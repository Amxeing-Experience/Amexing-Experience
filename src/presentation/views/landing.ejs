<%#
Amexing Experience - Premium Landing Page
Main landing page showcasing luxury transportation and experience services
in San Miguel de Allende with Tesla fleet and premium service offerings

@param {string} title - Page title (optional)
@param {object} user - Current user session (optional)
@param {object} seo - SEO meta data (optional)
@param {object} company - Company information (optional)

Created by Denisse Maldonado
%>

<!DOCTYPE html>
<html lang="es" prefix="og: http://ogp.me/ns#">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    
    <%# Page Title & SEO %>
    <% 
    const pageTitle = typeof title !== 'undefined' ? title : 'Amexing Experience - Transporte Premium en San Miguel de Allende';
    const seoData = typeof seo !== 'undefined' ? seo : {
        description: 'Experiencia de transporte premium en San Miguel de Allende con flota Tesla y 30 años de experiencia. Servicios de lujo, tours exclusivos y atención personalizada.',
        keywords: 'transporte premium, San Miguel de Allende, Tesla, tours, experiencias de lujo, transporte ejecutivo',
        author: 'Amexing Experience'
    };
    const companyInfo = typeof company !== 'undefined' ? company : {
        name: 'Amexing Experience',
        tagline: 'Elevamos la experiencia de viaje',
        phone: '+52 (415) 152-7890',
        email: 'info@amexing.com',
        address: 'San Miguel de Allende, Guanajuato, México'
    };
    %>
    
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= seoData.description %>">
    <meta name="keywords" content="<%= seoData.keywords %>">
    <meta name="author" content="<%= seoData.author %>">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://amexing.com/">
    
    <%# Open Graph Meta Tags %>
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= seoData.description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://amexing.com/">
    <meta property="og:image" content="https://amexing.com/images/og-hero-san-miguel.jpg">
    <meta property="og:site_name" content="<%= companyInfo.name %>">
    <meta property="og:locale" content="es_MX">
    
    <%# Twitter Card Meta Tags %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= seoData.description %>">
    <meta name="twitter:image" content="https://amexing.com/images/og-hero-san-miguel.jpg">
    
    <%# Favicon %>
    <link rel="icon" type="image/png" href="/images/heart_black.png">
    <link rel="apple-touch-icon" href="/images/heart_black.png">
    
    <%# Google Fonts %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
    
    <%# Font Awesome Icons %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    
    <%# Custom Fonts (Arpona and Myriad Pro) %>
    <link rel="stylesheet" href="/css/fonts.css">
    
    <%# Base Landing Page Styles %>
    <style>
        /* CSS Reset & Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }
        
        body {
            font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.6;
            color: #333;
            overflow-x: hidden;
            background-color: #000;
        }
        
        /* Smooth Scrolling */
        @media (prefers-reduced-motion: no-preference) {
            html {
                scroll-behavior: smooth;
            }
        }
        
        /* Loading Animation */
        .page-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.5s ease;
        }
        
        .page-loader--hidden {
            opacity: 0;
            pointer-events: none;
        }
        
        .loader-spinner {
            width: 50px;
            height: 50px;
            border: 3px solid rgba(150, 155, 129, 0.3);
            border-top: 3px solid #969B81;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* Page Content */
        .landing-page {
            position: relative;
        }
        
        /* Scroll to Top Button */
        .scroll-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #B8860B, #DAA520);
            color: white;
            border: none;
            border-radius: 0;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 15px rgba(184, 134, 11, 0.3);
        }
        
        .scroll-to-top--visible {
            opacity: 1;
            visibility: visible;
        }
        
        .scroll-to-top:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(184, 134, 11, 0.5);
        }
        
        .scroll-to-top__arrow {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-style: solid;
            border-width: 2px 2px 0 0;
            border-color: currentColor;
            transform: rotate(-45deg);
        }
        /* Accessibility */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
        
        /* Focus Styles */
        *:focus {
            outline: 2px solid #DAA520;
            outline-offset: 2px;
        }
        
        /* High Contrast Mode */
        @media (prefers-contrast: high) {
            .premium-btn,
            .landing-nav__link,
            .scroll-to-top {
                border: 2px solid currentColor;
            }
        }
        
        /* Experience Section Styles */
        .experience-section {
            padding: 6rem 0;
            background: #eaeaeaff;
            text-align: center;
        }
        
        .experience-section__container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        .experience-section__heart {
            width: 60px;
            height: auto;
            margin: 3rem auto 0 auto;
            display: block;
        }
        
        .experience-section__title {
            font-family: var(--font-myriad);
            font-weight: 700;
            font-size: clamp(1rem, 2vw, 1.2rem);
            color: #2e2e2d;
            margin-bottom: 0.5rem;
            line-height: 1.7;
        }
        
        .experience-section__description {
            font-family: var(--font-myriad);
            font-weight: 300;
            font-size: clamp(1rem, 2vw, 1.2rem);
            line-height: 1.7;
            color: #666;
            max-width: 800px;
            margin: 0 auto;
        }

        /* Reconocimientos Section Styles */
        .reconocimientos-section {
            padding: 4rem 0;
            background: #2e2e2d;
            text-align: center;
        }
        
        .reconocimientos-section__container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        .reconocimientos-section__title {
            font-family: var(--font-newsreader);
            font-optical-sizing: auto;
            font-weight: 400;
            font-size: clamp(1.2rem, 2.5vw, 1.8rem);
            color: #969B81;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            /* Equal VISUAL space above and below the word (between the two <hr>).
               Caps sit high in the line box, leaving ~6px more below, so the top
               margin is a bit larger than the bottom to compensate (total kept). */
            line-height: 1;
            margin: 0.9rem 0 0.6rem;
        }
        
        .reconocimientos-section__award {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 3rem;
            flex-wrap: wrap;
        }
        
        .reconocimientos-section__image {
            margin-top: 3rem;
            max-width: 190px;
            height: auto;
            border-radius: 50%;
        }

        .reconocimientos-section__hr {
            border: none;
            border-top: 1px solid #969b81;
            height: 0;
            margin: 0;
        }

        .reconocimientos-section__hr--bottom {
            margin-top: 3rem;
        }

        /* Clientes que confían en nosotros Section Styles */
        .clientes-confian-section {
            padding: 0.875rem 0;
            background: #ffffff;
            text-align: center;
        }

        .clientes-confian-section__band {
            padding: 3rem 0 4rem;
            background: #d6d6d6;
        }

        .clientes-confian-section__container {
            max-width: 1200px; /* igual que reconocimientos: alinea el marco con la línea verde */
            margin: 0 auto;
            padding: 0 2rem;
        }

        .clientes-confian-section__panel {
            position: relative;
            padding: 4rem 2.5rem 2.5rem;
            border: 0.5px solid rgba(51, 51, 51, 0.35);
            background: #d5d5d5;
        }

        .clientes-confian-section__panel::before {
            content: '';
            position: absolute;
            top: 0.3rem;
            left: 0.3rem;
            right: -0.3rem;
            bottom: -0.3rem;
            border: 0.5px solid rgba(51, 51, 51, 0.25);
            pointer-events: none;
        }

        .clientes-confian-section__title {
            position: absolute;
            left: 50%;
            top: -0.9rem;
            transform: translateX(-50%);
            background: #7f7f7f;
            color: #f3f3f3;
            font-family: var(--font-newsreader);
            font-weight: 400;
            font-size: clamp(0.8rem, 1.65vw, 1.15rem);
            letter-spacing: 0.22em;
            text-transform: uppercase;
            padding: 1.0rem 2.75rem 0.5rem;
            margin: 0;
            width: calc(100% - 7rem);
            max-width: 760px;
            line-height: 1.1;
            z-index: 1;
        }

        .clientes-confian-section__title::first-letter {
            font-size: 1.3em;
            line-height: 0;
        }

        /* Carousel (marquee) de logos */
        .clientes-confian-section__carousel {
            position: relative;
            width: 100%;
            margin-top: 4.5rem;
            padding: 0.75rem 0; /* aire vertical para que el hover-zoom no recorte logos altos */
            overflow: hidden;
            -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
        }

        .clientes-confian-section__track {
            display: flex;
            width: max-content;
            align-items: center;
            animation: clientes-confian-scroll 30s linear infinite;
            will-change: transform;
        }

        .clientes-confian-section__carousel:hover .clientes-confian-section__track,
        .clientes-confian-section__carousel:focus-within .clientes-confian-section__track {
            animation-play-state: paused;
        }

        @keyframes clientes-confian-scroll {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }

        @media (prefers-reduced-motion: reduce) {
            .clientes-confian-section__track {
                animation: none;
            }
        }

        .clientes-confian-section__logo-link {
            flex: 0 0 auto;
            text-decoration: none;
            color: #4b4b4b;
            min-height: 78px;
            padding: 0 3.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.25s ease, color 0.25s ease;
        }

        .clientes-confian-section__logo-image {
            max-width: 180px;
            max-height: 78px;
            width: auto;
            height: auto;
            object-fit: contain;
            transform-origin: center;
            transition: transform 0.25s ease;
        }

        .clientes-confian-section__logo-placeholder {
            font-family: var(--font-newsreader);
            font-size: clamp(1.8rem, 2.4vw, 2.8rem);
            font-weight: 400;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            line-height: 1;
            display: inline-block;
            transform-origin: center;
            transition: transform 0.25s ease;
            white-space: nowrap;
        }

        .clientes-confian-section__logo-link:hover,
        .clientes-confian-section__logo-link:focus-visible {
            color: #1f1f1f;
        }

        .clientes-confian-section__logo-link:hover .clientes-confian-section__logo-image,
        .clientes-confian-section__logo-link:focus-visible .clientes-confian-section__logo-image,
        .clientes-confian-section__logo-link:hover .clientes-confian-section__logo-placeholder,
        .clientes-confian-section__logo-link:focus-visible .clientes-confian-section__logo-placeholder {
            transform: scale(1.08);
        }

        .clientes-confian-section__logo-link:focus-visible {
            outline: 2px solid #7f7f7f;
            outline-offset: 6px;
        }

        .clientes-confian-section__categories {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
            align-items: start;
            margin-top: 4.5rem;
        }

        .clientes-confian-section__category {
            margin: 0;
            font-family: var(--font-newsreader);
            font-size: clamp(1rem, 1.5vw, 1.5rem);
            font-weight: 400;
            letter-spacing: 0.08em;
            color: #464646;
            font-variant-caps: small-caps;
            font-feature-settings: "smcp";
            line-height: 1.2;
            text-align: center;
            white-space: nowrap;
        }

        /* Publicaciones Section Styles */
        .publicaciones-section {
            padding: 4rem 0;
            background: #8c9280;
            overflow: hidden;
        }

        .publicaciones-section__inner {
            width: 100%;
            margin: 0 auto;
            padding: 0;
            position: relative;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            column-gap: 0; /* interno toca la portada; externo llega a la orilla */
        }

        /* Franja blanca tenue continua a todo el ancho, entre las dos líneas.
           La portada (encima) la corta visualmente en el centro. */
        .publicaciones-section__inner::before {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            height: clamp(5rem, 8vw, 6.5rem);
            background: linear-gradient(
                180deg,
                rgba(255, 255, 255, 0.12) 0%,
                rgba(255, 255, 255, 0.18) 50%,
                rgba(255, 255, 255, 0.12) 100%
            );
            border-top: 1px solid rgba(255, 255, 255, 0.8);
            border-bottom: 1px solid rgba(255, 255, 255, 0.8);
            z-index: 0;
            pointer-events: none;
        }

        /* Banner: banda horizontal con línea arriba y abajo, igual en ambos lados.
           La portada (centro) es más alta y rompe la banda. */
        .publicaciones-section__side {
            position: relative;
            z-index: 1; /* el texto va sobre la franja blanca */
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 0;
            min-height: clamp(5rem, 8vw, 6.5rem);
            padding: 0.6rem 0;
        }

        /* (Interno toca la portada por el column-gap:0; externo llega a la orilla
           porque el contenedor va a todo el ancho. El texto queda centrado.) */

        .publicaciones-section__label {
            flex: 0 0 auto;
            font-family: var(--font-newsreader);
            font-weight: 400;
            font-size: clamp(1.1rem, 1.8vw, 1.7rem);
            letter-spacing: 0.32em;
            text-transform: uppercase;
            color: #f5f5f0;
            white-space: nowrap;
            text-align: center;
        }

        .publicaciones-section__brand-block {
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.4rem;
            text-align: center;
        }

        .publicaciones-section__brand-img {
            display: block;
            width: clamp(80px, 10vw, 120px);
            height: auto;
            filter: brightness(0) invert(1); /* renderiza el logo en blanco */
        }

        .publicaciones-section__sub {
            font-family: var(--font-myriad), 'Segoe UI', Tahoma, sans-serif;
            font-weight: 400;
            font-size: clamp(1.05rem, 1.6vw, 1.5rem);
            letter-spacing: 0.12em;
            font-variant-caps: small-caps;
            font-feature-settings: "smcp";
            color: rgba(255, 255, 255, 0.85);
            line-height: 1.2;
        }

        /* Portada de la revista (link con animación de apertura) */
        .publicaciones-section__cover {
            position: relative;
            z-index: 1; /* tapa la franja blanca en el centro */
            flex: 0 0 auto;
            display: block;
            padding: 0.85rem;
            border: 1px solid rgba(255, 255, 255, 0.5);
            background: #8c9280; /* mismo verde: oculta la franja detrás del marco */
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        /* Escenario plano con perspectiva: las capas (portada + páginas) se
           apilan por z-index y cada una gira como una hoja al hojear */
        .publicaciones-section__cover-stage {
            position: relative;
            display: block;
            width: clamp(240px, 30vw, 380px);
            aspect-ratio: 605 / 788; /* proporción de la portada; da altura sin sizer en flujo */
            perspective: 1700px;
        }

        /* Todas las capas idénticas (absolutas) para que la animación 3D
           se vea igual en la imagen y en los PDFs */
        .publicaciones-section__cover-layer {
            position: absolute;
            inset: 0;
            transform-origin: left center;
            backface-visibility: hidden; /* al pasar de 90° desaparece y muestra la de atrás */
            will-change: transform;
            visibility: hidden; /* solo se ven la de adelante y la que se revela */
        }

        .publicaciones-section__cover-layer.is-front,
        .publicaciones-section__cover-layer.is-revealing {
            visibility: visible;
        }

        .publicaciones-section__cover-media {
            display: block;
            width: 100%;
            height: 100%;
            border: 0;
            object-fit: cover;
            background: #ffffff;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            pointer-events: none; /* los clics van al contenedor para ciclar */
        }

        /* Brillo + sombra que simulan la curvatura de una hoja flexible */
        .publicaciones-section__cover-sheen {
            position: absolute;
            inset: 0;
            backface-visibility: hidden;
            pointer-events: none;
            opacity: 0;
            background: linear-gradient(
                100deg,
                rgba(0, 0, 0, 0.35) 0%,
                rgba(0, 0, 0, 0) 18%,
                rgba(255, 255, 255, 0.45) 48%,
                rgba(255, 255, 255, 0) 64%,
                rgba(0, 0, 0, 0.18) 100%
            );
            background-size: 220% 100%;
            background-position: 100% 0;
        }

        /* Hover: la capa de adelante se inclina un poco y asoma un brillo */
        .publicaciones-section__cover:hover .publicaciones-section__cover-layer.is-front,
        .publicaciones-section__cover:focus-visible .publicaciones-section__cover-layer.is-front {
            transform: rotateY(-14deg) scale(1.02);
            transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
        }

        .publicaciones-section__cover:hover .publicaciones-section__cover-layer.is-front .publicaciones-section__cover-sheen,
        .publicaciones-section__cover:focus-visible .publicaciones-section__cover-layer.is-front .publicaciones-section__cover-sheen {
            opacity: 0.35;
            transition: opacity 0.35s ease;
        }

        .publicaciones-section__cover:focus-visible {
            outline: 2px solid #ffffff;
            outline-offset: 6px;
        }

        /* Clic: la capa de adelante gira como hoja y revela la siguiente */
        .publicaciones-section__cover-layer.is-flipping {
            animation: publicacion-open 0.95s cubic-bezier(0.45, 0.05, 0.2, 1) forwards;
        }

        .publicaciones-section__cover-layer.is-flipping .publicaciones-section__cover-sheen {
            animation: publicacion-sheen 0.95s cubic-bezier(0.45, 0.05, 0.2, 1) forwards;
        }

        @keyframes publicacion-open {
            0%   { transform: rotateY(0) scale(1); }
            14%  { transform: rotateY(-7deg) scale(1.01); }
            100% { transform: rotateY(-145deg) scale(1.04); }
        }

        @keyframes publicacion-sheen {
            0%   { opacity: 0; background-position: 100% 0; }
            30%  { opacity: 0.85; }
            100% { opacity: 0.55; background-position: 0% 0; }
        }

        @media (prefers-reduced-motion: reduce) {
            .publicaciones-section__cover-layer,
            .publicaciones-section__cover:hover .publicaciones-section__cover-layer.is-front,
            .publicaciones-section__cover-layer.is-flipping,
            .publicaciones-section__cover-layer.is-flipping .publicaciones-section__cover-sheen {
                transition: none;
                animation: none;
                transform: none;
            }
        }

        /* Testimonios Section Styles */
        .testimonios-section {
            padding: 6rem 0;
            background: white;
            text-align: center;
        }
        
        .testimonios-section__container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        .testimonios-section__title {
            font-family: var(--font-newsreader);
            font-optical-sizing: auto;
            font-weight: 400;
            font-size: clamp(2rem, 3vw, 2.7rem);
            color: white;
            background: rgba(150, 155, 129, 1.0);
            padding: 1rem 3rem;
            margin: 0 auto 4rem auto;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            display: inline-block;
        }
        
        .testimonios-section__slider {
            position: relative;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .testimonios-section__slider-container {
            overflow: hidden;
            border-radius: 10px;
            /* box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1); */
        }
        
        .testimonios-section__slides {
            display: flex;
            transition: transform 0.5s ease-in-out;
        }
        
        .testimonios-section__slide {
            min-width: 100%;
            padding: 2rem;
            background: white;
            display: flex;
            gap: 1.5rem;
            justify-content: center;
        }
        
        .testimonios-section__card {
            flex: 1;
            max-width: 350px;
            text-align: left;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 1.5rem;
            background: white;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }
        
        .testimonios-section__rating {
            text-align: left !important;
            margin-bottom: 1rem;
        }
        
        .testimonios-section__rating-img {
            height: 20px;
            width: auto;
