                        </div>
                        <div class="testimonios-section__navigation">
                            <button class="testimonios-section__nav-btn testimonios-section__nav-btn--prev" aria-label="Anterior testimonio">
                                <span class="testimonios-section__nav-arrow testimonios-section__nav-arrow--left"></span>
                            </button>
                            <button class="testimonios-section__nav-btn testimonios-section__nav-btn--next" aria-label="Siguiente testimonio">
                                <span class="testimonios-section__nav-arrow testimonios-section__nav-arrow--right"></span>
                            </button>
                        </div>
                        <div class="testimonios-section__indicators" id="testimonialIndicators">
                            <!-- Indicators will be dynamically generated -->
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <%# Footer %>
        <%- include('organisms/landing/landing-footer', {
            companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null
        }) %>

        <%# Scroll to Top Button %>
        <button class="scroll-to-top" id="scrollToTop" aria-label="Volver arriba">
            <span class="scroll-to-top__arrow" aria-hidden="true"></span>
        </button>
    </div>

    <%# Landing Page JavaScript %>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Page Loader
        const pageLoader = document.getElementById('pageLoader');
        const scrollToTop = document.getElementById('scrollToTop');
        
        // Hide loader after page load
        window.addEventListener('load', function() {
            setTimeout(function() {
                pageLoader.classList.add('page-loader--hidden');
                setTimeout(function() {
                    pageLoader.style.display = 'none';
                }, 500);
            }, 500);
        });
        
        // Scroll to Top Button
        window.addEventListener('scroll', function() {
            if (window.pageYOffset > 300) {
                scrollToTop.classList.add('scroll-to-top--visible');
            } else {
                scrollToTop.classList.remove('scroll-to-top--visible');
            }
        });
        
        scrollToTop.addEventListener('click', function() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
        
        // Smooth Scroll for All Anchor Links
        const anchorLinks = document.querySelectorAll('a[href^="#"]');
        anchorLinks.forEach(function(link) {
            link.addEventListener('click', function(e) {
                const targetId = this.getAttribute('href').substring(1);
                const targetElement = document.getElementById(targetId);
                
                if (targetElement) {
                    e.preventDefault();
                    const offsetTop = targetElement.offsetTop - 80;
                    window.scrollTo({
                        top: offsetTop,
                        behavior: 'smooth'
                    });
                }
            });
        });
        
        // Intersection Observer for Animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('section--visible');
                }
            });
        }, observerOptions);
        
        // Observe all main sections
        const sections = document.querySelectorAll('section[id]');
        sections.forEach(function(section) {
            observer.observe(section);
        });
        
        // Contact Form Handler (if needed)
        const contactForm = document.getElementById('contactForm');
        if (contactForm) {
            contactForm.addEventListener('submit', function(e) {
                e.preventDefault();
                // Add form submission logic here
                console.log('Contact form submitted');
            });
        }
        
        // Booking Form Handler (if needed)
        const bookingForm = document.getElementById('bookingForm');
        if (bookingForm) {
            bookingForm.addEventListener('submit', function(e) {
                e.preventDefault();
                // Add booking form logic here
                console.log('Booking form submitted');
            });
        }
        
        // Analytics Tracking
        function trackEvent(eventName, eventData) {
            if (typeof gtag !== 'undefined') {
                gtag('event', eventName, eventData);
            }
            // Add other analytics tracking here
        }
        
        // Track CTA clicks
        const ctaButtons = document.querySelectorAll('.premium-btn, .hero-section__cta');
        ctaButtons.forEach(function(button) {
            button.addEventListener('click', function() {
                trackEvent('cta_click', {
                    button_text: this.textContent.trim(),
                    page_location: window.location.href
                });
            });
        });
        
        // Performance Monitoring
        if ('performance' in window) {
            window.addEventListener('load', function() {
                setTimeout(function() {
                    const perfData = performance.timing;
                    const loadTime = perfData.loadEventEnd - perfData.navigationStart;
                    
                    trackEvent('page_load_time', {
                        load_time: loadTime,
                        page_type: 'landing_page'
                    });
                }, 1000);
            });
        }
        
        // Testimonios Slider Functionality
        function initTestimoniosSlider() {
            const slider = document.querySelector('.testimonios-section__slides');
            const prevBtn = document.querySelector('.testimonios-section__nav-btn--prev');
            const nextBtn = document.querySelector('.testimonios-section__nav-btn--next');
            const indicators = document.querySelectorAll('.testimonios-section__indicator');
            
            if (!slider) return;
            
            let currentSlide = 0;
            const totalSlides = document.querySelectorAll('.testimonios-section__slide').length;
            
            function updateSlider() {
                const translateX = -currentSlide * 100;
                slider.style.transform = `translateX(${translateX}%)`;
                
                // Update indicators
                indicators.forEach((indicator, index) => {
                    indicator.classList.toggle('testimonios-section__indicator--active', index === currentSlide);
                });
            }
            
            function nextSlide() {
                currentSlide = (currentSlide + 1) % totalSlides;
                updateSlider();
            }
            
            function prevSlide() {
                currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
                updateSlider();
            }
            
            function goToSlide(slideIndex) {
                currentSlide = slideIndex;
                updateSlider();
            }
            
            // Event listeners
            if (nextBtn) nextBtn.addEventListener('click', nextSlide);
            if (prevBtn) prevBtn.addEventListener('click', prevSlide);
            
            indicators.forEach((indicator, index) => {
                indicator.addEventListener('click', () => goToSlide(index));
            });
            
            // Auto-slide (optional)
            let autoSlideInterval;
            function startAutoSlide() {
                autoSlideInterval = setInterval(nextSlide, 5000);
            }
            
            function stopAutoSlide() {
                clearInterval(autoSlideInterval);
            }
            
            // Start auto-slide
            startAutoSlide();
            
            // Pause auto-slide on hover
            const testimoniosSection = document.querySelector('.testimonios-section');
            if (testimoniosSection) {
                testimoniosSection.addEventListener('mouseenter', stopAutoSlide);
                testimoniosSection.addEventListener('mouseleave', startAutoSlide);
            }
            
            // Touch/swipe support for mobile
            let startX = 0;
            let currentX = 0;
            let isDragging = false;
            
            slider.addEventListener('touchstart', (e) => {
                startX = e.touches[0].clientX;
                isDragging = true;
                stopAutoSlide();
            });
            
            slider.addEventListener('touchmove', (e) => {
                if (!isDragging) return;
                currentX = e.touches[0].clientX;
            });
            
            slider.addEventListener('touchend', () => {
                if (!isDragging) return;
                isDragging = false;
                
                const diffX = startX - currentX;
                const threshold = 50;
                
                if (Math.abs(diffX) > threshold) {
                    if (diffX > 0) {
                        nextSlide();
                    } else {
                        prevSlide();
                    }
                }
                
                startAutoSlide();
            });
        }
        
        // Initialize testimonios slider when DOM is loaded
        initTestimoniosSlider();
        
        // Testimonials Data (from TripAdvisor API or fallback)
        const testimonialData = {
            "data": <%- JSON.stringify(typeof testimonials !== 'undefined' ? testimonials : []) %>
        };
        
        // Function to format date
        function formatTestimonialDate(dateStr) {
            const date = new Date(dateStr);
            const options = { year: 'numeric', month: 'short', day: 'numeric' };
            return date.toLocaleDateString('en-US', options);
        }
        
        // Function to create testimonial card HTML (just the card, not the slide)
        function createTestimonialCard(testimonial) {
            const formattedDate = formatTestimonialDate(testimonial.published_date);
            
            return `
                <div class="testimonios-section__card">
                    <div class="testimonios-section__rating">
                        <img src="${testimonial.rating_image_url}" alt="${testimonial.rating} star rating" class="testimonios-section__rating-img" />
                    </div>
                    <p class="testimonios-section__text">"${testimonial.text}"</p>
                    <div class="testimonios-section__attribution">
                        Review by Tripadvisor Traveler ${formattedDate}
                    </div>
                </div>
            `;
        }
        
        // Function to populate testimonials (grouping by 3 per slide)
        function populateTestimonials() {
            const slidesContainer = document.getElementById('testimonialSlides');
            const indicatorsContainer = document.getElementById('testimonialIndicators');
            
            if (!slidesContainer || !indicatorsContainer) return;
            
            // Clear existing content
            slidesContainer.innerHTML = '';
            indicatorsContainer.innerHTML = '';
            
            // Group testimonials by 3 and create slides
            const testimonialsPerSlide = 3;
            const totalTestimonials = testimonialData.data.length;
            const totalSlides = Math.ceil(totalTestimonials / testimonialsPerSlide);
            
            for (let slideIndex = 0; slideIndex < totalSlides; slideIndex++) {
                // Create slide container
                let slideHTML = '<div class="testimonios-section__slide">';
                
                // Add up to 3 testimonials per slide
                const startIndex = slideIndex * testimonialsPerSlide;
                const endIndex = Math.min(startIndex + testimonialsPerSlide, totalTestimonials);
                
                for (let i = startIndex; i < endIndex; i++) {
                    slideHTML += createTestimonialCard(testimonialData.data[i]);
                }
                
                slideHTML += '</div>';
                slidesContainer.innerHTML += slideHTML;
                
                // Add indicator for this slide
                const indicator = document.createElement('button');
                indicator.className = `testimonios-section__indicator ${slideIndex === 0 ? 'testimonios-section__indicator--active' : ''}`;
                indicator.setAttribute('data-slide', slideIndex);
                indicatorsContainer.appendChild(indicator);
            }
            
            // Re-initialize the slider after adding content
            initTestimoniosSlider();
        }
        
        // Populate testimonials on page load
        populateTestimonials();
    });
    </script>

    <%# Google Analytics (if enabled) %>
    <% if (typeof process !== 'undefined' && process.env.GOOGLE_ANALYTICS_ID) { %>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GOOGLE_ANALYTICS_ID %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= process.env.GOOGLE_ANALYTICS_ID %>');
    </script>
    <% } %>
</body>
</html>