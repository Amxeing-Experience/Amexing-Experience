    <div class="landing-page">
        <%# Navigation %>
        <%- include('organisms/landing/landing-navigation', {
            user: typeof user !== 'undefined' ? user : null,
            currentPage: 'home',
            transparent: true,
            companyInfo: typeof company !== 'undefined' ? company : null,
            req: typeof req !== 'undefined' ? req : null,
            t: typeof t !== 'undefined' ? t : ((key) => key)
        }) %>

        <%# Main Content %>
        <main id="main-content">
            <%# Hero Section %>
            <%- include('organisms/landing/hero-section', {
                title: 'Elevamos la experiencia de viaje<br>en San Miguel de Allende',
                backgroundImage: '/images/hero-background.jpg',
                ctaText: 'BOOK NOW',
                ctaLink: '/contacto#book',
                user: typeof user !== 'undefined' ? user : null
            }) %>

            <%# Experience Section %>
            <section id="experience" class="experience-section">
                <div class="experience-section__container">
                    <h2 class="experience-section__title">Con 30 años de experiencia,</h2>
                    <p class="experience-section__description">
                        ofrecemos una manera segura, cálida y elegante de vivir San Miguel de Allende. 
                        Nuestra esencia local, junto con un servicio de lujo y una atención genuinamente 
                        cercana, nos permite brindar a cada cliente la confianza de estar en manos expertas 
                        y disfrutar el destino con absoluta tranquilidad y confianza.
                    </p>
                    <img src="/images/heart_black.png" alt="Corazón Amexing Experience" class="experience-section__heart">
                </div>
            </section>

            <%# Reconocimientos Section %>
            <section id="reconocimientos" class="reconocimientos-section">
                <div class="reconocimientos-section__container">
                    <hr class="reconocimientos-section__hr">
                    <h2 class="reconocimientos-section__title">RECONOCIMIENTOS</h2>
                    <hr class="reconocimientos-section__hr">
                    <div class="reconocimientos-section__award">
                        <img src="/images/trip_advisor.png" alt="TripAdvisor Travelers' Choice Awards 2025" class="reconocimientos-section__image">
                        <img src="/images/trip_advisor2026.png" alt="TripAdvisor Travelers' Choice Awards 2026" class="reconocimientos-section__image">
                    </div>
                    <hr class="reconocimientos-section__hr reconocimientos-section__hr--bottom">
                </div>
            </section>

            <%# Clientes que confían en nosotros Section %>
            <%
                // Logos del carrusel. Agrega más empresas aquí y el carrusel crece automáticamente.
                const logosClientes = [
                    { name: 'Casa Dragones', url: 'https://casadragones.com.mx/visitanos', logo: '/images/casa_dragones.png' },
                    { name: 'This', url: 'https://www.thistopdestinos.com/', logo: '/images/this.png' },
                    { name: 'Avenue', url: 'https://www.avenuesanmiguel.com/', logo: '/images/avenue.png' },
                    { name: 'Maizazul', url: 'https://www.casamaizazul.com/', logo: '/images/maiz_azul.png' },
                    { name: 'San Miguel Writers Conference', url: 'https://sanmiguelwritersconference.org/', logo: '/images/san_miguel_writers.png' },
                    { name: 'Casa Proserpina', url: 'https://www.casaproserpinasma.com/', logo: '/images/casa_proserpina.png' }
                ];
                // Categorías estáticas que se muestran debajo del carrusel.
                const categoriasClientes = ['Wedding Planners', 'Agencias de Viajes', 'Hoteles', 'DMCs'];
            %>
            <section id="clientes-confian" class="clientes-confian-section">
                <div class="clientes-confian-section__band">
                <div class="clientes-confian-section__container">
                    <div class="clientes-confian-section__panel">
                        <h2 class="clientes-confian-section__title">Clientes que confían en nosotros</h2>
                        <div class="clientes-confian-section__carousel">
                            <div class="clientes-confian-section__track">
                                <%# Lista duplicada (2x) para un desplazamiento continuo sin saltos %>
                                <% for (let copia = 0; copia < 2; copia++) { %>
                                    <% logosClientes.forEach(function(cliente) { %>
                                        <a
                                            class="clientes-confian-section__logo-link"
                                            href="<%= cliente.url %>"
                                            aria-label="Visitar sitio de <%= cliente.name %>"
                                            <% if (cliente.url && cliente.url !== '#') { %>target="_blank" rel="noopener noreferrer"<% } %>
                                            <% if (copia === 1) { %>aria-hidden="true" tabindex="-1"<% } %>
                                        >
                                            <% if (cliente.logo) { %>
                                                <img src="<%= cliente.logo %>" alt="<%= cliente.name %>" class="clientes-confian-section__logo-image">
                                            <% } else { %>
                                                <span class="clientes-confian-section__logo-placeholder"><%= cliente.name %></span>
                                            <% } %>
                                        </a>
                                    <% }); %>
                                <% } %>
                            </div>
                        </div>
                        <div class="clientes-confian-section__categories">
                            <% categoriasClientes.forEach(function(categoria) { %>
                                <p class="clientes-confian-section__category"><%= categoria %></p>
                            <% }); %>
                        </div>
                    </div>
                </div>
                </div>
            </section>

            <%# Publicaciones Section %>
            <%
                // URL del artículo (fallback sin JS / SEO).
                const publicacionThisUrl = 'https://www.thistopdestinos.com/this-that/amexing-experience-ofrece-una-forma-unica-de-recorrer-san-miguel';
                // El carrusel cicla: portada (imagen) → estos PDFs (en orden) → de nuevo la portada.
                const publicacionThisPdfs = [
                    { src: '/docs/This%2066%202026%20PP%2045.pdf', label: 'Revista THIS — página 45' },
                    { src: '/docs/This%2066%202026%20PP%20228.pdf', label: 'Revista THIS — página 228' },
                ];
            %>
            <section id="publicaciones" class="publicaciones-section">
                <div class="publicaciones-section__inner">
                    <div class="publicaciones-section__side publicaciones-section__side--left">
                        <span class="publicaciones-section__label">Publicaciones</span>
                    </div>

                    <a
                        class="publicaciones-section__cover"
                        href="<%= publicacionThisUrl %>"
                        rel="noopener"
                        role="button"
                        aria-label="Hojear la publicación de la revista THIS donde aparece Amexing Experience"
                    >
                        <span class="publicaciones-section__cover-stage">
                            <%# Capa 1: portada (imagen). Define el tamaño del escenario. %>
                            <span class="publicaciones-section__cover-layer publicaciones-section__cover-layer--sizer">
                                <img
                                    src="/images/revista_this.png"
                                    alt="Portada de la revista THIS, disponible con nosotros"
                                    class="publicaciones-section__cover-media"
                                >
                                <span class="publicaciones-section__cover-sheen" aria-hidden="true"></span>
                            </span>
                            <%# Capas siguientes: páginas del PDF que se van revelando al hojear %>
                            <% publicacionThisPdfs.forEach(function(pdf) { %>
                                <span class="publicaciones-section__cover-layer">
                                    <iframe
                                        class="publicaciones-section__cover-media"
                                        data-pdf="<%= pdf.src %>"
                                        title="<%= pdf.label %>"
                                        loading="lazy"
                                    ></iframe>
                                    <span class="publicaciones-section__cover-sheen" aria-hidden="true"></span>
                                </span>
                            <% }); %>
                        </span>
                    </a>

                    <div class="publicaciones-section__side publicaciones-section__side--right">
                        <span class="publicaciones-section__brand-block">
                            <img src="/images/this.png" alt="THIS" class="publicaciones-section__brand-img">
                            <span class="publicaciones-section__sub">Disponible con nosotros</span>
                        </span>
                    </div>
                </div>
            </section>

            <script>
                (function () {
                    var cover = document.querySelector('.publicaciones-section__cover');
                    if (!cover) return;
                    var stage = cover.querySelector('.publicaciones-section__cover-stage');
                    var layers = Array.prototype.slice.call(
                        stage.querySelectorAll('.publicaciones-section__cover-layer')
                    );
                    if (layers.length < 2) return;

                    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    var order = layers.slice(); // de adelante hacia atrás
                    var busy = false;
                    var flipTimer = null;

                    // Carga los PDFs (1 sola vez) para que el hojeo sea instantáneo.
                    function loadPdfs() {
                        layers.forEach(function (l) {
                            var f = l.querySelector('iframe');
                            if (f && !f.getAttribute('src') && f.getAttribute('data-pdf')) {
                                f.setAttribute('src', f.getAttribute('data-pdf') + '#toolbar=0&navpanes=0&view=FitH');
                            }
                        });
                    }

                    function applyStack() {
                        order.forEach(function (l, i) {
                            l.style.zIndex = String(order.length - i);
                            l.classList.toggle('is-front', i === 0);
                        });
                    }
                    applyStack();

                    if ('IntersectionObserver' in window) {
                        var io = new IntersectionObserver(function (entries, obs) {
                            entries.forEach(function (e) {
                                if (e.isIntersecting) { loadPdfs(); obs.disconnect(); }
                            });
                        }, { rootMargin: '300px' });
                        io.observe(cover);
                    } else {
                        loadPdfs();
                    }
                    cover.addEventListener('pointerenter', loadPdfs);

                    var revealTimer = null;

                    // Manda la capa de adelante al fondo y deja lista la siguiente.
                    function settle(front) {
                        order.push(order.shift());
                        front.classList.remove('is-flipping'); // reinicia su giro (ya está al fondo, tapada)
                        layers.forEach(function (l) { l.classList.remove('is-revealing'); });
                        applyStack();
                        busy = false;
                    }

                    function nextPage() {
                        if (busy) return;
                        busy = true;
                        loadPdfs();
                        var front = order[0];
                        var nextLayer = order[1];

                        if (prefersReduced) { settle(front); return; }

                        var finished = false;
                        function finish() {
                            if (finished) return;
                            finished = true;
                            front.removeEventListener('animationend', onAnim);
                            window.clearTimeout(flipTimer);
                            window.clearTimeout(revealTimer);
                            settle(front);
                        }
                        function onAnim(ev) {
                            if (ev.animationName === 'publicacion-open') finish();
                        }

                        front.classList.add('is-flipping');
                        // Revela la siguiente recién cuando la de adelante ya giró >90°
                        // (así se ve completa la animación de cualquier capa, incluida la imagen).
                        window.clearTimeout(revealTimer);
                        revealTimer = window.setTimeout(function () {
                            nextLayer.classList.add('is-revealing');
                        }, 600);
                        front.addEventListener('animationend', onAnim);
                        flipTimer = window.setTimeout(finish, 1100); // respaldo
                    }

                    cover.addEventListener('click', function (event) {
                        event.preventDefault();
                        nextPage();
                    });
                })();
            </script>

            <%# Testimonios Section %>
            <section id="testimonios" class="testimonios-section">
                <div class="testimonios-section__container">
                    <h2 class="testimonios-section__title">TESTIMONIOS</h2>
                    <div class="testimonios-section__slider">
                        <div class="testimonios-section__slider-container">
