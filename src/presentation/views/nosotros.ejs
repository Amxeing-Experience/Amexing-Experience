<%#
Nosotros (About) Page
About page showcasing Amexing Experience company information, history, and values

@param {string} title - Page title
@param {object} user - Current user session (optional)
@param {object} seo - SEO meta data
@param {object} company - Company information
@param {string} currentPage - Current page identifier

Created by Denisse Maldonado
%>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <%# Google Fonts %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
    
    <%# Font Awesome Icons %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <%# Custom Fonts CSS %>
    <link rel="stylesheet" href="/css/fonts.css">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background: #fff;
            color: #333;
            padding-top: 80px; /* Account for fixed navigation */
        }
        
        .white-spacer {
            background: #ffffff;
            height: 4rem;
            width: 100%;
        }
    </style>
</head>
<body>
    <%# Navigation %>
    <%- include('organisms/landing/landing-navigation', {
        user: typeof user !== 'undefined' ? user : null,
        currentPage: typeof currentPage !== 'undefined' ? currentPage : 'about',
        transparent: false,
        companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null,
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Quiénes Somos Section %>
    <%- include('organisms/landing/quienes-somos-section') %>

    <%# Historia Section %>
    <%- include('organisms/landing/historia-section') %>

    <%# About Section %>
    <%- include('organisms/landing/about-section') %>

    <%# Team Section %>
    <%- include('organisms/landing/team-section') %>

    <%# Permiso de Autotransporte Federal Section %>
    <%- include('organisms/landing/permiso-section') %>

    <%# Certificaciones Section %>
    <%- include('organisms/landing/certificaciones-section') %>

    <%# Afiliaciones Section %>
    <%- include('organisms/landing/afiliaciones-section') %>

    <%# Footer %>
    <%- include('organisms/landing/landing-footer', {
        companyInfo: typeof company !== 'undefined' ? company : null
    }) %>
</body>
</html>