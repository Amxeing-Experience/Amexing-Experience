<%#
Base Layout Template
Shared layout template for all Amexing Experience pages
Includes common head elements, navigation, footer and page structure

@param {string} title - Page title (required)
@param {object} user - Current user session (optional)
@param {object} seo - SEO meta data (optional)
@param {object} company - Company information (optional)
@param {string} currentPage - Current page identifier (optional)
@param {string} pageClass - Additional CSS class for body (optional)

Created by Denisse Maldonado
%>

<%
const pageTitle = typeof title !== 'undefined' ? title : 'Amexing Experience';
const seoData = typeof seo !== 'undefined' ? seo : {
    description: 'Experiencia de transporte premium en San Miguel de Allende con flota Tesla y 30 años de experiencia.',
    keywords: 'transporte premium, San Miguel de Allende, Tesla, tours, experiencias de lujo',
    author: 'Amexing Experience'
};
const companyInfo = typeof company !== 'undefined' ? company : {
    name: 'Amexing Experience',
    tagline: 'Elevamos la experiencia de viaje',
    phone: '+52 (415) 152-7890',
    email: 'info@amexing.com',
    address: 'San Miguel de Allende, Guanajuato, México'
};
const activePage = typeof currentPage !== 'undefined' ? currentPage : 'home';
const bodyClass = typeof pageClass !== 'undefined' ? pageClass : '';
%>

<!DOCTYPE html>
<html lang="es" prefix="og: http://ogp.me/ns#">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    
    <%# Page Title & SEO %>
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= seoData.description %>">
    <meta name="keywords" content="<%= seoData.keywords %>">
    <meta name="author" content="<%= seoData.author %>">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://amexing.com<%= typeof req !== 'undefined' ? req.path : '' %>">
    
    <%# Open Graph Meta Tags %>
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= seoData.description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://amexing.com<%= typeof req !== 'undefined' ? req.path : '' %>">
    <meta property="og:image" content="https://amexing.com/images/hero-background.jpg">
    <meta property="og:site_name" content="<%= companyInfo.name %>">
    <meta property="og:locale" content="es_MX">
    
    <%# Twitter Card Meta Tags %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= seoData.description %>">
    <meta name="twitter:image" content="https://amexing.com/images/hero-background.jpg">
    
    <%# Favicon %>
    <link rel="icon" type="image/png" href="/images/heart_black.png">
    <link rel="apple-touch-icon" href="/images/heart_black.png">
    
    <%# Google Fonts %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
    
    <%# Font Awesome Icons %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    
    <%# Custom Fonts CSS %>
    <link rel="stylesheet" href="/css/fonts.css">
    
    <%# Base Page Styles %>
    <style>
        /* CSS Reset & Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }
        
        body {
            font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.6;
            color: #333;
            overflow-x: hidden;
            background-color: #000;
        }
        
        .page-content {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .main-content {
            flex: 1;
            padding-top: 80px; /* Account for fixed navigation */
        }
        
        /* Page Loading Animation */
        .page-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.5s ease;
        }
        
        .page-loader--hidden {
            opacity: 0;
            pointer-events: none;
        }
        
        .loader-spinner {
            width: 50px;
            height: 50px;
            border: 3px solid rgba(184, 134, 11, 0.3);
            border-top: 3px solid #B8860B;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* Scroll to Top Button */
        .scroll-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #B8860B, #DAA520);
            color: white;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 15px rgba(184, 134, 11, 0.3);
        }
        
        .scroll-to-top--visible {
            opacity: 1;
            visibility: visible;
        }
        
        .scroll-to-top:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(184, 134, 11, 0.5);
        }
        
        .scroll-to-top__arrow {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-style: solid;
            border-width: 2px 2px 0 0;
            border-color: currentColor;
            transform: rotate(-45deg);
        }
        /* Accessibility */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
        
        /* Focus Styles */
        *:focus {
            outline: 2px solid #DAA520;
            outline-offset: 2px;
        }
        
        /* Print Styles */
        @media print {
            .landing-nav,
            .scroll-to-top,
            .page-loader {
                display: none !important;
            }
            
            body {
                background: white !important;
                color: black !important;
            }
        }
    </style>
    
    <%# Structured Data - JSON-LD %>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "TouristBusinessService",
        "name": "<%= companyInfo.name %>",
        "description": "<%= seoData.description %>",
        "url": "https://amexing.com",
        "telephone": "<%= companyInfo.phone %>",
        "email": "<%= companyInfo.email %>",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "San Miguel de Allende",
            "addressRegion": "Guanajuato",
            "addressCountry": "MX"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": "20.9154",
            "longitude": "-100.7455"
        },
        "serviceType": ["Transportation", "Tours", "Premium Experiences"],
        "areaServed": {
            "@type": "City",
            "name": "San Miguel de Allende"
        },
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "5.0",
            "reviewCount": "150+"
        }
    }
    </script>
</head>

<body class="<%= bodyClass %>">
    <%# Page Loader %>
    <div class="page-loader" id="pageLoader">
        <div class="loader-spinner"></div>
    </div>

    <%# Skip to Main Content - Accessibility %>
    <a href="#main-content" class="sr-only">Skip to main content</a>

    <div class="page-content">
        <%# Navigation %>
        <%- include('../organisms/landing/landing-navigation', {
            user: typeof user !== 'undefined' ? user : null,
            currentPage: activePage,
            transparent: false,
            companyInfo: companyInfo
        }) %>

        <%# Main Content %>
        <main id="main-content" class="main-content">
            <%- body %>
        </main>

        <%# Footer %>
        <%- include('../organisms/landing/landing-footer', {
            companyInfo: companyInfo,
            req: typeof req !== 'undefined' ? req : null
        }) %>

        <%# Scroll to Top Button %>
        <button class="scroll-to-top" id="scrollToTop" aria-label="Volver arriba">
            <span class="scroll-to-top__arrow" aria-hidden="true"></span>
        </button>
    </div>

    <%# Base JavaScript %>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Page Loader
        const pageLoader = document.getElementById('pageLoader');
        const scrollToTop = document.getElementById('scrollToTop');
        
        // Hide loader after page load
        window.addEventListener('load', function() {
            setTimeout(function() {
                pageLoader.classList.add('page-loader--hidden');
                setTimeout(function() {
                    pageLoader.style.display = 'none';
                }, 500);
            }, 500);
        });
        
        // Scroll to Top Button
        window.addEventListener('scroll', function() {
            if (window.pageYOffset > 300) {
                scrollToTop.classList.add('scroll-to-top--visible');
            } else {
                scrollToTop.classList.remove('scroll-to-top--visible');
            }
        });
        
        scrollToTop.addEventListener('click', function() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
        
        // Analytics Tracking
        function trackEvent(eventName, eventData) {
            if (typeof gtag !== 'undefined') {
                gtag('event', eventName, eventData);
            }
        }
        
        // Performance Monitoring
        if ('performance' in window) {
            window.addEventListener('load', function() {
                setTimeout(function() {
                    const perfData = performance.timing;
                    const loadTime = perfData.loadEventEnd - perfData.navigationStart;
                    
                    trackEvent('page_load_time', {
                        load_time: loadTime,
                        page_type: 'landing_page'
                    });
                }, 1000);
            });
        }
    });
    </script>

    <%# Google Analytics (if enabled) %>
    <% if (typeof process !== 'undefined' && process.env.GOOGLE_ANALYTICS_ID) { %>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GOOGLE_ANALYTICS_ID %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= process.env.GOOGLE_ANALYTICS_ID %>');
    </script>
    <% } %>
</body>
</html>