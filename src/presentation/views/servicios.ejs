<%#
Servicios (Services) Page
Services page showcasing all transportation services and experiences offered by Amexing

@param {string} title - Page title
@param {object} user - Current user session (optional)
@param {object} seo - SEO meta data
@param {object} company - Company information
@param {string} currentPage - Current page identifier

Created by Denisse Maldonado
%>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <%# Google Fonts %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
    
    <%# Font Awesome Icons %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <%# Custom Fonts CSS %>
    <link rel="stylesheet" href="/css/fonts.css">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background: #000;
            color: #333;
        }
        
        .page-hero {
            position: relative;
            width: 100%;
            height: auto;
            margin-top: 80px;
        }

        .page-hero__image {
            width: 100%;
            height: auto;
            display: block;
            object-fit: cover;
        }
    </style>
</head>
<body>
    <%# Navigation %>
    <%- include('organisms/landing/landing-navigation', {
        user: typeof user !== 'undefined' ? user : null,
        currentPage: typeof currentPage !== 'undefined' ? currentPage : 'services',
        transparent: false,
        companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null,
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Page Hero Section %>
    <section class="page-hero">
        <img src="/images/hero-services.png" alt="Servicios Amexing Experience" class="page-hero__image">
    </section>

    <%# Transporte Section %>
    <%- include('organisms/landing/transporte-section') %>

    <%# Tours Section %>
    <%- include('organisms/landing/tours-section', {
        req: typeof req !== 'undefined' ? req : null,
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Eventos Section %>
    <%- include('organisms/landing/eventos-section') %>

    <%# CTA Contacto (reutilizable) %>
    <%- include('organisms/landing/cta-contacto-section') %>

    <%# Footer %>
    <%- include('organisms/landing/landing-footer', {
        companyInfo: typeof company !== 'undefined' ? company : null
    }) %>
</body>
</html>