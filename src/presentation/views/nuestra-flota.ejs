<%#
Nuestra Flota (Fleet) Page
Fleet page showcasing Amexing Experience vehicle fleet and specifications

@param {string} title - Page title
@param {object} user - Current user session (optional)
@param {object} seo - SEO meta data
@param {object} company - Company information
@param {string} currentPage - Current page identifier

Created by Denisse Maldonado
%>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <%# Google Fonts %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
    
    <%# Font Awesome Icons %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <%# Custom Fonts CSS %>
    <link rel="stylesheet" href="/css/fonts.css">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background: #000;
            color: #333;
        }
        
        .page-hero {
            position: relative;
            min-height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(46, 46, 45, 0.9), rgba(46, 46, 45, 0.7)), url('/images/hero-background.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: white;
            text-align: center;
            margin-top: 80px;
        }

        .page-hero__container {
            max-width: 1200px;
            width: 100%;
            padding: 0 2rem;
            margin: 0 auto;
        }

        .page-hero__content {
            max-width: 600px;
            margin: 0 auto;
        }

        .page-hero__title {
            font-family: var(--font-arpona);
            font-size: clamp(3rem, 6vw, 5rem);
            font-weight: 400;
            margin-bottom: 1.5rem;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
            letter-spacing: 2px;
            font-variant: small-caps;
        }

        .page-hero__subtitle {
            font-family: 'Montserrat', sans-serif;
            font-size: clamp(1.1rem, 2vw, 1.3rem);
            font-weight: 300;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.9);
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
        }

        @media (max-width: 768px) {
            .page-hero {
                min-height: 300px;
                background-attachment: scroll;
            }
            
            .page-hero__container {
                padding: 0 1rem;
            }
        }
    </style>
</head>
<body>
    <%# Navigation %>
    <%- include('organisms/landing/landing-navigation', {
        user: typeof user !== 'undefined' ? user : null,
        currentPage: typeof currentPage !== 'undefined' ? currentPage : 'fleet',
        transparent: false,
        companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null,
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Page Hero Section %>
    <section class="page-hero">
        <div class="page-hero__container">
            <div class="page-hero__content">
                <h1 class="page-hero__title">Nuestra Flota</h1>
                <p class="page-hero__subtitle">Vehículos premium y tecnología de vanguardia</p>
            </div>
        </div>
    </section>

    <%# Fleet Section %>
    <%- include('organisms/landing/fleet-section') %>

    <%# Footer %>
    <%- include('organisms/landing/landing-footer', {
        companyInfo: typeof company !== 'undefined' ? company : null
    }) %>
</body>
</html>