<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof title !== 'undefined' ? title : 'Amexing - Transportation Management' %></title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/heart_black.png" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="/flexy-bootstrap-lite-1.0.0/assets/css/styles.min.css" />

    <!-- Tabler Icons -->
    <link rel="stylesheet" href="/dashboard/css/icons/tabler-icons/tabler-icons.css">

    <!-- Brand fonts (match landing) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/fonts.css">

    <!-- Auth-specific styles -->
    <style>
        /* Brand tokens (match landing) */
        :root {
            --amx-gold-1: #B8860B;
            --amx-gold-2: #DAA520;
            --amx-green-1: #969B81;
            --amx-green-2: #7f846a;
            --amx-charcoal: #2e2e2d;
            --amx-sage: #969B81;
            --amx-cream: #faf9f6;
            --amx-ink: #2e2e2d;
            --amx-muted: #6b6b66;
        }

        * { box-sizing: border-box; }

        body {
            font-family: var(--font-myriad), 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: radial-gradient(circle at 20% 20%, #3a3a37 0%, #2e2e2d 45%, #1c1c1b 100%);
            color: var(--amx-ink);
            min-height: 100vh;
        }

        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: stretch;
            justify-content: center;
            padding: 0;
            position: relative;
            overflow: hidden;
        }

        .auth-wrapper.with-header {
            min-height: calc(100vh - 200px);
            align-items: center;
            padding: 2rem 1rem 1rem;
        }

        /* Subtle gold grid texture */
        .auth-wrapper::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background-image:
                repeating-linear-gradient(0deg, transparent 0, transparent 27px, rgba(218, 165, 32, 0.05) 27px, rgba(218, 165, 32, 0.05) 28px),
                repeating-linear-gradient(90deg, transparent 0, transparent 27px, rgba(218, 165, 32, 0.05) 27px, rgba(218, 165, 32, 0.05) 28px);
            animation: float 26s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(28px, -28px); }
        }

        /* Split card — full screen */
        .auth-card {
            position: relative;
            z-index: 2;
            display: flex;
            width: 100%;
            max-width: none;
            min-height: 100vh;
            background: #fff;
            border-radius: 0;
            overflow: hidden;
            box-shadow: none;
        }

        /* Contained card variant (auth flows that show a header) */
        .auth-wrapper.with-header .auth-card {
            max-width: 960px;
            min-height: 600px;
            border-radius: 22px;
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
        }

        /* Brand (left) panel */
        .auth-brand {
            position: relative;
            flex: 1 1 50%;
            max-width: 50%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3rem 3.25rem 3.5rem;
            color: #fff;
            background-image:
                linear-gradient(180deg, rgba(20, 20, 19, 0.25) 0%, rgba(20, 20, 19, 0.55) 55%, rgba(18, 18, 17, 0.92) 100%),
                url('/images/SUBS-Privados.jpg');
            background-size: cover;
            background-position: center;
        }

        .auth-brand__logo img {
            height: 46px;
            width: auto;
            filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
        }

        .auth-brand__content {
            margin-top: auto;
            max-width: 26rem;
        }

        .auth-brand__eyebrow {
            display: inline-block;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--amx-gold-2);
            margin-bottom: 0.85rem;
        }

        .auth-brand__rule {
            width: 52px;
            height: 2px;
            border: 0;
            margin: 0 0 1.1rem;
            background: linear-gradient(135deg, var(--amx-gold-1), var(--amx-gold-2));
            opacity: 1;
        }

        .auth-brand__title {
            font-family: var(--font-arpona), 'Montserrat', serif;
            font-size: 2.55rem;
            font-weight: 400;
            line-height: 1.12;
            letter-spacing: 0.2px;
            margin: 0 0 1rem;
            color: #ffffff;
            text-shadow: 0 2px 16px rgba(0, 0, 0, 0.55);
        }

        .auth-brand__subtitle {
            font-size: 1rem;
            font-weight: 300;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.85);
            margin: 0;
            text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
        }

        /* Body (right) panel */
        .auth-body {
            flex: 1 1 50%;
            max-width: 50%;
            background: var(--amx-cream);
            padding: 3rem 3.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            overflow-y: auto;
        }

        /* Legacy single-logo block hidden in the split layout */
        .auth-logo { display: none; }

        /* Form controls */
        .form-control {
            background: #fff;
            border: 1px solid #e2ded3;
            border-radius: 12px;
            padding: 0.8rem 1rem;
            font-size: 0.975rem;
            transition: all 0.25s ease;
        }

        .form-control:focus {
            background: #fff;
            border-color: var(--amx-gold-2);
            box-shadow: 0 0 0 3px rgba(218, 165, 32, 0.16);
        }

        /* Buttons */
        .btn {
            border-radius: 12px;
            padding: 0.8rem 1.4rem;
            font-weight: 600;
            font-size: 0.975rem;
            letter-spacing: 0.2px;
            transition: all 0.25s ease;
            border: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--amx-green-1) 0%, var(--amx-green-2) 100%);
            color: #fff;
            box-shadow: 0 8px 22px rgba(127, 132, 106, 0.35);
        }

        .btn-primary:hover,
        .btn-primary:focus {
            background: linear-gradient(135deg, #878c6e 0%, #6e7259 100%);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(127, 132, 106, 0.45);
        }

        /* Loading Animation */
        .auth-loading {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(28, 28, 27, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .auth-loading.show {
            opacity: 1;
            visibility: visible;
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(218, 165, 32, 0.25);
            border-radius: 50%;
            border-top-color: var(--amx-gold-2);
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Accessibility */
        .sr-only {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            padding: 0 !important;
            margin: -1px !important;
            overflow: hidden !important;
            clip: rect(0,0,0,0) !important;
            white-space: nowrap !important;
            border: 0 !important;
        }

        /* Focus indicators */
        a:focus,
        button:focus,
        input:focus,
        select:focus,
        textarea:focus {
            outline: 2px solid var(--amx-gold-2);
            outline-offset: 2px;
        }

        /* Responsive: stack the panels */
        @media (max-width: 860px) {
            .auth-card {
                flex-direction: column;
            }

            .auth-wrapper.with-header .auth-card {
                max-width: 480px;
                min-height: 0;
            }

            .auth-brand,
            .auth-body {
                max-width: 100%;
                flex-basis: auto;
            }

            .auth-brand {
                min-height: 210px;
                padding: 1.75rem;
            }

            .auth-body {
                padding: 2.5rem 1.5rem;
            }
        }
    </style>

    <!-- Page-specific styles -->
    <% if (typeof additionalStyles !== 'undefined' && additionalStyles && Array.isArray(additionalStyles)) { %>
        <% additionalStyles.forEach(function(style) { %>
            <% if (typeof style === 'string' && (style.startsWith('/') || style.startsWith('https://cdnjs.cloudflare.com/'))) { %>
            <link rel="stylesheet" href="<%= style %>" />
            <% } %>
        <% }); %>
    <% } %>
</head>

<body>
    <!-- Loading Screen -->
    <div class="auth-loading" id="authLoader">
        <div class="loading-spinner"></div>
        <span class="sr-only">Loading...</span>
    </div>

    <!-- Auth Header (if requested) -->
    <% if (typeof showAuthHeader !== 'undefined' && showAuthHeader && typeof headerConfig !== 'undefined') { %>
        <%- include('../organisms/auth/auth-header', {
            page: typeof page !== 'undefined' ? page : 'login',
            title: headerConfig.title,
            subtitle: headerConfig.subtitle,
            corporate: headerConfig.corporate,
            showLogo: typeof headerConfig.showLogo !== 'undefined' ? headerConfig.showLogo : true,
            showNavigation: typeof headerConfig.showNavigation !== 'undefined' ? headerConfig.showNavigation : true,
            breadcrumbs: headerConfig.breadcrumbs
        }) %>
    <% } %>

    <!-- Auth Wrapper -->
    <div class="auth-wrapper <%= typeof showAuthHeader !== 'undefined' && showAuthHeader ? 'with-header' : '' %>">
        <div class="auth-card">
            <!-- Brand panel -->
            <aside class="auth-brand">
                <div class="auth-brand__logo">
                    <img src="/images/logos/light_white_amexing.png" alt="Amexing Experience">
                </div>
                <%
                    const hasAuthT = typeof t === 'function';
                    const ab = (key, fallback) => {
                        if (!hasAuthT) return fallback;
                        const v = t(`pages:auth.brand.${key}`);
                        return (v && v !== `pages:auth.brand.${key}`) ? v : fallback;
                    };
                %>
                <div class="auth-brand__content">
                    <span class="auth-brand__eyebrow"><%= ab('welcome', 'Bienvenido') %></span>
                    <hr class="auth-brand__rule">
                    <h2 class="auth-brand__title"><%= ab('title', 'La mejor experiencia de viaje empieza aquí') %></h2>
                    <p class="auth-brand__subtitle"><%= ab('subtitle', 'Plataforma premium de gestión de reservaciones') %></p>
                </div>
            </aside>

            <!-- Body panel -->
            <div class="auth-body">
                <!-- Flash Messages (only show if no content or body - content handles its own messages) -->
                <% if (!(typeof body !== 'undefined' && body) && !(typeof content !== 'undefined' && content)) { %>
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="ti ti-alert-circle me-2"></i>
                            <div><%= error %></div>
                        </div>
                    <% } %>

                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                            <i class="ti ti-circle-check me-2"></i>
                            <div><%= success %></div>
                        </div>
                    <% } %>
                <% } %>

                <!-- Content -->
                <div class="auth-content">
                    <% if (typeof content !== 'undefined' && content) { %>
                        <!-- New atomic design content -->
                        <%- content %> <%# nosemgrep: trusted pre-rendered atomic component content %>
                    <% } else if (typeof body !== 'undefined' && body) { %>
                        <!-- Legacy body content -->
                        <%- body %> <%# nosemgrep: trusted pre-rendered template content %>
                    <% } else { %>
                        <!-- Default forgot password form if no content provided -->
                        <%- include('../molecules/auth/forgot-password-form', {
                            error: typeof error !== 'undefined' ? error : '',
                            success: typeof success !== 'undefined' ? success : '',
                            csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : '',
                            email: typeof email !== 'undefined' ? email : '',
                            showBackToLogin: true
                        }) %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Core JavaScript -->
    <script src="/dashboard/libs/jquery.min.js"></script>
    <script src="/dashboard/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Auth Layout Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loader = document.getElementById('authLoader');
            const urlParams = new URLSearchParams(window.location.search);

            // Check if this is a redirect from a failed form submission
            const isErrorRedirect = urlParams.has('error') || urlParams.has('message');

            if (isErrorRedirect) {
                // Immediately hide loader for error redirects - no delay
                if (loader) {
                    loader.classList.remove('show');
                    // Force hide the loader by setting styles directly
                    loader.style.opacity = '0';
                    loader.style.visibility = 'hidden';
                    loader.style.display = 'none';
                }

                // Reset all submit buttons to normal state
                const submitBtns = document.querySelectorAll('button[type="submit"]');
                submitBtns.forEach(btn => {
                    btn.disabled = false;

                    // Restore original button text if available, otherwise use default
                    if (btn.dataset.originalText) {
                        btn.innerHTML = btn.dataset.originalText;
                    } else {
                        // Default text for login button
                        btn.innerHTML = '<i class="ti ti-login me-2"></i>Iniciar Sesión';
                    }
                });
            } else {
                // Normal page load - hide loader with delay for smooth transition
                if (loader) {
                    setTimeout(() => {
                        loader.classList.remove('show');
                    }, 300);
                }
            }

            // Smooth form animations
            const inputs = document.querySelectorAll('.form-control');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.classList.add('focused');
                });

                input.addEventListener('blur', function() {
                    if (!this.value) {
                        this.parentElement.classList.remove('focused');
                    }
                });

                // Pre-fill animation for auto-filled inputs
                if (input.value) {
                    input.parentElement.classList.add('focused');
                }
            });

            // Form submission loading state
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function(event) {
                    // Check if form validation will pass before showing loading state
                    if (form.checkValidity()) {
                        const submitBtn = form.querySelector('button[type="submit"]');
                        if (submitBtn && !submitBtn.disabled) {
                            // Store original button text for restoration
                            if (!submitBtn.dataset.originalText) {
                                submitBtn.dataset.originalText = submitBtn.innerHTML;
                            }

                            submitBtn.innerHTML = `
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Processing...
                            `;
                            submitBtn.disabled = true;
                        }

                        if (loader) {
                            loader.classList.add('show');
                        }
                    }
                    // If validation fails, don't show loading state - let validation messages appear
                });
            });

            // Auto-dismiss alerts
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                if (alert.classList.contains('alert-success')) {
                    setTimeout(() => {
                        // Check if bootstrap is available
                        if (typeof bootstrap !== 'undefined' && bootstrap.Alert) {
                            const bsAlert = new bootstrap.Alert(alert);
                            bsAlert.close();
                        } else {
                            // Fallback: simple fade out
                            alert.style.transition = 'opacity 0.5s ease';
                            alert.style.opacity = '0';
                            setTimeout(() => {
                                if (alert.parentNode) {
                                    alert.parentNode.removeChild(alert);
                                }
                            }, 500);
                        }
                    }, 5000);
                }
            });

            // Enhanced security
            document.addEventListener('keydown', function(e) {
                // Prevent F12, Ctrl+Shift+I, Ctrl+U in production
                if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
                    if (e.key === 'F12' ||
                        (e.ctrlKey && e.shiftKey && e.key === 'I') ||
                        (e.ctrlKey && e.key === 'U')) {
                        e.preventDefault();
                        return false;
                    }
                }
            });

        });

        // Global error handler
        window.addEventListener('error', function(e) {
            console.error('Auth error:', e.error);
        });

        // Safety mechanism: Hide loader when page becomes visible (handles tab switching, etc.)
        document.addEventListener('visibilitychange', function() {
            if (!document.hidden) {
                const loader = document.getElementById('authLoader');
                const urlParams = new URLSearchParams(window.location.search);

                // If there are error/message parameters, ensure loader is hidden
                if ((urlParams.has('error') || urlParams.has('message')) && loader) {
                    loader.classList.remove('show');
                    loader.style.opacity = '0';
                    loader.style.visibility = 'hidden';
                    loader.style.display = 'none';
                }
            }
        });

        // Prevent context menu in production
        if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
            document.addEventListener('contextmenu', function(e) {
                e.preventDefault();
                return false;
            });
        }
    </script>

    <!-- Page-specific scripts -->
    <% if (typeof additionalScripts !== 'undefined' && additionalScripts && Array.isArray(additionalScripts)) { %>
        <% additionalScripts.forEach(function(script) { %>
            <% if (typeof script === 'string' && (script.startsWith('/') || script.startsWith('https://cdnjs.cloudflare.com/'))) { %>
            <script src="<%= script %>"></script> <%# nosemgrep: allowlisted script paths %>
            <% } %>
        <% }); %>
    <% } %>

</body>

</html>
