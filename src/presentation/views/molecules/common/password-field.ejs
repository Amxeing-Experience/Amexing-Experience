<%
/**
 * Reusable password field: input + generar + mostrar/ocultar + copiar + checklist de requisitos
 * en tiempo real. Self-contained (su propio <script> scopeado por id), igual al del form de agencia.
 * Params: id (req), name, label, required (bool, default false), helpText,
 *   showGenerate (default true), showCopy (default true).
 * Created by Denisse Maldonado
 */
const pfId = (typeof id !== 'undefined' && id) ? id : 'password';
const pfName = (typeof name !== 'undefined' && name) ? name : 'password';
const pfLabel = (typeof label !== 'undefined' && label) ? label : 'Contraseña';
const pfRequired = (typeof required !== 'undefined') ? required : false;
const pfHelp = (typeof helpText !== 'undefined' && helpText) ? helpText : '';
const pfShowGenerate = (typeof showGenerate !== 'undefined') ? showGenerate : true;
const pfShowCopy = (typeof showCopy !== 'undefined') ? showCopy : true;
%>
<div class="mb-3">
    <label for="<%= pfId %>" class="form-label fw-semibold">
        <%= pfLabel %> <% if (pfRequired) { %><span class="text-danger">*</span><% } else { %><span class="text-muted fw-normal">(opcional)</span><% } %>
    </label>
    <div class="input-group">
        <input
            type="password"
            class="form-control"
            id="<%= pfId %>"
            name="<%= pfName %>"
            placeholder="Contraseña segura"
            minlength="12"
            maxlength="100"
            autocomplete="new-password"
            <%= pfRequired ? 'required' : '' %>
        >
        <% if (pfShowGenerate) { %>
        <button class="btn btn-outline-primary" type="button" id="<%= pfId %>Generate" title="Generar contraseña segura">
            <i class="ti ti-key" id="<%= pfId %>GenerateIcon"></i>
        </button>
        <% } %>
        <button class="btn btn-outline-secondary" type="button" id="<%= pfId %>Toggle" title="Mostrar/Ocultar contraseña" tabindex="-1">
            <i class="ti ti-eye" id="<%= pfId %>ToggleIcon"></i>
        </button>
        <% if (pfShowCopy) { %>
        <button class="btn btn-outline-secondary" type="button" id="<%= pfId %>Copy" title="Copiar contraseña" tabindex="-1">
            <i class="ti ti-copy" id="<%= pfId %>CopyIcon"></i>
        </button>
        <% } %>
    </div>
    <div class="form-text">Mínimo 12 caracteres, incluir mayúsculas, minúsculas, números y caracteres especiales</div>
    <% if (pfHelp) { %><div class="form-text"><%= pfHelp %></div><% } %>
    <div class="invalid-feedback" id="<%= pfId %>Feedback" style="display:none;">
        <ul class="mb-0">
            <li data-req="length" class="text-danger"><i class="ti ti-x-circle me-1"></i>Mínimo 12 caracteres</li>
            <li data-req="upper" class="text-danger"><i class="ti ti-x-circle me-1"></i>Al menos una letra mayúscula</li>
            <li data-req="lower" class="text-danger"><i class="ti ti-x-circle me-1"></i>Al menos una letra minúscula</li>
            <li data-req="number" class="text-danger"><i class="ti ti-x-circle me-1"></i>Al menos un número</li>
            <li data-req="special" class="text-danger"><i class="ti ti-x-circle me-1"></i>Al menos un carácter especial (!@#$%^&amp;*...)</li>
        </ul>
    </div>
</div>
<script>
(function () {
    var inp = document.getElementById('<%= pfId %>');
    if (!inp) return;
    var tgl = document.getElementById('<%= pfId %>Toggle');
    var ico = document.getElementById('<%= pfId %>ToggleIcon');
    var genBtn = document.getElementById('<%= pfId %>Generate');
    var copyBtn = document.getElementById('<%= pfId %>Copy');
    var copyIco = document.getElementById('<%= pfId %>CopyIcon');
    var fb = document.getElementById('<%= pfId %>Feedback');

    function check(v) {
        var reqs = {
            length: v.length >= 12,
            upper: /[A-Z]/.test(v),
            lower: /[a-z]/.test(v),
            number: /\d/.test(v),
            special: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(v)
        };
        if (fb) {
            fb.querySelectorAll('[data-req]').forEach(function (li) {
                var ok = reqs[li.getAttribute('data-req')];
                li.classList.toggle('text-success', ok);
                li.classList.toggle('text-danger', !ok);
                var i = li.querySelector('i');
                if (i) i.className = ok ? 'ti ti-check-circle me-1' : 'ti ti-x-circle me-1';
            });
        }
        var all = Object.keys(reqs).every(function (k) { return reqs[k]; });
        var has = v.length > 0;
        if (fb) fb.style.display = (has && !all) ? 'block' : 'none';
        inp.classList.toggle('is-invalid', has && !all);
        inp.classList.toggle('is-valid', has && all);
        return all;
    }

    function generate() {
        var lower = 'abcdefghijklmnopqrstuvwxyz';
        var upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
        var nums = '0123456789';
        var special = '!@#$%^&*';
        var all = lower + upper + nums + special;
        var pwd = lower[Math.floor(Math.random() * lower.length)]
            + upper[Math.floor(Math.random() * upper.length)]
            + nums[Math.floor(Math.random() * nums.length)]
            + special[Math.floor(Math.random() * special.length)];
        for (var i = 0; i < 8; i += 1) pwd += all[Math.floor(Math.random() * all.length)];
        return pwd.split('').sort(function () { return Math.random() - 0.5; }).join('');
    }

    if (tgl && ico) {
        tgl.addEventListener('click', function () {
            var isPwd = inp.type === 'password';
            inp.type = isPwd ? 'text' : 'password';
            ico.className = isPwd ? 'ti ti-eye-off' : 'ti ti-eye';
            tgl.title = isPwd ? 'Ocultar contraseña' : 'Mostrar contraseña';
        });
    }
    if (genBtn) {
        genBtn.addEventListener('click', function () {
            inp.type = 'text';
            if (ico) ico.className = 'ti ti-eye-off';
            inp.value = generate();
            check(inp.value);
        });
    }
    if (copyBtn && copyIco) {
        copyBtn.addEventListener('click', function () {
            if (!inp.value.trim()) return;
            navigator.clipboard.writeText(inp.value).then(function () {
                var prev = copyIco.className;
                copyIco.className = 'ti ti-check';
                copyBtn.classList.remove('btn-outline-secondary');
                copyBtn.classList.add('btn-success');
                setTimeout(function () {
                    copyIco.className = prev;
                    copyBtn.classList.remove('btn-success');
                    copyBtn.classList.add('btn-outline-secondary');
                }, 1500);
            });
        });
    }
    inp.addEventListener('input', function () { check(this.value); });
    inp.addEventListener('paste', function () { var self = this; setTimeout(function () { check(self.value); }, 10); });
})();
</script>
