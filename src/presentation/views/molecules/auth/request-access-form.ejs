<%
/**
 * Request Access Form Molecule
 * Agency access request form with mailto functionality
 *
 * @param {string} csrfToken - CSRF token for form security
 * @param {string} supportEmail - Environment-specific support email
 */

// Default parameters
const accessCsrfToken = typeof csrfToken !== 'undefined' ? csrfToken : '';
const accessSupportEmail = typeof supportEmail !== 'undefined' ? supportEmail : 'support@amexing.com';
const accessError = typeof error !== 'undefined' && error ? error : null;
const accessOAuthAttempted = typeof oauth_attempted !== 'undefined' ? oauth_attempted : null;
const accessUserEmail = typeof email !== 'undefined' ? email : null;
%>

<div class="request-access-container">
    <!-- Header -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark mb-3">Solicitud de Acceso - Agencias</h2>
        <p class="text-muted lead">Únete a la plataforma exclusiva de gestión de transporte ejecutivo</p>
    </div>

    <!-- Account Status Messages -->
    <% if (accessError === 'account_deactivated') { %>
        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
            <i class="ti ti-alert-triangle me-2"></i>
            <div>
                <strong>Cuenta Desactivada:</strong> Tu cuenta ha sido desactivada. 
                Por favor contacta a soporte en 
                <a href="mailto:<%= accessSupportEmail %>" class="alert-link"><%= accessSupportEmail %></a>
                para reactivar tu acceso.
            </div>
        </div>
    <% } else if (accessOAuthAttempted) { %>
        <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
            <i class="ti ti-info-circle me-2"></i>
            <div>
                <strong>Cuenta de <% if (accessOAuthAttempted === 'google') { %>Google<% } else { %><%= accessOAuthAttempted %><% } %> detectada:</strong>
                Para usar este método de inicio de sesión, necesitas solicitar acceso como agencia.
                <% if (accessUserEmail) { %>
                    <br><small class="text-muted">Email detectado: <%= accessUserEmail %></small>
                <% } %>
            </div>
        </div>
    <% } %>

    <!-- About Amexing -->
    <div class="about-section mb-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="card-title mb-3">
                    <i class="ti ti-info-circle me-2 text-primary"></i>
                    Sobre Amexing Experience
                </h5>
                <p class="card-text mb-3">
                    Amexing Experience es una plataforma exclusiva de gestión de servicios de transporte, 
                    tours y experiencias únicas, diseñada especialmente para agencias de viajes y empresas 
                    que buscan ofrecer servicios completos y memorables a sus clientes.
                </p>
                <p class="card-text text-muted mb-0">
                    <strong>El acceso requiere aprobación administrativa</strong> para garantizar la calidad 
                    y exclusividad de nuestros servicios.
                </p>
            </div>
        </div>
    </div>

    <!-- Benefits for Agencies -->
    <div class="benefits-section mb-5">
        <h5 class="mb-4">
            <i class="ti ti-star me-2 text-warning"></i>
            Beneficios para Agencias
        </h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="benefit-item">
                    <i class="ti ti-settings text-primary me-2"></i>
                    <span>Gestión centralizada de servicios</span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="benefit-item">
                    <i class="ti ti-discount text-success me-2"></i>
                    <span>Tarifas preferenciales</span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="benefit-item">
                    <i class="ti ti-map-pin text-warning me-2"></i>
                    <span>Tours y experiencias exclusivas</span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="benefit-item">
                    <i class="ti ti-car text-info me-2"></i>
                    <span>Transporte de todas las categorías</span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="benefit-item">
                    <i class="ti ti-chart-bar text-purple me-2"></i>
                    <span>Reportes detallados</span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="benefit-item">
                    <i class="ti ti-headset text-danger me-2"></i>
                    <span>Soporte dedicado</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Request Access Button -->
    <div class="text-center mb-5">
        <button 
            type="button" 
            class="btn btn-primary btn-lg px-5 py-3" 
            id="requestAccessBtn"
        >
            <i class="ti ti-mail-forward me-2"></i>
            Enviar Solicitud de Acceso
        </button>
        <p class="text-muted mt-3 small">
            Se abrirá tu cliente de correo con un formulario predefinido
        </p>
    </div>

    <!-- Back to Login -->
    <div class="text-center mt-5 pt-4 border-top">
        <p class="text-muted mb-0">
            ¿Ya tienes una cuenta?
            <a href="/login" class="text-primary text-decoration-none fw-semibold">
                <i class="ti ti-arrow-left me-1"></i>Volver al Login
            </a>
        </p>
    </div>

    <!-- Contact Information -->
    <div class="text-center mt-4">
        <small class="text-muted">
            ¿Necesitas ayuda?
            <a href="mailto:<%= accessSupportEmail %>?subject=Consulta%20sobre%20Solicitud%20de%20Acceso" 
               class="text-primary text-decoration-none">
                Contactar Soporte
            </a>
        </small>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    <div id="deactivationToast" class="toast align-items-center text-white bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="ti ti-alert-triangle me-2"></i>
                <strong>Cuenta Desactivada:</strong> Tu cuenta ha sido desactivada. Por favor contacta a soporte para reactivar tu acceso.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    .request-access-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 4rem;
    }


    .about-section .card {
        background: rgba(248, 249, 250, 0.5);
        border-radius: 16px;
        transition: transform 0.2s ease;
        border: 1px solid rgba(102, 126, 234, 0.08);
        max-width: 100%;
        margin: 0 auto;
    }

    .about-section .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.15);
    }

    .benefit-item {
        padding: 1rem 1.25rem;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 12px;
        border: 1px solid rgba(102, 126, 234, 0.1);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        box-shadow: 0 2px 8px rgba(102, 126, 234, 0.05);
        height: 100%;
    }

    .benefit-item:hover {
        background: rgba(102, 126, 234, 0.08);
        border-color: rgba(102, 126, 234, 0.25);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(102, 126, 234, 0.12);
    }

    .benefit-item i {
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .benefit-item span {
        font-weight: 500;
        color: #495057;
    }

    #requestAccessBtn {
        background: linear-gradient(135deg, #667eea, #764ba2);
        border: none;
        border-radius: 50px;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    #requestAccessBtn:hover {
        background: linear-gradient(135deg, #764ba2, #667eea);
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(102, 126, 234, 0.4);
    }

    #requestAccessBtn:active {
        transform: translateY(0);
        box-shadow: 0 6px 16px rgba(102, 126, 234, 0.3);
    }

    /* Enhanced spacing for sections */
    .benefits-section {
        margin-bottom: 2.5rem;
    }

    .about-section {
        margin-bottom: 2.5rem;
    }

    .benefits-section .row {
        justify-content: center;
        max-width: 100%;
    }

    /* Responsive adjustments */
    @media (max-width: 1400px) {
        .request-access-container {
            max-width: 90%;
            padding: 2rem 3rem;
        }
    }

    @media (max-width: 1200px) {
        .request-access-container {
            max-width: 85%;
            padding: 2rem 2.5rem;
        }
    }

    @media (max-width: 992px) {
        .request-access-container {
            max-width: 90%;
            padding: 2rem 2rem;
        }
    }

    @media (max-width: 768px) {
        .request-access-container {
            max-width: 95%;
            padding: 1.5rem 1.5rem;
        }

        .benefits-section .row {
            gap: 0.5rem 0;
        }
    }

    @media (max-width: 576px) {
        .request-access-container {
            max-width: 100%;
            padding: 1rem;
        }

        #requestAccessBtn {
            padding: 0.75rem 2rem !important;
            font-size: 1rem;
        }

        .benefit-item {
            padding: 0.75rem 1rem;
        }
    }

    /* Accessibility improvements */
    @media (prefers-reduced-motion: reduce) {
        .shimmer,
        .benefit-item {
            animation: none;
            transition: none;
        }
        
        #requestAccessBtn:hover {
            transform: none;
        }
    }

    /* Print styles */
    @media print {
        .request-access-container {
            color: black !important;
        }
        
        #requestAccessBtn {
            display: none;
        }
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('🎬 CLIENT: Request access page loaded');
    
    // Add visual feedback for better UX
    const requestBtn = document.getElementById('requestAccessBtn');
    
    if (requestBtn) {
        // Add click event listener
        requestBtn.addEventListener('click', sendAccessRequest);
        
        requestBtn.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-2px) scale(1.02)';
        });
        
        requestBtn.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0) scale(1)';
        });
    }

    // Handle toast messaging for deactivated accounts
    const urlParams = new URLSearchParams(window.location.search);
    const showToast = urlParams.get('toast') === 'true';
    const errorType = urlParams.get('error');
    
    if (showToast && errorType === 'account_deactivated') {
        // Show the deactivation toast
        const toastElement = document.getElementById('deactivationToast');
        if (toastElement) {
            const toast = new bootstrap.Toast(toastElement, {
                autohide: false, // Keep it visible until manually dismissed
            });
            toast.show();
        }
    }
    
    // Optional analytics
    if (typeof gtag !== 'undefined') {
        gtag('event', 'page_view', {
            page_title: 'Agency Access Request',
            page_location: window.location.href
        });
    }
});

function sendAccessRequest() {
    console.log('🎬 CLIENT: Sending access request via mailto');
    
    const supportEmail = '<%= accessSupportEmail %>';
    const subject = encodeURIComponent('Solicitud de Acceso - Agencia');
    
    const emailBody = encodeURIComponent(`Estimado equipo de Amexing,

Me dirijo a ustedes para solicitar acceso a la plataforma Amexing Experience para mi agencia.

INFORMACIÓN DE LA AGENCIA:
- Nombre de Agencia: [Escribir nombre de la agencia]
- Nombre del Solicitante: [Escribir nombre completo]
- Cargo: [Escribir cargo/posición]
- Teléfono de Contacto: [Escribir teléfono]
- Email de Contacto: [Escribir email]
- Sitio Web: [Escribir URL si tiene]

INFORMACIÓN DEL NEGOCIO:
- Volumen Estimado Mensual: [Escribir cantidad estimada de servicios]
- Tipo de Clientes que Maneja: [Describir perfil de clientes]
- Ciudades donde Opera: [Escribir ciudades principales]
- Años en el Negocio: [Escribir años de experiencia]
- Especialidad Principal: [Turismo, Corporativo, Eventos, etc.]

SERVICIOS DE INTERÉS:
- [ ] Transporte ejecutivo y empresarial
- [ ] Transporte estándar y económico  
- [ ] Traslados aeroportuarios
- [ ] Tours y excursiones guiadas
- [ ] Experiencias gastronómicas
- [ ] Experiencias culturales y recreativas
- [ ] Eventos corporativos y sociales
- [ ] Servicios para grupos grandes
- [ ] Otros: [Especificar]

EXPERIENCIAS Y TOURS ESPECÍFICOS:
- [ ] City tours urbanos
- [ ] Tours gastronómicos
- [ ] Experiencias nocturnas
- [ ] Tours culturales e históricos
- [ ] Aventura y naturaleza
- [ ] Experiencias personalizadas

COMENTARIOS ADICIONALES:
[Escribir cualquier información adicional que considere relevante sobre los servicios que busca para sus clientes]

Agradezco de antemano su atención y quedo en espera de su respuesta.

Saludos cordiales`);
    
    const mailtoLink = `mailto:${supportEmail}?subject=${subject}&body=${emailBody}`;
    
    // Track the action
    if (typeof gtag !== 'undefined') {
        gtag('event', 'agency_access_request', {
            method: 'mailto',
            support_email: supportEmail
        });
    }
    
    // Open mailto link
    window.location.href = mailtoLink;
    
    // Show confirmation message
    showConfirmationMessage();
}

function showConfirmationMessage() {
    const btn = document.getElementById('requestAccessBtn');
    const originalContent = btn.innerHTML;
    
    btn.innerHTML = `
        <i class="ti ti-check me-2"></i>
        Solicitud Enviada
    `;
    btn.classList.add('btn-success');
    btn.classList.remove('btn-primary');
    btn.disabled = true;
    
    // Reset button after 3 seconds
    setTimeout(() => {
        btn.innerHTML = originalContent;
        btn.classList.remove('btn-success');
        btn.classList.add('btn-primary');
        btn.disabled = false;
    }, 3000);
    
    // Show additional message
    const container = document.querySelector('.request-access-container');
    const successMessage = document.createElement('div');
    successMessage.className = 'alert alert-success mt-3';
    successMessage.innerHTML = `
        <i class="ti ti-circle-check me-2"></i>
        <strong>¡Perfecto!</strong> Tu cliente de correo debería haberse abierto con el formulario predefinido. 
        Complete la información y envíe el email para procesar su solicitud.
    `;
    
    btn.parentNode.appendChild(successMessage);
    
    // Remove message after 5 seconds
    setTimeout(() => {
        if (successMessage.parentNode) {
            successMessage.remove();
        }
    }, 5000);
}
</script>