<%
const clientId = locals.clientId || '';
const companyName = locals.companyName || 'Company';
%>

<!-- Page Header -->
<div class="mb-4">
  <h4 class="fw-semibold mb-2">My Team</h4>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <a class="text-muted text-decoration-none" href="/dashboard/client">Dashboard</a>
      </li>
      <li class="breadcrumb-item" aria-current="page">My Team</li>
    </ol>
  </nav>
</div>

<!-- Client Information Section -->
<div class="row mb-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm" id="client-info-section">
      <div class="card-header bg-dark text-white">
        <div>
          <h5 class="card-title mb-1 text-white">
            <i class="ti ti-user me-2"></i>Datos del Agente Admin
          </h5>
          <p class="text-white-50 mb-0">Información del agente admin</p>
        </div>
      </div>
      
      <div class="card-body">
        <!-- Loading state -->
        <div id="client-info-loading" class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando información...</span>
          </div>
          <p class="text-muted mt-2">Cargando información del agente admin...</p>
        </div>
        
        <!-- Client info container -->
        <div id="client-info-container" class="d-none">
          <!-- Info will be populated here via JavaScript -->
        </div>
        
        <!-- Error state -->
        <div id="client-info-error" class="text-center py-4 d-none">
          <div class="text-danger">
            <i class="ti ti-alert-circle" style="font-size: 2rem; opacity: 0.3;"></i>
            <p class="mt-2 mb-2">Error al cargar información del agente admin</p>
            <button class="btn btn-outline-primary btn-sm" onclick="loadClientInfo()">
              <i class="ti ti-reload me-1"></i>Reintentar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Team Management Section -->
<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <div class="mb-4">
          <h4 class="card-title fw-semibold">Team Members</h4>
        </div>

        <!-- Include Employees DataTable -->
        <%
        // Check if admin is viewing
        const actualUserRole = locals.user && locals.user.role ? locals.user.role : locals.userRole;
        
        if (actualUserRole === 'admin' || actualUserRole === 'superadmin') { %>
          <div class="alert alert-info d-flex align-items-center" role="alert">
            <i class="ti ti-info-circle me-2"></i>
            <div>
              <strong>Vista de Administrador</strong><br>
              Esta es una vista de demostración. Los administradores no tienen un equipo asignado. 
              Para ver datos reales de equipo, debe iniciar sesión como un Cliente (Agente).
            </div>
          </div>
        <% } else if (clientId) { %>
          <%- include('../../organisms/datatable/employees-table', {
            tableId: 'client-team-table',
            apiEndpoint: `/api/clients/${clientId}/employees`,
            userRole: 'client',
            showActions: true,
            clientId: clientId,
            currentUserId: currentUserId,
            accessToken: locals.accessToken || ''
          }) %>
        <% } else { %>
          <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="ti ti-alert-triangle me-2"></i>
            <div>
              <strong>Configuración Requerida</strong><br>
              No se ha configurado un ID de cliente para este usuario. Contacte al administrador del sistema.
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<!-- Create Employee Modal -->
<div class="modal fade" id="createEmployeeModal" tabindex="-1" aria-labelledby="createEmployeeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title text-white" id="createEmployeeModalLabel">
          <i class="ti ti-user-plus me-2"></i>Crear Nuevo Empleado
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <!-- Alert container for modal messages -->
        <div id="modalAlertContainer" class="mb-3" style="display: none;"></div>
        
        <form id="addTeamMemberForm">
          <div class="mb-3">
            <label for="firstName" class="form-label">Nombre <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="firstName" placeholder="Ej: Juan" required>
          </div>
          <div class="mb-3">
            <label for="lastName" class="form-label">Apellido <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="lastName" placeholder="Ej: Pérez García" required>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email Corporativo <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="email" placeholder="empleado@empresa.com" required>
            <div class="form-text">Email del empleado para acceso al sistema</div>
          </div>
          
          <!-- Password Field -->
          <div class="mb-3">
            <label for="password" class="form-label">Contraseña <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="password" class="form-control" id="password" placeholder="Mínimo 12 caracteres" minlength="12" required>
              <button class="btn btn-outline-primary" type="button" id="generatePassword" title="Generar contraseña segura">
                <i class="ti ti-key" id="generateIcon"></i>
              </button>
              <button class="btn btn-outline-secondary" type="button" id="togglePasswordVisibility" title="Mostrar/Ocultar contraseña">
                <i class="ti ti-eye" id="passwordToggleIcon"></i>
              </button>
              <button class="btn btn-outline-secondary" type="button" id="copyPassword" title="Copiar contraseña">
                <i class="ti ti-copy" id="copyIcon"></i>
              </button>
            </div>
            <div class="form-text">Mínimo 12 caracteres. El empleado podrá cambiarla después.</div>
          </div>
          
          <div class="mb-3">
            <label for="role" class="form-label">Rol <span class="text-danger">*</span></label>
            <select class="form-select" id="role" required>
              <option value="">Seleccionar rol...</option>
              <option value="employee">Employee (Empleado estándar)</option>
              <option value="client">Agent (Agente Admin)</option>
            </select>
          </div>
          
          <!-- Phone Field (Optional) -->
          <div class="mb-3">
            <label for="phone" class="form-label">Teléfono de Contacto</label>
            <input type="tel" class="form-control" id="phone" placeholder="Ej: +52 55 1234 5678">
            <div class="form-text">Opcional - Número de contacto del empleado</div>
          </div>
          
          <!-- Notes Field (Optional) -->
          <div class="mb-3">
            <label for="notes" class="form-label">Notas Adicionales</label>
            <textarea class="form-control" id="notes" rows="3" placeholder="Información relevante sobre el empleado..."></textarea>
            <small class="text-muted float-end"><span id="notesCharCount">0</span>/500</small>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="saveTeamMemberBtn">
          <i class="ti ti-device-floppy me-2"></i>Crear Empleado
        </button>
      </div>
    </div>
  </div>
</div>

<script>
    // Initialize all modal functionality when DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
      // Display static client information
      displayStaticRepresentativeInfo();
      
      // Add save button event listener
      const saveBtn = document.getElementById('saveTeamMemberBtn');
      if (saveBtn) {
        saveBtn.addEventListener('click', function() {
          saveTeamMember();
        });
      }
      
      // Character counter for notes
      const notesTextarea = document.getElementById('notes');
      const charCounter = document.getElementById('notesCharCount');
      
      if (notesTextarea && charCounter) {
        notesTextarea.addEventListener('input', function() {
          charCounter.textContent = this.value.length;
        });
      }
      
      // Password field functionality
      const passwordInput = document.getElementById('password');
      const toggleBtn = document.getElementById('togglePasswordVisibility');
      const toggleIcon = document.getElementById('passwordToggleIcon');
      const generateBtn = document.getElementById('generatePassword');
      const generateIcon = document.getElementById('generateIcon');
      const copyBtn = document.getElementById('copyPassword');
      const copyIcon = document.getElementById('copyIcon');
      
      // Toggle password visibility
      if (toggleBtn && passwordInput && toggleIcon) {
        toggleBtn.addEventListener('click', function() {
          if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleIcon.classList.remove('ti-eye');
            toggleIcon.classList.add('ti-eye-off');
            toggleBtn.title = 'Ocultar contraseña';
          } else {
            passwordInput.type = 'password';
            toggleIcon.classList.remove('ti-eye-off');
            toggleIcon.classList.add('ti-eye');
            toggleBtn.title = 'Mostrar contraseña';
          }
        });
      }
      
      // Generate password
      if (generateBtn && passwordInput && generateIcon) {
        generateBtn.addEventListener('click', function() {
          // Generate a secure password that meets all requirements
          const uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
          const lowercase = 'abcdefghijklmnopqrstuvwxyz';
          const numbers = '0123456789';
          const specialChars = '!@#$%^&*()_+-=[]{}|;:,.<>?';
          
          // Ensure at least one character from each category
          let password = '';
          password += uppercase[Math.floor(Math.random() * uppercase.length)];
          password += lowercase[Math.floor(Math.random() * lowercase.length)];
          password += numbers[Math.floor(Math.random() * numbers.length)];
          password += specialChars[Math.floor(Math.random() * specialChars.length)];
          
          // Fill remaining 8 characters (12 total - 4 required = 8 more)
          const allChars = uppercase + lowercase + numbers + specialChars;
          for (let i = 0; i < 8; i++) {
            password += allChars[Math.floor(Math.random() * allChars.length)];
          }
          
          // Shuffle the password to avoid predictable patterns
          password = password.split('').sort(() => Math.random() - 0.5).join('');
          passwordInput.value = password;
          
          // Show password temporarily
          passwordInput.type = 'text';
          toggleIcon.classList.remove('ti-eye');
          toggleIcon.classList.add('ti-eye-off');
          
          // Visual feedback
          generateIcon.classList.remove('ti-key');
          generateIcon.classList.add('ti-check');
          generateBtn.classList.remove('btn-outline-primary');
          generateBtn.classList.add('btn-success');
          
          setTimeout(() => {
            generateIcon.classList.remove('ti-check');
            generateIcon.classList.add('ti-key');
            generateBtn.classList.remove('btn-success');
            generateBtn.classList.add('btn-outline-primary');
          }, 1500);
          
          showAlert('success', 'Contraseña generada exitosamente');
        });
      }
      
      // Copy password to clipboard
      if (copyBtn && passwordInput && copyIcon) {
        copyBtn.addEventListener('click', async function() {
          if (!passwordInput.value.trim()) {
            showAlert('warning', 'No hay contraseña para copiar');
            return;
          }
          
          try {
            await navigator.clipboard.writeText(passwordInput.value);
            
            // Visual feedback
            copyIcon.classList.remove('ti-copy');
            copyIcon.classList.add('ti-check');
            copyBtn.classList.remove('btn-outline-secondary');
            copyBtn.classList.add('btn-success');
            
            setTimeout(() => {
              copyIcon.classList.remove('ti-check');
              copyIcon.classList.add('ti-copy');
              copyBtn.classList.remove('btn-success');
              copyBtn.classList.add('btn-outline-secondary');
            }, 1500);
            
            showAlert('success', 'Contraseña copiada al portapapeles');
          } catch (err) {
            console.error('Error copying to clipboard:', err);
            showAlert('danger', 'Error al copiar la contraseña');
          }
        });
      }
    });
    

    // Function to save team member
    async function saveTeamMember() {
      const form = document.getElementById('addTeamMemberForm');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = {
        firstName: document.getElementById('firstName').value,
        lastName: document.getElementById('lastName').value,
        email: document.getElementById('email').value,
        password: document.getElementById('password').value,
        role: document.getElementById('role').value,
        clientId: '<%= clientId %>'
      };
      
      // Add optional fields if they have values
      const phone = document.getElementById('phone').value.trim();
      const notes = document.getElementById('notes').value.trim();
      
      if (phone) {
        data.phone = phone;
      }
      
      if (notes) {
        data.notes = notes;
      }

      try {
        const response = await fetch('/api/clients/<%= clientId %>/employees', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          credentials: 'include',
          body: JSON.stringify(data)
        });

        const result = await response.json();
        
        if (result.success) {
          // Close modal
          const modal = bootstrap.Modal.getInstance(document.getElementById('createEmployeeModal'));
          modal.hide();
          
          // Reset form
          form.reset();
          
          // Reload table
          if (window.employeesTable) {
            window.employeesTable.ajax.reload();
          }
          
          // Show success message
          showAlert('success', 'Empleado creado exitosamente!');
        } else {
          showAlert('danger', result.error || 'Error al crear el empleado');
        }
      } catch (error) {
        console.error('Error adding team member:', error);
        showAlert('danger', 'Ocurrió un error al crear el empleado');
      }
    }

    // Function to show alerts inside modal
    function showAlert(type, message) {
      const modalContainer = document.getElementById('modalAlertContainer');
      if (!modalContainer) {
        console.error('Modal alert container not found');
        return;
      }
      
      const alertHtml = `
        <div class="alert alert-${type} alert-dismissible fade show" role="alert">
          ${message}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      `;
      
      modalContainer.innerHTML = alertHtml;
      modalContainer.style.display = 'block';
      
      // Auto-dismiss after 5 seconds
      setTimeout(() => {
        modalContainer.style.display = 'none';
        modalContainer.innerHTML = '';
      }, 5000);
    }

    // Function to display static representative information
    // Function to load department manager information (server-side data)
    function loadClientInfo() {
      const loadingEl = document.getElementById('client-info-loading');
      const containerEl = document.getElementById('client-info-container');
      const errorEl = document.getElementById('client-info-error');
      
      // Hide loading and error states
      loadingEl.classList.add('d-none');
      errorEl.classList.add('d-none');
      
      // Get contextual data passed from server
      const contextualData = <%-JSON.stringify(locals.contextualData || {}) %>;
      console.log('🔍 Contextual Data:', contextualData);
      
      const departmentManager = contextualData.departmentManager || <%-JSON.stringify(locals.departmentManager || null) %>;
      
      if (departmentManager) {
        displayRepresentativeInfo(departmentManager);
      } else {
        // Show fallback information for debugging
        console.log('🔍 No department manager data, showing fallback');
        const fallbackManager = {
          objectId: contextualData.clientId || '<%= clientId || "unknown" %>',
          firstName: 'Gerente',
          lastName: 'de Departamento',
          email: 'gerente@empresa.com',
          phone: 'No especificado',
          role: 'department_manager',
          active: true,
          companyName: contextualData.companyName || '<%= locals.companyName || "Mi Empresa" %>'
        };
        displayRepresentativeInfo(fallbackManager);
      }
    }

    function displayStaticRepresentativeInfo() {
      // Call the new async function instead
      loadClientInfo();
    }

    function displayRepresentativeInfo(departmentManager) {
      const loadingEl = document.getElementById('client-info-loading');
      const containerEl = document.getElementById('client-info-container');
      const errorEl = document.getElementById('client-info-error');
      
      // Hide loading and error states
      loadingEl.classList.add('d-none');
      errorEl.classList.add('d-none');
      
      // Get company name from contextual data, locals, or department manager data
      const contextualData = <%-JSON.stringify(locals.contextualData || {}) %>;
      const companyName = contextualData.companyName || '<%= locals.companyName || "" %>' || departmentManager.companyName || departmentManager.company || 'Mi Empresa';
      
      // Extract department manager information
      const userEmail = departmentManager.email || departmentManager.username || '';
      const userId = departmentManager.objectId || departmentManager.id || '';
      const userRole = departmentManager.role || 'department_manager';
      const isActive = departmentManager.active !== undefined ? departmentManager.active : true;
      const firstName = departmentManager.firstName || '';
      const lastName = departmentManager.lastName || '';
      const phone = departmentManager.phone || 'No especificado';
      
      // Parse name from email if firstName/lastName not available
      const emailParts = (!firstName && userEmail.includes('@')) ? userEmail.split('@')[0] : '';
      const userFirstName = firstName || emailParts || 'Gerente';
      const userLastName = lastName || '';
      
      console.log('Department Manager Data:', {
        userEmail, userId, userFirstName, userLastName, phone, isActive, companyName
      });
      
      const today = new Date().toLocaleDateString('es-ES', { 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
      });
      
      // Format user name
      const displayName = userFirstName && userLastName ? `${userFirstName} ${userLastName}` : userFirstName || 'Gerente';
      
      const infoHtml = `
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Nombre</label>
            <p class="fw-semibold mb-0">${displayName}</p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Email</label>
            <p class="mb-0">
              <a href="mailto:${userEmail}"><i class="ti ti-mail me-1"></i>${userEmail}</a>
            </p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Teléfono</label>
            <p class="mb-0">
              <i class="ti ti-phone me-1"></i>${phone}
            </p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Nombre de la Empresa</label>
            <p class="fw-semibold mb-0">${companyName}</p>
          </div>
        </div>
      `;
      
      containerEl.innerHTML = infoHtml;
      containerEl.classList.remove('d-none');
    }

    // Function to show error state
    function showClientInfoError(errorMessage = 'Error al cargar información del agente admin') {
      const loadingEl = document.getElementById('client-info-loading');
      const containerEl = document.getElementById('client-info-container');
      const errorEl = document.getElementById('client-info-error');
      
      loadingEl.classList.add('d-none');
      containerEl.classList.add('d-none');
      errorEl.classList.remove('d-none');
      
      // Update error message if different from default
      const errorText = errorEl.querySelector('p');
      if (errorText && errorMessage !== 'Error al cargar información del agente admin') {
        errorText.textContent = errorMessage;
      }
    }
</script>