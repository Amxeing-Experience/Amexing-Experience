<%
/**
 * Tarifario Export Page
 * Allows admin/superadmin to export the complete tarifario or selected sections
 * in Excel or PDF format.
 *
 * @author Denisse Maldonado
 * @version 1.0.0
 */

const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const rolePathMap = {
  superadmin: '/dashboard/superadmin',
  admin: '/dashboard/admin',
  client: '/dashboard/client',
  department_manager: '/dashboard/department_manager',
};
const basePath = rolePathMap[currentUserRole] || '/dashboard/admin';
%>

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="ti ti-download me-2 text-primary"></i>
                    Exportar Tarifario
                </h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="<%= basePath %>"><i class="ti ti-home me-1"></i>Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active">
                            <i class="ti ti-download me-1"></i>Exportar Tarifario
                        </li>
                    </ol>
                </nav>
                <p class="text-muted mt-2 mb-0">
                    Exporta el tarifario completo o por secciones en formato Excel o PDF.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Export Card -->
<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white" style="background: linear-gradient(135deg, #5D87FF 0%, #7C3AED 100%); border: none;">
                <h5 class="card-title mb-0 text-white">
                    <i class="ti ti-receipt-2 me-2"></i>Secciones del Tarifario
                </h5>
                <small class="text-white" style="opacity: 0.9;">Selecciona las secciones que deseas exportar</small>
            </div>
            <div class="card-body p-4">
                <!-- Select All -->
                <div class="form-check mb-3 pb-3 border-bottom">
                    <input class="form-check-input" type="checkbox" id="selectAll" checked>
                    <label class="form-check-label fw-bold" for="selectAll">
                        <i class="ti ti-checks me-1"></i> Seleccionar Todas
                    </label>
                </div>

                <!-- Section Checkboxes -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-check p-3 rounded border bg-light-subtle">
                            <input class="form-check-input section-check" type="checkbox" value="vehiculos" id="chkVehiculos" checked>
                            <label class="form-check-label" for="chkVehiculos">
                                <i class="ti ti-car me-1 text-primary"></i>
                                <strong>Vehiculos</strong>
                                <br><small class="text-muted">Tipos de vehiculo, capacidades</small>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check p-3 rounded border bg-light-subtle">
                            <input class="form-check-input section-check" type="checkbox" value="traslados" id="chkTraslados" checked>
                            <label class="form-check-label" for="chkTraslados">
                                <i class="ti ti-briefcase me-1 text-success"></i>
                                <strong>Traslados</strong>
                                <br><small class="text-muted">Servicios de traslado con precios por tarifa</small>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check p-3 rounded border bg-light-subtle">
                            <input class="form-check-input section-check" type="checkbox" value="a-disposicion" id="chkDisposicion" checked>
                            <label class="form-check-label" for="chkDisposicion">
                                <i class="ti ti-calculator me-1 text-warning"></i>
                                <strong>A Disposicion</strong>
                                <br><small class="text-muted">Precios por hora de renta de vehiculos</small>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check p-3 rounded border bg-light-subtle">
                            <input class="form-check-input section-check" type="checkbox" value="experiencias" id="chkExperiencias" checked>
                            <label class="form-check-label" for="chkExperiencias">
                                <i class="ti ti-star me-1 text-danger"></i>
                                <strong>Experiencias</strong>
                                <br><small class="text-muted">Paquetes de experiencias y costos</small>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check p-3 rounded border bg-light-subtle">
                            <input class="form-check-input section-check" type="checkbox" value="tours" id="chkTours" checked>
                            <label class="form-check-label" for="chkTours">
                                <i class="ti ti-map me-1 text-info"></i>
                                <strong>Tours</strong>
                                <br><small class="text-muted">Tours con precios por tarifa y vehiculo</small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Format, Payment & Currency Selection -->
                <div class="mt-4 pt-3 border-top">
                    <div class="row align-items-end g-3">
                        <div class="col-md-3">
                            <label for="formatSelect" class="form-label fw-semibold">
                                <i class="ti ti-file me-1"></i>Formato
                            </label>
                            <select class="form-select" id="formatSelect">
                                <option value="excel">Excel (.xlsx)</option>
                                <option value="pdf">PDF</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="paymentTypeSelect" class="form-label fw-semibold">
                                <i class="ti ti-credit-card me-1"></i>Tipo de Pago
                            </label>
                            <select class="form-select" id="paymentTypeSelect">
                                <option value="efectivo" <%= (currentUserRole === 'admin' || currentUserRole === 'superadmin') ? 'selected' : '' %>>Efectivo</option>
                                <option value="transferencia" <%= (currentUserRole === 'client' || currentUserRole === 'department_manager') ? 'selected' : '' %>>Transferencia</option>
                                <option value="tarjeta">Tarjeta</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="currencySelect" class="form-label fw-semibold">
                                <i class="ti ti-coin me-1"></i>Moneda
                            </label>
                            <select class="form-select" id="currencySelect">
                                <option value="MXN" selected>MXN</option>
                                <option value="USD">USD</option>
                            </select>
                        </div>
                        <div class="col-md-3 text-end">
                            <button type="button" class="btn btn-primary btn-lg w-100" id="exportBtn">
                                <i class="ti ti-download me-2"></i>Exportar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">
                    <i class="ti ti-info-circle me-1 text-primary"></i>Informacion
                </h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <i class="ti ti-file-spreadsheet me-1 text-success"></i>
                        <strong>Excel</strong>: Cada seccion en una hoja separada, con formato de moneda y estilos.
                    </li>
                    <li class="mb-2">
                        <i class="ti ti-file-type-pdf me-1 text-danger"></i>
                        <strong>PDF</strong>: Documento con branding de Amexing, ideal para compartir.
                    </li>
                    <li class="mb-2">
                        <i class="ti ti-clock me-1 text-muted"></i>
                        Los datos exportados reflejan el estado actual del tarifario.
                    </li>
                </ul>
            </div>
        </div>

        <!-- Quick Export Buttons -->
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">
                    <i class="ti ti-bolt me-1 text-warning"></i>Exportacion Rapida
                </h6>
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-primary btn-sm text-start quick-export-btn" data-section="vehiculos" data-format="excel">
                        <i class="ti ti-car me-1"></i> Vehiculos (Excel)
                    </button>
                    <button class="btn btn-outline-success btn-sm text-start quick-export-btn" data-section="traslados" data-format="excel">
                        <i class="ti ti-briefcase me-1"></i> Traslados (Excel)
                    </button>
                    <button class="btn btn-outline-warning btn-sm text-start quick-export-btn" data-section="a-disposicion" data-format="excel">
                        <i class="ti ti-calculator me-1"></i> A Disposicion (Excel)
                    </button>
                    <button class="btn btn-outline-danger btn-sm text-start quick-export-btn" data-section="experiencias" data-format="excel">
                        <i class="ti ti-star me-1"></i> Experiencias (Excel)
                    </button>
                    <button class="btn btn-outline-info btn-sm text-start quick-export-btn" data-section="tours" data-format="excel">
                        <i class="ti ti-map me-1"></i> Tours (Excel)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Select All toggle
document.getElementById('selectAll').addEventListener('change', function() {
    var isChecked = this.checked;
    document.querySelectorAll('.section-check').forEach(function(check) {
        check.checked = isChecked;
    });
});

// Update Select All when individual checkboxes change
document.querySelectorAll('.section-check').forEach(function(check) {
    check.addEventListener('change', function() {
        var allChecks = document.querySelectorAll('.section-check');
        var allChecked = Array.from(allChecks).every(function(c) { return c.checked; });
        document.getElementById('selectAll').checked = allChecked;
    });
});

/**
 * Download a tarifario export with loading state on the triggering button.
 * Uses fetch + blob so we can track when the download completes.
 */
function downloadTarifario(url, btn) {
    var originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Generando...';

    fetch(url, { credentials: 'same-origin' })
        .then(function(response) {
            if (!response.ok) {
                return response.json().then(function(data) {
                    throw new Error(data.error || 'Error al exportar');
                });
            }
            var disposition = response.headers.get('Content-Disposition') || '';
            var filenameMatch = disposition.match(/filename="?([^"]+)"?/);
            var filename = filenameMatch ? filenameMatch[1] : 'tarifario-amexing.xlsx';
            return response.blob().then(function(blob) {
                return { blob: blob, filename: filename };
            });
        })
        .then(function(result) {
            var a = document.createElement('a');
            a.href = URL.createObjectURL(result.blob);
            a.download = result.filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(a.href);
        })
        .catch(function(err) {
            alert(err.message || 'Error al generar la exportacion.');
        })
        .finally(function() {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        });
}

// Main export button
document.getElementById('exportBtn').addEventListener('click', function() {
    var checks = document.querySelectorAll('.section-check:checked');
    var sections = Array.from(checks).map(function(c) { return c.value; });

    if (sections.length === 0) {
        alert('Selecciona al menos una seccion para exportar.');
        return;
    }

    var format = document.getElementById('formatSelect').value;
    var paymentType = document.getElementById('paymentTypeSelect').value;
    var currency = document.getElementById('currencySelect').value;
    var url = '/api/tarifario/export?sections=' + sections.join(',') + '&format=' + format + '&paymentType=' + paymentType + '&currency=' + currency;
    downloadTarifario(url, this);
});

// Quick export buttons
document.querySelectorAll('.quick-export-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var section = this.getAttribute('data-section');
        var format = this.getAttribute('data-format');
        var paymentType = document.getElementById('paymentTypeSelect').value;
        var currency = document.getElementById('currencySelect').value;
        var url = '/api/tarifario/export?sections=' + section + '&format=' + format + '&paymentType=' + paymentType + '&currency=' + currency;
        downloadTarifario(url, this);
    });
});
</script>
