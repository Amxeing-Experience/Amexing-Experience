<%
/**
 * Dashboard de inicio — Client (Agente)
 * Landing con 3 segmentos por estatus, pendientes de pago y accesos rápidos.
 * Created by Denisse Maldonado
 */
const d = (typeof dashboardData !== 'undefined' && dashboardData) ? dashboardData : {};
const bp = d.basePath || 'client';
const seg = d.segments || { quoted: 0, hold: 0, scheduled: 0 };
const pendingPayments = d.pendingPayments || [];
%>

<style>
  .dash-wrap{--olive:#6E7A50;--olive-d:#566040;--line:#ded9cb;--ink:#2b2b2b;--muted:#8a8f78;--amber:#b8894a;--amber-bg:#f6efe2;}

  /* Encabezado */
  .dash-wrap .eyebrow{text-transform:uppercase;letter-spacing:.34em;font-size:.7rem;color:var(--olive);font-weight:600;}
  .dash-wrap .dash-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:26px;}
  .dash-wrap .dash-head h1{margin:.15rem 0 0;font-weight:400;letter-spacing:.06em;font-size:1.9rem;color:var(--ink);}
  .dash-wrap .head-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
  .dash-wrap .search{position:relative;width:300px;max-width:100%;}
  .dash-wrap .search i{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:1.15rem;}
  .dash-wrap .search input{width:100%;border:1px solid var(--line);background:#fff;border-radius:12px;padding:12px 14px 12px 44px;
    font-size:.92rem;color:var(--ink);outline:none;}
  .dash-wrap .search input:focus{border-color:var(--olive);box-shadow:0 0 0 .2rem rgba(110,122,80,.12);}
  .dash-wrap .btn-reservar{display:inline-flex;align-items:center;gap:7px;background:var(--olive);color:#fff;border:1px solid var(--olive);
    border-radius:11px;padding:.72rem 1.35rem;font-size:.88rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;text-decoration:none;}
  .dash-wrap .btn-reservar:hover{background:var(--olive-d);color:#fff;}

  /* Aviso de tarifas */
  .dash-wrap .dash-notice{display:flex;gap:12px;align-items:flex-start;background:#faf7f0;border:1px solid #e7d6bd;
    border-left:4px solid var(--amber);border-radius:10px;padding:14px 18px;margin-top:22px;color:#6b5a3f;font-size:.86rem;line-height:1.55;}
  .dash-wrap .dash-notice i{color:var(--amber);font-size:1.25rem;flex-shrink:0;margin-top:1px;}

  /* Sección */
  .dash-wrap .section-title{text-transform:uppercase;letter-spacing:.2em;font-size:.82rem;font-weight:700;color:var(--olive-d);
    margin:36px 0 16px;display:flex;align-items:center;gap:12px;}
  .dash-wrap .section-title .rule{flex:1;height:1px;background:var(--line);}

  /* 3 segmentos */
  .dash-wrap .segments{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  .dash-wrap .seg{display:block;background:#fff;border:1px solid var(--line);border-radius:12px;padding:22px 24px;position:relative;
    overflow:hidden;text-decoration:none;color:inherit;transition:box-shadow .15s;}
  .dash-wrap .seg:hover{box-shadow:0 .4rem 1rem rgba(0,0,0,.06);}
  .dash-wrap .seg::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;}
  .dash-wrap .seg.cot::before{background:var(--olive);}
  .dash-wrap .seg.blo::before{background:var(--amber);}
  .dash-wrap .seg.con::before{background:#4b6b3f;}
  .dash-wrap .seg .lbl{text-transform:uppercase;letter-spacing:.1em;font-size:.7rem;font-weight:700;color:var(--muted);}
  .dash-wrap .seg .sub{font-size:.72rem;color:var(--muted);font-style:italic;margin-top:2px;min-height:1em;}
  .dash-wrap .seg .num{font-size:2.6rem;font-weight:700;line-height:1;margin:14px 0 4px;color:var(--ink);}
  .dash-wrap .seg .foot{display:flex;justify-content:flex-end;align-items:center;margin-top:14px;padding-top:12px;border-top:1px solid var(--line);}
  .dash-wrap .seg .internal{font-size:.62rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);}
  .dash-wrap .seg .ver{color:var(--olive-d);font-weight:600;font-size:.82rem;}
  .dash-wrap .seg.blo .ver{color:var(--amber);}

  /* Tabla pendientes de pago */
  .dash-wrap .card{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;}
  .dash-wrap table{width:100%;border-collapse:collapse;}
  .dash-wrap thead th{background:#faf9f5;color:#6b6656;font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
    text-align:left;padding:12px 18px;border-bottom:1px solid var(--line);}
  .dash-wrap tbody td{padding:14px 18px;border-bottom:1px solid #f1efe8;font-size:.9rem;vertical-align:middle;}
  .dash-wrap tbody tr:last-child td{border-bottom:0;}
  .dash-wrap .folio{font-weight:600;color:var(--olive-d);}
  .dash-wrap .badge{display:inline-flex;align-items:center;gap:5px;font-size:.68rem;font-weight:700;text-transform:uppercase;
    letter-spacing:.04em;border-radius:6px;padding:.22rem .55rem;}
  .dash-wrap .badge.pend{background:var(--amber-bg);color:var(--amber);border:1px solid #e7d6bd;}
  .dash-wrap .badge.part{background:#eef0e6;color:var(--olive-d);border:1px solid var(--line);}
  .dash-wrap .saldo{font-weight:700;}
  .dash-wrap .link-btn{border:1px solid var(--line);background:#fff;border-radius:7px;padding:.35rem .8rem;font-size:.78rem;font-weight:600;
    color:var(--olive-d);text-decoration:none;}
  .dash-wrap .link-btn:hover{border-color:var(--olive);background:#eef0e6;}
  .dash-wrap .card-foot{padding:12px 18px;text-align:center;border-top:1px solid var(--line);}
  .dash-wrap .card-foot a{color:var(--olive-d);font-weight:600;font-size:.82rem;text-decoration:none;}
  .dash-wrap .empty{padding:34px 18px;text-align:center;color:var(--muted);font-size:.9rem;}

  /* Accesos rápidos */
  .dash-wrap .quick{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  .dash-wrap .qa{position:relative;background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px 14px;text-align:center;
    text-decoration:none;color:var(--ink);transition:border-color .15s,background .15s;}
  .dash-wrap .qa:hover{border-color:var(--olive);background:#faf9f5;}
  .dash-wrap .qa .ic{width:44px;height:44px;border-radius:10px;background:#eef0e6;color:var(--olive-d);display:flex;align-items:center;
    justify-content:center;margin:0 auto 10px;font-size:1.5rem;}
  .dash-wrap .qa .t{font-size:.8rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;}
  .dash-wrap .qa .cnt{position:absolute;top:12px;right:12px;background:var(--olive);color:#fff;font-size:.66rem;font-weight:700;
    border-radius:999px;min-width:20px;height:20px;display:flex;align-items:center;justify-content:center;padding:0 5px;}

  @media(max-width:900px){.dash-wrap .segments{grid-template-columns:1fr;}.dash-wrap .quick{grid-template-columns:repeat(2,1fr);}}
</style>

<div class="dash-wrap">

  <!-- Encabezado -->
  <div class="dash-head">
    <div>
      <div class="eyebrow">Inicio</div>
      <h1>Buen día, <%= d.agencyName || 'Cliente' %></h1>
    </div>
    <div class="head-actions">
      <div class="search">
        <i class="ti ti-search"></i>
        <input type="text" id="dashSearch" placeholder="Buscar por folio o cliente…" autocomplete="off">
      </div>
      <a class="btn-reservar" href="/dashboard/<%= bp %>/quotes/new"><i class="ti ti-plus"></i> Reservar</a>
    </div>
  </div>

  <!-- 3 segmentos -->
  <div class="segments">
    <a class="seg cot" href="/dashboard/<%= bp %>/quotes">
      <div class="lbl">Cotizado</div>
      <div class="sub">&nbsp;</div>
      <div class="num"><%= seg.quoted %></div>
      <div class="foot"><span class="ver">Ver todas &rarr;</span></div>
    </a>
    <a class="seg blo" href="/dashboard/<%= bp %>/bookings?dateFilter=pending_completion">
      <div class="lbl">Agendado</div>
      <div class="sub">Pendiente por completar información</div>
      <div class="num"><%= seg.hold %></div>
      <div class="foot"><span class="ver">Completar &rarr;</span></div>
    </a>
    <a class="seg con" href="/dashboard/<%= bp %>/bookings">
      <div class="lbl">Confirmado</div>
      <div class="sub">&nbsp;</div>
      <div class="num"><%= seg.scheduled %></div>
      <div class="foot"><span class="ver">Ver todas &rarr;</span></div>
    </a>
  </div>

  <!-- Aviso de actualización de tarifas -->
  <div class="dash-notice">
    <i class="ti ti-info-circle"></i>
    <div>Las cotizaciones correspondientes a servicios programados para 2027 en adelante están sujetas a actualización de tarifas. Para garantizar el precio cotizado, será necesario realizar durante 2026 un pago anticipado mínimo del 50% del total de los servicios confirmados. De lo contrario, aplicarán las tarifas vigentes al momento de la confirmación.</div>
  </div>

  <!-- Pendientes de pago -->
  <div class="section-title">Reservaciones pendientes de pago <span class="rule"></span></div>
  <div class="card">
    <% if (pendingPayments.length > 0) { %>
    <table>
      <thead>
        <tr><th>Folio</th><th>Cliente final</th><th>Fecha inicio</th><th>Saldo</th><th>Pago</th><th></th></tr>
      </thead>
      <tbody>
        <% pendingPayments.forEach(function(p) { %>
        <tr>
          <td class="folio"><%= p.folio %></td>
          <td><%= p.client %></td>
          <td><%= p.date %></td>
          <td class="saldo"><%= p.balance %></td>
          <td><span class="badge <%= p.status === 'partial' ? 'part' : 'pend' %>"><%= p.status === 'partial' ? 'Parcial' : 'Pendiente' %></span></td>
          <td><a class="link-btn" href="/dashboard/<%= bp %>/bookings/<%= p.id %>">Ver</a></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <div class="card-foot"><a href="/dashboard/<%= bp %>/bookings">Ver todas las reservaciones &rarr;</a></div>
    <% } else { %>
    <div class="empty">No hay reservaciones pendientes de pago.</div>
    <% } %>
  </div>

  <!-- Accesos rápidos -->
  <div class="section-title">Accesos rápidos <span class="rule"></span></div>
  <div class="quick">
    <a class="qa" href="/dashboard/<%= bp %>/vehicles"><div class="ic"><i class="ti ti-car"></i></div><div class="t">Vehículos</div></a>
    <a class="qa" href="/dashboard/<%= bp %>/services"><div class="ic"><i class="ti ti-briefcase"></i></div><div class="t">Traslados</div></a>
    <a class="qa" href="/dashboard/<%= bp %>/a-disposicion"><div class="ic"><i class="ti ti-calculator"></i></div><div class="t">A Disposición</div></a>
    <a class="qa" href="/dashboard/<%= bp %>/experiences"><div class="ic"><i class="ti ti-star"></i></div><div class="t">Experiencias</div></a>
    <a class="qa" href="/dashboard/<%= bp %>/tours"><div class="ic"><i class="ti ti-map"></i></div><div class="t">Tours</div></a>
    <a class="qa" href="/dashboard/<%= bp %>/tarifario-export"><div class="ic"><i class="ti ti-download"></i></div><div class="t">Exportar Tarifario</div></a>
    <a class="qa" href="/dashboard/<%= bp %>/clients"><div class="ic"><i class="ti ti-building"></i></div><div class="t">Clientes</div></a>
    <a class="qa" href="/dashboard/<%= bp %>/team"><div class="ic"><i class="ti ti-users"></i></div><div class="t">Mi Equipo</div></a>
  </div>

</div>

<script>
  // Búsqueda rápida: por ahora lleva a la lista de cotizaciones con el término (se afinará al wirear datos).
  document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('dashSearch');
    if (input) {
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && this.value.trim()) {
          window.location.href = '/dashboard/<%= bp %>/quotes?search=' + encodeURIComponent(this.value.trim());
        }
      });
    }
  });
</script>
