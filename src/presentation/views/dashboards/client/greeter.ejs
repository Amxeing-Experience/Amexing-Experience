<%
/**
 * Client Greeter Management Page
 * View-only greeter services for client role
 *
 * Layout Structure:
 * - Direct row/column structure
 * - Container-fluid from Flexy Bootstrap
 * - DataTables for greeter services listing (view-only)
 *
 * Note: DataTables CSS/JS libraries are loaded via controller
 * Created by Denisse Maldonado
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'client';
const currentPath = '/dashboard/client/greeter';
%>

<!-- Page Header with Breadcrumb -->
<div class="row">
    <div class="col-12">
        <div class="mb-4">
            <h2 class="mb-1 fw-bold">Greeter</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/dashboard/client" class="text-decoration-none">
                            <i class="ti ti-home me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <i class="ti ti-user-plus me-1"></i>Greeter
                    </li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<!-- Greeter Services DataTable -->
<div class="row">
    <div class="col-12">
        <%- include('../../organisms/datatable/greeter-table', {
            tableId: 'greeter-table',
            apiEndpoint: '/api/greeter',
            userRole: currentUserRole,
            showActions: false
        }) %>
    </div>
</div>