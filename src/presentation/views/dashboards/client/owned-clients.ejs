                            <div class="col-12 mb-2">
                                <h6 class="text-muted small fw-bold">
                                    <i class="ti ti-map-pin me-1"></i>
                                    Dirección Completa
                                </h6>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-3">
                                <%- include('../../atoms/common/street-type-select', {
                                    name: 'streetType',
                                    id: 'clientStreetType',
                                    label: 'Tipo de Vialidad',
                                    required: false,
                                    helpText: 'Tipo de vía',
                                    value: 'Calle'
                                }) %>
                            </div>
                            <div class="col-md-5">
                                <%- include('../../atoms/common/street-name-input', {
