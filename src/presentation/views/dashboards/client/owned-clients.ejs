<!-- Page Scripts -->
<script>
// Initialize DataTable and client management functions
document.addEventListener('DOMContentLoaded', function() {
    loadOwnedClients();
    
    // Add event listeners for buttons to avoid CSP violations
    const createBtn = document.getElementById('createClientBtn');
    if (createBtn) {
        createBtn.addEventListener('click', createClient);
    }
    
    const updateBtn = document.getElementById('updateClientBtn');
    if (updateBtn) {
        updateBtn.addEventListener('click', updateClient);
    }
});

function loadOwnedClients() {
    // The DataTable will be initialized by the included table component
    updateClientCount();
}

async function updateClientCount() {
    try {
        const response = await fetch('/api/owned-clients?limit=1', {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            }
        });
        
        if (response.ok) {
            const data = await response.json();
            document.getElementById('total-clients-count').textContent = data.pagination?.total || '0';
        }
    } catch (error) {
        console.error('Error fetching client count:', error);
    }
}

async function createClient() {
    const form = document.getElementById('createClientForm');
    
    // Validate form fields before submission
    if (!validateClientForm(form)) {
        return; // Stop submission if validation fails
    }
    
    // Get form data including phone_full from phone input component
    const formData = new FormData(form);
    
    // Get the full international phone number if available
    const phoneFullInput = form.querySelector('input[name="phone_full"]');
    const phoneValue = phoneFullInput ? phoneFullInput.value : formData.get('phone');
    
    // Process allergies and dietary restrictions from textareas
    const allergiesText = formData.get('allergies') || '';
    const dietaryText = formData.get('dietaryRestrictions') || '';
    
    const clientData = {
        // Names
        firstName: formData.get('firstName'),
        lastName: formData.get('lastName'),
        // Contact info
        email: formData.get('email'),
        phone: phoneValue, // Use full international format
        // Contact person
        contactFirstName: formData.get('contactFirstName'),
        contactLastName: formData.get('contactLastName'),
        // Emergency
        emergencyContactName: formData.get('emergencyContactName'),
        emergencyContactPhone: formData.get('emergencyContactPhone'),
        // Company
        companyType: formData.get('companyType'),
        taxId: formData.get('taxId'),
        website: formData.get('website'),
        address: formData.get('address'),
        // Special requirements
        preferredLanguage: formData.get('preferredLanguage'),
        accessibilityRequirements: formData.get('accessibilityRequirements'),
        allergies: allergiesText,
        dietaryRestrictions: dietaryText,
        notes: formData.get('notes')
    };
    
    // Remove empty fields to avoid sending nulls
    Object.keys(clientData).forEach(key => {
        if (!clientData[key] || clientData[key].trim() === '') {
            delete clientData[key];
        }
    });
    
    try {
        // Show loading state
        const createBtn = document.getElementById('createClientBtn');
        const originalText = createBtn.innerHTML;
        createBtn.innerHTML = '<i class="ti ti-loader-2 fa-spin me-1"></i>Creando...';
        createBtn.disabled = true;
        
        const response = await fetch('/api/owned-clients', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            },
            body: JSON.stringify(clientData)
        });
        
        const data = await response.json();
        
        if (response.ok && data.success) {
            showModalAlert('success', 'Cliente creado exitosamente');
            // Reset form
            form.reset();
            // Clear validation states
            clearFormValidation(form);
            setTimeout(() => {
                $('#createClientModal').modal('hide');
                location.reload(); // Reload to refresh the table
            }, 1500);
        } else {
            showModalAlert('error', data.error || 'Error al crear el cliente');
        }
    } catch (error) {
        console.error('Error creating client:', error);
        showModalAlert('error', 'Error de conexión al crear el cliente');
    } finally {
        // Restore button state
        const createBtn = document.getElementById('createClientBtn');
        createBtn.innerHTML = originalText;
        createBtn.disabled = false;
    }
}

// Client form validation function
function validateClientForm(form) {
    let isValid = true;
    
    // Validate required first name field
    const firstNameInput = form.querySelector('#clientFirstName, #editClientFirstName');
    if (firstNameInput) {
        const firstName = firstNameInput.value.trim();
        if (!firstName) {
            firstNameInput.classList.add('is-invalid');
            firstNameInput.focus();
            isValid = false;
        } else {
            firstNameInput.classList.remove('is-invalid');
            firstNameInput.classList.add('is-valid');
        }
    }
    
    // Validate required last name field
    const lastNameInput = form.querySelector('#clientLastName, #editClientLastName');
    if (lastNameInput) {
        const lastName = lastNameInput.value.trim();
        if (!lastName) {
            lastNameInput.classList.add('is-invalid');
            if (isValid) lastNameInput.focus();
            isValid = false;
        } else {
            lastNameInput.classList.remove('is-invalid');
            lastNameInput.classList.add('is-valid');
        }
    }
    
    // Validate email if provided
    const emailInput = form.querySelector('#clientEmail, #editClientEmail');
    if (emailInput && emailInput.value.trim()) {
        const emailPattern = /^[a-zA-Z0-9.!#$%&'*+\/=?^_`{\|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
        if (!emailPattern.test(emailInput.value.trim())) {
            emailInput.classList.add('is-invalid');
            isValid = false;
        }
    }
    
    // Validate phone if provided (phone component handles its own validation)
    const phoneInput = form.querySelector('#clientPhone, #editClientPhone');
    if (phoneInput && phoneInput.value.trim()) {
        // Check if phone component marked it as invalid
        if (phoneInput.classList.contains('is-invalid')) {
            isValid = false;
            phoneInput.focus();
        }
    }
    
    // Validate RFC if provided (RFC component handles its own validation)
    const rfcInput = form.querySelector('#clientTaxId, #editClientTaxId');
    if (rfcInput && rfcInput.value.trim()) {
        // Check if RFC component marked it as invalid
        if (rfcInput.classList.contains('is-invalid')) {
            isValid = false;
            rfcInput.focus();
        }
    }
    
    // Validate website if provided (URL component handles its own validation)
    const websiteInput = form.querySelector('#clientWebsite, #editClientWebsite');
    if (websiteInput && websiteInput.value.trim()) {
        // Check if URL component marked it as invalid
        if (websiteInput.classList.contains('is-invalid')) {
            isValid = false;
            websiteInput.focus();
        }
    }
    
    if (!isValid) {
        showModalAlert('error', 'Por favor corrige los errores en el formulario antes de continuar');
    }
    
    return isValid;
}

// Clear form validation states
function clearFormValidation(form) {
    const inputs = form.querySelectorAll('.form-control, .form-select');
    inputs.forEach(input => {
        input.classList.remove('is-invalid', 'is-valid');
    });
}

async function editClient(clientId) {
    try {
        const response = await fetch(`/api/owned-clients/${clientId}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            }
        });
        
        if (response.ok) {
            const data = await response.json();
            const client = data.data;
            
            // Populate edit form
            document.getElementById('editClientId').value = clientId;
            
            // Populate name fields
            document.getElementById('editClientFirstName').value = client.firstName || '';
            document.getElementById('editClientLastName').value = client.lastName || '';
            document.getElementById('editClientEmail').value = client.email || '';
            document.getElementById('editClientPhone').value = client.phone || '';
            
            // Populate contact person fields
            document.getElementById('editContactFirstName').value = client.contactFirstName || '';
            document.getElementById('editContactLastName').value = client.contactLastName || '';
            
            // Populate emergency contact
            document.getElementById('editEmergencyContactName').value = client.emergencyContactName || '';
            document.getElementById('editEmergencyContactPhone').value = client.emergencyContactPhone || '';
            
            // Populate company information fields
            const companyTypeSelect = document.getElementById('editCompanyType');
            if (companyTypeSelect) {
                companyTypeSelect.value = client.companyType || '';
            }
            
            const taxIdInput = document.getElementById('editClientTaxId');
            if (taxIdInput) {
                taxIdInput.value = client.taxId || '';
            }
            
            const websiteInput = document.getElementById('editClientWebsite');
            if (websiteInput) {
                websiteInput.value = client.website || '';
            }
            
            const addressInput = document.getElementById('editClientAddress');
            if (addressInput) {
                addressInput.value = client.address || '';
            }
            
            const notesInput = document.getElementById('editClientNotes');
            if (notesInput) {
                notesInput.value = client.notes || '';
            }
            
            // Populate special requirements
            const langSelect = document.getElementById('editPreferredLanguage');
            if (langSelect) {
                langSelect.value = client.preferredLanguage || 'es';
            }
            
            const accessInput = document.getElementById('editAccessibilityRequirements');
            if (accessInput) {
                accessInput.value = client.accessibilityRequirements || '';
            }
            
            // Populate allergies and dietary restrictions (arrays to text)
            const allergiesInput = document.getElementById('editAllergies');
            if (allergiesInput) {
                allergiesInput.value = Array.isArray(client.allergies) 
                    ? client.allergies.join('\n') 
                    : client.allergies || '';
            }
            
            const dietaryInput = document.getElementById('editDietaryRestrictions');
            if (dietaryInput) {
                dietaryInput.value = Array.isArray(client.dietaryRestrictions) 
                    ? client.dietaryRestrictions.join('\n') 
                    : client.dietaryRestrictions || '';
            }
            
            document.getElementById('editClientActive').checked = client.active !== false;
            
            $('#editClientModal').modal('show');
        } else {
            showToast('error', 'Error al cargar los datos del cliente');
        }
    } catch (error) {
        console.error('Error loading client:', error);
        showToast('error', 'Error de conexión al cargar el cliente');
    }
}

async function updateClient() {
    const clientId = document.getElementById('editClientId').value;
    const form = document.getElementById('editClientForm');
    
    // Validate form fields before submission
    if (!validateClientForm(form)) {
        return; // Stop submission if validation fails
    }
    
    const formData = new FormData(form);
    
    // Get the full international phone number if available
    const phoneFullInput = form.querySelector('input[name="phone_full"]');
    const phoneValue = phoneFullInput ? phoneFullInput.value : formData.get('phone');
    
    // Process allergies and dietary restrictions from textareas
    const allergiesText = formData.get('allergies') || '';
    const dietaryText = formData.get('dietaryRestrictions') || '';
    
    const clientData = {
        // Names
        firstName: formData.get('firstName'),
        lastName: formData.get('lastName'),
        // Contact info
        email: formData.get('email'),
        phone: phoneValue, // Use full international format
        // Contact person
        contactFirstName: formData.get('contactFirstName'),
        contactLastName: formData.get('contactLastName'),
        // Emergency
        emergencyContactName: formData.get('emergencyContactName'),
        emergencyContactPhone: formData.get('emergencyContactPhone'),
        // Company
        companyType: formData.get('companyType'),
        taxId: formData.get('taxId'),
        website: formData.get('website'),
        address: formData.get('address'),
        // Special requirements
        preferredLanguage: formData.get('preferredLanguage'),
        accessibilityRequirements: formData.get('accessibilityRequirements'),
        allergies: allergiesText,
        dietaryRestrictions: dietaryText,
        notes: formData.get('notes'),
        active: document.getElementById('editClientActive').checked
    };
    
    // Remove empty fields to avoid sending nulls
    Object.keys(clientData).forEach(key => {
        if (key !== 'active' && (!clientData[key] || clientData[key].trim() === '')) {
            delete clientData[key];
        }
    });
    
    try {
        // Show loading state
        const updateBtn = document.getElementById('updateClientBtn');
        const originalText = updateBtn.innerHTML;
        updateBtn.innerHTML = '<i class="ti ti-loader-2 fa-spin me-1"></i>Actualizando...';
        updateBtn.disabled = true;
        
        const response = await fetch(`/api/owned-clients/${clientId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            },
            body: JSON.stringify(clientData)
        });
        
        const data = await response.json();
        
        if (response.ok && data.success) {
            showEditModalAlert('success', 'Cliente actualizado exitosamente');
            setTimeout(() => {
                $('#editClientModal').modal('hide');
                location.reload();
            }, 1500);
        } else {
            showEditModalAlert('error', data.error || 'Error al actualizar el cliente');
        }
    } catch (error) {
        console.error('Error updating client:', error);
        showEditModalAlert('error', 'Error de conexión al actualizar el cliente');
    } finally {
        // Restore button state
        const updateBtn = document.getElementById('updateClientBtn');
        updateBtn.innerHTML = originalText;
        updateBtn.disabled = false;
    }
}

async function deleteClient(clientId, clientName) {
    if (confirm(`¿Está seguro que desea eliminar el cliente "${clientName}"?`)) {
        try {
            const response = await fetch(`/api/owned-clients/${clientId}`, {
                method: 'DELETE',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                }
            });
            
            const data = await response.json();
            
            if (response.ok && data.success) {
                showToast('success', 'Cliente eliminado exitosamente');
                location.reload();
            } else {
                showToast('error', data.error || 'Error al eliminar el cliente');
            }
        } catch (error) {
            console.error('Error deleting client:', error);
            showToast('error', 'Error de conexión al eliminar el cliente');
        }
    }
}

function showModalAlert(type, message) {
    const container = document.getElementById('modalAlertContainer');
    const alert = document.getElementById('modalAlert');
    const icon = document.getElementById('modalAlertIcon');
    const messageSpan = document.getElementById('modalAlertMessage');
    
    alert.className = `alert alert-${type === 'error' ? 'danger' : type}`;
    icon.className = `me-2 ti ti-${type === 'error' ? 'alert-circle' : 'circle-check'}`;
    messageSpan.textContent = message;
    container.style.display = 'block';
}

function showEditModalAlert(type, message) {
    const container = document.getElementById('editModalAlertContainer');
    const alert = document.getElementById('editModalAlert');
    const icon = document.getElementById('editModalAlertIcon');
    const messageSpan = document.getElementById('editModalAlertMessage');
    
    alert.className = `alert alert-${type === 'error' ? 'danger' : type}`;
    icon.className = `me-2 ti ti-${type === 'error' ? 'alert-circle' : 'circle-check'}`;
    messageSpan.textContent = message;
    container.style.display = 'block';
}

// Toast notification helper (assuming it's available globally)
function showToast(type, message) {
    if (typeof window.showToast === 'function') {
        window.showToast(type, message);
    } else {
        alert(message);
    }
}

// Add event listeners to clear validation states when modals are shown
document.addEventListener('DOMContentLoaded', function() {
    const createModal = document.getElementById('createClientModal');
    const editModal = document.getElementById('editClientModal');
    
    if (createModal) {
        createModal.addEventListener('show.bs.modal', function() {
            // Clear validation states for create modal
            setTimeout(function() {
                const form = document.getElementById('createClientForm');
                if (form) {
                    clearFormValidation(form);
                    console.log('Create client modal validation states cleared');
                }
            }, 100); // Small delay to ensure modal content is rendered
        });
    }
    
    if (editModal) {
        editModal.addEventListener('show.bs.modal', function() {
            // Clear validation states for edit modal
            setTimeout(function() {
                const form = document.getElementById('editClientForm');
                if (form) {
                    clearFormValidation(form);
                    console.log('Edit client modal validation states cleared');
                }
            }, 100); // Small delay to ensure modal content is rendered
        });
    }
});
</script>