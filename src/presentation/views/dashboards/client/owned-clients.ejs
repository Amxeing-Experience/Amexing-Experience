                            </div>
                        </div>

                    </div>

                    <!-- Sección: Requerimientos Especiales -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-heart me-1"></i>
