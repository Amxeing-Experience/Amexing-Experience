                                    id: 'clientState',
                                    label: 'Estado',
                                    required: false,
                                    helpText: 'Estado o región',
                                    value: ''
                                }) %>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <%- include('../../atoms/common/postal-code-input', {
                                    name: 'postalCode',
                                    id: 'clientPostalCode',
                                    label: 'Código Postal',
                                    required: false,
                                    placeholder: '12345',
                                    helpText: '5 dígitos',
                                    country: 'MX'
                                }) %>
                            </div>
                            <div class="col-md-8">
