<%
/**
 * Owned Clients Management Page
 * Shared view for department_manager and client roles to manage their own clients
 * Created by Denisse Maldonado
 * VALIDATION UPDATE: Now includes email, phone, RFC, and website validation components
 *
 * Layout Structure (matching main dashboard):
 * - Direct row/column structure (no body-wrapper)
 * - Container-fluid from Flexy Bootstrap
 * - Consistent spacing and alignment
 *
 * Note: DataTables CSS/JS libraries are loaded via controller (pageStyles & footerScripts)
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'client';
const currentPath = '/dashboard/clients';
%>

<!-- Page Header with Breadcrumb -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1 fw-bold">Mis Clientes</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/dashboard/<%= currentUserRole === 'department_manager' ? 'client' : currentUserRole %>" class="text-decoration-none">
                                <i class="ti ti-home me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <i class="ti ti-building me-1"></i>Mis Clientes
                        </li>
                    </ol>
                </nav>
            </div>
            <div class="text-muted">
                <small class="d-block">Total clientes registrados</small>
                <strong id="total-clients-count">-</strong>
            </div>
        </div>
    </div>
</div>

<!-- Owned Clients DataTable -->
<div class="row">
    <div class="col-12">
        <%- include('../../organisms/datatable/owned-clients-table', {
            tableId: 'owned-clients-table',
            apiEndpoint: '/api/owned-clients',
            userRole: currentUserRole,
            showActions: true
        }) %>
    </div>
</div>

<!-- Client Management Modals -->
<!-- Create Client Modal -->
<div class="modal fade" id="createClientModal" tabindex="-1" aria-labelledby="createClientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="createClientModalLabel">
                    <i class="ti ti-building-plus me-2"></i>Crear Nuevo Cliente
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Modal Alert Container -->
                <div id="modalAlertContainer" class="mb-3" style="display: none;">
                    <div id="modalAlert" class="alert" role="alert">
                        <i id="modalAlertIcon" class="me-2"></i>
                        <span id="modalAlertMessage"></span>
                    </div>
                </div>

                <form id="createClientForm">
                    <!-- Sección: Información del Cliente -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-user me-1"></i>
                            Información del Cliente
                        </h6>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../atoms/common/first-name-input', {
                                    name: 'firstName',
                                    id: 'clientFirstName',
                                    label: 'Nombre',
                                    required: true,
                                    placeholder: 'Ej: Juan',
                                    helpText: 'Primer nombre del cliente'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../atoms/common/last-name-input', {
                                    name: 'lastName',
                                    id: 'clientLastName',
                                    label: 'Apellido',
                                    required: true,
                                    placeholder: 'Ej: Pérez',
                                    helpText: 'Apellido(s) del cliente'
                                }) %>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../atoms/common/email-input', {
                                    name: 'email',
                                    id: 'clientEmail',
                                    label: 'Correo Electrónico',
                                    required: false,
                                    placeholder: 'cliente@empresa.com',
                                    helpText: 'Email de contacto principal'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../atoms/common/phone-input', {
                                    name: 'phone',
                                    id: 'clientPhone',
                                    label: 'Teléfono',
                                    required: false,
                                    countryCode: 'MX',
                                    placeholder: '999 123 4567',
                                    helpText: 'Número de contacto principal'
                                }) %>
                            </div>
                        </div>

                    </div>

                    <!-- Sección: Persona de Contacto y Emergencia -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-users me-1"></i>
                            Contactos
                        </h6>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../atoms/common/first-name-input', {
                                    name: 'contactFirstName',
                                    id: 'contactFirstName',
                                    label: 'Nombre de Contacto',
                                    required: false,
                                    placeholder: 'Ej: María',
                                    helpText: 'Nombre de la persona de contacto en la empresa'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../atoms/common/last-name-input', {
                                    name: 'contactLastName',
                                    id: 'contactLastName',
                                    label: 'Apellido de Contacto',
                                    required: false,
                                    placeholder: 'Ej: García',
                                    helpText: 'Apellido de la persona de contacto'
                                }) %>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../atoms/common/emergency-contact-input', {
                                    name: 'emergencyContactName',
                                    id: 'emergencyContactName',
                                    label: 'Contacto de Emergencia',
                                    required: false,
                                    placeholder: 'Ej: Carlos Pérez',
                                    helpText: 'Persona a contactar en caso de emergencia'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../atoms/common/emergency-phone-input', {
                                    name: 'emergencyContactPhone',
                                    id: 'emergencyContactPhone',
                                    label: 'Teléfono de Emergencia',
                                    required: false,
                                    countryCode: 'MX',
                                    placeholder: '999 123 4567',
                                    helpText: 'Número disponible 24/7'
                                }) %>
                            </div>
                        </div>
