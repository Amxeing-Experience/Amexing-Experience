<%
/**
 * Client Vehicles Management Page
 * View-only access to Amexing vehicle fleet and vehicle types
 *
 * Layout Structure:
 * - Vertical navigation menu (collapsible)
 * - Two sections: Vehículos (vehicles list) and Tipos (vehicle types management)
 * - Section-based content rendering
 *
 * Note: DataTables CSS/JS libraries are loaded via controller
 * Clients have read-only access to vehicle information
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'client';
const activeSection = typeof section !== 'undefined' ? section : 'types'; // Default to types

// Menu items configuration - Client can see both vehicles and types
const menuItems = [
    { label: 'Tipos de Vehículo', icon: 'list', section: 'types', href: '/dashboard/client/vehicles?section=types' }
];
%>

<!-- Page Header with Breadcrumb -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-1 fw-bold">Vehículos</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/dashboard/client" class="text-decoration-none">
                                <i class="ti ti-home me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <i class="ti ti-car me-1"></i>Vehículos
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Main Content with spacing from header -->
<div class="row mt-4">
    <div class="col-lg-3 mb-3 mb-lg-0" id="menuColumn">
        <nav class="vertical-menu card border-0 shadow-sm">
            <div class="card-body p-3">
                <div class="menu-header mb-3">
                    <h6 class="text-uppercase text-muted fw-bold menu-title" style="font-size: 0.75rem; letter-spacing: 0.5px; margin-bottom: 0;">MENÚ</h6>
                    <button class="btn btn-sm btn-link text-muted p-0 menu-toggle-btn" id="menuToggle" type="button" aria-label="Colapsar menú">
                        <i class="ti ti-menu-2 fs-5"></i>
                    </button>
                </div>
                <% menuItems.forEach(function(item) { %>
                    <a href="<%= item.href %>" class="menu-item <%= item.section === activeSection ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="<%= item.label %>">
                        <i class="ti ti-<%= item.icon %> menu-icon"></i><span class="menu-label"><%= item.label %></span>
                    </a>
                <% }); %>
            </div>
        </nav>
    </div>

    <div class="col-lg-9" id="contentColumn">
        <% if (activeSection === 'vehicles') { %>
            <!-- Vehicles Management Section -->
            <%- include('../../organisms/datatable/vehicles-table', {
                tableId: 'vehicles-table',
                apiEndpoint: '/api/vehicles',
                userRole: currentUserRole,
                showActions: false
            }) %>

        <% } else if (activeSection === 'types') { %>
            <!-- Vehicle Types Management Section -->
            <%- include('../../organisms/datatable/vehicle-types-table', {
                tableId: 'vehicle-types-table',
                apiEndpoint: '/api/vehicle-types?active=true',
                userRole: currentUserRole,
                showActions: false
            }) %>

        <% } %>
    </div>
</div>

<!-- Include the same styles as department manager -->
<style>
/* Vertical Menu Styles */
.vertical-menu {
    position: sticky;
    top: 1rem;
    transition: all 0.3s ease;
}

.vertical-menu.collapsed {
    width: 60px;
}

.menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.vertical-menu.collapsed .menu-title {
    display: none;
}

.menu-item {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    margin-bottom: 0.25rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: #495057;
    transition: all 0.2s ease;
}

.menu-item:hover {
    background-color: rgba(102, 126, 234, 0.08);
    color: #667eea;
}

.menu-item.active {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    font-weight: 500;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
}

.menu-icon {
    font-size: 1.25rem;
    margin-right: 0.75rem;
    min-width: 24px;
}

.vertical-menu.collapsed .menu-label {
    display: none;
}

.vertical-menu.collapsed .menu-icon {
    margin-right: 0;
}

/* Content area styles */
#contentColumn {
    transition: all 0.3s ease;
}

#contentColumn.expanded {
    margin-left: -180px;
}

/* Menu toggle button */
.menu-toggle-btn {
    opacity: 0.7;
    transition: opacity 0.2s ease;
    float: right;
}

.menu-toggle-btn:hover {
    opacity: 1;
}

/* Responsive adjustments */
@media (max-width: 991.98px) {
    .vertical-menu {
        position: relative;
        margin-bottom: 1rem;
    }
    
    #contentColumn.expanded {
        margin-left: 0;
    }
    
    .menu-toggle-btn {
        display: none;
    }
}

/* Card styling */
.card {
    border-radius: 0.75rem;
}

/* Breadcrumb styling */
.breadcrumb {
    background-color: transparent;
    padding-left: 0;
}

.breadcrumb-item + .breadcrumb-item::before {
    content: "›";
    font-weight: bold;
}
</style>

<script>
// Menu collapse/expand functionality
document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.getElementById('menuToggle');
    const menuColumn = document.getElementById('menuColumn');
    const contentColumn = document.getElementById('contentColumn');
    const verticalMenu = document.querySelector('.vertical-menu');
    
    if (menuToggle) {
        menuToggle.addEventListener('click', function() {
            verticalMenu.classList.toggle('collapsed');
            
            // Toggle column sizes
            if (verticalMenu.classList.contains('collapsed')) {
                menuColumn.classList.remove('col-lg-3');
                menuColumn.classList.add('col-lg-1');
                contentColumn.classList.remove('col-lg-9');
                contentColumn.classList.add('col-lg-11');
            } else {
                menuColumn.classList.remove('col-lg-1');
                menuColumn.classList.add('col-lg-3');
                contentColumn.classList.remove('col-lg-11');
                contentColumn.classList.add('col-lg-9');
            }
        });
    }
    
    // Initialize Bootstrap tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function(tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});
</script>