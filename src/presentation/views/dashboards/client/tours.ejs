<%
/**
 * Client Tours Page
 * View-only access to tour packages and itineraries
 *
 * Layout Structure:
 * - Direct row/column structure
 * - Container-fluid from Flexy Bootstrap
 * - DataTables for tours listing
 *
 * Note: DataTables CSS/JS libraries are loaded via controller
 * Clients can view tours but cannot modify them
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'client';
const currentPath = '/dashboard/client/tours';
%>

<!-- Page Header with Breadcrumb -->
<div class="row">
    <div class="col-12">
        <div class="mb-4">
            <h2 class="mb-1 fw-bold">Tours</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/dashboard/client" class="text-decoration-none">
                            <i class="ti ti-home me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <i class="ti ti-map me-1"></i>Tours
                    </li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<!-- Walking Tours Section -->
<div class="row">
    <div class="col-12" data-client-id="<%= clientId || '' %>">
        <%- include('../../organisms/tours/walking-tours-section', {
            walkingToursId: 'client-walking-tours',
            walkingApiEndpoint: '/api/tours'
        }) %>
    </div>
</div>

<script>
// Make client ID available globally for the walking tours component
window.clientId = '<%= clientId || "" %>';
</script>

<!-- Vehicle Tours DataTable -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="ti ti-car me-2 text-primary"></i>Tours con Vehículos
                </h5>
            </div>
            <div class="card-body">
                <%- include('../../organisms/datatable/tours-table', {
                    tableId: 'tours-table',
                    apiEndpoint: '/api/tours',
                    userRole: currentUserRole,
                    showActions: false,
                    showClientPricing: false,
                    clientId: typeof clientId !== 'undefined' ? clientId : null
                }) %>
            </div>
        </div>
    </div>
</div>