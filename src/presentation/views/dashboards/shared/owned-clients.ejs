<%
/**
 * Owned Clients Management Page
 * Shared view for department_manager and client roles to manage their own clients
 * Created by Denisse Maldonado
 *
 * Layout Structure (matching main dashboard):
 * - Direct row/column structure (no body-wrapper)
 * - Container-fluid from Flexy Bootstrap
 * - Consistent spacing and alignment
 *
 * Note: DataTables CSS/JS libraries are loaded via controller (pageStyles & footerScripts)
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'client';
const currentPath = '/dashboard/clients';
%>

<!-- Page Header with Breadcrumb -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1 fw-bold">Mis Clientes</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/dashboard/<%= currentUserRole === 'department_manager' ? 'client' : currentUserRole %>" class="text-decoration-none">
                                <i class="ti ti-home me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <i class="ti ti-building me-1"></i>Mis Clientes
                        </li>
                    </ol>
                </nav>
            </div>
            <div class="text-muted">
                <small class="d-block">Total clientes registrados</small>
                <strong id="total-clients-count">-</strong>
            </div>
        </div>
    </div>
</div>

<!-- Owned Clients DataTable -->
<div class="row">
    <div class="col-12">
        <%- include('../../organisms/datatable/owned-clients-table', {
            tableId: 'owned-clients-table',
            apiEndpoint: '/api/owned-clients',
            userRole: currentUserRole,
            showActions: true
        }) %>
    </div>
</div>

<!-- Client Management Modals -->
<!-- Create Client Modal -->
<div class="modal fade" id="createClientModal" tabindex="-1" aria-labelledby="createClientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="createClientModalLabel">
                    <i class="ti ti-building-plus me-2"></i>Crear Nuevo Cliente
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Modal Alert Container -->
                <div id="modalAlertContainer" class="mb-3" style="display: none;">
                    <div id="modalAlert" class="alert" role="alert">
                        <i id="modalAlertIcon" class="me-2"></i>
                        <span id="modalAlertMessage"></span>
                    </div>
                </div>

                <form id="createClientForm">
                    <!-- Sección: Información del Cliente -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-user me-1"></i>
                            Información del Cliente
                        </h6>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'name',
                                    id: 'clientName',
                                    label: 'Nombre del Cliente',
                                    required: true,
                                    placeholder: 'Ej: Juan Pérez o ACME Corporation',
                                    helpText: 'Nombre de la empresa o persona',
                                    inputAttributes: { maxlength: '200' }
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'email',
                                    name: 'email',
                                    id: 'clientEmail',
                                    label: 'Correo Electrónico',
                                    required: false,
                                    placeholder: 'Ej: cliente@empresa.com',
                                    helpText: 'Email de contacto principal'
                                }) %>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'contactPerson',
                                    id: 'clientContactPerson',
                                    label: 'Persona de Contacto',
                                    required: false,
                                    placeholder: 'Ej: María García',
                                    helpText: 'Nombre del contacto principal'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'tel',
                                    name: 'phone',
                                    id: 'clientPhone',
                                    label: 'Teléfono',
                                    required: false,
                                    placeholder: 'Ej: +52 999 123 4567',
                                    helpText: 'Número de contacto'
                                }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Sección: Información de la Empresa -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-building me-1"></i>
                            Información de la Empresa
                        </h6>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'select',
                                    name: 'companyType',
                                    id: 'companyType',
                                    label: 'Tipo de Empresa',
                                    required: false,
                                    options: [
                                        { value: '', label: 'Seleccione un tipo' },
                                        { value: 'individual', label: 'Persona Física' },
                                        { value: 'corporate', label: 'Persona Moral' },
                                        { value: 'travel_agency', label: 'Agencia de Viajes' },
                                        { value: 'tour_operator', label: 'Tour Operador' },
                                        { value: 'other', label: 'Otro' }
                                    ],
                                    helpText: 'Tipo de organización'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'taxId',
                                    id: 'clientTaxId',
                                    label: 'RFC / ID Fiscal',
                                    required: false,
                                    placeholder: 'Ej: ABC123456789',
                                    helpText: 'Identificación fiscal'
                                }) %>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'url',
                                    name: 'website',
                                    id: 'clientWebsite',
                                    label: 'Sitio Web',
                                    required: false,
                                    placeholder: 'https://www.ejemplo.com',
                                    helpText: 'URL del sitio web'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'address',
                                    id: 'clientAddress',
                                    label: 'Dirección',
                                    required: false,
                                    placeholder: 'Ej: Calle 60 #123, Centro, Mérida',
                                    helpText: 'Dirección física'
                                }) %>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'textarea',
                                    name: 'notes',
                                    id: 'clientNotes',
                                    label: 'Notas',
                                    required: false,
                                    placeholder: 'Notas adicionales sobre el cliente...',
                                    helpText: 'Información adicional relevante',
                                    inputAttributes: { rows: '3' }
                                }) %>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="createClientBtn">
                    <i class="ti ti-device-floppy me-1"></i>Crear Cliente
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Client Modal -->
<div class="modal fade" id="editClientModal" tabindex="-1" aria-labelledby="editClientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title text-white" id="editClientModalLabel">
                    <i class="ti ti-edit me-2"></i>Editar Cliente
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Modal Alert Container -->
                <div id="editModalAlertContainer" class="mb-3" style="display: none;">
                    <div id="editModalAlert" class="alert" role="alert">
                        <i id="editModalAlertIcon" class="me-2"></i>
                        <span id="editModalAlertMessage"></span>
                    </div>
                </div>

                <form id="editClientForm">
                    <input type="hidden" id="editClientId" name="editClientId">
                    
                    <!-- Same fields as create form, but with edit prefix -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-user me-1"></i>
                            Información del Cliente
                        </h6>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'name',
                                    id: 'editClientName',
                                    label: 'Nombre del Cliente',
                                    required: true,
                                    placeholder: 'Ej: Juan Pérez o ACME Corporation',
                                    helpText: 'Nombre de la empresa o persona',
                                    inputAttributes: { maxlength: '200' }
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'email',
                                    name: 'email',
                                    id: 'editClientEmail',
                                    label: 'Correo Electrónico',
                                    required: false,
                                    placeholder: 'Ej: cliente@empresa.com',
                                    helpText: 'Email de contacto principal'
                                }) %>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'contactPerson',
                                    id: 'editClientContactPerson',
                                    label: 'Persona de Contacto',
                                    required: false,
                                    placeholder: 'Ej: María García',
                                    helpText: 'Nombre del contacto principal'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'tel',
                                    name: 'phone',
                                    id: 'editClientPhone',
                                    label: 'Teléfono',
                                    required: false,
                                    placeholder: 'Ej: +52 999 123 4567',
                                    helpText: 'Número de contacto'
                                }) %>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="editClientActive" name="active">
                                    <label class="form-check-label" for="editClientActive">
                                        Cliente Activo
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-info text-white" id="updateClientBtn">
                    <i class="ti ti-device-floppy me-1"></i>Actualizar Cliente
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Page Scripts -->
<script>
// Initialize DataTable and client management functions
document.addEventListener('DOMContentLoaded', function() {
    loadOwnedClients();
    
    // Add event listeners for buttons to avoid CSP violations
    const createBtn = document.getElementById('createClientBtn');
    if (createBtn) {
        createBtn.addEventListener('click', createClient);
    }
    
    const updateBtn = document.getElementById('updateClientBtn');
    if (updateBtn) {
        updateBtn.addEventListener('click', updateClient);
    }
});

function loadOwnedClients() {
    // The DataTable will be initialized by the included table component
    updateClientCount();
}

async function updateClientCount() {
    try {
        const response = await fetch('/api/owned-clients?limit=1', {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            }
        });
        
        if (response.ok) {
            const data = await response.json();
            document.getElementById('total-clients-count').textContent = data.pagination?.total || '0';
        }
    } catch (error) {
        console.error('Error fetching client count:', error);
    }
}

async function createClient() {
    const form = document.getElementById('createClientForm');
    const formData = new FormData(form);
    
    const clientData = {
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        contactPerson: formData.get('contactPerson'),
        companyType: formData.get('companyType'),
        taxId: formData.get('taxId'),
        website: formData.get('website'),
        address: formData.get('address'),
        notes: formData.get('notes')
    };
    
    try {
        const response = await fetch('/api/owned-clients', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            },
            body: JSON.stringify(clientData)
        });
        
        const data = await response.json();
        
        if (response.ok && data.success) {
            showModalAlert('success', 'Cliente creado exitosamente');
            setTimeout(() => {
                $('#createClientModal').modal('hide');
                location.reload(); // Reload to refresh the table
            }, 1500);
        } else {
            showModalAlert('error', data.error || 'Error al crear el cliente');
        }
    } catch (error) {
        console.error('Error creating client:', error);
        showModalAlert('error', 'Error de conexión al crear el cliente');
    }
}

async function editClient(clientId) {
    try {
        const response = await fetch(`/api/owned-clients/${clientId}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            }
        });
        
        if (response.ok) {
            const data = await response.json();
            const client = data.data;
            
            // Populate edit form
            document.getElementById('editClientId').value = clientId;
            document.getElementById('editClientName').value = client.name || '';
            document.getElementById('editClientEmail').value = client.email || '';
            document.getElementById('editClientContactPerson').value = client.contactPerson || '';
            document.getElementById('editClientPhone').value = client.phone || '';
            document.getElementById('editClientActive').checked = client.active !== false;
            
            $('#editClientModal').modal('show');
        } else {
            showToast('error', 'Error al cargar los datos del cliente');
        }
    } catch (error) {
        console.error('Error loading client:', error);
        showToast('error', 'Error de conexión al cargar el cliente');
    }
}

async function updateClient() {
    const clientId = document.getElementById('editClientId').value;
    const form = document.getElementById('editClientForm');
    const formData = new FormData(form);
    
    const clientData = {
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        contactPerson: formData.get('contactPerson'),
        active: document.getElementById('editClientActive').checked
    };
    
    try {
        const response = await fetch(`/api/owned-clients/${clientId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            },
            body: JSON.stringify(clientData)
        });
        
        const data = await response.json();
        
        if (response.ok && data.success) {
            showEditModalAlert('success', 'Cliente actualizado exitosamente');
            setTimeout(() => {
                $('#editClientModal').modal('hide');
                location.reload();
            }, 1500);
        } else {
            showEditModalAlert('error', data.error || 'Error al actualizar el cliente');
        }
    } catch (error) {
        console.error('Error updating client:', error);
        showEditModalAlert('error', 'Error de conexión al actualizar el cliente');
    }
}

async function deleteClient(clientId, clientName) {
    if (confirm(`¿Está seguro que desea eliminar el cliente "${clientName}"?`)) {
        try {
            const response = await fetch(`/api/owned-clients/${clientId}`, {
                method: 'DELETE',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                }
            });
            
            const data = await response.json();
            
            if (response.ok && data.success) {
                showToast('success', 'Cliente eliminado exitosamente');
                location.reload();
            } else {
                showToast('error', data.error || 'Error al eliminar el cliente');
            }
        } catch (error) {
            console.error('Error deleting client:', error);
            showToast('error', 'Error de conexión al eliminar el cliente');
        }
    }
}

function showModalAlert(type, message) {
    const container = document.getElementById('modalAlertContainer');
    const alert = document.getElementById('modalAlert');
    const icon = document.getElementById('modalAlertIcon');
    const messageSpan = document.getElementById('modalAlertMessage');
    
    alert.className = `alert alert-${type === 'error' ? 'danger' : type}`;
    icon.className = `me-2 ti ti-${type === 'error' ? 'alert-circle' : 'circle-check'}`;
    messageSpan.textContent = message;
    container.style.display = 'block';
}

function showEditModalAlert(type, message) {
    const container = document.getElementById('editModalAlertContainer');
    const alert = document.getElementById('editModalAlert');
    const icon = document.getElementById('editModalAlertIcon');
    const messageSpan = document.getElementById('editModalAlertMessage');
    
    alert.className = `alert alert-${type === 'error' ? 'danger' : type}`;
    icon.className = `me-2 ti ti-${type === 'error' ? 'alert-circle' : 'circle-check'}`;
    messageSpan.textContent = message;
    container.style.display = 'block';
}

// Toast notification helper (assuming it's available globally)
function showToast(type, message) {
    if (typeof window.showToast === 'function') {
        window.showToast(type, message);
    } else {
        alert(message);
    }
}
</script>