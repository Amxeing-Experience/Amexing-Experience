<%
/**
 * Detalle de un cliente de agencia para department_manager / client (roles dueños).
 * Reusa los bloques del admin: Información (lectura), Facturación y Perfil de Viaje.
 * Locals: clientData, ownerRole ('department_manager' | 'client'), section, userRole.
 * Created by Denisse Maldonado
 */
const c = (typeof clientData !== 'undefined' && clientData) ? clientData : {};
const backRole = (typeof ownerRole !== 'undefined' && ownerRole) ? ownerRole : (typeof userRole !== 'undefined' ? userRole : 'department_manager');
const backHref = `/dashboard/${backRole}/clients`;
const displayName = c.companyName || `${c.firstName || ''} ${c.lastName || ''}`.trim() || c.email || 'Cliente';
const DIAL = { MX:'+52',US:'+1',CA:'+1',CO:'+57',AR:'+54',CL:'+56',PE:'+51',BR:'+55',EC:'+593',ES:'+34',GB:'+44',FR:'+33',DE:'+49',IT:'+39',PT:'+351',NL:'+31',BE:'+32',CH:'+41',SE:'+46',NO:'+47',DK:'+45',FI:'+358',PL:'+48',IE:'+353',AT:'+43' };
const phoneDial = (c.phone && DIAL[c.phoneCountry]) ? (DIAL[c.phoneCountry] + ' ') : '';
%>

<div class="container-fluid py-3 ocd-wrap">
  <nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="<%= backHref %>">Clientes</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= displayName %></li>
    </ol>
  </nav>

  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
      <div class="ocd-eyebrow">Cliente</div>
      <h3 class="mb-0 fw-bold"><%= displayName %></h3>
      <% if (c.email) { %><div class="text-muted small"><i class="ti ti-mail me-1"></i><%= c.email %></div><% } %>
    </div>
    <a href="<%= backHref %>" class="btn btn-outline-secondary btn-sm"><i class="ti ti-arrow-left me-1"></i>Volver</a>
  </div>

  <ul class="nav nav-pills ocd-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#ocd-info" type="button"><i class="ti ti-info-circle me-1"></i>Información</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#ocd-billing" type="button"><i class="ti ti-receipt-2 me-1"></i>Facturación</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#ocd-travel" type="button"><i class="ti ti-plane me-1"></i>Perfil de Viaje</button></li>
  </ul>

  <div class="tab-content">
    <!-- Información (editable) -->
    <div class="tab-pane fade show active" id="ocd-info">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div id="ocdAlert" class="alert d-none" role="alert"></div>
          <%- include('../../organisms/forms/client-form', {
            formId: 'ocdClientForm',
            idPrefix: 'ocd',
            isEdit: true,
            showPassword: true,
            passwordHelp: 'Déjala vacía para conservar la contraseña actual.',
            showActive: true
          }) %>
          <div class="d-flex justify-content-end mt-2">
            <button type="button" class="btn btn-primary" id="ocdSaveBtn"><i class="ti ti-device-floppy me-1"></i>Guardar cambios</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Facturación (editable) -->
    <div class="tab-pane fade" id="ocd-billing">
      <%- include('../../organisms/billing/billing-profiles-section', {
        userRole: backRole,
        readOnly: false,
        targetUserId: c.id,
        showHeader: false
      }) %>
    </div>

    <!-- Perfil de Viaje (editable, /api/agents/:id) -->
    <div class="tab-pane fade" id="ocd-travel">
      <div id="profileRoot" data-client-id="<%= c.id %>" data-owner-base="/api/agents/<%= c.id %>">
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="ti ti-id me-2 text-primary"></i>Pasaportes</h5>
            <button type="button" class="btn btn-sm btn-primary" id="addPassportBtn"><i class="ti ti-plus me-1"></i>Agregar Pasaporte</button>
          </div>
          <div class="card-body"><div id="passportsContainer"><p class="text-muted mb-0">Cargando…</p></div></div>
        </div>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="ti ti-map-pin me-2 text-primary"></i>Direcciones</h5>
            <button type="button" class="btn btn-sm btn-primary" id="addAddressBtn"><i class="ti ti-plus me-1"></i>Agregar Dirección</button>
          </div>
          <div class="card-body"><div id="addressesContainer"><p class="text-muted mb-0">Cargando…</p></div></div>
        </div>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="ti ti-plane me-2 text-primary"></i>Preferencias de Viaje</h5>
            <button type="button" class="btn btn-sm btn-primary" id="addPreferenceBtn"><i class="ti ti-edit me-1"></i>Editar preferencias</button>
          </div>
          <div class="card-body"><div id="preferencesContainer"><p class="text-muted mb-0">Cargando…</p></div></div>
        </div>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="ti ti-files me-2 text-primary"></i>Documentos</h5>
            <button type="button" class="btn btn-sm btn-primary" id="addDocumentBtn"><i class="ti ti-plus me-1"></i>Agregar documento</button>
          </div>
          <div class="card-body">
            <div id="documentFormWrap" class="border rounded p-3 mb-3 bg-light" style="display:none"></div>
            <div id="documentsContainer"><p class="text-muted mb-0">Cargando…</p></div>
          </div>
        </div>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="ti ti-star me-2 text-primary"></i>Programas de Lealtad</h5>
            <button type="button" class="btn btn-sm btn-primary" id="addLoyaltyBtn"><i class="ti ti-plus me-1"></i>Agregar Programa</button>
          </div>
          <div class="card-body"><div id="loyaltyContainer"><p class="text-muted mb-0">Cargando…</p></div></div>
        </div>
      </div>
      <%- include('../admin/sections/client-profile-section') %>
    </div>
  </div>
</div>

<script>
(function () {
  var CLIENT = <%- JSON.stringify(c).replace(/</g, '\\u003c') %>;
  var CLIENT_ID = CLIENT.id;
  var form = document.getElementById('ocdClientForm');
  var saveBtn = document.getElementById('ocdSaveBtn');
  var alertBox = document.getElementById('ocdAlert');
  if (!form || !saveBtn) return;

  function setVal(name, val) {
    var el = form.querySelector('[name="' + name + '"]');
    if (el) el.value = (val === null || val === undefined) ? '' : val;
  }
  var addr = CLIENT.address || {};
  setVal('firstName', CLIENT.firstName); setVal('lastName', CLIENT.lastName);
  setVal('email', CLIENT.email); setVal('phone', CLIENT.phone);
  setVal('contactFirstName', CLIENT.contactFirstName); setVal('contactLastName', CLIENT.contactLastName);
  setVal('emergencyContactName', CLIENT.emergencyContactName); setVal('emergencyContactPhone', CLIENT.emergencyContactPhone);
  setVal('companyType', CLIENT.companyType); setVal('taxId', CLIENT.taxId); setVal('website', CLIENT.website);
  setVal('streetType', addr.streetType); setVal('streetName', addr.streetName);
  setVal('exteriorNumber', addr.exteriorNumber); setVal('interiorNumber', addr.interiorNumber);
  setVal('colonia', addr.colonia); setVal('city', addr.city); setVal('state', addr.state); setVal('postalCode', addr.postalCode);
  setVal('preferredLanguage', CLIENT.preferredLanguage || 'es');
  setVal('accessibilityRequirements', CLIENT.accessibilityRequirements);
  setVal('allergies', Array.isArray(CLIENT.allergies) ? CLIENT.allergies.join('\n') : (CLIENT.allergies || ''));
  setVal('dietaryRestrictions', Array.isArray(CLIENT.dietaryRestrictions) ? CLIENT.dietaryRestrictions.join('\n') : (CLIENT.dietaryRestrictions || ''));
  setVal('notes', CLIENT.notes);
  if (CLIENT.birthDate) setVal('birthDate', ('' + CLIENT.birthDate).slice(0, 10));
  var activeEl = document.getElementById('ocdActive');
  if (activeEl) activeEl.checked = CLIENT.active !== false;

  function showAlert(type, msg) {
    if (!alertBox) return;
    alertBox.className = 'alert alert-' + (type === 'success' ? 'success' : 'danger');
    alertBox.textContent = msg;
    alertBox.classList.remove('d-none');
  }

  saveBtn.addEventListener('click', async function () {
    var fd = new FormData(form);
    var phoneFull = form.querySelector('input[name="phone_full"]');
    var phone = phoneFull ? phoneFull.value : fd.get('phone');
    var data = {
      firstName: fd.get('firstName'), lastName: fd.get('lastName'), email: fd.get('email'), phone: phone,
      contactFirstName: fd.get('contactFirstName'), contactLastName: fd.get('contactLastName'),
      emergencyContactName: fd.get('emergencyContactName'), emergencyContactPhone: fd.get('emergencyContactPhone'),
      companyType: fd.get('companyType'), taxId: fd.get('taxId'), website: fd.get('website'),
      streetType: fd.get('streetType'), streetName: fd.get('streetName'), exteriorNumber: fd.get('exteriorNumber'),
      interiorNumber: fd.get('interiorNumber'), colonia: fd.get('colonia'), city: fd.get('city'),
      state: fd.get('state'), postalCode: fd.get('postalCode'),
      preferredLanguage: fd.get('preferredLanguage'), accessibilityRequirements: fd.get('accessibilityRequirements'),
      allergies: fd.get('allergies'), dietaryRestrictions: fd.get('dietaryRestrictions'), notes: fd.get('notes'),
      active: activeEl ? activeEl.checked : true,
      password: fd.get('password')
    };
    if (fd.get('birthDate')) data.birthDate = fd.get('birthDate');

    saveBtn.disabled = true;
    try {
      var token = localStorage.getItem('accessToken') || localStorage.getItem('token');
      var res = await fetch('/api/owned-clients/' + CLIENT_ID, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify(data)
      });
      var out = await res.json().catch(function () { return {}; });
      if (res.ok && out.success !== false) {
        showAlert('success', 'Cambios guardados correctamente.');
        var pwd = form.querySelector('[name="password"]'); if (pwd) pwd.value = '';
      } else {
        showAlert('error', out.error || 'Error al guardar los cambios.');
      }
    } catch (e) {
      showAlert('error', 'Error de conexión al guardar.');
    } finally {
      saveBtn.disabled = false;
    }
  });
})();
</script>

<style>
  .ocd-wrap { max-width: 1000px; }
  .ocd-eyebrow { text-transform: uppercase; letter-spacing: .18em; font-size: .72rem; color: var(--olive, #6E7A50); font-weight: 700; }
  .ocd-tabs .nav-link { color: #5a6a85; }
  .ocd-tabs .nav-link.active { background: var(--olive, #6E7A50); color: #fff; }
  .ocd-field label { display:block; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; color:#9a9a8e; font-weight:600; margin-bottom:2px; }
  .ocd-field .val { font-size:.95rem; color:#2a3547; }
</style>
