<%
/**
 * Booking Detail Page
 * Department Manager dashboard page for viewing and managing a single reservation
 *
 * @author Denisse Maldonado
 * @version 1.0.0
 */
%>

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/dashboard/department_manager/bookings" class="text-decoration-none">Reservaciones</a></li>
                        <li class="breadcrumb-item active" id="breadcrumbFolio">Cargando...</li>
                    </ol>
                </nav>
                <h2 class="mb-0 fw-bold" id="pageTitle">
                    <i class="ti ti-clipboard-list me-2 text-primary"></i>
                    Reservación
                </h2>
            </div>
            <div id="headerActions"></div>
        </div>
    </div>
</div>

<!-- Loading State -->
<div id="loadingState" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
    <p class="text-muted mt-2">Cargando reservación...</p>
</div>

<!-- Reservation Content -->
<div id="reservationContent" style="display: none;">
    <!-- Info Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <small class="text-muted d-block">Folio</small>
                    <strong id="infoFolio">—</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Cotización</small>
                    <a href="#" id="infoQuoteLink" class="fw-semibold text-decoration-none">—</a>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Estado</small>
                    <span id="infoStatus">—</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Fecha Creación</small>
                    <span id="infoCreatedAt">—</span>
                </div>
            </div>
            <hr>
            <div class="row g-3">
                <div class="col-md-3">
                    <small class="text-muted d-block">Cliente</small>
                    <strong id="infoClient">—</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Contacto</small>
                    <span id="infoContact">—</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Motivo de viaje</small>
                    <span id="infoEventType">—</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Personas</small>
                    <span id="infoPeople">—</span>
                </div>
            </div>
            <hr>
            <div class="row g-3">
                <div class="col-md-3">
                    <small class="text-muted d-block">Fecha Inicio</small>
                    <span id="infoStartDate">—</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Fecha Fin</small>
                    <span id="infoEndDate">—</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Tipo de Pago</small>
                    <span id="infoPaymentType">—</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Total</small>
                    <strong id="infoTotal" class="text-success fs-5">—</strong>
                </div>
            </div>
            <hr>
            <div class="row g-3">
                <div class="col-md-6">
                    <small class="text-muted d-block">Seguidor de Servicio (Amexing)</small>
                    <span id="infoServiceCustomer" class="fw-semibold">—</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Summary Card (read-only) -->
    <div class="card border-0 shadow-sm mb-4" id="financialSummaryCard" style="display:none;">
        <div class="card-header" style="background: linear-gradient(135deg, #0d9488 0%, #5eead4 100%); border: none;">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-white">
                    <i class="ti ti-calculator me-2"></i>Resumen Financiero
                </h5>
                <button class="btn btn-sm btn-light d-none" id="addPaymentBtn">
                    <i class="ti ti-cash me-1"></i>Agregar pago
                </button>
            </div>
        </div>
        <div class="card-body" id="financialSummaryBody"></div>
    </div>

    <!-- Services by Day -->
    <div class="card border-0 shadow-sm">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #059669 0%, #34d399 100%); border: none;">
            <h5 class="card-title mb-0 text-white">
                <i class="ti ti-list-details me-2"></i>Servicios
            </h5>
        </div>
        <div class="card-body p-0" id="servicesContainer">
            <!-- Services will be rendered here -->
        </div>
    </div>
</div>

<!-- Assign Employee Modal -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Asignar Personal</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="assignServiceId">
                <div class="mb-3">
                    <label class="form-label">Conductor</label>
                    <select id="assignDriver" class="form-select form-select-sm">
                        <option value="">Sin asignar</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Guía</label>
                    <select id="assignGuide" class="form-select form-select-sm">
                        <option value="">Sin asignar</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Greeter</label>
                    <select id="assignGreeter" class="form-select form-select-sm">
                        <option value="">Sin asignar</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Vehículo</label>
                    <select id="assignVehicle" class="form-select form-select-sm">
                        <option value="">Sin asignar</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-sm btn-primary" id="saveAssignmentBtn">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Pagos — Offcanvas (Bootstrap 5 nativo). Agencia (department_manager) y agente (client) registran,
     editan y eliminan pagos de SUS reservaciones (backend nivel 4+), con el mismo formulario, validación y
     manejo de comprobante que admin. Se abre con "Agregar pago". Ancho 680px; full-width bajo sm (576px). -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="paymentsOffcanvas" aria-labelledby="paymentsOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title mb-0" id="paymentsOffcanvasLabel"><i class="ti ti-cash me-2"></i>Pagos</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body">
        <div class="rounded p-3 mb-3 payment-coverage-highlight" id="paymentCoverageCard"></div>
        <div class="mb-3" id="paymentDiscountEmphasis" style="display:none;"></div>
        <div class="text-muted fw-semibold small mb-2"><i class="ti ti-credit-card me-1"></i>Progreso por método de pago</div>
        <div class="mb-3" id="paymentChips"></div>
        <div class="p-3 mb-3" id="paymentRemainingByMethod" style="display:none;"></div>
        <!-- Historial de pagos (colapsado) + registro (agencia/agente) -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <button class="btn btn-sm btn-link text-decoration-none ps-0 fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#paymentsHistoryCollapse" id="paymentsHistoryToggle">
                <i class="ti ti-history me-1"></i>Historial de pagos <i class="ti ti-chevron-down ms-1" style="font-size:0.75rem;"></i>
            </button>
            <button class="btn btn-sm btn-primary d-none" id="showPaymentFormBtn"><i class="ti ti-plus me-1"></i>Registrar pago</button>
        </div>
        <!-- Formulario de pago inline (mismo patrón que admin: renderPaymentForm) -->
        <div id="paymentFormWrap" class="p-3 mb-3" style="display:none;"></div>
        <div class="collapse" id="paymentsHistoryCollapse">
            <div class="p-2" id="paymentsBody"></div>
        </div>
    </div>
</div>

<style>
#paymentsOffcanvas { --bs-offcanvas-width: 760px; }
@media (max-width: 576px) { #paymentsOffcanvas { --bs-offcanvas-width: 100%; } }
.offcanvas-backdrop.show { background-color: rgba(15,23,32,0.72) !important; opacity: 1 !important; }
#paymentsOffcanvas .offcanvas-body { background: #f8f9fa; font-size: 0.95rem; }
#paymentCoverageCard.payment-coverage-highlight,
#paymentChips .payment-chip-card,
#paymentRemainingByMethod,
#paymentFormWrap,
#paymentsBody {
    background: #fff;
    border: 1px solid #e0e6ed;
    border-radius: 0.5rem;
}
#paymentChips > div { background: transparent; border: none; }
#paymentCoverageCard.payment-coverage-highlight { border-left: 4px solid #969b81; }
#paymentChips .payment-chip-card,
#paymentRemainingByMethod,
#paymentFormWrap,
#paymentsBody {
    border-left: 4px solid #c0c3b3;
}
#paymentsBody { overflow: hidden; }
#paymentsOffcanvas #paymentsBody table { font-size: 0.8rem; }
#paymentsOffcanvas #paymentsBody .badge { font-size: 0.75rem; }
#paymentDiscountEmphasis > div, #paymentCoverageCard .rounded { border-radius: 0.5rem; }
.service-row {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    transition: background-color 0.15s;
}
.service-row:hover {
    background-color: #f8f9fa;
}
.service-row:last-child {
    border-bottom: none;
}
.day-header {
    background-color: #f8f9fa;
    padding: 0.5rem 1rem;
    font-weight: 600;
    border-bottom: 2px solid #e9ecef;
}
.assignment-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
}
.detail-tag {
    font-size: 0.9rem;
    padding: 0.15rem 0.4rem;
    font-weight: 500;
}
</style>

<!-- Shared payment breakdown helpers (isomorphic; also require'd by Jest) -->
<script src="/shared/payments/paymentBreakdownHelpers.js"></script>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    const token = localStorage.getItem('token') || sessionStorage.getItem('token');
    const reservationId = '<%= reservationId %>';
    let reservationData = null;
    let employeesCache = null;
    let vehiclesCache = null;

    function getInitials(name) {
        if (!name) return '?';
        return name.split(' ').map(w => w[0]).filter(Boolean).join('').substring(0, 2).toUpperCase();
    }

    function buildPersonCard(person, roleLabel, roleIcon, colorClass) {
        if (!person) return '';
        const name = person.fullName || 'Sin nombre';
        const phone = person.phone || '';
        const photo = person.profilePhotoUrl || '';
        const initials = getInitials(name);
        const photoHtml = photo
            ? `<img src="${photo}" class="rounded-circle photo-preview-trigger" width="36" height="36" style="object-fit:cover;cursor:pointer" data-photo="${photo}" data-name="${name.replace(/"/g, '&quot;')}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
            : '';
        const initialsDisplay = photo ? 'display:none' : 'display:flex';
        return `
            <div class="d-flex align-items-center gap-2 mb-2">
                ${photoHtml}
                <span class="rounded-circle bg-${colorClass}-subtle text-${colorClass} align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;${initialsDisplay};font-size:0.8rem;font-weight:600">${initials}</span>
                <div>
                    <div class="fw-semibold small">${name}</div>
                    <small class="text-${colorClass}"><i class="ti ${roleIcon} me-1"></i>${roleLabel}</small>
                    ${phone ? `<a href="tel:${phone}" class="text-muted small d-block"><i class="ti ti-phone me-1"></i>${phone}</a>` : ''}
                </div>
            </div>`;
    }

    function buildVehicleCard(vehicle) {
        if (!vehicle) return '';
        const name = vehicle.name || 'Vehiculo';
        const photo = vehicle.imageUrl || '';
        const initials = name.substring(0, 2).toUpperCase();
        const photoHtml = photo
            ? `<img src="${photo}" class="rounded-circle photo-preview-trigger" width="36" height="36" style="object-fit:cover;cursor:pointer" data-photo="${photo}" data-name="${name.replace(/"/g, '&quot;')}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
            : '';
        const initialsDisplay = photo ? 'display:none' : 'display:flex';
        return `
            <div class="d-flex align-items-center gap-2 mb-2">
                ${photoHtml}
                <span class="rounded-circle bg-secondary-subtle text-secondary align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;${initialsDisplay};font-size:0.8rem;font-weight:600">${initials}</span>
                <div>
                    <div class="fw-semibold small">${name}</div>
                    <small class="text-secondary"><i class="ti ti-car me-1"></i>Vehiculo</small>
                </div>
            </div>`;
    }

    function getQuoteStatusBadge(status) {
        if (!status) return '';
        const map = {
            scheduled: { label: 'Agendada', cls: 'bg-success text-white' },
            hold: { label: 'Bloqueada', cls: 'bg-warning text-dark' },
            requested: { label: 'Solicitada', cls: 'bg-info text-white' },
            quoted: { label: 'Cotizada', cls: 'bg-primary text-white' },
            rejected: { label: 'Rechazada', cls: 'bg-danger text-white' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado de cotización origen">${s.label}</span>`;
    }
    
    function getReservationStatusBadge(status) {
        const map = {
            pending: { label: 'Asignaciones pendientes', cls: 'bg-warning text-dark' },
            assigned: { label: 'Asignada', cls: 'bg-info text-white' },
            in_progress: { label: 'En Progreso', cls: 'bg-primary text-white' },
            completed: { label: 'Completada', cls: 'bg-success text-white' },
            cancelled: { label: 'Cancelada', cls: 'bg-danger text-white' },
            confirmed: { label: 'Confirmada', cls: 'bg-success text-white' },
            hold: { label: 'En Espera', cls: 'bg-warning text-dark' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado operacional de reservación">${s.label}</span>`;
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
    }

    function formatCurrency(amount, currency) {
        const sym = currency === 'USD' ? 'USD $' : '$';
        return `${sym}${(amount || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function getServiceTypeIcon(type) {
        const icons = {
            transport: 'ti-car',
            tour: 'ti-map-pin',
            experience: 'ti-sparkles',
            concepto: 'ti-tag',
            'a-disposicion': 'ti-clock',
        };
        return icons[type] || 'ti-point';
    }

    async function loadReservation() {
        try {
            const response = await fetch(`/api/reservations/${reservationId}`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const result = await response.json();
            if (!result.success) {
                document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al cargar la reservación</p>';
                return;
            }

            reservationData = result.data;
            renderReservation();
        } catch (error) {
            console.error('Error loading reservation:', error);
            document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al cargar la reservación</p>';
        }
    }

    function renderReservation() {
        const d = reservationData;

        document.getElementById('breadcrumbFolio').textContent = d.folio;
        document.getElementById('pageTitle').innerHTML = `<i class="ti ti-clipboard-list me-2 text-primary"></i>${d.folio}`;
        document.getElementById('infoFolio').textContent = d.folio;

        const quoteLink = document.getElementById('infoQuoteLink');
        if (d.quoteId) {
            quoteLink.href = `/dashboard/department_manager/quotes/${d.quoteId}?context=reservation`;
            quoteLink.textContent = d.quoteFolio;
        }

        const quoteBadge = getQuoteStatusBadge(d.quoteStatus);
        const reservationBadge = getReservationStatusBadge(d.status);
        document.getElementById('infoStatus').innerHTML = `${quoteBadge} ${reservationBadge}`;
        document.getElementById('infoCreatedAt').textContent = formatDate(d.createdAt);
        // Display company name first, then fallback to fullName or contactPerson
        const clientDisplay = d.client?.companyName || d.client?.fullName || d.contactPerson || '—';
        document.getElementById('infoClient').textContent = clientDisplay;
        document.getElementById('infoContact').innerHTML = `${d.contactEmail || ''}${d.contactPhone ? '<br>' + d.contactPhone : ''}`;
        document.getElementById('infoEventType').textContent = d.eventType || '—';
        document.getElementById('infoPeople').textContent = d.numberOfPeople || '—';
        document.getElementById('infoStartDate').textContent = formatDate(d.startDate);
        document.getElementById('infoEndDate').textContent = formatDate(d.endDate);
        document.getElementById('infoPaymentType').textContent = d.paymentType || '—';
        document.getElementById('infoTotal').textContent = formatCurrency(d.totalAmount, d.currency);

        // Service Customer
        const scEl = document.getElementById('infoServiceCustomer');
        if (d.serviceCustomer) {
            scEl.innerHTML = buildPersonCard(d.serviceCustomer, 'Seguidor', 'ti-user-star', 'primary');
        } else {
            scEl.innerHTML = '<span class="text-muted">Sin asignar</span>';
        }

        // Header actions — "Exportar" opens the public reservation view in a new tab,
        // which has the PDF export + print-friendly layout. "Cancelar" only shows when
        // the reservation can still be cancelled.
        const actions = document.getElementById('headerActions');
        const folio = encodeURIComponent(d.folio || '');
        const canCancel = d.status !== 'cancelled' && d.status !== 'completed';
        const exportBtnHtml = folio
            ? `<a class="btn btn-sm btn-outline-secondary" href="/reservations/${folio}" target="_blank" rel="noopener" title="Abrir vista pública (incluye Exportar a PDF)"><i class="ti ti-file-export me-1"></i>Exportar</a>`
            : '';
        const cancelBtnHtml = canCancel
            ? `<button class="btn btn-sm btn-outline-danger" id="cancelResBtn"><i class="ti ti-x me-1"></i>Cancelar Reservación</button>`
            : '';
        actions.innerHTML = `<div class="d-flex gap-2 align-items-center">${exportBtnHtml}${cancelBtnHtml}</div>`;
        if (canCancel) {
            document.getElementById('cancelResBtn')?.addEventListener('click', cancelReservation);
        }

        // Render services grouped by day
        renderServices(d.services);
        renderFinancialSummary();
        loadPayments();

        document.getElementById('loadingState').style.display = 'none';
        document.getElementById('reservationContent').style.display = '';
    }

    function renderFinancialSummary() {
        const d = reservationData;
        const card = document.getElementById('financialSummaryCard');
        const body = document.getElementById('financialSummaryBody');
        const adjustments = d.adjustments || [];
        const servicesSubtotal = d.servicesSubtotal || d.totalAmount || 0;
        const curr = d.currency || 'MXN';
        const pay = d.payment;
        // Propina cobrada (Fase 2): del summary del servidor (d.payment), NUNCA de d.globalTip del snapshot
        // bruto ni recalculada localmente. d.totalAmount ya la incluye vía recalculateTotal.
        const generalTip = pay ? PaymentBreakdownHelpers.round2(pay.generalTip) : 0;
        const serviceTipsTotal = pay ? PaymentBreakdownHelpers.round2(pay.serviceTipsTotal) : 0;

        // La tarjeta financiera se pinta SIEMPRE que haya datos de reservación, con o sin ajustes.
        // (Antes un early-return con 0 ajustes ocultaba también Subtotal/Total/Saldo — bug corregido.)
        card.style.display = '';
        document.getElementById('addPaymentBtn')?.classList.remove('d-none');

        // Esta plantilla es SIEMPRE de agencia: los ajustes se enmarcan como cargo/ajuste, nunca como
        // "descuento".

        let html = '';
        html += `<div class="d-flex justify-content-between align-items-center py-2 border-bottom">
            <span class="text-muted"><i class="ti ti-list-details me-2"></i>Subtotal Servicios</span>
            <span class="fw-semibold">${formatCurrency(servicesSubtotal, curr)}</span>
        </div>`;

        adjustments.filter(a => a.type === 'charge').forEach(adj => {
            html += `<div class="d-flex justify-content-between align-items-center py-2 border-bottom ps-3">
                <div><i class="ti ti-plus text-danger me-1"></i><span class="small">${PaymentBreakdownHelpers.escapeHtml(adj.description)}</span></div>
                <span class="text-danger fw-semibold">+${formatCurrency(adj.amount, curr)}</span>
            </div>`;
        });

        // Ajustes de tipo discount: se muestran como reducción (nunca se pierde dinero real) pero con
        // framing neutral de "ajuste" — sin la palabra "descuento" ni el ícono de descuento.
        adjustments.filter(a => a.type === 'discount').forEach(adj => {
            html += `<div class="d-flex justify-content-between align-items-center py-2 border-bottom ps-3">
                <div><i class="ti ti-minus text-success me-1"></i><span class="small">${PaymentBreakdownHelpers.escapeHtml(adj.description)}</span></div>
                <span class="text-success fw-semibold">-${formatCurrency(adj.amount, curr)}</span>
            </div>`;
        });

        // Propina cobrada (Fase 2): líneas del summary del servidor para que Subtotal + ajustes + propina
        // reconcilie con el Total a pagar. La general en su línea; la de por-servicio agregada (los tips por
        // servicio también aparecen por servicio en el itinerario, aquí es el agregado).
        if (generalTip > 0) {
            html += `<div class="d-flex justify-content-between align-items-center py-2 border-bottom ps-3">
                <div><i class="ti ti-coin text-info me-1"></i><span class="small">Propina general</span></div>
                <span class="text-info fw-semibold">+${formatCurrency(generalTip, curr)}</span>
            </div>`;
        }
        if (serviceTipsTotal > 0) {
            html += `<div class="d-flex justify-content-between align-items-center py-2 border-bottom ps-3">
                <div><i class="ti ti-coin text-info me-1"></i><span class="small">Propinas por servicio</span></div>
                <span class="text-info fw-semibold">+${formatCurrency(serviceTipsTotal, curr)}</span>
            </div>`;
        }

        // Bloque de pago (agencia/agente): Estado / Total a pagar / Pagado / Saldo. El "Saldo" se resuelve
        // con resolveDisplayedBalance (0 cuando está pagado; línea de ahorro aparte si se pagó en un método
        // más barato que el ancla). El detalle completo (chips, cobertura, saldo por método, descuento e
        // historial) vive en #paymentsOffcanvas, junto al formulario de registro ("Agregar pago").
        if (pay) {
            const resolved = PaymentBreakdownHelpers.resolveDisplayedBalance(pay);
            const balanceCls = resolved.displayedBalance > 0 ? 'text-danger' : 'text-success';
            const savingsRow = resolved.savings
                ? `<div class="py-2 border-top" style="color:#146c43;">
                    <div class="fw-semibold"><i class="ti ti-discount-2 me-2"></i>${PaymentBreakdownHelpers.escapeHtml(resolved.savings.label)}</div>
                    <div class="small">${PaymentBreakdownHelpers.escapeHtml(resolved.savings.sublabel)}</div>
                </div>` : '';
            html += `<div class="mt-2 pt-2">
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted"><i class="ti ti-cash me-2"></i>Estado de pago</span>
                    ${PaymentBreakdownHelpers.getPaymentStatusBadge(pay.paymentStatus)}
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted"><i class="ti ti-receipt-2 me-2"></i>Total a pagar</span>
                    <span class="fw-semibold">${formatCurrency(pay.total, curr)}</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted"><i class="ti ti-check me-2"></i>Pagado</span>
                    <span class="fw-semibold text-success">${formatCurrency(pay.paidAmount, curr)}</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-muted"><i class="ti ti-wallet me-2"></i>Saldo</span>
                    <span class="fw-semibold ${balanceCls}">${formatCurrency(resolved.displayedBalance, curr)}</span>
                </div>
                ${savingsRow}
            </div>`;
        }

        body.innerHTML = html;
    }

    // ===== PAGOS (registrar / editar / eliminar) =====
    // Portado de admin/booking-detail.ejs: agencia (department_manager) y agente (client) registran,
    // editan y eliminan pagos de SUS reservaciones (backend nivel 4+, requireRoleLevel(4)). Mismo
    // formulario, misma validación (fecha obligatoria, receivedBy condicional a efectivo, maxlength,
    // escapeHtml en texto libre) y mismo manejo de comprobante que admin. end_client NO porta esto: queda
    // de solo lectura por política de negocio.

    // Último summary AMPLIO de GET .../payments (coveragePercent/availableMethods/anchoredMethod/
    // montoParaSaldar). El summary ANGOSTO de getReservationById NO los trae — el carrito se puebla solo
    // desde aquí.
    let latestSummary = null;
    let paymentsCache = [];

    const PAYMENT_METHOD_LABELS = { efectivo: 'Efectivo', transferencia: 'Transferencia', tarjeta: 'Tarjeta' };

    // Live thousands formatting for the amount input (mismo comportamiento que admin).
    function formatThousandsInput(el) {
        const raw = el.value;
        const caret = el.selectionStart || 0;
        const digitsBeforeCaret = (raw.slice(0, caret).match(/\d/g) || []).length;
        let clean = raw.replace(/[^\d.]/g, '');
        const dot = clean.indexOf('.');
        if (dot !== -1) clean = clean.slice(0, dot + 1) + clean.slice(dot + 1).replace(/\./g, '');
        let [intPart = '', decPart] = clean.split('.');
        intPart = intPart.replace(/^0+(?=\d)/, '');
        const grouped = intPart ? Number(intPart).toLocaleString('en-US') : '';
        let out = grouped;
        if (decPart !== undefined) out += `.${decPart.slice(0, 2)}`;
        el.value = out;
        let pos = 0;
        let seen = 0;
        while (pos < out.length && seen < digitsBeforeCaret) {
            if (/\d/.test(out[pos])) seen += 1;
            pos += 1;
        }
        el.setSelectionRange(pos, pos);
    }

    function attachThousands(el) {
        if (!el) return;
        el.addEventListener('input', () => formatThousandsInput(el));
        if (el.value) formatThousandsInput(el);
    }

    // Parse an amount that may carry thousands separators ("1,234.56" -> 1234.56).
    function parseAmount(value) {
        return parseFloat(String(value == null ? '' : value).replace(/,/g, ''));
    }

    function paymentsOffcanvasInstance() {
        const el = document.getElementById('paymentsOffcanvas');
        return el ? bootstrap.Offcanvas.getOrCreateInstance(el) : null;
    }

    async function loadPayments() {
        try {
            const response = await fetch(`/api/reservations/${reservationId}/payments`, {
                headers: { 'Authorization': `Bearer ${token}` },
            });
            const result = await response.json();
            paymentsCache = result?.data?.payments || [];
            if (result?.data?.summary) applyPaymentSummary(result.data.summary);
        } catch (err) {
            console.error('Error loading payments:', err);
        }
        renderPayments();
    }

    function renderPayments() {
        const body = document.getElementById('paymentsBody');
        const showFormBtn = document.getElementById('showPaymentFormBtn');
        if (!body) return;

        const d = reservationData;
        const canEdit = d.status !== 'cancelled' && d.status !== 'completed';
        const curr = d.currency || 'MXN';

        // "Registrar pago" (dentro del carrito) solo si la reservación sigue editable (no cancelada/completada).
        if (showFormBtn) { if (canEdit) showFormBtn.classList.remove('d-none'); else showFormBtn.classList.add('d-none'); }

        if (!paymentsCache.length) {
            body.innerHTML = '<div class="text-center py-3 text-muted">Sin pagos registrados</div>';
            return;
        }

        const rows = paymentsCache.map((p) => {
            const ref = p.reference ? PaymentBreakdownHelpers.escapeHtml(p.reference) : '<span class="text-muted">—</span>';
            // "Recibió" solo aplica al efectivo; en otros métodos es irrelevante y se muestra un guion.
            const received = (p.method === 'efectivo' && p.receivedBy)
                ? PaymentBreakdownHelpers.escapeHtml(p.receivedBy) : '<span class="text-muted">—</span>';
            const receipt = p.receiptUrl
                ? `<a href="${PaymentBreakdownHelpers.escapeHtml(p.receiptUrl)}" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Ver comprobante"><i class="ti ti-file-invoice"></i></a>`
                : '<span class="text-muted">—</span>';
            return `<tr>
                <td>${formatDate(p.paidAt || p.createdAt)}</td>
                <td><span class="badge bg-secondary-subtle text-secondary">${PAYMENT_METHOD_LABELS[p.method] || p.method || '—'}</span></td>
                <td>${ref}</td>
                <td>${received}</td>
                <td class="text-end">${formatCurrency(p.amount, curr)}</td>
                <td>${p.origCurrency || curr}</td>
                <td class="text-center">${receipt}</td>
                <td class="text-end">
                    ${canEdit ? `<button class="btn btn-sm btn-outline-primary py-0 px-1 edit-payment-btn" data-payment-id="${p.id}" title="Editar"><i class="ti ti-edit"></i></button>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1 delete-payment-btn" data-payment-id="${p.id}" title="Eliminar"><i class="ti ti-trash"></i></button>` : ''}
                </td>
            </tr>`;
        }).join('');

        body.innerHTML = `<div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Método</th>
                        <th>Referencia</th>
                        <th>Recibió</th>
                        <th class="text-end">Monto</th>
                        <th>Moneda</th>
                        <th class="text-center">Comprobante</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
        </div>`;

        body.querySelectorAll('.edit-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => renderPaymentForm(btn.dataset.paymentId));
        });
        body.querySelectorAll('.delete-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => deletePayment(btn.dataset.paymentId));
        });
    }

    // Rellena las secciones del offcanvas (chips / cobertura / saldo restante / descuento) desde el
    // summary AMPLIO. Los % de cada chip y la barra usan coveragePercent/remainingPercent del backend TAL
    // CUAL (no re-derivar en cliente: rompería con ajustes manuales).
    function renderPaymentsOffcanvas() {
        if (!latestSummary) return;
        const services = reservationData?.services || [];
        const curr = reservationData?.currency || 'MXN';
        const chips = document.getElementById('paymentChips');
        const coverage = document.getElementById('paymentCoverageCard');
        const remaining = document.getElementById('paymentRemainingByMethod');
        const discount = document.getElementById('paymentDiscountEmphasis');
        if (chips) chips.innerHTML = PaymentBreakdownHelpers.buildMethodChips(latestSummary, services, curr);
        if (coverage) coverage.innerHTML = PaymentBreakdownHelpers.buildCoverageCard(latestSummary, curr);
        if (remaining) {
            const html = PaymentBreakdownHelpers.buildRemainingByMethod(latestSummary, curr);
            remaining.innerHTML = html;
            remaining.style.display = html ? '' : 'none';
        }
        if (discount) {
            const html = PaymentBreakdownHelpers.buildDiscountEmphasis(latestSummary, services, curr);
            discount.innerHTML = html;
            discount.style.display = html ? '' : 'none';
        }
    }

    function applyPaymentSummary(summary) {
        if (!summary) return;
        latestSummary = summary;
        if (reservationData.payment) Object.assign(reservationData.payment, summary);
        else reservationData.payment = { ...summary };
        renderFinancialSummary();
        renderPaymentsOffcanvas();
    }

    // Read a File as base64 (strip the "data:...;base64," prefix) for the JSON receipt upload.
    function fileToBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result).split(',')[1] || '');
            reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
            reader.readAsDataURL(file);
        });
    }

    // Upload a payment receipt in a SEPARATE request (decoupled from the save). El pago ya está
    // persistido, así que esto nunca lo arriesga: devuelve null si sube, o un aviso si falla.
    async function uploadReceipt(paymentId, file) {
        try {
            const body = JSON.stringify({
                fileBase64: await fileToBase64(file), fileName: file.name, mimeType: file.type,
            });
            const resp = await fetch(`/api/reservations/${reservationId}/payments/${paymentId}/receipt`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body,
            });
            const r = await resp.json().catch(() => ({}));
            if (resp.ok && r.success) return null;
            return r.error
                ? `Pago guardado, pero el comprobante no se subió: ${r.error}`
                : 'Pago guardado, pero el comprobante no se subió. Reinténtalo editando el pago.';
        } catch (err) {
            console.error('Receipt upload error:', err);
            return 'Pago guardado, pero el comprobante no se subió (se cortó la conexión). Reinténtalo editando el pago.';
        }
    }

    // Inline payment form (dentro de #paymentsOffcanvas). null = nuevo, id = editar el pago.
    function renderPaymentForm(paymentId) {
        const wrap = document.getElementById('paymentFormWrap');
        if (!wrap) return;
        const existing = paymentId ? paymentsCache.find((p) => p.id === paymentId) : null;
        const curr = existing?.origCurrency || 'MXN';
        const paidAt = existing?.paidAt ? new Date(existing.paidAt).toISOString().slice(0, 10) : '';
        // Payment date allows the future (reservations later); shared standard 1900 .. today + 20y.
        const paidAtMax = (() => { const dt = new Date(); dt.setFullYear(dt.getFullYear() + 20); return dt.toISOString().slice(0, 10); })();
        const opt = (v, label, sel) => `<option value="${v}" ${sel === v ? 'selected' : ''}>${label}</option>`;
        const receiptLink = existing?.receiptUrl
            ? `<a href="${existing.receiptUrl}" target="_blank" class="small d-block mt-1"><i class="ti ti-file-invoice me-1"></i>Ver comprobante actual</a>` : '';

        // Método: poblado dinámicamente desde availableMethods (Fase C), NUNCA hardcodeado a 3 opciones.
        // Al editar, se conserva el método guardado aunque ya no esté disponible (no cambiarlo en silencio).
        // Sin métodos disponibles (H3): select deshabilitado con mensaje y guardado bloqueado.
        const available = (latestSummary && Array.isArray(latestSummary.availableMethods)) ? latestSummary.availableMethods.slice() : [];
        const method = existing?.method || available[0] || '';
        const methodOrder = available.slice();
        if (existing?.method && !methodOrder.includes(existing.method)) methodOrder.push(existing.method);
        const methodDisabled = methodOrder.length === 0;
        const methodSelectHtml = methodDisabled
            ? `<select class="form-select form-select-sm" id="paymentMethod" disabled><option value="">Sin métodos disponibles</option></select>
               <div class="form-text text-danger">No hay métodos de pago disponibles para esta reservación.</div>`
            : `<select class="form-select form-select-sm" id="paymentMethod">${methodOrder.map((m) => opt(m, PAYMENT_METHOD_LABELS[m] || m, method)).join('')}</select>`;

        const amountInit = existing ? (existing.origAmount ?? existing.amount ?? '') : '';

        wrap.innerHTML = `
            <h6 class="fw-bold mb-2">${existing ? '<i class="ti ti-edit me-1"></i>Editar pago' : '<i class="ti ti-cash me-1"></i>Registrar pago'}</h6>
            <input type="hidden" id="paymentId" value="${existing ? existing.id : ''}">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentAmount">Monto</label>
                    <input type="text" inputmode="decimal" maxlength="17" class="form-control form-control-sm" id="paymentAmount" placeholder="0.00" value="${amountInit}">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentCurrency">Moneda</label>
                    <select class="form-select form-select-sm" id="paymentCurrency">${opt('MXN', 'MXN', curr)}${opt('USD', 'USD', curr)}</select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentMethod">Método</label>
                    ${methodSelectHtml}
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentPaidAt">Fecha de pago</label>
                    <input type="date" class="form-control form-control-sm" id="paymentPaidAt" min="1900-01-01" max="${paidAtMax}" value="${paidAt}" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold small" for="paymentReference">Referencia</label>
                    <input type="text" class="form-control form-control-sm" id="paymentReference" maxlength="100" placeholder="Folio / autorización" value="${PaymentBreakdownHelpers.escapeHtml(existing?.reference || '')}">
                </div>
                <div class="col-md-6" id="paymentReceivedByWrap" style="display:${method === 'efectivo' ? '' : 'none'};">
                    <label class="form-label fw-semibold small" for="paymentReceivedBy">¿Quién recibió el efectivo?</label>
                    <input type="text" class="form-control form-control-sm" id="paymentReceivedBy" maxlength="100" placeholder="Nombre de quien recibió" value="${PaymentBreakdownHelpers.escapeHtml(existing?.receivedBy || '')}" ${method === 'efectivo' ? 'required' : ''}>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold small" for="paymentReceipt">Comprobante (imagen o PDF)</label>
                    <input type="file" class="form-control form-control-sm" id="paymentReceipt" accept="image/*,application/pdf">
                    ${receiptLink}
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold small" for="paymentNotes">Notas</label>
                    <textarea class="form-control form-control-sm" id="paymentNotes" rows="2" maxlength="300" placeholder="Notas del pago">${PaymentBreakdownHelpers.escapeHtml(existing?.notes || '')}</textarea>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="cancelPaymentBtn">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary px-4" id="savePaymentBtn"><i class="ti ti-check me-1"></i>Guardar</button>
            </div>`;
        // El formulario vive dentro del offcanvas (posición fija con scroll propio): se muestra en su
        // sitio y se desplaza a la vista dentro del panel, sin scrollIntoView de página ni borde inline.
        wrap.style.display = '';
        wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const saveBtn = document.getElementById('savePaymentBtn');
        // Sin métodos disponibles (H3): no se puede registrar/editar el pago — bloquea el guardado.
        if (methodDisabled && saveBtn) saveBtn.disabled = true;
        document.getElementById('cancelPaymentBtn').addEventListener('click', () => { wrap.style.display = 'none'; wrap.innerHTML = ''; });
        saveBtn.addEventListener('click', () => savePayment(existing ? existing.id : ''));
        attachThousands(document.getElementById('paymentAmount'));

        // "¿Quién recibió el efectivo?" es visible + required SOLO cuando el método es efectivo, y
        // reacciona en vivo si el usuario cambia el método DESPUÉS de abrir el formulario.
        const methodSel = document.getElementById('paymentMethod');
        function syncReceivedByVisibility() {
            const isCash = methodSel && methodSel.value === 'efectivo';
            const wrapEl = document.getElementById('paymentReceivedByWrap');
            const inputEl = document.getElementById('paymentReceivedBy');
            if (wrapEl) wrapEl.style.display = isCash ? '' : 'none';
            if (inputEl) inputEl.required = !!isCash;
        }
        if (methodSel) methodSel.addEventListener('change', syncReceivedByVisibility);
        syncReceivedByVisibility();
    }

    // "Agregar pago" (header): abre el carrito. El formulario queda colapsado detrás de "Registrar pago".
    document.getElementById('addPaymentBtn')?.addEventListener('click', () => {
        paymentsOffcanvasInstance()?.show();
    });
    // "Registrar pago" (dentro del carrito): muestra el formulario de nuevo pago sin reabrir el panel.
    document.getElementById('showPaymentFormBtn')?.addEventListener('click', () => renderPaymentForm(null));
    // Cerrar el carrito (backdrop-click / Escape / botón) descarta el formulario en silencio (H5).
    document.getElementById('paymentsOffcanvas')?.addEventListener('hidden.bs.offcanvas', () => {
        const wrap = document.getElementById('paymentFormWrap');
        if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; }
    });

    async function savePayment(paymentId) {
        const amount = parseAmount(document.getElementById('paymentAmount').value);
        const paidAt = document.getElementById('paymentPaidAt').value;
        const method = document.getElementById('paymentMethod').value;
        const receivedByEl = document.getElementById('paymentReceivedBy');
        const receivedBy = receivedByEl ? receivedByEl.value.trim() : '';

        if (!amount || amount <= 0) { pmToast('El monto debe ser mayor a 0', 'warning'); return; }
        if (amount > 100000000) { pmToast('El monto no puede exceder 100,000,000', 'warning'); return; }
        if (!paidAt) { pmToast('La fecha de pago es obligatoria', 'warning'); return; }
        if (method === 'efectivo' && !receivedBy) { pmToast('Indica quién recibió el efectivo', 'warning'); return; }

        const payload = {
            amount,
            currency: document.getElementById('paymentCurrency').value,
            method,
            reference: document.getElementById('paymentReference').value.trim(),
            notes: document.getElementById('paymentNotes').value.trim(),
        };
        if (paidAt) payload.paidAt = paidAt;
        if (receivedBy) payload.receivedBy = receivedBy;

        // Receipt (optional) — validado aquí pero subido en una petición SEPARADA DESPUÉS de guardar el
        // pago (ver uploadReceipt), para que una subida lenta a S3 nunca bloquee ni pierda el pago.
        const fileInput = document.getElementById('paymentReceipt');
        const file = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
        if (file) {
            if (file.size > 10 * 1024 * 1024) { pmToast('El comprobante supera el límite de 10MB', 'warning'); return; }
            if (!/^image\//.test(file.type) && file.type !== 'application/pdf') { pmToast('El comprobante debe ser imagen o PDF', 'warning'); return; }
        }

        const isEdit = !!paymentId;
        const url = isEdit
            ? `/api/reservations/${reservationId}/payments/${paymentId}`
            : `/api/reservations/${reservationId}/payments`;
        const httpMethod = isEdit ? 'PUT' : 'POST';
        // Snapshot del conteo actual para reconciliar si la RESPUESTA se pierde: el request suele llegar
        // al servidor y guardar aunque la respuesta no regrese.
        const prevCount = paymentsCache.length;

        const btn = document.getElementById('savePaymentBtn');
        if (btn) btn.disabled = true;
        try {
            const response = await fetch(url, {
                method: httpMethod,
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });
            // Leer el body crudo primero para que una respuesta no-JSON (p. ej. página HTML de error)
            // muestre un mensaje claro en vez del genérico.
            const rawBody = await response.text();
            let result;
            try {
                result = JSON.parse(rawBody);
            } catch (parseErr) {
                pmToast(`Error del servidor (HTTP ${response.status})`, 'error');
                if (btn) btn.disabled = false;
                return;
            }
            if (result.success) {
                const savedId = result.data?.payment?.id || paymentId;
                // Sube el comprobante en su propia petición ahora que el pago está guardado. Si falla,
                // el pago se queda — solo avisamos para que el usuario reintente el comprobante.
                let receiptWarn = result.warning || null;
                if (file && savedId) receiptWarn = await uploadReceipt(savedId, file);
                const wrap = document.getElementById('paymentFormWrap');
                if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; }
                applyPaymentSummary(result.data?.summary);
                await loadPayments();
                if (receiptWarn) pmToast(receiptWarn, 'warning');
                else pmToast('Pago guardado', 'success');
            } else {
                let msg = result.error || 'No se pudo guardar el pago';
                if (result.detail) msg += ` — ${result.detail}`;
                if (response.status === 401) {
                    msg = `Sesión/token inválido (${result.detail || result.code || '401'}). Recarga la página (Ctrl+Shift+R) e intenta de nuevo.`;
                }
                pmToast(msg, 'error');
                if (btn) btn.disabled = false;
            }
        } catch (err) {
            // Error de red: el request suele llegar al servidor y guardar aunque la respuesta se pierda.
            // En vez de un falso fallo, reconciliamos desde el servidor (lo mismo que un Ctrl+R manual).
            console.error('Save payment network error, reconciling from server:', err);
            await loadPayments();
            let saved = !isEdit && paymentsCache.length > prevCount;
            if (!saved && !isEdit) {
                await new Promise((resolve) => setTimeout(resolve, 700));
                await loadPayments();
                saved = paymentsCache.length > prevCount;
            }
            const wrap = document.getElementById('paymentFormWrap');
            if (saved) {
                if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; }
                pmToast('Pago guardado (se recuperó tras un corte de conexión)', 'success');
            } else if (isEdit) {
                if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; }
                pmToast('La respuesta se perdió, pero la lista ya se actualizó — verifica que el pago sea correcto.', 'warning');
            } else {
                pmToast('No se pudo confirmar el guardado. Revisa la lista; si el pago no aparece, regístralo otra vez.', 'warning');
                if (btn) btn.disabled = false;
            }
        }
    }

    // ---- Styled confirm + toasts (reemplazan el confirm/alert nativo en el carrito de pagos) ----
    const pmEsc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    function pmConfirm({ title = 'Confirmar', message = '', confirmText = 'Aceptar', danger = false } = {}) {
        return new Promise((resolve) => {
            let el = document.getElementById('pmConfirmModal');
            if (!el) {
                document.body.insertAdjacentHTML('beforeend', `
                    <div class="modal fade" id="pmConfirmModal" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg" style="border-radius:0.85rem;overflow:hidden">
                          <div class="modal-body text-center px-4 pt-4 pb-2">
                            <div data-pm-icon class="d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;border-radius:50%"></div>
                            <h5 class="fw-bold mb-2" data-pm-title></h5>
                            <p class="text-muted mb-0" data-pm-msg></p>
                          </div>
                          <div class="modal-footer border-0 justify-content-center pt-1 pb-4 gap-2">
                            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn px-4" data-pm-ok></button>
                          </div>
                        </div>
                      </div>
                    </div>`);
                el = document.getElementById('pmConfirmModal');
            }
            el.querySelector('[data-pm-title]').textContent = title;
            el.querySelector('[data-pm-msg]').textContent = message;
            const icon = el.querySelector('[data-pm-icon]');
            icon.classList.remove('bg-danger-subtle', 'text-danger', 'bg-primary-subtle', 'text-primary');
            icon.classList.add(danger ? 'bg-danger-subtle' : 'bg-primary-subtle', danger ? 'text-danger' : 'text-primary');
            icon.innerHTML = `<i class="ti ${danger ? 'ti-alert-triangle' : 'ti-help-circle'}" style="font-size:1.75rem"></i>`;
            const old = el.querySelector('[data-pm-ok]');
            const ok = old.cloneNode(true);
            ok.textContent = confirmText;
            ok.className = `btn px-4 ${danger ? 'btn-danger' : 'btn-primary'}`;
            old.replaceWith(ok);
            const modal = bootstrap.Modal.getOrCreateInstance(el);
            let confirmed = false;
            ok.addEventListener('click', () => { confirmed = true; modal.hide(); });
            el.addEventListener('hidden.bs.modal', () => resolve(confirmed), { once: true });
            modal.show();
        });
    }

    function pmToast(message, type = 'info') {
        let c = document.getElementById('pmToastContainer');
        if (!c) {
            document.body.insertAdjacentHTML('beforeend', '<div id="pmToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090"></div>');
            c = document.getElementById('pmToastContainer');
        }
        const bg = {
            error: 'bg-danger text-white', success: 'bg-success text-white',
            warning: 'bg-warning text-dark', info: 'bg-dark text-white',
        }[type] || 'bg-dark text-white';
        const wrap = document.createElement('div');
        wrap.className = `toast align-items-center ${bg} border-0`;
        wrap.setAttribute('role', 'alert');
        wrap.innerHTML = `<div class="d-flex"><div class="toast-body">${pmEsc(message)}</div>`
            + `<button type="button" class="btn-close ${type === 'warning' ? '' : 'btn-close-white'} me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button></div>`;
        c.appendChild(wrap);
        const t = new bootstrap.Toast(wrap, { delay: 4500 });
        t.show();
        wrap.addEventListener('hidden.bs.toast', () => wrap.remove());
    }

    async function deletePayment(paymentId) {
        if (!(await pmConfirm({
            title: 'Eliminar pago', message: '¿Eliminar este pago? Esta acción no se puede deshacer.',
            confirmText: 'Eliminar', danger: true,
        }))) return;
        const existedBefore = paymentsCache.some((p) => p.id === paymentId);
        try {
            const response = await fetch(`/api/reservations/${reservationId}/payments/${paymentId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}` },
            });
            const result = await response.json();
            if (result.success) {
                applyPaymentSummary(result.data?.summary);
                await loadPayments();
                pmToast('Pago eliminado', 'success');
            } else {
                pmToast(result.error || 'Error al eliminar el pago', 'error');
            }
        } catch (err) {
            // Respuesta perdida — el delete pudo haber pasado. Reconciliamos desde el servidor en vez de
            // reportar un falso fallo (misma idea que el guardado).
            console.error('Delete payment network error, reconciling from server:', err);
            await loadPayments();
            const stillThere = paymentsCache.some((p) => p.id === paymentId);
            if (existedBefore && !stillThere) {
                pmToast('Pago eliminado (se recuperó tras un corte de conexión)', 'success');
            } else {
                pmToast('No se pudo confirmar la eliminación. Revisa la lista; si el pago sigue ahí, inténtalo otra vez.', 'warning');
            }
        }
    }

    function getSubconceptDetails(svc) {
        const sub = svc.subconcept;
        if (!sub) return '';
        const tags = [];
        const tag = (icon, text, color) => `<span class="badge detail-tag bg-${color}-subtle text-${color}"><i class="ti ti-${icon} me-1"></i>${text}</span>`;

        // Fase 2d: descuento y propina por servicio (ya reflejados en el total del servicio).
        if (Number(sub.discountAmount) > 0) {
            const dPct = (sub.discountType === 'percent' && sub.discountValue) ? ` ${sub.discountValue}%` : '';
            tags.push(tag('discount-2', `Descuento${dPct} −${formatCurrency(sub.discountAmount, reservationData.currency)}`, 'success'));
        }
        if (Number(sub.tipAmount) > 0) {
            const tPct = (sub.tipType === 'percent' && sub.tipValue) ? ` ${sub.tipValue}%` : '';
            const tMand = sub.tipMandatory ? ' (oblig.)' : '';
            tags.push(tag('coin', `Propina${tPct} +${formatCurrency(sub.tipAmount, reservationData.currency)}${tMand}`, 'info'));
        }

        // Vehicle quantity (applies to transport, a-disposicion, etc.)
        if (sub.quantity && sub.quantity > 1) tags.push(tag('car', `${sub.quantity} vehículos`, 'primary'));

        // Guide & Greeter status (applies to ALL service types)
        if (sub.includeGuide === true) {
            tags.push(tag('map-pin', 'Guía: Sí', 'success'));
        } else if (sub.includeGuide === false && (svc.type === 'transport' || svc.type === 'tour')) {
            tags.push(tag('map-pin', 'Guía: No', 'secondary'));
        }
        if (sub.includeGreeter === true) {
            const inVehicle = sub.greeterInVehicle ? ' (en vehículo)' : ' (en punto)';
            tags.push(tag('hand-stop', `Greeter: Sí${inVehicle}`, 'warning'));
        } else if (sub.includeGreeter === false && (svc.type === 'transport' || svc.type === 'tour')) {
            tags.push(tag('hand-stop', 'Greeter: No', 'secondary'));
        }

        // Transport-specific details
        if (svc.type === 'transport') {
            if (sub.tripType) {
                const tripLabel = sub.tripType === 'round-trip' ? 'Redondo' : 'Sencillo';
                const dirLabel = sub.directionType === 'arrival' ? 'Llegada' : 'Salida';
                tags.push(tag('arrows-exchange', `${tripLabel} — ${dirLabel}`, 'info'));
            }
            const pax = [];
            if (sub.transportAdults) pax.push(`${sub.transportAdults} adulto${sub.transportAdults > 1 ? 's' : ''}`);
            if (sub.transportChildren) pax.push(`${sub.transportChildren} niño${sub.transportChildren > 1 ? 's' : ''}`);
            if (sub.transportInfants) pax.push(`${sub.transportInfants} infante${sub.transportInfants > 1 ? 's' : ''}`);
            if (sub.persons && !pax.length) pax.push(`${sub.persons} persona${sub.persons > 1 ? 's' : ''}`);
            if (pax.length) tags.push(tag('users', pax.join(', '), 'primary'));
            if (sub.airline || sub.flightNumber) {
                const flightLabel = `${sub.airline || ''} ${sub.flightNumber || ''}`.trim();
                // Hora real del vuelo (llegada o salida del avión), distinta al pick-up del Horario.
                const fm = String(svc.time || sub.selectedSchedule || sub.time || '').match(/^(\d{1,2}:\d{2})/);
                const flightTime = fm ? fm[1] : '';
                tags.push(tag('plane', flightTime ? `${flightLabel} @ ${flightTime}` : flightLabel, 'info'));
            }
            if (sub.waitingTimeHours) tags.push(tag('clock-pause', `Espera: ${sub.waitingTimeHours}h`, 'warning'));
            if (Array.isArray(sub.extraAdditionalVehicles)) {
                sub.extraAdditionalVehicles.forEach((v) => {
                    const wh = parseFloat(v && v.waitingHours) || 0;
                    if (wh > 0) tags.push(tag('clock-pause', `Espera ${(v.vehicleTypeName || 'adicional')}: ${wh}h`, 'warning'));
                });
            }
            if (sub.routeDuration) tags.push(tag('route', `Duración: ${sub.routeDuration} min`, 'secondary'));
            
            // Horario = hora de pick-up del servicio (aeropuerto). Salida: la hora sugerida ES el
            // pick-up; llegada: el pick-up ocurre a la hora de llegada del pasajero.
            if (sub.transportType === 'aeropuerto') {
                let pickup = '';
                if (sub.directionType === 'departure') {
                    pickup = sub.flightDepartureTimeSuggested || '';
                } else if (sub.directionType === 'arrival') {
                    const am = String(sub.time || svc.time || sub.selectedSchedule || '').match(/^(\d{1,2}:\d{2})/);
                    pickup = am ? am[1] : '';
                }
                if (pickup) tags.push(tag('clock-hour-4', `Horario: ${pickup}`, 'success'));
            }
            if (sub.roundTripDepartureTimeSuggestedIda) {
                tags.push(tag('clock-hour-4', `Horario ida: ${sub.roundTripDepartureTimeSuggestedIda}`, 'success'));
            }
            if (sub.roundTripDepartureTimeSuggestedVuelta) {
                tags.push(tag('clock-hour-4', `Horario vuelta: ${sub.roundTripDepartureTimeSuggestedVuelta}`, 'success'));
            }
        }

        // Tour-specific details
        if (svc.type === 'tour') {
            if (sub.hotelName) tags.push(tag('building', sub.hotelName, 'secondary'));
            if (sub.isWalkingTour) tags.push(tag('walk', `Walking tour (${sub.walkingTourPeopleCount || 0} pax)`, 'info'));
            if (sub.persons) tags.push(tag('users', `${sub.persons} persona${sub.persons > 1 ? 's' : ''}`, 'primary'));
        }

        // Experience-specific details
        if (svc.type === 'experience') {
            const tickets = [];
            if (sub.adultsQuantity) tickets.push(`${sub.adultsQuantity} adulto${sub.adultsQuantity > 1 ? 's' : ''}`);
            if (sub.childrenQuantity) tickets.push(`${sub.childrenQuantity} niño${sub.childrenQuantity > 1 ? 's' : ''}`);
            if (sub.adultsNoAlcoholQuantity) tickets.push(`${sub.adultsNoAlcoholQuantity} sin alcohol`);
            if (tickets.length) tags.push(tag('ticket', tickets.join(', '), 'primary'));
            if (sub.selectedSchedule) tags.push(tag('clock', sub.selectedSchedule, 'info'));
        }

        // A Disposición-specific details
        if (svc.type === 'a-disposicion') {
            if (sub.selectedSchedule) tags.push(tag('clock', sub.selectedSchedule, 'info'));
            if (sub.discountPercent) tags.push(tag('discount-2', `${sub.discountPercent}% desc.`, 'success'));
        }

        // General fields
        if (sub.notes) tags.push(tag('note', `Admin: ${sub.notes}`, 'secondary'));
        if (sub.agencyNotes) tags.push(tag('user', `Cliente: ${sub.agencyNotes}`, 'info'));

        return tags.length ? `<div class="mt-1 d-flex flex-wrap gap-1">${tags.join('')}</div>` : '';
    }

    function renderServices(services) {
        const container = document.getElementById('servicesContainer');

        // Group by dayNumber
        const days = {};
        services.forEach(svc => {
            const key = svc.dayNumber || 1;
            if (!days[key]) days[key] = { title: svc.dayTitle || `Día ${key}`, date: svc.serviceDate, services: [] };
            days[key].services.push(svc);
        });

        if (Object.keys(days).length === 0) {
            container.innerHTML = '<div class="text-center py-4 text-muted">No hay servicios en esta reservación</div>';
            return;
        }

        let html = '';
        Object.keys(days).sort((a, b) => a - b).forEach(dayNum => {
            const day = days[dayNum];
            html += `<div class="day-header"><i class="ti ti-calendar-event me-1"></i>Día ${dayNum} — ${day.title}${day.date ? ' (' + formatDate(day.date) + ')' : ''}</div>`;

            day.services.forEach(svc => {
                const icon = getServiceTypeIcon(svc.type);
                // Build person cards for assigned employees
                let peopleHtml = '';
                let vehiclesHtml = '';
                peopleHtml += buildPersonCard(svc.assignedDriver, 'Conductor', 'ti-steering-wheel', 'info');
                peopleHtml += buildPersonCard(svc.assignedGuide, 'Guía', 'ti-map-pin', 'success');
                peopleHtml += buildPersonCard(svc.assignedGreeter, 'Greeter', 'ti-hand-stop', 'warning');
                peopleHtml += buildPersonCard(svc.assignedServiceCustomer, 'Seguidor', 'ti-user-star', 'primary');

                // Vehicle card
                if (svc.assignedVehicle) vehiclesHtml += buildVehicleCard(svc.assignedVehicle);

                // Extra assignments (additional vehicles/drivers)
                const extras = svc.extraAssignments || [];
                extras.forEach(ea => {
                    if (ea.driverName) peopleHtml += buildPersonCard({ fullName: ea.driverName, phone: '', profilePhotoUrl: '' }, 'Conductor', 'ti-steering-wheel', 'info');
                    if (ea.vehicleName) vehiclesHtml += buildVehicleCard({ name: ea.vehicleName, imageUrl: ea.vehicleImageUrl || '' });
                });

                const hasAssignments = peopleHtml || vehiclesHtml;

                const route = svc.originName || svc.destinationName
                    ? `<small class="text-muted">${svc.originName || ''}${svc.originName && svc.destinationName ? ' → ' : ''}${svc.destinationName || ''}</small>`
                    : '';

                // "Pago externo" (includeInTotal:false): el cliente lo paga directo a un tercero, NO es un
                // cargo que la agencia deba cobrar. Se marca junto al título (el precio ya se muestra
                // completo). Estilo tomado de .service-badge.external (services-renderer.js), no cargado aquí.
                const externalBadge = svc.subconcept?.includeInTotal === false
                    ? '<span class="badge me-1" style="background:rgba(150,155,129,0.15);color:#969b81;border:1px solid rgba(150,155,129,0.3);font-weight:600;">Pago externo</span>'
                    : '';

                const canAssign = false; // Assignment is admin-only

                html += `
                <div class="service-row d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center flex-grow-1">
                        <div>
                            <div class="fw-semibold">${externalBadge}${svc.concept || '—'}${svc.time ? ` <small class="text-muted">@ ${svc.time}</small>` : ''}</div>
                            ${route}
                            ${svc.vehicleTypeName ? `<small class="text-muted d-block">${svc.vehicleTypeName}</small>` : ''}
                            ${getSubconceptDetails(svc)}
                            ${hasAssignments ? `<div class="row mt-2"><div class="col-md-7">${peopleHtml}</div><div class="col-md-5">${vehiclesHtml}</div></div>` : (svc.type === 'concepto' ? '<div class="mt-2"><small class="text-muted">No requiere asignación</small></div>' : '<div class="mt-2"><small class="text-muted">Sin asignar</small></div>')}
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        ${svc.type === 'concepto' && svc.status !== 'cancelled' ? '<span class="badge bg-success text-white">Lista</span>' : getReservationStatusBadge(svc.status)}
                        <span class="text-end" style="min-width: 80px;">${formatCurrency(svc.total, reservationData.currency)}</span>
                        ${canAssign ? `<button class="btn btn-sm btn-outline-primary assign-btn" data-service-id="${svc.id}" data-driver-id="${svc.assignedDriver?.id || ''}" data-guide-id="${svc.assignedGuide?.id || ''}" data-greeter-id="${svc.assignedGreeter?.id || ''}" data-vehicle-id="${svc.assignedVehicle?.id || ''}"><i class="ti ti-user-plus"></i></button>` : ''}
                    </div>
                </div>`;
            });
        });

        container.innerHTML = html;

        // Bind assign buttons
        container.querySelectorAll('.assign-btn').forEach(btn => {
            btn.addEventListener('click', () => openAssignModal(btn));
        });
    }

    async function loadEmployees() {
        if (employeesCache) return employeesCache;
        try {
            const response = await fetch('/api/employees?limit=500', {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const result = await response.json();
            employeesCache = result.data?.users || result.data || result.results || [];
            return employeesCache;
        } catch { return []; }
    }

    async function loadVehicles() {
        if (vehiclesCache) return vehiclesCache;
        try {
            const response = await fetch('/api/vehicles?limit=500', {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const result = await response.json();
            vehiclesCache = result.data || result.results || [];
            return vehiclesCache;
        } catch { return []; }
    }

    async function openAssignModal(btn) {
        const serviceId = btn.dataset.serviceId;
        const driverId = btn.dataset.driverId;
        const guideId = btn.dataset.guideId;
        const greeterId = btn.dataset.greeterId;
        const vehicleId = btn.dataset.vehicleId;

        document.getElementById('assignServiceId').value = serviceId;

        // Load employees and vehicles
        const [employees, vehicles] = await Promise.all([loadEmployees(), loadVehicles()]);

        // Populate dropdowns
        const driverSelect = document.getElementById('assignDriver');
        const guideSelect = document.getElementById('assignGuide');
        const greeterSelect = document.getElementById('assignGreeter');
        const vehicleSelect = document.getElementById('assignVehicle');

        // Filter employees by role
        const drivers = employees.filter(e => e.role === 'driver' || e.role === 'employee_amexing');
        const guides = employees.filter(e => e.role === 'guia' || e.role === 'employee_amexing');
        const greeters = employees.filter(e => e.role === 'greeter' || e.role === 'employee_amexing');

        function populateSelect(select, items, selectedId, nameField) {
            select.innerHTML = '<option value="">Sin asignar</option>';
            items.forEach(item => {
                const name = item[nameField] || item.fullName || item.username || item.name || 'Sin nombre';
                const id = item.id || item.objectId;
                select.innerHTML += `<option value="${id}" ${id === selectedId ? 'selected' : ''}>${name}</option>`;
            });
        }

        populateSelect(driverSelect, drivers, driverId, 'fullName');
        populateSelect(guideSelect, guides, guideId, 'fullName');
        populateSelect(greeterSelect, greeters, greeterId, 'fullName');
        populateSelect(vehicleSelect, vehicles, vehicleId, 'name');

        const modal = new bootstrap.Modal(document.getElementById('assignModal'));
        modal.show();
    }

    document.getElementById('saveAssignmentBtn')?.addEventListener('click', async function() {
        const serviceId = document.getElementById('assignServiceId').value;
        const driverId = document.getElementById('assignDriver').value;
        const guideId = document.getElementById('assignGuide').value;
        const greeterId = document.getElementById('assignGreeter').value;
        const vehicleId = document.getElementById('assignVehicle').value;

        try {
            const response = await fetch(`/api/reservations/${reservationId}/services/${serviceId}/assign`, {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ driverId, guideId, greeterId, vehicleId }),
            });
            const result = await response.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('assignModal'))?.hide();
                await loadReservation(); // Reload to show updated assignments
            } else {
                alert(result.error || 'Error al guardar asignación');
            }
        } catch (err) {
            console.error('Assignment error:', err);
            alert('Error al guardar asignación');
        }
    });

    async function cancelReservation() {
        if (!confirm('¿Estás seguro de cancelar esta reservación? Se cancelarán todos los servicios.')) return;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/cancel`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json',
                },
            });
            const result = await response.json();
            if (result.success) {
                await loadReservation();
            } else {
                alert(result.error || 'Error al cancelar');
            }
        } catch (err) {
            console.error('Cancel error:', err);
            alert('Error al cancelar reservación');
        }
    }

    await loadReservation();
});

document.addEventListener('click', function(e) {
    const trigger = e.target.closest('.photo-preview-trigger');
    if (!trigger) return;
    document.getElementById('photoPreviewImg').src = trigger.dataset.photo;
    document.getElementById('photoPreviewName').textContent = trigger.dataset.name;
    new bootstrap.Modal(document.getElementById('photoPreviewModal')).show();
});
