<%
/**
 * Department Manager Vehicles Management Page
 * View-only access to Amexing vehicle fleet and vehicle types
 *
 * Layout Structure:
 * - Vertical navigation menu (collapsible)
 * - Two sections: Vehículos (vehicles list) and Tipos (vehicle types management)
 * - Section-based content rendering
 *
 * Note: DataTables CSS/JS libraries are loaded via controller
 * Department managers have read-only access to vehicle information
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'department_manager';
const activeSection = typeof section !== 'undefined' ? section : 'vehicles'; // Default to vehicles

// Menu items configuration - Only show vehicles for department_manager
const menuItems = [
    { label: 'Vehículos', icon: 'car', section: 'vehicles', href: '/dashboard/department_manager/vehicles' }
];
%>

<!-- Page Header with Breadcrumb -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-1 fw-bold">Vehículos</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/dashboard/department_manager" class="text-decoration-none">
                                <i class="ti ti-home me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <i class="ti ti-car me-1"></i>Vehículos
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Main Content without menu -->
<div class="row mt-4">
    <div class="col-12">
        <!-- Vehicles Management Section with Card View -->
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white" style="background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%); border: none;">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="card-title mb-0 text-white">
                            <i class="ti ti-car me-2"></i>Flota de Vehículos
                        </h5>
                        <small class="text-white" style="opacity: 0.9;">Vista de vehículos disponibles</small>
                    </div>
                </div>
            </div>

            <!-- Filtros -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="filterRate" class="form-label fw-semibold">
                            <i class="ti ti-percentage me-1"></i>Filtrar por Segmento
                        </label>
                        <select class="form-select" id="filterRate">
                            <option value="">Todos los segmentos</option>
                            <!-- Options loaded dynamically -->
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="filterType" class="form-label fw-semibold">
                            <i class="ti ti-list me-1"></i>Filtrar por Tipo
                        </label>
                        <select class="form-select" id="filterType">
                            <option value="">Todos los tipos</option>
                            <!-- Options loaded dynamically -->
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="searchVehicle" class="form-label fw-semibold">
                            <i class="ti ti-search me-1"></i>Buscar Vehículo
                        </label>
                        <input type="text" class="form-control" id="searchVehicle" placeholder="Buscar por marca o modelo...">
                    </div>
                </div>
            </div>

            <div class="card-body">
                <!-- Loading state -->
                <div id="vehiclesLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando vehículos...</span>
                    </div>
                    <p class="mt-2 text-muted">Cargando vehículos...</p>
                </div>

                <!-- Vehicles Grid -->
                <div id="vehiclesGrid" class="row g-4" style="display: none;">
                    <!-- Vehicle cards will be dynamically inserted here -->
                </div>

                <!-- No results message -->
                <div id="noVehiclesMessage" class="text-center py-5" style="display: none;">
                    <i class="ti ti-car-off" style="font-size: 3rem; color: #dee2e6;"></i>
                    <p class="mt-3 text-muted">No se encontraron vehículos con los filtros seleccionados</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Vehicle Card Styles -->
<style>
/* Vehicle Card Styles */
.vehicle-card {
    border: 1px solid #dee2e6;
    border-radius: 0.75rem;
    overflow: hidden;
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.vehicle-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    border-color: #06b6d4;
}

.vehicle-card-image {
    height: 200px;
    background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.vehicle-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.vehicle-card-image .no-image {
    color: #9ca3af;
    font-size: 3rem;
}

.vehicle-type-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(255, 255, 255, 0.95);
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1f2937;
    backdrop-filter: blur(5px);
}

.vehicle-card-body {
    padding: 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.vehicle-card-title {
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
}

.vehicle-card-info {
    flex: 1;
}

.vehicle-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid #f3f4f6;
}

.vehicle-info-row:last-child {
    border-bottom: none;
}

.vehicle-info-label {
    color: #6b7280;
    font-size: 0.875rem;
}

.vehicle-info-value {
    font-weight: 500;
    color: #1f2937;
}

.rate-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: white;
    font-weight: 500;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Vehicle management functionality
    let allVehicles = [];
    let filteredVehicles = [];

    // Get JWT token for API calls
    async function getAccessToken() {
        // First try localStorage
        let token = localStorage.getItem('accessToken') || localStorage.getItem('token');
        if (token) {
            console.log('Found token in localStorage:', token.substring(0, 20) + '...');
            return token;
        }
        
        // Try to get token from cookies directly
        const cookieToken = getCookie('accessToken');
        if (cookieToken) {
            console.log('Found token in cookies, storing in localStorage');
            localStorage.setItem('accessToken', cookieToken);
            return cookieToken;
        }
        
        console.log('No token found in localStorage or cookies');
        return '';
    }
    
    // Helper function to get cookie value
    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) {
            const cookieValue = parts.pop().split(';').shift();
            return cookieValue;
        }
        return null;
    }

    // Load vehicles from API
    async function loadVehicles() {
        try {
            const token = await getAccessToken();
            console.log('Using token for vehicles API:', token ? token.substring(0, 20) + '...' : 'NO TOKEN');
            
            const response = await fetch('/api/vehicles', {
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': 'application/json'
                }
            });

            console.log('Vehicles API response status:', response.status);

            if (!response.ok) {
                const errorText = await response.text();
                console.error('Vehicles API error:', response.status, errorText);
                throw new Error(`HTTP ${response.status}: ${errorText}`);
            }

            const data = await response.json();
            console.log('Vehicles data received:', data);
            allVehicles = data.data || [];
            filteredVehicles = [...allVehicles];
            
            populateFilters();
            displayVehicles();
            
            document.getElementById('vehiclesLoading').style.display = 'none';
            document.getElementById('vehiclesGrid').style.display = 'flex';
        } catch (error) {
            console.error('Error loading vehicles:', error);
            document.getElementById('vehiclesLoading').innerHTML = `
                <i class="ti ti-alert-circle text-danger" style="font-size: 3rem;"></i>
                <p class="mt-3 text-danger">Error al cargar vehículos</p>
                <p class="text-muted">${error.message}</p>
            `;
        }
    }

    // Populate filter dropdowns
    function populateFilters() {
        // Get unique rates
        const rates = [...new Set(allVehicles.map(v => v.rateId?.name).filter(Boolean))].sort();
        const rateSelect = document.getElementById('filterRate');
        rateSelect.innerHTML = '<option value="">Todos los segmentos</option>';
        rates.forEach(rate => {
            rateSelect.innerHTML += `<option value="${rate}">${rate}</option>`;
        });

        // Get unique types
        const types = [...new Set(allVehicles.map(v => v.vehicleTypeId?.name).filter(Boolean))].sort();
        const typeSelect = document.getElementById('filterType');
        typeSelect.innerHTML = '<option value="">Todos los tipos</option>';
        types.forEach(type => {
            typeSelect.innerHTML += `<option value="${type}">${type}</option>`;
        });
    }

    // Display vehicles as cards
    function displayVehicles() {
        const grid = document.getElementById('vehiclesGrid');
        const noResults = document.getElementById('noVehiclesMessage');

        if (filteredVehicles.length === 0) {
            grid.style.display = 'none';
            noResults.style.display = 'block';
            return;
        }

        grid.style.display = 'flex';
        noResults.style.display = 'none';

        grid.innerHTML = filteredVehicles.map(vehicle => {
            const typeName = vehicle.vehicleTypeId?.name || 'Sin tipo';
            const rateName = vehicle.rateId?.name || 'Sin segmento';
            const rateColor = getRateColor(rateName);
            const imageUrl = vehicle.image || '';
            const luggageCount = vehicle.luggageCapacity || vehicle.luggage_quantity || vehicle.luggageQuantity || vehicle.luggage || '-';
            
            return `
                <div class="col-md-6 col-lg-4">
                    <div class="vehicle-card">
                        <div class="vehicle-card-image">
                            ${imageUrl ? 
                                `<img src="${imageUrl}" alt="${vehicle.brand} ${vehicle.model}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                 <div class="no-image" style="display: none;"><i class="ti ti-car"></i></div>` :
                                `<div class="no-image"><i class="ti ti-car"></i></div>`
                            }
                            <div class="vehicle-type-badge">
                                ${typeName}
                            </div>
                        </div>
                        <div class="vehicle-card-body">
                            <h5 class="vehicle-card-title">
                                ${vehicle.brand} ${vehicle.model}
                            </h5>
                            <div class="vehicle-card-info">
                                <div class="vehicle-info-row">
                                    <span class="vehicle-info-label">
                                        <i class="ti ti-percentage me-1"></i>Segmento
                                    </span>
                                    <span class="rate-badge" style="background: ${rateColor};">
                                        ${rateName}
                                    </span>
                                </div>
                                <div class="vehicle-info-row">
                                    <span class="vehicle-info-label">
                                        <i class="ti ti-users me-1"></i>Capacidad
                                    </span>
                                    <span class="vehicle-info-value">
                                        ${vehicle.capacity || '-'} personas
                                    </span>
                                </div>
                                <div class="vehicle-info-row">
                                    <span class="vehicle-info-label">
                                        <i class="ti ti-briefcase me-1"></i>Equipaje
                                    </span>
                                    <span class="vehicle-info-value">
                                        ${luggageCount} piezas
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    // Get color for rate badge
    function getRateColor(rate) {
        const colors = {
            'Económica': '#10b981',
            'Estándar': '#3b82f6', 
            'Premium': '#8b5cf6',
            'Ejecutiva': '#f59e0b',
            'VIP': '#ef4444'
        };
        return colors[rate] || '#6b7280';
    }

    // Filter vehicles
    function filterVehicles() {
        const rateFilter = document.getElementById('filterRate').value;
        const typeFilter = document.getElementById('filterType').value;
        const searchFilter = document.getElementById('searchVehicle').value.toLowerCase();

        filteredVehicles = allVehicles.filter(vehicle => {
            const matchesRate = !rateFilter || vehicle.rateId?.name === rateFilter;
            const matchesType = !typeFilter || vehicle.vehicleTypeId?.name === typeFilter;
            const matchesSearch = !searchFilter || 
                vehicle.brand.toLowerCase().includes(searchFilter) ||
                vehicle.model.toLowerCase().includes(searchFilter);

            return matchesRate && matchesType && matchesSearch;
        });

        displayVehicles();
    }

    // Set up event listeners for filters
    document.getElementById('filterRate').addEventListener('change', filterVehicles);
    document.getElementById('filterType').addEventListener('change', filterVehicles);
    document.getElementById('searchVehicle').addEventListener('input', filterVehicles);

    // Load vehicles on page load
    loadVehicles();
});
</script>