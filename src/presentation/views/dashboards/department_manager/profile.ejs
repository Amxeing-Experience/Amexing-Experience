<%
/**
 * Employee Profile View
 * Displays the employee's personal information and settings
 * Created by Denisse Maldonado
 */

// User data setup
const user = typeof userData !== 'undefined' && userData !== null ? userData : {};
const profileData = {
  username: user.username || '',
  email: user.email || '',
  firstName: user.firstName || '',
  lastName: user.lastName || '',
  fullName: user.fullName || `${user.firstName || ''} ${user.lastName || ''}`.trim() || 'N/A',
  joinedDate: (user.createdAt || user.created_at || user._created_at) ? 
    new Date(user.createdAt || user.created_at || user._created_at).toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' }) : 
    '1 ene 2024',
  lastLoginAt: user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleString('es-MX', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }) : 'Sin registro',
  emailVerified: user.emailVerified || false,
  active: user.active !== undefined ? user.active : true,
  profilePicture: user.profilePicture || user.avatar || '',
  role: user.role || 'employee',
  organizationId: user.organizationId || '',
  phone: user.phone || '',
  companyName: user.companyName || '',
  taxId: user.taxId || '',
  website: user.website || '',
  notes: user.notes || '',
  address: user.address || {}
};

// Generate initials for avatar placeholder
const initials = profileData.fullName.split(' ')
  .map(word => word.charAt(0))
  .join('')
  .substring(0, 2)
  .toUpperCase() || 'UN';

// Format role display name
const formatRoleName = (role) => {
  if (role === 'department_manager') return 'Department Manager';
  if (role === 'superadmin') return 'Super Admin';
  if (role === 'employee_amexing') return 'Amexing Employee';
  return role.charAt(0).toUpperCase() + role.slice(1);
};
%>

<!-- Page Header -->
<div class="page-breadcrumb">
  <div class="row align-items-center">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 d-flex align-items-center">
          <li class="breadcrumb-item">
            <a href="/dashboard/admin" class="link">
              <i class="ti ti-home fs-6"></i>
            </a>
          </li>
          <li class="breadcrumb-item active" aria-current="page">My Profile</li>
        </ol>
      </nav>
      <h1 class="mb-0 fw-bold">My Profile</h1>
    </div>
  </div>
</div>

<style>
  /* ===== Rediseño limpio (sin card blanca) — perfil de usuario ===== */
  .profile-wrap { --olive: #6E7A50; --olive-d: #566040; --line: #e7e3d8; --ink: #2b2b2b; --muted: #8a8f78; }
  .profile-wrap .profile-name { font-size: 1.35rem; font-weight: 700; color: var(--ink); margin-bottom: .4rem; }
  .profile-wrap .profile-role { display: inline-flex; align-items: center; gap: 5px; background: #eef0e6; color: var(--olive-d); border: 1px solid var(--line); border-radius: 999px; padding: .25rem .85rem; font-size: .78rem; font-weight: 600; }
  .profile-wrap .profile-email { color: var(--muted); font-size: .9rem; }
  .profile-wrap .profile-info { border-left: 1px solid var(--line); padding-left: 32px; }
  .profile-wrap .profile-section-title { color: var(--olive-d); font-weight: 700; font-size: 1rem; border-bottom: 1px solid var(--line); padding-bottom: .6rem; }
  .profile-wrap .profile-field label { text-transform: uppercase; letter-spacing: .06em; font-size: .68rem; color: var(--muted); font-weight: 600; margin-bottom: 2px; display: block; }
  .profile-wrap .profile-field p { color: var(--ink); font-weight: 600; margin-bottom: 0; }
  .profile-wrap .profile-change-btn { border: 1px solid var(--line); color: var(--olive-d); background: #fff; border-radius: 8px; padding: .3rem .85rem; font-size: .82rem; font-weight: 600; transition: background .15s ease, border-color .15s ease; }
  .profile-wrap .profile-change-btn:hover { border-color: var(--olive); background: #eef0e6; color: var(--olive-d); }
  @media (max-width: 991.98px) {
    .profile-wrap .profile-info { border-left: 0; padding-left: 12px; margin-top: 14px; }
  }
</style>

<!-- Profile Content -->
<div class="container-fluid profile-wrap">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10">
      <div class="row g-4 align-items-start">
        <!-- Profile Picture & Basic Info -->
        <div class="col-lg-4 text-center">
          <!-- Profile Image Upload Component -->
          <%- include('../../organisms/profile/profile-image-upload', { profileData, initials }) %>

          <!-- Basic Info -->
          <h3 class="profile-name mt-3"><%= profileData.fullName %></h3>
          <div class="mb-2">
            <span class="profile-role"><i class="ti ti-user-shield"></i><%= formatRoleName(profileData.role) %></span>
          </div>
          <div class="profile-email">
            <i class="ti ti-mail me-1"></i><%= profileData.email %>
          </div>
        </div>

        <!-- Personal Information -->
        <div class="col-lg-8">
          <div class="profile-info">
            <h5 class="profile-section-title mb-4">Personal Information</h5>
            <div class="row">
              <div class="col-md-6 mb-3 profile-field">
                <label>First Name</label>
                <p><%= profileData.firstName || 'Not provided' %></p>
              </div>
              <div class="col-md-6 mb-3 profile-field">
                <label>Last Name</label>
                <p><%= profileData.lastName || 'Not provided' %></p>
              </div>
              <div class="col-md-6 mb-3 profile-field">
                <label>Email Address</label>
                <p><%= profileData.email || 'Not provided' %></p>
              </div>
              <div class="col-md-6 mb-3 profile-field">
                <label>Phone</label>
                <p><%= profileData.phone || 'Not provided' %></p>
              </div>
              <div class="col-md-6 mb-3 profile-field">
                <label>Account Status</label>
                <p>
                  <% if (profileData.active) { %>
                    <span class="badge bg-success">Active</span>
                  <% } else { %>
                    <span class="badge bg-danger">Inactive</span>
                  <% } %>
                </p>
              </div>
              <div class="col-12 mb-3 profile-field">
                <label>Password</label>
                <p>
                  <button class="profile-change-btn" id="change-password-btn">
                    <i class="ti ti-key me-1"></i>Change
                  </button>
                </p>
              </div>
              <div class="col-md-6 mb-3 profile-field">
                <label>Member Since</label>
                <p><%= profileData.joinedDate %></p>
              </div>
              <div class="col-md-6 mb-3 profile-field">
                <label>Last login</label>
                <p><%= profileData.lastLoginAt %></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Company & Fiscal Information -->
  <div class="row justify-content-center mt-4">
    <div class="col-12 col-lg-10">
      <div class="row g-4">
        <div class="col-lg-6">
          <h5 class="profile-section-title mb-4">Company Information</h5>
          <div class="row">
            <div class="col-12 mb-3 profile-field"><label>Company Name</label><p><%= profileData.companyName || 'Not provided' %></p></div>
            <div class="col-md-6 mb-3 profile-field"><label>RFC / Tax ID</label><p><%= profileData.taxId || 'Not provided' %></p></div>
            <div class="col-md-6 mb-3 profile-field"><label>Website</label><p><% if (profileData.website) { %><a href="<%= profileData.website %>" target="_blank"><i class="ti ti-external-link me-1"></i><%= profileData.website %></a><% } else { %>Not provided<% } %></p></div>
          </div>
        </div>
        <div class="col-lg-6">
          <h5 class="profile-section-title mb-4">Fiscal Address</h5>
          <div class="row">
            <div class="col-12 mb-3 profile-field"><label>Street</label><p><%= (profileData.address && profileData.address.street) || 'Not provided' %></p></div>
            <div class="col-md-6 mb-3 profile-field"><label>City</label><p><%= (profileData.address && profileData.address.city) || 'Not provided' %></p></div>
            <div class="col-md-6 mb-3 profile-field"><label>State</label><p><%= (profileData.address && profileData.address.state) || 'Not provided' %></p></div>
            <div class="col-md-6 mb-3 profile-field"><label>ZIP Code</label><p><%= (profileData.address && profileData.address.zipCode) || 'Not provided' %></p></div>
            <div class="col-md-6 mb-3 profile-field"><label>Country</label><p><%= (profileData.address && profileData.address.country) || 'Not provided' %></p></div>
          </div>
        </div>
      </div>
      <% if (profileData.notes) { %>
      <div class="mt-2 profile-field">
        <h5 class="profile-section-title mb-3">Notes</h5>
        <p class="mb-0" style="color: #2b2b2b;"><%= profileData.notes %></p>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Billing Profiles Section -->
  <div class="row justify-content-center mt-4">
    <div class="col-12 col-lg-10">
      <%- include('../../organisms/billing/billing-profiles-section', {
        userRole: typeof userRole !== 'undefined' ? userRole : 'department_manager'
      }) %>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const changePasswordBtn = document.getElementById('change-password-btn');
  if (changePasswordBtn) {
    changePasswordBtn.addEventListener('click', function() {
      window.location.href = '/dashboard/<%= profileData.role %>/change-password';
    });
  }
});
</script>