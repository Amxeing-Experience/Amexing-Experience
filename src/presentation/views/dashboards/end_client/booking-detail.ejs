<%
/**
 * Booking Detail Page
 * Client dashboard page for viewing and managing a single reservation
 *
 * @author Denisse Maldonado
 * @version 1.0.0
 */
%>

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/dashboard/end_client/bookings" class="text-decoration-none">Reservaciones</a></li>
                        <li class="breadcrumb-item active" id="breadcrumbFolio">Cargando...</li>
                    </ol>
                </nav>
                <h2 class="mb-0 fw-bold" id="pageTitle">
                    <i class="ti ti-clipboard-list me-2 text-primary"></i>
                    Reservación
                </h2>
            </div>
            <div id="headerActions"></div>
        </div>
    </div>
</div>

<!-- Loading State -->
<div id="loadingState" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
    <p class="text-muted mt-2">Cargando reservación...</p>
</div>

<!-- Reservation Content -->
<div id="reservationContent" style="display: none;">
    <!-- Info Card — misma tarjeta que client y department_manager. -->
    <div class="bkg-info mb-4">
        <!-- [Cliente | Customer Support] a la izquierda, Estado a la derecha; el folio ya está en el título -->
        <div class="bkg-top">
            <div class="bkg-top-left">
                <div>
                    <div class="bkg-eyebrow"><i class="ti ti-building me-1"></i>Cliente</div>
                    <div class="bkg-title" id="infoClient">&mdash;</div>
                </div>
                <div class="bkg-cs">
                    <span class="bkg-cs-lbl"><i class="ti ti-headset me-1"></i>Customer Support</span>
                    <div id="infoServiceCustomer">&mdash;</div>
                </div>
            </div>
            <div class="bkg-status" id="infoStatus">&mdash;</div>
        </div>

        <!-- Datos en tiles -->
        <div class="bkg-grid">
            <div class="bkg-tile">
                <div class="bkg-lbl"><i class="ti ti-file-invoice"></i> Cotización</div>
                <a href="#" id="infoQuoteLink" class="bkg-val bkg-link">&mdash;</a>
            </div>
            <div class="bkg-tile">
                <div class="bkg-lbl"><i class="ti ti-mail"></i> Contacto</div>
                <div class="bkg-val" id="infoContact">&mdash;</div>
            </div>
            <div class="bkg-tile is-empty" id="infoLeadGuestRow">
                <div class="bkg-lbl"><i class="ti ti-user"></i> Lead Guest</div>
                <div class="bkg-val" id="infoLeadGuest">&mdash;</div>
            </div>
            <div class="bkg-tile">
                <div class="bkg-lbl"><i class="ti ti-calendar"></i> Fechas</div>
                <div class="bkg-val bkg-dates" id="infoDates">&mdash;</div>
                <div class="bkg-sub" id="infoNights"></div>
            </div>
            <div class="bkg-tile">
                <div class="bkg-lbl"><i class="ti ti-users"></i> Personas</div>
                <div class="bkg-val" id="infoPeople">&mdash;</div>
            </div>
            <div class="bkg-tile">
                <div class="bkg-lbl"><i class="ti ti-plane"></i> Motivo de viaje</div>
                <div class="bkg-val" id="infoEventType">&mdash;</div>
            </div>
        </div>
    </div>

    <!-- Financial Summary Card (read-only) -->
    <div class="fin-wrap mb-4" id="financialSummaryCard" style="display:none;">
        <div class="fin-section-head">
            <h5 class="fin-section-title"><i class="ti ti-calculator me-2"></i>Resumen Financiero</h5>
            <!-- Acceso visible al carrito desde la cabecera. El del hero queda 27% más abajo, dentro
                 del bloque de totales, y con la tarjeta a media altura no se alcanza a ver. Hace
                 EXACTAMENTE lo mismo que aquél —incluido desplegar el formulario— para que no importe
                 por cuál se entre: dos puertas con comportamiento distinto fue justo lo que hizo que
                 el cajón abriera unas veces con el formulario y otras sin él. -->
            <button type="button" class="hdr-btn" id="viewPaymentsBtn">
                <i class="ti ti-cash"></i>Pagos
            </button>
        </div>
        <div id="financialSummaryBody"></div>
    </div>

    <!-- Services by Day -->
    <div class="svc-wrap">
        <div class="fin-section-head">
            <h5 class="fin-section-title"><i class="ti ti-list-details me-2"></i>Servicios</h5>
            <!-- Dos acciones sobre el mismo documento: verlo en pantalla y descargarlo. -->
            <span class="hdr-seg d-none" id="exportItinerarySeg" role="group" aria-label="Itinerario">
                <a class="hdr-seg-btn" id="previewItineraryBtn" href="#" target="_blank" rel="noopener"
                   title="Ver el itinerario en pantalla"><i class="ti ti-eye"></i>Ver itinerario</a>
                <a class="hdr-seg-btn" id="downloadItineraryBtn" href="#"
                   title="Descargar el itinerario en PDF"><i class="ti ti-download"></i>PDF</a>
            </span>
        </div>
        <div id="servicesContainer">
            <!-- Services will be rendered here -->
        </div>
    </div>
</div>

<!-- Assign Employee Modal -->

<link rel="stylesheet" href="/shared/services/serviceList.css">
<link rel="stylesheet" href="/shared/services/reservationHeader.css">
<link rel="stylesheet" href="/shared/services/reservationFinance.css">
<style>
.service-row {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    transition: background-color 0.15s;
}
.service-row:hover {
    background-color: #f8f9fa;
}
.service-row:last-child {
    border-bottom: none;
}
.day-header {
    background-color: #f8f9fa;
    padding: 0.5rem 1rem;
    font-weight: 600;
    border-bottom: 2px solid #e9ecef;
}
.assignment-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
}
.detail-tag {
    font-size: 0.9rem;
    padding: 0.15rem 0.4rem;
    font-weight: 500;
}
</style>

<!-- Shared payment breakdown helpers (isomorphic; also require'd by Jest) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="paymentsOffcanvas" aria-labelledby="paymentsOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title mb-0" id="paymentsOffcanvasLabel"><i class="ti ti-cash me-2"></i>Pagos</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body">
        <!-- Tabs: Pago (resumen + registrar + por método) | Historial. Reemplazan la columna única con
             chips + "saldo restante" + historial colapsado: el carrito crecía hacia abajo y obligaba a
             desplazarse para llegar al historial. -->
        <ul class="nav payments-seg mb-3" id="paymentsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tabPagoBtn" data-bs-toggle="tab" data-bs-target="#tabPago" type="button" role="tab" aria-selected="true"><i class="ti ti-cash me-1"></i>Pago</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tabHistorialBtn" data-bs-toggle="tab" data-bs-target="#tabHistorial" type="button" role="tab" aria-selected="false"><i class="ti ti-history me-1"></i>Historial <span id="historialCount" class="badge rounded-pill ms-1" style="background:#eef0e6;color:#566040;"></span></button>
            </li>
        </ul>
        <div class="tab-content">
            <!-- TAB PAGO -->
            <div class="tab-pane fade show active" id="tabPago" role="tabpanel" aria-labelledby="tabPagoBtn">
                <!-- Card de cobertura (total + estado + barra + Pagado/Saldo) -->
                <div class="rounded p-3 mb-3 payment-coverage-highlight" id="paymentCoverageCard"></div>
                <!-- Acción principal: registrar pago -->
                <button class="btn btn-primary w-100 mb-3 d-none" id="showPaymentFormBtn"><i class="ti ti-plus me-1"></i>Registrar pago</button>
                <!-- Formulario de pago inline (renderPaymentForm) -->
                <div id="paymentFormWrap" class="p-3 mb-3" style="display:none;"></div>
                <!-- Por método de pago: total + cubierto + restante (reemplaza chips y saldo restante) -->
                <div class="text-muted fw-semibold mb-2"><i class="ti ti-credit-card me-1"></i>Por método de pago</div>
                <div class="p-3 mb-3" id="paymentMethodTable" style="display:none;"></div>
            </div>
            <!-- TAB HISTORIAL -->
            <div class="tab-pane fade" id="tabHistorial" role="tabpanel" aria-labelledby="tabHistorialBtn">
                <div id="paymentsBody">
                    <!-- Payments table — rendered by JS -->
                </div>
            </div>
        </div>
    </div>
</div>


<script src="/shared/payments/paymentBreakdownHelpers.js"></script>
<script src="/shared/services/financialSummary.js"></script>
<script src="/shared/services/paymentsPanel.js"></script>
<script src="/shared/services/paymentForm.js"></script>
<script src="/shared/services/serviceListHelpers.js"></script>
<script src="/shared/services/serviceListRenderer.js"></script>
<script src="/shared/services/itineraryExport.js"></script>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    const token = localStorage.getItem('token') || sessionStorage.getItem('token');
    const reservationId = '<%= reservationId %>';
    let reservationData = null;
    let employeesCache = null;
    let vehiclesCache = null;

    function getInitials(name) {
        if (!name) return '?';
        return name.split(' ').map(w => w[0]).filter(Boolean).join('').substring(0, 2).toUpperCase();
    }

    function buildPersonCard(person, roleLabel, roleIcon, colorClass) {
        if (!person) return '';
        const name = person.fullName || 'Sin nombre';
        const phone = person.phone || '';
        const photo = person.profilePhotoUrl || '';
        const initials = getInitials(name);
        const photoHtml = photo
            ? `<img src="${photo}" class="rounded-circle photo-preview-trigger" width="36" height="36" style="object-fit:cover;cursor:pointer" data-photo="${photo}" data-name="${name.replace(/"/g, '&quot;')}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
            : '';
        const initialsDisplay = photo ? 'display:none' : 'display:flex';
        return `
            <div class="d-flex align-items-center gap-2 mb-2">
                ${photoHtml}
                <span class="rounded-circle bg-${colorClass}-subtle text-${colorClass} align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;${initialsDisplay};font-size:0.8rem;font-weight:600">${initials}</span>
                <div>
                    <div class="fw-semibold small">${name}</div>
                    <small class="text-${colorClass}"><i class="ti ${roleIcon} me-1"></i>${roleLabel}</small>
                    ${phone ? `<a href="tel:${phone}" class="text-muted small d-block"><i class="ti ti-phone me-1"></i>${phone}</a>` : ''}
                </div>
            </div>`;
    }

    function getQuoteStatusBadge(status) {
        if (!status) return '';
        const map = {
            scheduled: { label: 'Agendada', cls: 'bg-success text-white' },
            hold: { label: 'Bloqueada', cls: 'bg-warning text-dark' },
            requested: { label: 'Solicitada', cls: 'bg-info text-white' },
            quoted: { label: 'Cotizada', cls: 'bg-primary text-white' },
            rejected: { label: 'Rechazada', cls: 'bg-danger text-white' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado de cotización origen">${s.label}</span>`;
    }
    
    function getReservationStatusBadge(status) {
        const map = {
            pending: { label: 'Asignaciones pendientes', cls: 'bg-warning text-dark' },
            assigned: { label: 'Asignada', cls: 'bg-info text-white' },
            in_progress: { label: 'En Progreso', cls: 'bg-primary text-white' },
            completed: { label: 'Completada', cls: 'bg-success text-white' },
            cancelled: { label: 'Cancelada', cls: 'bg-danger text-white' },
            confirmed: { label: 'Confirmada', cls: 'bg-success text-white' },
            hold: { label: 'En Espera', cls: 'bg-warning text-dark' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado operacional de reservación">${s.label}</span>`;
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
    }

    function formatCurrency(amount, currency) {
        const sym = currency === 'USD' ? 'USD $' : '$';
        return `${sym}${(amount || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    async function loadReservation() {
        try {
            const response = await fetch(`/api/reservations/${reservationId}`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const result = await response.json();
            if (!result.success) {
                document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al cargar la reservación</p>';
                return;
            }

            reservationData = result.data;
            renderReservation();
        } catch (error) {
            console.error('Error loading reservation:', error);
            document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al cargar la reservación</p>';
        }
    }

    function renderReservation() {
        const d = reservationData;

        document.getElementById('breadcrumbFolio').textContent = d.folio;
        document.getElementById('pageTitle').innerHTML = `<i class="ti ti-clipboard-list me-2 text-primary"></i>${d.folio}`;

        const quoteLink = document.getElementById('infoQuoteLink');
        if (d.quoteId) {
            quoteLink.href = `/dashboard/end_client/quotes/${d.quoteId}?context=reservation`;
            quoteLink.textContent = d.quoteFolio;
        }

        // Header actions — "Exportar" opens the public reservation view in a new tab,
        // which has the PDF export + print-friendly layout. "Cancelar" only shows when
        // the reservation can still be cancelled.
        const quoteBadge = getQuoteStatusBadge(d.quoteStatus);
        const reservationBadge = getReservationStatusBadge(d.status);
        document.getElementById('infoStatus').innerHTML = `${quoteBadge} ${reservationBadge}`;
        // Display company name first, then fallback to fullName or contactPerson
        const clientDisplay = d.client?.companyName || d.client?.fullName || d.contactPerson || '—';
        document.getElementById('infoClient').textContent = clientDisplay;
        // Contacto: nombre (si existe) + email + teléfono, cada uno en su línea y solo si viene.
        const contactName = (d.contactPerson
            || `${d.contactFirstName || ''} ${d.contactLastName || ''}`.trim()).trim();
        const contactLines = [];
        if (contactName) contactLines.push(`<span class="fw-semibold">${PaymentBreakdownHelpers.escapeHtml(contactName)}</span>`);
        if (d.contactEmail) contactLines.push(PaymentBreakdownHelpers.escapeHtml(d.contactEmail));
        if (d.contactPhone) contactLines.push(PaymentBreakdownHelpers.escapeHtml(d.contactPhone));
        document.getElementById('infoContact').innerHTML = contactLines.length ? contactLines.join('<br>') : '&mdash;';
        document.getElementById('infoEventType').textContent = d.eventType || '—';
        document.getElementById('infoPeople').textContent = d.numberOfPeople || '—';
        // Fecha inicio y fin se fusionaron en un rango compacto; el Total dejó de repetirse aquí porque
        // el Resumen Financiero ya lo muestra ("Total a pagar").
        document.getElementById('infoDates').innerHTML = formatDateRange(d.startDate, d.endDate);
        // Duración (noches) = diferencia en días; se oculta en reservaciones de un solo día.
        const nightsEl = document.getElementById('infoNights');
        if (nightsEl) {
            if (d.startDate && d.endDate) {
                const nights = Math.max(0, Math.round((new Date(d.endDate) - new Date(d.startDate)) / 86400000));
                nightsEl.textContent = nights <= 0 ? '' : (nights === 1 ? '1 noche' : `${nights} noches`);
            } else {
                nightsEl.textContent = '';
            }
        }
        // El método de pago dejó de tener tile propio: se muestra como chip junto al "Total a pagar"
        // del Resumen Financiero, que es donde tiene contexto.

        // Lead guest — la celda siempre ocupa su lugar en la rejilla; solo se vacía cuando no hay uno.
        // Cae a contactPerson para que una reservación que trae al viajero en los campos de contacto
        // igual lo muestre como lead guest.
        const leadGuestParts = [d.leadGuestFirstName, d.leadGuestLastName]
            .map((p) => (p || '').trim())
            .filter(Boolean);
        const leadGuestName = leadGuestParts.length > 0
            ? leadGuestParts.join(' ')
            : (d.contactPerson || '').trim();
        const leadGuestRow = document.getElementById('infoLeadGuestRow');
        const leadGuestEl = document.getElementById('infoLeadGuest');
        if (leadGuestEl && leadGuestRow) {
            leadGuestEl.textContent = leadGuestName || '—';
            leadGuestRow.classList.toggle('is-empty', !leadGuestName);
        }

        // Service Customer — de solo lectura: reasignarlo es admin-only, así que aquí no hay botón.
        const scEl = document.getElementById('infoServiceCustomer');
        if (d.serviceCustomer) {
            scEl.innerHTML = buildPersonCard(d.serviceCustomer, 'Customer Support', 'ti-headset', 'primary');
        } else {
            scEl.innerHTML = '<span class="text-muted">Sin asignar</span>';
        }

        // Header actions — "Exportar confirmación" opens the public reservation view in a new tab,
        // which has the PDF export + print-friendly layout. "Cancelar" only shows when
        // the reservation can still be cancelled.
        const actions = document.getElementById('headerActions');
        const folio = encodeURIComponent(d.folio || '');
        const canCancel = d.status !== 'cancelled' && d.status !== 'completed';
        const exportBtnHtml = folio
            ? `<a class="hdr-btn" href="/reservations/${folio}" target="_blank" rel="noopener" title="Exportar confirmación — abre la vista pública, exportable a PDF"><i class="ti ti-file-export"></i>Exportar confirmación</a>`
            : '';
        const cancelBtnHtml = canCancel
            ? `<button type="button" class="hdr-danger" id="cancelResBtn"><i class="ti ti-x"></i>Cancelar reservación</button>`
            : '';
        actions.innerHTML = `<div class="d-flex gap-2 align-items-center">${exportBtnHtml}${cancelBtnHtml}</div>`;
        if (canCancel) {
            document.getElementById('cancelResBtn')?.addEventListener('click', cancelReservation);
        }

        // Los dos botones del itinerario los cablea ItineraryExport, compartido con los otros tres
        // detalles. Son rutas públicas por folio, la misma familia que "Exportar", así que no abren
        // acceso nuevo. Esta vista no tiene pmToast, así que el fallo del PDF avisa con alert.
        ItineraryExport.wire({ folio, alFallar: (msg) => alert(msg) });

        // "Registrar pago" dentro del carrito.
        document.getElementById('showPaymentFormBtn')?.addEventListener('click', () => {
            const wrap = document.getElementById('paymentFormWrap');
            if (wrap) paymentForm.renderPaymentForm(null, wrap);
        });

        // Render services grouped by day
        renderServices(d.services);

        // El historial y el resumen de cobertura vienen de GET /payments, que este rol SÍ puede leer.
        loadPayments();
        renderFinancialSummary();

        document.getElementById('loadingState').style.display = 'none';
        document.getElementById('reservationContent').style.display = '';
    }

    // Rango de fechas compacto (es-MX, UTC): mismo día → una sola fecha; mismo mes → "16 → 17 ago
    // 2026"; mismo año → "28 jul → 03 ago 2026"; años distintos → ambas completas.
    function formatDateRange(startStr, endStr) {
        if (!startStr) return '—';
        const start = new Date(startStr);
        if (Number.isNaN(start.getTime())) return '—';
        if (!endStr) return formatDate(startStr);
        const end = new Date(endStr);
        if (Number.isNaN(end.getTime())) return formatDate(startStr);
        // Se formatea día y mes por separado para evitar el guion del locale ("28-jul" → "28 jul").
        const fmt = (dt, o) => dt.toLocaleDateString('es-MX', Object.assign({ timeZone: 'UTC' }, o));
        const day = (dt) => fmt(dt, { day: '2-digit' });
        const dayMonth = (dt) => `${fmt(dt, { day: '2-digit' })} ${fmt(dt, { month: 'short' })}`;
        const full = (dt) => `${dayMonth(dt)} ${fmt(dt, { year: 'numeric' })}`;
        const sameYear = start.getUTCFullYear() === end.getUTCFullYear();
        const sameMonth = sameYear && start.getUTCMonth() === end.getUTCMonth();
        const sameDay = sameMonth && start.getUTCDate() === end.getUTCDate();
        const arrow = ' <span class="bkg-arrow">&rarr;</span> ';
        if (sameDay) return formatDate(startStr);
        if (sameMonth) return `${day(start)}${arrow}${full(end)}`;
        if (sameYear) return `${dayMonth(start)}${arrow}${full(end)}`;
        return `${full(start)}${arrow}${full(end)}`;
    }

    // Estado del carrito de pagos. Vive fuera de los render para sobrevivir a las recargas.
    let paymentsCache = [];
    let latestSummary = null;
    let paymentsSort = { key: 'date', dir: 'desc' };

    // Copiar al portapapeles con respaldo para contextos sin navigator.clipboard (HTTP, navegadores
    // viejos), donde la API no existe y el botón quedaría muerto sin avisar.
    async function copyToClipboard(text) {
        if (!text) return;
        try {
            if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(text);
            } else {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.setAttribute('readonly', '');
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
            }
            pmToast('Referencia copiada', 'success');
        } catch (err) {
            console.error('Error copiando al portapapeles:', err);
            pmToast('No se pudo copiar la referencia', 'warning');
        }
    }

    // Rellena las secciones del offcanvas (chips / cobertura / saldo restante / descuento) desde el
    // summary AMPLIO. Los % de cada chip y la barra usan coveragePercent/remainingPercent del backend TAL
    // CUAL (no re-derivar en cliente: rompería con ajustes manuales).
    // "En efectivo ahorras $X" bajo el total: el mismo hint del hero del Resumen Financiero, para que
    // el ahorro se vea al registrar el pago y no solo al bajar al desglose por método. Devuelve '' si no
    // hay un método más barato que el cotizado.
    function cheapestSavingsHint(summary, services, curr) {
        const H = PaymentBreakdownHelpers;
        const s = summary || {};
        const methods = Array.isArray(s.availableMethods) ? s.availableMethods : [];
        const anchor = s.anchoredMethod;
        const cheapest = H.cheapestAvailableMethod(methods, services, curr);
        if (!cheapest || !anchor || cheapest === anchor) return '';
        // Mismos totales por método que el resto del panel (subtotal del método + ajustes + propina).
        const extras = H.round2(s.adjustments) + H.round2(s.tip);
        const totalFor = (m) => Math.max(0, H.round2(H.computeServicesSubtotalByType(services, m, curr) + extras));
        const savings = H.round2(totalFor(anchor) - totalFor(cheapest));
        if (savings < 0.005) return '';
        return `<div class="pay-savings-hint"><i class="ti ti-discount-2"></i>En ${H.escapeHtml(H.methodLabel(cheapest).toLowerCase())} ahorras ${formatCurrency(savings, curr)}</div>`;
    }

    // Tabla "Por método de pago": un renglón por método con Total, Cubierto y Restante. Reemplaza los
    // chips de progreso + la sección de saldo restante, que repetían las mismas barras dos veces.
    // Total = subtotal por método + ajustes + propina; restante = montoParaSaldar del backend.
    function buildMethodTableHtml(summary, services, curr) {
        const H = PaymentBreakdownHelpers;
        const s = summary || {};
        const methods = Array.isArray(s.availableMethods) ? s.availableMethods : [];
        if (!methods.length) return '';
        const adjustments = H.round2(s.adjustments);
        const tip = H.round2(s.tip);
        const mps = s.montoParaSaldar || {};
        const isPaid = s.paymentStatus === 'paid';
        const paid = H.round2(s.paidAmount);
        const rows = methods.map((m) => {
            const total = Math.max(0, H.round2(H.computeServicesSubtotalByType(services, m, curr) + adjustments + tip));
            return {
                method: m,
                label: H.methodLabel(m),
                total,
                // % cubierto CORRECTO por método = pagado ÷ total del método (distinto en cada método).
                pct: total > 0 ? Math.min(100, Math.round((paid / total) * 100)) : 0,
                // Monto cubierto de ESTE total. Se topa al total del método por la misma razón que el
                // porcentaje: si lo pagado supera el total de un método más barato, lo excedente es
                // saldo a favor, no cobertura de este renglón.
                covered: Math.min(paid, total),
                remaining: H.round2(mps[m]),
            };
        });
        const cheapest = H.cheapestAvailableMethod(methods, services, curr);
        const anchor = s.anchoredMethod;
        const showCheaper = cheapest && anchor && cheapest !== anchor;
        // Ahorro del método más barato vs. el cotizado, dentro del tag "Más barato".
        const anchorTotal = (rows.find((r) => r.method === anchor) || {}).total || 0;
        const savingsVsAnchor = H.round2(anchorTotal - ((rows.find((r) => r.method === cheapest) || {}).total || 0));
        const thR = 'text-align:right;padding:.45rem .3rem;font-size:.66rem;text-transform:uppercase;letter-spacing:.05em;color:#8a8f78;font-weight:700;';
        const body = rows.map((r) => {
            const cheap = (showCheaper && r.method === cheapest)
                ? `<span class="badge ms-2" style="background:#146c43;color:#fff;font-size:.74rem;padding:.32em .6em;">Más barato · ahorra ${formatCurrency(savingsVsAnchor, curr)}</span>` : '';
            const remainingCell = isPaid
                ? '<span style="color:#4b6b3f;font-weight:700;">Pagado</span>'
                : `<span style="font-weight:700;color:#2b2b2b;">${formatCurrency(r.remaining, curr)}</span>`;
            return `<tr style="border-top:1px solid #f1efe8;">
                <td style="padding:.55rem .3rem;font-weight:600;">${H.escapeHtml(r.label)}${cheap}</td>
                <td style="padding:.55rem .3rem;text-align:right;color:#6b6656;">${formatCurrency(r.total, curr)}</td>
                <td style="padding:.55rem .3rem;text-align:right;">
                    <div style="font-weight:700;color:#4b6b3f;">${formatCurrency(r.covered, curr)}</div>
                    <div style="font-size:.76rem;font-weight:600;color:#8a8f78;">${r.pct}%</div>
                </td>
                <td style="padding:.55rem .3rem;text-align:right;">${remainingCell}</td>
            </tr>`;
        }).join('');
        return `<table style="width:100%;border-collapse:collapse;">
            <thead><tr>
              <th style="text-align:left;padding:.45rem .3rem;font-size:.66rem;text-transform:uppercase;letter-spacing:.05em;color:#8a8f78;font-weight:700;">Método</th>
              <th style="${thR}">Total</th>
              <th style="${thR}">Cubierto</th>
              <th style="${thR}">Restante</th>
            </tr></thead>
            <tbody>${body}</tbody>
          </table>`;
    }

    // El resumen lo arma FinancialSummary, compartido con client y department_manager.
    // `allowEdit: true` desde que el negocio retiró denyRoles('end_client') de los endpoints de
    // escritura: el hero pinta "Agregar pago" igual que en las otras tres vistas.
    function renderFinancialSummary() {
        const card = document.getElementById('financialSummaryCard');
        if (card) card.style.display = '';
        const body = document.getElementById('financialSummaryBody');
        if (body) {
            body.innerHTML = FinancialSummary.buildHtml({
                reservationData,
                formatCurrency,
                allowEdit: true,
            });
        }
    }

    const PAYMENT_METHOD_LABELS = { efectivo: 'Efectivo', transferencia: 'Transferencia', tarjeta: 'Tarjeta' };

    function attachThousands(el) {
        if (!el) return;
        el.addEventListener('input', () => formatThousandsInput(el));
        if (el.value) formatThousandsInput(el);
    }

    // Parse an amount that may carry thousands separators ("1,234.56" -> 1234.56).
    function parseAmount(value) {
        return parseFloat(String(value == null ? '' : value).replace(/,/g, ''));
    }

    function pmConfirm({ title = 'Confirmar', message = '', confirmText = 'Aceptar', danger = false } = {}) {
        return new Promise((resolve) => {
            let el = document.getElementById('pmConfirmModal');
            if (!el) {
                document.body.insertAdjacentHTML('beforeend', `
                    <div class="modal fade" id="pmConfirmModal" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg" style="border-radius:0.85rem;overflow:hidden">
                          <div class="modal-body text-center px-4 pt-4 pb-2">
                            <div data-pm-icon class="d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;border-radius:50%"></div>
                            <h5 class="fw-bold mb-2" data-pm-title></h5>
                            <p class="text-muted mb-0" data-pm-msg></p>
                          </div>
                          <div class="modal-footer border-0 justify-content-center pt-1 pb-4 gap-2">
                            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn px-4" data-pm-ok></button>
                          </div>
                        </div>
                      </div>
                    </div>`);
                el = document.getElementById('pmConfirmModal');
            }
            el.querySelector('[data-pm-title]').textContent = title;
            el.querySelector('[data-pm-msg]').textContent = message;
            const icon = el.querySelector('[data-pm-icon]');
            icon.classList.remove('bg-danger-subtle', 'text-danger', 'bg-primary-subtle', 'text-primary');
            icon.classList.add(danger ? 'bg-danger-subtle' : 'bg-primary-subtle', danger ? 'text-danger' : 'text-primary');
            icon.innerHTML = `<i class="ti ${danger ? 'ti-alert-triangle' : 'ti-help-circle'}" style="font-size:1.75rem"></i>`;
            const old = el.querySelector('[data-pm-ok]');
            const ok = old.cloneNode(true);
            ok.textContent = confirmText;
            ok.className = `btn px-4 ${danger ? 'btn-danger' : 'btn-primary'}`;
            old.replaceWith(ok);
            const modal = bootstrap.Modal.getOrCreateInstance(el);
            let confirmed = false;
            ok.addEventListener('click', () => { confirmed = true; modal.hide(); });
            el.addEventListener('hidden.bs.modal', () => resolve(confirmed), { once: true });
            modal.show();
        });
    }

    function pmToast(message, type = 'info') {
        let c = document.getElementById('pmToastContainer');
        if (!c) {
            document.body.insertAdjacentHTML('beforeend', '<div id="pmToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090"></div>');
            c = document.getElementById('pmToastContainer');
        }
        const bg = {
            error: 'bg-danger text-white', success: 'bg-success text-white',
            warning: 'bg-warning text-dark', info: 'bg-dark text-white',
        }[type] || 'bg-dark text-white';
        const wrap = document.createElement('div');
        wrap.className = `toast align-items-center ${bg} border-0`;
        wrap.setAttribute('role', 'alert');
        wrap.innerHTML = `<div class="d-flex"><div class="toast-body">${pmEsc(message)}</div>`
            + `<button type="button" class="btn-close ${type === 'warning' ? '' : 'btn-close-white'} me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button></div>`;
        c.appendChild(wrap);
        const t = new bootstrap.Toast(wrap, { delay: 4500 });
        t.show();
        wrap.addEventListener('hidden.bs.toast', () => wrap.remove());
    }

    // El formulario de pago lo arma PaymentForm, el mismo módulo que usan client y department_manager.
    // El cliente directo registra sus propios pagos desde que el negocio retiró denyRoles('end_client')
    // de los cuatro endpoints de escritura; lo que sigue acotándolo es la PROPIEDAD de la reservación,
    // que el controller aplica en loadReservation.
    const paymentForm = PaymentForm.create({
        reservationId,
        token: () => token,
        reservationData: () => reservationData,
        payments: () => paymentsCache,
        summary: () => latestSummary,
        formatCurrency,
        formatDate,
        toast: pmToast,
        confirm: pmConfirm,
        attachThousands,
        parseAmount,
        applySummary: applyPaymentSummary,
        reload: loadPayments,
        repaint: renderPayments,
        methodLabels: PAYMENT_METHOD_LABELS,
    });

    // Dos puertas al carrito —el botón de la cabecera y el del hero— pero UN SOLO comportamiento.
    // Antes la de la cabecera abría el cajón sin declarar intención, así que el formulario salía
    // colapsado según por dónde se entrara; el problema no eran las dos puertas sino que hicieran
    // cosas distintas.
    //
    // "Agregar pago" vive DENTRO del hero, que renderFinancialSummary vuelve a pintar en cada pago,
    // así que se cablea por DELEGACIÓN sobre el contenedor estable. Va al nivel del closure y no
    // dentro del render: ahí se volvería a registrar en cada recarga y un clic dispararía varias
    // veces. Sin este cableo el botón se dibujaba y no hacía nada, desde que este rol registra pagos.
    document.getElementById('financialSummaryCard')?.addEventListener('click', (e) => {
        // Las dos puertas del carrito, atendidas por el MISMO camino: el botón de la cabecera y el que
        // vive dentro del hero. La delegación las cubre a ambas porque las dos cuelgan de esta tarjeta.
        if (e.target.closest('#addPaymentBtn') || e.target.closest('#viewPaymentsBtn')) {
            paymentForm.requestAddForm();
            paymentsOffcanvasInstance()?.show();
        }
    });
    // Al terminar la animación de apertura: si el summary ya llegó, el formulario se despliega solo.
    // Se espera al 'shown' y no al 'show' porque antes el contenedor no está en su posición final.
    document.getElementById('paymentsOffcanvas')?.addEventListener('shown.bs.offcanvas', () => {
        paymentForm.maybeOpenAddForm();
    });


    /** Instancia del carrito, creada a demanda. */
    function paymentsOffcanvasInstance() {
        const el = document.getElementById('paymentsOffcanvas');
        return el ? bootstrap.Offcanvas.getOrCreateInstance(el) : null;
    }

    function renderPaymentsSkeleton() {
        const body = document.getElementById('paymentsBody');
        if (body) body.innerHTML = PaymentsPanel.renderPaymentsSkeleton();
    }

    function renderPaymentsLoadError() {
        const coverage = document.getElementById('paymentCoverageCard');
        if (coverage) {
            coverage.innerHTML = `<div class="text-center py-2">
                <div class="text-muted mb-2"><i class="ti ti-alert-triangle me-1"></i>No se pudo cargar la información de pagos.</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="retryPaymentsBtn"><i class="ti ti-refresh me-1"></i>Reintentar</button>
              </div>`;
            document.getElementById('retryPaymentsBtn')?.addEventListener('click', () => loadPayments());
        }
        const methodTable = document.getElementById('paymentMethodTable');
        if (methodTable) { methodTable.innerHTML = ''; methodTable.style.display = 'none'; }
        const body = document.getElementById('paymentsBody');
        if (body) body.innerHTML = PaymentsPanel.renderPaymentsLoadError();
    }

    // La tabla la arma PaymentsPanel; aquí se quedan el ORDEN y el pago en edición, que los cambia el
    // usuario al hacer clic, y esos clics los escucha esta vista.
    function renderPayments() {
        const body = document.getElementById('paymentsBody');
        if (!body) return;
        paymentForm.syncAddPaymentBtn();
        const histCount = document.getElementById('historialCount');
        if (histCount) histCount.textContent = paymentsCache.length ? String(paymentsCache.length) : '';
        body.innerHTML = PaymentsPanel.renderPayments({
            reservationData,
            formatCurrency,
            payments: paymentsCache,
            sort: paymentsSort,
            editingId: paymentForm.getEditingId(),
            allowEdit: true,
        });
        body.querySelectorAll('.pay-hist-sort').forEach((btn) => {
            btn.addEventListener('click', () => {
                const key = btn.dataset.sortKey;
                // Volver a la misma columna invierte el sentido; cambiar de columna arranca descendente.
                if (paymentsSort.key === key) paymentsSort.dir = paymentsSort.dir === 'asc' ? 'desc' : 'asc';
                else paymentsSort = { key, dir: 'desc' };
                renderPayments();
            });
        });
        body.querySelectorAll('.copy-ref-btn').forEach((btn) => {
            btn.addEventListener('click', () => copyToClipboard(btn.dataset.ref || ''));
        });
        body.querySelectorAll('.edit-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                // Cerrar primero descarta el otro formulario antes de abrir este.
                // Cerrar primero descarta el otro formulario antes de abrir este.
                paymentForm.closePaymentForm();
                paymentForm.setEditingId(btn.dataset.paymentId);
                renderPayments();
            });
        });
        body.querySelectorAll('.delete-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => paymentForm.deletePayment(btn.dataset.paymentId));
        });

        // El formulario inline se dibuja al final, cuando su contenedor ya está en el DOM.
        // El formulario inline se dibuja al final, cuando su contenedor ya está en el DOM. Si el pago
        // en edición desapareció, el estado se limpia solo.
        const editando = paymentForm.getEditingId();
        if (editando) {
            const editWrap = document.getElementById('paymentEditWrap');
            if (editWrap) paymentForm.renderPaymentForm(editando, editWrap);
            else paymentForm.setEditingId(null);
        }
    }

    function renderPaymentsOffcanvas() {
        if (!latestSummary) return;
        const services = reservationData?.services || [];
        const curr = reservationData?.currency || 'MXN';
        const coverage = document.getElementById('paymentCoverageCard');
        const methodTable = document.getElementById('paymentMethodTable');
        if (coverage) {
            coverage.innerHTML = PaymentBreakdownHelpers.buildCoverageCard(
                latestSummary, curr, cheapestSavingsHint(latestSummary, services, curr),
            );
        }
        if (methodTable) {
            const html = buildMethodTableHtml(latestSummary, services, curr);
            methodTable.innerHTML = html;
            methodTable.style.display = html ? '' : 'none';
        }
    }

    function applyPaymentSummary(summary) {
        if (!summary) return;
        latestSummary = summary;
        if (reservationData.payment) Object.assign(reservationData.payment, summary);
        else reservationData.payment = { ...summary };
        renderFinancialSummary();
        renderPaymentsOffcanvas();
        // Si el panel se abrió antes de que llegara el summary, este es el momento de desplegar el alta.
        paymentForm.maybeOpenAddForm();
    }

    // GET /payments SÍ está abierto a este rol: leer su propio historial es parte de su scope. Los
    // verbos de escritura son los que llevan denyRoles.
    async function loadPayments() {
        if (!latestSummary) renderPaymentsSkeleton();
        let loaded = false;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/payments`, {
                headers: { 'Authorization': `Bearer ${token}` },
            });
            const result = await response.json().catch(() => null);
            loaded = response.ok && !!result?.data;
            if (loaded) {
                paymentsCache = result.data.payments || [];
                if (result.data.summary) applyPaymentSummary(result.data.summary);
            } else {
                console.error('Error loading payments:', response.status, result);
            }
        } catch (err) {
            console.error('Error loading payments:', err);
        }
        if (!loaded && !latestSummary) { renderPaymentsLoadError(); return; }
        renderPayments();
    }

    // La lista la arma ServiceListRenderer, la MISMA que pinta el detalle de admin. Esta vista
    // traía el layout de dos columnas de hace varias versiones, y hasta nombraba "Seguidor" a lo que
    // en el resto del sistema es Customer Support.
    //
    // `allowAssign: false` — asignar es de admin, y no basta con no pintar el botón: sin esto los
    // círculos salen clicables. El rol va LITERAL: de él dependen los canales de notas.
    function renderServices(services) {
        const container = document.getElementById('servicesContainer');
        container.innerHTML = ServiceListRenderer.buildHtml(services, {
            reservationData,
            formatCurrency,
            allowAssign: false,
            userRole: 'end_client',
        });
    }

    async function cancelReservation() {
        if (!confirm('¿Estás seguro de cancelar esta reservación? Se cancelarán todos los servicios.')) return;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/cancel`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json',
                },
            });
            const result = await response.json();
            if (result.success) {
                await loadReservation();
            } else {
                alert(result.error || 'Error al cancelar');
            }
        } catch (err) {
            console.error('Cancel error:', err);
            alert('Error al cancelar reservación');
        }
    }

    await loadReservation();
});

document.addEventListener('click', function(e) {
    const trigger = e.target.closest('.photo-preview-trigger');
    if (!trigger) return;
    document.getElementById('photoPreviewImg').src = trigger.dataset.photo;
    document.getElementById('photoPreviewName').textContent = trigger.dataset.name;
    new bootstrap.Modal(document.getElementById('photoPreviewModal')).show();
});
</script>

<!-- Photo Preview Modal -->
