<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= pageTitle || 'Reservación' %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/dashboard/css/icons/tabler-icons/tabler-icons.css">
    <link rel="icon" type="image/png" href="/images/heart_black.png">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
            padding: 2rem 0;
        }

        .public-quote-container {
            max-width: 1200px;
            margin: 0 auto;
            background: #fff;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            border-radius: 8px;
            padding: 2rem;
        }

        .public-header {
            text-align: center;
            padding-bottom: 1rem;
        }

        .header-logo { margin-bottom: 1.5rem; }
        .header-folio { margin-top: 1rem; }

        .public-header h1 {
            background: #969b81;
            color: white;
            font-size: 1.2rem;
            font-weight: 400;
            letter-spacing: 0.3rem;
            text-transform: uppercase;
            padding: 0.75rem;
            margin: 0;
            display: block;
            border-radius: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            width: 100%;
            text-align: center;
        }

        .public-header p {
            color: #6c757d;
            font-size: 1rem;
            margin: 0;
        }

        .public-footer {
            text-align: center;
            padding-top: 2rem;
            color: #6c757d;
            font-size: 1.1rem;
        }

        .public-footer a { color: black; text-decoration: none; }
        .public-footer a:hover { text-decoration: underline; }

        @media print {
            body { background: #fff; padding: 0; }
            .public-quote-container { box-shadow: none; border-radius: 0; padding: 0; }
            .public-header, .public-footer { display: none; }
        }

        /* PDF mode (puppeteer adds body.pdf-export-mode when ?pdf=1 is set): remove the gray
           outer page background, padding, max-width cap, shadow and rounded corners so the
           document uses the full page width. */
        body.pdf-export-mode { background: #fff !important; padding: 0 !important; }
        body.pdf-export-mode .public-quote-container {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0.5rem !important;
            box-shadow: none !important;
            border-radius: 0 !important;
        }
        /* Only hide the wrapper footer link — the .public-header inside quote-summary is
           the AMEXING + folio banner and must stay visible in the PDF. */
        body.pdf-export-mode > .public-quote-container > .public-footer { display: none !important; }
    </style>
</head>
<body>
    <div class="public-quote-container">
        <%- include('./sections/quote-summary', {
            quote: quote,
            isPublicView: true,
            isReservationView: typeof isReservationView !== 'undefined' ? isReservationView : true
        }) %>

        <div class="public-footer">
            <p>
                <a href="https://www.amexingexperience.com" target="_blank" rel="noopener">amexingexperience.com</a>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/services-renderer-config.js"></script>
    <script src="/js/services-renderer.js"></script>
</body>
</html>
