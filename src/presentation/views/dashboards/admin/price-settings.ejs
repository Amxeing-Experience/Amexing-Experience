function setDefaultDateTime() {
    const now = new Date();
    const localDateTime = new Date(now.getTime() - now.getTimezoneOffset() * 60000);
    document.getElementById('effectiveDateInput').value = localDateTime.toISOString().slice(0, 16);
}

function getAccessToken() {
    // Get token from cookie or API
    return document.cookie.split('; ')
        .find(row => row.startsWith('accessToken='))
        ?.split('=')[1];
}

function showAlert(type, message) {
    const alertsContainer = document.getElementById('alertsContainer');
    const alertId = 'alert-' + Date.now();
    
    const alertHtml = `
        <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    
    alertsContainer.insertAdjacentHTML('beforeend', alertHtml);
    
    // Auto-dismiss after 5 seconds
    setTimeout(() => {
        const alertElement = document.getElementById(alertId);
        if (alertElement) {
            bootstrap.Alert.getOrCreateInstance(alertElement).close();
        }
    }, 5000);
}

function initializeInflationButton() {
    const inflationBtn = document.getElementById('applyInflationBtn');
    if (!inflationBtn) return;
    
    inflationBtn.addEventListener('click', async function() {
        // Get current inflation percentage from the display
        const percentageElement = document.querySelector('#currentValueDisplay .display-3.fw-bold.text-primary');
        const percentageText = percentageElement?.textContent || '0';
        const currentPercentage = parseFloat(percentageText.replace('%', ''));
        
        if (currentPercentage <= 0) {
            showAlert('warning', 'No se puede aplicar inflación. El porcentaje debe ser mayor a 0.');
            return;
        }
        
        // Show confirmation dialog
        if (!confirm(`¿Estás seguro de que deseas aplicar una inflación del ${currentPercentage}% al tarifario? Esta acción actualizará los precios de todos los servicios.`)) {
            return;
        }
        
        // Disable button and show loading state
        const originalText = this.innerHTML;
        this.disabled = true;
        this.innerHTML = '<i class="ti ti-loader ti-spin me-2"></i>Aplicando...';
        
        try {
            // Call the API endpoint to start inflation process
            const response = await $.ajax({
                url: '/api/inflation-rate/apply',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    percentage: currentPercentage
                })
            });
            
            if (response.success) {
                showAlert('success', `Proceso de inflación iniciado exitosamente. ID: ${response.batchId}\nEste proceso se ejecutará en segundo plano.`);
                
                // Optional: Start polling for status updates
                pollInflationStatus(response.batchId);
            } else {
                throw new Error(response.error || 'Error desconocido');
            }
            
        } catch (error) {
            console.error('Error applying inflation:', error);
            const errorMessage = error.responseJSON?.error || error.message || 'Error desconocido';
            showAlert('danger', 'Error al aplicar inflación: ' + errorMessage);
        } finally {
            // Re-enable button
            this.disabled = false;
            this.innerHTML = originalText;
        }
    });
}

function initializeRevertInflationButton() {
    const revertBtn = document.getElementById('revertInflationBtn');
    if (!revertBtn) return;
    
    revertBtn.addEventListener('click', async function() {
        const originalText = this.innerHTML;
        
        try {
            // First, get available inflation batches
            const batchesResponse = await $.ajax({
                url: '/api/inflation-rate/available-batches',
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`
                }
            });
            
            if (!batchesResponse.success || !batchesResponse.batches || batchesResponse.batches.length === 0) {
                showAlert('warning', 'No hay procesos de inflación disponibles para revertir.');
                return;
            }
            
            // Create selection options
            let options = '';
            batchesResponse.batches.forEach((batch, index) => {
                const date = new Date(batch.createdAt).toLocaleString('es-MX');
                const message = batch.descriptiveMessage || `${batch.processedCount} registros procesados`;
                options += `${index + 1}. ${date} - ${batch.percentage}% - ${message}\n`;
            });
            
            // Show selection prompt
            const selectedIndex = prompt(`Selecciona el proceso de inflación que deseas revertir:\n\n${options}\nIngresa el número (1-${batchesResponse.batches.length}) o cancela:`);
            
            if (!selectedIndex || selectedIndex.trim() === '') {
                return; // User cancelled
            }
            
            const batchIndex = parseInt(selectedIndex) - 1;
            if (batchIndex < 0 || batchIndex >= batchesResponse.batches.length) {
                showAlert('danger', 'Selección inválida. Por favor, selecciona un número válido.');
                return;
            }
            
            const selectedBatch = batchesResponse.batches[batchIndex];
            const date = new Date(selectedBatch.createdAt).toLocaleString('es-MX');
            
            // Show confirmation dialog
            if (!confirm(`¿Estás seguro de que deseas revertir esta inflación?\n\nFecha: ${date}\nPorcentaje: ${selectedBatch.percentage}%\nRegistros: ${selectedBatch.processedCount}\n\nEsta acción restaurará los precios anteriores y no se puede deshacer fácilmente.`)) {
                return;
            }
            
            // Disable button and show loading
            this.disabled = true;
            this.innerHTML = '<i class="ti ti-loader ti-spin me-2"></i>Revirtiendo...';
            
            // Call revert with specific batch ID
            const response = await $.ajax({
                url: '/api/inflation-rate/revert',
                method: 'POST',
                contentType: 'application/json',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`
                },
                data: JSON.stringify({
                    batchId: selectedBatch.batchId
                })
            });
            
            if (response.success) {
                const totalReverted = response.totalReverted || 0;
                showAlert('success', `Reversión de inflación completada exitosamente. ${totalReverted} registros procesados.`);
                
                // Refresh the page to show updated prices
                setTimeout(() => {
                    window.location.reload();
                }, 2000);
            } else {
                throw new Error(response.error || 'Error desconocido');
            }
            
        } catch (error) {
            console.error('Error reverting inflation:', error);
            const errorMessage = error.responseJSON?.error || error.message || 'Error desconocido';
            showAlert('danger', 'Error al revertir inflación: ' + errorMessage);
        } finally {
            // Re-enable button
            this.disabled = false;
            this.innerHTML = originalText;
        }
    });
}

// Function to poll inflation status for background job monitoring
function pollInflationStatus(batchId) {
    const pollInterval = setInterval(async () => {
        try {
            const response = await $.ajax({
                url: `/api/inflation-rate/status/${batchId}`,
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`
                }
            });
            
            if (response.success) {
                const status = response.status;
                const processed = response.processed_count || 0;
                
                // Update UI with progress if needed
                console.log(`Inflation status: ${status} - Processed: ${processed} records`);
                
                // Stop polling if completed or failed
                if (status === 'COMPLETED' || status === 'FAILED') {
                    clearInterval(pollInterval);
                    
                    if (status === 'COMPLETED') {
                        const message = response.descriptive_message || `${processed} registros procesados.`;
                        showAlert('success', `Proceso de inflación completado exitosamente. ${message}`);
                    } else if (status === 'FAILED') {
                        showAlert('danger', `Error en el proceso de inflación: ${response.error_message || 'Error desconocido'}`);
                    }
                    
                    // Optionally refresh the page to show updated prices
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                }
            }
        } catch (error) {
            console.error('Error polling inflation status:', error);
            clearInterval(pollInterval);
        }
    }, 5000); // Poll every 5 seconds
    
    // Stop polling after 5 minutes to prevent infinite polling
    setTimeout(() => {
        clearInterval(pollInterval);
        console.log('Inflation status polling stopped after 5 minutes');
    }, 300000);
}

