async function saveFormulaConfiguration(e) {
    e.preventDefault();
    
    const submitBtn = document.getElementById('saveFormulaBtn');
    const originalText = submitBtn.innerHTML;
    
    try {
        // Disable button and show loading
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="ti ti-loader ti-spin me-2"></i>Guardando...';
        
        const formData = {
            roundTripMultiplier: parseFloat(document.getElementById('roundTripMultiplier').value),
            minimumCharge: 0 // Always 0 since we removed the field
        };
        
        const response = await fetch('/api/guide-transport-rate/formula', {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${getAccessToken()}`
            },
            body: JSON.stringify(formData)
        });
        
        const data = await response.json();
        
        if (data.success) {
            // Update config with response data (which includes the converted components)
            formulaConfig = data.config || formData;
            
            // Update the components based on the multiplier
            const multiplier = parseFloat(document.getElementById('roundTripMultiplier').value) || 2;
            currentFormulaComponents = [
                { type: 'duration_hours', label: 'Duración (hrs)', id: 'comp_1' },
                { type: 'operator', value: '*', label: '×', id: 'op_1' },
                { type: 'fixed', value: multiplier, label: String(multiplier), editable: true, id: 'comp_2' },
                { type: 'operator', value: '*', label: '×', id: 'op_2' },
                { type: 'rate', label: 'Tarifa Guía', id: 'comp_3' }
            ];
            
            // Update displays
            displayFormulaComponents();
            updateFormulaDisplayText();
            updateFormulaPreview();
            updateSimulation();
            showAlert('success', 'Configuración de fórmula guardada exitosamente');
            
            // Also clear the cache in the generic evaluator if available
            if (typeof GuideFormulaEvaluator !== 'undefined') {
                GuideFormulaEvaluator.clearCache();
                GuideFormulaEvaluator.loadFormula(); // Reload the new formula
            }
        } else {
            showAlert('danger', data.error || 'Error al guardar la configuración');
        }
        
    } catch (error) {
        console.error('Error saving formula configuration:', error);
        showAlert('danger', 'Error al guardar la configuración de fórmula');
    } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
    }
}

function updateFormulaPreview() {
    const multiplier = parseFloat(document.getElementById('roundTripMultiplier').value) || 2;
    
    // Update formula display
    const formulaMultiplierSpan = document.getElementById('formulaMultiplier');
    const formulaMultiplierText = document.getElementById('formulaMultiplierText');
    
    if (formulaMultiplierSpan) formulaMultiplierSpan.textContent = multiplier;
    if (formulaMultiplierText) formulaMultiplierText.textContent = multiplier;
    
    // Update simulation
    updateSimulation();
}

async function loadCurrentRateForSimulation() {
    try {
        const response = await fetch('/api/guide-transport-rate/current', {
            headers: {
                'Authorization': `Bearer ${getAccessToken()}`
            }
        });
        
        if (response.ok) {
            const data = await response.json();
            if (data.success && data.data) {
                const rateInput = document.getElementById('simulationRate');
                if (rateInput) {
                    rateInput.value = data.data.value;
                    updateSimulation();
                }
            }
        }
    } catch (error) {
        console.error('Error loading current rate:', error);
        // Set default rate for simulation
        const rateInput = document.getElementById('simulationRate');
        if (rateInput) rateInput.value = 400;
    }
}

function updateSimulation() {
    const duration = parseFloat(document.getElementById('simulationDuration').value) || 0;
    const rate = parseFloat(document.getElementById('simulationRate').value) || 400;
    const baseCost = parseFloat(document.getElementById('simulationBaseCost').value) || 0;
    
    let guideCost;
    let breakdown;
    
    // Check if we're using advanced formula
    if (currentFormulaComponents && currentFormulaComponents.length > 0) {
        // Use component-based formula
        const result = evaluateFormulaForSimulation(currentFormulaComponents, duration, rate);
        guideCost = result.value;
        breakdown = `Fórmula: ${result.formula} = $${guideCost.toFixed(2)}`;
    } else {
        // Use simple formula
        const multiplier = formulaConfig.roundTripMultiplier || 2;
        const durationHours = duration / 60;
        guideCost = durationHours * multiplier * rate;
        breakdown = `Fórmula: (${duration} ÷ 60) × ${multiplier} × $${rate.toFixed(2)} = $${guideCost.toFixed(2)}`;
    }
    
    // Calculate total cost
    const totalCost = guideCost + baseCost;
    
    // Update result display
    const guideResultElement = document.getElementById('simulationGuideResult');
    const totalResultElement = document.getElementById('simulationResult');
    const breakdownElement = document.getElementById('simulationBreakdown');
    
    if (guideResultElement) {
        guideResultElement.textContent = `$${guideCost.toFixed(2)} MXN`;
    }
    
    if (totalResultElement) {
        totalResultElement.textContent = `$${totalCost.toFixed(2)} MXN`;
    }
    
    if (breakdownElement) {
        let fullBreakdown = breakdown;
        if (baseCost > 0) {
            fullBreakdown += ` + Base: $${baseCost.toFixed(2)} = Total: $${totalCost.toFixed(2)}`;
        }
        breakdownElement.textContent = fullBreakdown;
    }
}

function evaluateFormulaForSimulation(components, durationMinutes, rate) {
    let formulaString = '';
    let expression = '';
    
    const values = {
        duration_minutes: durationMinutes,
        duration_hours: durationMinutes / 60,
        rate: rate
    };

    for (const comp of components) {
        if (comp.type === 'operator') {
            expression += ` ${comp.value} `;
            formulaString += ` ${comp.label || comp.value} `;
        } else if (comp.type === 'parenthesis') {
            expression += comp.value;
            formulaString += comp.value;
        } else if (comp.type === 'fixed') {
            expression += comp.value;
            formulaString += comp.value;
        } else if (values[comp.type] !== undefined) {
            expression += values[comp.type];
            formulaString += `${values[comp.type].toFixed(2)}`;
        }
    }

    // Safely evaluate the expression
    let result;
    try {
        // Use Function constructor for safe evaluation
        result = new Function('return ' + expression)();
    } catch (error) {
        console.error('Error evaluating formula expression:', error);
        result = 0;
    }

    return {
        value: result,
        formula: formulaString.trim(),
        expression: expression.trim()
    };
}

function setSimulationDuration(minutes) {
    const durationInput = document.getElementById('simulationDuration');
    if (durationInput) {
        durationInput.value = minutes;
        // Trigger input event to update simulation
        durationInput.dispatchEvent(new Event('input'));
        updateSimulation();
    }
}

// Formula Builder Functions for Advanced Mode
let currentFormulaComponents = [];

function initializeFormulaBuilder() {
    // Mode toggle handlers
    const simpleModeBtn = document.getElementById('simpleModeBtn');
    const advancedModeBtn = document.getElementById('advancedModeBtn');
    
    if (simpleModeBtn && advancedModeBtn) {
        simpleModeBtn.addEventListener('change', () => toggleFormulaMode('simple'));
        advancedModeBtn.addEventListener('change', () => toggleFormulaMode('advanced'));
        
        // Check if Advanced Mode is already selected on page load
        if (advancedModeBtn.checked) {
            // Ensure formula components are displayed
            setTimeout(() => {
                if (!currentFormulaComponents || currentFormulaComponents.length === 0) {
                    // Load default formula based on current multiplier
                    const multiplier = formulaConfig.roundTripMultiplier || 2;
                    currentFormulaComponents = [
                        { type: 'duration_hours', label: 'Duración (hrs)', id: 'comp_1' },
                        { type: 'operator', value: '*', label: '×', id: 'op_1' },
                        { type: 'fixed', value: multiplier, label: String(multiplier), editable: true, id: 'comp_2' },
                        { type: 'operator', value: '*', label: '×', id: 'op_2' },
                        { type: 'rate', label: 'Tarifa Guía', id: 'comp_3' }
                    ];
                }
                displayFormulaComponents();
                updateFormulaDisplayText();
            }, 100); // Small delay to ensure DOM is ready
        }
    }
    
    // Component buttons
    const componentBtns = document.querySelectorAll('.component-btn');
    componentBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const type = e.currentTarget.dataset.type;
            addComponentToFormula(type);
        });
    });
    
    // Clear and reset buttons
    const clearBtn = document.getElementById('clearFormulaBtn');
    const resetBtn = document.getElementById('resetToDefaultBtn');
    const saveAdvancedBtn = document.getElementById('saveAdvancedFormulaBtn');
    
    if (clearBtn) clearBtn.addEventListener('click', clearFormula);
    if (resetBtn) resetBtn.addEventListener('click', resetToDefaultFormula);
    if (saveAdvancedBtn) saveAdvancedBtn.addEventListener('click', saveAdvancedFormula);
}

function toggleFormulaMode(mode) {
    const simpleForm = document.getElementById('formulaConfigForm');
    const advancedBuilder = document.getElementById('advancedFormulaBuilder');
    
    if (mode === 'simple') {
        if (simpleForm) simpleForm.style.display = 'block';
        if (advancedBuilder) advancedBuilder.style.display = 'none';
    } else {
        if (simpleForm) simpleForm.style.display = 'none';
        if (advancedBuilder) {
            advancedBuilder.style.display = 'block';
            // Ensure formula components are displayed when switching to advanced mode
            if (currentFormulaComponents && currentFormulaComponents.length > 0) {
                displayFormulaComponents();
                updateFormulaDisplayText();
            } else {
                // If no components, load the default based on current multiplier
                const multiplier = formulaConfig.roundTripMultiplier || 2;
                currentFormulaComponents = [
                    { type: 'duration_hours', label: 'Duración (hrs)', id: 'comp_1' },
                    { type: 'operator', value: '*', label: '×', id: 'op_1' },
                    { type: 'fixed', value: multiplier, label: String(multiplier), editable: true, id: 'comp_2' },
                    { type: 'operator', value: '*', label: '×', id: 'op_2' },
                    { type: 'rate', label: 'Tarifa Guía', id: 'comp_3' }
                ];
                displayFormulaComponents();
                updateFormulaDisplayText();
            }
        }
    }
}

function addComponentToFormula(type) {
    const placeholder = document.getElementById('formulaPlaceholder');
    if (placeholder) placeholder.style.display = 'none';
    
    let component = {};
    const componentId = `comp_${Date.now()}`;
    
    // Handle different component types
    switch(type) {
        case 'duration_minutes':
            component = { type: 'duration_minutes', label: 'Duración (min)', id: componentId };
            break;
        case 'duration_hours':
            component = { type: 'duration_hours', label: 'Duración (hrs)', id: componentId };
            break;
        case 'rate':
            component = { type: 'rate', label: 'Tarifa Guía', id: componentId };
            break;
        case 'fixed':
            const value = prompt('Ingrese el valor fijo:', '2');
            if (value === null) return;
            component = { 
                type: 'fixed', 
                value: parseFloat(value) || 1, 
                label: value,
                editable: true,
                id: componentId 
            };
            break;
        case 'parenthesis_open':
            component = { type: 'parenthesis', value: '(', label: '(', id: componentId };
            break;
        case 'parenthesis_close':
            component = { type: 'parenthesis', value: ')', label: ')', id: componentId };
            break;
    }
    
    // Add operator if needed (between values)
    if (currentFormulaComponents.length > 0 && 
        type !== 'parenthesis_open' && type !== 'parenthesis_close' &&
        currentFormulaComponents[currentFormulaComponents.length - 1].type !== 'operator' &&
        currentFormulaComponents[currentFormulaComponents.length - 1].type !== 'parenthesis') {
        
        // Check if last component is not an opening parenthesis
        const lastComp = currentFormulaComponents[currentFormulaComponents.length - 1];
        if (!(lastComp.type === 'parenthesis' && lastComp.value === '(')) {
            // Add default operator
            currentFormulaComponents.push({
                type: 'operator',
                value: '*',
                label: '×',
                id: `op_${Date.now()}`
            });
        }
    }
    
    currentFormulaComponents.push(component);
    displayFormulaComponents();
    updateFormulaDisplayText();
}

function displayFormulaComponents() {
    const container = document.getElementById('formulaComponents');
    if (!container) return;
    
    container.innerHTML = '';
    
    if (currentFormulaComponents.length === 0) {
        const placeholder = document.createElement('div');
        placeholder.className = 'text-muted';
        placeholder.id = 'formulaPlaceholder';
        placeholder.innerHTML = '<i class="ti ti-drag-drop me-1"></i>Arrastra componentes aquí o haz clic en ellos para agregar';
        container.appendChild(placeholder);
        return;
    }
    
    currentFormulaComponents.forEach((comp, index) => {
        const element = document.createElement('div');
        element.className = 'd-inline-flex align-items-center';
        
        if (comp.type === 'operator') {
            // Create operator dropdown
            const select = document.createElement('select');
            select.className = 'form-select form-select-sm mx-1';
            select.style.width = '60px';
            select.innerHTML = `
                <option value="+" ${comp.value === '+' ? 'selected' : ''}>+</option>
                <option value="-" ${comp.value === '-' ? 'selected' : ''}>−</option>
                <option value="*" ${comp.value === '*' ? 'selected' : ''}>×</option>
                <option value="/" ${comp.value === '/' ? 'selected' : ''}>÷</option>
            `;
            select.addEventListener('change', (e) => {
                currentFormulaComponents[index].value = e.target.value;
                currentFormulaComponents[index].label = e.target.options[e.target.selectedIndex].text;
                updateFormulaDisplayText();
            });
            element.appendChild(select);
        } else if (comp.type === 'fixed' && comp.editable) {
            // Create editable fixed value
            const badge = document.createElement('span');
            badge.className = 'badge bg-primary position-relative me-3';
            badge.style.cursor = 'pointer';
            badge.style.paddingRight = '25px';
            badge.innerHTML = `
                ${comp.label}
                <button type="button" class="btn-close btn-close-white position-absolute" 
                        style="width: 16px; height: 16px; top: 50%; transform: translateY(-50%); right: 5px;" 
                        data-index="${index}"></button>
            `;
            badge.addEventListener('click', (e) => {
                if (!e.target.classList.contains('btn-close')) {
                    const newValue = prompt('Ingrese el nuevo valor:', comp.value);
                    if (newValue !== null) {
                        currentFormulaComponents[index].value = parseFloat(newValue) || 1;
                        currentFormulaComponents[index].label = newValue;
                        displayFormulaComponents();
                        updateFormulaDisplayText();
                    }
                }
            });
            element.appendChild(badge);
        } else {
            // Create non-editable component
            const badge = document.createElement('span');
            badge.className = 'badge bg-secondary position-relative me-3';
            badge.style.paddingRight = '25px';
            badge.innerHTML = `
                ${comp.label}
                <button type="button" class="btn-close btn-close-white position-absolute" 
                        style="width: 16px; height: 16px; top: 50%; transform: translateY(-50%); right: 5px;" 
                        data-index="${index}"></button>
            `;
            element.appendChild(badge);
        }
        
        // Add remove button handler
        const closeBtn = element.querySelector('.btn-close');
        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                currentFormulaComponents.splice(index, 1);
                displayFormulaComponents();
                updateFormulaDisplayText();
            });
        }
        
        container.appendChild(element);
    });
}

function updateFormulaDisplayText() {
    const display = document.getElementById('formulaDisplayText');
    if (!display) return;
    
    if (currentFormulaComponents.length === 0) {
        display.textContent = 'Costo = duración_horas × 2 × tarifa_guía';
        return;
    }
    
    let formula = 'Costo = ';
    currentFormulaComponents.forEach(comp => {
        if (comp.type === 'operator') {
            formula += ` ${comp.label} `;
        } else if (comp.type === 'duration_minutes') {
            formula += 'duración_minutos';
        } else if (comp.type === 'duration_hours') {
            formula += 'duración_horas';
        } else if (comp.type === 'rate') {
            formula += 'tarifa_guía';
        } else if (comp.type === 'fixed') {
            formula += comp.value;
        } else if (comp.type === 'parenthesis') {
            formula += comp.value;
        }
    });
    
    display.textContent = formula;
    
    // Also update simulation if on advanced mode
    if (document.getElementById('advancedModeBtn')?.checked) {
        updateSimulation();
    }
}

function clearFormula() {
    currentFormulaComponents = [];
    displayFormulaComponents();
    updateFormulaDisplayText();
}

function resetToDefaultFormula() {
    currentFormulaComponents = [
        { type: 'duration_hours', label: 'Duración (hrs)', id: 'comp_1' },
        { type: 'operator', value: '*', label: '×', id: 'op_1' },
        { type: 'fixed', value: 2, label: '2', editable: true, id: 'comp_2' },
        { type: 'operator', value: '*', label: '×', id: 'op_2' },
        { type: 'rate', label: 'Tarifa Guía', id: 'comp_3' }
    ];
    displayFormulaComponents();
    updateFormulaDisplayText();
}

async function saveAdvancedFormula() {
    const saveBtn = document.getElementById('saveAdvancedFormulaBtn');
    const originalText = saveBtn.innerHTML;
    
    try {
        // Validate formula has components
        if (currentFormulaComponents.length === 0) {
            showAlert('warning', 'La fórmula no puede estar vacía');
            return;
        }
        
        // Disable button and show loading
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="ti ti-loader ti-spin me-2"></i>Guardando...';
        
        // No minimum charge since we removed the field
        const response = await fetch('/api/guide-transport-rate/formula', {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${getAccessToken()}`
            },
            body: JSON.stringify({
                formulaComponents: currentFormulaComponents,
                minimumCharge: 0 // Always 0 since we removed the field
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            console.log('Formula saved successfully, response:', data);
            formulaConfig = data.config;
            // Update the current components if returned
            if (data.config && data.config.formulaComponents) {
                console.log('Updating currentFormulaComponents with saved data:', data.config.formulaComponents);
                currentFormulaComponents = data.config.formulaComponents;
            }
            displayFormulaComponents();
            updateFormulaDisplayText();
            updateSimulation();
            showAlert('success', 'Fórmula avanzada guardada exitosamente');
            
            // Also clear the cache in the generic evaluator if available
            if (typeof GuideFormulaEvaluator !== 'undefined') {
                GuideFormulaEvaluator.clearCache();
                GuideFormulaEvaluator.loadFormula(); // Reload the new formula
            }
        } else {
            showAlert('danger', data.error || 'Error al guardar la fórmula');
        }
        
    } catch (error) {
        console.error('Error saving advanced formula:', error);
        showAlert('danger', 'Error al guardar la fórmula avanzada');
    } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
    }
}
</script>