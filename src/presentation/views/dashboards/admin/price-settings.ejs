            headers: {
                'Authorization': `Bearer ${getAccessToken()}`
            }
        });
        
        if (response.ok) {
            const data = await response.json();
            console.log('Loaded formula configuration from API:', data);
            
            if (data.success) {
                formulaConfig = data.config;
                
                // Check if we have formula components
                if (formulaConfig.formulaComponents && formulaConfig.formulaComponents.length > 0) {
                    console.log('Using saved formula components:', formulaConfig.formulaComponents);
                    currentFormulaComponents = formulaConfig.formulaComponents;
                } else {
                    // No components exist, create them from the current multiplier
                    console.log('No saved components found, generating defaults');
                    const multiplier = formulaConfig.roundTripMultiplier || 2;
                    currentFormulaComponents = [
                        { type: 'duration_hours', label: 'Duración (hrs)', id: 'comp_1' },
                        { type: 'operator', value: '*', label: '×', id: 'op_1' },
                        { type: 'fixed', value: multiplier, label: String(multiplier), editable: true, id: 'comp_2' },
                        { type: 'operator', value: '*', label: '×', id: 'op_2' },
                        { type: 'rate', label: 'Tarifa Guía', id: 'comp_3' }
                    ];
                }
                
                // Always display the components for advanced mode
                displayFormulaComponents();
                updateFormulaDisplayText();
                
                // Update UI
                const multiplierInput = document.getElementById('roundTripMultiplier');
                
                if (multiplierInput) multiplierInput.value = formulaConfig.roundTripMultiplier || 2;
                
                updateFormulaPreview();
            }
        }
    } catch (error) {
        console.log('Using default formula configuration:', error);
        // Use defaults if API not available yet
        formulaConfig = { roundTripMultiplier: 2, minimumCharge: 0, formulaComponents: [] };
        
        // Create default formula components
        currentFormulaComponents = [
            { type: 'duration_hours', label: 'Duración (hrs)', id: 'comp_1' },
