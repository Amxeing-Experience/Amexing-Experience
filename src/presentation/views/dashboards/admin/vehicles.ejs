<%
/**
 * Admin Vehicles Management Page
 * Manages Amexing vehicle fleet and vehicle types
 *
 * Layout Structure:
 * - Vertical navigation menu (collapsible)
 * - Two sections: Vehículos (vehicles list) and Tipos (vehicle types management)
 * - Section-based content rendering
 *
 * Note: DataTables CSS/JS libraries are loaded via controller
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const activeSection = typeof section !== 'undefined' ? section : 'vehicles';

// Menu items configuration
const menuItems = [
    { label: 'Vehículos', icon: 'car', section: 'vehicles', href: '/dashboard/admin/vehicles' },
    { label: 'Tipos de Vehículo', icon: 'list', section: 'types', href: '/dashboard/admin/vehicles?section=types' }
];
%>

<div class="vehicles-wrap">

<!-- Encabezado editorial -->
<div class="vh-head">
    <div>
        <div class="eyebrow">Gestión</div>
        <h1>Vehículos</h1>
        <div class="crumb"><a href="/dashboard/admin"><i class="ti ti-home me-1"></i>Dashboard</a> · Vehículos</div>
    </div>
</div>

<!-- Main Content -->
<div class="row mt-4">
    <!-- Section tabs (horizontal) -->
    <div class="col-12">
        <nav class="vehicles-nav-tabs mb-3">
            <% menuItems.forEach(function(item) { %>
                <a href="<%= item.href %>" class="vehicles-nav-tab <%= item.section === activeSection ? 'active' : '' %>">
                    <i class="ti ti-<%= item.icon %> me-2"></i><%= item.label %>
                </a>
            <% }); %>
        </nav>
    </div>

    <!-- Content Column -->
    <div class="col-12" id="contentColumn">
        <% if (activeSection === 'vehicles') { %>
            <!-- Vehicles Management Section -->
            <%- include('../../organisms/datatable/vehicles-table', {
                tableId: 'vehicles-table',
                apiEndpoint: '/api/vehicles',
                userRole: currentUserRole,
                showActions: true,
                editorial: true
            }) %>

        <% } else if (activeSection === 'types') { %>
            <!-- Vehicle Types Management Section -->

            <%- include('../../organisms/datatable/vehicle-types-table', {
                tableId: 'vehicle-types-table',
                apiEndpoint: '/api/vehicle-types',
                userRole: currentUserRole,
                showActions: true,
                editorial: true
            }) %>

        <% } %>
    </div>
</div>
</div>

<!-- Estilos editoriales -->
<style>
.vehicles-wrap{--olive:#6E7A50;--olive-d:#566040;--line:#ded9cb;--ink:#2b2b2b;--muted:#8a8f78;}
/* Encabezado editorial */
.vehicles-wrap .eyebrow{text-transform:uppercase;letter-spacing:.34em;font-size:.7rem;color:var(--olive);font-weight:600;}
.vehicles-wrap .vh-head{margin-bottom:22px;}
.vehicles-wrap .vh-head h1{margin:.15rem 0 0;font-weight:400;letter-spacing:.06em;font-size:1.9rem;color:var(--ink);}
.vehicles-wrap .vh-head .crumb{margin-top:.35rem;font-size:.78rem;color:var(--muted);}
.vehicles-wrap .vh-head .crumb a{color:var(--muted);text-decoration:none;}
.vehicles-wrap .vh-head .crumb a:hover{color:var(--olive-d);}

/* Tabs de sección — editorial (subrayado olivo, sin gradiente) */
.vehicles-wrap .vehicles-nav-tabs{display:flex;flex-wrap:wrap;gap:.4rem;border-bottom:1px solid var(--line);overflow-x:auto;}
.vehicles-wrap .vehicles-nav-tab{display:inline-flex;align-items:center;padding:.55rem 1rem;color:var(--muted);text-decoration:none;
    font-weight:600;font-size:.85rem;white-space:nowrap;border-bottom:2px solid transparent;border-radius:0;transition:all .2s ease;}
.vehicles-wrap .vehicles-nav-tab:hover{color:var(--olive-d);background:transparent;}
.vehicles-wrap .vehicles-nav-tab.active{color:var(--olive-d);background:transparent;border-bottom-color:var(--olive);}

/* Tabla en modo editorial (sin panel blanco ni header con gradiente) */
.vehicles-wrap .vt-editorial{background:transparent;}
.vehicles-wrap .vt-toolbar{margin:.2rem 0 1.1rem;}
.vehicles-wrap .vt-btn-new{background:var(--olive);color:#fff;border:1px solid var(--olive);border-radius:10px;
    font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:.76rem;padding:.5rem 1rem;}
.vehicles-wrap .vt-btn-new:hover{background:var(--olive-d);color:#fff;}
.vehicles-wrap .vt-filter{margin:0 0 1rem;padding:0;}
.vehicles-wrap .vt-table{padding:0;}
</style>

<!-- Load Dropzone.js from CDN -->
<script src="https://unpkg.com/dropzone@6.0.0-beta.2/dist/dropzone-min.js"></script>
<link href="https://unpkg.com/dropzone@6.0.0-beta.2/dist/dropzone.css" rel="stylesheet" type="text/css" />

<!-- Vehicle Images Modal JavaScript -->
<script src="/js/vehicle-images-modal.js"></script>
