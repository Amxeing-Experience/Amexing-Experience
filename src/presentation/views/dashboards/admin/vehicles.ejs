<%
/**
 * Admin Vehicles Management Page
 * Manages Amexing vehicle fleet and vehicle types
 *
 * Layout Structure:
 * - Vertical navigation menu (collapsible)
 * - Two sections: Vehículos (vehicles list) and Tipos (vehicle types management)
 * - Section-based content rendering
 *
 * Note: DataTables CSS/JS libraries are loaded via controller
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const activeSection = typeof section !== 'undefined' ? section : 'vehicles';

// Menu items configuration
const menuItems = [
    { label: 'Vehículos', icon: 'car', section: 'vehicles', href: '/dashboard/admin/vehicles' },
    { label: 'Tipos de Vehículo', icon: 'list', section: 'types', href: '/dashboard/admin/vehicles?section=types' }
];
%>

<!-- Page Header with Breadcrumb -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-1 fw-bold">Gestión de Vehículos</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/dashboard/admin"><i class="ti ti-home me-1"></i>Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active">
                            <i class="ti ti-car me-1"></i>Vehículos
                        </li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/dashboard/admin" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i>Volver
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row mt-4">
    <!-- Section tabs (horizontal) -->
    <div class="col-12">
        <nav class="vehicles-nav-tabs mb-3">
            <% menuItems.forEach(function(item) { %>
                <a href="<%= item.href %>" class="vehicles-nav-tab <%= item.section === activeSection ? 'active' : '' %>">
                    <i class="ti ti-<%= item.icon %> me-2"></i><%= item.label %>
                </a>
            <% }); %>
        </nav>
    </div>

    <!-- Content Column -->
    <div class="col-12" id="contentColumn">
        <% if (activeSection === 'vehicles') { %>
            <!-- Vehicles Management Section -->
            <%- include('../../organisms/datatable/vehicles-table', {
                tableId: 'vehicles-table',
                apiEndpoint: '/api/vehicles',
                userRole: currentUserRole,
                showActions: true
            }) %>

        <% } else if (activeSection === 'types') { %>
            <!-- Vehicle Types Management Section -->

            <%- include('../../organisms/datatable/vehicle-types-table', {
                tableId: 'vehicle-types-table',
                apiEndpoint: '/api/vehicle-types',
                userRole: currentUserRole,
                showActions: true
            }) %>

        <% } %>
    </div>
</div>

<!-- Vertical Menu Styles -->
<style>
/* Vertical Menu Styles */
/* Section tabs (horizontal, salvia) */
.vehicles-nav-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 1px solid #e9ecef;
    overflow-x: auto;
}

.vehicles-nav-tab {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.1rem;
    color: var(--brand-primary-active);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    border-radius: 0.5rem 0.5rem 0 0;
    transition: all 0.2s ease;
}

.vehicles-nav-tab:hover {
    background: rgba(var(--brand-primary-rgb), 0.08);
    color: var(--brand-primary-active);
}

.vehicles-nav-tab.active {
    color: #fff;
    background: var(--brand-gradient);
    border-bottom-color: var(--brand-primary);
}

/* Breadcrumb styles */
.breadcrumb-item a {
    color: #5a6a85;
    text-decoration: none;
}

.breadcrumb-item a:hover {
    color: var(--brand-primary-active);
}
</style>

<!-- Load Dropzone.js from CDN -->
<script src="https://unpkg.com/dropzone@6.0.0-beta.2/dist/dropzone-min.js"></script>
<link href="https://unpkg.com/dropzone@6.0.0-beta.2/dist/dropzone.css" rel="stylesheet" type="text/css" />

<!-- Vehicle Images Modal JavaScript -->
<script src="/js/vehicle-images-modal.js"></script>
