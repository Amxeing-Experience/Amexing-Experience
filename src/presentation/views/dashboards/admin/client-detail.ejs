// Setup experience filter event handlers
function setupExperienceFilters() {
    // Prevent multiple initialization
    if (window.experienceFiltersSetup) {
        return;
    }
    window.experienceFiltersSetup = true;
    
    // Store original prices for calculations
    let originalPrices = new Map();
    
    // Store current rates (these would normally be loaded from APIs)
    let currentTransferRate = 0;
    let currentAgencyRate = 0; 
    let currentExchangeRate = 0;
    
    // Function to apply transfer rate to price
    function applyTransferRate(priceString) {
        if (currentTransferRate <= 0) return priceString;
        
        const numericValue = parseFloat(priceString.replace(/[^0-9.]/g, ''));
        if (isNaN(numericValue)) return priceString;
        
        const newValue = numericValue * (1 + currentTransferRate / 100);
        
        return new Intl.NumberFormat('es-MX', {
            style: 'currency',
            currency: 'MXN'
        }).format(newValue);
    }
    
    // Function to apply agency rate to price
    function applyAgencyRate(priceString) {
        if (currentAgencyRate <= 0) return priceString;
        
        const numericValue = parseFloat(priceString.replace(/[^0-9.]/g, ''));
        if (isNaN(numericValue)) return priceString;
        
        const newValue = numericValue * (1 + currentAgencyRate / 100);
        
        return new Intl.NumberFormat('es-MX', {
            style: 'currency',
            currency: 'MXN'
        }).format(newValue);
    }
    
    // USD rounding rules now handled by centralized PricingUtils.applyUSDRoundingRules()

    // Function to convert currency
    function convertCurrency(priceString, currency) {
        const numericValue = parseFloat(priceString.replace(/[^0-9.]/g, ''));
        if (isNaN(numericValue)) return priceString;
        
        if (currency === 'USD' && currentExchangeRate > 0) {
            // Convert MXN to USD by dividing by exchange rate
            const convertedValue = numericValue / currentExchangeRate;
            
            // Apply custom USD rounding rules
            const roundedValue = PricingUtils.applyUSDRoundingRules(convertedValue);
            
            return new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(roundedValue);
        } else {
            return new Intl.NumberFormat('es-MX', {
                style: 'currency',
                currency: 'MXN'
            }).format(numericValue);
        }
    }
    
    // Function to update all displayed prices
    function updateExperiencePrices(paymentType, currency) {
        if (!experiencesTable) return;
        
        // Get all price cells in the table
        const table = document.getElementById('experiencesTable');
        if (!table) return;
        
        // Update price cells (4th column - index 3)
        const priceCells = table.querySelectorAll('tbody tr td:nth-child(4) .fw-bold');
        
        priceCells.forEach(cell => {
            let originalPrice = cell.dataset.originalPrice;
            
            // Store original price on first run
            if (!originalPrice) {
                originalPrice = cell.textContent;
                cell.dataset.originalPrice = originalPrice;
            }
            
            let finalPrice = originalPrice;
            
            // Apply appropriate rate based on payment type
            if (paymentType === 'transferencia' || paymentType === 'transf_agencias') {
                // Both Transferencia and Trans. Agencias use transfer rate
                finalPrice = applyTransferRate(finalPrice);
            } else if (paymentType === 'tarjeta') {
                // Tarjeta Débito/Crédito uses agency rate
                finalPrice = applyAgencyRate(finalPrice);
            }
            
            // Apply currency conversion
            finalPrice = convertCurrency(finalPrice, currency);
            
            cell.textContent = finalPrice;
        });
    }
    
    // Get access token for API calls
    function getAccessToken() {
        return document.cookie.split('; ')
            .find(row => row.startsWith('accessToken='))
            ?.split('=')[1] || null;
    }

    // Load current transfer rate from API
    function loadCurrentTransferRate() {
        return $.ajax({
            url: '/api/transfer-rate/current',
            type: 'GET',
            beforeSend: function(xhr) {
                const token = getAccessToken();
                if (token) {
                    xhr.setRequestHeader('Authorization', `Bearer ${token}`);
                }
            },
            success: function(response) {
                if (response.success && response.data) {
                    currentTransferRate = response.data.value || 0;
                    console.log('✅ Current transfer rate loaded:', currentTransferRate + '%');
                } else {
                    console.warn('⚠️ No active transfer rate found');
                    currentTransferRate = 0;
                }
            },
            error: function(xhr, status, error) {
                console.error('❌ Error loading transfer rate:', error);
                currentTransferRate = 0;
            }
        });
    }

    // Load current agency rate from API
    function loadCurrentAgencyRate() {
        return $.ajax({
            url: '/api/agency-rate/current',
            type: 'GET',
            beforeSend: function(xhr) {
                const token = getAccessToken();
                if (token) {
                    xhr.setRequestHeader('Authorization', `Bearer ${token}`);
                }
            },
            success: function(response) {
                if (response.success && response.data) {
                    currentAgencyRate = response.data.value || 0;
                    console.log('✅ Current agency rate loaded:', currentAgencyRate + '%');
                } else {
                    console.warn('⚠️ No active agency rate found');
                    currentAgencyRate = 0;
                }
            },
            error: function(xhr, status, error) {
                console.error('❌ Error loading agency rate:', error);
                currentAgencyRate = 0;
            }
        });
    }

    // Load current exchange rate from API
    function loadCurrentExchangeRate() {
        return $.ajax({
            url: '/api/exchange-rate/current',
            type: 'GET',
            beforeSend: function(xhr) {
                const token = getAccessToken();
                if (token) {
                    xhr.setRequestHeader('Authorization', `Bearer ${token}`);
                }
            },
            success: function(response) {
                if (response.success && response.data) {
                    currentExchangeRate = response.data.value || 0;
                    console.log('✅ Current exchange rate loaded:', currentExchangeRate, 'MXN per USD');
                } else {
                    console.warn('⚠️ No active exchange rate found');
                    currentExchangeRate = 0;
                }
            },
            error: function(xhr, status, error) {
                console.error('❌ Error loading exchange rate:', error);
                currentExchangeRate = 0;
            }
        });
    }

    // Load all rates from database
    function loadRates() {
        // Load transfer rate
        loadCurrentTransferRate();
        
        // Load agency rate
        loadCurrentAgencyRate();
        
        // Load exchange rate
        loadCurrentExchangeRate();
    }
    
    // Debounce function to prevent excessive requests
    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func.apply(this, args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    // Debounced update function
    const debouncedUpdatePrices = debounce((paymentType, currency) => {
        updateExperiencePrices(paymentType, currency);
    }, 300);

    // Currency filter change handler
    document.getElementById('experiencesCurrencyFilter').addEventListener('change', function() {
        const selectedCurrency = this.value;
        const selectedPaymentType = document.getElementById('experiencesPaymentTypeFilter').value;
        
        if (selectedCurrency === 'USD' && currentExchangeRate <= 0) {
            loadCurrentExchangeRate().then(() => {
                debouncedUpdatePrices(selectedPaymentType, selectedCurrency);
            });
        } else {
            debouncedUpdatePrices(selectedPaymentType, selectedCurrency);
        }
    });

    // Payment type filter change handler
    document.getElementById('experiencesPaymentTypeFilter').addEventListener('change', function() {
        const selectedPaymentType = this.value;
        const selectedCurrency = document.getElementById('experiencesCurrencyFilter').value;
        
        if (selectedPaymentType === 'transferencia') {
            // Transferencia uses Transfer Rate
            if (currentTransferRate <= 0) {
                loadCurrentTransferRate().then(() => {
                    debouncedUpdatePrices(selectedPaymentType, selectedCurrency);
                });
            } else {
                debouncedUpdatePrices(selectedPaymentType, selectedCurrency);
            }
        } else if (selectedPaymentType === 'tarjeta') {
            // Tarjeta uses Agency Rate
            if (currentAgencyRate <= 0) {
                loadCurrentAgencyRate().then(() => {
                    debouncedUpdatePrices(selectedPaymentType, selectedCurrency);
                });
            } else {
                debouncedUpdatePrices(selectedPaymentType, selectedCurrency);
            }
        } else {
            debouncedUpdatePrices(selectedPaymentType, selectedCurrency);
        }
    });
    
    // Load initial rates
    loadRates();
}
</script>

