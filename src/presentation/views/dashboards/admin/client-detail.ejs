    /**
     * Execute update employee API call
     */
    async function executeUpdateEmployee(employeeId, formData) {
        const submitBtn = document.getElementById('submitEditEmployee');
        const originalContent = submitBtn.innerHTML;

        try {
            // Show loading state
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Actualizando...';

            const clientId = '<%= clientId %>';
            const response = await fetch(`/api/clients/${clientId}/employees/${employeeId}`, {
                method: 'PUT',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();
            if (!response.ok || !result.success) {
                throw new Error(result.error || 'Error al actualizar el agente');
            }

            // Success - restore button before hiding modal
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalContent;

            // Hide modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('editEmployeeModal'));
            modal.hide();

            showSuccessAlert(`Agente "${formData.firstName} ${formData.lastName}" actualizado exitosamente`);
            
            // Reload table
            if (window.employeesTable) {
                window.employeesTable.ajax.reload(null, false);
            }
        } catch (error) {
            console.error('Error updating agent:', error);
            showErrorAlert(error.message || 'Error al actualizar el agente. Por favor, intenta nuevamente.');
            
            // Restore button
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalContent;
        }
    }

