<!-- Employee Management JavaScript -->
<script>
    // ========================================================================
    // PASSWORD GENERATION UTILITY
    // ========================================================================
    
    /**
     * Generate a secure random password meeting complexity requirements
     * @returns {string} - Secure random password
     */
    function generateSecurePassword() {
        // Character sets for password generation
        const lowercase = 'abcdefghijklmnopqrstuvwxyz';
        const uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
        const numbers = '0123456789';
        // Using only safe special characters
        const specialChars = '!@#$%^&*';
        const allChars = lowercase + uppercase + numbers + specialChars;

        // Ensure at least one character from each category
        let password = '';
        password += lowercase[Math.floor(Math.random() * lowercase.length)];
        password += uppercase[Math.floor(Math.random() * uppercase.length)];
        password += numbers[Math.floor(Math.random() * numbers.length)];
        password += specialChars[Math.floor(Math.random() * specialChars.length)];

        // Fill remaining characters (12 total - 4 already added = 8 more)
        for (let i = 0; i < 8; i += 1) {
            password += allChars[Math.floor(Math.random() * allChars.length)];
        }

        // Shuffle the password to avoid predictable patterns
        password = password
            .split('')
            .sort(() => Math.random() - 0.5)
            .join('');

        return password;
    }

    // ========================================================================
    // CREATE EMPLOYEE MODAL FUNCTIONS
    // ========================================================================

    /**
     * Initialize create employee modal with validation
     */
    function initializeCreateEmployeeModal() {
        const modal = document.getElementById('createEmployeeModal');
        const form = document.getElementById('createEmployeeForm');
        const submitBtn = document.getElementById('submitCreateEmployee');

        if (!modal || !form || !submitBtn) return;

        // Character counter for notes
        const notesTextarea = document.getElementById('employeeNotes');
        const charCounter = document.getElementById('notesCharCountEmployee');

        if (notesTextarea && charCounter) {
            notesTextarea.addEventListener('input', function() {
                const length = this.value.length;
                charCounter.textContent = `${length}/500`;

                if (length > 450) {
                    charCounter.classList.add('text-warning');
                    charCounter.classList.remove('text-muted');
                } else if (length === 500) {
                    charCounter.classList.add('text-danger');
                    charCounter.classList.remove('text-warning', 'text-muted');
                } else {
                    charCounter.classList.remove('text-warning', 'text-danger');
                    charCounter.classList.add('text-muted');
                }
            });
        }

        // Password functionality for employee modal
        const employeePasswordInput = document.getElementById('employeePassword');
        const employeeToggleBtn = document.getElementById('toggleEmployeePasswordVisibility');
        const employeeToggleIcon = document.getElementById('employeePasswordToggleIcon');

        if (employeePasswordInput && employeeToggleBtn && employeeToggleIcon) {
            employeeToggleBtn.addEventListener('click', function() {
                const isPassword = employeePasswordInput.type === 'password';
                employeePasswordInput.type = isPassword ? 'text' : 'password';
                employeeToggleIcon.className = isPassword ? 'ti ti-eye-off' : 'ti ti-eye';
                employeeToggleBtn.title = isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña';
            });
        }

        // Employee password real-time validation
        const employeePasswordValidationFeedback = document.getElementById('employeePasswordValidationFeedback');
        const employeeLengthReq = document.getElementById('employeeLengthRequirement');
        const employeeUppercaseReq = document.getElementById('employeeUppercaseRequirement');
        const employeeLowercaseReq = document.getElementById('employeeLowercaseRequirement');
        const employeeNumberReq = document.getElementById('employeeNumberRequirement');
        const employeeSpecialCharReq = document.getElementById('employeeSpecialCharRequirement');

        function validateEmployeePasswordRequirements(password) {
            const requirements = {
                length: password.length >= 12,
                uppercase: /[A-Z]/.test(password),
                lowercase: /[a-z]/.test(password),
                number: /\d/.test(password),
                specialChar: /[!@#$%^&*()_+\-=[\]{};':"\\|,.<>/?]/.test(password)
            };

            // Update visual feedback for each requirement
            updateEmployeeRequirement(employeeLengthReq, requirements.length);
            updateEmployeeRequirement(employeeUppercaseReq, requirements.uppercase);
            updateEmployeeRequirement(employeeLowercaseReq, requirements.lowercase);
            updateEmployeeRequirement(employeeNumberReq, requirements.number);
            updateEmployeeRequirement(employeeSpecialCharReq, requirements.specialChar);

            // Show/hide validation feedback and update input styling
            const allValid = Object.values(requirements).every(req => req);
            const hasValue = password.length > 0;

            if (hasValue && !allValid) {
                employeePasswordValidationFeedback.style.display = 'block';
                employeePasswordInput.classList.add('is-invalid');
                employeePasswordInput.classList.remove('is-valid');
            } else if (hasValue && allValid) {
                employeePasswordValidationFeedback.style.display = 'none';
                employeePasswordInput.classList.remove('is-invalid');
                employeePasswordInput.classList.add('is-valid');
            } else {
                employeePasswordValidationFeedback.style.display = 'none';
                employeePasswordInput.classList.remove('is-invalid', 'is-valid');
            }

            return allValid;
        }

        function updateEmployeeRequirement(element, isValid) {
            const icon = element.querySelector('i');
            if (isValid) {
                element.classList.remove('text-danger');
                element.classList.add('text-success');
                icon.className = 'ti ti-check-circle me-1';
            } else {
                element.classList.remove('text-success');
                element.classList.add('text-danger');
                icon.className = 'ti ti-x-circle me-1';
            }
        }

        if (employeePasswordInput) {
            employeePasswordInput.addEventListener('input', function() {
                validateEmployeePasswordRequirements(this.value);
            });

            // Also validate on paste
            employeePasswordInput.addEventListener('paste', function() {
                setTimeout(() => {
                    validateEmployeePasswordRequirements(this.value);
                }, 10);
            });
        }

        // Copy employee password to clipboard
        const employeeCopyBtn = document.getElementById('copyEmployeePassword');
        const employeeCopyIcon = document.getElementById('copyEmployeeIcon');

        if (employeePasswordInput && employeeCopyBtn && employeeCopyIcon) {
            employeeCopyBtn.addEventListener('click', async function() {
                if (!employeePasswordInput.value.trim()) {
                    showAlert('No hay contraseña para copiar', 'warning');
                    return;
                }

                try {
                    await navigator.clipboard.writeText(employeePasswordInput.value);
                    
                    // Visual feedback
                    const originalIcon = employeeCopyIcon.className;
                    employeeCopyIcon.className = 'ti ti-check';
                    employeeCopyBtn.classList.remove('btn-outline-secondary');
                    employeeCopyBtn.classList.add('btn-success');
                    
                    setTimeout(() => {
                        employeeCopyIcon.className = originalIcon;
                        employeeCopyBtn.classList.remove('btn-success');
                        employeeCopyBtn.classList.add('btn-outline-secondary');
                    }, 1500);
                    
                    showSuccessAlert('Contraseña copiada al portapapeles');
                } catch (err) {
                    console.error('Error copying to clipboard:', err);
                    showErrorAlert('Error al copiar la contraseña');
                }
            });
        }

        // Generate employee password functionality
        const employeeGenerateBtn = document.getElementById('generateEmployeePassword');
        const employeeGenerateIcon = document.getElementById('generateEmployeeIcon');

        if (employeePasswordInput && employeeGenerateBtn && employeeGenerateIcon) {
            employeeGenerateBtn.addEventListener('click', function() {
                // Generate secure password
                const newPassword = generateSecurePassword();
                employeePasswordInput.value = newPassword;
                
                // Trigger validation
                validateEmployeePasswordRequirements(newPassword);
                
                // Trigger form validation to enable/disable submit button
                validateForm();
                
                // Visual feedback
                const originalIcon = employeeGenerateIcon.className;
                employeeGenerateIcon.className = 'ti ti-check';
                employeeGenerateBtn.classList.remove('btn-outline-primary');
                employeeGenerateBtn.classList.add('btn-success');
                
                setTimeout(() => {
                    employeeGenerateIcon.className = originalIcon;
                    employeeGenerateBtn.classList.remove('btn-success');
                    employeeGenerateBtn.classList.add('btn-outline-primary');
                }, 1500);
                
                // Show success message
                showSuccessAlert('Nueva contraseña generada exitosamente');
                
                // Show the password for easy verification
                employeePasswordInput.type = 'text';
                employeeToggleIcon.className = 'ti ti-eye-off';
                employeeToggleBtn.title = 'Ocultar contraseña';
                
                // Hide password again after 3 seconds
                setTimeout(() => {
                    employeePasswordInput.type = 'password';
                    employeeToggleIcon.className = 'ti ti-eye';
                    employeeToggleBtn.title = 'Mostrar contraseña';
                }, 3000);
            });
        }

        // Role description display
        const roleSelect = document.getElementById('employeeRole');
        if (roleSelect) {
            // Show default description on modal open since "client" is selected by default
            document.getElementById('roleDescriptionClient')?.classList.remove('d-none');
            
            roleSelect.addEventListener('change', function() {
                // Hide all descriptions
                document.querySelectorAll('.role-description').forEach(el => el.classList.add('d-none'));

                // Show selected role description
                if (this.value === 'client') {
                    document.getElementById('roleDescriptionClient')?.classList.remove('d-none');
                } else if (this.value === 'employee') {
                    document.getElementById('roleDescriptionEmployee')?.classList.remove('d-none');
                }
            });
        }

        // Real-time validation
        const requiredFields = form.querySelectorAll('[required]');

        function validateForm() {
            let isValid = true;

            requiredFields.forEach(field => {
                const value = field.value.trim();

                // Required field validation
                if (!value) {
                    isValid = false;
                    return;
                }

                // Email validation
                if (field.type === 'email' && value) {
                    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                    if (!emailRegex.test(value)) {
                        isValid = false;
                    }
                }

                // Password validation
                if (field.type === 'password' && value) {
                    const passwordValid = validateEmployeePasswordRequirements(value);
                    if (!passwordValid) {
                        isValid = false;
                    }
                }
            });

            submitBtn.disabled = !isValid;
            return isValid;
        }

        // Validate on input for all form fields
        form.addEventListener('input', validateForm);
        form.addEventListener('change', validateForm);

        // Live email validation
        const employeeEmailInput = document.getElementById('employeeEmail');
        if (employeeEmailInput) {
            function validateEmployeeEmailField(email) {
                const trimmedEmail = (email || '').trim();
                
                // If empty, just remove validation classes
                if (!trimmedEmail) {
                    return { isValid: true, showFeedback: false };
                }

                // Email format validation
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(trimmedEmail)) {
                    return {
                        isValid: false,
                        message: 'Por favor, ingresa un email válido (ej: usuario@empresa.com)',
                        showFeedback: true
                    };
                }

                return { isValid: true, showFeedback: true };
            }

            function showEmployeeEmailValidation(validation) {
                const container = employeeEmailInput.closest('.mb-3');
                
                // Remove existing validation classes and feedback
                employeeEmailInput.classList.remove('is-valid', 'is-invalid');
                const existingFeedback = container.querySelector('.invalid-feedback, .valid-feedback');
                if (existingFeedback) {
                    existingFeedback.remove();
                }

                if (!validation.showFeedback) {
                    return; // Don't show any feedback for empty field
                }

                if (!validation.isValid) {
                    // Show error state
                    employeeEmailInput.classList.add('is-invalid');
                    const feedback = document.createElement('div');
                    feedback.className = 'invalid-feedback';
                    feedback.innerHTML = `<i class="ti ti-alert-circle me-1"></i>${validation.message}`;
                    container.appendChild(feedback);
                } else {
                    // Show success state for valid email
                    employeeEmailInput.classList.add('is-valid');
                    const feedback = document.createElement('div');
                    feedback.className = 'valid-feedback';
                    feedback.innerHTML = `<i class="ti ti-check me-1"></i>Email válido`;
                    container.appendChild(feedback);
                }
            }

            // Add debounced input validation
            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }

            // Real-time email validation on input
            employeeEmailInput.addEventListener('input', debounce((e) => {
                const validation = validateEmployeeEmailField(e.target.value);
                showEmployeeEmailValidation(validation);
            }, 300));

            // Immediate validation on blur
            employeeEmailInput.addEventListener('blur', (e) => {
                const validation = validateEmployeeEmailField(e.target.value);
                showEmployeeEmailValidation(validation);
            });
        }

        // Handle form submission
        submitBtn.addEventListener('click', async function() {
            if (!validateForm()) return;

            // Collect form data
            const formData = {
                firstName: document.getElementById('employeeFirstName').value.trim(),
                lastName: document.getElementById('employeeLastName').value.trim(),
                email: document.getElementById('employeeEmail').value.trim(),
                password: document.getElementById('employeePassword').value.trim(),
                role: document.getElementById('employeeRole').value.trim(),
                phone: document.getElementById('employeePhone').value.trim() || '',
                notes: document.getElementById('employeeNotes').value.trim() || ''
            };

            // Remove undefined values
            Object.keys(formData).forEach(key => {
                if (formData[key] === undefined) {
                    delete formData[key];
                }
            });

            await executeCreateEmployee(formData);
        });

        // Reset form on modal hide
        modal.addEventListener('hidden.bs.modal', function() {
            form.reset();
            submitBtn.disabled = true;

            if (charCounter) {
                charCounter.textContent = '0/500';
                charCounter.classList.remove('text-warning', 'text-danger');
                charCounter.classList.add('text-muted');
            }

            // Hide role descriptions
            document.querySelectorAll('.role-description').forEach(el => el.classList.add('d-none'));

            // Reset password validation feedback
            if (employeePasswordValidationFeedback) {
                employeePasswordValidationFeedback.style.display = 'none';
            }

            // Clear validation states
            form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid', 'is-valid'));
            form.querySelectorAll('.is-valid').forEach(el => el.classList.remove('is-valid'));
            form.querySelectorAll('.invalid-feedback').forEach(el => el.style.display = 'none');
            form.querySelectorAll('.valid-feedback').forEach(el => el.style.display = 'none');
            
            // Specifically clear phone input validation
            const phoneInput = document.getElementById('employeePhone');
            if (phoneInput) {
                phoneInput.classList.remove('is-invalid', 'is-valid');
            }
        });
    }

    /**
     * Execute create employee API call
     * @param {object} formData - Employee data from form
     */
    async function executeCreateEmployee(formData) {
        const submitBtn = document.getElementById('submitCreateEmployee');
        const modal = bootstrap.Modal.getInstance(document.getElementById('createEmployeeModal'));

        // Disable button and show loading
        submitBtn.disabled = true;
        const originalContent = submitBtn.innerHTML;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Creando...';

        try {
            const clientId = '<%= clientId %>';
            const response = await fetch(`/api/clients/${clientId}/employees`, {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                throw new Error(result.error || 'Error al crear el agente');
            }

            // Success - restore button before hiding modal
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalContent;

            modal.hide();
            showSuccessAlert(`Agente "${formData.firstName} ${formData.lastName}" creado exitosamente`);

            // Reload table
            if (window.employeesTable) {
                window.employeesTable.ajax.reload(null, false);
            }

        } catch (error) {
            console.error('Error creating agent:', error);
            showErrorAlert(error.message || 'Error al crear el agente. Por favor, intenta nuevamente.');

            // Restore button
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalContent;
        }
    }

    // ========================================================================
    // ALERT/NOTIFICATION FUNCTIONS FOR EMPLOYEE MODAL
    // ========================================================================

    /**
     * Show success alert message
     * @param {string} message - Success message to display
     */
    function showSuccessAlert(message) {
        const alertHtml = `
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="ti ti-check-circle me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;

        // Remove existing alerts
        document.querySelectorAll('.alert').forEach(el => el.remove());

        // Insert new alert at the top of the content column
        const contentColumn = document.getElementById('contentColumn');
        if (contentColumn) {
            contentColumn.insertAdjacentHTML('afterbegin', alertHtml);
        }

        // Auto-dismiss after 5 seconds
        setTimeout(() => {
            document.querySelectorAll('.alert').forEach(el => {
                el.classList.remove('show');
                setTimeout(() => el.remove(), 150);
            });
        }, 5000);
    }

    /**
     * Show error alert message
     * @param {string} message - Error message to display
     */
    function showErrorAlert(message) {
        const alertHtml = `
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ti ti-alert-circle me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;

        // Remove existing alerts
        document.querySelectorAll('.alert').forEach(el => el.remove());

        // Insert new alert at the top of the content column
        const contentColumn = document.getElementById('contentColumn');
        if (contentColumn) {
            contentColumn.insertAdjacentHTML('afterbegin', alertHtml);
        }
    }

    // ========================================================================
    // EDIT EMPLOYEE MODAL FUNCTIONS
    // ========================================================================
    
    /**
     * Initialize edit employee modal with validation and event handlers
     */
    function initializeEditEmployeeModal() {
        const modal = document.getElementById('editEmployeeModal');
        const form = document.getElementById('editEmployeeForm');
        const submitBtn = document.getElementById('submitEditEmployee');

        if (!modal || !form || !submitBtn) return;

        // Character counter for notes
        const notesTextarea = document.getElementById('editEmployeeNotes');
        const charCounter = document.getElementById('editNotesCharCountEmployee');

        if (notesTextarea && charCounter) {
            notesTextarea.addEventListener('input', function() {
                const length = this.value.length;
                charCounter.textContent = `${length}/500`;

                if (length > 450) {
                    charCounter.classList.add('text-warning');
                    charCounter.classList.remove('text-muted');
                } else if (length === 500) {
                    charCounter.classList.add('text-danger');
                    charCounter.classList.remove('text-warning', 'text-muted');
                } else {
                    charCounter.classList.remove('text-warning', 'text-danger');
                    charCounter.classList.add('text-muted');
                }
            });
        }

        // Role change handler for edit modal
        const editRoleSelect = document.getElementById('editEmployeeRole');
        if (editRoleSelect) {
            editRoleSelect.addEventListener('change', function() {
                // Hide all role descriptions
                document.querySelectorAll('#editEmployeeModal .role-description').forEach(el => el.classList.add('d-none'));
                
                // Show selected role description
                if (this.value === 'client') {
                    document.getElementById('editRoleDescriptionClient')?.classList.remove('d-none');
                } else if (this.value === 'employee') {
                    document.getElementById('editRoleDescriptionEmployee')?.classList.remove('d-none');
                }
            });
        }

        // Form validation
        const requiredFields = form.querySelectorAll('[required]');
        function validateEditForm() {
            let isValid = true;
            requiredFields.forEach(field => {
                const value = field.value.trim();
                if (!value) {
                    isValid = false;
                    return;
                }
                
                // Email validation
                if (field.type === 'email' && value) {
                    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                    if (!emailRegex.test(value)) {
                        isValid = false;
                    }
                }
            });
            submitBtn.disabled = !isValid;
            return isValid;
        }

        // Email field is read-only for security - no validation needed
        
        // Password generation and validation for edit modal
        const editPasswordInput = document.getElementById('editEmployeePassword');
        const generatePasswordEditBtn = document.getElementById('generatePasswordEditBtn');
        const toggleEditPasswordBtn = document.getElementById('toggleEditPasswordVisibility');
        const copyEditPasswordBtn = document.getElementById('copyEditPassword');
        const editPasswordValidationFeedback = document.getElementById('editPasswordValidationFeedback');

        // Password validation function for edit modal
        function validateEditPasswordRequirements(password) {
            const requirements = {
                length: password.length >= 12,
                uppercase: /[A-Z]/.test(password),
                lowercase: /[a-z]/.test(password),
                number: /\d/.test(password),
                special: /[!@#$%^&*()_+\-=[\]{};':"\\|,.<>/?]/.test(password)
            };

            // Update UI for each requirement
            const updateRequirement = (id, met) => {
                const element = document.getElementById(id);
                if (element) {
                    const icon = element.querySelector('i');
                    if (met) {
                        element.classList.remove('text-danger');
                        element.classList.add('text-success');
                        icon.classList.remove('ti-x');
                        icon.classList.add('ti-check');
                    } else {
                        element.classList.remove('text-success');
                        element.classList.add('text-danger');
                        icon.classList.remove('ti-check');
                        icon.classList.add('ti-x');
                    }
                }
            };

            updateRequirement('editLengthRequirement', requirements.length);
            updateRequirement('editUppercaseRequirement', requirements.uppercase);
            updateRequirement('editLowercaseRequirement', requirements.lowercase);
            updateRequirement('editNumberRequirement', requirements.number);
            updateRequirement('editSpecialCharRequirement', requirements.special);

            // Return true if all requirements are met
            return Object.values(requirements).every(v => v === true);
        }

        // Password visibility toggle
        if (toggleEditPasswordBtn) {
            toggleEditPasswordBtn.addEventListener('click', function() {
                const icon = document.getElementById('editPasswordToggleIcon');
                if (editPasswordInput.type === 'password') {
                    editPasswordInput.type = 'text';
                    icon.classList.remove('ti-eye');
                    icon.classList.add('ti-eye-off');
                } else {
                    editPasswordInput.type = 'password';
                    icon.classList.remove('ti-eye-off');
                    icon.classList.add('ti-eye');
                }
            });
        }

        // Copy password button
        if (copyEditPasswordBtn) {
            copyEditPasswordBtn.addEventListener('click', function() {
                if (editPasswordInput && editPasswordInput.value) {
                    // Temporarily show password to copy
                    const originalType = editPasswordInput.type;
                    editPasswordInput.type = 'text';
                    editPasswordInput.select();
                    document.execCommand('copy');
                    editPasswordInput.type = originalType;
                    
                    // Visual feedback
                    const icon = document.getElementById('copyEditPasswordIcon');
                    icon.classList.remove('ti-copy');
                    icon.classList.add('ti-check');
                    setTimeout(() => {
                        icon.classList.remove('ti-check');
                        icon.classList.add('ti-copy');
                    }, 2000);
                    
                    // Show alert
                    showSuccessAlert('Contraseña copiada al portapapeles');
                }
            });
        }

        // Generate password button
        if (generatePasswordEditBtn) {
            generatePasswordEditBtn.addEventListener('click', function() {
                const newPassword = generateSecurePassword();
                if (editPasswordInput) {
                    editPasswordInput.value = newPassword;
                    
                    // Show password automatically when generated
                    editPasswordInput.type = 'text';
                    const toggleIcon = document.getElementById('editPasswordToggleIcon');
                    if (toggleIcon) {
                        toggleIcon.classList.remove('ti-eye');
                        toggleIcon.classList.add('ti-eye-off');
                    }
                    
                    // Validate and show feedback
                    editPasswordValidationFeedback.style.display = 'block';
                    const isValid = validateEditPasswordRequirements(newPassword);
                    
                    if (isValid) {
                        editPasswordInput.classList.remove('is-invalid');
                        editPasswordInput.classList.add('is-valid');
                    }
                    
                    // Animate the generate button
                    const icon = document.getElementById('generateEditPasswordIcon');
                    icon.classList.add('ti-spin');
                    setTimeout(() => {
                        icon.classList.remove('ti-spin');
                    }, 500);
                    
                    // Trigger validation
                    validateEditForm();
                }
            });
        }

        // Password input validation
        if (editPasswordInput) {
            editPasswordInput.addEventListener('input', function() {
                const password = this.value;
                
                if (password) {
                    // Show validation feedback
                    editPasswordValidationFeedback.style.display = 'block';
                    const isValid = validateEditPasswordRequirements(password);
                    
                    // Update input styling
                    if (isValid) {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                    } else {
                        this.classList.remove('is-valid');
                        this.classList.add('is-invalid');
                    }
                } else {
                    // Hide validation feedback when empty
                    editPasswordValidationFeedback.style.display = 'none';
                    this.classList.remove('is-invalid', 'is-valid');
                }
                
                validateEditForm();
            });
            
            // Show validation on focus
            editPasswordInput.addEventListener('focus', function() {
                if (this.value) {
                    editPasswordValidationFeedback.style.display = 'block';
                }
            });
        }

        // Validate on input for all form fields
        form.addEventListener('input', validateEditForm);
        form.addEventListener('change', validateEditForm);

        // Handle form submission
        submitBtn.addEventListener('click', async function() {
            if (!validateEditForm()) return;

            const formData = {
                firstName: document.getElementById('editEmployeeFirstName').value.trim(),
                lastName: document.getElementById('editEmployeeLastName').value.trim(),
                email: document.getElementById('editEmployeeEmail').value.trim(),
                role: document.getElementById('editEmployeeRole').value.trim(),
                phone: document.getElementById('editEmployeePhone').value.trim() || '',
                notes: document.getElementById('editEmployeeNotes').value.trim() || '',
                active: document.getElementById('editEmployeeActive').checked
            };
            
            // Include password only if a new password was entered
            const newPassword = document.getElementById('editEmployeePassword').value.trim();
            if (newPassword) {
                formData.password = newPassword;
            }

            // Remove undefined values
            Object.keys(formData).forEach(key => {
                if (formData[key] === undefined) {
                    delete formData[key];
                }
            });

            const employeeId = document.getElementById('editEmployeeId').value;
            await executeUpdateEmployee(employeeId, formData);
        });

        // Reset form on modal hide
        modal.addEventListener('hidden.bs.modal', function() {
            form.reset();
            submitBtn.disabled = true;
            if (charCounter) {
                charCounter.textContent = '0/500';
                charCounter.classList.remove('text-warning', 'text-danger');
                charCounter.classList.add('text-muted');
            }
            
            // Hide role descriptions
            document.querySelectorAll('#editEmployeeModal .role-description').forEach(el => el.classList.add('d-none'));
            
            // Clear validation states
            form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid', 'is-valid'));
            form.querySelectorAll('.is-valid').forEach(el => el.classList.remove('is-valid'));
            form.querySelectorAll('.invalid-feedback').forEach(el => el.remove());
            form.querySelectorAll('.valid-feedback').forEach(el => el.remove());
            
            // Clear password field and reset visibility
            const passwordField = document.getElementById('editEmployeePassword');
            if (passwordField) {
                passwordField.value = '';
                passwordField.type = 'password';
                passwordField.classList.remove('is-invalid', 'is-valid');
            }
            
            // Reset password toggle icon
            const toggleIcon = document.getElementById('editPasswordToggleIcon');
            if (toggleIcon) {
                toggleIcon.classList.remove('ti-eye-off');
                toggleIcon.classList.add('ti-eye');
            }
            
            // Hide and reset password validation feedback
            const passwordValidation = document.getElementById('editPasswordValidationFeedback');
            if (passwordValidation) {
                passwordValidation.style.display = 'none';
                // Reset all requirement indicators
                ['editLengthRequirement', 'editUppercaseRequirement', 'editLowercaseRequirement', 
                 'editNumberRequirement', 'editSpecialCharRequirement'].forEach(id => {
                    const element = document.getElementById(id);
                    if (element) {
                        element.classList.remove('text-success');
                        element.classList.add('text-danger');
                        const icon = element.querySelector('i');
                        if (icon) {
                            icon.classList.remove('ti-check');
                            icon.classList.add('ti-x');
                        }
                    }
                });
            }
        });
    }

    /**
