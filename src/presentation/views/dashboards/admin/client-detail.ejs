    /**
     * Password Reset Modal functionality
     */
    function initializePasswordResetModal() {
        
        const resetPasswordModal = document.getElementById('resetPasswordModal');
        const confirmPasswordReset = document.getElementById('confirmPasswordReset');
        const copyPasswordButton = document.getElementById('copyPasswordButton');
        const passwordSuccessDisplay = document.getElementById('passwordSuccessDisplay');
        const generatedPasswordDisplay = document.getElementById('generatedPasswordDisplay');
        
        
        if (confirmPasswordReset) {
            confirmPasswordReset.addEventListener('click', async function() {
                const originalContent = this.innerHTML;
                this.disabled = true;
                this.innerHTML = '<i class="ti ti-loader-2 me-1 spinner-border spinner-border-sm"></i>Generando...';
                
                try {
                    const clientId = '<%= clientData.id %>';
                    
                    const response = await fetch(`/api/clients/${clientId}/reset-password`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        credentials: 'include'
                    });
                    
                    const data = await response.json();
                    
                    if (!response.ok) {
                        console.error('❌ API Error - Status:', response.status, 'Status Text:', response.statusText);
                        console.error('❌ API Error - Response:', data);
                        throw new Error(data.message || `HTTP ${response.status}: ${response.statusText}`);
                    }
                    
                    // Show the generated password in the success display
                    generatedPasswordDisplay.textContent = data.password;
                    passwordSuccessDisplay.classList.remove('d-none');
                    
                    // Hide the confirm button and show success state
                    this.style.display = 'none';
                    
                    // Show global success message
                    showSuccessMessage('Nueva contraseña generada exitosamente.');
                    
                } catch (error) {
                    console.error('Error resetting password:', error);
                    showErrorMessage(error.message || 'Error al generar nueva contraseña. Por favor, intenta nuevamente.');
                } finally {
                    this.disabled = false;
                    this.innerHTML = originalContent;
                }
            });
        }
        
        if (copyPasswordButton) {
            copyPasswordButton.addEventListener('click', async function() {
                try {
                    const password = generatedPasswordDisplay.textContent;
                    await navigator.clipboard.writeText(password);
                    
                    const originalContent = this.innerHTML;
                    this.innerHTML = '<i class="ti ti-check me-1"></i>Copiado';
                    this.classList.remove('btn-outline-primary');
                    this.classList.add('btn-success');
                    
                    setTimeout(() => {
                        this.innerHTML = originalContent;
                        this.classList.remove('btn-success');
                        this.classList.add('btn-outline-primary');
                    }, 2000);
                    
                } catch (error) {
                    console.error('Error copying password:', error);
                    showErrorMessage('No se pudo copiar la contraseña. Por favor, seleccione y copie manualmente.');
                }
            });
        }
        
        // Reset modal state when hidden
        if (resetPasswordModal) {
            resetPasswordModal.addEventListener('hidden.bs.modal', function() {
                passwordSuccessDisplay.classList.add('d-none');
                confirmPasswordReset.style.display = 'inline-block';
                generatedPasswordDisplay.textContent = '';
            });
        }
    }
    
    // Initialize password reset modal when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            initializePasswordResetModal();
        });
    } else {
        initializePasswordResetModal();
    }
    
    // Bulk Pricing Application Function
    async function applyBulkPricing(clientId, source) {
        // Get the checkbox and input values based on the source (services or tours tab)
        const suffix = source === 'services' ? '' : '-tours';
        const applyServices = document.getElementById(`apply-services-check${suffix}`).checked;
        const applyTours = document.getElementById(`apply-tours-check${suffix}`).checked;
        const markupPercentage = parseFloat(document.getElementById(`markup-percentage-${source}`).value);
        
        // Validate input
        if (!applyServices && !applyTours) {
            showPricingAlert('Por favor seleccione al menos un tipo de servicio (Servicios o Tours).', 'warning', source);
            return;
        }
        
        if (isNaN(markupPercentage) || markupPercentage < 0 || markupPercentage > 100) {
            showPricingAlert('Por favor ingrese un porcentaje válido entre 0 y 100.', 'danger', source);
            return;
        }
        
        // Disable button and show loading
        const button = document.getElementById(`apply-pricing-btn-${source}`);
        const originalText = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Aplicando...';
        
        try {
            // Call API endpoint to apply bulk pricing
            const response = await fetch('/api/client-prices/bulk-apply', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${localStorage.getItem('token')}`
                },
                body: JSON.stringify({
                    clientId: clientId,
                    applyToServices: applyServices,
                    applyToTours: applyTours,
                    markupPercentage: markupPercentage
                })
            });
            
            const data = await response.json();
            
            if (response.ok && data.success) {
                // Show success message
                const message = `✅ Incremento aplicado exitosamente. ` +
                    `Servicios: ${data.servicesCreated || 0} precios creados. ` +
                    `Tours: ${data.toursCreated || 0} precios creados.`;
                showPricingAlert(message, 'success', source);
                
                // Reload the respective table after a delay
                setTimeout(() => {
                    if (source === 'services' && window.servicesTable) {
                        window.servicesTable.ajax.reload();
                    } else if (source === 'tours' && window.toursTable) {
                        window.toursTable.ajax.reload();
                    }
                    // Hide alert after reload
                    setTimeout(() => {
                        hidePricingAlert(source);
                    }, 3000);
                }, 2000);
            } else {
                throw new Error(data.error || 'Error al aplicar el incremento de precios');
            }
        } catch (error) {
            console.error('Error applying bulk pricing:', error);
            showPricingAlert('Error al aplicar el incremento: ' + error.message, 'danger', source);
        } finally {
            // Re-enable button
            button.disabled = false;
            button.innerHTML = originalText;
        }
    }
    
    function showPricingAlert(message, type, source) {
        const alertDiv = document.getElementById(`pricing-alert-${source}`);
        const alertText = document.getElementById(`pricing-alert-text-${source}`);
        
        alertDiv.classList.remove('d-none', 'alert-info', 'alert-success', 'alert-warning', 'alert-danger');
        alertDiv.classList.add(`alert-${type}`);
        alertText.textContent = message;
    }
    
    function hidePricingAlert(source) {
        const alertDiv = document.getElementById(`pricing-alert-${source}`);
        alertDiv.classList.add('d-none');
    }

    // New Sidebar Bulk Pricing Functionality
    document.addEventListener('DOMContentLoaded', function() {
        const applyBulkPricingBtn = document.getElementById('apply-bulk-pricing');
        
        if (applyBulkPricingBtn) {
            applyBulkPricingBtn.addEventListener('click', async function() {
                console.log('Button clicked!'); // Debug log
                
                const applyServices = document.getElementById('apply-to-services').checked;
                const applyTours = document.getElementById('apply-to-tours').checked;
                const markupPercentage = parseFloat(document.getElementById('markup-percentage').value);
                
                console.log('Values:', { applyServices, applyTours, markupPercentage }); // Debug log
                
                // Validate input
                if (!applyServices && !applyTours) {
                    showSidebarAlert('Por favor seleccione al menos un tipo de servicio (Servicios o Tours).', 'warning');
                    return;
                }
                
                if (isNaN(markupPercentage) || markupPercentage < 0 || markupPercentage > 100) {
                    showSidebarAlert('Por favor ingrese un porcentaje válido entre 0 y 100.', 'danger');
                    return;
                }
                
                // Disable button and show loading
                const originalText = applyBulkPricingBtn.innerHTML;
                applyBulkPricingBtn.disabled = true;
                applyBulkPricingBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Aplicando...';
                
                // Show progress bar and hide results
                const progressContainer = document.getElementById('bulk-pricing-progress');
                const progressBar = document.getElementById('progress-bar');
                const progressPercentage = document.getElementById('progress-percentage');
                const progressStatus = document.getElementById('progress-status');
                const resultsContainer = document.getElementById('bulk-pricing-results');
                
                progressContainer.style.display = 'block';
                resultsContainer.style.display = 'none';
                progressBar.style.width = '0%';
                progressPercentage.textContent = '0%';
                progressStatus.textContent = 'Iniciando proceso...';

                // Simulate progress updates during the request
                let simulatedProgress = 5;
                const progressInterval = setInterval(() => {
                    if (simulatedProgress < 95) {
                        simulatedProgress += Math.random() * 10;
                        if (simulatedProgress > 95) simulatedProgress = 95;
                        
                        progressBar.style.width = simulatedProgress + '%';
                        progressPercentage.textContent = Math.round(simulatedProgress) + '%';
                        
                        if (simulatedProgress < 30) {
                            progressStatus.textContent = 'Cargando servicios y tarifas...';
                        } else if (simulatedProgress < 60) {
                            progressStatus.textContent = 'Procesando combinaciones de precios...';
                        } else if (simulatedProgress < 90) {
                            progressStatus.textContent = 'Aplicando incrementos...';
                        } else {
                            progressStatus.textContent = 'Finalizando proceso...';
                        }
                    }
                }, 500);

                try {
                    // Use the original working endpoint
                    const response = await fetch('/api/client-prices/bulk-apply', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include',
                        body: JSON.stringify({
                            clientId: '<%= clientId %>',
                            applyToServices: applyServices,
                            applyToTours: applyTours,
                            markupPercentage: markupPercentage
                        })
                    });
                    
                    clearInterval(progressInterval);
                    
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const data = await response.json();
                    
                    // Complete the progress bar
                    progressBar.style.width = '100%';
                    progressPercentage.textContent = '100%';
                    progressStatus.textContent = 'Proceso completado exitosamente';

                    if (data.success) {
                        // Use the message from backend if available, otherwise fall back to detailed breakdown
                        const message = data.message || 
                            `✅ Incremento aplicado exitosamente. ` +
                            `Servicios: ${data.servicesCreated || 0} creados, ${data.servicesUpdated || 0} actualizados. ` +
                            `Tours: ${data.toursCreated || 0} creados, ${data.toursUpdated || 0} actualizados.`;
                        
                        setTimeout(() => {
                            progressContainer.style.display = 'none';
                            showSidebarAlert(message, 'success');
                            
                            // Reload tables after showing success
                            setTimeout(() => {
                                if (window.servicesTable) window.servicesTable.ajax.reload();
                                if (window.toursTable) window.toursTable.ajax.reload();
                            }, 1500);
                        }, 1000);
                    } else {
                        throw new Error(data.error || 'No se pudo aplicar el incremento');
                    }

                } catch (error) {
                    clearInterval(progressInterval);
                    console.error('Error during bulk pricing process:', error);
                    progressContainer.style.display = 'none';
                    showSidebarAlert('Error durante el proceso: ' + error.message, 'danger');
                } finally {
                    clearInterval(progressInterval);
                    applyBulkPricingBtn.disabled = false;
                    applyBulkPricingBtn.innerHTML = originalText;
                }
            });
        }
    });
    
    function showSidebarAlert(message, type) {
        const alertDiv = document.getElementById('bulk-pricing-results');
        const alertContent = document.getElementById('results-content');
        
        if (alertDiv && alertContent) {
            alertContent.textContent = message;
            const alertClass = alertDiv.querySelector('.alert');
            alertClass.className = `alert alert-${type} mb-0`;
            alertDiv.style.display = 'block';
        }
        
        // Auto-hide after 8 seconds for success, longer for errors
        const hideDelay = type === 'success' ? 8000 : 12000;
        setTimeout(() => {
            if (alertDiv) {
                alertDiv.style.display = 'none';
            }
        }, hideDelay);
    }
</script>

