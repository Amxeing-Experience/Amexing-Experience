<%
/**
 * Client Detail Page - Simplified without includes
 */

const activeSection = typeof section !== 'undefined' ? section : 'information';
const activeSubsection = typeof subsection !== 'undefined' ? subsection : '';

if (typeof client === 'undefined' || !client) {
    throw new Error('Client data is required');
}

function getNestedProperty(obj, path, defaultValue = '') {
    return path.split('.').reduce((acc, part) => acc && acc[part], obj) || defaultValue;
}

const clientData = {
    id: client.id || client.objectId,
    firstName: client.firstName || '',
    lastName: client.lastName || '',
    email: client.email || '',
    phone: client.phone || '',
    active: typeof client.active !== 'undefined' ? client.active : true,
    companyName: client.companyName || getNestedProperty(client, 'contextualData.companyName', ''),
    taxId: client.taxId || getNestedProperty(client, 'contextualData.taxId', ''),
    website: client.website || getNestedProperty(client, 'contextualData.website', ''),
    notes: client.notes || getNestedProperty(client, 'contextualData.notes', ''),
    addressStreet: getNestedProperty(client, 'address.street', ''),
    addressCity: getNestedProperty(client, 'address.city', ''),
    addressState: getNestedProperty(client, 'address.state', ''),
    addressZipCode: getNestedProperty(client, 'address.zipCode', ''),
    addressCountry: getNestedProperty(client, 'address.country', ''),
    clientCategory: client.clientCategory || null,
    isAmexingUser: client.isAmexingUser === true,
    roleName: client.roleName || null,
    // Person-type fields (present for Cliente Directo / agentes; agencies won't have them). Copied
    // here because the render + edit form read clientData.*, not the raw client.* passed by the controller.
    birthDate: client.birthDate || null,
    anniversary: client.anniversary || null,
    createdAt: client.createdAt || null,
    updatedAt: client.updatedAt || null
};

const clientId = clientData.id;
const clientName = `${clientData.firstName} ${clientData.lastName}`.trim();

// Determine display name - prefer company name, then personal name, then email
let displayName = '';
if (clientData.companyName && clientData.companyName !== 'Sin nombre') {
    displayName = clientData.companyName;
} else if (clientName) {
    displayName = clientName;
} else if (clientData.email) {
    displayName = clientData.email;
} else {
    displayName = 'Cliente';
}

const companyName = displayName;
const isActive = clientData.active;

// Only agencies have agents. Agencies are AmexingUser department_managers (no clientCategory),
// so detect by role too — not just the clientCategory used in the mixed list.
const isAgency = clientData.clientCategory === 'agency' || clientData.roleName === 'department_manager';

const menuItems = [
    { label: 'Información', icon: 'info-circle', section: 'information', href: `/dashboard/admin/clients/${clientId}` },
    // Agencies are entities (no personal profile); people-type clients get Perfil, agencies get Agentes.
    ...(!isAgency ? [{ label: 'Perfil', icon: 'address-book', section: 'profile', href: `/dashboard/admin/clients/${clientId}?section=profile` }] : []),
    ...(isAgency ? [{ label: 'Agentes', icon: 'users', section: 'employees', href: `/dashboard/admin/clients/${clientId}?section=employees` }] : []),
    { label: 'Trips', icon: 'plane', section: 'quotes', href: `/dashboard/admin/clients/${clientId}?section=quotes` },
    { label: 'Tarifario', icon: 'receipt-2', section: 'tarifario', href: `/dashboard/admin/clients/${clientId}?section=tarifario` }
];

// Tarifario subsections for tab navigation
const tarifarioTabs = [
    { label: 'Vehículos', icon: 'car', subsection: 'vehicles', href: `/dashboard/admin/clients/${clientId}?section=tarifario&subsection=vehicles` },
    { label: 'Traslados', icon: 'briefcase', subsection: 'services', href: `/dashboard/admin/clients/${clientId}?section=tarifario&subsection=services` },
    { label: 'Experiencias', icon: 'star', subsection: 'experiences', href: `/dashboard/admin/clients/${clientId}?section=tarifario&subsection=experiences` },
    { label: 'Tours', icon: 'map', subsection: 'tours', href: `/dashboard/admin/clients/${clientId}?section=tarifario&subsection=tours` }
];
%>

<% if (isNewClient) { %>
<!-- ===== MODO NUEVO: crear cliente (misma página, sin controlador nuevo) ===== -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-1 fw-bold">Nuevo Cliente</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/dashboard/admin"><i class="ti ti-home me-1"></i>Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/dashboard/admin/clients"><i class="ti ti-building me-1"></i>Clientes</a></li>
                        <li class="breadcrumb-item active">Nuevo</li>
                    </ol>
                </nav>
            </div>
            <a href="/dashboard/admin/clients" class="btn btn-sm btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>Volver</a>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div style="max-width:880px;">
            <!-- Toggle: Agencia / Cliente -->
            <div class="client-form-editorial mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="ti ti-users me-1"></i>Tipo de Cliente</h6>
                <div class="btn-group w-100" role="group" aria-label="Tipo de cliente">
                    <input type="radio" class="btn-check" name="pageClientType" id="pageTypeAgency" value="agency" checked>
                    <label class="btn btn-outline-primary" for="pageTypeAgency"><i class="ti ti-building me-2"></i>Agencia</label>
                    <input type="radio" class="btn-check" name="pageClientType" id="pageTypeClient" value="client">
                    <label class="btn btn-outline-primary" for="pageTypeClient"><i class="ti ti-user me-2"></i>Cliente</label>
                </div>
                <div class="form-text mt-2" id="pageTypeHelp"><strong>Agencia:</strong> usuario con acceso al sistema para gestionar sus propios clientes y reservas.</div>
            </div>

            <!-- Formulario AGENCIA -->
            <form id="createAgencyPageForm" novalidate>
                <%- include('../../organisms/forms/agency-form-fields') %>
                <div class="d-flex justify-content-end gap-2 mt-2 mb-4">
                    <a href="/dashboard/admin/clients" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary" id="createAgencyPageSubmit"><i class="ti ti-plus me-1"></i>Crear Agencia</button>
                </div>
            </form>

            <!-- Formulario CLIENTE (oculto por defecto) -->
            <form id="createClientPageForm" novalidate style="display:none;">
                <%- include('../../organisms/forms/client-form-fields', { client: {} }) %>
                <div class="d-flex justify-content-end gap-2 mt-2 mb-4">
                    <a href="/dashboard/admin/clients" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary" id="createClientPageSubmit"><i class="ti ti-plus me-1"></i>Crear Cliente</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var agencyForm = document.getElementById('createAgencyPageForm');
    var clientForm = document.getElementById('createClientPageForm');
    var typeHelp = document.getElementById('pageTypeHelp');
    if (!agencyForm || !clientForm) return;
    var g = function (id) { var el = document.getElementById(id); return el ? String(el.value || '').trim() : ''; };
    var pass = function (id) { var el = document.getElementById(id); return el && el.value ? el.value : undefined; };
    var token = function () { return (document.cookie.match(/clientAccessToken=([^;]+)/) || [])[1] || ''; };

    // Toggle mostrar/ocultar
    document.querySelectorAll('input[name="pageClientType"]').forEach(function (r) {
        r.addEventListener('change', function () {
            var isAgency = document.getElementById('pageTypeAgency').checked;
            agencyForm.style.display = isAgency ? '' : 'none';
            clientForm.style.display = isAgency ? 'none' : '';
            if (typeHelp) {
                typeHelp.innerHTML = isAgency
                    ? '<strong>Agencia:</strong> usuario con acceso al sistema para gestionar sus propios clientes y reservas.'
                    : '<strong>Cliente:</strong> cliente final. Puede tener contraseña para ver sus cotizaciones y reservaciones.';
            }
        });
    });

    async function submitClient(endpoint, payload, btn) {
        btn.disabled = true;
        try {
            var resp = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token() },
                credentials: 'same-origin',
                body: JSON.stringify(payload)
            });
            var data = await resp.json().catch(function () { return {}; });
            if (resp.ok && data && data.success) {
                var d = data.data || {};
                var id = d.id || (d.client && (d.client.id || d.client.objectId)) || null;
                window.location.href = id ? ('/dashboard/admin/clients/' + id) : '/dashboard/admin/clients';
            } else {
                alert((data && (data.error || data.message)) || 'No se pudo crear el registro');
                btn.disabled = false;
            }
        } catch (err) {
            alert('Error al crear el registro');
            btn.disabled = false;
        }
    }

    // AGENCIA → /api/clients
    agencyForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var payload = {
            firstName: g('agencyFirstName'),
            lastName: g('agencyLastName'),
            email: g('agencyEmail'),
            password: pass('agencyPassword'),
            phone: g('agencyPhone') || undefined,
            companyName: g('agencyCompanyName') || undefined,
            website: g('agencyWebsite') || undefined,
            notes: g('agencyNotes') || undefined
        };
        if (!payload.firstName || !payload.lastName || !payload.email) { alert('Nombre, apellido y email del representante son obligatorios'); return; }
        if (!payload.companyName) { alert('El nombre de la empresa es obligatorio'); return; }
        if (!payload.password) { alert('La contraseña de la agencia es obligatoria'); return; }
        submitClient('/api/clients', payload, document.getElementById('createAgencyPageSubmit'));
    });

    // CLIENTE → /api/owned-clients
    clientForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var payload = {
            clientCategory: g('directClientCategory') || undefined,
            firstName: g('directClientFirstName'),
            lastName: g('directClientLastName'),
            email: g('directClientEmail') || undefined,
            password: pass('directClientPassword'),
            phone: g('directClientPhone') || undefined,
            birthDate: g('directClientBirthDate') || undefined,
            contactFirstName: g('directClientContactFirstName') || undefined,
            contactLastName: g('directClientContactLastName') || undefined,
            emergencyContactName: g('directClientEmergencyContactName') || undefined,
            emergencyContactPhone: g('directClientEmergencyContactPhone') || undefined,
            companyType: g('directClientCompanyType') || undefined,
            website: g('directClientWebsite') || undefined,
            streetType: g('directClientStreetType') || undefined,
            streetName: g('directClientStreetName') || undefined,
            exteriorNumber: g('directClientExteriorNumber') || undefined,
            interiorNumber: g('directClientInteriorNumber') || undefined,
            colonia: g('directClientColonia') || undefined,
            city: g('directClientCity') || undefined,
            state: g('directClientState') || undefined,
            postalCode: g('directClientPostalCode') || undefined,
            preferredLanguage: g('directClientPreferredLanguage') || 'es',
            accessibilityRequirements: g('directClientAccessibilityRequirements') || undefined,
            allergies: g('directClientAllergies') || undefined,
            dietaryRestrictions: g('directClientDietaryRestrictions') || undefined,
            notes: g('directClientNotes') || undefined
        };
        if (!payload.firstName || !payload.lastName) { alert('Nombre y apellido son obligatorios'); return; }
        if (payload.password && !payload.email) { alert('Para asignar contraseña, el cliente necesita email'); return; }
        submitClient('/api/owned-clients', payload, document.getElementById('createClientPageSubmit'));
    });
});
</script>
<% } else { %>
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-1 fw-bold"><%= companyName %></h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/dashboard/admin"><i class="ti ti-home me-1"></i>Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/dashboard/admin/clients"><i class="ti ti-building me-1"></i>Clientes</a></li>
                        <li class="breadcrumb-item active"><%= companyName %></li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex align-items-center gap-2">
                <% if (isActive) { %>
                    <span class="badge bg-success fs-6"><i class="ti ti-check-circle me-1"></i>Activo</span>
                <% } else { %>
                    <span class="badge bg-danger fs-6"><i class="ti ti-x-circle me-1"></i>Inactivo</span>
                <% } %>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editClientModal">
                    <i class="ti ti-edit me-1"></i>Editar
                </button>
                <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#resetPasswordModal">
                    <i class="ti ti-key me-1"></i>Restablecer Contraseña
                </button>
                <a href="/dashboard/admin/clients" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i>Volver
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Main Content with spacing from header -->
<!-- Horizontal navigation tabs (full width) -->
<div class="row mt-4">
    <div class="col-12">
        <nav class="client-nav-tabs">
            <% menuItems.forEach(function(item) { %>
                <a href="<%= item.href %>" class="client-nav-tab <%= item.section === activeSection ? 'active' : '' %>">
                    <i class="ti ti-<%= item.icon %>"></i><span><%= item.label %></span>
                </a>
            <% }); %>
        </nav>
    </div>
</div>

<!-- Main content row -->
<div class="row mt-4">
    <!-- Bulk Pricing Panel (only visible in tarifario section, right column) -->
    <% if (activeSection === 'tarifario') { %>
    <div class="col-lg-4 order-2 mb-3 mb-lg-0">
        <div class="card border-0 shadow-sm mt-3" id="bulk-pricing-panel">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Incrementar precios tarifario
                </h5>
            </div>
            <div class="card-body">
                <!-- Informational text -->
                <div class="alert alert-info py-2 px-3 mb-3">
                    <small class="mb-0">
                        <i class="ti ti-info-circle me-1"></i>
                        El incremento se aplicará sobre el precio base del tarifario general
                    </small>
                </div>
                
                <!-- Services Checkbox -->
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="apply-to-services" checked>
                    <label class="form-check-label small" for="apply-to-services">
                        <i class="ti ti-car me-1"></i>
                        Traslados
                    </label>
                </div>
                
                <!-- Tours Checkbox -->
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="apply-to-tours" checked>
                    <label class="form-check-label small" for="apply-to-tours">
                        <i class="ti ti-map-pin me-1"></i>
                        Tours
                    </label>
                </div>
                
                <!-- Percentage Input -->
                <div class="mb-3">
                    <label class="form-label small text-muted">Incremento (%)</label>
                    <div class="input-group input-group-sm">
                        <input type="number" 
                               class="form-control" 
                               id="markup-percentage" 
                               min="0" 
                               max="100" 
                               value="15"
                               step="1">
                        <span class="input-group-text">%</span>
                    </div>
                </div>
                
                <!-- Apply Button -->
                <button class="btn btn-primary btn-sm w-100" id="apply-bulk-pricing">
                    <i class="ti ti-check me-2"></i>
                    Aplicar
                </button>
                
                <!-- Progress Bar -->
                <div id="bulk-pricing-progress" class="mt-3" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted">Procesando precios...</small>
                        <small class="text-muted" id="progress-percentage">0%</small>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar progress-bar-animated" role="progressbar" id="progress-bar" style="width: 0%"></div>
                    </div>
                    <div class="text-center mt-2">
                        <small class="text-muted" id="progress-status">Iniciando...</small>
                    </div>
                </div>
                
                <!-- Results Message -->
                <div id="bulk-pricing-results" class="mt-3" style="display: none;">
                    <div class="alert alert-sm mb-0" role="alert">
                        <div id="results-content"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Export Tarifario Panel -->
        <div class="card border-0 shadow-sm mt-3" id="export-tarifario-panel">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="ti ti-download me-2"></i>Exportar Tarifario
                </h5>
            </div>
            <div class="card-body">
                <div class="form-check mb-1">
                    <input class="form-check-input export-section-check" type="checkbox" value="vehiculos" id="expVehiculos" checked>
                    <label class="form-check-label small" for="expVehiculos"><i class="ti ti-car me-1"></i>Vehiculos</label>
                </div>
                <div class="form-check mb-1">
                    <input class="form-check-input export-section-check" type="checkbox" value="traslados" id="expTraslados" checked>
                    <label class="form-check-label small" for="expTraslados"><i class="ti ti-briefcase me-1"></i>Traslados</label>
                </div>
                <div class="form-check mb-1">
                    <input class="form-check-input export-section-check" type="checkbox" value="a-disposicion" id="expDisposicion" checked>
                    <label class="form-check-label small" for="expDisposicion"><i class="ti ti-calculator me-1"></i>A Disposicion</label>
                </div>
                <div class="form-check mb-1">
                    <input class="form-check-input export-section-check" type="checkbox" value="experiencias" id="expExperiencias" checked>
                    <label class="form-check-label small" for="expExperiencias"><i class="ti ti-star me-1"></i>Experiencias</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input export-section-check" type="checkbox" value="tours" id="expTours" checked>
                    <label class="form-check-label small" for="expTours"><i class="ti ti-map me-1"></i>Tours</label>
                </div>

                <div class="mb-2">
                    <label class="form-label small text-muted mb-1">Formato</label>
                    <select class="form-select form-select-sm" id="exportFormat">
                        <option value="excel">Excel (.xlsx)</option>
                        <option value="pdf">PDF</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted mb-1">Tipo de Pago</label>
                    <select class="form-select form-select-sm" id="exportPaymentType">
                        <option value="efectivo">Efectivo</option>
                        <option value="transferencia" selected>Transferencia</option>
                        <option value="tarjeta">Tarjeta</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">Moneda</label>
                    <select class="form-select form-select-sm" id="exportCurrency">
                        <option value="MXN" selected>MXN</option>
                        <option value="USD">USD</option>
                    </select>
                </div>

                <button class="btn btn-primary btn-sm w-100" id="exportTarifarioBtn">
                    <i class="ti ti-download me-2"></i>Exportar
                </button>
            </div>
        </div>

        <script>
        document.getElementById('exportTarifarioBtn').addEventListener('click', function() {
            var checks = document.querySelectorAll('.export-section-check:checked');
            var sections = Array.from(checks).map(function(c) { return c.value; });
            if (sections.length === 0) {
                alert('Selecciona al menos una seccion.');
                return;
            }
            var format = document.getElementById('exportFormat').value;
            var paymentType = document.getElementById('exportPaymentType').value;
            var currency = document.getElementById('exportCurrency').value;
            var clientId = '<%= clientId %>';
            var url = '/api/tarifario/export?sections=' + sections.join(',') + '&format=' + format + '&paymentType=' + paymentType + '&currency=' + currency + '&clientId=' + clientId;

            var btn = this;
            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generando...';

            fetch(url, { credentials: 'same-origin' })
                .then(function(response) {
                    if (!response.ok) {
                        return response.json().then(function(data) { throw new Error(data.error || 'Error al exportar'); });
                    }
                    var disposition = response.headers.get('Content-Disposition') || '';
                    var match = disposition.match(/filename="?([^"]+)"?/);
                    var filename = match ? match[1] : 'tarifario-cliente.xlsx';
                    return response.blob().then(function(blob) { return { blob: blob, filename: filename }; });
                })
                .then(function(result) {
                    var a = document.createElement('a');
                    a.href = URL.createObjectURL(result.blob);
                    a.download = result.filename;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(a.href);
                })
                .catch(function(err) { alert(err.message || 'Error al generar la exportacion.'); })
                .finally(function() { btn.disabled = false; btn.innerHTML = originalHtml; });
        });
        </script>
    </div>
    <% } %>

    <div class="<%= activeSection === 'tarifario' ? 'col-lg-8 order-1' : 'col-12' %>" id="contentColumn">
        <% if (activeSection === 'information') { %>
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><h5 class="mb-0"><i class="ti ti-info-circle me-2 text-primary"></i>Información del Cliente</h5></div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="ti ti-user me-1"></i><%= isAgency ? 'Datos del Agente Admin' : 'Información Básica' %></h6>
                        <div class="row">
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Nombre</label><p class="fw-semibold mb-0"><%= clientData.firstName || 'N/A' %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Apellido</label><p class="fw-semibold mb-0"><%= clientData.lastName || 'N/A' %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Email</label><p class="mb-0"><a href="mailto:<%= clientData.email %>"><i class="ti ti-mail me-1"></i><%= clientData.email %></a></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Teléfono</label><p class="mb-0"><% if (clientData.phone) { %><a href="tel:<%= clientData.phone %>"><i class="ti ti-phone me-1"></i><%= clientData.phone %></a><% } else { %>N/A<% } %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Fecha de nacimiento</label><p class="mb-0"><% if (clientData.birthDate && !isNaN(new Date(clientData.birthDate))) { %><i class="ti ti-cake me-1"></i><%= new Date(clientData.birthDate).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }) %><% } else { %>N/A<% } %></p></div>
                        </div>
                    </div>
                    <%
                    // Empresa/Dirección Fiscal: las agencias siempre las muestran; los demás
                    // clientes solo si capturaron algún dato (si no, se ocultan ambas secciones).
                    const hasCompanyData = !!(clientData.companyName || clientData.taxId || clientData.website
                        || clientData.addressStreet || clientData.addressCity || clientData.addressState
                        || clientData.addressZipCode || clientData.addressCountry);
                    %>
                    <% if (isAgency || hasCompanyData) { %>
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="ti ti-building me-1"></i>Información de la Empresa</h6>
                        <div class="row">
                            <div class="col-md-12 mb-3"><label class="form-label text-muted small">Nombre de la Empresa</label><p class="fw-semibold mb-0"><%= clientData.companyName || 'N/A' %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">RFC</label><p class="mb-0"><%= clientData.taxId || 'N/A' %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Sitio Web</label><p class="mb-0"><% if (clientData.website) { %><a href="<%= clientData.website %>" target="_blank"><i class="ti ti-external-link me-1"></i><%= clientData.website %></a><% } else { %>N/A<% } %></p></div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="ti ti-map-pin me-1"></i>Dirección Fiscal</h6>
                        <div class="row">
                            <div class="col-md-12 mb-3"><label class="form-label text-muted small">Calle</label><p class="mb-0"><%= clientData.addressStreet || 'N/A' %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Ciudad</label><p class="mb-0"><%= clientData.addressCity || 'N/A' %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Estado</label><p class="mb-0"><%= clientData.addressState || 'N/A' %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">CP</label><p class="mb-0"><%= clientData.addressZipCode || 'N/A' %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">País</label><p class="mb-0"><%= clientData.addressCountry || 'N/A' %></p></div>
                        </div>
                    </div>
                    <% } %>
                    <% if (clientData.notes) { %>
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="ti ti-notes me-1"></i>Notas</h6>
                        <p class="text-muted mb-0"><%= clientData.notes %></p>
                    </div>
                    <% } %>
                    <div class="mb-0">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="ti ti-clock me-1"></i>Registro</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Fecha de Registro</label><p class="mb-0"><% if (clientData.createdAt) { %><%= new Date(clientData.createdAt).toLocaleString('es-ES', { dateStyle: 'long', timeStyle: 'short' }) %><% } else { %>N/A<% } %></p></div>
                            <div class="col-md-6 mb-3"><label class="form-label text-muted small">Actualización</label><p class="mb-0"><% if (clientData.updatedAt) { %><%= new Date(clientData.updatedAt).toLocaleString('es-ES', { dateStyle: 'long', timeStyle: 'short' }) %><% } else { %>N/A<% } %></p></div>
                        </div>
                    </div>
                </div>
            </div>
            <% if (isAgency) { %>
            <!-- Perfiles de Facturación (solo lectura), embebidos en Información — solo agencias.
                 Reusa el organism con targetUserId=clientId; el endpoint admin resuelve el
                 Client → su dueño (department_manager) y devuelve sus perfiles. -->
            <div class="mt-3">
                <%- include('../../organisms/billing/billing-profiles-section', {
                    userRole: typeof userRole !== 'undefined' ? userRole : 'admin',
                    readOnly: true,
                    targetUserId: clientId
                }) %>
            </div>
            <% } %>
        <% } else if (activeSection === 'profile') { %>
            <% /* Agencies are entities — no personal profile. Guard against a forced ?section=profile URL. */ %>
            <% if (isAgency) { %>
            <div class="alert alert-info mb-0"><i class="ti ti-info-circle me-2"></i>Las agencias no tienen perfil personal. Usa la pestaña Agentes.</div>
            <% } else { %>
            <!-- Profile: passports, addresses, travel preferences, loyalty programs. Loaded via AJAX. -->
            <% /* People-type clients are AmexingUser → profile sub-resources live under /api/agents/:id. */ %>
            <div id="profileRoot" data-client-id="<%= clientId %>"<% if (clientData.isAmexingUser) { %> data-owner-base="/api/agents/<%= clientId %>"<% } %>>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="ti ti-id me-2 text-primary"></i>Pasaportes</h5>
                        <button type="button" class="btn btn-sm btn-primary" id="addPassportBtn"><i class="ti ti-plus me-1"></i>Agregar Pasaporte</button>
                    </div>
                    <div class="card-body"><div id="passportsContainer"><p class="text-muted mb-0">Cargando…</p></div></div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="ti ti-map-pin me-2 text-primary"></i>Direcciones</h5>
                        <button type="button" class="btn btn-sm btn-primary" id="addAddressBtn"><i class="ti ti-plus me-1"></i>Agregar Dirección</button>
                    </div>
                    <div class="card-body"><div id="addressesContainer"><p class="text-muted mb-0">Cargando…</p></div></div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="ti ti-plane me-2 text-primary"></i>Preferencias de Viaje</h5>
                        <button type="button" class="btn btn-sm btn-primary" id="addPreferenceBtn"><i class="ti ti-edit me-1"></i>Editar preferencias</button>
                    </div>
                    <div class="card-body"><div id="preferencesContainer"><p class="text-muted mb-0">Cargando…</p></div></div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="ti ti-files me-2 text-primary"></i>Documentos</h5>
                        <button type="button" class="btn btn-sm btn-primary" id="addDocumentBtn"><i class="ti ti-plus me-1"></i>Agregar documento</button>
                    </div>
                    <div class="card-body">
                        <div id="documentFormWrap" class="border rounded p-3 mb-3 bg-light" style="display:none"></div>
                        <div id="documentsContainer"><p class="text-muted mb-0">Cargando…</p></div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="ti ti-star me-2 text-primary"></i>Programas de Lealtad</h5>
                        <button type="button" class="btn btn-sm btn-primary" id="addLoyaltyBtn"><i class="ti ti-plus me-1"></i>Agregar Programa</button>
                    </div>
                    <div class="card-body"><div id="loyaltyContainer"><p class="text-muted mb-0">Cargando…</p></div></div>
                </div>

            </div>
            <%- include('./sections/client-profile-section') %>
            <% } %>

        <% } else if (activeSection === 'employees') { %>
            <!-- Employees Management Section — agencies only -->
            <% if (isAgency) { %>
            <%- include('../../organisms/datatable/employees-table', {
                tableId: 'client-employees-table',
                clientId: clientId,
                apiEndpoint: `/api/clients/${clientId}/employees`,
                userRole: typeof userRole !== 'undefined' ? userRole : 'admin',
                showActions: true
            }) %>
            <% } else { %>
            <div class="alert alert-info mb-0"><i class="ti ti-info-circle me-2"></i>Solo las agencias tienen agentes.</div>
            <% } %>
        <% } else if (activeSection === 'quotes') { %>
            <!-- Trips: read-only quotes/reservations linked to this client. Loaded via AJAX. -->
            <div class="card border-0 shadow-sm" id="tripsRoot" data-client-id="<%= clientId %>"<% if (clientData.isAmexingUser) { %> data-owner-base="/api/agents/<%= clientId %>"<% } %>>
                <div class="card-header bg-white"><h5 class="mb-0"><i class="ti ti-plane me-2 text-primary"></i>Trips</h5></div>
                <div class="card-body"><div id="tripsContainer"><p class="text-muted mb-0">Cargando…</p></div></div>
            </div>
            <%- include('./sections/client-trips-section') %>
        <% } else if (activeSection === 'tarifario') { %>
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom-0">
                    <h5 class="mb-0"><i class="ti ti-receipt-2 me-2 text-primary"></i>Tarifario del Cliente</h5>
                    <p class="text-muted small mb-0 mt-1">Gestiona los servicios específicos para este cliente</p>
                </div>
                
                <!-- Tab Navigation -->
                <div class="tarifario-tabs border-bottom">
                    <nav class="nav nav-tabs border-0" id="tarifario-nav" role="tablist">
                        <% tarifarioTabs.forEach(function(tab, index) { %>
                            <button class="nav-link <%= (activeSubsection === tab.subsection) || (index === 0 && !activeSubsection) ? 'active' : '' %>" 
                                    id="<%= tab.subsection %>-tab" 
                                    data-bs-toggle="tab" 
                                    data-bs-target="#<%= tab.subsection %>-pane" 
                                    type="button" 
                                    role="tab" 
                                    aria-controls="<%= tab.subsection %>-pane" 
                                    aria-selected="<%= (activeSubsection === tab.subsection) || (index === 0 && !activeSubsection) ? 'true' : 'false' %>">
                                <i class="ti ti-<%= tab.icon %> me-2"></i>
                                <%= tab.label %>
                            </button>
                        <% }); %>
                    </nav>
                </div>
                
                <!-- Tab Content -->
                <div class="card-body p-0">
                    <div class="tab-content" id="tarifario-content">
                        <% tarifarioTabs.forEach(function(tab, index) { %>
                            <div class="tab-pane fade <%= (activeSubsection === tab.subsection) || (index === 0 && !activeSubsection) ? 'show active' : '' %>" 
                                 id="<%= tab.subsection %>-pane" 
                                 role="tabpanel" 
                                 aria-labelledby="<%= tab.subsection %>-tab" 
                                 tabindex="0">
                                
                                <div class="p-4">
                                    <% if (tab.subsection === 'vehicles') { %>
                                        <!-- Vehicle Types Section -->
                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <div>
                                                <h4 class="fw-bold text-dark mb-1">
                                                    <i class="ti ti-car me-2 text-primary"></i>Tipos de Vehículos
                                                </h4>
                                                <p class="text-muted mb-0">Gestiona los tipos de vehículos disponibles para <%= companyName %></p>
                                            </div>
                                            <button class="btn btn-primary" onclick="loadVehicleTypes()">
                                                <i class="ti ti-refresh me-1"></i>Actualizar
                                            </button>
                                        </div>

                                        <!-- Loading State -->
                                        <div id="vehicle-types-loading" class="text-center py-5">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Cargando tipos de vehículos...</span>
                                            </div>
                                            <p class="text-muted mt-2">Cargando tipos de vehículos...</p>
                                        </div>

                                        <!-- Vehicle Types DataTable -->
                                        <div id="vehicle-types-container" class="d-none">
                                            <div class="table-responsive">
                                                <table id="vehicleTypesTable" class="table table-striped table-hover">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Nombre</th>
                                                            <th>Capacidad</th>
                                                            <th>Carry-on</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <!-- Data will be loaded via DataTables Ajax -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- Empty State -->
                                        <div id="vehicle-types-empty" class="text-center py-5 d-none">
                                            <i class="ti ti-car-off" style="font-size: 3rem; color: #d1d5db;"></i>
                                            <h5 class="mt-3 text-muted">No hay tipos de vehículos</h5>
                                            <p class="text-muted">No se encontraron tipos de vehículos disponibles.</p>
                                        </div>

                                        <!-- Error State -->
                                        <div id="vehicle-types-error" class="text-center py-5 d-none">
                                            <i class="ti ti-alert-circle" style="font-size: 3rem; color: #dc3545;"></i>
                                            <h5 class="mt-3 text-danger">Error al cargar</h5>
                                            <p class="text-muted mb-3">No se pudieron cargar los tipos de vehículos.</p>
                                            <button class="btn btn-outline-primary" onclick="loadVehicleTypes()">
                                                <i class="ti ti-refresh me-1"></i>Intentar de nuevo
                                            </button>
                                        </div>
                                    <% } else if (tab.subsection === 'tours') { %>
                                        <!-- Tours Section -->
                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <div>
                                                <h4 class="fw-bold text-dark mb-1">
                                                    <i class="ti ti-map me-2 text-primary"></i>Tours Disponibles
                                                </h4>
                                                <p class="text-muted mb-0">Tours configurados para tarifas de <%= companyName %></p>
                                            </div>
                                        </div>
                                        <!-- Include Tours Table Organism -->
                                        <div data-client-id="<%= clientId %>">
                                            <%- include('../../organisms/datatable/tours-table', {
                                                tableId: 'client-tours-table',
                                                apiEndpoint: `/api/tours?clientId=${clientId}`,
                                                userRole: 'client',
                                                showActions: false,
                                                showClientPricing: true,
                                                clientId: clientId
                                            }) %>
                                        </div>
                                    <% } else if (tab.subsection === 'experiences') { %>
                                        <!-- Experiences Section -->
                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <div>
                                                <h4 class="fw-bold text-dark mb-1">
                                                    <i class="ti ti-star me-2 text-primary"></i>Experiencias Disponibles
                                                </h4>
                                                <p class="text-muted mb-0">Gestiona las experiencias disponibles para <%= companyName %></p>
                                            </div>
                                            <button class="btn btn-primary" onclick="loadExperiences()">
                                                <i class="ti ti-refresh me-1"></i>Actualizar
                                            </button>
                                        </div>
                                        <!-- Loading State -->
                                        <div id="experiences-loading" class="text-center py-5">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Cargando experiencias...</span>
                                            </div>
                                            <p class="text-muted mt-2">Cargando experiencias...</p>
                                        </div>
                                        <!-- Experiences DataTable -->
                                        <div id="experiences-container" class="d-none">
                                            <!-- Filter Controls -->
                                            <div class="d-flex justify-content-end align-items-center mb-3">
                                                <!-- Trailing Dropdowns -->
                                                <div class="d-flex gap-2 align-items-center">
                                                    <!-- Currency Dropdown -->
                                                    <div class="d-flex align-items-center gap-1">
                                                        <label for="experiencesCurrencyFilter" class="form-label mb-0 text-muted">Moneda:</label>
                                                        <select class="form-select" id="experiencesCurrencyFilter" style="min-width: 100px;">
                                                            <option value="MXN" selected>MXN</option>
                                                            <option value="USD">USD</option>
                                                        </select>
                                                    </div>

                                                    <!-- Payment Type Dropdown -->
                                                    <div class="d-flex align-items-center gap-1">
                                                        <label for="experiencesPaymentTypeFilter" class="form-label mb-0 text-muted">Pago:</label>
                                                        <select class="form-select" id="experiencesPaymentTypeFilter" style="min-width: 140px;">
                                                            <option value="efectivo" selected>Efectivo</option>
                                                            <option value="transferencia">Transferencia</option>
                                                            <option value="tarjeta">Tarjeta Débito/Crédito</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="table-responsive">
                                                <table id="experiencesTable" class="table table-striped table-hover">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th style="width: 20%;">Nombre</th>
                                                            <th style="width: 30%;">Descripción</th>
                                                            <th style="width: 15%;">Duración</th>
                                                            <th style="width: 15%;">Precio</th>
                                                            <th style="width: 20%;">Precio Cliente</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <!-- Data will be loaded via DataTables Ajax -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <!-- Empty State -->
                                        <div id="experiences-empty" class="text-center py-5 d-none">
                                            <i class="ti ti-star-off" style="font-size: 3rem; color: #d1d5db;"></i>
                                            <h5 class="mt-3 text-muted">No hay experiencias</h5>
                                            <p class="text-muted">No se encontraron experiencias disponibles.</p>
                                        </div>
                                        <!-- Error State -->
                                        <div id="experiences-error" class="text-center py-5 d-none">
                                            <i class="ti ti-alert-circle" style="font-size: 3rem; color: #dc3545;"></i>
                                            <h5 class="mt-3 text-danger">Error al cargar</h5>
                                            <p class="text-muted mb-3">No se pudieron cargar las experiencias.</p>
                                            <button class="btn btn-outline-primary" onclick="loadExperiences()">
                                                <i class="ti ti-refresh me-1"></i>Intentar de nuevo
                                            </button>
                                        </div>
                                    <% } else if (tab.subsection === 'services') { %>
                                        <!-- Services Section -->
                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <div>
                                                <h4 class="fw-bold text-dark mb-1">
                                                    <i class="ti ti-briefcase me-2 text-primary"></i>Traslados Disponibles
                                                </h4>
                                                <p class="text-muted mb-0">Servicios de traslado configurados para <%= companyName %></p>
                                            </div>
                                        </div>
                                        <!-- Include Services Table Organism -->
                                        <div data-client-id="<%= clientId %>">
                                            <%- include('../../organisms/datatable/services-table', {
                                                tableId: 'client-services-table',
                                                apiEndpoint: '/api/services?clientId=' + clientId,
                                                userRole: 'client',
                                                showActions: false,
                                                showClientPricing: true,
                                                clientId: clientId
                                            }) %>
                                        </div>
                                    <% } else { %>
                                        <!-- Other tabs placeholder -->
                                        <div class="text-center py-5">
                                            <div class="tarifario-icon-container mb-3">
                                                <i class="ti ti-<%= tab.icon %>" style="font-size: 3.5rem; color: var(--brand-primary-active);"></i>
                                            </div>
                                            <h4 class="fw-bold text-dark mb-2"><%= tab.label %></h4>
                                            <p class="text-muted mb-4">Gestión personalizada de <%= tab.label.toLowerCase() %> para <%= companyName %></p>
                                            
                                            <div class="row g-3 justify-content-center">
                                                <div class="col-sm-6 col-md-4">
                                                    <div class="tarifario-action-card">
                                                        <i class="ti ti-plus-circle action-icon text-success"></i>
                                                        <h6 class="mt-2 mb-1">Crear Nuevo</h6>
                                                        <p class="text-muted small mb-0">Añadir <%= tab.label.toLowerCase() %> personalizado</p>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6 col-md-4">
                                                    <div class="tarifario-action-card">
                                                        <i class="ti ti-list action-icon text-primary"></i>
                                                        <h6 class="mt-2 mb-1">Ver Catálogo</h6>
                                                        <p class="text-muted small mb-0">Explorar <%= tab.label.toLowerCase() %> disponibles</p>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6 col-md-4">
                                                    <div class="tarifario-action-card">
                                                        <i class="ti ti-settings action-icon text-warning"></i>
                                                        <h6 class="mt-2 mb-1">Configurar</h6>
                                                        <p class="text-muted small mb-0">Ajustar precios y condiciones</p>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="mt-4">
                                                <button class="btn btn-primary me-2">
                                                    <i class="ti ti-plus me-1"></i>Crear <%= tab.label %>
                                                </button>
                                                <button class="btn btn-outline-secondary">
                                                    <i class="ti ti-eye me-1"></i>Ver Existentes
                                                </button>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>

<style>
/* Horizontal Client Nav Tabs */
.client-nav-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 2px solid rgba(var(--brand-primary-rgb), 0.15);
    overflow-x: auto;
}

.client-nav-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    color: var(--brand-primary-active);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0.5rem 0.5rem 0 0;
    background: transparent;
    transition: all 0.2s ease;
}

.client-nav-tab i {
    font-size: 1.1rem;
}

.client-nav-tab:hover {
    color: var(--brand-primary-active);
    background: rgba(var(--brand-primary-rgb), 0.1);
}

.client-nav-tab.active {
    color: white;
    font-weight: 600;
    background: var(--brand-gradient);
    border-bottom-color: var(--brand-primary);
}

/* Tarifario Tabs Styles */
.tarifario-tabs {
    background: #f8f9fa;
    padding: 0 1.5rem;
}

.tarifario-tabs .nav-tabs {
    border: none;
}

.tarifario-tabs .nav-link {
    border: none;
    color: #6c757d;
    font-weight: 500;
    padding: 1rem 1.5rem;
    margin-right: 0.5rem;
    border-radius: 0.5rem 0.5rem 0 0;
    background: transparent;
    transition: all 0.3s ease;
    position: relative;
}

.tarifario-tabs .nav-link:hover {
    color: var(--brand-primary-active);
    background: rgba(var(--brand-primary-rgb), 0.1);
}

.tarifario-tabs .nav-link.active {
    color: var(--brand-primary-active);
    background: white;
    border-bottom: 2px solid var(--brand-primary);
    box-shadow: 0 -2px 8px rgba(0,0,0,0.1);
}

.tarifario-tabs .nav-link i {
    font-size: 1.1rem;
}

/* Tarifario Action Cards */
.tarifario-action-card {
    background: white;
    border: 1px solid #e9ecef;
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
    height: 100%;
}

.tarifario-action-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    border-color: var(--brand-primary);
}

.tarifario-action-card .action-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

.tarifario-action-card h6 {
    font-weight: 600;
    color: #343a40;
}

.tarifario-icon-container {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(var(--brand-primary-rgb), 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
}

/* Tab Content Styling */
.tab-content {
    background: white;
}

.tab-pane {
    min-height: 400px;
}

/* DataTable Custom Styles */
#vehicleTypesTable {
    font-size: 0.875rem;
    width: 100% !important;
}

#vehicleTypesTable thead th {
    background: #f8f9fa;
    font-weight: 600;
    color: #495057;
    border-bottom: 2px solid #dee2e6;
