                        <i class="ti ti-key text-warning" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="mb-3">¿Generar nueva contraseña?</h5>
                    <p class="text-muted mb-3">
                        Se generará una nueva contraseña segura para:<br>
                        <strong><%= clientData.firstName %> <%= clientData.lastName %></strong><br>
                        <span class="text-muted small"><%= clientData.email %></span>
                    </p>
                </div>

                <!-- Security Warning -->
                <div class="alert alert-warning d-flex align-items-start">
                    <i class="ti ti-alert-triangle me-2 flex-shrink-0 mt-1"></i>
                    <div>
                        <strong>Importante:</strong> La contraseña actual será invalidada inmediatamente. 
                        Asegúrese de compartir la nueva contraseña de forma segura con el cliente.
                    </div>
                </div>

                <!-- Success Display (Hidden initially) -->
                <div id="passwordSuccessDisplay" class="d-none">
                    <div class="alert alert-success">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="mb-0">
                                <i class="ti ti-check-circle me-1 text-success"></i>
                                Nueva contraseña generada
                            </h6>
                            <span class="badge bg-success">Exitoso</span>
                        </div>
                        
                        <div class="bg-light rounded p-3 mb-3">
                            <label class="form-label small text-muted mb-2">Contraseña temporal:</label>
                            <div class="d-flex align-items-center">
                                <code id="generatedPasswordDisplay" class="flex-grow-1 me-2 fs-5 text-primary"></code>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="copyPasswordButton">
                                    <i class="ti ti-copy me-1"></i>Copiar
