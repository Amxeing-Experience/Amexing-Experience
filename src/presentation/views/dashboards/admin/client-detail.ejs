    /**
     * Live validation functions
     */
    
    // Real-time validation rules
    const validationRules = {
        firstName: {
            required: true,
            minLength: 2,
            maxLength: 50,
            pattern: /^[a-zA-ZÀ-ÿ\u00f1\u00d1\s'-]+$/,
            message: 'El nombre debe tener entre 2-50 caracteres y solo contener letras'
        },
        lastName: {
            required: true,
            minLength: 2,
            maxLength: 50,
            pattern: /^[a-zA-ZÀ-ÿ\u00f1\u00d1\s'-]+$/,
            message: 'El apellido debe tener entre 2-50 caracteres y solo contener letras'
        },
        email: {
            required: true,
            pattern: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
            message: 'Debe ingresar un email válido'
        },
        companyName: {
            required: true,
            minLength: 2,
            maxLength: 100,
            message: 'El nombre de la empresa debe tener entre 2-100 caracteres'
        },
        phone: {
            required: false,
            pattern: /^[+]?[\d\s()-]{10,15}$/,
            message: 'Formato de teléfono inválido (ej: +52 999 123 4567)'
        },
        taxId: {
            required: false,
            pattern: /^[A-Z&Ñ]{3}[0-9]{2}(0[1-9]|1[012])(0[1-9]|[12][0-9]|3[01])[A-Z0-9]{3}$|^[A-Z&Ñ]{4}[0-9]{2}(0[1-9]|1[012])(0[1-9]|[12][0-9]|3[01])[A-Z0-9]{3}$/,
            message: 'Formato de RFC inválido. Personas Morales: 12 chars (ej: ABC123456789), Personas Físicas: 13 chars (ej: MALJ850101ABC)'
        },
        website: {
            required: false,
            pattern: /^https?:\/\/(www\.)?[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]*)$/,
            message: 'URL inválida (debe comenzar con http:// o https://)'
        },
        zipCode: {
            required: false,
            pattern: /^[0-9]{5}$/,
            message: 'Código postal debe tener 5 dígitos'
        }
    };

    /**
     * Validate a single field
     */
    function validateField(fieldName, value) {
        const rules = validationRules[fieldName];
        if (!rules) return { isValid: true };

        const trimmedValue = (value || '').trim();
        
        // Required field validation
        if (rules.required && !trimmedValue) {
            return {
                isValid: false,
                message: `Este campo es obligatorio`
            };
        }

        // Skip other validations if field is empty and not required
        if (!trimmedValue && !rules.required) {
            return { isValid: true };
        }

        // Length validation
        if (rules.minLength && trimmedValue.length < rules.minLength) {
            return {
                isValid: false,
                message: rules.message || `Debe tener al menos ${rules.minLength} caracteres`
            };
        }

        if (rules.maxLength && trimmedValue.length > rules.maxLength) {
            return {
                isValid: false,
                message: rules.message || `No puede exceder ${rules.maxLength} caracteres`
            };
        }

        // Pattern validation
        if (rules.pattern && !rules.pattern.test(trimmedValue)) {
            return {
                isValid: false,
                message: rules.message
            };
        }

        return { isValid: true };
    }

    /**
     * Show validation feedback for a field
     */
    function showFieldValidation(fieldId, validation) {
        const field = document.getElementById(fieldId);
        const container = field.closest('.mb-3');
        
        // Remove existing validation classes and messages
        field.classList.remove('is-valid', 'is-invalid');
        const existingFeedback = container.querySelector('.invalid-feedback, .valid-feedback');
        if (existingFeedback) {
            existingFeedback.remove();
        }

        if (!validation.isValid) {
            // Show error state
            field.classList.add('is-invalid');
            const feedback = document.createElement('div');
            feedback.className = 'invalid-feedback';
            feedback.innerHTML = `<i class="ti ti-alert-circle me-1"></i>${validation.message}`;
            container.appendChild(feedback);
        } else if (field.value.trim()) {
            // Show success state for non-empty valid fields
            field.classList.add('is-valid');
            const feedback = document.createElement('div');
            feedback.className = 'valid-feedback';
            feedback.innerHTML = `<i class="ti ti-check me-1"></i>Válido`;
            container.appendChild(feedback);
        }
    }

    /**
     * Setup live validation for the edit form
     */
    function setupLiveValidation() {
        const form = document.getElementById('editClientForm');
        if (!form) return;

        // Fields to validate
        const fieldsToValidate = [
            'editFirstName',
            'editLastName',
            'editEmail',
            'editCompanyName',
            'editPhone',
            'editTaxId',
            'editWebsite',
            'editZipCode'
        ];

        fieldsToValidate.forEach(fieldId => {
            const field = document.getElementById(fieldId);
            if (!field) return;

            // Map field IDs to validation rule names
            const ruleMap = {
                'editFirstName': 'firstName',
                'editLastName': 'lastName',
                'editCompanyName': 'companyName',
                'editPhone': 'phone',
                'editTaxId': 'taxId',
                'editWebsite': 'website',
                'editZipCode': 'zipCode'
            };

            const ruleName = ruleMap[fieldId];

            // Add event listeners for real-time validation
            field.addEventListener('input', debounce((e) => {
                const validation = validateField(ruleName, e.target.value);
                showFieldValidation(fieldId, validation);
                updateSaveButtonState();
            }, 300));

            field.addEventListener('blur', (e) => {
                const validation = validateField(ruleName, e.target.value);
                showFieldValidation(fieldId, validation);
                updateSaveButtonState();
            });
        });
    }

    /**
     * Check if form is valid and update save button state
     */
    function updateSaveButtonState() {
        const saveButton = document.getElementById('saveClientChanges');
        if (!saveButton) return;

        const form = document.getElementById('editClientForm');
        const invalidFields = form.querySelectorAll('.is-invalid');
        const requiredFields = ['editFirstName', 'editLastName', 'editEmail', 'editCompanyName'];
        
        // Check if all required fields have values
        const requiredFieldsValid = requiredFields.every(fieldId => {
            const field = document.getElementById(fieldId);
            return field && field.value.trim();
        });

        // Enable button if no invalid fields and required fields are filled
        const isFormValid = invalidFields.length === 0 && requiredFieldsValid;
        
        saveButton.disabled = !isFormValid;
        
        if (isFormValid) {
            saveButton.classList.remove('btn-secondary');
            saveButton.classList.add('btn-primary');
        } else {
            saveButton.classList.remove('btn-primary');
            saveButton.classList.add('btn-secondary');
        }
    }

    /**
     * Debounce function to limit API calls
     */
    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    /**
     * Update client information via API
     */
    async function updateClient() {
        
        const form = document.getElementById('editClientForm');
        const saveButton = document.getElementById('saveClientChanges');
        
        if (!form || !saveButton) {
            console.error('❌ Form or save button not found');
            return;
        }
        
        
        // Basic validation
        if (!form.checkValidity()) {
            console.warn('⚠️ Form validation failed');
            form.reportValidity();
            return;
        }
        
        
        // Disable button and show loading state
        saveButton.disabled = true;
        const originalContent = saveButton.innerHTML;
        saveButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Guardando...';
        
        // Gather form data
        const formData = {
            firstName: document.getElementById('editFirstName').value.trim(),
            lastName: document.getElementById('editLastName').value.trim(),
            email: document.getElementById('editEmail').value.trim(),
            phone: document.getElementById('editPhone').value.trim() || undefined,
            // Date input value is already YYYY-MM-DD; omit when empty so it doesn't clear an existing date.
            birthDate: document.getElementById('editBirthDate').value || undefined,
            companyName: document.getElementById('editCompanyName').value.trim(),
            taxId: document.getElementById('editTaxId').value.trim() || undefined,
            website: document.getElementById('editWebsite').value.trim() || undefined,
            address: {
                street: document.getElementById('editStreet').value.trim() || undefined,
                city: document.getElementById('editCity').value.trim() || undefined,
                state: document.getElementById('editState').value.trim() || undefined,
                zipCode: document.getElementById('editZipCode').value.trim() || undefined,
                country: document.getElementById('editCountry').value.trim() || undefined
            },
            notes: document.getElementById('editNotes').value.trim() || undefined,
            active: document.getElementById('editActive').value === 'true'
        };
        
        // Get client ID
        const clientId = document.getElementById('editClientId').value;
        
        
        try {
            const response = await fetch(`/api/clients/${clientId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'include',
                body: JSON.stringify(formData)
            });
            
            
            if (!response.ok) {
                const errorText = await response.text();
                console.error('❌ API Error Response:', errorText);
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }
            
            const result = await response.json();
            
            if (!result.success) {
                throw new Error(result.error || 'Error al actualizar el cliente');
            }
            
            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('editClientModal'));
            modal.hide();
            
            // Show success message
            showSuccessMessage('Cliente actualizado exitosamente');
            
            // Reload page after a short delay to show updated data
            setTimeout(() => {
                window.location.reload();
            }, 1500);
            
        } catch (error) {
            console.error('Error updating client:', error);
            showErrorMessage(error.message || 'Error al actualizar el cliente. Por favor, intenta nuevamente.');
        } finally {
            // Restore button state
            saveButton.disabled = false;
            saveButton.innerHTML = originalContent;
        }
    }
    
    /**
     * Show success message
     * @param {string} message - Success message to display
     */
    function showSuccessMessage(message) {
        // Remove existing alerts
        document.querySelectorAll('.floating-alert').forEach(el => el.remove());
        
        const alertHtml = `
            <div class="alert alert-success alert-dismissible fade show floating-alert" role="alert" 
                 style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
                <i class="ti ti-check-circle me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        
        document.body.insertAdjacentHTML('beforeend', alertHtml);
        
        // Auto-dismiss after 5 seconds
        setTimeout(() => {
            const alert = document.querySelector('.floating-alert');
            if (alert) {
                alert.classList.remove('show');
                setTimeout(() => alert.remove(), 150);
            }
        }, 5000);
    }
    
