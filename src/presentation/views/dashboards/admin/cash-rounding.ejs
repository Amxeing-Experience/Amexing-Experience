<!-- Cash Rounding Settings Page -->
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <h2 class="page-title">
                    <i class="ti ti-coin me-2"></i>Configuración de Redondeo para Efectivo
                </h2>
                <p class="text-muted">Administra el redondeo automático de precios cuando se selecciona pago en efectivo.</p>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Current Status Card -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header text-white" style="background: var(--brand-gradient); border: none;">
                    <h5 class="card-title mb-0 text-white">
                        <i class="ti ti-info-circle me-2"></i>Estado Actual
                    </h5>
                </div>
                <div class="card-body">
                    <div id="cashRoundingCurrentStatus" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="text-muted mt-2">Verificando configuración...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Configuration Card -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header text-white" style="background: var(--brand-gradient); border: none;">
                    <h5 class="card-title mb-0 text-white">
                        <i class="ti ti-settings me-2"></i>Configuración
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="fw-semibold mb-3">Redondeo en Efectivo</h6>
                        <p class="text-muted small mb-3">
                            Cuando está habilitado, los precios se redondean automáticamente a múltiplos de $5 MXN cuando el cliente selecciona "Efectivo" como método de pago.
                        </p>
                        
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <label for="cashRoundingToggle" class="form-label mb-0 fw-medium">
                                Habilitar Redondeo
                            </label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="cashRoundingToggle" checked>
                            </div>
                        </div>
                        
                        <button type="button" id="saveCashRoundingSetting" class="btn btn-primary w-100" disabled>
                            <i class="ti ti-device-floppy me-2"></i>Guardar Configuración
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Examples Section -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header text-white" style="background: var(--brand-gradient); border: none;">
                    <h5 class="card-title mb-0 text-white">
                        <i class="ti ti-calculator me-2"></i>Ejemplos de Redondeo
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="fw-semibold text-success mb-3">
                                <i class="ti ti-arrow-down me-1"></i>Redondeo Hacia Abajo (≤ 50 centavos)
                            </h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Precio Original</th>
                                            <th>Precio Redondeado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>$142.30</td><td class="fw-semibold text-success">$140.00</td></tr>
                                        <tr><td>$157.50</td><td class="fw-semibold text-success">$155.00</td></tr>
                                        <tr><td>$98.15</td><td class="fw-semibold text-success">$95.00</td></tr>
                                        <tr><td>$1,052.30</td><td class="fw-semibold text-success">$1,050.00</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-semibold text-info mb-3">
                                <i class="ti ti-arrow-up me-1"></i>Redondeo Hacia Arriba (> 50 centavos)
                            </h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Precio Original</th>
                                            <th>Precio Redondeado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>$142.75</td><td class="fw-semibold text-info">$145.00</td></tr>
                                        <tr><td>$157.80</td><td class="fw-semibold text-info">$160.00</td></tr>
                                        <tr><td>$98.90</td><td class="fw-semibold text-info">$100.00</td></tr>
                                        <tr><td>$1,052.80</td><td class="fw-semibold text-info">$1,055.00</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="alert alert-info d-flex align-items-start">
                                <i class="ti ti-info-circle me-2 mt-1"></i>
                                <div>
                                    <strong>Nota:</strong> El redondeo solo se aplica cuando:
                                    <ul class="mb-0 mt-2">
                                        <li>El método de pago seleccionado es "Efectivo"</li>
                                        <li>La moneda es Pesos Mexicanos (MXN)</li>
                                        <li>Esta configuración está habilitada</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="alert alert-warning d-flex align-items-start">
                                <i class="ti ti-alert-triangle me-2 mt-1"></i>
                                <div>
                                    <strong>Secciones afectadas:</strong>
                                    <ul class="mb-0 mt-2">
                                        <li>A Disposición</li>
                                        <li>Tours (Walking Tours y Vehicle Tours)</li>
                                        <li>Servicios</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Include the cash rounding JavaScript -->
<script src="/dashboards/admin/js/cash-rounding.js"></script>