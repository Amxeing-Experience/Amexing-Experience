    // Single form with all preference categories. Multi categories (PREFERENCE_MULTI) render checkboxes
    // so several can be picked; the rest a dropdown. Filled at once and saved in one PUT.
    function preferencesForm(current = {}) {
        return `<div class="row g-3">${Object.keys(PREFERENCE_CATALOG).map((type, ti) => {
            const cur = current[type] || [];
            if (type === 'Bebida / Alcohol') {
                const hasNo = cur.includes('No toma alcohol');
                const types = cur.filter((o) => o !== 'No toma alcohol' && o !== 'Sí, toma alcohol');
                const yes = !hasNo && (types.length > 0 || cur.includes('Sí, toma alcohol'));
                const boxes = PREFERENCE_CATALOG[type].map((o, oi) => {
                    const id = `pref-alc-${oi}`;
                    return `<div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="${id}" data-pref-multi="${esc(type)}" value="${esc(o)}" ${types.includes(o) ? 'checked' : ''}>
                        <label class="form-check-label small" for="${id}">${esc(o)}</label>
                    </div>`;
                }).join('');
                return `<div class="col-12">
                    <label class="form-label small fw-semibold">${esc(type)}</label>
                    <div class="mb-1">
                        <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="alcoholToggle" id="alcSi" data-alcohol-toggle value="si" ${yes ? 'checked' : ''}><label class="form-check-label small" for="alcSi">Sí toma</label></div>
                        <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="alcoholToggle" id="alcNo" data-alcohol-toggle value="no" ${hasNo ? 'checked' : ''}><label class="form-check-label small" for="alcNo">No toma</label></div>
                    </div>
                    <div data-alcohol-types ${yes ? '' : 'style="display:none"'}>${boxes}</div>
                </div>`;
            }
            if (type === 'Restricción / Alergia') {
                const noneChecked = cur.includes('Ninguna');
                const others = PREFERENCE_CATALOG[type].filter((o) => o !== 'Ninguna');
                // Values not in the catalog are custom "Otra" entries the user typed previously.
                const customVals = cur.filter((o) => o !== 'Ninguna' && !PREFERENCE_CATALOG[type].includes(o));
                const otraChecked = customVals.length > 0;
                const boxes = others.map((o, oi) => {
                    const id = `pref-alg-${oi}`;
                    const isOtra = o === 'Otra (especificar)';
                    const checked = isOtra ? otraChecked : cur.includes(o);
                    const attr = isOtra ? 'data-allergy-otra' : `data-pref-multi="${esc(type)}"`;
                    return `<div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="${id}" ${attr} value="${esc(o)}" ${checked ? 'checked' : ''}>
                        <label class="form-check-label small" for="${id}">${esc(o)}</label>
                    </div>`;
                }).join('');
                return `<div class="col-12">
                    <label class="form-label small fw-semibold">${esc(type)}</label>
                    <div class="form-check mb-1"><input class="form-check-input" type="checkbox" id="algNone" data-allergy-none ${noneChecked ? 'checked' : ''}><label class="form-check-label small" for="algNone">Ninguna</label></div>
                    <div data-allergy-types ${noneChecked ? 'style="display:none"' : ''}>${boxes}
                        <input type="text" class="form-control form-control-sm mt-2" data-allergy-other maxlength="${FIELD_LIMITS.otherText}" placeholder="Especifica cuál" value="${esc(customVals.join(', '))}" ${otraChecked ? '' : 'style="display:none"'}>
                    </div>
                </div>`;
            }
            if (PREFERENCE_MULTI.includes(type)) {
                const boxes = PREFERENCE_CATALOG[type].map((o, oi) => {
                    const id = `pref-${ti}-${oi}`;
                    return `<div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="${id}" data-pref-multi="${esc(type)}" value="${esc(o)}" ${cur.includes(o) ? 'checked' : ''}>
                        <label class="form-check-label small" for="${id}">${esc(o)}</label>
                    </div>`;
                }).join('');
                return `<div class="col-12"><label class="form-label small fw-semibold">${esc(type)}</label><div>${boxes}</div></div>`;
            }
            const sel = cur[0] || '';
            const custom = sel && !PREFERENCE_CATALOG[type].includes(sel) ? `<option value="${esc(sel)}" selected>${esc(sel)}</option>` : '';
            const opts = PREFERENCE_CATALOG[type].map((o) => `<option value="${esc(o)}" ${sel === o ? 'selected' : ''}>${esc(o)}</option>`).join('');
            return `<div class="col-md-6"><label class="form-label small fw-semibold">${esc(type)}</label>
                <select class="form-select" data-pref-single="${esc(type)}"><option value="">— Sin especificar —</option>${custom}${opts}</select></div>`;
        }).join('')}</div>`;
    }

