    // ---------- Generic modal (standard dashboard style: bg-primary header + icon) ----------
    function openModal(title, bodyHtml, onSave, icon = 'edit') {
        let el = document.getElementById('profileModal');
        if (!el) {
            document.body.insertAdjacentHTML('beforeend', `
                <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title text-white"><i class="ti ti-edit me-2" data-modal-icon></i><span data-modal-title></span></h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body"></div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancelar</button>
                                <button type="button" class="btn btn-primary" id="profileModalSave"><i class="ti ti-check me-1"></i>Guardar</button>
                            </div>
                        </div>
                    </div>
                </div>`);
            el = document.getElementById('profileModal');
        }
        el.querySelector('[data-modal-icon]').className = `ti ti-${icon} me-2`;
        el.querySelector('[data-modal-title]').textContent = title;
        el.querySelector('.modal-body').innerHTML = bodyHtml;
        // Country of Issue drives Nationality on every change (user can still override after).
        const ci = el.querySelector('[data-f="countryOfIssue"]');
        const nat = el.querySelector('[data-f="nationality"]');
        if (ci && nat) ci.addEventListener('change', () => { nat.value = COUNTRY_TO_NATIONALITY[ci.value] || ''; });
        // Address: typing the CP looks up Estado + Ciudad (MX/US/CA) via the backend proxy.
        const addrCountry = el.querySelector('[data-f="country"]');
        const addrCp = el.querySelector('[data-f="zipCode"]');
        const cpFeedback = el.querySelector('[data-cp-feedback]');
        if (addrCountry && addrCp) {
            const setFeedback = (msg, cls) => {
                if (cpFeedback) { cpFeedback.textContent = msg; cpFeedback.className = `d-block mt-1 small ${cls}`; }
            };
            const runLookup = async () => {
                const iso = isoFor(addrCountry.value);
                const code = addrCp.value.trim();
                if (!iso || !code) { setFeedback('', ''); return; }
                setFeedback('Buscando…', 'text-muted');
                const data = await lookupPostal(iso, code);
                if (data && (data.state || data.city)) {
                    const st = el.querySelector('[data-f="state"]');
                    const cy = el.querySelector('[data-f="city"]');
                    if (data.state && st) st.value = data.state;
                    if (data.city && cy) cy.value = data.city;
                    // Mexico (SEPOMEX) returns the colonias for the CP → offer them in the datalist.
                    const dl = el.querySelector('#coloniaOptions');
                    const colonias = data.colonias || [];
                    if (dl) dl.innerHTML = colonias.map((co) => `<option value="${esc(co)}"></option>`).join('');
                    const extra = colonias.length ? ` · ${colonias.length} colonia${colonias.length > 1 ? 's' : ''}` : '';
                    setFeedback(`✓ ${[data.city, data.state].filter(Boolean).join(', ')}${extra}`, 'text-success');
                } else {
                    setFeedback('Código postal no encontrado', 'text-warning');
                }
            };
            addrCp.addEventListener('input', () => {
                const rule = postalRule(isoFor(addrCountry.value));
                if (rule.numeric) {
                    const cleaned = addrCp.value.replace(/\D/g, '').slice(0, rule.length || 10);
                    if (cleaned !== addrCp.value) addrCp.value = cleaned;
                    if (cleaned.length === rule.length) runLookup();
                }
            });
            addrCp.addEventListener('change', runLookup);
            addrCountry.addEventListener('change', () => setFeedback('', ''));
        }
        // Alcohol preference: reveal the type checkboxes only when "Sí toma" is selected.
        const alcTypes = el.querySelector('[data-alcohol-types]');
        if (alcTypes) {
            el.querySelectorAll('[data-alcohol-toggle]').forEach((r) => r.addEventListener('change', () => {
                alcTypes.style.display = el.querySelector('[data-alcohol-toggle][value="si"]').checked ? '' : 'none';
            }));
        }
        // Allergies: "Ninguna" hides (and clears) the specific restriction checkboxes.
        const algNone = el.querySelector('[data-allergy-none]');
        const algTypes = el.querySelector('[data-allergy-types]');
        if (algNone && algTypes) {
            algNone.addEventListener('change', () => {
                algTypes.style.display = algNone.checked ? 'none' : '';
                if (algNone.checked) algTypes.querySelectorAll('input[type="checkbox"]').forEach((c) => { c.checked = false; });
            });
        }
        // Allergies: "Otra (especificar)" reveals a textbox to write the specific restriction.
        const algOtra = el.querySelector('[data-allergy-otra]');
        const algOther = el.querySelector('[data-allergy-other]');
        if (algOtra && algOther) {
            algOtra.addEventListener('change', () => {
                algOther.style.display = algOtra.checked ? '' : 'none';
                if (algOtra.checked) algOther.focus(); else algOther.value = '';
            });
        }
        const modal = bootstrap.Modal.getOrCreateInstance(el);
        const saveBtn = el.querySelector('#profileModalSave');
        const fresh = saveBtn.cloneNode(true);
        saveBtn.replaceWith(fresh);
        fresh.addEventListener('click', async () => {
            const values = {};
            el.querySelectorAll('[data-f]').forEach((input) => {
                values[input.dataset.f] = input.type === 'checkbox' ? input.checked : input.value;
            });
            // Address CP validation: only numbers + exact length where the country requires it.
            if (addrCountry && addrCp) {
                const rule = postalRule(isoFor(addrCountry.value));
                const cp = String(values.zipCode || '').trim();
                if (cp && rule.length) {
                    if (rule.numeric && !/^\d+$/.test(cp)) {
                        notify('El código postal solo debe contener números', 'error'); return;
                    }
                    const len = rule.numeric ? cp.length : cp.replace(/\s/g, '').length;
                    if (len !== rule.length) {
                        notify(`El código postal debe tener exactamente ${rule.length} ${rule.numeric ? 'dígitos' : 'caracteres'}`, 'error'); return;
                    }
                }
            }
            // The selected file (if any) is handed to onSave so it can do the second S3 upload step;
            // the create/update request itself stays JSON (no file in the body).
            const fileInput = el.querySelector('[data-f-file]');
            const file = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
            // Lock the button while saving so it can't be submitted twice (no duplicate records).
            const label = fresh.innerHTML;
            fresh.disabled = true;
            fresh.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando…';
            try {
                await onSave(values, file);
                modal.hide();
            } catch (e) {
                notify(e.message, 'error');
            } finally {
                fresh.disabled = false;
                fresh.innerHTML = label;
            }
        });
        // When opened over a parent modal (e.g. the agent profile modal), hide the parent so only
        // this form shows; re-show it once this modal is fully hidden (save or cancel).
        const parentEl = document.querySelector('.modal.show');
        const parentModal = (parentEl && parentEl !== el) ? bootstrap.Modal.getOrCreateInstance(parentEl) : null;
        if (parentModal) parentModal.hide();
        modal.show();
        if (parentModal) el.addEventListener('hidden.bs.modal', () => parentModal.show(), { once: true });
    }

    // ---------- Wiring ----------
    document.getElementById('addPassportBtn')?.addEventListener('click', () => {
        openModal('Agregar Pasaporte', passportForm(), async (v, file) => {
            const { passport } = await api('/passports', 'POST', v);
            // Document is uploaded as a second multipart step against the new passport's id.
            if (file) await uploadPassportDocument(passport.id, file);
            notify('Pasaporte creado'); loadPassports();
        }, 'id');
    });
    document.getElementById('addAddressBtn')?.addEventListener('click', () => {
        openModal('Agregar Dirección', addressForm(), async (v) => { await api('/addresses', 'POST', v); notify('Dirección creada'); loadAddresses(); }, 'map-pin');
    });
    document.getElementById('addPreferenceBtn')?.addEventListener('click', () => {
        const grouped = document.getElementById('preferencesContainer')._grouped || {};
        openModal('Preferencias de viaje', preferencesForm(grouped), async () => {
            const modal = document.getElementById('profileModal');
            const preferences = [];
            modal.querySelectorAll('[data-pref-single]').forEach((sel) => {
                if (sel.value) preferences.push({ type: sel.dataset.prefSingle, option: sel.value });
            });
            modal.querySelectorAll('[data-pref-multi]:checked').forEach((cb) => {
                if (cb.dataset.prefMulti === 'Bebida / Alcohol') return; // handled via the Sí/No toggle
                preferences.push({ type: cb.dataset.prefMulti, option: cb.value });
            });
            // Alcohol: No → "No toma alcohol"; Sí → checked types (or "Sí, toma alcohol" if none).
            const alc = modal.querySelector('[data-alcohol-toggle]:checked');
            if (alc && alc.value === 'no') {
                preferences.push({ type: 'Bebida / Alcohol', option: 'No toma alcohol' });
            } else if (alc && alc.value === 'si') {
                const types = [...modal.querySelectorAll('[data-pref-multi="Bebida / Alcohol"]:checked')].map((c) => c.value);
                if (types.length) types.forEach((o) => preferences.push({ type: 'Bebida / Alcohol', option: o }));
                else preferences.push({ type: 'Bebida / Alcohol', option: 'Sí, toma alcohol' });
            }
            // Allergies: "Ninguna" → only Ninguna; otherwise specific restrictions (from the multi loop)
            // plus the free-text "Otra (especificar)" value when provided.
            const algNoneEl = modal.querySelector('[data-allergy-none]');
            if (algNoneEl && algNoneEl.checked) {
                preferences.push({ type: 'Restricción / Alergia', option: 'Ninguna' });
            } else {
                const algOtherEl = modal.querySelector('[data-allergy-other]');
                if (algOtherEl && algOtherEl.value.trim()) {
                    preferences.push({ type: 'Restricción / Alergia', option: algOtherEl.value.trim() });
                }
            }
            await api('/travel-preferences', 'PUT', { preferences });
            notify('Preferencias guardadas'); loadPreferences();
        }, 'plane');
    });
    document.getElementById('addLoyaltyBtn')?.addEventListener('click', () => {
        const box = document.getElementById('loyaltyContainer');
        if (!box) return;
        box._editing = true;
        renderLoyalty();
        const rows = box.querySelector('[data-loyalty-rows]');
        if (rows) rows.insertAdjacentHTML('beforeend', loyaltyRow());
    });
    // Documents: only ~2 fields (tipo + archivo) → render the form inline in the card, not a modal.
    // openDocumentForm(null) = add; openDocumentForm(doc) = edit (prefilled, file optional). Same edit
    // capability as the passport, kept inline per the 2-field rule.
    function openDocumentForm(doc) {
        const wrap = document.getElementById('documentFormWrap');
        if (!wrap) return;
        // Re-clicking "Agregar" while the add form is open toggles it closed.
        if (!doc && wrap.style.display !== 'none' && wrap.dataset.mode === 'add') {
            wrap.style.display = 'none'; wrap.innerHTML = ''; wrap.dataset.mode = ''; return;
        }
        wrap.dataset.mode = doc ? 'edit' : 'add';
        wrap.innerHTML = `${documentForm(!!doc)}
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-sm btn-secondary" data-doc-cancel><i class="ti ti-x me-1"></i>Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary" data-doc-submit><i class="ti ti-${doc ? 'check' : 'upload'} me-1"></i>${doc ? 'Guardar' : 'Subir'}</button>
            </div>`;
        if (doc) {
            const labelInput = wrap.querySelector('[data-f="label"]');
            if (labelInput) labelInput.value = doc.customLabel || doc.label || '';
        }
        wrap.style.display = '';
        wrap.querySelector('[data-doc-cancel]')?.addEventListener('click', () => {
            wrap.style.display = 'none'; wrap.innerHTML = ''; wrap.dataset.mode = '';
        });
        const submitBtn = wrap.querySelector('[data-doc-submit]');
        submitBtn?.addEventListener('click', async () => {
            const values = {};
            wrap.querySelectorAll('[data-f]').forEach((i) => { values[i.dataset.f] = i.value; });
            const fileInput = wrap.querySelector('[data-f-file]');
            const file = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
            const original = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando…';
            try {
                if (doc) await updateDocument(doc.id, values, file);
                else await uploadDocument(values, file);
                notify(doc ? 'Documento actualizado' : 'Documento subido');
                wrap.style.display = 'none'; wrap.innerHTML = ''; wrap.dataset.mode = '';
                loadDocuments();
            } catch (err) {
                notify(err.message, 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = original;
            }
        });
    }
    document.getElementById('addDocumentBtn')?.addEventListener('click', () => openDocumentForm(null));

    root.addEventListener('click', async (e) => {
        const btn = e.target.closest('button'); if (!btn) return;
        try {
            if (btn.dataset.revealPp) {
                const span = document.querySelector(`[data-pp-mask="${btn.dataset.revealPp}"]`);
                const icon = btn.querySelector('i');
                // Toggle on an explicit flag (not the icon class, which can desync).
                if (btn.dataset.revealed === '1') {
                    span.textContent = span.dataset.masked;
                    icon.className = 'ti ti-eye-off';
                    btn.dataset.revealed = '0';
                } else if (btn.dataset.revealing !== '1') {
                    // Each reveal hits the server (PCI-protected number). Disable the button
                    // while in flight so spamming the eye can't fire a burst of /reveal requests;
                    // re-enabled in finally so it stays clickable to re-mask.
                    btn.dataset.revealing = '1';
                    btn.disabled = true;
                    try {
                        if (!span.dataset.masked) span.dataset.masked = span.textContent;
                        const { number } = await api(`/passports/${btn.dataset.revealPp}/reveal`, 'POST');
                        span.textContent = number;
                        icon.className = 'ti ti-eye';
                        btn.dataset.revealed = '1';
                    } finally {
                        btn.dataset.revealing = '';
                        btn.disabled = false;
                    }
                }
            } else if (btn.dataset.editPp) {
                const p = (document.getElementById('passportsContainer')._data || []).find((x) => x.id === btn.dataset.editPp);
                openModal('Editar Pasaporte', passportForm(p), async (v, file) => {
                    await api(`/passports/${p.id}`, 'PUT', v);
                    if (file) await uploadPassportDocument(p.id, file);
                    notify('Pasaporte actualizado'); loadPassports();
                }, 'id');
            } else if (btn.dataset.delPp) {
                if (await confirmDanger('¿Eliminar este pasaporte? Esta acción no se puede deshacer.')) { await api(`/passports/${btn.dataset.delPp}`, 'DELETE'); notify('Pasaporte eliminado correctamente'); loadPassports(); }
            } else if (btn.dataset.editDoc) {
                const d = (document.getElementById('documentsContainer')._data || []).find((x) => x.id === btn.dataset.editDoc);
                if (d) openDocumentForm(d);
            } else if (btn.dataset.delDoc) {
                if (await confirmDanger('¿Eliminar este documento? Esta acción no se puede deshacer.')) { await api(`/documents/${btn.dataset.delDoc}`, 'DELETE'); notify('Documento eliminado correctamente'); loadDocuments(); }
            } else if (btn.dataset.fav) { await api(`/addresses/${btn.dataset.fav}`, 'PUT', { isFavorite: true }); loadAddresses(); }
            else if (btn.dataset.editAddr) {
                const a = (document.getElementById('addressesContainer')._data || []).find((x) => x.id === btn.dataset.editAddr);
                openModal('Editar Dirección', addressForm(a), async (v) => { await api(`/addresses/${a.id}`, 'PUT', v); notify('Dirección actualizada'); loadAddresses(); }, 'map-pin');
            } else if (btn.dataset.delAddr) {
                if (await confirmDanger('¿Eliminar esta dirección?')) { await api(`/addresses/${btn.dataset.delAddr}`, 'DELETE'); notify('Dirección eliminada correctamente'); loadAddresses(); }
            } else if (btn.dataset.loyaltyEdit) {
                const box = document.getElementById('loyaltyContainer');
                box._editing = true; renderLoyalty();
            } else if (btn.dataset.loyaltyDel) {
                btn.closest('[data-loyalty-row]')?.remove();
            } else if (btn.dataset.loyaltySave) {
                const box = document.getElementById('loyaltyContainer');
                const list = [...box.querySelectorAll('[data-loyalty-row]')].map((r) => ({
                    type: (r.querySelector('[data-l-type]').value || '').trim(),
                    number: (r.querySelector('[data-l-number]').value || '').trim(),
                })).filter((p) => p.type);
                await saveLoyalty(list); box._data = list; box._editing = false; renderLoyalty(); notify('Programas de lealtad guardados');
            }
        } catch (err) { notify(err.message, 'error'); }
    });

    loadPassports();
    loadAddresses();
    loadPreferences();
    loadLoyalty();
    loadDocuments();
};

// Auto-init for the client detail page (the agent modal calls initProfileSection itself).
(function () {
    const root = document.getElementById('profileRoot');
    if (root) window.initProfileSection(root);
})();
</script>
