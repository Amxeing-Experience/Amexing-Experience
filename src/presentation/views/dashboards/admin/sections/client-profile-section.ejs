<%
// Curated travel-preference catalog. Categories and options informed by industry practice (luxury
// travel concierge profiles, IATA airline seat/special-meal SSR codes, luxury-hotel guest preference
// profiles) plus the experiences Amexing offers. The option field is a datalist, so the team can also
// type a custom value not in the list.
const PREFERENCE_CATALOG = {
  'Asiento (avión)': ['Ventana', 'Pasillo', 'En medio', 'Espacio extra para piernas', 'Adelante', 'Atrás', 'Sin preferencia'],
  'Clase de vuelo': ['Turista', 'Turista premium', 'Ejecutiva (Business)', 'Primera clase'],
  'Tipo de comida': ['Mexicana', 'Internacional', 'Mariscos', 'Italiana', 'Asiática', 'Japonesa', 'Cortes / Carnes', 'Vegetariana', 'Vegana', 'Alta cocina', 'Fusión', 'Tradicional', 'Saludable'],
  'Restricción / Alergia': ['Ninguna', 'Sin gluten', 'Sin lácteos', 'Sin nueces', 'Sin mariscos', 'Vegetariano', 'Vegano', 'Kosher', 'Halal', 'Diabética', 'Otra (especificar)'],
  'Bebida / Alcohol': ['Vino', 'Cerveza', 'Cócteles', 'Tequila / Mezcal', 'Whisky', 'Champaña / Espumosos'],
  'Interés / Experiencia': ['Cata de vinos / Viñedos', 'Gastronomía', 'Aventura', 'Tours culturales / históricos', 'Bienestar / Spa', 'Vida nocturna', 'Naturaleza', 'Arte', 'Fotografía', 'Compras', 'Golf', 'Playa', 'Transporte ejecutivo'],
  'Vehículo preferido': ['Sedán', 'SUV', 'Suburban', 'Eléctrico'],
  'Idioma preferido': ['Español', 'Inglés', 'Francés', 'Alemán', 'Italiano', 'Portugués'],
};

// Predefined client-document labels (kept in sync with src/domain/models/ClientDocument.js
// DOCUMENT_LABELS). Shown as datalist suggestions only — the admin types the document type by hand,
// so any document not covered by these tags is allowed.
const DOCUMENT_LABELS = ['Identificación oficial (INE)', 'Pasaporte', 'Visa', 'Comprobante de pago',
  'Boletos / pase de abordar', 'Voucher / confirmación de reserva', 'Seguro de viaje',
  'Datos fiscales (RFC)', 'Otro documento'];
%>
<style>
    #profileModal .form-control, #profileModal .form-select,
    #agentProfileModal .form-control, #agentProfileModal .form-select,
    #profileRoot .form-control, #profileRoot .form-select { color: #1b1b1b; }
    #profileModal .form-control::placeholder,
    #agentProfileModal .form-control::placeholder,
    #profileRoot .form-control::placeholder { color: #6c757d; }
</style>
<script>
// Initialize the profile section for a given root element. Reusable so it can drive both the
// client detail page (#profileRoot) and an injected agent-profile modal (its own root).
window.initProfileSection = function (root) {
    if (!root || root.dataset.profileInit === '1') return;
    root.dataset.profileInit = '1';
    const clientId = root.dataset.clientId;
    // ownerBase lets this section drive either /api/clients/:id (Client) or /api/agents/:id
    // (AmexingUser agent). Falls back to the client base for backward compatibility.
    const base = root.dataset.ownerBase || `/api/clients/${clientId}`;
    const PREFERENCE_CATALOG = <%- JSON.stringify(PREFERENCE_CATALOG) %>;
    const DOCUMENT_LABELS = <%- JSON.stringify(DOCUMENT_LABELS) %>;
    // Categories where the client can pick several options at once (rendered as checkboxes).
    const PREFERENCE_MULTI = ['Tipo de comida', 'Restricción / Alergia', 'Bebida / Alcohol', 'Interés / Experiencia'];

    // Character limit per input TYPE (not per field) — reviewed against each field's real-world content
    // so the cap is sensible. This is the UI guard; persisted values are also trimmed server-side.
    const FIELD_LIMITS = {
        label: 40,          // short tag: "Casa", "Pasaporte 1"
        street: 120,        // full street line: número + calle + interior
        city: 80,           // municipio / ciudad (cubre municipios largos de SEPOMEX)
        state: 60,          // estado / provincia / región
        colonia: 80,        // asentamiento SEPOMEX (puede ser largo)
        postalCode: 10,     // MX/US 5, CA "A1A 1A1" 7; el JS lo acota más por país
        programName: 60,    // programa de lealtad: "Aeroméxico Club Premier"
        membership: 40,     // número de viajero frecuente / membresía
        passportNumber: 14, // los pasaportes son máx ~9-12 caracteres
        otherText: 120,     // texto libre de "Otra (especificar)"
    };

    // Country list for passport dropdowns. México/Estados Unidos/Canadá first (Mexican travel
    // company), then the rest alphabetically.
    const COUNTRIES = ['México', 'Estados Unidos', 'Canadá', 'Alemania', 'Arabia Saudita', 'Argentina',
        'Australia', 'Austria', 'Bélgica', 'Bolivia', 'Brasil', 'Bulgaria', 'Chile', 'China', 'Chipre',
        'Colombia', 'Corea del Sur', 'Costa Rica', 'Croacia', 'Cuba', 'Dinamarca', 'Ecuador', 'Egipto',
        'El Salvador', 'Emiratos Árabes Unidos', 'Eslovaquia', 'Eslovenia', 'España', 'Estonia',
        'Filipinas', 'Finlandia', 'Francia', 'Grecia', 'Guatemala', 'Honduras', 'Hungría', 'India',
        'Indonesia', 'Irlanda', 'Islandia', 'Israel', 'Italia', 'Japón', 'Letonia', 'Lituania',
        'Luxemburgo', 'Malasia', 'Malta', 'Marruecos', 'Nicaragua', 'Noruega', 'Nueva Zelanda',
        'Países Bajos', 'Panamá', 'Paraguay', 'Perú', 'Polonia', 'Portugal', 'Qatar', 'Reino Unido',
        'República Checa', 'República Dominicana', 'Rumania', 'Rusia', 'Singapur', 'Sudáfrica',
        'Suecia', 'Suiza', 'Tailandia', 'Turquía', 'Ucrania', 'Uruguay', 'Venezuela', 'Vietnam'];

    // Maps each country to its Spanish demonym (feminine/neutral form used for "nacionalidad").
    const COUNTRY_TO_NATIONALITY = {
        'México': 'Mexicana', 'Estados Unidos': 'Estadounidense', 'Canadá': 'Canadiense',
        'Alemania': 'Alemana', 'Arabia Saudita': 'Saudí', 'Argentina': 'Argentina',
        'Australia': 'Australiana', 'Austria': 'Austriaca', 'Bélgica': 'Belga', 'Bolivia': 'Boliviana',
        'Brasil': 'Brasileña', 'Bulgaria': 'Búlgara', 'Chile': 'Chilena', 'China': 'China',
        'Chipre': 'Chipriota', 'Colombia': 'Colombiana', 'Corea del Sur': 'Surcoreana',
        'Costa Rica': 'Costarricense', 'Croacia': 'Croata', 'Cuba': 'Cubana', 'Dinamarca': 'Danesa',
        'Ecuador': 'Ecuatoriana', 'Egipto': 'Egipcia', 'El Salvador': 'Salvadoreña',
        'Emiratos Árabes Unidos': 'Emiratí', 'Eslovaquia': 'Eslovaca', 'Eslovenia': 'Eslovena',
        'España': 'Española', 'Estonia': 'Estonia', 'Filipinas': 'Filipina', 'Finlandia': 'Finlandesa',
        'Francia': 'Francesa', 'Grecia': 'Griega', 'Guatemala': 'Guatemalteca', 'Honduras': 'Hondureña',
        'Hungría': 'Húngara', 'India': 'India', 'Indonesia': 'Indonesia', 'Irlanda': 'Irlandesa',
        'Islandia': 'Islandesa', 'Israel': 'Israelí', 'Italia': 'Italiana', 'Japón': 'Japonesa',
        'Letonia': 'Letona', 'Lituania': 'Lituana', 'Luxemburgo': 'Luxemburguesa', 'Malasia': 'Malasia',
        'Malta': 'Maltesa', 'Marruecos': 'Marroquí', 'Nicaragua': 'Nicaragüense', 'Noruega': 'Noruega',
        'Nueva Zelanda': 'Neozelandesa', 'Países Bajos': 'Neerlandesa', 'Panamá': 'Panameña',
        'Paraguay': 'Paraguaya', 'Perú': 'Peruana', 'Polonia': 'Polaca', 'Portugal': 'Portuguesa',
        'Qatar': 'Catarí', 'Reino Unido': 'Británica', 'República Checa': 'Checa',
        'República Dominicana': 'Dominicana', 'Rumania': 'Rumana', 'Rusia': 'Rusa',
        'Singapur': 'Singapurense', 'Sudáfrica': 'Sudafricana', 'Suecia': 'Sueca', 'Suiza': 'Suiza',
        'Tailandia': 'Tailandesa', 'Turquía': 'Turca', 'Ucrania': 'Ucraniana', 'Uruguay': 'Uruguaya',
        'Venezuela': 'Venezolana', 'Vietnam': 'Vietnamita',
    };

    // Nationality options, in the same order as COUNTRIES (México/Estados Unidos/Canadá first).
    const NATIONALITIES = COUNTRIES.map((c) => COUNTRY_TO_NATIONALITY[c]);

    function optionsList(values, current) {
        return values.map((v) => `<option value="${esc(v)}" ${current === v ? 'selected' : ''}>${esc(v)}</option>`).join('');
    }

    function countrySelect(field, current) {
        return `<select class="form-select" data-f="${field}"><option value="">Selecciona…</option>${optionsList(COUNTRIES, current)}</select>`;
    }

    function nationalitySelect(field, current) {
        return `<select class="form-select" data-f="${field}"><option value="">Selecciona…</option>${optionsList(NATIONALITIES, current)}</select>`;
    }

    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Country → ISO code for the postal-code lookup. Only MX/US/CA are covered by the backend proxy.
    const COUNTRY_ISO = { 'México': 'mx', 'Estados Unidos': 'us', 'Canadá': 'ca' };
    const ISO_TO_COUNTRY = { mx: 'México', us: 'Estados Unidos', ca: 'Canadá' };

    function isoFor(country) {
        if (COUNTRY_ISO[country]) return COUNTRY_ISO[country];
        const c = String(country || '').toLowerCase().trim();
        if (/^(m[eé]xico|mx|mex)$/.test(c)) return 'mx';
        if (/^(estados unidos|usa|us|ee\.?\s*uu\.?)$/.test(c)) return 'us';
        if (/^(canad[áa]|ca|can)$/.test(c)) return 'ca';
        return '';
    }

    // Normalize a stored country value to a COUNTRIES option so the <select> preselects it.
    function countryDisplay(c) {
        if (!c) return 'México';
        if (COUNTRIES.includes(c)) return c;
        return ISO_TO_COUNTRY[isoFor(c)] || c;
    }

    // Postal-code rule per supported country: digits-only + exact length (MX/US) or alphanumeric (CA).
    function postalRule(iso) {
        if (iso === 'mx' || iso === 'us') return { numeric: true, length: 5 };
        if (iso === 'ca') return { numeric: false, length: 6 };
        return { numeric: false, length: null };
    }

    // Resolve a postal code to { state, city } via our backend proxy (Zippopotam.us); null if unknown.
    async function lookupPostal(iso, code) {
        if (!iso || !code) return null;
        try {
            const res = await fetch(`/api/geo/postal/${iso}/${encodeURIComponent(code)}`, {
                credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });
            if (!res.ok) return null;
            const json = await res.json();
            return json && json.data ? json.data : null;
        } catch (e) { return null; }
    }

    async function api(path, method = 'GET', body) {
        const res = await fetch(base + path, {
            method,
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: body ? JSON.stringify(body) : undefined,
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error(json.error || `Error ${res.status}`);
        return json.data;
    }

    function notify(msg, kind = 'success') {
        if (typeof window.showSuccessAlert === 'function' && kind === 'success') return window.showSuccessAlert(msg);
        if (typeof window.showErrorAlert === 'function' && kind !== 'success') return window.showErrorAlert(msg);
        alert(msg);
    }

    // Reusable RED danger confirmation modal. Returns a Promise<boolean> (true = confirmed).
    // Built once and reused by id; the confirm button is cloned each open to avoid stacked listeners.
    function confirmDanger(message, confirmLabel = 'Eliminar') {
        let el = document.getElementById('profileConfirmModal');
        if (!el) {
            document.body.insertAdjacentHTML('beforeend', `
                <div class="modal fade" id="profileConfirmModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title text-white"><i class="ti ti-alert-triangle me-2"></i>Confirmar eliminación</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body" data-confirm-body></div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancelar</button>
                                <button type="button" class="btn btn-danger" id="profileConfirmBtn"><i class="ti ti-trash me-1"></i><span data-confirm-label></span></button>
                            </div>
                        </div>
                    </div>
                </div>`);
            el = document.getElementById('profileConfirmModal');
        }
        el.querySelector('[data-confirm-body]').textContent = message;
        el.querySelector('[data-confirm-label]').textContent = confirmLabel;
        const modal = bootstrap.Modal.getOrCreateInstance(el);
        const confirmBtn = el.querySelector('#profileConfirmBtn');
        const fresh = confirmBtn.cloneNode(true);
        confirmBtn.replaceWith(fresh);
        return new Promise((resolve) => {
            let confirmed = false;
            fresh.addEventListener('click', () => { confirmed = true; modal.hide(); });
            el.addEventListener('hidden.bs.modal', () => resolve(confirmed), { once: true });
            modal.show();
        });
    }

    // ---------- Passports ----------
    async function loadPassports() {
        const box = document.getElementById('passportsContainer');
        if (!box) return; // agencies don't render the passports card
        try {
            const { passports } = await api('/passports');
            if (!passports.length) { box.innerHTML = '<p class="text-muted mb-0">Sin pasaportes registrados.</p>'; return; }
            box.innerHTML = passports.map((p) => `
                <div class="border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="fw-semibold">${esc(p.label) || 'Pasaporte'}${p.verified ? '<span class="badge bg-success ms-2"><i class="ti ti-circle-check me-1"></i>Verificado</span>' : '<span class="badge bg-secondary ms-2">Sin verificar</span>'}</div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-light" title="Editar" data-edit-pp="${p.id}"><i class="ti ti-pencil"></i></button>
                            <button class="btn btn-light text-danger" title="Eliminar" data-del-pp="${p.id}"><i class="ti ti-trash"></i></button>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-md-6 mb-2">
                            <label class="form-label text-muted small mb-0">Passport Number</label>
                            <div><span data-pp-mask="${p.id}">${esc(p.numberMasked) || '—'}</span>
                                ${p.hasNumber ? `<button class="btn btn-sm btn-light ms-1" title="Mostrar" data-reveal-pp="${p.id}"><i class="ti ti-eye-off"></i></button>` : ''}
                            </div>
                        </div>
                        ${p.passportDocument ? `<div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Copia del Pasaporte</label><div><a href="${esc(p.passportDocument)}" target="_blank"><i class="ti ti-file me-1"></i>Ver documento</a></div></div>` : ''}
                        <div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Country of Issue</label><div class="text-muted">${esc(p.countryOfIssue) || '—'}</div></div>
                        <div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Nationality</label><div class="text-muted">${esc(p.nationality) || '—'}</div></div>
                        <div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Date of Issue</label><div class="text-muted">${fmtDate(p.dateOfIssue)}</div></div>
                        <div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Expiration Date</label><div class="text-muted">${fmtDate(p.expirationDate)}</div></div>
                    </div>
                </div>`).join('');
            box._data = passports;
        } catch (e) { box.innerHTML = `<p class="text-danger mb-0">${esc(e.message)}</p>`; }
    }

    function fmtDate(v) {
        if (!v) return '—';
        const d = new Date(v); return Number.isNaN(d.getTime()) ? '—' : d.toLocaleDateString('en-US', { dateStyle: 'medium' });
    }

    function dateInput(v) { return v ? new Date(v).toISOString().slice(0, 10) : ''; }
    // Shared date standard (mirrors server utils/dateValidation): issue = past-only, expiry = future-ok.
    const DATE_MIN = '1900-01-01';
    const DATE_MAX_TODAY = new Date().toISOString().slice(0, 10);
    const DATE_MAX_FUTURE = (() => { const d = new Date(); d.setFullYear(d.getFullYear() + 20); return d.toISOString().slice(0, 10); })();

    function passportForm(p = {}) {
        return `
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label small">Etiqueta</label><input class="form-control" data-f="label" maxlength="${FIELD_LIMITS.label}" value="${esc(p.label)}" placeholder="Passport 1"></div>
                <div class="col-md-6"><label class="form-label small">Passport Number</label><input class="form-control" data-f="number" maxlength="${FIELD_LIMITS.passportNumber}" placeholder="${p.hasNumber ? 'Dejar vacío para conservar' : ''}"></div>
                <div class="col-md-6"><label class="form-label small">Country of Issue</label>${countrySelect('countryOfIssue', p.countryOfIssue)}</div>
                <div class="col-md-6"><label class="form-label small">Nationality</label>${nationalitySelect('nationality', p.nationality)}</div>
                <div class="col-md-6"><label class="form-label small">Date of Issue</label><input type="date" class="form-control" data-f="dateOfIssue" min="${DATE_MIN}" max="${DATE_MAX_TODAY}" value="${dateInput(p.dateOfIssue)}"></div>
                <div class="col-md-6"><label class="form-label small">Expiration Date</label><input type="date" class="form-control" data-f="expirationDate" min="${DATE_MIN}" max="${DATE_MAX_FUTURE}" value="${dateInput(p.expirationDate)}"></div>
                <div class="col-12"><label class="form-label small">Copia del Pasaporte (foto o PDF)</label><input type="file" class="form-control" data-f-file="passportDocument" accept="image/*,application/pdf">${p.passportDocument ? ` <a href="${esc(p.passportDocument)}" target="_blank" class="small d-inline-block mt-1"><i class="ti ti-file me-1"></i>Ver documento actual</a>` : ''}</div>
                <div class="col-12 form-check ms-1 mt-1"><input class="form-check-input" type="checkbox" data-f="verified" id="ppVerified" ${p.verified ? 'checked' : ''}><label class="form-check-label small" for="ppVerified">Documento verificado (es un pasaporte válido)</label></div>
            </div>`;
    }

    // Second step after create/update: upload the document file via multipart to the S3 endpoint.
    // Client-side validation mirrors the server (image/PDF, ≤5MB); returns true on success.
    async function uploadPassportDocument(passportId, file) {
        if (!file) return true;
        if (file.size > 5 * 1024 * 1024) { notify('El archivo supera el límite de 5MB', 'error'); return false; }
        if (!/^image\//.test(file.type) && file.type !== 'application/pdf') {
            notify('Tipo de archivo no permitido. Solo imágenes o PDF.', 'error'); return false;
        }
        const fd = new FormData();
        fd.append('document', file);
        // No Content-Type header — the browser sets the multipart boundary itself.
        const res = await fetch(`${base}/passports/${passportId}/document`, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: fd,
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error(json.error || `Error ${res.status}`);
        return true;
    }

    // ---------- Documents ----------
    const DOC_LABEL_MAX = 60;
    const DOC_MAX_BYTES = 10 * 1024 * 1024; // 10MB

    function humanSize(bytes) {
        const n = Number(bytes) || 0;
        if (n < 1024) return `${n} B`;
        if (n < 1024 * 1024) return `${(n / 1024).toFixed(0)} KB`;
        return `${(n / (1024 * 1024)).toFixed(1)} MB`;
    }

    async function loadDocuments() {
        const box = document.getElementById('documentsContainer');
        if (!box) return; // agencies don't render the documents card
        try {
            const { documents } = await api('/documents');
            if (!documents.length) { box.innerHTML = '<p class="text-muted mb-0">Sin documentos registrados.</p>'; return; }
            box.innerHTML = documents.map((d) => {
                const name = d.label === 'Otro documento' && d.customLabel ? d.customLabel : d.label;
                return `
                <div class="d-flex justify-content-between align-items-start border-bottom py-2">
                    <div>
                        <div class="fw-semibold">${esc(name) || 'Documento'}${d.isSensitive ? '<span class="badge bg-secondary ms-2"><i class="ti ti-lock me-1"></i>Sensible</span>' : ''}</div>
                        <div class="text-muted small">${esc(d.fileName)}${d.size ? ` · ${humanSize(d.size)}` : ''}</div>
                        ${d.documentUrl ? `<a href="${esc(d.documentUrl)}" target="_blank" class="small"><i class="ti ti-file me-1"></i>Ver documento</a>` : ''}
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-light" title="Editar" data-edit-doc="${d.id}"><i class="ti ti-pencil"></i></button>
                        <button class="btn btn-light text-danger" title="Eliminar" data-del-doc="${d.id}"><i class="ti ti-trash"></i></button>
                    </div>
                </div>`;
            }).join('');
            box._data = documents;
        } catch (e) { box.innerHTML = `<p class="text-danger mb-0">${esc(e.message)}</p>`; }
    }

    function documentForm(fileOptional) {
        // The type is free text (datalist = suggestions only) so the admin can write a type the
        // predefined tags don't cover.
        const opts = DOCUMENT_LABELS.map((l) => `<option value="${esc(l)}"></option>`).join('');
        const fileHint = fileOptional ? ' <span class="text-muted">(opcional · deja vacío para conservar el actual)</span>' : '';
        return `
            <div class="row g-2">
                <div class="col-12"><label class="form-label small">Tipo de documento</label>
                    <input class="form-control" data-f="label" list="documentLabelOptions" maxlength="${DOC_LABEL_MAX}" placeholder="Escribe o elige el tipo de documento">
                    <datalist id="documentLabelOptions">${opts}</datalist></div>
                <div class="col-12"><label class="form-label small">Archivo (foto o PDF)${fileHint}</label>
                    <input type="file" class="form-control" data-f-file="document" accept="image/*,application/pdf"></div>
            </div>`;
    }

    // Read a File as base64 (strip the "data:...;base64," prefix) for the JSON upload body.
    function fileToBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result).split(',')[1] || '');
            reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
            reader.readAsDataURL(file);
        });
    }

    // Upload a document via base64-in-JSON (multipart is blocked by the WAF, HTTP 426).
    // Throws on validation failure so openModal keeps the form open and shows the message.
    async function uploadDocument(values, file) {
        if (!values.label || !values.label.trim()) throw new Error('Escribe el tipo de documento');
        if (!file) throw new Error('Selecciona un archivo');
        if (file.size > DOC_MAX_BYTES) throw new Error('El archivo supera el límite de 10MB');
        if (!/^image\//.test(file.type) && file.type !== 'application/pdf') {
            throw new Error('Tipo de archivo no permitido. Solo imágenes o PDF.');
        }
        const fileBase64 = await fileToBase64(file);
        await api('/documents', 'POST', {
            fileBase64,
            fileName: file.name,
            mimeType: file.type,
            label: values.label.trim(),
        });
    }

    // Update a document: label always; file only if a new one is chosen (mirrors the passport edit).
    async function updateDocument(docId, values, file) {
        if (!values.label || !values.label.trim()) throw new Error('Escribe el tipo de documento');
        const body = { label: values.label.trim() };
        if (file) {
            if (file.size > DOC_MAX_BYTES) throw new Error('El archivo supera el límite de 10MB');
            if (!/^image\//.test(file.type) && file.type !== 'application/pdf') {
                throw new Error('Tipo de archivo no permitido. Solo imágenes o PDF.');
            }
            body.fileBase64 = await fileToBase64(file);
            body.fileName = file.name;
            body.mimeType = file.type;
        }
        await api(`/documents/${docId}`, 'PUT', body);
    }

