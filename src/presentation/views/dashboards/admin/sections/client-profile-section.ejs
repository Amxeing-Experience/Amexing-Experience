<%
// Travel-preference types mirror the reference design.
const PREFERENCE_TYPES = ['Activity', 'Bed', 'Hotel', 'Meal', 'Mood', 'Seat'];
%>
<style>
    #profileModal .form-control, #profileModal .form-select,
    #agentProfileModal .form-control, #agentProfileModal .form-select,
    #profileRoot .form-control, #profileRoot .form-select { color: #1b1b1b; }
    #profileModal .form-control::placeholder,
    #agentProfileModal .form-control::placeholder,
    #profileRoot .form-control::placeholder { color: #6c757d; }
</style>
<script>
// Initialize the profile section for a given root element. Reusable so it can drive both the
// client detail page (#profileRoot) and an injected agent-profile modal (its own root).
window.initProfileSection = function (root) {
    if (!root || root.dataset.profileInit === '1') return;
    root.dataset.profileInit = '1';
    const clientId = root.dataset.clientId;
    // ownerBase lets this section drive either /api/clients/:id (Client) or /api/agents/:id
    // (AmexingUser agent). Falls back to the client base for backward compatibility.
    const base = root.dataset.ownerBase || `/api/clients/${clientId}`;
    const PREFERENCE_TYPES = <%- JSON.stringify(PREFERENCE_TYPES) %>;

    // Country list for passport dropdowns. México/Estados Unidos/Canadá first (Mexican travel
    // company), then the rest alphabetically.
    const COUNTRIES = ['México', 'Estados Unidos', 'Canadá', 'Alemania', 'Arabia Saudita', 'Argentina',
        'Australia', 'Austria', 'Bélgica', 'Bolivia', 'Brasil', 'Bulgaria', 'Chile', 'China', 'Chipre',
        'Colombia', 'Corea del Sur', 'Costa Rica', 'Croacia', 'Cuba', 'Dinamarca', 'Ecuador', 'Egipto',
        'El Salvador', 'Emiratos Árabes Unidos', 'Eslovaquia', 'Eslovenia', 'España', 'Estonia',
        'Filipinas', 'Finlandia', 'Francia', 'Grecia', 'Guatemala', 'Honduras', 'Hungría', 'India',
        'Indonesia', 'Irlanda', 'Islandia', 'Israel', 'Italia', 'Japón', 'Letonia', 'Lituania',
        'Luxemburgo', 'Malasia', 'Malta', 'Marruecos', 'Nicaragua', 'Noruega', 'Nueva Zelanda',
        'Países Bajos', 'Panamá', 'Paraguay', 'Perú', 'Polonia', 'Portugal', 'Qatar', 'Reino Unido',
        'República Checa', 'República Dominicana', 'Rumania', 'Rusia', 'Singapur', 'Sudáfrica',
        'Suecia', 'Suiza', 'Tailandia', 'Turquía', 'Ucrania', 'Uruguay', 'Venezuela', 'Vietnam'];

    function countrySelect(field, current) {
        const opts = COUNTRIES.map((c) => `<option value="${esc(c)}" ${current === c ? 'selected' : ''}>${esc(c)}</option>`).join('');
        return `<select class="form-select" data-f="${field}"><option value="">Selecciona…</option>${opts}</select>`;
    }

    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    async function api(path, method = 'GET', body) {
        const res = await fetch(base + path, {
            method,
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: body ? JSON.stringify(body) : undefined,
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error(json.error || `Error ${res.status}`);
        return json.data;
    }

    function notify(msg, kind = 'success') {
        if (typeof window.showSuccessAlert === 'function' && kind === 'success') return window.showSuccessAlert(msg);
        if (typeof window.showErrorAlert === 'function' && kind !== 'success') return window.showErrorAlert(msg);
        alert(msg);
    }

    // ---------- Passports ----------
    async function loadPassports() {
        const box = document.getElementById('passportsContainer');
        if (!box) return; // agencies don't render the passports card
        try {
            const { passports } = await api('/passports');
            if (!passports.length) { box.innerHTML = '<p class="text-muted mb-0">Sin pasaportes registrados.</p>'; return; }
            box.innerHTML = passports.map((p) => `
                <div class="border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="fw-semibold">${esc(p.label) || 'Pasaporte'}</div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-light" title="Editar" data-edit-pp="${p.id}"><i class="ti ti-pencil"></i></button>
                            <button class="btn btn-light text-danger" title="Eliminar" data-del-pp="${p.id}"><i class="ti ti-trash"></i></button>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-md-6 mb-2">
                            <label class="form-label text-muted small mb-0">Passport Number</label>
                            <div><span data-pp-mask="${p.id}">${esc(p.numberMasked) || '—'}</span>
                                ${p.hasNumber ? `<button class="btn btn-sm btn-light ms-1" title="Mostrar" data-reveal-pp="${p.id}"><i class="ti ti-eye-off"></i></button>` : ''}
                            </div>
                        </div>
                        <div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Passport Copy</label><div>${p.passportDocument ? `<a href="${esc(p.passportDocument)}" target="_blank"><i class="ti ti-file me-1"></i>Ver documento</a>` : '<span class="text-muted">—</span>'}</div></div>
                        <div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Country of Issue</label><div class="text-muted">${esc(p.countryOfIssue) || '—'}</div></div>
                        <div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Nationality</label><div class="text-muted">${esc(p.nationality) || '—'}</div></div>
                        <div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Date of Issue</label><div class="text-muted">${fmtDate(p.dateOfIssue)}</div></div>
                        <div class="col-md-6 mb-2"><label class="form-label text-muted small mb-0">Expiration Date</label><div class="text-muted">${fmtDate(p.expirationDate)}</div></div>
                    </div>
                </div>`).join('');
            box._data = passports;
        } catch (e) { box.innerHTML = `<p class="text-danger mb-0">${esc(e.message)}</p>`; }
    }

    function fmtDate(v) {
        if (!v) return '—';
        const d = new Date(v); return Number.isNaN(d.getTime()) ? '—' : d.toLocaleDateString('en-US', { dateStyle: 'medium' });
    }

    function dateInput(v) { return v ? new Date(v).toISOString().slice(0, 10) : ''; }

    function passportForm(p = {}) {
        return `
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label small">Etiqueta</label><input class="form-control" data-f="label" value="${esc(p.label)}" placeholder="Passport 1"></div>
                <div class="col-md-6"><label class="form-label small">Passport Number</label><input class="form-control" data-f="number" placeholder="${p.hasNumber ? 'Dejar vacío para conservar' : ''}"></div>
                <div class="col-md-6"><label class="form-label small">Country of Issue</label>${countrySelect('countryOfIssue', p.countryOfIssue)}</div>
                <div class="col-md-6"><label class="form-label small">Nationality</label>${countrySelect('nationality', p.nationality)}</div>
                <div class="col-md-6"><label class="form-label small">Date of Issue</label><input type="date" class="form-control" data-f="dateOfIssue" value="${dateInput(p.dateOfIssue)}"></div>
                <div class="col-md-6"><label class="form-label small">Expiration Date</label><input type="date" class="form-control" data-f="expirationDate" value="${dateInput(p.expirationDate)}"></div>
            </div>`;
    }

    // ---------- Addresses ----------
    async function loadAddresses() {
        const box = document.getElementById('addressesContainer');
        try {
            const { addresses } = await api('/addresses');
            if (!addresses.length) { box.innerHTML = '<p class="text-muted mb-0">Sin direcciones registradas.</p>'; return; }
            box.innerHTML = addresses.map((a) => `
                <div class="d-flex justify-content-between align-items-start border-bottom py-2">
                    <div>
                        <div class="fw-semibold">${esc(a.label) || 'Dirección'} ${a.isFavorite ? '<span class="badge bg-warning ms-1"><i class="ti ti-star me-1"></i>Favorita</span>' : ''}</div>
                        <div class="text-muted small">${esc(a.street)}, ${esc(a.city)}, ${esc(a.state)} ${esc(a.zipCode)}, ${esc(a.country)}</div>
                    </div>
                    <div class="btn-group btn-group-sm">
                        ${a.isFavorite ? '' : `<button class="btn btn-light" title="Marcar favorita" data-fav="${a.id}"><i class="ti ti-star"></i></button>`}
                        <button class="btn btn-light" title="Editar" data-edit-addr="${a.id}"><i class="ti ti-pencil"></i></button>
                        <button class="btn btn-light text-danger" title="Eliminar" data-del-addr="${a.id}"><i class="ti ti-trash"></i></button>
                    </div>
                </div>`).join('');
            box._data = addresses;
        } catch (e) { box.innerHTML = `<p class="text-danger mb-0">${esc(e.message)}</p>`; }
    }

    function addressForm(a = {}) {
        return `
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label small">Etiqueta</label><input class="form-control" data-f="label" value="${esc(a.label)}"></div>
                <div class="col-md-6"><label class="form-label small">País</label><input class="form-control" data-f="country" value="${esc(a.country || 'MX')}"></div>
                <div class="col-12"><label class="form-label small">Calle</label><input class="form-control" data-f="street" value="${esc(a.street)}"></div>
                <div class="col-md-4"><label class="form-label small">Ciudad</label><input class="form-control" data-f="city" value="${esc(a.city)}"></div>
                <div class="col-md-4"><label class="form-label small">Estado</label><input class="form-control" data-f="state" value="${esc(a.state)}"></div>
                <div class="col-md-4"><label class="form-label small">CP</label><input class="form-control" data-f="zipCode" value="${esc(a.zipCode)}"></div>
                <div class="col-12 form-check ms-2 mt-2"><input class="form-check-input" type="checkbox" data-f="isFavorite" id="favChk" ${a.isFavorite ? 'checked' : ''}><label class="form-check-label small" for="favChk">Marcar como favorita</label></div>
            </div>`;
    }

    // ---------- Travel preferences ----------
    async function loadPreferences() {
        const box = document.getElementById('preferencesContainer');
        try {
            const { preferences } = await api('/travel-preferences');
            if (!preferences.length) { box.innerHTML = '<p class="text-muted mb-0">Sin preferencias registradas.</p>'; return; }
            box.innerHTML = preferences.map((p) => `
                <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                    <div><span class="fw-semibold">${esc(p.type)}</span><span class="text-muted ms-2">${esc(p.option)}</span></div>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-light" title="Editar" data-edit-pref="${p.id}"><i class="ti ti-pencil"></i></button>
                        <button class="btn btn-light text-danger" title="Eliminar" data-del-pref="${p.id}"><i class="ti ti-trash"></i></button>
                    </div>
                </div>`).join('');
            box._data = preferences;
        } catch (e) { box.innerHTML = `<p class="text-danger mb-0">${esc(e.message)}</p>`; }
    }

    function preferenceForm(p = {}) {
        const opts = PREFERENCE_TYPES.map((t) => `<option value="${t}" ${p.type === t ? 'selected' : ''}>${t}</option>`).join('');
        return `
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label small">Tipo</label><select class="form-select" data-f="type"><option value="">Selecciona…</option>${opts}</select></div>
                <div class="col-md-6"><label class="form-label small">Opción</label><input class="form-control" data-f="option" value="${esc(p.option)}"></div>
            </div>`;
    }

    // ---------- Loyalty programs (array on the client) ----------
    async function loadLoyalty() {
        const box = document.getElementById('loyaltyContainer');
        if (!box) return; // agents (and any owner without loyalty) don't render the loyalty card
        try {
            const { loyaltyPrograms } = await api('/loyalty-programs');
            box._data = loyaltyPrograms || [];
            renderLoyalty();
        } catch (e) { box.innerHTML = `<p class="text-danger mb-0">${esc(e.message)}</p>`; }
    }

    function renderLoyalty() {
        const box = document.getElementById('loyaltyContainer');
        const list = box._data || [];
        if (!list.length) { box.innerHTML = '<p class="text-muted mb-0">Sin programas registrados.</p>'; return; }
        box.innerHTML = list.map((p, i) => `
            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                <div><span class="fw-semibold">${esc(p.type)}</span><span class="text-muted ms-2">${esc(p.number)}</span></div>
                <button class="btn btn-light btn-sm text-danger" title="Eliminar" data-del-loyalty="${i}"><i class="ti ti-trash"></i></button>
            </div>`).join('');
    }

    async function saveLoyalty(list) {
        await api('/loyalty-programs', 'PUT', { loyaltyPrograms: list });
    }

    // ---------- Generic modal (standard dashboard style: bg-primary header + icon) ----------
    function openModal(title, bodyHtml, onSave, icon = 'edit') {
        let el = document.getElementById('profileModal');
        if (!el) {
            document.body.insertAdjacentHTML('beforeend', `
                <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title text-white"><i class="ti ti-edit me-2" data-modal-icon></i><span data-modal-title></span></h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body"></div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancelar</button>
                                <button type="button" class="btn btn-primary" id="profileModalSave"><i class="ti ti-check me-1"></i>Guardar</button>
                            </div>
                        </div>
                    </div>
                </div>`);
            el = document.getElementById('profileModal');
        }
        el.querySelector('[data-modal-icon]').className = `ti ti-${icon} me-2`;
        el.querySelector('[data-modal-title]').textContent = title;
        el.querySelector('.modal-body').innerHTML = bodyHtml;
        const modal = bootstrap.Modal.getOrCreateInstance(el);
        const saveBtn = el.querySelector('#profileModalSave');
        const fresh = saveBtn.cloneNode(true);
        saveBtn.replaceWith(fresh);
        fresh.addEventListener('click', async () => {
            const values = {};
            el.querySelectorAll('[data-f]').forEach((input) => {
                values[input.dataset.f] = input.type === 'checkbox' ? input.checked : input.value;
            });
            try { await onSave(values); modal.hide(); } catch (e) { notify(e.message, 'error'); }
        });
        modal.show();
        // When opened over a parent modal (e.g. the agent profile modal), stack this one and
        // its backdrop above it so the parent is dimmed instead of peeking through.
        const stacked = document.querySelectorAll('.modal.show').length > 1;
        if (stacked) {
            el.style.zIndex = '1075';
            requestAnimationFrame(() => {
                const backdrops = document.querySelectorAll('.modal-backdrop');
                if (backdrops.length) backdrops[backdrops.length - 1].style.zIndex = '1070';
            });
        }
    }

    // ---------- Wiring ----------
    document.getElementById('addPassportBtn')?.addEventListener('click', () => {
        openModal('Agregar Pasaporte', passportForm(), async (v) => { await api('/passports', 'POST', v); notify('Pasaporte creado'); loadPassports(); }, 'id');
    });
    document.getElementById('addAddressBtn')?.addEventListener('click', () => {
        openModal('Agregar Dirección', addressForm(), async (v) => { await api('/addresses', 'POST', v); notify('Dirección creada'); loadAddresses(); }, 'map-pin');
    });
    document.getElementById('addPreferenceBtn')?.addEventListener('click', () => {
        openModal('Agregar Preferencia', preferenceForm(), async (v) => { await api('/travel-preferences', 'POST', v); notify('Preferencia creada'); loadPreferences(); }, 'plane');
    });
    document.getElementById('addLoyaltyBtn')?.addEventListener('click', () => {
        openModal('Agregar Programa', `
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label small">Programa</label><input class="form-control" data-f="type"></div>
                <div class="col-md-6"><label class="form-label small">N° de Membresía</label><input class="form-control" data-f="number"></div>
            </div>`, async (v) => {
            const box = document.getElementById('loyaltyContainer');
            const list = [...(box._data || []), { type: v.type, number: v.number }];
            await saveLoyalty(list); box._data = list; renderLoyalty(); notify('Programa agregado');
        }, 'star');
    });

    root.addEventListener('click', async (e) => {
        const btn = e.target.closest('button'); if (!btn) return;
        try {
            if (btn.dataset.revealPp) {
                const span = document.querySelector(`[data-pp-mask="${btn.dataset.revealPp}"]`);
                const icon = btn.querySelector('i');
                if (icon.classList.contains('ti-eye-off')) {
                    const { number } = await api(`/passports/${btn.dataset.revealPp}/reveal`, 'POST');
                    span.dataset.masked = span.textContent;
                    span.textContent = number;
                    icon.className = 'ti ti-eye';
                } else {
                    span.textContent = span.dataset.masked || span.textContent;
                    icon.className = 'ti ti-eye-off';
                }
            } else if (btn.dataset.editPp) {
                const p = (document.getElementById('passportsContainer')._data || []).find((x) => x.id === btn.dataset.editPp);
                openModal('Editar Pasaporte', passportForm(p), async (v) => { await api(`/passports/${p.id}`, 'PUT', v); notify('Pasaporte actualizado'); loadPassports(); }, 'id');
            } else if (btn.dataset.delPp) {
                if (confirm('¿Eliminar este pasaporte?')) { await api(`/passports/${btn.dataset.delPp}`, 'DELETE'); notify('Pasaporte eliminado'); loadPassports(); }
            } else if (btn.dataset.fav) { await api(`/addresses/${btn.dataset.fav}`, 'PUT', { isFavorite: true }); loadAddresses(); }
            else if (btn.dataset.editAddr) {
                const a = (document.getElementById('addressesContainer')._data || []).find((x) => x.id === btn.dataset.editAddr);
                openModal('Editar Dirección', addressForm(a), async (v) => { await api(`/addresses/${a.id}`, 'PUT', v); notify('Dirección actualizada'); loadAddresses(); }, 'map-pin');
            } else if (btn.dataset.delAddr) {
                if (confirm('¿Eliminar esta dirección?')) { await api(`/addresses/${btn.dataset.delAddr}`, 'DELETE'); notify('Dirección eliminada'); loadAddresses(); }
            } else if (btn.dataset.editPref) {
                const p = (document.getElementById('preferencesContainer')._data || []).find((x) => x.id === btn.dataset.editPref);
                openModal('Editar Preferencia', preferenceForm(p), async (v) => { await api(`/travel-preferences/${p.id}`, 'PUT', v); notify('Preferencia actualizada'); loadPreferences(); }, 'plane');
            } else if (btn.dataset.delPref) {
                if (confirm('¿Eliminar esta preferencia?')) { await api(`/travel-preferences/${btn.dataset.delPref}`, 'DELETE'); notify('Preferencia eliminada'); loadPreferences(); }
            } else if (btn.dataset.delLoyalty) {
                const box = document.getElementById('loyaltyContainer');
                const list = (box._data || []).filter((_, i) => i !== Number(btn.dataset.delLoyalty));
                await saveLoyalty(list); box._data = list; renderLoyalty(); notify('Programa eliminado');
            }
        } catch (err) { notify(err.message, 'error'); }
    });

    loadPassports();
    loadAddresses();
    loadPreferences();
    loadLoyalty();
};

// Auto-init for the client detail page (the agent modal calls initProfileSection itself).
(function () {
    const root = document.getElementById('profileRoot');
    if (root) window.initProfileSection(root);
})();
</script>
