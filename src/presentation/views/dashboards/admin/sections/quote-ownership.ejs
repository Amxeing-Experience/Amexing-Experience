<%
/**
 * Quote Ownership & Collaboration Component
 * Displays and manages quote ownership, collaborators, and edit history
 * Created by Denisse Maldonado
 */
%>

<!-- Ownership & Collaboration Panel -->
<div class="card shadow-sm mb-4" id="ownershipPanel">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold">
                <i class="ti ti-users me-2 text-primary"></i>
                Propiedad y Agentes
            </h5>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary" id="btnViewHistory" data-bs-toggle="tooltip" title="Ver historial">
                    <i class="ti ti-history me-1"></i>
                    Historial de cambios
                </button>
                <button class="btn btn-sm btn-primary" id="btnManageCollaborators">
                    <i class="ti ti-user-plus me-1"></i>
                    Gestionar Acceso
                </button>
            </div>
        </div>
    </div>
    
    <div class="card-body">
        <!-- Owner Information -->
        <div class="mb-4">
            <h6 class="text-muted mb-2">Propietario</h6>
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="avatar avatar-sm bg-primary-subtle text-primary rounded-circle me-3">
                        <i class="ti ti-user"></i>
                    </div>
                    <div>
                        <div class="fw-semibold" id="ownerName">Cargando...</div>
                        <small class="text-muted" id="ownerEmail">...</small>
                    </div>
                </div>
                <div>
                    <small class="text-muted" id="ownerSince">Desde: ...</small>
                </div>
            </div>
        </div>

        <!-- Agents List -->
        <div class="mb-4">
            <h6 class="text-muted mb-2">Agentes</h6>
            <div id="collaboratorsList">
                <div class="text-center py-3 text-muted">
                    <i class="ti ti-users-off mb-2" style="font-size: 2rem;"></i>
                    <p class="mb-0">No hay agentes asignados</p>
                </div>
            </div>
        </div>

        <!-- Access Info for Current User -->
        <div id="currentUserAccess" class="alert alert-info d-none">
            <div class="d-flex align-items-center">
                <i class="ti ti-info-circle me-2"></i>
                <div>
                    <strong>Tu acceso:</strong> <span id="userAccessRole"></span>
                    <div class="small" id="userAccessDetails"></div>
                </div>
            </div>
        </div>

        <!-- Pending Edits Alert (only visible to owner) -->
        <div id="pendingEditsAlert" class="alert alert-warning d-none">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="ti ti-alert-circle me-2"></i>
                    <strong>Ediciones pendientes de aprobación:</strong> <span id="pendingCount">0</span>
                </div>
                <button class="btn btn-sm btn-warning" id="btnReviewEdits">
                    Revisar
                </button>
            </div>
        </div>
    </div>
</div>


<!-- Manage Collaborators Modal -->
<div class="modal fade" id="manageCollaboratorsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-settings me-2"></i>
                    Gestionar Acceso y Propiedad
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Ownership Transfer Section -->
                <div class="card mb-4" id="ownershipTransferSection">
                    <div class="card-header bg-warning-subtle">
                        <h6 class="card-title mb-0">
                            <i class="ti ti-crown me-2"></i>
                            Gestionar Propiedad
                        </h6>
                    </div>
                    <div class="card-body">
                        <!-- Current Owner Display -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Propietario Actual</label>
                            <div class="d-flex align-items-center p-2 bg-light rounded">
                                <div class="avatar avatar-sm bg-primary-subtle text-primary rounded-circle me-3">
                                    <i class="ti ti-user"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-medium" id="modalOwnerName">Cargando...</div>
                                    <small class="text-muted" id="modalOwnerEmail">...</small>
                                </div>
                                <span class="badge bg-primary">Propietario</span>
                            </div>
                        </div>

                        <!-- Transfer Ownership Form -->
                        <div class="border-top pt-3" id="transferOwnershipForm">
                            <div class="alert alert-warning">
                                <i class="ti ti-alert-triangle me-2"></i>
                                <strong>Importante:</strong> Al transferir la propiedad, perderás el control total sobre esta cotización.
                                Mantendrás acceso como editor.
                            </div>
                            
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label">Transferir Propiedad a:</label>
                                    <select class="form-select" id="newOwnerSelectMain">
                                        <option value="">Seleccionar nuevo propietario...</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">&nbsp;</label>
                                    <button class="btn btn-warning w-100" id="btnConfirmTransferMain">
                                        <i class="ti ti-transfer me-1"></i>
                                        Transferir
                                    </button>
                                </div>
                            </div>
                            
                            <div class="mt-3">
                                <label class="form-label">Razón de la transferencia (opcional)</label>
                                <textarea class="form-control" id="transferReasonMain" rows="2" 
                                          placeholder="Explica por qué transfieres la propiedad"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add Collaborator Form -->
                <div class="card mb-3">
                    <div class="card-body">
                        <h6 class="card-title">Agregar Agente</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <select class="form-select" id="collaboratorSelect">
                                    <option value="">Seleccionar agente...</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" id="collaboratorRole">
                                    <option value="viewer">Visualizador</option>
                                    <option value="editor">Editor</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button class="btn btn-primary w-100" id="btnAddCollaborator">
                                    <i class="ti ti-plus me-1"></i>
                                    Agregar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Current Agents -->
                <h6 class="mb-2">Agentes Actuales</h6>
                <div id="collaboratorsManagementList">
                    <p class="text-muted text-center py-3">Cargando agentes...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit History Modal -->
<div class="modal fade" id="editHistoryModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-history me-2"></i>
                    Historial de Cambios
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="editHistoryTable">
                        <thead>
                            <tr>
                                <th>Versión</th>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Cambios</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="6" class="text-center py-3">
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">Cargando...</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Review Pending Edits Modal -->
<div class="modal fade" id="reviewEditsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-eye-check me-2"></i>
                    Revisar Ediciones Pendientes
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="pendingEditsList">
                    <p class="text-center py-3">
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        Cargando ediciones pendientes...
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Ownership Panel Styles */
#ownershipPanel .avatar {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.collaborator-item {
    padding: 0.75rem;
    border: 1px solid #e9ecef;
    border-radius: 0.375rem;
    margin-bottom: 0.5rem;
    transition: all 0.2s;
}

.collaborator-item:hover {
    background-color: #f8f9fa;
}

.role-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
}

.role-badge.editor {
    background-color: #d1ecf1;
    color: #0c5460;
}

.role-badge.viewer {
    background-color: #d4edda;
    color: #155724;
}

.role-badge.owner {
    background-color: #f8d7da;
    color: #721c24;
}

.edit-item {
    padding: 1rem;
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
    margin-bottom: 1rem;
}

.edit-item.pending {
    border-left: 3px solid #ffc107;
}

.edit-item.approved {
    border-left: 3px solid #28a745;
}

.edit-item.rejected {
    border-left: 3px solid #dc3545;
}

.changes-list {
    background-color: #f8f9fa;
    padding: 0.5rem;
    border-radius: 0.25rem;
    margin-top: 0.5rem;
}

.change-field {
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
}

.old-value {
    color: #dc3545;
    text-decoration: line-through;
}

.new-value {
    color: #28a745;
}
</style>

<script>
// Set quote ID for the ownership manager
window.quoteId = '<%= typeof quoteId !== 'undefined' ? quoteId : '' %>';
</script>
<script src="/dashboards/admin/sections/quote-ownership.js"></script>