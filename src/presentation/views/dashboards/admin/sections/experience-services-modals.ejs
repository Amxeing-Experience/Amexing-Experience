<%
/**
 * Experience Services Modals - Modal components for the services builder
 * Created by Denisse Maldonado
 */
%>

<!-- Service Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-labelledby="serviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title" id="serviceModalLabel">
                    <i class="ti ti-plus-circle me-2"></i>Agregar Servicio
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Alert Container for Modal -->
                <div id="serviceModalAlert" class="modal-alert-container"></div>
                
                <form id="serviceForm">
                    <!-- Service Type Selection -->
                    <div class="service-type-selector mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0">Servicio <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="serviceType" id="typeExperience" value="experience" checked>
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeExperience">
                                    <i class="ti ti-beach me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Experiencia</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="serviceType" id="typeTour" value="tour">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeTour">
                                    <i class="ti ti-map-2 me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Tour</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="serviceType" id="typeTransport" value="transport">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeTransport">
                                    <i class="ti ti-car me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Transporte</span>
                                </label>

                                <input type="radio" class="btn-check" name="serviceType" id="typeConcepto" value="concepto">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeConcepto">
                                    <i class="ti ti-file-text me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Concepto</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Transport Type Selection (only visible when transport is selected) -->
                    <div id="transportTypeSelector" class="mb-3 d-none">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0">Transporte <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="transportType" id="transportAeropuerto" value="aeropuerto" checked>
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="transportAeropuerto">
                                    <i class="ti ti-plane me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Aeropuerto</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="transportType" id="transportPuntoAPunto" value="punto-a-punto">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="transportPuntoAPunto">
                                    <i class="ti ti-route me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Punto a Punto</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="transportType" id="transportLocal" value="local">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="transportLocal">
                                    <i class="ti ti-map-pin me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Local</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Trip Type Selection (only visible when transport is selected) -->
                    <div id="tripTypeSelector" class="mb-3 d-none">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0">Viaje <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="tripType" id="tripOneWay" value="one-way" checked>
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="tripOneWay">
                                    <i class="ti ti-arrow-right me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">One Way</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="tripType" id="tripRoundTrip" value="round-trip">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="tripRoundTrip">
                                    <i class="ti ti-arrows-right-left me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Round Trip</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Content Based on Service Type -->
                    <div id="serviceTypeContent">
                        <!-- Experience/Tour Selection -->
                        <div id="experienceContent" class="service-content">
                            <div class="mb-3">
                                <label for="experienceSelect" class="form-label">Seleccionar Experiencia <span class="text-danger">*</span></label>
                                <select class="form-select" id="experienceSelect" required>
                                    <option value="">-- Selecciona una experiencia --</option>
                                </select>
                                <div class="form-text" id="experienceAvailabilityWarning" style="display: none; color: #fd7e14;">
                                    *Se verificará disponibilidad y se confirmará en la reservación
                                </div>
                            </div>
                            
                            <!-- Experience Details Card -->
                            <div id="experienceDetailsCard" class="card border mb-3 d-none">
                                <div class="card-body p-3" id="experienceDetailsCardBody">
                                    <!-- Populated dynamically by JS -->
                                </div>
                            </div>

                            <!-- Schedule Fields (now optional/hidden by default) -->
                            <div class="row" id="experienceScheduleFields" style="display: none;">
                                <div class="col-md-6 mb-3">
                                    <label for="experienceStartTime" class="form-label">Hora de inicio</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                        <input type="text" class="form-control time-input" id="experienceStartTime" placeholder="__:__" maxlength="5" data-placeholder="09:00">
                                    </div>
                                    <small class="form-text text-muted">Ej: 09:00, 14:30</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="experienceEndTime" class="form-label">Hora de fin</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                        <input type="text" class="form-control time-input" id="experienceEndTime" placeholder="__:__" maxlength="5" data-placeholder="17:00">
                                    </div>
                                    <small class="form-text text-muted">Ej: 17:00, 20:30</small>
                                </div>
                            </div>
                        </div>

                        <!-- Tour Selection -->
                        <div id="tourContent" class="service-content d-none">
                            <div class="mb-3">
                                <label for="tourSelect" class="form-label">Seleccionar Tour <span class="text-danger">*</span></label>
                                <select class="form-select" id="tourSelect" required>
                                    <option value="">-- Selecciona un tour --</option>
                                </select>
                                <div class="form-text" id="tourAvailabilityWarning" style="display: none; color: #fd7e14;">
                                    *Se verificará disponibilidad y se confirmará en la reservación
                                </div>
                            </div>
                            
                            <!-- Tour Details Card -->
                            <div id="tourDetailsCard" class="card border mb-3 d-none">
                                <div class="card-body p-3" id="tourDetailsCardBody">
                                    <!-- Populated dynamically by JS -->
                                </div>
                            </div>

                            <!-- Schedule Fields (now optional/hidden by default) -->
                            <div class="row" id="tourScheduleFields" style="display: none;">
                                <div class="col-md-6 mb-3">
                                    <label for="tourStartTime" class="form-label">Hora de inicio</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                        <input type="text" class="form-control time-input" id="tourStartTime" placeholder="__:__" maxlength="5" data-placeholder="09:00">
                                    </div>
                                    <small class="form-text text-muted">Ej: 09:00, 14:30</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="tourEndTime" class="form-label">Hora de fin</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                        <input type="text" class="form-control time-input" id="tourEndTime" placeholder="__:__" maxlength="5" data-placeholder="17:00">
                                    </div>
                                    <small class="form-text text-muted">Ej: 17:00, 20:30</small>
                                </div>
                            </div>
                        </div>

                        <!-- Transport Fields -->
                        <div id="transportContent" class="service-content d-none">
                            <!-- One Way Form -->
                            <div id="oneWayForm" class="transport-trip-form">
                                <div class="border rounded p-3 bg-light">
                                    <!-- Arrival/Departure Selection (only for one-way) -->
                                    <div id="arrivalDepartureSelector" class="mb-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <label class="form-label mb-0">Tipo <span class="text-danger">*</span></label>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <input type="radio" class="btn-check" name="directionType" id="typeArrival" value="arrival" checked>
                                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeArrival">
                                                    <i class="ti ti-plane-arrival me-1" style="font-size: 1.1rem;"></i>
                                                    <span style="font-size: 0.9rem;">Arrival</span>
                                                </label>

                                                <input type="radio" class="btn-check" name="directionType" id="typeDeparture" value="departure">
                                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeDeparture">
                                                    <i class="ti ti-plane-departure me-1" style="font-size: 1.1rem;"></i>
                                                    <span style="font-size: 0.9rem;">Departure</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" id="transportOriginLabel">Origen <span class="text-danger">*</span></label>
                                        <!-- Arrival: Dropdown Origin (airports) -->
                                        <select class="form-select transport-origin-arrival" id="transportOriginSelect" required>
                                            <option value="">-- Seleccionar origen --</option>
                                        </select>
                                        <!-- Departure: Combo Origin (hotels, cities) -->
                                        <div class="position-relative d-none" id="transportOriginComboWrapper">
                                            <input type="text"
                                                   class="form-control"
                                                   id="transportOriginCombo"
                                                   list="transportOriginList"
                                                   placeholder="Seleccionar o escribir origen...">
                                            <datalist id="transportOriginList">
                                            </datalist>
                                            <small class="text-muted d-none" id="originOptionsIndicator">
                                                <i class="ti ti-arrow-down"></i> Opciones disponibles
                                            </small>
                                        </div>
                                        <!-- Other types: Text Origin -->
                                        <input type="text" class="form-control transport-origin-departure d-none" id="transportOriginText" placeholder="Ej: Hotel Xcaret, Airbnb Playa">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" id="transportDestinationLabel">Destino <span class="text-danger">*</span></label>
                                        <!-- Arrival/default: Combo Box destination -->
                                        <div class="position-relative" id="transportDestinationComboWrapper">
                                            <input type="text"
                                                   class="form-control"
                                                   id="transportDestinationCombo"
                                                   list="transportDestinationList"
                                                   placeholder="Seleccionar o escribir destino..."
                                                   required>
                                            <datalist id="transportDestinationList">
                                            </datalist>
                                            <small class="text-muted d-none" id="destinationOptionsIndicator">
                                                <i class="ti ti-arrow-down"></i> Opciones disponibles
                                            </small>
                                        </div>
                                        <!-- Departure: Dropdown destination (airports) -->
                                        <select class="form-select d-none" id="transportDestinationSelect">
                                            <option value="">-- Seleccionar destino --</option>
                                        </select>
                                        <!-- Local: Text destination -->
                                        <input type="text" class="form-control d-none" id="transportDestinationText" placeholder="Ej: Hotel Rosewood, Casa en Aldama 15...">
                                    </div>
                                </div>

                                <!-- Specific Location field (shown only for certain destinations) -->
                                <div class="row d-none" id="specificLocationRow">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Ubicación Específica <span class="text-info">(Hotel, Dirección, etc.)</span></label>
                                        <input type="text"
                                               class="form-control"
                                               id="transportSpecificLocation"
                                               placeholder="Ej: Hotel Rosewood, Casa en Aldama 15, Centro Histórico..."
                                               aria-describedby="specificLocationHelp">
                                        <small id="specificLocationHelp" class="form-text text-muted">
                                            Especifique el hotel, dirección o lugar exacto dentro de <span id="selectedDestinationName"></span>
                                        </small>
                                    </div>
                                </div>

                                <!-- Transport Schedule (shown for Punto a Punto and Local) -->
                                <div id="transportScheduleSection" class="d-none">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="transportStartTime" class="form-label">Horario Inicio</label>
                                            <input type="text" class="form-control time-input" id="transportStartTime" placeholder="__:__" maxlength="5">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="transportEndTime" class="form-label">Horario Fin</label>
                                            <input type="text" class="form-control time-input" id="transportEndTime" placeholder="__:__" maxlength="5">
                                        </div>
                                    </div>
                                </div>

                                <!-- Flight Details (only show if Aeropuerto is selected) -->
                                <div id="flightDetailsSection" class="d-none">
                                    <hr class="my-2">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="airline" class="form-label">Aerolínea</label>
                                            <input type="text" class="form-control" id="airline" placeholder="Ej: American Airlines">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="flightNumber" class="form-label">Número de Vuelo</label>
                                            <input type="text" class="form-control" id="flightNumber" placeholder="Ej: AA1234">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="flightTime" class="form-label">Hora de Llegada</label>
                                            <input type="text" class="form-control time-input" id="flightTime" placeholder="__:__" maxlength="5">
                                        </div>
                                    </div>
                                </div>
                                </div>
                            </div>

                            <!-- Round Trip Form -->
                            <div id="roundTripForm" class="transport-trip-form d-none">
                                <!-- Ida (Arrival leg) -->
                                <div class="border rounded p-3 mb-3 bg-light">
                                    <h6 class="mb-3 text-info" id="roundTripIdaHeader">
                                        <i class="ti ti-plane-arrival me-2"></i>Arrival
                                    </h6>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" id="roundTripOriginIdaLabel">Origen <span class="text-danger">*</span></label>
                                            <!-- Arrival SELECT (airports or origins) -->
                                            <select class="form-select" id="roundTripOriginIdaSelect" required>
                                                <option value="">-- Seleccionar origen --</option>
                                            </select>
                                            <!-- Arrival TEXT (Local Ida) -->
                                            <input type="text" class="form-control d-none" id="roundTripOriginIdaText" placeholder="Ej: Hotel Xcaret, Airbnb Playa">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" id="roundTripDestinationIdaLabel">Destino <span class="text-danger">*</span></label>
                                            <!-- COMBO destination (aeropuerto/punto-a-punto arrival) -->
                                            <div class="position-relative" id="roundTripDestinationIdaComboWrapper">
                                                <input type="text" class="form-control" id="roundTripDestinationIdaCombo"
                                                       list="roundTripDestinationIdaList"
                                                       placeholder="Seleccionar o escribir destino..." required>
                                                <datalist id="roundTripDestinationIdaList"></datalist>
                                            </div>
                                            <!-- SELECT destination (Local Ida) -->
                                            <select class="form-select d-none" id="roundTripDestinationIdaSelect">
                                                <option value="">-- Seleccionar destino --</option>
                                            </select>
                                        </div>
                                    </div>
                                    <!-- Specific Location for Ida -->
                                    <div class="row d-none" id="roundTripSpecificLocationIdaRow">
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label">Ubicación Específica <span class="text-info">(Hotel, Dirección, etc.)</span></label>
                                            <input type="text" class="form-control" id="roundTripSpecificLocationIda"
                                                   placeholder="Ej: Hotel Rosewood, Casa en Aldama 15, Centro Histórico...">
                                            <small class="form-text text-muted">
                                                Especifique el hotel, dirección o lugar exacto dentro del destino
                                            </small>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="roundTripDateIda" class="form-label" id="roundTripDateIdaLabel">Fecha de Llegada</label>
                                            <input type="date" class="form-control" id="roundTripDateIda">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="roundTripTimeIda" class="form-label" id="roundTripTimeIdaLabel">Hora de Llegada</label>
                                            <input type="text" class="form-control time-input" id="roundTripTimeIda" placeholder="__:__" maxlength="5">
                                        </div>
                                    </div>

                                    <!-- Flight Details for Ida (only show if Aeropuerto is selected) -->
                                    <div class="roundtrip-flight-details-ida d-none">
                                        <hr class="my-2">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="roundTripAirlineIda" class="form-label">Aerolínea</label>
                                                <input type="text" class="form-control" id="roundTripAirlineIda" placeholder="Ej: American Airlines">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="roundTripFlightNumberIda" class="form-label">Número de Vuelo</label>
                                                <input type="text" class="form-control" id="roundTripFlightNumberIda" placeholder="Ej: AA1234">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Vuelta (Departure leg) -->
                                <div class="border rounded p-3 bg-light">
                                    <h6 class="mb-3 text-primary" id="roundTripVueltaHeader">
                                        <i class="ti ti-plane-departure me-2"></i>Departure
                                    </h6>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" id="roundTripOriginVueltaLabel">Origen <span class="text-danger">*</span></label>
                                            <!-- COMBO origin (aeropuerto/punto-a-punto departure) -->
                                            <div class="position-relative" id="roundTripOriginVueltaComboWrapper">
                                                <input type="text" class="form-control" id="roundTripOriginVueltaCombo"
                                                       list="roundTripOriginVueltaList"
                                                       placeholder="Seleccionar o escribir origen...">
                                                <datalist id="roundTripOriginVueltaList"></datalist>
                                            </div>
                                            <!-- SELECT origin (Local Vuelta) -->
                                            <select class="form-select d-none" id="roundTripOriginVueltaSelect">
                                                <option value="">-- Seleccionar origen --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" id="roundTripDestinationVueltaLabel">Destino <span class="text-danger">*</span></label>
                                            <!-- SELECT destination (aeropuerto/punto-a-punto departure) -->
                                            <select class="form-select" id="roundTripDestinationVueltaSelect">
                                                <option value="">-- Seleccionar destino --</option>
                                            </select>
                                            <!-- TEXT destination (Local Vuelta) -->
                                            <input type="text" class="form-control d-none" id="roundTripDestinationVueltaText" placeholder="Ej: Hotel Rosewood, Casa en Aldama 15...">
                                        </div>
                                    </div>
                                    <!-- Specific Location for Vuelta -->
                                    <div class="row d-none" id="roundTripSpecificLocationVueltaRow">
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label">Ubicación Específica <span class="text-info">(Hotel, Dirección, etc.)</span></label>
                                            <input type="text" class="form-control" id="roundTripSpecificLocationVuelta"
                                                   placeholder="Ej: Hotel Rosewood, Casa en Aldama 15, Centro Histórico...">
                                            <small class="form-text text-muted">
                                                Especifique el hotel, dirección o lugar exacto dentro del origen
                                            </small>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="roundTripDateVuelta" class="form-label" id="roundTripDateVueltaLabel">Fecha de Salida</label>
                                            <input type="date" class="form-control" id="roundTripDateVuelta">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="roundTripTimeVuelta" class="form-label" id="roundTripTimeVueltaLabel">Hora de Salida</label>
                                            <input type="text" class="form-control time-input" id="roundTripTimeVuelta" placeholder="__:__" maxlength="5">
                                        </div>
                                    </div>

                                    <!-- Flight Details for Vuelta (only show if Aeropuerto is selected) -->
                                    <div class="roundtrip-flight-details-vuelta d-none">
                                        <hr class="my-2">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="roundTripAirlineVuelta" class="form-label">Aerolínea</label>
                                                <input type="text" class="form-control" id="roundTripAirlineVuelta" placeholder="Ej: American Airlines">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="roundTripFlightNumberVuelta" class="form-label">Número de Vuelo</label>
                                                <input type="text" class="form-control" id="roundTripFlightNumberVuelta" placeholder="Ej: AA5678">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Concepto Fields -->
                        <div id="conceptoContent" class="service-content d-none">
                            <div class="mb-3">
                                <label for="conceptoConcept" class="form-label">Concepto <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="conceptoConcept" placeholder="Describe el servicio...">
                            </div>
                            
                            <!-- Schedule Toggle -->
                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="conceptoHasSchedule">
                                    <label class="form-check-label" for="conceptoHasSchedule">
                                        <i class="ti ti-clock me-1"></i>Incluir horario
                                    </label>
                                </div>
                            </div>
                            
                            <!-- Schedule Fields (hidden by default) -->
                            <div id="conceptoScheduleFields" class="d-none">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="conceptoStartTime" class="form-label">Hora de inicio</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                            <input type="text" class="form-control time-input" id="conceptoStartTime" placeholder="__:__" maxlength="5" data-placeholder="09:00">
                                        </div>
                                        <small class="form-text text-muted">Ej: 09:00, 14:30</small>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="conceptoEndTime" class="form-label">Hora de fin</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                            <input type="text" class="form-control time-input" id="conceptoEndTime" placeholder="__:__" maxlength="5" data-placeholder="17:00">
                                        </div>
                                        <small class="form-text text-muted">Ej: 17:00, 20:30</small>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>

                    <!-- Common Fields -->
                    <hr class="my-4">
                    
                    <!-- Tour Transport Checkbox - Only visible for Tours -->
                    <div class="mb-3" id="tourTransportCheckboxContainer" style="display: none;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="tourRequiresTransport">
                            <label class="form-check-label" for="tourRequiresTransport">
                                <i class="ti ti-car me-1"></i>Se requiere traslado
                            </label>
                        </div>
                    </div>
                    
                    <div class="row" id="transportFieldsRow">
                        <div class="col-md-6 mb-3">
                            <label for="transportCategory" class="form-label">Segmento <span class="text-danger">*</span></label>
                            <select class="form-select" id="transportCategory" required>
                                <option value="">-- Seleccionar segmento --</option>
                                <!-- Options will be loaded dynamically from Rate table -->
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="vehicleSelect" class="form-label">Vehículo</label>
                            <select class="form-select" id="vehicleSelect">
                                <option value="">-- Sin vehículo --</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label d-block">Opcional</label>
                            <div class="d-flex flex-column align-items-start" style="min-height: 38px;">
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" value="" id="includeGuide">
                                    <label class="form-check-label small" for="includeGuide" id="guideLabel" style="font-size: 0.875rem; line-height: 1.2;">
                                        Guía + Chofer
                                    </label>
                                </div>
                                <div class="form-check" id="greeterCheckboxContainer">
                                    <input class="form-check-input" type="checkbox" value="" id="includeGreeter">
                                    <label class="form-check-label small" for="includeGreeter" id="greeterLabel" style="font-size: 0.875rem; line-height: 1.2;">
                                        Greeter
                                    </label>
                                </div>
                                <div class="form-check ms-3 d-none" id="greeterInVehicleContainer">
                                    <input class="form-check-input" type="checkbox" value="" id="greeterInVehicle">
                                    <label class="form-check-label small text-muted" for="greeterInVehicle" style="font-size: 0.75rem; line-height: 1.2;">
                                        Viaja en el vehículo
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tiempo de Espera (Transport only) -->
                    <div id="tiempoEsperaSection" class="d-none mb-3">
                        <div class="row align-items-end">
                            <div class="col-md-4">
                                <label for="waitingTimeHours" class="form-label"><i class="ti ti-clock me-1"></i>Tiempo de espera</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="waitingTimeHours" min="0" step="0.5" value="0" placeholder="0">
                                    <span class="input-group-text">horas</span>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-center" style="min-height: 38px; padding-bottom: 4px;">
                                <small id="waitingTimeRate" class="text-muted"></small>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Standard pricing for non-experience services -->
                    <div class="row" id="standardPricingSection">
                        <div class="col-md-6 mb-3">
                            <label for="servicePrice" class="form-label">Precio <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="servicePrice" placeholder="0.00" step="0.01" min="0" required>
                                <span class="input-group-text" id="currencySymbol">MXN</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3" id="quantityFieldContainer">
                            <label for="serviceQuantity" class="form-label">Cantidad</label>
                            <input type="number" class="form-control" id="serviceQuantity" value="1" min="1" required>
                        </div>
                        <div class="col-md-6 mb-3 d-none" id="additionalVehicleContainer">
                            <label class="form-label d-block">&nbsp;</label>
                            <div class="form-check" style="padding-top: 6px;">
                                <input class="form-check-input" type="checkbox" id="additionalVehicle">
                                <label class="form-check-label" for="additionalVehicle">Vehículo adicional</label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Horas -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="hoursQuantity" class="form-label">Horas</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-clock-hour-3"></i></span>
                                <input type="number" class="form-control" id="hoursQuantity" min="0.5" step="0.5" value="1">
                                <span class="input-group-text">horas</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Experience pricing with adult/child/no-alcohol options -->
                    <div id="experiencePricingSection" class="d-none">
                        <!-- Price fields for each type -->
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="adultPrice" class="form-label">Precio Adulto <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="adultPrice" placeholder="0.00" step="0.01" min="0">
                                    <span class="input-group-text currency-symbol">MXN</span>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="childPrice" class="form-label">Precio Niño</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="childPrice" placeholder="0.00" step="0.01" min="0">
                                    <span class="input-group-text currency-symbol">MXN</span>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="noAlcoholPrice" class="form-label">Precio sin alcohol</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="noAlcoholPrice" placeholder="0.00" step="0.01" min="0">
                                    <span class="input-group-text currency-symbol">MXN</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    

                    <div class="mb-3">
                        <label for="serviceNotes" class="form-label">Notas Adicionales</label>
                        <textarea class="form-control" id="serviceNotes" rows="2" placeholder="Información adicional del servicio..."></textarea>
                    </div>

                    <!-- Preview -->
                    <div class="service-preview bg-light rounded p-3 d-none">
                        <h6 class="mb-2">Vista Previa</h6>
                        <div id="servicePreview">
                            <!-- Preview content will be generated here -->
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="saveServiceBtn">
                    <i class="ti ti-device-floppy me-1"></i>Guardar Servicio
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom bg-danger text-white">
                <h5 class="modal-title">
                    <i class="ti ti-alert-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="deleteConfirmMessage">¿Estás seguro de que deseas eliminar este elemento?</p>
                <p class="text-muted">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="ti ti-trash me-1"></i>Eliminar
                </button>
            </div>
        </div>
    </div>
</div>
