<%
/**
 * Quote Services Catalog - Offcanvas drag-and-drop panel
 * Provides draggable Experiences, Tours, and Transport items for quotes
 * Created by Denisse Maldonado
 */
%>

<!-- Catalog Offcanvas Panel -->
<div class="offcanvas offcanvas-start" data-bs-backdrop="false" data-bs-scroll="true" tabindex="-1" id="catalogOffcanvas" aria-labelledby="catalogOffcanvasLabel">
    <div class="offcanvas-header border-bottom py-2">
        <h6 class="offcanvas-title mb-0" id="catalogOffcanvasLabel">
            <i class="ti ti-layout-grid me-1"></i>Catálogo de Servicios
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body p-0" id="catalogDragSourcePanel">
        <!-- Tabs (control segmentado) -->
        <ul class="nav catalog-seg" id="catalogTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="catalogTabExperiences" data-bs-toggle="tab" data-bs-target="#catalogPaneExperiences" type="button" role="tab">
                    <i class="ti ti-beach"></i><span>Experiencias</span>
                    <span class="badge" id="catalogExpCount">0</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="catalogTabTours" data-bs-toggle="tab" data-bs-target="#catalogPaneTours" type="button" role="tab">
                    <i class="ti ti-map-2"></i><span>Tours</span>
                    <span class="badge" id="catalogToursCount">0</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="catalogTabTransport" data-bs-toggle="tab" data-bs-target="#catalogPaneTransport" type="button" role="tab">
                    <i class="ti ti-car"></i><span>Transporte</span>
                    <span class="badge" id="catalogTransportCount">0</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="catalogTabEntradas" data-bs-toggle="tab" data-bs-target="#catalogPaneEntradas" type="button" role="tab">
                    <i class="ti ti-ticket"></i><span>Entradas</span>
                    <span class="badge" id="catalogEntradasCount">0</span>
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Experiences Tab -->
            <div class="tab-pane fade show active" id="catalogPaneExperiences" role="tabpanel">
                <div class="p-3 pb-2">
                    <input type="text" class="form-control catalog-search-input mb-2" id="catalogSearchExperiences" placeholder="Buscar experiencia...">
                    <select class="form-select catalog-filter-select" id="catalogFilterDestination" title="Filtrar por destino">
                        <option value="all">Todos los destinos</option>
                    </select>
                </div>
                <div class="catalog-drag-items-list px-3 pb-3" id="catalogExperiencesList" style="max-height: calc(100vh - 270px); overflow-y: auto;">
                    <div class="text-center text-muted py-3">
                        <span class="spinner-border spinner-border-sm me-1"></span> Cargando...
                    </div>
                </div>
            </div>

            <!-- Tours Tab -->
            <div class="tab-pane fade" id="catalogPaneTours" role="tabpanel">
                <div class="p-3 pb-2">
                    <input type="text" class="form-control catalog-search-input" id="catalogSearchTours" placeholder="Buscar tour...">
                    <!-- Tour Type Filter -->
                    <div class="btn-group btn-group-sm w-100 mt-2" role="group" aria-label="Filtro de tours">
                        <input type="radio" class="btn-check" name="tourTypeFilter" id="tourFilterAll" value="all" checked>
                        <label class="btn btn-outline-secondary" for="tourFilterAll">
                            <i class="ti ti-list me-1"></i>Todos
                        </label>
                        
                        <input type="radio" class="btn-check" name="tourTypeFilter" id="tourFilterWalking" value="walking">
                        <label class="btn btn-outline-secondary" for="tourFilterWalking">
                            <i class="ti ti-walk me-1"></i>Walking
                        </label>
                        
                        <input type="radio" class="btn-check" name="tourTypeFilter" id="tourFilterVehicle" value="vehicle">
                        <label class="btn btn-outline-secondary" for="tourFilterVehicle">
                            <i class="ti ti-car me-1"></i>En Vehículo
                        </label>
                    </div>
                </div>
                <div class="catalog-drag-items-list px-3 pb-3" id="catalogToursList" style="max-height: calc(100vh - 240px); overflow-y: auto;">
                    <div class="text-center text-muted py-3">
                        <span class="spinner-border spinner-border-sm me-1"></span> Cargando...
                    </div>
                </div>
            </div>

            <!-- Transport Tab -->
            <div class="tab-pane fade" id="catalogPaneTransport" role="tabpanel">
                <div class="p-3 pb-2">
                    <input type="text" class="form-control catalog-search-input" id="catalogSearchTransport" placeholder="Buscar transporte...">
                    <!-- Transport Type Filter -->
                    <div class="btn-group btn-group-sm w-100 mt-2" role="group" aria-label="Filtro de transporte">
                        <input type="radio" class="btn-check" name="transportTypeFilter" id="transportFilterAll" value="all" checked>
                        <label class="btn btn-outline-secondary" for="transportFilterAll"><i class="ti ti-list me-1"></i>Todos</label>

                        <input type="radio" class="btn-check" name="transportTypeFilter" id="transportFilterAeropuerto" value="aeropuerto">
                        <label class="btn btn-outline-secondary" for="transportFilterAeropuerto"><i class="ti ti-plane me-1"></i>Aeropuerto</label>

                        <input type="radio" class="btn-check" name="transportTypeFilter" id="transportFilterPunto" value="punto-a-punto">
                        <label class="btn btn-outline-secondary" for="transportFilterPunto"><i class="ti ti-arrows-exchange me-1"></i>Punto a Punto</label>

                        <input type="radio" class="btn-check" name="transportTypeFilter" id="transportFilterLocal" value="local">
                        <label class="btn btn-outline-secondary" for="transportFilterLocal"><i class="ti ti-map-pin me-1"></i>Local</label>
                    </div>
                </div>
                <div class="catalog-drag-items-list px-3 pb-3" id="catalogTransportList" style="max-height: calc(100vh - 240px); overflow-y: auto;">
                    <div class="text-center text-muted py-3">
                        <span class="spinner-border spinner-border-sm me-1"></span> Cargando...
                    </div>
                </div>
            </div>

            <!-- Entradas Tab -->
            <div class="tab-pane fade" id="catalogPaneEntradas" role="tabpanel">
                <div class="p-3 pb-2">
                    <input type="text" class="form-control catalog-search-input mb-2" id="catalogSearchEntradas" placeholder="Buscar entrada...">
                    <select class="form-select catalog-filter-select" id="catalogFilterEntradasDestination" title="Filtrar por destino">
                        <option value="all">Todos los destinos</option>
                    </select>
                </div>
                <div class="catalog-drag-items-list px-3 pb-3" id="catalogEntradasList" style="max-height: calc(100vh - 270px); overflow-y: auto;">
                    <div class="text-center text-muted py-3">
                        <span class="spinner-border spinner-border-sm me-1"></span> Cargando...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
