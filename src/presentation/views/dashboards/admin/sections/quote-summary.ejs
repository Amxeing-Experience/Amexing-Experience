            if (eventType) {
                doc.text(`EVENTO: ${eventType}`, margin, yPosition);
                yPosition += 5;
            }
            doc.text(`PERSONAS: ${numberOfPeople}`, margin, yPosition);
            yPosition += 5;
            // Fechas de servicios: solo si la fila está visible (hay días con fecha).
            const __serviceDatesHidden = document.getElementById('summaryServiceDatesRow')?.classList.contains('d-none');
            const __serviceDates = (document.getElementById('summaryServiceDates')?.textContent || '').trim();
            if (!__serviceDatesHidden && __serviceDates && __serviceDates !== '-') {
                doc.text(`FECHAS DE SERVICIOS: ${__serviceDates}`, margin, yPosition);
                yPosition += 5;
            }
            yPosition += 5;

            // Services Section
            doc.setFontSize(12);
            doc.setTextColor(13, 110, 253);
            doc.text('SERVICIOS E ITINERARIO', margin, yPosition);
            yPosition += 8;

            // Get card data
            const cardsContainer = document.querySelector('#summaryServicesCards');
            if (cardsContainer) {
                const dayCards = cardsContainer.querySelectorAll('.sm-day-card');

                dayCards.forEach((card) => {
                    if (yPosition > 250) {
                        doc.addPage();
                        yPosition = 20;
                    }

                    // Day header
                    const dayTitle = card.querySelector('.sm-day-title')?.textContent || '';
                    yPosition += 5;
                    doc.setFontSize(11);
                    doc.setTextColor(13, 110, 253);
                    doc.setFillColor(231, 241, 255);
                    doc.rect(margin, yPosition - 4, contentWidth, 8, 'F');
                    doc.text(dayTitle.toUpperCase(), margin + 2, yPosition + 1);
                    yPosition += 8;

                    // Service items
                    const services = card.querySelectorAll('.sm-service');
                    services.forEach((svc) => {
                        if (yPosition > 250) {
                            doc.addPage();
                            yPosition = 20;
                        }

                        doc.setFontSize(9);
                        doc.setTextColor(0, 0, 0);

                        // Service name from header
                        const badge = svc.querySelector('.sm-badge')?.textContent || '';
                        const name = svc.querySelector('.sm-service-name')?.textContent || '';
                        const routeNames = svc.querySelector('.sm-route-names');
                        const concept = name || (routeNames ? routeNames.textContent.trim().replace(/\n+/g, ' → ') : '');

                        doc.text(`• [${badge}] ${concept}`, margin + 5, yPosition);
                        yPosition += 4;

                        // Details (time, vehicle)
                        const details = svc.querySelectorAll('.sm-service-detail');
                        details.forEach((det) => {
                            const text = det.textContent.trim();
                            if (text) {
                                doc.text(`  ${text}`, margin + 8, yPosition);
                                yPosition += 4;
                            }
                        });

                        // Price
                        const price = svc.querySelector('.sm-price')?.textContent?.trim() || '';
                        if (price) {
                            doc.text(`  Precio: ${price}`, margin + 8, yPosition);
                            yPosition += 4;
                        }

                        // Notes
                        const notes = svc.querySelector('.sm-notes')?.textContent?.trim() || '';
                        if (notes) {
                            const noteLines = doc.splitTextToSize(`  Notas: ${notes}`, contentWidth - 10);
                            doc.text(noteLines, margin + 8, yPosition);
                            yPosition += noteLines.length * 4;
                        }

                        yPosition += 3;
                    });
                });
            }

            // Financial Summary
            yPosition += 10;
            if (yPosition > 240) {
                doc.addPage();
                yPosition = 20;
            }

            doc.setFontSize(12);
            doc.setTextColor(13, 110, 253);
            doc.text('RESUMEN FINANCIERO', margin, yPosition);
            yPosition += 8;

            // Draw totals box
            const boxHeight = 25;
            doc.setDrawColor(13, 110, 253);
            doc.setLineWidth(0.5);
            doc.rect(margin, yPosition, contentWidth, boxHeight);

            doc.setFontSize(10);
            doc.setTextColor(0, 0, 0);
            
            const subtotal = document.getElementById('summarySubtotal')?.textContent || '$0.00';
            const iva = document.getElementById('summaryIVA')?.textContent || '$0.00';
            const total = document.getElementById('summaryTotal')?.textContent || '$0.00';

            yPosition += 6;
            doc.text('Subtotal:', margin + 5, yPosition);
            doc.text(subtotal, pageWidth - margin - 5, yPosition, { align: 'right' });
            
            yPosition += 5;
            doc.text('IVA (16%):', margin + 5, yPosition);
            doc.text(iva, pageWidth - margin - 5, yPosition, { align: 'right' });
            
            yPosition += 5;
            doc.setDrawColor(13, 110, 253);
            doc.line(margin + 5, yPosition, pageWidth - margin - 5, yPosition);
            
            yPosition += 5;
            doc.setFontSize(12);
            doc.setTextColor(13, 110, 253);
            doc.text('TOTAL:', margin + 5, yPosition);
            doc.text(total, pageWidth - margin - 5, yPosition, { align: 'right' });

            // Footer
            yPosition += 15;
            doc.setFontSize(9);
            doc.setTextColor(100, 100, 100);
            const footerText = 'Agradecemos su preferencia y quedamos a sus órdenes para cualquier duda o comentario';
            const footerLines = doc.splitTextToSize(footerText, contentWidth);
            doc.text(footerLines, margin, yPosition, { align: 'center' });

            // Add metadata (Cotización vs Reservación based on folio prefix)
            const isReservacion = !/^QTE-/i.test(folio);
            const docLabel = isReservacion ? 'Reservación' : 'Cotización';
            doc.setProperties({
                title: `${docLabel} ${folio}`,
                subject: `${docLabel} Amexing Experience`,
                author: 'Amexing Experience',
                keywords: `${docLabel.toLowerCase()}, transporte, servicios`,
                creator: 'AmexingWeb Platform'
            });

            // Save the PDF
            doc.save(filename);
            
            console.log('PDF generated successfully with manual jsPDF');
            return true;

        } catch (error) {
            console.error('Error generating PDF with jsPDF:', error);
            return false;
        } finally {
            // Restore button
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    }

    // html2pdf approach with content loading and visibility handling
    function tryHtml2PdfExport() {
        if (typeof html2pdf === 'undefined') {
            alert('No se pudo cargar ninguna librería de PDF. Por favor recargue la página.');
            return;
        }

        const element = document.getElementById('summaryContent');
        const loadingElement = document.getElementById('summaryLoading');
        const folio = document.getElementById('summaryFolio').textContent || 'cotizacion';
        const docKind = /^QTE-/i.test(folio) ? 'Cotizacion' : 'Reservacion';
        const filename = `${folio.replace(/\s+/g, '_')}.pdf`;

        // Check if element exists
        if (!element) {
            alert('Error: No se encontró el contenido del resumen.');
            return;
        }

        // UI feedback
        const btn = document.getElementById('exportPdfBtn');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generando PDF...';
        btn.disabled = true;

        // Check if content is loaded and visible
        const isContentVisible = element.style.display !== 'none';
        const isLoading = loadingElement && loadingElement.style.display !== 'none';
        
        if (!isContentVisible || isLoading) {
            // Content not ready - trigger loading and wait
            console.log('Content not ready, loading quote summary...');
            
            loadQuoteSummary().then(() => {
                // Wait a bit more for rendering to complete
                setTimeout(() => {
                    proceedWithPdfExport();
                }, 500);
            }).catch(error => {
                console.error('Error loading quote summary:', error);
                btn.innerHTML = originalText;
                btn.disabled = false;
                alert('Error al cargar el contenido. Por favor intente nuevamente.');
            });
            return;
        }

        // Content is ready, proceed immediately
        proceedWithPdfExport();

        function proceedWithPdfExport() {
            // Store original visibility for restoration
            const originalDisplay = element.style.display;
            
            try {
                // Ensure element is visible for PDF generation
                if (element.style.display === 'none') {
                    element.style.display = 'block';
                }

                // High-quality html2pdf options
                const opt = {
                    margin: 10,
                    filename: filename,
                    image: { type: 'png', quality: 1.0 },
                    html2canvas: { 
                        scale: 3,                    // High resolution (3x for crisp text)
                        useCORS: true,              // Allow external images 
                        allowTaint: false,          // Better CORS handling
                        letterRendering: true,      // Better text rendering
                        logging: false,             // Disable console logs
                        windowWidth: 1200,          // Higher reference width
                        windowHeight: 800,          // Adequate height
                        scrollX: 0,
                        scrollY: 0,
                        backgroundColor: '#ffffff',
                        foreignObjectRendering: true, // Better for complex layouts
                        imageTimeout: 15000,        // Wait longer for images
                        removeContainer: true       // Clean up after rendering
                    },
                    jsPDF: { 
                        unit: 'mm', 
                        format: 'letter',           // US Letter for consistency 
                        orientation: 'portrait',
                        compress: true,
                        precision: 16               // Higher precision for better quality
                    }
                };

                html2pdf()
                    .set(opt)
                    .from(element)
                    .save()
                    .then(() => {
                        console.log('PDF generated successfully with html2pdf');
                    })
                    .catch((error) => {
                        console.error('Error generating PDF:', error);
                        alert('Error al generar el PDF. Por favor intente nuevamente.');
                    })
                    .finally(() => {
                        // Restore original visibility
                        if (originalDisplay) {
                            element.style.display = originalDisplay;
                        }
                        
                        // Restore button
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    });
            } catch (error) {
                console.error('Error in PDF export setup:', error);
                // Restore original visibility
                if (originalDisplay) {
                    element.style.display = originalDisplay;
                }
                
                // Restore button
                btn.innerHTML = originalText;
                btn.disabled = false;
                alert('Error al configurar la exportación PDF.');
            }
        }
    }

    // Send quote email - modal with multiple recipients
    function showSendEmailModal(quoteObj) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const emails = [];

        // Remove existing modal if any
        document.getElementById('sendEmailModal')?.remove();

        const modalHtml = `
        <div class="modal fade" id="sendEmailModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="ti ti-mail me-2"></i>Enviar <%= e %> por correo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Destinatarios <span class="text-muted small">(máx. 10)</span></label>
                        <div class="input-group mb-2">
                            <input type="email" class="form-control" id="emailRecipientInput" placeholder="correo@ejemplo.com">
                            <button class="btn btn-outline-primary" type="button" id="addEmailBtn">Agregar</button>
                        </div>
                        <div id="emailValidationMsg" class="text-danger small mb-2 d-none"></div>
                        <div id="emailChipsContainer" class="d-flex flex-wrap gap-2 mb-3"></div>
                        <div id="emailCount" class="text-muted small">0 destinatario(s)</div>
                        <div id="sendEmailResults" class="mt-3 d-none"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-primary" id="confirmSendEmailBtn" disabled>
                            <i class="ti ti-send me-1"></i>Enviar
                        </button>
                    </div>
                </div>
            </div>
        </div>`;

        document.body.insertAdjacentHTML('beforeend', modalHtml);
        const modal = new bootstrap.Modal(document.getElementById('sendEmailModal'));

        const input = document.getElementById('emailRecipientInput');
        const addBtn = document.getElementById('addEmailBtn');
        const chipsContainer = document.getElementById('emailChipsContainer');
        const countEl = document.getElementById('emailCount');
        const validationMsg = document.getElementById('emailValidationMsg');
        const confirmBtn = document.getElementById('confirmSendEmailBtn');

        function updateCount() {
            countEl.textContent = `${emails.length} destinatario(s)`;
            confirmBtn.disabled = emails.length === 0;
        }

        function addEmail(email) {
            const trimmed = email.trim().toLowerCase();
            validationMsg.classList.add('d-none');

            if (!trimmed) return;
            if (!emailRegex.test(trimmed)) {
                validationMsg.textContent = 'Formato de correo inválido';
                validationMsg.classList.remove('d-none');
                return;
            }
            if (emails.includes(trimmed)) {
                validationMsg.textContent = 'Este correo ya fue agregado';
                validationMsg.classList.remove('d-none');
                return;
            }
            if (emails.length >= 10) {
                validationMsg.textContent = 'Máximo 10 destinatarios';
                validationMsg.classList.remove('d-none');
                return;
            }

            emails.push(trimmed);
            const chip = document.createElement('span');
            chip.className = 'badge bg-primary d-flex align-items-center gap-1';
            chip.style.fontSize = '0.85rem';
            chip.innerHTML = `${trimmed} <button type="button" class="btn-close btn-close-white" style="font-size: 0.5rem;" aria-label="Quitar"></button>`;
            chip.querySelector('.btn-close').addEventListener('click', () => {
                const idx = emails.indexOf(trimmed);
                if (idx > -1) emails.splice(idx, 1);
                chip.remove();
                updateCount();
            });
            chipsContainer.appendChild(chip);
            input.value = '';
            updateCount();
        }

        addBtn.addEventListener('click', () => addEmail(input.value));
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); addEmail(input.value); }
        });

        // Pre-populate contactEmail
        if (quoteObj.contactEmail) {
            addEmail(quoteObj.contactEmail);
        }

        confirmBtn.addEventListener('click', () => sendQuoteEmailToRecipients(quoteObj, emails, modal));

        // Cleanup on close
        document.getElementById('sendEmailModal').addEventListener('hidden.bs.modal', () => {
            document.getElementById('sendEmailModal')?.remove();
        });

        modal.show();
        input.focus();
    }

    async function sendQuoteEmailToRecipients(quoteObj, emailsArray, modal) {
        const confirmBtn = document.getElementById('confirmSendEmailBtn');
        const resultsDiv = document.getElementById('sendEmailResults');
        const originalHtml = confirmBtn.innerHTML;
        confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Enviando...';
        confirmBtn.disabled = true;

        try {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            const response = await fetch(`/api/quotes/${quoteObj.id}/send-email`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ recipients: emailsArray }),
            });
            const result = await response.json();

            if (result.data?.results) {
                const items = result.data.results.map((r) =>
                    `<div class="${r.success ? 'text-success' : 'text-danger'} small">
                        <i class="ti ti-${r.success ? 'check' : 'x'} me-1"></i>${r.email}${r.error ? ` - ${r.error}` : ''}
                    </div>`
                ).join('');
                resultsDiv.innerHTML = `<strong class="small">${result.message}</strong>${items}`;
                resultsDiv.classList.remove('d-none');

                if (result.success && result.data.totalFailed === 0) {
                    setTimeout(() => modal.hide(), 2000);
                }
            } else if (result.success) {
                resultsDiv.innerHTML = `<div class="text-success small">${result.message || 'Correo enviado exitosamente'}</div>`;
                resultsDiv.classList.remove('d-none');
                setTimeout(() => modal.hide(), 2000);
            } else {
                resultsDiv.innerHTML = `<div class="text-danger small">${result.error || 'Error al enviar correo'}</div>`;
                resultsDiv.classList.remove('d-none');
            }
        } catch (err) {
            console.error('Send email error:', err);
            resultsDiv.innerHTML = '<div class="text-danger small">Error al enviar correo</div>';
            resultsDiv.classList.remove('d-none');
        }

        confirmBtn.innerHTML = originalHtml;
        confirmBtn.disabled = false;
    }

    // Generate share link function
    async function generateShareLink(quoteId) {
        try {
            // Show loading state
            const btn = document.getElementById('shareLinkBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generando...';
            btn.disabled = true;

            // Get CSRF token from meta tag or cookie
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

            // Call API to generate share link (credentials: 'include' sends cookies automatically)
            const response = await fetch(`/api/quotes/${quoteId}/share-link`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                credentials: 'include' // Important: sends cookies (JWT token) automatically
            });

            const result = await response.json();

            // Restore button state
            btn.innerHTML = originalText;
            btn.disabled = false;

            if (!response.ok || !result.success) {
                throw new Error(result.error || 'Error al generar el enlace');
            }

            // Show modal with share link
            showShareModal(result.data);

        } catch (error) {
            console.error('Error generating share link:', error);
            alert(`Error al generar enlace: ${error.message}`);

            // Restore button state
            const btn = document.getElementById('shareLinkBtn');
            btn.innerHTML = '<i class="ti ti-share me-2"></i>Compartir';
            btn.disabled = false;
        }
    }

    // Show share modal with copy functionality
    function showShareModal(data) {
        // Create modal HTML
        const modalHtml = `
            <div class="modal fade" id="shareLinkModal" tabindex="-1" aria-labelledby="shareLinkModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title" id="shareLinkModalLabel">
                                <i class="ti ti-share me-2"></i>Enlace de Compartir
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted mb-3">
                                <i class="ti ti-info-circle me-2"></i>
                                Comparta este enlace con su cliente para que pueda ver la <%= e %> sin necesidad de iniciar sesión.
                            </p>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Folio</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" value="${data.folio}" readonly>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">URL Pública</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="shareUrlInput" value="${data.shareUrl}" readonly>
                                    <button class="btn btn-outline-primary" type="button" id="copyShareUrlBtn">
                                        <i class="ti ti-copy me-1"></i>Copiar
                                    </button>
                                </div>
                                <small class="text-muted">
                                    <i class="ti ti-lock-open me-1"></i>
                                    Este enlace es público y no requiere autenticación
                                </small>
                            </div>

                            <div class="alert alert-info mb-0">
                                <i class="ti ti-bulb me-2"></i>
                                <strong>Consejo:</strong> Puede copiar este enlace y enviarlo por correo electrónico o WhatsApp a su cliente.
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <a href="${data.shareUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                                <i class="ti ti-external-link me-2"></i>Abrir en Nueva Pestaña
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        `;

        // Remove existing modal if any
        const existingModal = document.getElementById('shareLinkModal');
        if (existingModal) {
            existingModal.remove();
        }

        // Insert modal into DOM
        document.body.insertAdjacentHTML('beforeend', modalHtml);

        // Get modal element and show it
        const modalElement = document.getElementById('shareLinkModal');
        const modal = new bootstrap.Modal(modalElement);
        modal.show();

        // Attach copy button event listener
        document.getElementById('copyShareUrlBtn').addEventListener('click', () => {
            const input = document.getElementById('shareUrlInput');
            input.select();
            input.setSelectionRange(0, 99999); // For mobile devices

            // Copy to clipboard
            navigator.clipboard.writeText(input.value).then(() => {
                const btn = document.getElementById('copyShareUrlBtn');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="ti ti-check me-1"></i>¡Copiado!';
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-success');

                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-outline-primary');
                }, 2000);
            }).catch(err => {
                console.error('Error copying to clipboard:', err);
                alert('Error al copiar el enlace. Por favor cópielo manualmente.');
            });
        });

        // Clean up modal when hidden
        modalElement.addEventListener('hidden.bs.modal', () => {
            modalElement.remove();
        });
    }

</script>
