<!-- Services Renderer Scripts. Cache-bust (?v=Date.now) para evitar servir versiones viejas del
     JS estático: sin esto, un renderer cacheado sin getServiceTip rompía el resumen tras deploy. -->
<script src="/js/services-renderer-config.js?v=<%= Date.now() %>"></script>
<script src="/js/services-renderer.js?v=<%= Date.now() %>"></script>

<script>
    // Entity label (client-side): "Reservación" once the quote is scheduled.
    const QE = window.__isReservation ? 'Reservación' : 'Cotización';
    const Qe = window.__isReservation ? 'reservación' : 'cotización';
    // Currency formatter
    const currencyFormatter = new Intl.NumberFormat('es-MX', {
        style: 'currency',
        currency: 'MXN',
        minimumFractionDigits: 2
    });
    
    // Segment mappings cache
    let segmentMappings = {};
    // Full rates cache (array of {value, label, color}) — used by the unified renderer
    // to resolve segment colors for the colored chip display.
    let ratesCache = [];
    
    // Fetch and cache segment mappings from API
    async function fetchSegmentMappings() {
        try {
            // Get access token using comprehensive method (same as ServicesRenderer)
            let accessToken = getAccessTokenComprehensive();
            
            if (!accessToken) {
                console.warn('❌ Quote Summary: No access token available for fetching rate mappings - will use static fallbacks only');
                return;
            }
            
            console.log('🔍 Fetching rate mappings from /api/rates/active...');
            const ratesResponse = await fetch('/api/rates/active', {
                headers: {
                    'Authorization': `Bearer ${accessToken}`,
                    'Content-Type': 'application/json'
                }
            });
            
            if (ratesResponse.ok) {
                const result = await ratesResponse.json();
                if (result.success && result.data) {
                    console.log(`📊 Processing ${result.data.length} rates for ObjectId mapping...`);
                    // Keep the raw rates so the renderer can resolve segment colors
                    ratesCache = result.data;
                    
                    result.data.forEach(rate => {
                        // Log the first rate to understand structure
                        if (!window.rateStructureLogged) {
                            console.log('📊 Rate structure example:', rate);
                            window.rateStructureLogged = true;
                        }
                        
                        // The key insight: rate.value contains the Rate ObjectId
                        // and rate.label contains the Rate display name
                        const rateId = rate.value;  // This is the ObjectId like "yipmABp1UZ" 
                        const rateName = rate.label; // This is the name like "First Class"
                        
                        if (rateId && rateName) {
                            segmentMappings[rateId] = rateName;
                            
                            // Log specific problematic IDs to confirm mapping
                            if (['yipmABp1UZ', 'JGEgJ4gr9G', 'ox5gO8c9ok'].includes(rateId)) {
                                console.log(`✅ Mapped rate ObjectId: ${rateId} -> ${rateName}`);
                            }
                        }
                        
                        // Also map alternative ID fields just in case
                        const alternativeIds = [rate.id, rate.objectId].filter(Boolean);
                        alternativeIds.forEach(altId => {
                            if (altId && altId !== rateId && rateName) {
                                segmentMappings[altId] = rateName;
                            }
                        });
                    });
                    
                    console.log('✅ Rate ObjectId mappings loaded:', Object.keys(segmentMappings).length);
                    console.log('📝 Sample mappings:', Object.entries(segmentMappings).slice(0, 5));
                    
                    // Verify problematic IDs are now mapped
                    ['yipmABp1UZ', 'JGEgJ4gr9G', 'ox5gO8c9ok'].forEach(id => {
                        if (segmentMappings[id]) {
                            console.log(`✅ ${id} successfully mapped to: ${segmentMappings[id]}`);
                        } else {
                            console.log(`❌ ${id} still not found in mappings`);
                        }
                    });
                } else {
                    console.error('❌ Invalid rates API response structure:', result);
                }
            } else {
                console.error('❌ Failed to fetch rates:', ratesResponse.status, ratesResponse.statusText);
                // If API fails, ensure we still have some basic static mappings
                if (Object.keys(segmentMappings).length === 0) {
                    console.log('🔄 API failed, loading minimal static mappings as fallback...');
                    segmentMappings = {
                        'ox5gO8c9ok': 'First Class',
                        'yipmABp1UZ': 'Premium', 
                        'JGEgJ4gr9G': 'Green Class'
                    };
                }
            }
            
        } catch (error) {
            console.error('❌ Error fetching rate mappings:', error);
            // Ensure we have some basic static mappings even if API completely fails
            if (Object.keys(segmentMappings).length === 0) {
                console.log('🔄 Network error, loading minimal static mappings as fallback...');
                segmentMappings = {
                    'ox5gO8c9ok': 'First Class',
                    'yipmABp1UZ': 'Premium', 
                    'JGEgJ4gr9G': 'Green Class'
                };
            }
        }
    }

    // Date formatter for Spanish
    function formatDateSpanish(date) {
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        return new Date(date).toLocaleDateString('es-MX', options);
    }

    // Robust cookie getter function
    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) {
            const cookieValue = parts.pop().split(';').shift();
            if (cookieValue) {
                console.log(`✅ Quote Summary: Found cookie ${name} with value length:`, cookieValue.length);
                return cookieValue;
            }
        }
        return null;
    }

    // Get access token with comprehensive fallback logic and enhanced debugging
    function getAccessTokenComprehensive() {
        // Enhanced debugging - show all available cookies
        console.log('🔍 Quote Summary: Starting token lookup...');
        console.log('🔍 Quote Summary: Raw document.cookie:', document.cookie);
        console.log('🔍 Quote Summary: Cookie breakdown:', 
            document.cookie.split(';').map((c, i) => {
                const trimmed = c.trim();
                const [name, value] = trimmed.split('=');
                return { 
                    index: i, 
                    name: name || '(empty)', 
                    hasValue: !!value, 
                    valueLength: value?.length || 0,
                    rawContent: trimmed.substring(0, 50) + (trimmed.length > 50 ? '...' : '')
                };
            })
        );

        // First try to get from window variable (passed from server)
        if (typeof window !== 'undefined' && window.quoteAccessToken) {
            // Set the cookie for future requests since middleware expects it
            document.cookie = `accessToken=${window.quoteAccessToken}; path=/; SameSite=Lax`;
            console.log('✅ Quote Summary: Using token from window.quoteAccessToken');
            return window.quoteAccessToken;
        }

        // Try robust cookie parsing for common token cookie names
        const tokenCookieNames = ['accessToken', 'clientAccessToken', 'client_access_token', 'authToken'];
        for (const cookieName of tokenCookieNames) {
            const tokenValue = getCookie(cookieName);
            if (tokenValue) {
                console.log(`✅ Quote Summary: Using token from ${cookieName} cookie`);
                return tokenValue;
            } else {
                console.log(`❌ Quote Summary: No value found for ${cookieName} cookie`);
            }
        }

        // Fallback to old parsing method (in case of parsing differences)
        console.log('🔍 Quote Summary: Trying fallback cookie parsing...');
        const cookies = document.cookie.split(';');
        for (const cookie of cookies) {
            const [name, value] = cookie.trim().split('=');
            console.log(`🔍 Quote Summary: Checking cookie - name: '${name}', hasValue: ${!!value}, valueLength: ${value?.length || 0}`);
            if (name === 'accessToken' && value) {
                console.log('✅ Quote Summary: Using token from accessToken cookie (fallback method)');
                return value;
            }
            if (name === 'clientAccessToken' && value) {
                console.log('✅ Quote Summary: Using token from clientAccessToken cookie (fallback method)');
                return value;
            }
        }

        // Try localStorage/sessionStorage with various keys (with enhanced logging)
        console.log('🔍 Quote Summary: Checking localStorage/sessionStorage...');
        const tokenSources = [
            { source: 'localStorage.accessToken', getter: () => localStorage.getItem('accessToken') },
            { source: 'sessionStorage.accessToken', getter: () => sessionStorage.getItem('accessToken') },
            { source: 'localStorage.token', getter: () => localStorage.getItem('token') },
            { source: 'sessionStorage.token', getter: () => sessionStorage.getItem('token') },
            { source: 'localStorage.clientAccessToken', getter: () => localStorage.getItem('clientAccessToken') },
            { source: 'sessionStorage.clientAccessToken', getter: () => sessionStorage.getItem('clientAccessToken') }
        ];

        for (const tokenSource of tokenSources) {
            try {
                const token = tokenSource.getter();
                console.log(`🔍 Quote Summary: Checking ${tokenSource.source} - hasValue: ${!!token}, length: ${token?.length || 0}`);
                if (token) {
                    console.log(`✅ Quote Summary: Using token from ${tokenSource.source}`);
                    return token;
                }
            } catch (error) {
                console.warn(`⚠️ Quote Summary: Error accessing ${tokenSource.source}:`, error.message);
            }
        }

        // Try original getAccessToken function as fallback
        try {
            const token = getAccessToken();
            if (token) {
                console.log('✅ Quote Summary: Using token from legacy getAccessToken()');
                return token;
            }
        } catch (error) {
            console.warn('⚠️ Quote Summary: Error calling getAccessToken():', error.message);
        }

        console.warn('❌ Quote Summary: No authentication token found in any source:', {
            windowQuoteAccessToken: !!(window.quoteAccessToken),
            rawCookieString: document.cookie,
            cookieCount: document.cookie.split(';').length,
            checkedSources: tokenSources.map(s => s.source),
            checkedCookieNames: ['accessToken', 'clientAccessToken', 'client_access_token', 'authToken'],
            browserInfo: {
                userAgent: navigator.userAgent,
                url: window.location.href,
                domain: window.location.hostname
            }
        });
        return null;
    }

    // Get access token with retry logic (legacy function - kept for compatibility)
    function getAccessToken() {
        return document.cookie
            .split('; ')
            .find(row => row.startsWith('accessToken='))
            ?.split('=')[1];
    }

    // Wait for access token to be available (handles timing issues on page reload)
    async function waitForAccessToken(maxRetries = 5, delayMs = 100) {
        for (let i = 0; i < maxRetries; i++) {
            const token = getAccessToken();
            if (token) {
                console.debug('Access token found for summary cache loading');
                return token;
            }
            console.debug(`Waiting for access token... attempt ${i + 1}/${maxRetries}`);
            await new Promise(resolve => setTimeout(resolve, delayMs));
        }
        console.warn('Access token not available after retries - cache loading may fail');
        return null;
    }

    // Experience cache variables
    let experiencesCache = [];
    let providerExperiencesCache = [];

    // Load regular experiences cache with enhanced error handling
    async function loadExperiencesCache() {
        try {
            console.debug('Loading experiences cache for summary...');
            const token = await waitForAccessToken();
            if (!token) {
                console.warn('No access token available - skipping experiences cache loading');
                experiencesCache = [];
                return;
            }

            const response = await fetch('/api/experiences?draw=1&start=0&length=1000&search[value]=', {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            if (response.ok) {
                const result = await response.json();
                experiencesCache = result.data || [];
                console.debug(`Loaded ${experiencesCache.length} experiences for summary`);
                
                // Validate data structure
                if (experiencesCache.length > 0) {
                    const sampleExp = experiencesCache[0];
                    console.debug('Sample experience data:', { 
                        id: sampleExp.id, 
                        hasProvider: !!sampleExp.provider,
                        providerType: sampleExp.provider?.type 
                    });
                }
            } else {
                console.warn(`Failed to load experiences: ${response.status} ${response.statusText}`);
                experiencesCache = [];
            }
        } catch (error) {
            console.error('Error loading experiences cache for summary:', error);
            experiencesCache = [];
        }
    }

    // Load provider experiences cache with enhanced error handling
    async function loadProviderExperiencesCache() {
        try {
            console.debug('Loading provider experiences cache for summary...');
            const token = await waitForAccessToken();
            if (!token) {
                console.warn('No access token available - skipping provider experiences cache loading');
                providerExperiencesCache = [];
                return;
            }

            const response = await fetch('/api/provider-experiencias/all', {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            if (response.ok) {
                const result = await response.json();
                if (result.success && result.data) {
                    providerExperiencesCache = result.data;
                } else if (result.data && Array.isArray(result.data)) {
                    providerExperiencesCache = result.data;
                } else if (Array.isArray(result)) {
                    providerExperiencesCache = result;
                } else {
                    console.warn('Unexpected provider experiences response format:', result);
                    providerExperiencesCache = [];
                }
                
                console.debug(`Loaded ${providerExperiencesCache.length} provider experiences for summary`);
                
                // Validate data structure
                if (providerExperiencesCache.length > 0) {
                    const sampleExp = providerExperiencesCache[0];
                    console.debug('Sample provider experience data:', { 
                        id: sampleExp.id, 
                        hasProvider: !!sampleExp.provider,
                        providerType: sampleExp.provider?.type 
                    });
                }
            } else {
                console.warn(`Failed to load provider experiences: ${response.status} ${response.statusText}`);
                providerExperiencesCache = [];
            }
        } catch (error) {
            console.error('Error loading provider experiences cache for summary:', error);
            providerExperiencesCache = [];
        }
    }

    // Load quote summary
    async function loadQuoteSummary() {
        try {
            let quote;
            
            <% if (locals.isPublicView && locals.quote) { %>
            // For public views, use the server-provided quote data
            quote = <%- JSON.stringify(locals.quote) %>;
            console.log('Using server-provided quote data:', quote);
            <% } else { %>
            // For authenticated views, fetch via API
            const quoteId = '<%= quoteId %>';
            const token = getAccessToken();

            const response = await fetch(`/api/quotes/${quoteId}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();

            if (!result.success || !result.data) {
                throw new Error(result.error || `Error al cargar la ${Qe}`);
            }

            quote = result.data;
            console.log('Quote data loaded via API:', quote);
            <% } %>

            // Populate summary information
            // Once scheduled, show the reservation folio instead of the quote folio.
            const __isReservationView = window.__isReservation;
            const __folioLabel = (__isReservationView && window.__reservationFolio)
                ? window.__reservationFolio
                : (quote.folio || quote.id || 'N/A');
            document.getElementById('summaryFolio').textContent = __folioLabel;
            // Green banner shows the document type word (the folio is already
            // displayed in its own "Folio" row below).
            document.getElementById('summaryFolioHeader').textContent = __isReservationView
                ? 'Reservación'
                : 'Cotización';
            document.getElementById('summaryLastUpdated').textContent = formatDateSpanish(quote.updatedAt);
            // "Atención a":
            //  - AGENCIA: el propietario del quote (el agente que lo gestiona). El "Cliente" (la
            //    agencia) se muestra en su propio campo.
            //  - CLIENTE DIRECTO (end_client): el CLIENTE mismo — el "Cliente" se oculta y el
            //    destinatario del documento es el cliente. NO el propietario, que puede ser el
            //    admin/agente que creó la cotización (p. ej. "Admin User").
            //  Fallback en ambos: contactPerson → '-'.
            const summaryContactPersonElement = document.getElementById('summaryContactPerson');
            if (summaryContactPersonElement) {
                const owner = quote.owner || {};
                const ownerFullName = [owner.firstName, owner.lastName]
                    .map((s) => String(s || '').trim())
                    .filter(Boolean)
                    .join(' ')
                    .trim();
                const contactPerson = (quote.contactPerson || '').trim();
                const contactValue = contactPerson && contactPerson.toLowerCase() !== 'no especificado'
                    ? contactPerson
                    : '';
                let attnName = ownerFullName;
                if (quote.clientType === 'direct' && quote.client) {
                    const c = quote.client;
                    const directClientName = (c.companyName
                        || c.name
                        || `${c.firstName || ''} ${c.lastName || ''}`.trim()).trim();
                    if (directClientName) attnName = directClientName;
                }
                summaryContactPersonElement.textContent = attnName || contactValue || '-';
            }

            // Quote details — omit the "Motivo de viaje" row entirely when no event type was provided
            const summaryEventTypeRow = document.getElementById('summaryEventTypeRow');
            const summaryEventTypeEl = document.getElementById('summaryEventType');
            if (quote.eventType && String(quote.eventType).trim()) {
                summaryEventTypeEl.textContent = quote.eventType;
                summaryEventTypeRow?.classList.remove('d-none');
            } else {
                summaryEventTypeEl.textContent = '';
                summaryEventTypeRow?.classList.add('d-none');
            }
            document.getElementById('summaryNumberOfPeople').textContent = quote.numberOfPeople || '0';

            // Fechas de servicios: de la fecha del primer servicio a la del último. day.date es
            // YYYY-MM-DD (ordena cronológico como string). Se parsea como fecha LOCAL para evitar el
            // corrimiento de -1 día del UTC. Se oculta la fila si no hay días con fecha.
            (() => {
                const datesRow = document.getElementById('summaryServiceDatesRow');
                const datesEl = document.getElementById('summaryServiceDates');
                if (!datesRow || !datesEl) return;
                const dayDates = ((quote.serviceItems && quote.serviceItems.days) || [])
                    .map((d) => d && d.date)
                    .filter(Boolean)
                    .sort();
                if (dayDates.length === 0) {
                    datesEl.textContent = '-';
                    datesRow.classList.add('d-none');
                    return;
                }
                const parseServiceDate = (s) => {
                    if (typeof s === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(s)) {
                        const [y, m, dd] = s.split('-').map(Number);
                        return new Date(y, m - 1, dd);
                    }
                    return new Date(s);
                };
                // Formatea el rango colapsando lo redundante:
                //  - mismo día → "31 de octubre de 2026"
                //  - mismo mes y año → "5 al 12 de julio de 2026"
                //  - mismo año, distinto mes → "31 de octubre – 2 de noviembre de 2026"
                //  - distinto año → "31 de diciembre de 2026 – 2 de enero de 2027"
                const d1 = parseServiceDate(dayDates[0]);
                const d2 = parseServiceDate(dayDates[dayDates.length - 1]);
                const full = (d) => d.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });
                const dayMonth = (d) => d.toLocaleDateString('es-MX', { month: 'long', day: 'numeric' });
                const dayNum = (d) => d.toLocaleDateString('es-MX', { day: 'numeric' });
                let rangeText;
                if (d1.getTime() === d2.getTime()) {
                    rangeText = full(d1);
                } else if (d1.getFullYear() === d2.getFullYear() && d1.getMonth() === d2.getMonth()) {
                    rangeText = `${dayNum(d1)} al ${full(d2)}`;
                } else if (d1.getFullYear() === d2.getFullYear()) {
                    rangeText = `${dayMonth(d1)} – ${full(d2)}`;
                } else {
                    rangeText = `${full(d1)} – ${full(d2)}`;
                }
                datesEl.textContent = rangeText;
                datesRow.classList.remove('d-none');
            })();

            // Idioma de preferencia — show only when set (maps the 2-letter code to a label).
            // Sits between Folio y Última actualización. El número de columnas lo maneja el
            // auto-fit del CSS (.sm-quote-info-row); solo togglear visibilidad.
            const summaryPreferredLanguageRow = document.getElementById('summaryPreferredLanguageRow');
            const summaryPreferredLanguageEl = document.getElementById('summaryPreferredLanguage');
            const preferredLanguage = quote.preferredLanguage && String(quote.preferredLanguage).trim();
            if (preferredLanguage) {
                const languageLabels = {
                    es: 'Español', en: 'English', fr: 'Français', de: 'Deutsch', it: 'Italiano',
                    pt: 'Português', zh: '中文', ja: '日本語', ru: 'Русский', ar: 'العربية',
                };
                summaryPreferredLanguageEl.textContent = languageLabels[preferredLanguage] || preferredLanguage;
                summaryPreferredLanguageRow?.classList.remove('d-none');
            } else {
                summaryPreferredLanguageEl.textContent = '';
                summaryPreferredLanguageRow?.classList.add('d-none');
            }

            // Quote-level notes — show the callout above SERVICIOS only when set
            const quoteNotesBlock = document.getElementById('summaryQuoteNotesBlock');
            const quoteNotesEl = document.getElementById('summaryQuoteNotes');
            if (quote.notes && String(quote.notes).trim()) {
                quoteNotesEl.textContent = quote.notes;
                quoteNotesBlock?.classList.remove('d-none');
            } else {
                quoteNotesEl.textContent = '';
                quoteNotesBlock?.classList.add('d-none');
            }

            // Lead Guest row — prefer the explicit leadGuestFirstName/leadGuestLastName
            // fields; when there's no lead guest, fall back to the final client
            // (cliente final). Hidden when neither is set.
            const buildName = (first, last) => [first, last]
                .map(part => (part || '').trim())
                .filter(Boolean)
                .join(' ');
            const leadGuestName = buildName(quote.leadGuestFirstName, quote.leadGuestLastName);
            const clientFinal = quote.clientFinal || {};
            const clientFinalName = (clientFinal.fullName || '').trim()
                || buildName(clientFinal.firstName, clientFinal.lastName)
                || (clientFinal.name || '').trim()
                || (clientFinal.companyName || '').trim();
            const leadGuestDisplay = leadGuestName || clientFinalName;
            const leadGuestRow = document.getElementById('summaryLeadGuestRow');
            const leadGuestEl = document.getElementById('summaryLeadGuest');
            if (leadGuestEl && leadGuestRow) {
                if (leadGuestDisplay) {
                    leadGuestEl.textContent = leadGuestDisplay;
                    leadGuestRow.classList.remove('d-none');
                } else {
                    leadGuestEl.textContent = '';
                    leadGuestRow.classList.add('d-none');
                }
            }

            // Seguidor de servicio (reservation-level service customer, only for reservations)
            const scRow = document.getElementById('summaryServiceCustomerRow');
            const scEl = document.getElementById('summaryServiceCustomer');
            const sc = quote.reservationServiceCustomer;
            if (scRow && scEl) {
                if (sc && (sc.fullName || sc.email || sc.phone)) {
                    const contact = [sc.phone, sc.email].filter(Boolean).join(' · ');
                    const photo = sc.profilePhotoUrl
                        ? `<img src="${sc.profilePhotoUrl}" alt="" onerror="this.style.display='none'" style="width:22px;height:22px;border-radius:50%;object-fit:cover;border:1px solid #e9ecef;vertical-align:middle;margin-right:6px;">`
                        : '';
                    scEl.innerHTML = `${photo}<span class="fw-semibold">${sc.fullName || '—'}</span>${contact ? `<span class="text-muted ms-2" style="font-size:0.85rem;">${contact}</span>` : ''}`;
                    scRow.classList.remove('d-none');
                } else {
                    scEl.textContent = '';
                    scRow.classList.add('d-none');
                }
            }

            // Client name
            let clientName = 'No especificado';
            if (quote.client) {
                if (quote.client.companyName) {
                    clientName = quote.client.companyName;
                } else if (quote.client.name) {
                    clientName = quote.client.name;
                } else if (quote.client.firstName || quote.client.lastName) {
                    clientName = `${quote.client.firstName || ''} ${quote.client.lastName || ''}`.trim();
                }
            }
            document.getElementById('summaryClientName').textContent = clientName;

            // Cliente directo (end_client, NO agencia): se oculta el campo "Cliente" y queda solo
            // "Atención a" (que es el cliente). En agencia/otros se mantiene el campo.
            const __isDirectClient = quote.clientType === 'direct';
            const summaryClientItem = document.getElementById('summaryClientItem');
            if (summaryClientItem) summaryClientItem.classList.toggle('d-none', __isDirectClient);

            // Load experience caches for establishment detection (only for authenticated views)
            <% if (!locals.isPublicView) { %>
            await Promise.all([
                loadExperiencesCache(),
                loadProviderExperiencesCache()
            ]);
            <% } %>

            // Store quote data globally for payment type changes
            window.currentQuoteData = quote;
            
            // Fetch segment mappings if not already loaded
            if (Object.keys(segmentMappings).length === 0) {
                await fetchSegmentMappings();
            }
            
            // Render services table
            renderServicesTable(quote.serviceItems, quote.numberOfPeople || 0);

            // Show summary content
            document.getElementById('summaryLoading').style.display = 'none';
            document.getElementById('summaryContent').style.display = 'block';

            // Show and attach Export PDF button (visible in both admin and public views)
            const exportBtn = document.getElementById('exportPdfBtn');
            exportBtn.style.display = 'inline-block';
            const newExportBtn = exportBtn.cloneNode(true);
            exportBtn.parentNode.replaceChild(newExportBtn, exportBtn);
            newExportBtn.addEventListener('click', exportToPdf);

            // Share / Email / Cancel buttons are admin-only
            <% if (!locals.isPublicView) { %>
            // Show and attach share button
            const shareBtn = document.getElementById('shareLinkBtn');
            shareBtn.style.display = 'inline-block';

            // Attach share event listener
            const newShareBtn = shareBtn.cloneNode(true);
            shareBtn.parentNode.replaceChild(newShareBtn, shareBtn);
            newShareBtn.addEventListener('click', () => generateShareLink(quote.id));

            // Show and attach send email button
            const emailBtn = document.getElementById('sendEmailBtn');
            emailBtn.style.display = 'inline-block';
            const newEmailBtn = emailBtn.cloneNode(true);
            emailBtn.parentNode.replaceChild(newEmailBtn, emailBtn);
            newEmailBtn.addEventListener('click', () => showSendEmailModal(quote));

            // La cancelación se maneja ahora desde el segmented control de estado
            // (Estado de la Reservación → Cancelada) en quote-detail.ejs.
            <% } %>

        } catch (error) {
            console.error('Error loading quote summary:', error);
            document.getElementById('summaryLoading').innerHTML = `
                <div class="alert alert-danger">
                    <i class="ti ti-alert-circle me-2"></i>
                    Error al cargar el resumen de la ${Qe}: ${error.message}
                </div>
            `;
        }
    }

    // Render services table
    function renderServicesTable(serviceItems, quoteNumberOfPeople) {
        const container = document.getElementById('summaryServicesCards');
        const numberOfPeople = quoteNumberOfPeople || parseInt(document.getElementById('summaryNumberOfPeople').textContent) || 0;

        // Currency and payment type from saved serviceItems
        const paymentLabels = { efectivo: 'Efectivo', transferencia: 'Transferencia', tarjeta: 'Tarjeta de Crédito/Débito' };
        const savedCurrency = serviceItems?.currency || 'MXN';
        const savedPayment = serviceItems?.paymentType || 'efectivo';
        document.getElementById('summaryCurrency').textContent = savedCurrency;
        document.getElementById('summaryPaymentType').textContent = paymentLabels[savedPayment] || savedPayment;

        if (!serviceItems || !serviceItems.days || serviceItems.days.length === 0) {
            container.innerHTML = `<div class="sm-empty-state">No hay servicios agregados a esta ${Qe}</div>`;
            document.getElementById('summarySubtotal').textContent = currencyFormatter.format(0);
            document.getElementById('summaryIVA').textContent = currencyFormatter.format(0);
            document.getElementById('summaryTotal').textContent = currencyFormatter.format(0);
            document.getElementById('summaryPerPerson').textContent = currencyFormatter.format(0);
            document.getElementById('summaryPersonCount').textContent = `(${numberOfPeople})`;
            return;
        }

        // ONLY use unified renderer - no fallback
        if (typeof ServicesRenderer !== 'undefined' && typeof ServicesRendererConfig !== 'undefined') {
            console.log('✅ Summary: Using unified renderer');
            console.log('📊 Summary: serviceItems structure:', serviceItems);
            
            const renderer = new ServicesRenderer({
                mode: 'summary',
                container: container,
                paymentType: savedPayment,
                formatCurrency: (amount) => currencyFormatter.format(amount),
                formatDate: (date) => {
                    if (!date) return '';
                    // YYYY-MM-DD strings must be parsed as LOCAL dates — `new Date('2026-08-11')`
                    // is UTC midnight, which shifts to the previous day in any negative-offset
                    // timezone (e.g. Mexico City UTC-6) when formatted.
                    let d;
                    if (typeof date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(date)) {
                        const [y, m, day] = date.split('-').map(Number);
                        d = new Date(y, m - 1, day);
                    } else {
                        d = new Date(date);
                    }
                    // es-MX returns the weekday in lowercase ("lunes"); capitalize it.
                    const formatted = new Intl.DateTimeFormat('es-MX', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    }).format(d);
                    return formatted.charAt(0).toUpperCase() + formatted.slice(1);
                },
                segmentMappings: segmentMappings, // Pass segment mappings for ObjectId to name conversion
                ratesCache: ratesCache // Full rates so the renderer can resolve segment colors (rate.color)
            });

            // Normalize the data structure
            const normalizedData = ServicesRendererConfig.normalizeQuoteServices(serviceItems);
            console.log('📊 Summary: normalized data:', normalizedData);
            
            // Render with normalized data
            renderer.renderNormalized(normalizedData);

            // Calculate and update totals — usar los métodos del renderer (mismos que los totales
            // por día) para reflejar descuento + propina por servicio. netSubtotal (sin propinas por
            // servicio) es la base de la propina global.
            let serviceTotal = 0;
            let netSubtotal = 0;
            normalizedData.days.forEach(day => {
                (day.services || []).forEach(svc => {
                    if (svc.includeInTotal === false) return;
                    const net = renderer.getServicePrice(svc);
                    // Guard defensivo: si por caché se cargó un renderer viejo sin getServiceTip, no
                    // reventar todo el resumen (se omite la propina hasta que el JS se refresque).
                    const tip = (typeof renderer.getServiceTip === 'function') ? renderer.getServiceTip(svc) : 0;
                    netSubtotal += net;
                    serviceTotal += net + tip;
                });
            });

            // Fase 2b: propina global de la cotización. Se usa el monto guardado (calculado en la
            // forma de pago guardada) y se muestra en su línea + se suma al total.
            const gtMeta = serviceItems.globalTip;
            const globalTipAmount = (gtMeta && gtMeta.type && Number(gtMeta.value) > 0) ? (Number(gtMeta.amount) || 0) : 0;
            const gtRow = document.getElementById('summaryGlobalTipRow');
            const gtEl = document.getElementById('summaryGlobalTip');
            if (gtRow && gtEl) {
                if (globalTipAmount > 0) {
                    gtEl.textContent = `+${currencyFormatter.format(globalTipAmount)}`;
                    gtRow.classList.remove('d-none');
                } else {
                    gtRow.classList.add('d-none');
                }
            }
            serviceTotal += globalTipAmount;

            // Calculate IVA breakdown based on payment type (matching main services logic)
            let subtotal;
            let iva;
            const total = serviceTotal;

            if (savedPayment === 'efectivo') {
                // Efectivo: no IVA breakdown
                subtotal = total;
                iva = 0;
                // Hide IVA row
                const ivaRow = document.getElementById('summaryIVARow');
                if (ivaRow) {
                    ivaRow.classList.add('d-none');
                }
            } else {
                // Transferencia/Tarjeta: calculate backwards from total (which already includes IVA)
                subtotal = total / 1.16;
                iva = total - subtotal;
                // Show IVA row
                const ivaRow = document.getElementById('summaryIVARow');
                if (ivaRow) {
                    ivaRow.classList.remove('d-none');
                }
            }
            
            const perPerson = numberOfPeople > 0 ? total / numberOfPeople : 0;

            document.getElementById('summarySubtotal').textContent = currencyFormatter.format(subtotal);
            document.getElementById('summaryIVA').textContent = currencyFormatter.format(iva);
            document.getElementById('summaryTotal').textContent = currencyFormatter.format(total);
            document.getElementById('summaryPerPerson').textContent = currencyFormatter.format(perPerson);
            document.getElementById('summaryPersonCount').textContent = `(${numberOfPeople})`;

        } else {
            // Show clear error if renderer is not available
            console.error('❌ Summary: ServicesRenderer or ServicesRendererConfig not available!');
            container.innerHTML = `
                <div class="alert alert-danger">
                    <i class="ti ti-alert-circle me-2"></i>
                    <strong>Error:</strong> El sistema de renderizado no está disponible. 
                    Por favor, recarga la página o contacta al soporte técnico.
                </div>`;
            document.getElementById('summarySubtotal').textContent = currencyFormatter.format(0);
            document.getElementById('summaryIVA').textContent = currencyFormatter.format(0);
            document.getElementById('summaryTotal').textContent = currencyFormatter.format(0);
            document.getElementById('summaryPerPerson').textContent = currencyFormatter.format(0);
            document.getElementById('summaryPersonCount').textContent = `(${numberOfPeople})`;
        }
    }


    // Function to handle payment type changes and recalculate totals
    function handlePaymentTypeChange(newPaymentType) {
        console.log('Payment type changed to:', newPaymentType);
        
