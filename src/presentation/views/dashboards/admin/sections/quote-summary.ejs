<%
/**
 * Quote Summary Section
 * Complete read-only summary of the quote for client viewing and PDF export
 */
const __isRes = typeof isReservation !== 'undefined' && isReservation;
const E = __isRes ? 'Reservación' : 'Cotización';
const e = __isRes ? 'reservación' : 'cotización';
%>

<style>
    /* Summary Styles */
    .quote-summary-container {
        background: #fff;
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    .summary-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .summary-banner-logo img {
        max-width: 250px;
        height: auto;
    }

    .summary-banner-folio {
        font-size: 2.5rem;
        font-weight: 700;
        color: #0d6efd;
        text-align: center;
        letter-spacing: 1px;
        margin: 0;
        line-height: 1.2;
    }

    .summary-banner-address {
        text-align: right;
        color: #495057;
        line-height: 1.6;
    }

    .summary-banner-address div {
        margin-bottom: 0.25rem;
    }

    /* Public Header Styles (matching public quote view) */
    .public-header {
        text-align: center;
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }

    .header-logo {
        margin-bottom: 1.5rem;
    }

    .header-folio {
        margin-top: 1rem;
    }

    .public-header h1 {
        background: #969b81;
        color: white;
        font-size: calc(1.2rem + 1px);
        font-weight: 600;
        letter-spacing: 0.3rem;
        text-transform: uppercase;
        padding: 0.75rem;
        margin: 0;
        display: block;
        border-radius: 0;
        font-family: 'ArponaPDF', var(--font-myriad, 'Myriad Pro'), 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        width: 100%;
        text-align: center;
    }

    .summary-section {
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: #f8f9fa;
        border-radius: 0.5rem;
    }

    .summary-section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #212529;
        margin-bottom: 1rem;
        border-bottom: 2px solid #dee2e6;
        padding-bottom: 0.5rem;
    }

    .summary-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
    }

    .summary-info-item {
        display: flex;
        flex-direction: column;
    }

    .summary-info-label {
        font-weight: 600;
        color: #6c757d;
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }

    .summary-info-value {
        color: #212529;
        font-size: 1rem;
    }

    .summary-attention {
        font-size: 1.5rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #0d6efd;
        padding: 1rem;
        background: #e7f1ff;
        border-radius: 0.5rem;
        text-align: center;
    }

    /* Unified quote info card */
    .sm-quote-info {
        border-radius: 0.5rem;
        margin-bottom: 2rem;
        background: #fff;
    }
    .sm-quote-info-row {
        display: grid;
        /* auto-fit reparte los ítems VISIBLES en una sola fila y los estira parejo (evita que
           "Fechas de servicios" u otro campo opcional quede huérfano solo en un renglón). La 1ra
           fila no se afecta: define su propio grid-template-columns inline. */
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 1rem;
    }
    .sm-quote-info-divider {
        height: 1px;
        background: #e9ecef;
        margin: 1rem 0;
    }
    .sm-quote-info-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        color: #868e96;
        margin-bottom: 0.2rem;
    }
    .sm-quote-info-value {
        font-size: 0.95rem;
        color: #212529;
    }
    @media (max-width: 767.98px) {
        .sm-quote-info-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .summary-table {
        width: 100%;
        margin-bottom: 1rem;
    }

    .summary-table th {
        background: #0d6efd;
        color: #fff;
        font-weight: 600;
        padding: 0.75rem;
        text-align: left;
    }

    .summary-table td {
        padding: 0.75rem;
        border-bottom: 1px solid #dee2e6;
    }

    .summary-day-header {
        background: #e7f1ff;
        font-weight: 600;
        color: #0d6efd;
    }

    .summary-subconcept-row {
        background: #fff;
    }

    .summary-subconcept-row:hover {
        background: #f8f9fa;
    }

    .summary-totals {
        margin-top: 1.5rem;
        padding: 1.5rem;
        background: #fff;
        border: 2px solid #0d6efd;
        border-radius: 0.5rem;
    }

    .summary-total-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        font-size: 1.1rem;
    }

    .summary-total-row.total {
        border-top: 2px solid #0d6efd;
        padding-top: 1rem;
        margin-top: 0.5rem;
        font-weight: 700;
        font-size: 1.5rem;
        color: #0d6efd;
    }

    .summary-footer {
        text-align: center;
        padding: 2rem;
        color: #6c757d;
        margin-top: 2rem;
        letter-spacing: 0.3rem;
    }

    .experience-included-list {
        margin: 0.5rem 0 0 1.5rem;
        padding: 0;
        list-style: none;
    }

    .experience-included-list li {
        padding: 0.25rem 0;
        color: #6c757d;
        font-size: 0.875rem;
    }

    .experience-included-list li:before {
        content: "✓ ";
        color: #198754;
        font-weight: bold;
        margin-right: 0.5rem;
    }

    /* Summary Day Cards */
    .sm-day-card { border: 1px solid #e9ecef; border-radius: 0.5rem; overflow: hidden; margin-bottom: 1.5rem; }
    .sm-day-header { background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%); padding: 1rem 1.25rem; border-bottom: 1px solid #e9ecef; display: flex; align-items: center; }
    .sm-day-badge { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #f76b1c 0%, #fa984f 100%); color: white; font-weight: 700; font-size: 0.9rem; margin-right: 0.75rem; flex-shrink: 0; }
    .sm-day-title { font-size: 1.1rem; font-weight: 600; color: #212529; }
    .sm-services { padding: 0.75rem 1.25rem; }
    .sm-service { display: flex; justify-content: space-between; align-items: flex-start; padding: 0.75rem; margin-bottom: 0.5rem; border-radius: 0.375rem; background: #fafbfc; border-left: 4px solid #dee2e6; flex-wrap: wrap; }
    .sm-service:last-child { margin-bottom: 0; }
    .sm-service-info { flex: 1; min-width: 0; }
    .sm-service-img { width: 100%; margin-top: 0.5rem; border-radius: 0.5rem; max-height: 180px; object-fit: cover; }
    .sm-service-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; flex-wrap: wrap; }
    .sm-badge { display: inline-block; padding: 0.15em 0.5em; border-radius: 0.25rem; font-size: 0.7rem; font-weight: 600; }
    .sm-service-name { font-weight: 600; font-size: 0.9rem; color: #212529; }
    .sm-service-detail { font-size: 0.8rem; color: #6c757d; display: flex; align-items: center; gap: 0.25rem; margin-top: 0.2rem; }
    .sm-route { display: flex; align-items: flex-start; gap: 0.5rem; margin-top: 0.25rem; }
    .sm-route-dots { display: flex; flex-direction: column; align-items: center; min-width: 14px; padding-top: 2px; }
    .sm-route-line { width: 1.5px; height: 14px; background: linear-gradient(to bottom, #198754, #dc3545); }
    .sm-route-names { font-size: 0.85rem; line-height: 1.5; }
    .sm-price { font-weight: 600; font-size: 0.9rem; white-space: nowrap; margin-left: 1rem; text-align: right; }
    .sm-price .sm-payment { display: block; font-size: 0.7rem; font-weight: 500; }
    .sm-notes { font-size: 0.78rem; color: #868e96; font-style: italic; margin-top: 0.2rem; }
    .sm-day-footer { padding: 0.75rem 1.25rem; background: #f8f9fa; border-top: 1px solid #e9ecef; text-align: right; font-weight: 700; font-size: 1rem; }
    .sm-included-list { list-style: none; padding: 0; margin: 0.25rem 0 0 0; font-size: 0.8rem; }
    .sm-included-list li { color: #198754; padding: 0.1rem 0; }
    .sm-included-list li::before { content: "✓ "; font-weight: bold; margin-right: 0.25rem; }
    .sm-empty-state { text-align: center; color: #adb5bd; padding: 3rem 1rem; font-size: 0.95rem; }

    /* Services section - clean white card */
    .sm-services-section {
        margin-bottom: 1.5rem;
    }
    .sm-section-title {
        font-size: 1.1rem;
        letter-spacing: 0.3rem;
        font-weight: 600;
        color: #212529;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
    }

    /* Totals card */
    .sm-totals-card {
        border-radius: 0.5rem;
        background: #fff;
        margin-bottom: 2rem;
    }
    .sm-totals-meta {
        display: flex;
        gap: 2rem;
        margin-bottom: 0;
    }
    .sm-totals-meta-item {
        font-size: 1.1rem;
        color: #6c757d;
    }
    .sm-totals-meta-item strong {
        color: #212529;
    }
    .sm-totals-divider {
        height: 1px;
        background: #e9ecef;
        margin: 0.75rem 0;
    }
    .sm-totals-row {
        display: flex;
        justify-content: space-between;
        padding: 0.35rem 0;
        font-size: 1rem;
        color: #495057;
    }
    .sm-totals-subtotal {
        font-size: 1.1rem;
        color: #212529;
        padding: 0.75rem;
        border: 2px solid #ffffff;
        border-radius: 0.375rem;
        margin-top: 0.5rem;
    }
    .sm-totals-iva {
        font-size: 1.1rem;
        color: #212529;
        padding: 0.75rem;
        border: 2px solid #ffffff;
        border-radius: 0.375rem;
        margin-top: 0.5rem;
    }
    .sm-totals-grand {
        font-weight: 600;
        font-size: calc(1.1rem + 1px);
        color: #212529;
        padding: 0.75rem;
        border: 2px solid #969b81;
        border-radius: 0.375rem;
        margin-top: 0.5rem;
    }
    .sm-totals-per-person {
        font-weight: 600;
        font-size: 1rem;
        color: #495057;
        padding: 0.75rem;
        border: 2px solid #ffffff;
        border-radius: 0.375rem;
        margin-top: 0.5rem;
    }

    /* Print Styles */
    @media print {
        .sidebar-nav,
        .topbar,
        .card-header,
        .btn,
        body {
            display: none !important;
        }

        .quote-summary-container {
            display: block !important;
        }

        .summary-banner,
        .summary-section,
        .summary-table,
        .summary-totals,
        .summary-footer {
            break-inside: avoid;
        }

        .summary-table th {
            background-color: #0d6efd !important;
            color: #fff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .summary-day-header {
            background-color: #e7f1ff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }

    /* PDF Export Optimization - Improved Layout Strategy */
    .pdf-export-mode {
        max-width: 100% !important;
        width: 100% !important;
        padding: 15px !important;
        font-size: 0.9rem !important;
        box-sizing: border-box !important;
        line-height: 1.4 !important;
    }

    .pdf-export-mode .summary-banner {
        padding: 15px 0 !important;
        margin-bottom: 15px !important;
        page-break-inside: avoid;
    }

    .pdf-export-mode .summary-banner-logo img {
        max-width: 200px !important;
        height: auto !important;
    }

    .pdf-export-mode .summary-banner-address {
        font-size: 0.8rem !important;
        line-height: 1.5 !important;
    }

    .pdf-export-mode .summary-section {
        margin-bottom: 15px !important;
        padding: 12px !important;
        page-break-inside: avoid;
    }

    .pdf-export-mode .summary-section-title {
        font-size: 1.1rem !important;
        margin-bottom: 10px !important;
        padding-bottom: 5px !important;
        page-break-after: avoid;
    }

    .pdf-export-mode .summary-attention {
        font-size: 1.3rem !important;
        padding: 12px !important;
        page-break-inside: avoid;
    }

    .pdf-export-mode .summary-table {
        width: 100% !important;
        table-layout: auto !important;
        font-size: 10px !important;
        border-collapse: collapse !important;
        page-break-inside: auto;
        margin: 0 !important;
        visibility: visible !important;
        display: table !important;
    }

    .pdf-export-mode .summary-table th {
        padding: 6px 4px !important;
        font-size: 9px !important;
        word-wrap: break-word !important;
        border: 1px solid #000 !important;
        background-color: #0d6efd !important;
        color: white !important;
        font-weight: bold !important;
        text-align: center !important;
        visibility: visible !important;
        display: table-cell !important;
    }

    .pdf-export-mode .summary-table td {
        padding: 6px 4px !important;
        font-size: 9px !important;
        word-wrap: break-word !important;
        border: 1px solid #000 !important;
        vertical-align: top !important;
        visibility: visible !important;
        display: table-cell !important;
        background-color: white !important;
        color: black !important;
    }

    /* Simplified column widths for better PDF rendering */
    .pdf-export-mode .summary-table th:nth-child(1),
    .pdf-export-mode .summary-table td:nth-child(1) {
        width: 10% !important;
    }

    .pdf-export-mode .summary-table th:nth-child(2),
    .pdf-export-mode .summary-table td:nth-child(2) {
        width: 35% !important;
    }

    .pdf-export-mode .summary-table th:nth-child(3),
    .pdf-export-mode .summary-table td:nth-child(3) {
        width: 15% !important;
    }

    .pdf-export-mode .summary-table th:nth-child(4),
    .pdf-export-mode .summary-table td:nth-child(4) {
        width: 12% !important;
    }

    .pdf-export-mode .summary-table th:nth-child(5),
    .pdf-export-mode .summary-table td:nth-child(5) {
        width: 12% !important;
    }

    .pdf-export-mode .summary-table th:nth-child(6),
    .pdf-export-mode .summary-table td:nth-child(6) {
        width: 16% !important;
    }

    .pdf-export-mode .summary-day-header {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        color-adjust: exact;
        background-color: #e7f1ff !important;
        page-break-after: avoid;
    }

    .pdf-export-mode .summary-subconcept-row {
        page-break-inside: avoid;
    }

    .pdf-export-mode .summary-totals,
    .pdf-export-mode .sm-totals-card {
        margin-top: 15px !important;
        padding: 15px !important;
        font-size: 0.95rem !important;
        page-break-inside: avoid;
        /* Keep the following "THANK YOU" attached so it can't be orphaned. */
        break-after: avoid;
        page-break-after: avoid;
    }

    .pdf-export-mode .sm-section-title {
        font-size: 1rem !important;
        margin-bottom: 10px !important;
    }

    .pdf-export-mode .summary-footer {
        padding: 15px !important;
        font-size: 0.8rem !important;
        page-break-inside: avoid;
        /* Glue the "THANK YOU" to the totals card above it so it never lands
           alone on its own page — if it doesn't fit, both move together. */
        break-before: avoid;
        page-break-before: avoid;
    }

    /* Keep the quote-info fields on a single row in the PDF (the narrow render
       width would otherwise trigger the 2-column responsive breakpoint). */
    .pdf-export-mode .sm-quote-info-row {
        display: grid !important;
        grid-template-columns: none !important;
        grid-auto-flow: column !important;
        grid-auto-columns: minmax(0, 1fr) !important;
        gap: 12px !important;
    }

    /* :not(.d-none) so empty fields hidden via Bootstrap's d-none stay hidden
       (Lead Guest, Seguidor de servicio, Motivo de viaje when not set). */
    .pdf-export-mode .sm-quote-info-item:not(.d-none) {
        display: block !important;
        width: auto !important;
        margin: 0 !important;
        vertical-align: top !important;
    }

    /* Additional PDF table optimizations */
    .pdf-export-mode .summary-table th,
    .pdf-export-mode .summary-table td {
        white-space: normal !important;
        word-break: break-word !important;
        line-height: 1.3 !important;
        max-width: none !important;
        overflow: visible !important;
    }

    .pdf-export-mode .summary-day-header {
        background-color: #e7f1ff !important;
        color: #0d6efd !important;
        font-weight: bold !important;
        visibility: visible !important;
        display: table-row !important;
    }

    .pdf-export-mode .summary-subconcept-row {
        background-color: white !important;
        color: black !important;
        visibility: visible !important;
        display: table-row !important;
    }

    /* Ensure wrapper doesn't exceed page width */
    .pdf-export-mode {
        max-width: 720px !important;
        overflow: hidden !important;
    }

    /* Ensure backgrounds are visible in PDF */
    .summary-table th,
    .summary-day-header,
    .bg-light {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        color-adjust: exact;
    }

    /* Font rendering optimization */
    .quote-summary-container {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* Keep this view's own blocks (totals card, banner, table rows) intact across
       page breaks. Service-level atoms (.assignment-card, detail rows) and their
       headers are handled in services-renderer.js's own <style>, next to the markup
       that produces them. Do NOT re-add .service-item / .assignments-block here:
       those containers can be taller than a page, so break-inside:avoid on them is
       physically impossible — Chrome ignores it and cuts at an arbitrary point,
       which was the original mid-card-cut bug. */
    .pdf-export-mode .sm-totals-card,
    .pdf-export-mode .summary-banner,
    .pdf-export-mode tr {
        page-break-inside: avoid;
        break-inside: avoid;
    }
    .pdf-export-mode .summary-section-title {
        page-break-after: avoid;
        break-after: avoid;
    }
    /* Hide hero images in PDF mode — Chrome embeds full source bytes regardless of CSS sizing,
       so a single 2 MB hero JPG bloats the PDF dramatically. Logo, avatars and vehicle thumbs
       stay because they are tiny in source as well. */
    .pdf-export-mode .service-item .sm-service-image,
    .pdf-export-mode .service-item .service-hero-image,
    .pdf-export-mode .service-item > img,
    .pdf-export-mode .service-item .ratio img { display: none; }
    .pdf-export-mode .summary-banner-logo img { max-width: 180px; }
</style>

<div class="card border-0">
    <div class="card-header bg-white border-bottom d-print-none">
        <div class="d-flex justify-content-between align-items-center">
            <% if (!locals.isPublicView) { %>
            <h5 class="card-title mb-0">
                <i class="ti ti-file-description me-2"></i>Resumen de la <%= E %>
            </h5>
            <% } else { %>
            <span></span>
            <% } %>
            <div class="d-flex gap-2">
                <button id="shareLinkBtn" class="btn btn-success" style="display: none;">
                    <i class="ti ti-share me-2"></i>Compartir
                </button>
                <button id="sendEmailBtn" class="btn btn-outline-primary" style="display: none;">
                    <i class="ti ti-mail me-2"></i>Enviar por correo
                </button>
                <button id="exportPdfBtn" class="btn btn-primary" style="display: none;">
                    <i class="ti ti-download me-2"></i>Exportar a PDF
                </button>
                <!-- "Cancelar Reserva" se movió al segmented control de estado
                     (Estado de la Reservación → Cancelada) en quote-detail.ejs. -->
            </div>
        </div>
    </div>

    <div class="card-body">
        <!-- Loading State -->
        <div id="summaryLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando resumen...</span>
            </div>
            <p class="mt-3 text-muted">Cargando información de la <%= e %>...</p>
        </div>

        <!-- Summary Content -->
        <div id="summaryContent" class="quote-summary-container" style="display: none;">
            <!-- Banner -->
            <!-- Original summary-banner (commented for future reference)
            <div class="summary-banner">
                <div class="summary-banner-logo">
                    <% if (locals.isPublicView) { %>
                        <h1 class="summary-banner-folio"><%= quote.folio || quote.id || 'N/A' %></h1>
                    <% } else { %>
                        <img src="/images/logos/light_amexing.png" alt="Amexing Experience">
                    <% } %>
                </div>
                <div class="summary-banner-address">
                    <div>Vicente Suarez 5, Colonia Independencia</div>
                    <div>San Miguel de Allende, Guanajuato 37732</div>
                    <div>+52 (415) 167 39 90</div>
                    <div>contact@amexingexperience.com</div>
                </div>
            </div>
            -->

            <!-- Public Header Design (matching public quote view) -->
            <div class="public-header">
                <div class="header-logo">
                    <img src="/images/logos/light_amexing.png" alt="Amexing Experience" style="max-width: 200px; height: auto;">
                </div>
                <div class="header-folio">
                    <h1 id="summaryFolioHeader">-</h1>
                </div>
            </div>

            <!-- Quote Info -->
            <div class="sm-quote-info">
                <div class="sm-quote-info-row" id="summaryTopInfoRow">
                    <div class="sm-quote-info-item">
                        <span class="sm-quote-info-label">Folio</span>
                        <span class="sm-quote-info-value" id="summaryFolio">-</span>
                    </div>
                    <div class="sm-quote-info-item d-none" id="summaryPreferredLanguageRow">
                        <span class="sm-quote-info-label">Idioma de Preferencia</span>
                        <span class="sm-quote-info-value" id="summaryPreferredLanguage">-</span>
                    </div>
                    <div class="sm-quote-info-item">
                        <span class="sm-quote-info-label">Última actualización</span>
                        <span class="sm-quote-info-value" id="summaryLastUpdated">-</span>
                    </div>
                    <!-- Fechas de servicios va en esta fila "meta" (junto a Folio/Última actualización)
                         en vez de sola abajo. Se muestra/oculta por JS (#summaryServiceDatesRow). -->
                    <div class="sm-quote-info-item d-none" id="summaryServiceDatesRow">
                        <span class="sm-quote-info-label">Fechas de servicios</span>
