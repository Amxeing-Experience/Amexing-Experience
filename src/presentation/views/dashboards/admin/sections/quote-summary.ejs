    // Export to PDF via server-side puppeteer (vector text, native page breaks).
    // Falls back to client-side html2pdf if the server endpoint fails.
    async function exportToPdf() {
        const folio = (document.getElementById('summaryFolio')?.textContent || '').trim();
        if (!folio) {
            alert('No se pudo determinar el folio para exportar.');
            return;
        }
        const isQuote = /^QTE-/i.test(folio);
        // Pass the exact quote id (?q=) so the PDF resolves the same record even
        // when folios are duplicated. Reservations are unaffected.
        const qParam = (isQuote && window.__quoteId) ? `?q=${encodeURIComponent(window.__quoteId)}` : '';
        const endpoint = isQuote
            ? `/quotes/${encodeURIComponent(folio)}/pdf${qParam}`
            : `/reservations/${encodeURIComponent(folio)}/pdf`;
        const docKind = isQuote ? 'Cotizacion' : 'Reservacion';
        const filename = `${folio.replace(/\s+/g, '_')}.pdf`;

        const btn = document.getElementById('exportPdfBtn');
        const originalText = btn ? btn.innerHTML : '';
        if (btn) {
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generando PDF...';
            btn.disabled = true;
        }

        try {
            const res = await fetch(endpoint, { credentials: 'same-origin' });
            if (!res.ok) throw new Error(`Server returned ${res.status}`);
            const blob = await res.blob();
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            a.remove();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
        } catch (err) {
            console.error('Server PDF export failed, falling back to client-side html2pdf:', err);
            if (typeof html2pdf !== 'undefined') {
                exportWithHtml2Pdf();
            } else {
                alert('No se pudo generar el PDF en el servidor. Intente nuevamente.');
            }
        } finally {
            if (btn) {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    }

    // Simple html2pdf export - restored to working state
    function exportWithHtml2Pdf() {
        if (typeof html2pdf === 'undefined') {
            alert('No se pudo cargar la librería de PDF. Por favor recargue la página.');
            return;
        }

        const element = document.getElementById('summaryContent');
        const folio = document.getElementById('summaryFolio').textContent || 'cotizacion';
        const docKind = /^QTE-/i.test(folio) ? 'Cotizacion' : 'Reservacion';
        const filename = `${folio.replace(/\s+/g, '_')}.pdf`;

        // Check if element exists
        if (!element) {
            alert('Error: No se encontró el contenido del resumen.');
            return;
        }

        // UI feedback
        const btn = document.getElementById('exportPdfBtn');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generando PDF...';
        btn.disabled = true;

        // Simple html2pdf options (restored to working version)
        const opt = {
            margin: 10,
            filename: filename,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { 
                scale: 2,
                useCORS: true
            },
            jsPDF: { 
                unit: 'mm', 
                format: 'a4', 
                orientation: 'portrait' 
            }
        };

        html2pdf()
            .set(opt)
            .from(element)
            .save()
            .then(() => {
                console.log('PDF generated successfully');
            })
            .catch((error) => {
                console.error('Error generating PDF:', error);
                alert('Error al generar el PDF. Por favor intente nuevamente.');
            })
            .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
    }

