    async function loadExperienceData() {
        try {
            // Get access token using simple working pattern
            const accessToken = getAccessToken();
            
            debugLog('Load Experience Data - Starting', { 
                experienceId,
                hasAccessToken: !!accessToken 
            });
            
            if (!accessToken) {
                showAlert('Error de autenticación. Por favor, recarga la página.', 'danger');
                return;
            }
            
            const response = await fetch(`/api/experiences/${experienceId}`, {
                headers: { 'Authorization': `Bearer ${accessToken}`, 'Content-Type': 'application/json' }
            });
            const result = await response.json();
            
            // Simple error checking

            if (!result.success || !result.data) {
                showAlert('Error al cargar datos de la experiencia', 'danger');
                return;
            }


            const data = result.data;

            // Basic fields - use specific form ID to guarantee correct element targeting
            document.querySelector('#experienceName').value = data.name || '';
            document.querySelector('#experienceDescription').value = data.description || '';
            document.querySelector('#experienceInformationForm #experienceCost').value = data.cost || '';
            
            debugLog('Load Experience Data - Fields Populated', {
                name: document.querySelector('#experienceName').value,
