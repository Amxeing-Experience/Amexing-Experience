    function removeTimeSlot(btn) {
        const timeSlotsContainer = btn.closest('.time-slots-container');
        const timeSlotRow = btn.closest('.time-slot-row');
        // Only remove if there's more than one time slot
        if (timeSlotsContainer.querySelectorAll('.time-slot-row').length > 1) {
            timeSlotRow.remove();
        }
    }

    function removeDayScheduleRow(day) {
        const row = document.querySelector(`#daySchedulesContainer .day-schedule-row[data-day="${day}"]`);
        if (row) row.remove();
    }

    function updateNoDaysMessage() {
        const noDays = document.getElementById('noDaysSelected');
        const rows = document.querySelectorAll('#daySchedulesContainer .day-schedule-row');
        if (noDays) noDays.style.display = rows.length === 0 ? 'block' : 'none';
    }

    // Parse textarea lines to array (filter empty lines)
    function textareaToArray(id) {
        const text = document.getElementById(id).value.trim();
        return text ? text.split('\n').map(l => l.trim()).filter(l => l) : [];
    }

    function stringToArray(text) {
        const trimmedText = (text || '').trim();
        return trimmedText ? trimmedText.split('\n').map(l => l.trim()).filter(l => l) : [];
    }


