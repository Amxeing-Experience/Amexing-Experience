<%
/**
 * Experience Information Section
 * Basic information form for experience creation/editing
 * Created by Denisse Maldonado
 */
%>

<!-- Util del selector amigable de "Tiempo de Anticipación" (presets + Días/Horas/Min → minutos) -->
<script src="/dashboard/js/utils/advance-time-picker.js"></script>

<div id="experienceInformationCard" class="py-4">
    <!-- Alerts Container -->
    <div id="experienceInfoAlerts"></div>

    <%# El <form> ahora abre DESPUÉS del hero + Servicios (más abajo), para que #serviceForm
        no quede anidado. Los inputs ocultos y el hero se leen por getElementById igual. %>
    <input type="hidden" id="experienceId" value="<%= typeof experienceId !== 'undefined' ? experienceId : '' %>">
    <input type="hidden" id="experienceType" value="Experience">

        <!-- ===== HERO editable (estilo exp-lux): portada + categoría + nombre + descripción =====
             Se edita viéndose como el detalle del catálogo del cliente. -->
        <style>
            .exp-hero{display:grid;grid-template-columns:1.05fr 1fr;gap:0;background:#fff;
                border:1px solid #e2ded1;border-radius:16px;overflow:hidden;box-shadow:0 6px 24px rgba(0,0,0,.06);margin-bottom:24px;}
            .exp-hero__media{position:relative;min-height:420px;background:linear-gradient(135deg,#5c6a48,#8a9470 60%,#b6bd9e);}
            .exp-hero__media #mainImageContainer{position:absolute;inset:0;}
            .exp-hero__media #mainImagePreview{display:block;position:absolute;inset:0;margin:0;}
            .exp-hero__media #mainImagePreview .position-relative{display:block !important;width:100%;height:100%;}
            .exp-hero__media #mainImageImg{max-width:none !important;max-height:none !important;width:100%;height:100%;object-fit:cover;border-radius:0 !important;}
            .exp-hero__media #mainImageUpload{position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);
                background:rgba(255,255,255,.92);border-color:#cfd3c2 !important;max-width:78%;z-index:3;}
            .exp-hero__overlay{position:absolute;inset:0;pointer-events:none;
                background:linear-gradient(to top,rgba(0,0,0,.62) 0%,rgba(0,0,0,.12) 45%,transparent 70%);}
            .exp-hero__caption{position:absolute;left:26px;right:26px;bottom:24px;z-index:4;}
            .exp-hero__category{display:inline-block;width:auto;max-width:90%;background:rgba(110,122,80,.92);color:#fff;
                border:0;border-radius:999px;padding:7px 16px;font-size:.72rem;font-weight:700;letter-spacing:.12em;
                text-transform:uppercase;cursor:pointer;outline:none;}
            .exp-hero__category option{color:#2b2b2b;}
            .exp-hero__title{display:block;width:100%;margin-top:12px;background:transparent;border:0;color:#fff;
                font-size:2.2rem;font-weight:700;letter-spacing:-.01em;outline:none;padding:0;}
            .exp-hero__title::placeholder{color:rgba(255,255,255,.65);}
            .exp-hero__underline{display:block;width:60px;height:4px;background:#e6b34a;margin-top:10px;border-radius:2px;}
            .exp-hero__panel{padding:28px 28px 24px;display:flex;flex-direction:column;}
            .exp-hero__label{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:#8a8f78;font-weight:700;margin-bottom:7px;display:block;}
            .exp-hero__desc{flex:1;min-height:200px;border:1px solid #e2ded1;border-radius:12px;padding:15px;
                font-size:1rem;line-height:1.6;color:#3a3a3a;resize:vertical;outline:none;background:#fcfbf7;width:100%;}
            .exp-hero__desc:focus{border-color:#6E7A50;box-shadow:0 0 0 .18rem rgba(110,122,80,.14);}
            .exp-hero__meta{margin-top:16px;}
            @media (max-width:768px){ .exp-hero{grid-template-columns:1fr;} .exp-hero__media{min-height:260px;} }

            /* Config en una sola columna, cada bloque como tarjeta colapsable */
            .exp-config > .col-md-6{flex:0 0 100%;max-width:100%;}
            .exp-config .mb-4{background:#fff;border:1px solid #e2ded1;border-radius:14px;padding:16px 20px;margin-bottom:14px !important;}
            .exp-config .mb-4 > h6{cursor:pointer;user-select:none;display:flex;align-items:center;gap:8px;}
            .exp-config .mb-4 > h6 .cfg-chev{margin-left:auto;transition:transform .15s;color:#8a8f78;font-size:.95rem;}
            .exp-config .mb-4.collapsed > h6{border-bottom:0 !important;padding-bottom:0 !important;margin-bottom:0 !important;}
            .exp-config .mb-4.collapsed > h6 .cfg-chev{transform:rotate(-90deg);}
            .exp-config .mb-4.collapsed > *:not(h6){display:none !important;}
        </style>
        <div class="exp-hero">
            <div class="exp-hero__media">
                <div id="mainImageContainer">
                    <div id="mainImagePreview" style="display: none;">
                        <div class="position-relative d-inline-block">
                            <img id="mainImageImg" src="" alt="Portada" class="rounded shadow-sm">
                            <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2" id="removeMainImageBtn" title="Eliminar imagen" style="z-index:5;">
                                <i class="ti ti-x"></i>
                            </button>
                        </div>
                    </div>
                    <div id="mainImageUpload" class="border border-2 border-dashed rounded p-4 text-center" style="cursor: pointer;">
                        <i class="ti ti-cloud-upload fs-1 text-muted d-block mb-2"></i>
                        <p class="text-muted mb-1">Arrastra la portada o haz clic para seleccionar</p>
                        <small class="text-muted">JPG, PNG, WebP</small>
                        <input type="file" id="mainImageInput" accept="image/jpeg,image/png,image/webp" style="display: none;">
                    </div>
                </div>
                <div class="exp-hero__overlay"></div>
                <div class="exp-hero__caption">
                    <select class="exp-hero__category" id="experienceCategory" name="experience_category" title="Categoría de la experiencia">
                        <%# Opciones cargadas dinámicamente (ExperienceCategories.populateSelect). %>
                        <option value="">Categoría…</option>
                    </select>
                    <input type="text" class="exp-hero__title" id="experienceName" name="name" required maxlength="280"
                           autocomplete="off" placeholder="Nombre de la experiencia *">
                    <span class="exp-hero__underline"></span>
                </div>
                <!-- Loader dedicado de categorías (defensivo): si el init no las pobló, las llena aquí
                     sin pisar un valor ya cargado. -->
                <script>
                (function () {
                    function fillCategories() {
                        var sel = document.getElementById('experienceCategory');
                        if (!sel || !window.ExperienceCategories) return;
                        window.ExperienceCategories.fetch().then(function () {
                            if (sel.options.length <= 1) {
                                window.ExperienceCategories.populateSelect(sel, sel.value, { placeholder: 'Categoría…' });
                            }
                        }).catch(function () { /* silencioso */ });
                    }
                    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { setTimeout(fillCategories, 350); });
                    else setTimeout(fillCategories, 350);
                })();
                </script>
            </div>
            <div class="exp-hero__panel">
                <label class="exp-hero__label" for="experienceDescription">Descripción</label>
                <textarea class="exp-hero__desc" id="experienceDescription" name="description"
                          placeholder="Describe la experiencia como se mostrará al cliente…"></textarea>
                <div class="invalid-feedback" id="description-error"></div>
                <div class="exp-hero__meta">
                    <label class="exp-hero__label" for="experienceTipo">Tipo de experiencia</label>
                    <select class="form-select mb-3" id="experienceTipo" name="tipo">
                        <option value="">Seleccionar</option>
                        <option value="Exclusivo">Exclusivo</option>
                        <option value="Compartido">Compartido</option>
                        <option value="Privado">Privado</option>
                    </select>
                    <label class="exp-hero__label" for="experienceDestino">Destino <span class="text-muted">(Opcional)</span></label>
                    <select class="form-select mb-3" id="experienceDestino" name="destinationPOI">
                        <option value="">Seleccione un destino...</option>
                        <!-- Dynamically populated with POI data -->
                    </select>
                    <%# Duración: movida a la barra General de la sección de Servicios (junto a la tarifa). %>
                </div>
            </div>
        </div>

        <!-- Servicios de la experiencia: JUSTO DESPUÉS del hero (header premium), fuera del form. -->
        <%- include('./experience-services', { experienceId: (typeof experienceId !== 'undefined' ? experienceId : '') }) %>

        <!-- A partir de aquí abre el form de Información (config + guardar). -->
        <form id="experienceInformationForm" class="needs-validation" novalidate>

        <!-- Colapsables de config (progressive enhancement): cada bloque .mb-4 con h6 se vuelve tarjeta. -->
        <script>
        (function () {
            function initCfgCards() {
                var blocks = document.querySelectorAll('#experienceInformationForm .exp-config .mb-4');
                var collapseByDefault = /nota|disponibilidad|fotos/i;
                blocks.forEach(function (b) {
                    var h = b.querySelector(':scope > h6');
                    if (!h || h.dataset.cfgWired) return;
                    h.dataset.cfgWired = '1';
                    var chev = document.createElement('i');
                    chev.className = 'ti ti-chevron-down cfg-chev';
                    h.appendChild(chev);
                    h.addEventListener('click', function (e) {
                        if (e.target.closest('input, select, textarea, .form-check, .form-switch, label, button')) return;
                        b.classList.toggle('collapsed');
                    });
                    if (collapseByDefault.test(h.textContent || '')) b.classList.add('collapsed');
                });
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { setTimeout(initCfgCards, 450); });
            else setTimeout(initCfgCards, 450);
        })();
        </script>

        <div class="row g-4 exp-config">
            <!-- Left Column: Image + Basic Info + Tiempos + Capacidad + Notas -->
            <div class="col-md-6">
                <!-- Tarifas (la Capacidad Mín/Máx se define en la sección de Servicios: fuente única) -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="ti ti-cash me-1"></i>
                        Tarifas
                    </h6>
                    <div class="row">
                        <!-- Adult Prices Row -->
                        <div class="col-md-6 mb-3">
                            <label for="experienceCost" class="form-label">Precio Adulto <span class="text-muted small">(opcional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="experienceCost" name="cost" min="0" step="0.01" placeholder="0.00">
                            </div>
                            <div class="invalid-feedback" id="cost-error"></div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="experienceCreateVersion">
                                <label class="form-check-label small text-muted" for="experienceCreateVersion">
                                    Crear <b>nueva versión</b> de precio al Guardar (conserva el historial). Sin marcar, el precio se actualiza en el mismo registro.
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="experiencePriceNoAlcohol" class="form-label">Precio Sin Alcohol</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="experiencePriceNoAlcohol" name="price_no_alcohol" min="0" step="0.01" placeholder="0.00">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <!-- Child Prices Row -->
                        <div class="col-md-6 mb-3">
                            <label for="experiencePriceChild" class="form-label">Precio Niño (3-12)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="experiencePriceChild" name="price_child" min="0" step="0.01" placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="experiencePriceInfant" class="form-label">Precio Infante (0-2)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="experiencePriceInfant" name="price_infant" min="0" step="0.01" placeholder="0.00">
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Incluye/NoIncluye + Idiomas + Disponibilidad + Fotos + Precios -->
            <div class="col-md-6">
                <!-- Incluye / No Incluye -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="ti ti-list-check me-1"></i>
                        Incluye / No Incluye
                    </h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="experienceIncludes" class="form-label">Incluye <span class="text-muted">(uno por linea)</span></label>
                            <textarea class="form-control" id="experienceIncludes" rows="4" placeholder="Transporte ida y vuelta&#10;Guia bilingue certificado&#10;Entrada al sitio&#10;Degustacion de platillos"></textarea>
                            <div class="form-text"><small><i class="ti ti-info-circle me-1"></i>Cada elemento en una linea nueva</small></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="experienceNotIncludes" class="form-label">No incluye <span class="text-muted">(uno por linea)</span></label>
                            <textarea class="form-control" id="experienceNotIncludes" rows="4" placeholder="Propinas&#10;Comidas adicionales&#10;Transporte desde aeropuerto&#10;Gastos personales"></textarea>
                            <div class="form-text"><small><i class="ti ti-alert-circle me-1"></i>Cada exclusion en una linea nueva</small></div>
                        </div>
                    </div>
                </div>

                <!-- Idiomas -->
                <div class="mb-4">
                    <label for="experienceLanguages" class="form-label">
                        <i class="ti ti-language me-1"></i>Idiomas disponibles <span class="text-muted">(uno por linea)</span>
                    </label>
                    <textarea class="form-control" id="experienceLanguages" rows="3" placeholder="Espanol&#10;Ingles&#10;Frances"></textarea>
                    <div class="form-text"><small><i class="ti ti-world me-1"></i>Escriba cada idioma en una linea nueva</small></div>
                </div>

                <!-- Agenda: tiempos (arriba) + disponibilidad (abajo) -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span><i class="ti ti-calendar-time me-1"></i>Logística</span>
                        <span class="form-check form-switch mb-0 fw-normal" title='Si se activa, en el detalle se muestra "Horarios" en lugar de "Horarios sugeridos" (ej. viñedos).'>
                            <input class="form-check-input" type="checkbox" id="experienceFixedSchedule" name="fixed_schedule">
                            <label class="form-check-label small" for="experienceFixedSchedule">Horario fijo</label>
                        </span>
                    </h6>
                    <!-- Tiempos: trayecto + anticipación -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Duración de Trayecto</label>
                            <%- include('../../../molecules/forms/advance-time-picker', { hiddenId: 'experienceTravelDuration', hiddenName: 'travel_duration', showDays: false, presets: [{ label: '30 min', minutes: 30 }, { label: '45 min', minutes: 45 }, { label: '1 h', minutes: 60 }, { label: '1 h 30', minutes: 90 }] }) %>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tiempo de Anticipación</label>
                            <%- include('../../../molecules/forms/advance-time-picker', { hiddenId: 'experienceAdvanceMinutes', hiddenName: 'advance_minutes' }) %>
                        </div>
                    </div>
                    <!-- Disponibilidad: días + horarios -->
                    <label class="form-label mt-1">Disponibilidad</label>
                    <div class="mb-3">
                        <div class="d-flex gap-1 flex-wrap mb-3" id="availableDaysContainer">
                            <button type="button" class="btn btn-sm btn-outline-primary day-btn" data-day="1" data-day-name="Lunes">Lu</button>
                            <button type="button" class="btn btn-sm btn-outline-primary day-btn" data-day="2" data-day-name="Martes">Ma</button>
                            <button type="button" class="btn btn-sm btn-outline-primary day-btn" data-day="3" data-day-name="Miercoles">Mi</button>
                            <button type="button" class="btn btn-sm btn-outline-primary day-btn" data-day="4" data-day-name="Jueves">Ju</button>
                            <button type="button" class="btn btn-sm btn-outline-primary day-btn" data-day="5" data-day-name="Viernes">Vi</button>
                            <button type="button" class="btn btn-sm btn-outline-primary day-btn" data-day="6" data-day-name="Sabado">Sa</button>
                            <button type="button" class="btn btn-sm btn-outline-primary day-btn" data-day="0" data-day-name="Domingo">Do</button>
                        </div>
                    </div>
                    <div id="daySchedulesContainer" class="mb-3">
                        <div id="noDaysSelected" class="text-center text-muted py-2 border rounded bg-light" style="font-size: 1rem;">
                            <i class="ti ti-calendar-off me-1"></i>
                            <small>Selecciona dias para configurar horarios</small>
                        </div>
                    </div>
                </div>

                <!-- Fotos -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="ti ti-camera me-1"></i>
                        Fotos
                    </h6>
                    <div class="alert alert-warning py-2 px-3 mb-2 d-flex align-items-center" role="alert" style="font-size: 0.85rem;">
                        <i class="ti ti-alert-triangle me-2"></i>
                        <span>Las imágenes (portada y fotos) <b>no</b> se autoguardan: da clic en <b>Guardar imágenes</b> para subirlas.</span>
                    </div>
                    <div class="experience-photos-container">
                        <div class="row g-2 mb-2" id="photosPreviewContainer"></div>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="addPhotoBtn">
                                <i class="ti ti-camera-plus me-1"></i>Agregar Foto
                            </button>
                            <button type="button" class="btn btn-success btn-sm" id="savePhotosBtn">
                                <i class="ti ti-device-floppy me-1"></i>Guardar imágenes
                            </button>
                        </div>
                        <input type="file" class="d-none" id="experiencePhotoInput" accept=".jpg,.jpeg,.png,.webp" multiple>
                    </div>
                    <div class="form-text"><small><i class="ti ti-info-circle me-1"></i>Formatos: JPG, PNG, WebP</small></div>
                </div>

                <!-- Notas -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="ti ti-notes me-1"></i>
                        Notas
                    </h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="experienceInternalNotes" class="form-label">
                                <i class="ti ti-lock me-1"></i>Notas internas <span class="text-muted">(Uso interno)</span>
                            </label>
                            <textarea class="form-control" id="experienceInternalNotes" rows="3" placeholder="Notas para uso exclusivo interno del equipo..."></textarea>
                            <div class="form-text"><small>Solo visible para el equipo interno</small></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="experienceClientBookingNotes" class="form-label">
                                <i class="ti ti-user-check me-1"></i>Notas cliente <span class="text-muted">(Reservar)</span>
                            </label>
                            <textarea class="form-control" id="experienceClientBookingNotes" rows="3" placeholder="Notas que vera el cliente al reservar..."></textarea>
                            <div class="form-text"><small>Visible para el cliente durante reserva</small></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="experienceProviderNotes" class="form-label">
                                <i class="ti ti-building-store me-1"></i>Notas proveedor <span class="text-muted">(Proveedor)</span>
                            </label>
                            <textarea class="form-control" id="experienceProviderNotes" rows="3" placeholder="Notas e instrucciones para el proveedor..."></textarea>
                            <div class="form-text"><small>Instrucciones para el proveedor</small></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="experienceTeamNotes" class="form-label">
                                <i class="ti ti-users me-1"></i>Notas colaboradores <span class="text-muted">(Equipo)</span>
                            </label>
                            <textarea class="form-control" id="experienceTeamNotes" rows="3" placeholder="Notas para colaboradores y equipo de Amexing..."></textarea>
                            <div class="form-text"><small>Informacion para el equipo Amexing</small></div>
                        </div>
                    </div>
                </div>

                <!-- Términos y condiciones (último, debajo de Fotos) -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="ti ti-file-description me-1"></i>
                        Términos y condiciones
                    </h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Mínimo para privado</label>
                            <div class="input-group">
                                <select class="form-control" id="experiencePrivateMinType" name="private_min_type" style="max-width: 160px;">
                                    <option value="">N/A</option>
                                    <option value="personas">Por personas</option>
                                    <option value="monto">Monto fijo ($)</option>
                                </select>
                                <input type="number" class="form-control" id="experiencePrivateMinValue" name="private_min_value" min="0" step="0.01" placeholder="N° personas o monto">
                            </div>
                            <div class="form-text">Personas mínimas o monto fijo para hacerlo privado</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="experienceBuyout" class="form-label">Buy-out</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="experienceBuyout" name="buyout" min="0" step="0.01" placeholder="0.00">
                            </div>
                            <div class="form-text">Monto para reservar la experiencia completa (buy-out)</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="experienceCancellationPolicy" class="form-label">Políticas de cancelación</label>
                        <textarea class="form-control" id="experienceCancellationPolicy" name="cancellation_policy" rows="3" placeholder="Ej. Cancelación gratuita hasta 48h antes; después se cobra el 50%..."></textarea>
                    </div>
                </div>

                <!-- Services Price Breakdown — OCULTO: redundante con los servicios inline.
                     Se conservan los elementos (el builder los actualiza y alimenta el total del header). -->
                <div class="mb-4 d-none">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light border-bottom-0 d-flex justify-content-between align-items-center py-3">
                            <h6 class="mb-0 fw-bold">
                                <i class="ti ti-calculator me-2"></i>Desglose de Precios de Servicios
                            </h6>
                            <button class="btn btn-sm btn-link text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#priceBreakdownContent" aria-expanded="true">
                                <i class="ti ti-chevron-down" id="breakdownToggleIcon"></i>
                            </button>
                        </div>
                        <div class="collapse show" id="priceBreakdownContent">
                            <div class="card-body">
                                <div id="servicesBreakdownList" class="mb-3">
                                    <!-- Dynamic service breakdown will appear here -->
                                    <div class="text-center text-muted py-3">
                                        <i class="ti ti-package-off"></i>
                                        <p class="mb-0 small">No hay servicios agregados aun</p>
                                        <p class="mb-0 small text-muted">Los servicios se agregan en la seccion Servicios</p>
                                    </div>
                                </div>
                                
                                <!-- Summary totals -->
                                <div class="border-top pt-3">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">Total de Servicios:</span>
                                                <strong id="servicesTotalCost">$0.00</strong>
                                            </div>
                                            <div class="d-flex justify-content-between mb-2">
