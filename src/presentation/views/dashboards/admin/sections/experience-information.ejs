    // Check user authorization for services transfer
    async function checkServiceTransferAuthorization(accessToken) {
        try {
            // Test if user can access service items endpoint by making a GET request
            const response = await fetch(`/api/experiences/test/service-items`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${accessToken}`,
                    'Content-Type': 'application/json'
                }
            });
            
            debugLog('Authorization Check - Service Items Endpoint', {
                status: response.status,
                statusText: response.statusText,
                hasAuth: response.status !== 401,
                hasPermission: response.status !== 403,
                canAccess: response.status === 404 || response.status === 200, // 404 means endpoint exists but experience doesn't, which is fine
            });
            
            return response.status !== 401 && response.status !== 403;
        } catch (error) {
            debugLog('Authorization Check - Failed', { error: error.message });
            return false;
        }
    }

    // Get JWT token from cookies - use clientAccessToken (non-httpOnly cookie)
    function getAccessToken() {
        const cookies = document.cookie.split(';');
        for (let cookie of cookies) {
            const [name, value] = cookie.trim().split('=');
            if (name === 'clientAccessToken') {
                return value;
            }
        }
        return null;
    }

    async function saveExperience() {
        // Nombre global obligatorio: no se puede guardar sin él. Enfoca el campo.
        const globalNameEl = document.getElementById('experienceName');
        if (!globalNameEl || !globalNameEl.value.trim()) {
            showAlert('El nombre de la experiencia es obligatorio.', 'warning');
            if (globalNameEl) {
                globalNameEl.focus();
                globalNameEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return;
        }

        // Try multiple auth approaches - same as provider modal
        const accessToken = getAccessToken() || localStorage.getItem('authToken');
        
        if (!accessToken) {
            showAlert('Error de autenticación. Por favor, recarga la página e intenta nuevamente.', 'danger');
            debugLog('Save Experience - Auth Error', { 
                hasToken: false,
                cookieToken: !!getAccessToken(),
                localStorageToken: !!localStorage.getItem('authToken')
            });
            return;
        }

        // Debug services state at start of save
        const tempServicesCheck = localStorage.getItem('tempExperienceServices');
        debugLog('Save Experience - Initial Services Check', {
            hasTemporaryServices: !!tempServicesCheck,
            servicesData: tempServicesCheck ? JSON.parse(tempServicesCheck) : null,
            experienceId: experienceId
        });

        // Enhanced debugging - check element existence first
        // Use specific form ID to guarantee correct element targeting
        const nameElement = document.querySelector('#experienceName');
        const descriptionElement = document.querySelector('#experienceInformationForm #experienceDescription');
        const costElement = document.querySelector('#experienceInformationForm #experienceCost');

        debugLog('Save Experience - Element Check', {
            nameElementExists: !!nameElement,
            descriptionElementExists: !!descriptionElement,
            costElementExists: !!costElement,
            descriptionElementType: descriptionElement ? descriptionElement.tagName : 'null',
            descriptionElementValue: descriptionElement ? descriptionElement.value : 'no element',
            descriptionElementTextContent: descriptionElement ? descriptionElement.textContent : 'no element',
            descriptionElementInnerHTML: descriptionElement ? descriptionElement.innerHTML : 'no element'
        });

        if (!nameElement || !descriptionElement || !costElement) {
            showAlert('Error: No se pudieron encontrar los campos del formulario', 'danger');
            debugLog('Save Experience - Missing Elements Error', {
                nameElement: !!nameElement,
                descriptionElement: !!descriptionElement,
                costElement: !!costElement
            });
            return;
        }

        // Use a small delay to ensure DOM is fully updated
        await new Promise(resolve => setTimeout(resolve, 100));
        
        // Try multiple methods to get the values
        const directName = nameElement.value;
        const directDescription = descriptionElement.value;
        const directCost = costElement.value;
        
        // Force update the values by triggering change events
        nameElement.dispatchEvent(new Event('change', { bubbles: true }));
        descriptionElement.dispatchEvent(new Event('change', { bubbles: true }));
        costElement.dispatchEvent(new Event('change', { bubbles: true }));
        
        // Use captured values as primary source, with direct reading as fallback
        const name = (capturedFormValues.name || directName || '').trim();
        // Solo el nombre es obligatorio: si no hay descripción, usa el nombre por
        // defecto (el backend sí valida que description no sea vacío).
        const description = (capturedFormValues.description || directDescription || '').trim() || name;
        const cost = parseFloat(capturedFormValues.cost || directCost) || 0;

        debugLog('Save Experience - Form Data', {
            name,
            description,
            cost,
            nameLength: name.length,
            descriptionLength: description.length,
            hasAccessToken: !!accessToken,
            tokenLength: accessToken.length,
            // Additional debugging info
            capturedName: capturedFormValues.name,
            capturedDescription: capturedFormValues.description,
            capturedCost: capturedFormValues.cost,
            directName: directName,
            directDescription: directDescription,
            directCost: directCost,
            rawNameValue: nameElement.value,
            rawDescriptionValue: descriptionElement.value,
            rawCostValue: costElement.value
        });

        if (!name) { showAlert('El nombre es requerido', 'warning'); return; }
        // Descripción ya NO es obligatoria (cae al nombre por defecto arriba).
        if (cost < 0) { showAlert('El costo debe ser mayor o igual a 0', 'warning'); return; }
        
        // Validate all numeric fields before saving
        if (!validateAllNumericFields()) {
            showAlert('Por favor, corrige los errores en los campos numericos antes de guardar', 'warning');
            return;
        }

        const saveBtn = document.getElementById('saveExperienceInfoBtn');
        const saveText = document.getElementById('saveButtonText');
        saveBtn.disabled = true;

        // Progress helper
        const totalSteps = 1 + (window._mainImageFile ? 1 : 0) + pendingPhotoFiles.length;
        let currentStep = 0;
        function updateProgress(msg) {
            currentStep++;
            if (totalSteps > 1) {
                saveText.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span>${msg} (${currentStep}/${totalSteps})`;
            } else {
                saveText.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span>${msg}`;
            }
        }

        try {
            updateProgress('Guardando datos...');

            // Build availability (multi-slot format matching provider)
            const availability = [];
            document.querySelectorAll('#daySchedulesContainer .day-schedule-row').forEach(row => {
                const daySchedule = {
                    day: parseInt(row.dataset.day),
                    times: []
                };
                row.querySelectorAll('.time-slot-row').forEach(slotRow => {
                    const start = slotRow.querySelector('.start-time').value;
                    const end = slotRow.querySelector('.end-time').value;
                    if (start && end) {
                        daySchedule.times.push({ start, end });
                    }
                });
                if (daySchedule.times.length > 0) {
                    availability.push(daySchedule);
                }
            });

            const body = {
                name,
                description,
                type: 'Experience',
                cost,
                price_no_alcohol: parseFloat(document.getElementById('experiencePriceNoAlcohol').value) || null,
                price_child: parseFloat(document.getElementById('experiencePriceChild').value) || null,
                price_infant: parseFloat(document.getElementById('experiencePriceInfant').value) || null,
                duration: parseFloat(document.getElementById('experienceDuration').value) || null,
                travel_duration: parseInt(document.getElementById('experienceTravelDuration').value) || null,
                advance_minutes: parseInt(document.getElementById('experienceAdvanceMinutes').value) || null,
                min_people: parseInt(document.getElementById('experienceMinPeople').value) || null,
                max_people: parseInt(document.getElementById('experienceMaxPeople').value) || null,
                cancellation_policy: document.getElementById('experienceCancellationPolicy').value.trim() || null,
                buyout: parseFloat(document.getElementById('experienceBuyout').value) || null,
                private_min_type: document.getElementById('experiencePrivateMinType').value || null,
                private_min_value: parseFloat(document.getElementById('experiencePrivateMinValue').value) || null,
                includes: stringToArray(capturedFormValues.includes) || textareaToArray('experienceIncludes'),
                notincludes: stringToArray(capturedFormValues.notincludes) || textareaToArray('experienceNotIncludes'),
                languages: stringToArray(capturedFormValues.languages) || textareaToArray('experienceLanguages'),
                internal_notes: document.getElementById('experienceInternalNotes').value.trim() || null,
                client_booking_notes: document.getElementById('experienceClientBookingNotes').value.trim() || null,
                provider_notes: document.getElementById('experienceProviderNotes').value.trim() || null,
                team_notes: document.getElementById('experienceTeamNotes').value.trim() || null,
                availability: availability.length > 0 ? availability : null,
                fixed_schedule: document.getElementById('experienceFixedSchedule').checked,
                destinationPOI: document.getElementById('experienceDestino').value || null,
            };

            // 🔍 SAVE DEBUG - Log destinationPOI save details
            const destinoValue = document.getElementById('experienceDestino').value;
            const destinoElement = document.getElementById('experienceDestino');
            console.log('🔍 SAVE DEBUG - Destino form value:', destinoValue);
            console.log('🔍 SAVE DEBUG - Destino element:', destinoElement);
            console.log('🔍 SAVE DEBUG - Destino dropdown options:', Array.from(destinoElement.options).map(o => ({value: o.value, text: o.textContent})));
            console.log('🔍 SAVE DEBUG - Selected option:', destinoElement.selectedOptions[0] ? {value: destinoElement.selectedOptions[0].value, text: destinoElement.selectedOptions[0].textContent} : 'None selected');
            console.log('🔍 SAVE DEBUG - Body.destinationPOI:', body.destinationPOI);

            if (window._mainImageRemoved) {
                body.mainImage = '';
            }

            debugLog('Save Experience - Request Body', {
                url: isNew ? '/api/experiences' : `/api/experiences/${experienceId}`,
                method: isNew ? 'POST' : 'PUT',
                body: body,
                authToken: accessToken ? `${accessToken.substring(0, 10)}...` : 'NO TOKEN',
                hasToken: !!accessToken,
                bodyStringified: JSON.stringify(body, null, 2),
                capturedTextareas: {
                    includes: capturedFormValues.includes,
                    notincludes: capturedFormValues.notincludes,
                    languages: capturedFormValues.languages
                },
                finalArrays: {
                    includes: body.includes,
                    notincludes: body.notincludes,
                    languages: body.languages
                }
            });

            // F3 (draft-first): si al agregar servicios ya se creó un borrador
            // (active:false), este "guardar" lo FINALIZA (PUT + active:true) en vez
            // de crear una experiencia duplicada.
            const draftId = window.__experienceDraftId || null;
            const creatingNew = isNew && !draftId;
            const targetId = draftId || experienceId;
            if (draftId) body.active = true;

            const url = creatingNew ? '/api/experiences' : `/api/experiences/${targetId}`;
            const method = creatingNew ? 'POST' : 'PUT';

            const response = await fetch(url, {
                method,
                headers: {
                    'Authorization': `Bearer ${accessToken}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(body)
            });

            const result = await response.json();

            // 🔍 SAVE RESPONSE DEBUG - Log server response details
            console.log('🔍 SAVE RESPONSE DEBUG - Complete server response:', result);
            console.log('🔍 SAVE RESPONSE DEBUG - Response success:', result.success);
            console.log('🔍 SAVE RESPONSE DEBUG - Response data:', result.data);
            if (result.data && result.data.destinationPOI) {
                console.log('🔍 SAVE RESPONSE DEBUG - Saved destinationPOI in response:', result.data.destinationPOI);
            } else {
                console.log('🔍 SAVE RESPONSE DEBUG - No destinationPOI in response data');
            }

            // Store access token if provided in response
            if (result.accessToken) {
                localStorage.setItem('accessToken', result.accessToken);
                debugLog('Save Experience - Token Stored', { tokenStored: true });
            }

            debugLog('Save Experience - Server Response', {
                status: response.status,
                success: result.success,
                result: result,
                isNew: isNew,
                hasData: !!result.data,
                dataId: result.data?.id
            });

            if (!result.success) {
                console.error('❌ Save Experience Failed:', result);
                showAlert(result.error || 'Error al guardar', 'danger');
                return;
            }

            // Delete old main image if removed (without replacement)
            if (window._mainImageRemoved && !window._mainImageFile && window._mainImageId) {
                try {
                    const expIdForDelete = result.data?.id || experienceId;
                    await fetch(`/api/experiences/${expIdForDelete}/images/${window._mainImageId}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': `Bearer ${accessToken}` }
                    });
                    window._mainImageId = null;
                } catch (delErr) {
                    console.warn('Could not delete old main image:', delErr);
                }
            }

            // Upload main image if new file
            if (window._mainImageFile && result.data && result.data.id) {
                updateProgress('Subiendo imagen principal...');
                await uploadMainImage(result.data.id, window._mainImageFile);
            }

            // Upload pending photos
            if (pendingPhotoFiles.length > 0 && result.data && result.data.id) {
                const photoCount = pendingPhotoFiles.length;
                for (let i = 0; i < photoCount; i++) {
                    updateProgress(`Optimizando foto ${i + 1} de ${photoCount}...`);
                    await uploadPhoto(result.data.id, pendingPhotoFiles[i]);
                }
                pendingPhotoFiles.length = 0;
            }

            saveText.innerHTML = `<i class="ti ti-check me-1"></i>Guardado`;
            showAlert(isNew ? 'Experiencia creada exitosamente' : 'Cambios guardados exitosamente', 'success');

            if (isNew) {
                // F3 (draft-first): normalmente los servicios ya se guardaron directo
                // contra el borrador (active:false); no hay transferencia desde
                // localStorage. Limpiamos el marcador y vamos al detalle.
                const finalId = (result.data && result.data.id) || draftId || experienceId;
                window.__experienceDraftId = null;
                localStorage.removeItem('tempExperienceServices');
                if (window.experienceServicesBuilder) {
                    const builder = window.experienceServicesBuilder;
                    builder.experienceId = finalId;
                    // Red de seguridad: si el usuario agregó servicios ANTES de poner
                    // el nombre (aún en memoria, sin borrador creado), persístelos ahora
                    // contra la experiencia real para no perderlos.
                    if (builder.services && builder.services.size > 0) {
                        try {
                            await builder.saveToBackend();
                        } catch (flushErr) {
                            console.warn('No se pudieron guardar los servicios en memoria:', flushErr);
                            showAlert('La experiencia se creó, pero revisa que los servicios se hayan guardado.', 'warning');
                        }
                    }
                }

                if (typeof isDebugMode === 'function' && isDebugMode()) {
                    showAlert(`Debug: experiencia ${finalId} guardada. Redirect prevenido.`, 'info');
                } else {
                    setTimeout(() => {
                        window.location.href = `/dashboard/admin/experiences/${finalId}`;
                    }, 1000);
                }
            }
        } catch (error) {
            console.error('Error saving experience:', error);
            showAlert('Error al guardar la experiencia', 'danger');
        } finally {
            saveBtn.disabled = false;
            setTimeout(() => {
                saveText.innerHTML = isNew ? 'Crear Experiencia' : 'Guardar Cambios';
            }, 2000);
        }
    }

    async function uploadMainImage(expId, file) {
        try {
            // Get fresh access token
            const accessToken = getAccessToken();
            
            // Delete old primary image if it exists
            if (window._mainImageId) {
                try {
                    await fetch(`/api/experiences/${expId}/images/${window._mainImageId}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': `Bearer ${accessToken}` }
                    });
                } catch (delErr) {
                    console.warn('Could not delete old main image:', delErr);
                }
            }

            const formData = new FormData();
            formData.append('image', file);
            formData.append('isPrimary', 'true');

            const response = await fetch(`/api/experiences/${expId}/images`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${accessToken}` },
                body: formData
            });

            const result = await response.json();
            if (result.success && result.data) {
                window._mainImageId = result.data.id;
            } else {
                console.error('Main image upload failed:', result.error);
            }
        } catch (error) {
            console.error('Error uploading main image:', error);
        }
    }

    async function uploadPhoto(expId, file) {
        try {
            // Get fresh access token
            const accessToken = getAccessToken();
            
            const formData = new FormData();
            formData.append('image', file);

            const response = await fetch(`/api/experiences/${expId}/images`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${accessToken}` },
                body: formData
            });
            const result = await response.json();
            if (!result.success) {
                console.error('Photo upload failed:', result.error);
            }
        } catch (error) {
            console.error('Error uploading photo:', error);
        }
    }

    function showAlert(message, type) {
        const container = document.getElementById('experienceInfoAlerts');
        container.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                <i class="ti ti-${type === 'success' ? 'check' : type === 'danger' ? 'alert-circle' : 'info-circle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        if (type === 'success') {
            setTimeout(() => { container.innerHTML = ''; }, 3000);
        }
    }
});
</script>

