    function setupNumericValidation() {
        // Define all numeric input fields with their validation rules
        const numericFields = [
            // Price fields (allow decimals)
            { id: 'experienceCost', required: false, allowDecimals: true, min: 0, name: 'Precio Adulto' },
            { id: 'experiencePriceNoAlcohol', required: false, allowDecimals: true, min: 0, name: 'Precio Sin Alcohol' },
            { id: 'experiencePriceChild', required: false, allowDecimals: true, min: 0, name: 'Precio Niño' },
            { id: 'experiencePriceInfant', required: false, allowDecimals: true, min: 0, name: 'Precio Infante' },
            
            // Time fields (duration allows decimals, others are integers)
            { id: 'experienceDuration', required: false, allowDecimals: true, min: 0, name: 'Duración' },
            { id: 'experienceTravelDuration', required: false, allowDecimals: false, min: 0, name: 'Duración Trayecto' },
            { id: 'experienceAdvanceMinutes', required: false, allowDecimals: false, min: 0, name: 'Anticipación' },
            
            // Capacity fields (integers only)
            { id: 'experienceMinPeople', required: false, allowDecimals: false, min: 1, name: 'Mín. Personas' },
            { id: 'experienceMaxPeople', required: false, allowDecimals: false, min: 1, name: 'Máx. Personas' }
        ];

        numericFields.forEach(field => {
            const input = document.getElementById(field.id);
            if (!input) return;

            // Add keydown event listener to prevent invalid characters (better browser support than keypress)
            input.addEventListener('keydown', function(e) {
                preventInvalidInput(e, field.allowDecimals);
            });

            // Add input event listener for real-time validation and cleanup
            input.addEventListener('input', function(e) {
                // First clean any invalid characters (handles paste, drag-drop, etc.)
                cleanNumericInput(e.target, field.allowDecimals);
                // Then validate the field
                validateNumericField(e.target, field);
                
                // For capacity fields, also trigger validation on the related field
                triggerCapacityCrossValidation(field.id);
            });

            // Add paste event listener to handle pasted content
            input.addEventListener('paste', function(e) {
                // Allow the paste to happen, then clean it up
                setTimeout(() => {
                    cleanNumericInput(e.target, field.allowDecimals);
                }, 0);
            });

            // Add blur event listener for final validation
            input.addEventListener('blur', function(e) {
                validateNumericField(e.target, field);
                
                // For capacity fields, also trigger validation on the related field
                triggerCapacityCrossValidation(field.id);
            });

            // Set input mode for better mobile experience
            input.setAttribute('inputmode', field.allowDecimals ? 'decimal' : 'numeric');
        });
    }

    function preventInvalidInput(event, allowDecimals) {
        const keyCode = event.keyCode || event.which;
        const char = String.fromCharCode(keyCode);
        const currentValue = event.target.value;
        
        // Allow: backspace, delete, tab, escape, enter, arrow keys
        if ([8, 9, 27, 13, 46, 35, 36, 37, 38, 39, 40].indexOf(keyCode) !== -1 ||
            // Allow: Ctrl+A, Ctrl+C, Ctrl+V, Ctrl+X, Ctrl+Z (specific key combinations only)
            (event.ctrlKey && [65, 67, 86, 88, 90].indexOf(keyCode) !== -1) ||
            // Allow: Cmd+A, Cmd+C, Cmd+V, Cmd+X, Cmd+Z on Mac
            (event.metaKey && [65, 67, 86, 88, 90].indexOf(keyCode) !== -1) ||
            // Allow: F1-F12
            (keyCode >= 112 && keyCode <= 123)) {
            return;
        }
        
        // Allow numbers: regular keyboard (48-57) and numpad (96-105)
        const isNumber = (keyCode >= 48 && keyCode <= 57) || (keyCode >= 96 && keyCode <= 105);
        
        // Allow decimal point if allowed and not already present
        const isDecimalPoint = allowDecimals && (char === '.' || char === ',' || keyCode === 188 || keyCode === 190) && 
                               currentValue.indexOf('.') === -1 && currentValue.indexOf(',') === -1;
        
        // If not number or decimal point, prevent the input
        if (!isNumber && !isDecimalPoint) {
            event.preventDefault();
            return;
        }
        
        // Prevent shift+number combinations that produce symbols
        if (event.shiftKey && isNumber) {
            event.preventDefault();
        }
    }

    function cleanNumericInput(input, allowDecimals) {
        const currentValue = input.value;
        let cleanedValue = currentValue;
        const cursorPosition = input.selectionStart;
        
        if (allowDecimals) {
            // Allow digits and one decimal point only
            cleanedValue = currentValue.replace(/[^0-9.]/g, '');
            
            // Ensure only one decimal point
            const decimalIndex = cleanedValue.indexOf('.');
            if (decimalIndex !== -1) {
                cleanedValue = cleanedValue.substring(0, decimalIndex + 1) + 
                              cleanedValue.substring(decimalIndex + 1).replace(/\./g, '');
            }
        } else {
            // Allow only digits
            cleanedValue = currentValue.replace(/[^0-9]/g, '');
        }
        
        // Update value if it changed
        if (cleanedValue !== currentValue) {
            input.value = cleanedValue;
            
            // Try to restore cursor position
            const newCursorPosition = Math.min(cursorPosition, cleanedValue.length);
            setTimeout(() => {
                input.setSelectionRange(newCursorPosition, newCursorPosition);
            }, 0);
            
            // Trigger validation after cleaning
            const fieldConfig = getFieldConfig(input.id);
            if (fieldConfig) {
                validateNumericField(input, fieldConfig);
            }
        }
    }

    function getFieldConfig(inputId) {
        const fieldConfigs = [
            { id: 'experienceCost', required: false, allowDecimals: true, min: 0, name: 'Precio Adulto' },
            { id: 'experiencePriceNoAlcohol', required: false, allowDecimals: true, min: 0, name: 'Precio Sin Alcohol' },
            { id: 'experiencePriceChild', required: false, allowDecimals: true, min: 0, name: 'Precio Niño' },
            { id: 'experiencePriceInfant', required: false, allowDecimals: true, min: 0, name: 'Precio Infante' },
            { id: 'experienceDuration', required: false, allowDecimals: true, min: 0, name: 'Duración' },
            { id: 'experienceTravelDuration', required: false, allowDecimals: false, min: 0, name: 'Duración Trayecto' },
            { id: 'experienceAdvanceMinutes', required: false, allowDecimals: false, min: 0, name: 'Anticipación' },
            { id: 'experienceMinPeople', required: false, allowDecimals: false, min: 1, name: 'Mín. Personas' },
            { id: 'experienceMaxPeople', required: false, allowDecimals: false, min: 1, name: 'Máx. Personas' }
        ];
        
        return fieldConfigs.find(config => config.id === inputId);
    }

    function validateNumericField(input, fieldConfig) {
        const value = input.value.trim();
        const numericValue = parseFloat(value);
        let isValid = true;
        let errorMessage = '';

        // Clear previous validation state
        clearFieldValidation(input);

        // Check if required field is empty
        if (fieldConfig.required && (value === '' || isNaN(numericValue))) {
            isValid = false;
            errorMessage = `${fieldConfig.name} es requerido`;
        }
        // Check if optional field has invalid numeric value (but not empty)
        else if (value !== '' && (isNaN(numericValue) || !isFinite(numericValue))) {
            isValid = false;
            errorMessage = `${fieldConfig.name} debe ser un número válido`;
        }
        // Check minimum value constraint
        else if (value !== '' && !isNaN(numericValue) && numericValue < fieldConfig.min) {
            isValid = false;
            errorMessage = `${fieldConfig.name} debe ser mayor o igual a ${fieldConfig.min}`;
        }
        // Check decimal constraint
        else if (value !== '' && !isNaN(numericValue) && !fieldConfig.allowDecimals && numericValue % 1 !== 0) {
            isValid = false;
            errorMessage = `${fieldConfig.name} debe ser un número entero`;
        }

        // Apply validation styling for individual field validation
        if (!isValid) {
            showFieldValidation(input, errorMessage, 'error');
        } else if (value !== '') {
            showFieldValidation(input, '', 'success');
        }

        // For capacity fields, also validate the min/max relationship
        if (isValid && (fieldConfig.id === 'experienceMinPeople' || fieldConfig.id === 'experienceMaxPeople')) {
            const relationshipValid = validateCapacityRelationship();
            if (!relationshipValid) {
                isValid = false;
            }
        }

        return isValid;
    }

    function showFieldValidation(input, message, type) {
        input.classList.remove('is-valid', 'is-invalid');
        
        if (type === 'error') {
            input.classList.add('is-invalid');
            // Find or create error display element
            let errorDiv = input.parentNode.querySelector('.invalid-feedback');
            if (!errorDiv) {
                errorDiv = document.createElement('div');
                errorDiv.className = 'invalid-feedback';
                input.parentNode.appendChild(errorDiv);
            }
            errorDiv.textContent = message;
            errorDiv.style.display = 'block';
        } else if (type === 'success') {
            input.classList.add('is-valid');
        }
    }

    function clearFieldValidation(input) {
        input.classList.remove('is-valid', 'is-invalid');
        const errorDiv = input.parentNode.querySelector('.invalid-feedback');
        if (errorDiv) {
            errorDiv.style.display = 'none';
        }
    }

    function validateCapacityRelationship() {
        const minPeopleInput = document.getElementById('experienceMinPeople');
        const maxPeopleInput = document.getElementById('experienceMaxPeople');
        
        if (!minPeopleInput || !maxPeopleInput) {
            return true; // If inputs don't exist, consider valid
        }

        const minValue = minPeopleInput.value.trim();
        const maxValue = maxPeopleInput.value.trim();
        
        // Only validate relationship if both fields have values
        if (minValue === '' || maxValue === '') {
            return true; // Allow empty fields
        }

        const minPeople = parseInt(minValue, 10);
        const maxPeople = parseInt(maxValue, 10);
        
        // Check if both are valid numbers
        if (isNaN(minPeople) || isNaN(maxPeople)) {
            return true; // Let individual field validation handle invalid numbers
        }

        // Check if min > max
        if (minPeople > maxPeople) {
            // Show error on min field
            showFieldValidation(minPeopleInput, `Min. Personas no puede ser mayor que Max. Personas (${maxPeople})`, 'error');
            
            // Show error on max field
            showFieldValidation(maxPeopleInput, `Max. Personas no puede ser menor que Min. Personas (${minPeople})`, 'error');
            
            return false;
        }

        return true;
    }

    function triggerCapacityCrossValidation(changedFieldId) {
        // Only trigger cross-validation for capacity fields
        if (changedFieldId !== 'experienceMinPeople' && changedFieldId !== 'experienceMaxPeople') {
            return;
        }

        const minPeopleInput = document.getElementById('experienceMinPeople');
        const maxPeopleInput = document.getElementById('experienceMaxPeople');
        
        if (!minPeopleInput || !maxPeopleInput) {
            return;
        }

        // Get the field configs for both capacity fields
        const minFieldConfig = getFieldConfig('experienceMinPeople');
        const maxFieldConfig = getFieldConfig('experienceMaxPeople');
        
        if (!minFieldConfig || !maxFieldConfig) {
            return;
        }

        // If min field changed, also validate max field (but don't show success on max if it has no value)
        if (changedFieldId === 'experienceMinPeople' && maxPeopleInput.value.trim() !== '') {
            // Clear any previous relationship errors on max field first
            clearFieldValidation(maxPeopleInput);
            // Re-validate max field which will trigger relationship validation
            validateNumericField(maxPeopleInput, maxFieldConfig);
        }
        
        // If max field changed, also validate min field (but don't show success on min if it has no value)  
        if (changedFieldId === 'experienceMaxPeople' && minPeopleInput.value.trim() !== '') {
            // Clear any previous relationship errors on min field first
            clearFieldValidation(minPeopleInput);
            // Re-validate min field which will trigger relationship validation
            validateNumericField(minPeopleInput, minFieldConfig);
        }
    }

    function validateAllNumericFields() {
        const numericFields = [
            { id: 'experienceCost', required: false, allowDecimals: true, min: 0, name: 'Precio Adulto' },
            { id: 'experiencePriceNoAlcohol', required: false, allowDecimals: true, min: 0, name: 'Precio Sin Alcohol' },
            { id: 'experiencePriceChild', required: false, allowDecimals: true, min: 0, name: 'Precio Niño' },
            { id: 'experiencePriceInfant', required: false, allowDecimals: true, min: 0, name: 'Precio Infante' },
            { id: 'experienceDuration', required: false, allowDecimals: true, min: 0, name: 'Duración' },
            { id: 'experienceTravelDuration', required: false, allowDecimals: false, min: 0, name: 'Duración Trayecto' },
            { id: 'experienceAdvanceMinutes', required: false, allowDecimals: false, min: 0, name: 'Anticipación' },
            { id: 'experienceMinPeople', required: false, allowDecimals: false, min: 1, name: 'Mín. Personas' },
            { id: 'experienceMaxPeople', required: false, allowDecimals: false, min: 1, name: 'Máx. Personas' }
        ];

        let allValid = true;

        numericFields.forEach(field => {
            const input = document.getElementById(field.id);
            if (input) {
                const isValid = validateNumericField(input, field);
                if (!isValid) {
                    allValid = false;
                }
            }
        });

        // Also validate capacity relationship
        const capacityRelationshipValid = validateCapacityRelationship();
        if (!capacityRelationshipValid) {
            allValid = false;
        }

        return allValid;
    }

    function setupImageUpload() {
        const uploadArea = document.getElementById('mainImageUpload');
        const fileInput = document.getElementById('mainImageInput');
        const removeBtn = document.getElementById('removeMainImageBtn');

        uploadArea.addEventListener('click', () => fileInput.click());
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('border-primary', 'bg-light');
        });
        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('border-primary', 'bg-light');
        });
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('border-primary', 'bg-light');
            if (e.dataTransfer.files.length > 0) handleImageFile(e.dataTransfer.files[0]);
        });
        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) handleImageFile(e.target.files[0]);
        });
        removeBtn.addEventListener('click', () => {
            document.getElementById('mainImagePreview').style.display = 'none';
            document.getElementById('mainImageUpload').style.display = 'block';
            document.getElementById('mainImageImg').src = '';
            document.getElementById('mainImageInput').value = '';
            window._mainImageFile = null;
            window._mainImageRemoved = true;
            // Keep _mainImageId so we know which ExperienceImage to delete on save
        });
    }

    function handleImageFile(file) {
        if (!file.type.match(/^image\/(jpeg|png|webp)$/)) {
            showAlert('Solo se aceptan imagenes JPG, PNG o WebP', 'warning');
            return;
        }
        window._mainImageFile = file;
        window._mainImageRemoved = false;
        const reader = new FileReader();
        reader.onload = (e) => {
            document.getElementById('mainImageImg').src = e.target.result;
            document.getElementById('mainImagePreview').style.display = 'block';
            document.getElementById('mainImageUpload').style.display = 'none';
        };
        reader.readAsDataURL(file);
    }

    function setupPhotoUpload() {
        const addBtn = document.getElementById('addPhotoBtn');
        const fileInput = document.getElementById('experiencePhotoInput');

        addBtn.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', (e) => {
            Array.from(e.target.files).forEach(file => {
                if (file.type.match(/^image\/(jpeg|png|webp)$/)) {
                    pendingPhotoFiles.push(file);
                    addPhotoPreview(file);
                }
            });
            fileInput.value = '';
        });
    }

    function addPhotoPreview(fileOrUrl, imageId, optimizationFormat) {
        const container = document.getElementById('photosPreviewContainer');
        const col = document.createElement('div');
        col.className = 'col-3';
        if (imageId) col.dataset.imageId = imageId;

        const isFile = fileOrUrl instanceof File;

        const formatBadge = optimizationFormat
            ? `<span class="badge bg-success position-absolute bottom-0 start-0 m-1" style="font-size: 9px;">${optimizationFormat.toUpperCase()}</span>`
            : '';

        function renderPreview(src) {
            col.innerHTML = `
                <div class="position-relative">
                    <img src="${src}" class="rounded border w-100" style="height: 80px; object-fit: cover;" alt="Foto">
                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 remove-photo-btn" style="padding: 0 4px; font-size: 10px;">
                        <i class="ti ti-x"></i>
                    </button>
                    ${formatBadge}
                </div>
            `;
            col.querySelector('.remove-photo-btn').addEventListener('click', () => {
                if (isFile) {
                    const idx = pendingPhotoFiles.indexOf(fileOrUrl);
                    if (idx > -1) pendingPhotoFiles.splice(idx, 1);
                }
                col.remove();
            });
        }

        if (isFile) {
            // Use data: URL to avoid CSP blocking blob: URLs
            const reader = new FileReader();
            reader.onload = (e) => renderPreview(e.target.result);
            reader.readAsDataURL(fileOrUrl);
        } else {
            renderPreview(fileOrUrl);
        }

        container.appendChild(col);
    }

    function addDayScheduleRow(day, dayName, startTime = '09:00', endTime = '18:00') {
        const container = document.getElementById('daySchedulesContainer');

        // Don't add if already exists
        if (container.querySelector(`.day-schedule-row[data-day="${day}"]`)) return;

        const template = document.getElementById('dayScheduleRowTemplate');
        const clone = template.content.cloneNode(true);
        const row = clone.querySelector('.day-schedule-row');
        row.dataset.day = day;
        row.querySelector('.day-name span').textContent = dayName;

        // Set initial time values
        row.querySelector('.start-time').value = startTime;
        row.querySelector('.end-time').value = endTime;

        // Remove day button
        row.querySelector('.remove-day-btn').addEventListener('click', () => {
            const dayBtn = document.querySelector(`#availableDaysContainer .day-btn[data-day="${day}"]`);
            if (dayBtn) {
                dayBtn.classList.remove('btn-primary');
                dayBtn.classList.add('btn-outline-primary');
            }
            selectedDays.delete(day);
            row.remove();
            updateNoDaysMessage();
        });

        // Add time slot button
        row.querySelector('.add-time-slot-btn').addEventListener('click', function() {
            addTimeSlotToDay(this.closest('.day-schedule-row'));
        });

        // Remove time slot button
        row.querySelector('.remove-time-slot-btn').addEventListener('click', function() {
            removeTimeSlot(this);
        });

        container.appendChild(row);
    }

