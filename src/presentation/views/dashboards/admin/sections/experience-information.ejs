            }


            // Includes / NotIncludes / Languages (arrays to textarea)
            console.log('🔍 Loading textarea fields - API Response data:', { 
                includes: data.includes, 
                includesType: typeof data.includes,
                includesIsArray: Array.isArray(data.includes),
                notincludes: data.notincludes, 
                notincludesType: typeof data.notincludes,
                notincludesIsArray: Array.isArray(data.notincludes),
                languages: data.languages,
                languagesType: typeof data.languages,
                languagesIsArray: Array.isArray(data.languages)
            });

            // Get textarea elements from the form specifically (avoid modal duplicates)
            const includesEl = document.querySelector('#experienceInformationForm #experienceIncludes');
            const notincludesEl = document.querySelector('#experienceInformationForm #experienceNotIncludes'); 
            const languagesEl = document.querySelector('#experienceInformationForm #experienceLanguages');

            console.log('🔍 Textarea elements found:', {
                includesEl: !!includesEl,
                notincludesEl: !!notincludesEl,
                languagesEl: !!languagesEl
            });

            // Debug: Verify we're targeting the FORM elements, not modal elements
            console.log('🔍 Element verification - ensuring we target form elements not modals:', {
                includesElReadonly: includesEl?.readOnly,
                includesElParentForm: includesEl?.closest('form')?.id,
                notincludesElReadonly: notincludesEl?.readOnly,
                notincludesElParentForm: notincludesEl?.closest('form')?.id,
                languagesElReadonly: languagesEl?.readOnly,
                languagesElParentForm: languagesEl?.closest('form')?.id
            });

            // Store textarea data for later population - maybe something is clearing it after our setTimeout
            const textareaData = {
                includes: Array.isArray(data.includes) ? data.includes.join('\n') : '',
                notincludes: Array.isArray(data.notincludes) ? data.notincludes.join('\n') : '',
                languages: Array.isArray(data.languages) ? data.languages.join('\n') : ''
            };

            // Define the population function
            const populateTextareas = () => {
                console.log('🕐 Attempting textarea population with data:', textareaData);
                
                // Get fresh element references each time - use form-specific selectors to avoid modal duplicates
                const includesEl = document.querySelector('#experienceInformationForm #experienceIncludes');
                const notincludesEl = document.querySelector('#experienceInformationForm #experienceNotIncludes'); 
                const languagesEl = document.querySelector('#experienceInformationForm #experienceLanguages');
                
                console.log('🔍 Fresh textarea elements found:', {
                    includesEl: !!includesEl,
                    notincludesEl: !!notincludesEl,
                    languagesEl: !!languagesEl
                });
                
                if (includesEl) {
                    includesEl.value = textareaData.includes; // Set value even if empty string
                    includesEl.dispatchEvent(new Event('input', { bubbles: true }));
                    includesEl.dispatchEvent(new Event('change', { bubbles: true }));
                    // Force focus and blur to trigger any validation
                    includesEl.focus();
                    includesEl.blur();
                    console.log('✅ Populated experienceIncludes (maintaining original height):', includesEl.value);
                }
                
                if (notincludesEl) {
                    notincludesEl.value = textareaData.notincludes; // Set value even if empty string
                    notincludesEl.dispatchEvent(new Event('input', { bubbles: true }));
                    notincludesEl.dispatchEvent(new Event('change', { bubbles: true }));
                    notincludesEl.focus();
                    notincludesEl.blur();
                    console.log('✅ Populated experienceNotIncludes (maintaining original height):', notincludesEl.value);
                }
                
                if (languagesEl) {
                    languagesEl.value = textareaData.languages; // Set value even if empty string
                    languagesEl.dispatchEvent(new Event('input', { bubbles: true }));
                    languagesEl.dispatchEvent(new Event('change', { bubbles: true }));
                    languagesEl.focus();
                    languagesEl.blur();
                    console.log('✅ Populated experienceLanguages (maintaining original height):', languagesEl.value);
                }
            };

            // Try multiple times with increasing delays to overcome any interference
            setTimeout(populateTextareas, 50);   // First try - fast
            setTimeout(populateTextareas, 200);  // Second try - after potential interference
            setTimeout(populateTextareas, 500);  // Third try - after everything settles
            setTimeout(populateTextareas, 1000); // Final try - very late
            
            // Also try immediately (in case timing isn't the issue)
            populateTextareas();

            // Notes
            document.getElementById('experienceInternalNotes').value = data.internal_notes || '';
            document.getElementById('experienceClientBookingNotes').value = data.client_booking_notes || '';
            document.getElementById('experienceProviderNotes').value = data.provider_notes || '';
            document.getElementById('experienceTeamNotes').value = data.team_notes || '';

            // Availability (supports both old single-slot and new multi-slot formats)
            if (data.availability && Array.isArray(data.availability)) {
                data.availability.forEach(schedule => {
                    // Support both formats: { day, times } (new) and { dayOfWeek, startTime, endTime } (old)
                    const dayCode = schedule.day !== undefined ? schedule.day : schedule.dayOfWeek;
                    const dayStr = String(dayCode);
                    const dayBtn = document.querySelector(`#availableDaysContainer .day-btn[data-day="${dayStr}"]`);
                    if (dayBtn) {
                        dayBtn.classList.remove('btn-outline-primary');
                        dayBtn.classList.add('btn-primary');
                        selectedDays.set(dayStr, true);

                        if (schedule.times && schedule.times.length > 0) {
                            // New multi-slot format (ordenado por hora de inicio)
                            const sortedTimes = sortExpTimes(schedule.times);
                            addDayScheduleRow(dayStr, dayBtn.dataset.dayName, sortedTimes[0].start, sortedTimes[0].end);
                            const dayRow = document.querySelector(`#daySchedulesContainer .day-schedule-row[data-day="${dayStr}"]`);
                            for (let i = 1; i < sortedTimes.length; i++) {
                                addTimeSlotToDay(dayRow, sortedTimes[i].start, sortedTimes[i].end);
                            }
                        } else if (schedule.startTime || schedule.endTime) {
                            // Old single-slot format
                            addDayScheduleRow(dayStr, dayBtn.dataset.dayName, schedule.startTime || '09:00', schedule.endTime || '18:00');
                        } else {
                            addDayScheduleRow(dayStr, dayBtn.dataset.dayName);
                        }
                    }
                });
                updateNoDaysMessage();
            }

            // Load images from ExperienceImage records (optimized with presigned URLs)
            try {
                const imagesRes = await fetch(`/api/experiences/${experienceId}/images`, {
                    headers: { 'Authorization': `Bearer ${accessToken}` }
                });
                const imagesResult = await imagesRes.json();
                if (imagesResult.success && imagesResult.data && imagesResult.data.length > 0) {
                    const primaryImg = imagesResult.data.find(img => img.isPrimary);
                    if (primaryImg) {
                        const primaryUrl = primaryImg.formats?.webp || primaryImg.formats?.jpeg || primaryImg.url;
                        document.getElementById('mainImageImg').src = primaryUrl;
                        document.getElementById('mainImagePreview').style.display = 'block';
                        document.getElementById('mainImageUpload').style.display = 'none';
                        window._mainImageId = primaryImg.id;
                    }
                    imagesResult.data.forEach(img => {
                        if (!img.isPrimary) {
                            const displayUrl = img.formats?.webp || img.formats?.jpeg || img.url;
                            const fmt = img.formats?.avif ? 'avif' : img.formats?.webp ? 'webp' : img.formats?.jpeg ? 'jpeg' : null;
                            addPhotoPreview(displayUrl, img.id, fmt);
                        }
                    });
                } else if (data.mainImage) {
                    // Fallback: load from experience.mainImage field (backward compat)
                    document.getElementById('mainImageImg').src = data.mainImage;
                    document.getElementById('mainImagePreview').style.display = 'block';
                    document.getElementById('mainImageUpload').style.display = 'none';
                }
            } catch (imgError) {
                console.error('Error loading images:', imgError);
                // Fallback to mainImage field
                if (data.mainImage) {
                    document.getElementById('mainImageImg').src = data.mainImage;
                    document.getElementById('mainImagePreview').style.display = 'block';
                    document.getElementById('mainImageUpload').style.display = 'none';
                }
            }

        } catch (error) {
            console.error('Error loading experience data:', error);
            showAlert('Error al cargar datos de la experiencia', 'danger');
        }
    }

    // Debug mode helper functions
    function isDebugMode() {
        return new URLSearchParams(window.location.search).get('debug') === 'true' || 
               localStorage.getItem('experienceDebugMode') === 'true';
    }

    function debugLog(label, data) {
        const logEntry = {
            timestamp: new Date().toISOString(),
            label,
            data
        };
        
        console.log(`🔍 ${label}:`, data);
        
        // Store in localStorage for persistence
        if (isDebugMode()) {
            const logs = JSON.parse(localStorage.getItem('experienceDebugLogs') || '[]');
            logs.push(logEntry);
            // Keep only last 50 logs
            if (logs.length > 50) logs.shift();
            localStorage.setItem('experienceDebugLogs', JSON.stringify(logs));
        }
    }

    // Debug log viewer function for persistent debugging
    function showDebugLogs() {
        const logs = JSON.parse(localStorage.getItem('experienceDebugLogs') || '[]');
        const servicesLogs = logs.filter(log => log.label.includes('Services Transfer'));
        
        console.group('🔍 Experience Services Transfer Debug Logs');
        console.log('Total logs:', logs.length, 'Services transfer logs:', servicesLogs.length);
        
        servicesLogs.forEach((log, index) => {
            console.log(`${index + 1}. [${log.timestamp}] ${log.label}:`, log.data);
        });
        
        console.groupEnd();
        
        // Also show in alert if requested
        if (servicesLogs.length > 0) {
            const lastLog = servicesLogs[servicesLogs.length - 1];
            const summary = `Last services log: ${lastLog.label} at ${new Date(lastLog.timestamp).toLocaleTimeString()}`;
            showAlert(`Debug: ${summary}. Check console for full logs.`, 'info');
        } else {
            showAlert('No services transfer logs found in debug history.', 'info');
        }
    }
    
    // Make debug viewer available globally
    window.showDebugLogs = showDebugLogs;

    // Check user authorization for services transfer
    async function checkServiceTransferAuthorization(accessToken) {
        try {
            // Test if user can access service items endpoint by making a GET request
            const response = await fetch(`/api/experiences/test/service-items`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${accessToken}`,
                    'Content-Type': 'application/json'
                }
            });
            
            debugLog('Authorization Check - Service Items Endpoint', {
                status: response.status,
                statusText: response.statusText,
                hasAuth: response.status !== 401,
                hasPermission: response.status !== 403,
                canAccess: response.status === 404 || response.status === 200, // 404 means endpoint exists but experience doesn't, which is fine
            });
            
            return response.status !== 401 && response.status !== 403;
        } catch (error) {
            debugLog('Authorization Check - Failed', { error: error.message });
            return false;
        }
    }

    // Get JWT token from cookies - use clientAccessToken (non-httpOnly cookie)
    function getAccessToken() {
        const cookies = document.cookie.split(';');
        for (let cookie of cookies) {
            const [name, value] = cookie.trim().split('=');
            if (name === 'clientAccessToken') {
                return value;
            }
        }
        return null;
    }

    // Construye el payload JSON de la experiencia (TODOS los campos menos imágenes).
    // Reutilizado por el guardado manual y por el autoguardado.
    function buildExperienceInfoBody() {
        const nameEl = document.getElementById('experienceName');
        const descEl = document.getElementById('experienceDescription');
        const costEl = document.querySelector('#experienceInformationForm #experienceCost') || document.getElementById('experienceCost');
        const bName = ((capturedFormValues.name || (nameEl && nameEl.value) || '')).trim();
        const bDescription = ((capturedFormValues.description || (descEl && descEl.value) || '')).trim() || bName;
        const bCost = parseFloat(capturedFormValues.cost || (costEl && costEl.value)) || 0;

        const availability = [];
        document.querySelectorAll('#daySchedulesContainer .day-schedule-row').forEach(row => {
            const daySchedule = { day: parseInt(row.dataset.day), times: [] };
            row.querySelectorAll('.time-slot-row').forEach(slotRow => {
                const start = slotRow.querySelector('.start-time').value;
                const end = slotRow.querySelector('.end-time').value;
                if (start && end) daySchedule.times.push({ start, end });
            });
            daySchedule.times = sortExpTimes(daySchedule.times);
            if (daySchedule.times.length > 0) availability.push(daySchedule);
        });

        return {
            name: bName,
            description: bDescription,
            type: 'Experience',
            cost: bCost,
            price_no_alcohol: parseFloat(document.getElementById('experiencePriceNoAlcohol').value) || null,
            price_child: parseFloat(document.getElementById('experiencePriceChild').value) || null,
            price_infant: parseFloat(document.getElementById('experiencePriceInfant').value) || null,
            duration: parseFloat(document.getElementById('experienceDuration').value) || null,
            travel_duration: parseInt(document.getElementById('experienceTravelDuration').value) || null,
            advance_minutes: parseInt(document.getElementById('experienceAdvanceMinutes').value) || null,
            min_people: parseInt(document.getElementById('experienceMinPeople').value) || null,
            max_people: parseInt(document.getElementById('experienceMaxPeople').value) || null,
            cancellation_policy: document.getElementById('experienceCancellationPolicy').value.trim() || null,
            buyout: parseFloat(document.getElementById('experienceBuyout').value) || null,
            experience_category: document.getElementById('experienceCategory').value || null,
            tipo: (document.getElementById('experienceTipo') || {}).value || null,
            general_guide: !!(document.getElementById('generalGuideToggle') || {}).checked,
            general_chofer: !!(document.getElementById('generalChoferToggle') || {}).checked,
            general_guide_rate: parseFloat((document.getElementById('generalGuideRate') || {}).value) || null,
            general_chofer_rate: parseFloat((document.getElementById('generalChoferRate') || {}).value) || null,
            private_min_type: document.getElementById('experiencePrivateMinType').value || null,
            private_min_value: parseFloat(document.getElementById('experiencePrivateMinValue').value) || null,
            includes: stringToArray(capturedFormValues.includes) || textareaToArray('experienceIncludes'),
            notincludes: stringToArray(capturedFormValues.notincludes) || textareaToArray('experienceNotIncludes'),
            languages: stringToArray(capturedFormValues.languages) || textareaToArray('experienceLanguages'),
            internal_notes: document.getElementById('experienceInternalNotes').value.trim() || null,
            client_booking_notes: document.getElementById('experienceClientBookingNotes').value.trim() || null,
            provider_notes: document.getElementById('experienceProviderNotes').value.trim() || null,
            team_notes: document.getElementById('experienceTeamNotes').value.trim() || null,
            availability: availability.length > 0 ? availability : null,
            fixed_schedule: document.getElementById('experienceFixedSchedule').checked,
            destinationPOI: document.getElementById('experienceDestino').value || null,
        };
    }

    // Versionado por costo: cuando cambia 'cost', el backend crea una NUEVA versión con
    // otro objectId (y marca la vieja con valid_until). Si el front sigue usando el id
    // viejo, el siguiente GET/PUT falla (queda histórico). Aquí adoptamos el id nuevo.
    function applyVersionedId(result) {
        if (!result || !result.success || !result.data) return;
        const d = result.data;
        if (!d.costChanged || !d.id) return;
        const newId = d.id;
        window.__experienceDraftId = newId;                 // id de trabajo para el autosave
        if (window.experienceServicesBuilder) window.experienceServicesBuilder.experienceId = newId; // service-items al id vigente
        try {
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', `/dashboard/admin/experiences/${newId}`);
            }
        } catch (e) { /* noop */ }
    }

    // ===== AUTOGUARDADO de la EXPERIENCIA COMPLETA (sin imágenes) =====
    // Las imágenes son pesadas: NO entran al autosave; solo se suben con el botón Guardar.
    let _infoAutoSaveTimer = null;
    let _infoAutoSaveInFlight = false;
    function setAutoSaveStatus(state) {
        // Toast FIJO (position:fixed en <body>) para que se vea aunque estés haciendo scroll.
        let el = document.getElementById('expAutoSaveToast');
        if (!el) {
            el = document.createElement('div');
            el.id = 'expAutoSaveToast';
            el.style.cssText = 'position:fixed;z-index:2000;right:18px;bottom:18px;display:inline-flex;align-items:center;padding:9px 16px;border-radius:999px;font-size:13px;font-weight:600;box-shadow:0 6px 20px rgba(0,0,0,.18);opacity:0;transition:opacity .25s;pointer-events:none;';
            document.body.appendChild(el);
        }
        if (state === 'saving') {
            el.style.background = '#ffffff'; el.style.color = '#6E7A50'; el.style.border = '1px solid #d9dcc9';
            el.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando cambios…';
            el.style.opacity = '1';
        } else if (state === 'saved') {
            el.style.background = '#eaf3e4'; el.style.color = '#3f7a3f'; el.style.border = '1px solid #c3ddb6';
            el.innerHTML = '<i class="ti ti-cloud-check me-2"></i>Cambios guardados';
            el.style.opacity = '1';
            setTimeout(() => { el.style.opacity = '0'; }, 2000);
        } else {
            el.style.opacity = '0';
        }
    }
    function scheduleExperienceInfoAutoSave() {
        clearTimeout(_infoAutoSaveTimer);
        _infoAutoSaveTimer = setTimeout(() => { autoSaveExperienceInfo(); }, 900);
    }
    async function autoSaveExperienceInfo() {
        const nameEl = document.getElementById('experienceName');
        if (!nameEl || !nameEl.value.trim()) return;            // sin nombre no se guarda
        if (_infoAutoSaveInFlight) { scheduleExperienceInfoAutoSave(); return; } // reintenta luego
        if (typeof validateAllNumericFields === 'function' && !validateAllNumericFields()) return; // no guardar con errores
        const accessToken = getAccessToken() || localStorage.getItem('authToken');
        if (!accessToken) return;

        // Necesita un id: experiencia existente o borrador. Para una nueva, crea el borrador.
        let targetId = window.__experienceDraftId || (isNew ? null : experienceId);
        if (!targetId && isNew && window.experienceServicesBuilder && window.experienceServicesBuilder.ensureDraftExperience) {
            try { targetId = (await window.experienceServicesBuilder.ensureDraftExperience()) || window.__experienceDraftId; } catch (e) { return; }
        }
        if (!targetId) return;

        const body = buildExperienceInfoBody(); // sin imágenes, sin tocar 'active' (no finaliza el borrador)
        _infoAutoSaveInFlight = true;
        setAutoSaveStatus('saving');
        try {
            const res = await fetch(`/api/experiences/${targetId}`, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(body),
            });
            const result = await res.json().catch(() => null);
            if (res.ok && result && result.success) {
                applyVersionedId(result); // si versionó por costo, adopta el nuevo id
                setAutoSaveStatus('saved');
            } else {
                setAutoSaveStatus('idle');
            }
        } catch (e) {
            console.warn('Autoguardado de experiencia falló:', e);
            setAutoSaveStatus('idle');
        } finally {
            _infoAutoSaveInFlight = false;
        }
    }
    // Exponer para que la sección de Servicios (toggles generales, mín/máx, duración) lo dispare.
    window.scheduleExperienceInfoAutoSave = scheduleExperienceInfoAutoSave;

    async function saveExperience() {
        // Nombre global obligatorio: no se puede guardar sin él. Enfoca el campo.
        const globalNameEl = document.getElementById('experienceName');
        if (!globalNameEl || !globalNameEl.value.trim()) {
            showAlert('El nombre de la experiencia es obligatorio.', 'warning');
            if (globalNameEl) {
                globalNameEl.focus();
                globalNameEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return;
        }

        // Try multiple auth approaches - same as provider modal
        const accessToken = getAccessToken() || localStorage.getItem('authToken');
        
        if (!accessToken) {
            showAlert('Error de autenticación. Por favor, recarga la página e intenta nuevamente.', 'danger');
            debugLog('Save Experience - Auth Error', { 
                hasToken: false,
                cookieToken: !!getAccessToken(),
                localStorageToken: !!localStorage.getItem('authToken')
            });
            return;
        }

        // Debug services state at start of save
        const tempServicesCheck = localStorage.getItem('tempExperienceServices');
        debugLog('Save Experience - Initial Services Check', {
            hasTemporaryServices: !!tempServicesCheck,
            servicesData: tempServicesCheck ? JSON.parse(tempServicesCheck) : null,
            experienceId: experienceId
        });

        // Enhanced debugging - check element existence first
        // Use specific form ID to guarantee correct element targeting
        const nameElement = document.querySelector('#experienceName');
        const descriptionElement = document.querySelector('#experienceDescription');
        const costElement = document.querySelector('#experienceInformationForm #experienceCost');

        debugLog('Save Experience - Element Check', {
            nameElementExists: !!nameElement,
            descriptionElementExists: !!descriptionElement,
            costElementExists: !!costElement,
            descriptionElementType: descriptionElement ? descriptionElement.tagName : 'null',
            descriptionElementValue: descriptionElement ? descriptionElement.value : 'no element',
            descriptionElementTextContent: descriptionElement ? descriptionElement.textContent : 'no element',
            descriptionElementInnerHTML: descriptionElement ? descriptionElement.innerHTML : 'no element'
        });

        if (!nameElement || !descriptionElement || !costElement) {
            showAlert('Error: No se pudieron encontrar los campos del formulario', 'danger');
            debugLog('Save Experience - Missing Elements Error', {
                nameElement: !!nameElement,
                descriptionElement: !!descriptionElement,
                costElement: !!costElement
            });
            return;
        }

        // Use a small delay to ensure DOM is fully updated
        await new Promise(resolve => setTimeout(resolve, 100));
        
        // Try multiple methods to get the values
        const directName = nameElement.value;
        const directDescription = descriptionElement.value;
        const directCost = costElement.value;
        
        // Force update the values by triggering change events
        nameElement.dispatchEvent(new Event('change', { bubbles: true }));
        descriptionElement.dispatchEvent(new Event('change', { bubbles: true }));
        costElement.dispatchEvent(new Event('change', { bubbles: true }));
        
        // Use captured values as primary source, with direct reading as fallback
        const name = (capturedFormValues.name || directName || '').trim();
        // Solo el nombre es obligatorio: si no hay descripción, usa el nombre por
        // defecto (el backend sí valida que description no sea vacío).
        const description = (capturedFormValues.description || directDescription || '').trim() || name;
        const cost = parseFloat(capturedFormValues.cost || directCost) || 0;

        debugLog('Save Experience - Form Data', {
            name,
            description,
            cost,
            nameLength: name.length,
            descriptionLength: description.length,
            hasAccessToken: !!accessToken,
            tokenLength: accessToken.length,
            // Additional debugging info
            capturedName: capturedFormValues.name,
            capturedDescription: capturedFormValues.description,
            capturedCost: capturedFormValues.cost,
            directName: directName,
            directDescription: directDescription,
            directCost: directCost,
            rawNameValue: nameElement.value,
            rawDescriptionValue: descriptionElement.value,
            rawCostValue: costElement.value
        });

        if (!name) { showAlert('El nombre es requerido', 'warning'); return; }
        // Descripción ya NO es obligatoria (cae al nombre por defecto arriba).
        if (cost < 0) { showAlert('El costo debe ser mayor o igual a 0', 'warning'); return; }
        
        // Validate all numeric fields before saving
        if (!validateAllNumericFields()) {
            showAlert('Por favor, corrige los errores en los campos numericos antes de guardar', 'warning');
            return;
        }

        const saveBtn = document.getElementById('saveExperienceInfoBtn');
        const saveText = document.getElementById('saveButtonText');
        saveBtn.disabled = true;

        // Progress helper
        const totalSteps = 1 + (window._mainImageFile ? 1 : 0) + pendingPhotoFiles.length;
        let currentStep = 0;
        function updateProgress(msg) {
            currentStep++;
            if (totalSteps > 1) {
                saveText.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span>${msg} (${currentStep}/${totalSteps})`;
            } else {
                saveText.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span>${msg}`;
            }
        }

        try {
            updateProgress('Guardando datos...');

            // Payload común (todos los campos menos imágenes). Mismo builder que el autosave.
            const body = buildExperienceInfoBody();
            // Versionado EXPLÍCITO: solo el guardado MANUAL puede versionar el precio, y solo
            // si el usuario marcó el checkbox. El autoguardado nunca manda esto (actualiza en
            // el mismo registro), por eso no crea versiones ni cambia el id.
            body.createVersion = !!document.getElementById('experienceCreateVersion')?.checked;

            // 🔍 SAVE DEBUG - Log destinationPOI save details
            const destinoValue = document.getElementById('experienceDestino').value;
            const destinoElement = document.getElementById('experienceDestino');
            console.log('🔍 SAVE DEBUG - Destino form value:', destinoValue);
            console.log('🔍 SAVE DEBUG - Destino element:', destinoElement);
            console.log('🔍 SAVE DEBUG - Destino dropdown options:', Array.from(destinoElement.options).map(o => ({value: o.value, text: o.textContent})));
            console.log('🔍 SAVE DEBUG - Selected option:', destinoElement.selectedOptions[0] ? {value: destinoElement.selectedOptions[0].value, text: destinoElement.selectedOptions[0].textContent} : 'None selected');
            console.log('🔍 SAVE DEBUG - Body.destinationPOI:', body.destinationPOI);

            if (window._mainImageRemoved) {
                body.mainImage = '';
            }

            debugLog('Save Experience - Request Body', {
                url: isNew ? '/api/experiences' : `/api/experiences/${experienceId}`,
                method: isNew ? 'POST' : 'PUT',
                body: body,
                authToken: accessToken ? `${accessToken.substring(0, 10)}...` : 'NO TOKEN',
                hasToken: !!accessToken,
                bodyStringified: JSON.stringify(body, null, 2),
                capturedTextareas: {
                    includes: capturedFormValues.includes,
                    notincludes: capturedFormValues.notincludes,
                    languages: capturedFormValues.languages
                },
                finalArrays: {
                    includes: body.includes,
                    notincludes: body.notincludes,
                    languages: body.languages
                }
            });

            // F3 (draft-first): si al agregar servicios ya se creó un borrador
            // (active:false), este "guardar" lo FINALIZA (PUT + active:true) en vez
            // de crear una experiencia duplicada.
            const draftId = window.__experienceDraftId || null;
            const creatingNew = isNew && !draftId;
            const targetId = draftId || experienceId;
            if (draftId) body.active = true;

            const url = creatingNew ? '/api/experiences' : `/api/experiences/${targetId}`;
            const method = creatingNew ? 'POST' : 'PUT';

            const response = await fetch(url, {
                method,
                headers: {
                    'Authorization': `Bearer ${accessToken}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(body)
            });

            const result = await response.json();

            // 🔍 SAVE RESPONSE DEBUG - Log server response details
            console.log('🔍 SAVE RESPONSE DEBUG - Complete server response:', result);
            console.log('🔍 SAVE RESPONSE DEBUG - Response success:', result.success);
            console.log('🔍 SAVE RESPONSE DEBUG - Response data:', result.data);
            if (result.data && result.data.destinationPOI) {
                console.log('🔍 SAVE RESPONSE DEBUG - Saved destinationPOI in response:', result.data.destinationPOI);
            } else {
                console.log('🔍 SAVE RESPONSE DEBUG - No destinationPOI in response data');
            }

            // Store access token if provided in response
            if (result.accessToken) {
                localStorage.setItem('accessToken', result.accessToken);
                debugLog('Save Experience - Token Stored', { tokenStored: true });
            }

            debugLog('Save Experience - Server Response', {
                status: response.status,
                success: result.success,
                result: result,
                isNew: isNew,
                hasData: !!result.data,
                dataId: result.data?.id
            });

            if (!result.success) {
                console.error('❌ Save Experience Failed:', result);
                showAlert(result.error || 'Error al guardar', 'danger');
                return;
            }

            // Si el guardado versionó por costo (nuevo objectId), adopta el id nuevo para
            // que las imágenes y guardados siguientes no apunten al registro histórico.
            applyVersionedId(result);
            // Desmarca "crear versión": es una acción puntual, no debe repetirse en el
            // siguiente guardado sin que el usuario lo vuelva a pedir.
            const verChk = document.getElementById('experienceCreateVersion');
            if (verChk) verChk.checked = false;

            // Delete old main image if removed (without replacement)
            if (window._mainImageRemoved && !window._mainImageFile && window._mainImageId) {
                try {
                    const expIdForDelete = result.data?.id || experienceId;
                    await fetch(`/api/experiences/${expIdForDelete}/images/${window._mainImageId}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': `Bearer ${accessToken}` }
                    });
                    window._mainImageId = null;
                } catch (delErr) {
                    console.warn('Could not delete old main image:', delErr);
                }
            }

            // Upload main image if new file
            if (window._mainImageFile && result.data && result.data.id) {
                updateProgress('Subiendo imagen principal...');
                await uploadMainImage(result.data.id, window._mainImageFile);
            }

            // Upload pending photos
            if (pendingPhotoFiles.length > 0 && result.data && result.data.id) {
                const photoCount = pendingPhotoFiles.length;
                for (let i = 0; i < photoCount; i++) {
                    updateProgress(`Optimizando foto ${i + 1} de ${photoCount}...`);
                    await uploadPhoto(result.data.id, pendingPhotoFiles[i]);
                }
                pendingPhotoFiles.length = 0;
            }

            saveText.innerHTML = `<i class="ti ti-check me-1"></i>Guardado`;
            showAlert(isNew ? 'Experiencia creada exitosamente' : 'Cambios guardados exitosamente', 'success');

            if (isNew) {
                // F3 (draft-first): normalmente los servicios ya se guardaron directo
                // contra el borrador (active:false); no hay transferencia desde
                // localStorage. Limpiamos el marcador y vamos al detalle.
                const finalId = (result.data && result.data.id) || draftId || experienceId;
                window.__experienceDraftId = null;
                localStorage.removeItem('tempExperienceServices');
                if (window.experienceServicesBuilder) {
                    const builder = window.experienceServicesBuilder;
                    builder.experienceId = finalId;
                    // Red de seguridad: si el usuario agregó servicios ANTES de poner
                    // el nombre (aún en memoria, sin borrador creado), persístelos ahora
                    // contra la experiencia real para no perderlos.
                    if (builder.services && builder.services.size > 0) {
                        try {
                            await builder.saveToBackend();
                        } catch (flushErr) {
                            console.warn('No se pudieron guardar los servicios en memoria:', flushErr);
                            showAlert('La experiencia se creó, pero revisa que los servicios se hayan guardado.', 'warning');
                        }
                    }
                }

                if (typeof isDebugMode === 'function' && isDebugMode()) {
                    showAlert(`Debug: experiencia ${finalId} guardada. Redirect prevenido.`, 'info');
                } else {
                    setTimeout(() => {
                        window.location.href = `/dashboard/admin/experiences/${finalId}`;
                    }, 1000);
                }
            }
        } catch (error) {
            console.error('Error saving experience:', error);
            showAlert('Error al guardar la experiencia', 'danger');
        } finally {
            saveBtn.disabled = false;
            setTimeout(() => {
                saveText.innerHTML = isNew ? 'Crear Experiencia' : 'Guardar Cambios';
            }, 2000);
        }
    }

    async function uploadMainImage(expId, file) {
        try {
            // Get fresh access token
            const accessToken = getAccessToken();
            
            // Delete old primary image if it exists
            if (window._mainImageId) {
                try {
                    await fetch(`/api/experiences/${expId}/images/${window._mainImageId}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': `Bearer ${accessToken}` }
                    });
                } catch (delErr) {
                    console.warn('Could not delete old main image:', delErr);
                }
            }

            const formData = new FormData();
            formData.append('image', file);
            formData.append('isPrimary', 'true');

            const response = await fetch(`/api/experiences/${expId}/images`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${accessToken}` },
                body: formData
            });

            const result = await response.json();
            if (result.success && result.data) {
                window._mainImageId = result.data.id;
            } else {
                console.error('Main image upload failed:', result.error);
            }
        } catch (error) {
            console.error('Error uploading main image:', error);
        }
    }

    async function uploadPhoto(expId, file) {
        try {
            // Get fresh access token
            const accessToken = getAccessToken();
            
            const formData = new FormData();
            formData.append('image', file);

            const response = await fetch(`/api/experiences/${expId}/images`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${accessToken}` },
                body: formData
            });
            const result = await response.json();
            if (!result.success) {
                console.error('Photo upload failed:', result.error);
            }
        } catch (error) {
            console.error('Error uploading photo:', error);
        }
    }

    // Guarda SOLO imágenes (portada + fotos), sin el resto del formulario. Sirve para que
    // el usuario no las olvide: el autoguardado no las sube (son pesadas).
    async function saveImagesOnly() {
        const nameEl = document.getElementById('experienceName');
        if (!nameEl || !nameEl.value.trim()) {
            showAlert('Escribe primero el nombre de la experiencia para poder subir imágenes.', 'warning');
            if (nameEl) { nameEl.focus(); nameEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
            return;
        }
        const accessToken = getAccessToken() || localStorage.getItem('authToken');
        if (!accessToken) { showAlert('Error de autenticación. Recarga la página.', 'danger'); return; }

        const hasMainNew = !!window._mainImageFile;
        const hasMainRemoved = !!(window._mainImageRemoved && !window._mainImageFile && window._mainImageId);
        const hasPhotos = pendingPhotoFiles.length > 0;
        if (!hasMainNew && !hasMainRemoved && !hasPhotos) {
            showAlert('No hay imágenes nuevas por guardar.', 'info');
            return;
        }

        // Asegura que la experiencia exista (borrador o real) antes de subir imágenes.
        let targetId = window.__experienceDraftId || (isNew ? null : experienceId);
        if (!targetId && isNew && window.experienceServicesBuilder && window.experienceServicesBuilder.ensureDraftExperience) {
            try { targetId = (await window.experienceServicesBuilder.ensureDraftExperience()) || window.__experienceDraftId; } catch (e) {}
        }
        if (!targetId) { showAlert('No se pudo preparar la experiencia para subir imágenes.', 'danger'); return; }

        const btn = document.getElementById('savePhotosBtn');
        const btnHtml = btn ? btn.innerHTML : '';
        if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando imágenes...'; }
        try {
            if (hasMainRemoved) {
                try {
                    await fetch(`/api/experiences/${targetId}/images/${window._mainImageId}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${accessToken}` } });
                    window._mainImageId = null; window._mainImageRemoved = false;
                } catch (delErr) { console.warn('No se pudo borrar la portada:', delErr); }
            }
            if (hasMainNew) {
                await uploadMainImage(targetId, window._mainImageFile);
                window._mainImageFile = null; window._mainImageRemoved = false;
            }
            if (pendingPhotoFiles.length > 0) {
                const count = pendingPhotoFiles.length;
                for (let i = 0; i < count; i++) {
                    // eslint-disable-next-line no-await-in-loop
                    await uploadPhoto(targetId, pendingPhotoFiles[i]);
                }
                pendingPhotoFiles.length = 0;
            }
            showAlert('Imágenes guardadas correctamente.', 'success');
            setAutoSaveStatus('saved');
        } catch (e) {
            console.error('Error guardando imágenes:', e);
            showAlert('Error al subir las imágenes.', 'danger');
        } finally {
            if (btn) { btn.disabled = false; btn.innerHTML = btnHtml; }
        }
    }

    function showAlert(message, type) {
        const container = document.getElementById('experienceInfoAlerts');
        container.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                <i class="ti ti-${type === 'success' ? 'check' : type === 'danger' ? 'alert-circle' : 'info-circle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        if (type === 'success') {
            setTimeout(() => { container.innerHTML = ''; }, 3000);
        }
    }
});
</script>

