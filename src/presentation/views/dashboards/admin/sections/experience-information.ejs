                            const dayRow = document.querySelector(`#daySchedulesContainer .day-schedule-row[data-day="${dayStr}"]`);
                            for (let i = 1; i < schedule.times.length; i++) {
                                addTimeSlotToDay(dayRow, schedule.times[i].start, schedule.times[i].end);
                            }
                        } else if (schedule.startTime || schedule.endTime) {
                            // Old single-slot format
                            addDayScheduleRow(dayStr, dayBtn.dataset.dayName, schedule.startTime || '09:00', schedule.endTime || '18:00');
                        } else {
                            addDayScheduleRow(dayStr, dayBtn.dataset.dayName);
