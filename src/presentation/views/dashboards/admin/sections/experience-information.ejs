            console.log('🔍 LOAD DEBUG - Available dropdown options:', Array.from(destinoDropdown.options).map(o => ({value: o.value, text: o.textContent})));

            // Set destinationPOI if exists
            if (data.destinationPOI && data.destinationPOI.id) {
                console.log('🔍 LOAD DEBUG - Setting destinationPOI value:', data.destinationPOI.id);
                console.log('🔍 LOAD DEBUG - DestinationPOI object:', data.destinationPOI);
                
                document.getElementById('experienceDestino').value = data.destinationPOI.id;
                
                // Verify the value was set correctly
                const setValueCheck = document.getElementById('experienceDestino').value;
                console.log('🔍 LOAD DEBUG - Value after setting:', setValueCheck);
                console.log('🔍 LOAD DEBUG - Value set successfully:', setValueCheck === data.destinationPOI.id);
                console.log('🔍 LOAD DEBUG - Selected option after setting:', destinoDropdown.selectedOptions[0] ? {value: destinoDropdown.selectedOptions[0].value, text: destinoDropdown.selectedOptions[0].textContent} : 'None selected');
                
