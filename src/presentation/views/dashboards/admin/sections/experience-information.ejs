    function removeTimeSlot(btn) {
        const timeSlotsContainer = btn.closest('.time-slots-container');
        const timeSlotRow = btn.closest('.time-slot-row');
        // Only remove if there's more than one time slot
        if (timeSlotsContainer.querySelectorAll('.time-slot-row').length > 1) {
            timeSlotRow.remove();
        }
    }

    function removeDayScheduleRow(day) {
        const row = document.querySelector(`#daySchedulesContainer .day-schedule-row[data-day="${day}"]`);
