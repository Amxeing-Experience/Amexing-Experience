<%
/**
 * Quote Services Modals - Modal components for the itinerary builder
 * Created by Denisse Maldonado
 */

// Define role-based permissions at the top of the file
const currentUserRole = typeof userRole !== 'undefined' ? userRole : '';
const canEditPrices = ['admin', 'superadmin'].includes(currentUserRole);
%>

<!-- Day Modal -->
<div class="modal fade" id="dayModal" tabindex="-1" aria-labelledby="dayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title" id="dayModalLabel">
                    <i class="ti ti-calendar-plus me-2"></i>Agregar Día
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Alert Container for Modal -->
                <div id="dayModalAlert" class="modal-alert-container"></div>
                
                <form id="dayForm">
                    <div class="mb-3">
                        <label for="dayTitle" class="form-label">Título del Día</label>
                        <input type="text" class="form-control" id="dayTitle" placeholder="Ej: Llegada y City Tour">
                        <div class="form-text">Opcional: Dale un nombre descriptivo a este día del itinerario. Si se deja vacío, se generará automáticamente como "Día X"</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="dayDate" class="form-label">Fecha</label>
                        <input type="date" class="form-control" id="dayDate">
                        <div class="form-text">Opcional: Asigna una fecha específica</div>
                    </div>

                    <div class="mb-3">
                        <label for="dayDescription" class="form-label">Descripción</label>
                        <textarea class="form-control" id="dayDescription" rows="3" placeholder="Descripción general del día..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="saveDayBtn">
                    <i class="ti ti-device-floppy me-1"></i>Guardar Día
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Service Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-labelledby="serviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title" id="serviceModalLabel">
                    <i class="ti ti-plus-circle me-2"></i>Agregar Servicio
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Alert Container for Modal -->
                <div id="serviceModalAlert" class="modal-alert-container"></div>
                
                <form id="serviceForm">
                    <!-- Service Type Selection -->
                    <div class="service-type-selector mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0">Servicio <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="serviceType" id="typeExperience" value="experience" checked>
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeExperience">
                                    <i class="ti ti-beach me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Experiencia</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="serviceType" id="typeTour" value="tour">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeTour">
                                    <i class="ti ti-map-2 me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Tour</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="serviceType" id="typeTransport" value="transport">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeTransport">
                                    <i class="ti ti-car me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Transporte</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="serviceType" id="typeADisposicion" value="a-disposicion">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeADisposicion">
                                    <i class="ti ti-clock-hour-4 me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">A Disposición</span>
                                </label>

                                <input type="radio" class="btn-check" name="serviceType" id="typeConcepto" value="concepto">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeConcepto">
                                    <i class="ti ti-file-text me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Concepto</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Transport Type Selection (only visible when transport is selected) -->
                    <div id="transportTypeSelector" class="mb-3 d-none">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0">Transporte <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="transportType" id="transportAeropuerto" value="aeropuerto" checked>
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="transportAeropuerto">
                                    <i class="ti ti-plane me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Aeropuerto</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="transportType" id="transportPuntoAPunto" value="punto-a-punto">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="transportPuntoAPunto">
                                    <i class="ti ti-route me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Punto a Punto</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="transportType" id="transportLocal" value="local">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="transportLocal">
                                    <i class="ti ti-map-pin me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Local</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Trip Type Selection (only visible when transport is selected) -->
                    <div id="tripTypeSelector" class="mb-3 d-none">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0">Viaje <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="tripType" id="tripOneWay" value="one-way" checked>
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="tripOneWay">
                                    <i class="ti ti-arrow-right me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">One Way</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="tripType" id="tripRoundTrip" value="round-trip">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="tripRoundTrip">
                                    <i class="ti ti-arrows-right-left me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Round Trip</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Content Based on Service Type -->
                    <div id="serviceTypeContent">
                        <!-- Experience/Tour Selection -->
                        <div id="experienceContent" class="service-content">
                            <div class="mb-3">
                                <label for="experienceSelect" class="form-label">Seleccionar Experiencia <span class="text-danger">*</span></label>
                                <select class="form-select" id="experienceSelect" required>
                                    <option value="">-- Selecciona una experiencia --</option>
                                </select>
                                <div class="form-text" id="experienceAvailabilityWarning" style="display: none; color: #fd7e14;">
                                    *Se verificará disponibilidad y se confirmará en la reservación
                                </div>
                            </div>
                            
                        </div>

                        <!-- Tour Selection -->
                        <div id="tourContent" class="service-content d-none">
                            <div class="mb-3">
                                <label for="tourSelect" class="form-label">Seleccionar Tour <span class="text-danger">*</span></label>
                                <select class="form-select" id="tourSelect" required>
                                    <option value="">-- Selecciona un tour --</option>
                                </select>
                                <div class="form-text" id="tourAvailabilityWarning" style="display: none; color: #fd7e14;">
                                    *Se verificará disponibilidad y se confirmará en la reservación
                                </div>
                            </div>
                            <!-- Tour Details Card (minimalist) -->
                            <div id="tourDetailsCard" class="card border mb-3 d-none">
                                <div class="card-body p-3" id="tourDetailsCardBody">
                                    <!-- Populated dynamically by JS -->
                                </div>
                            </div>
                            
                            <!-- Hora de inicio / Hora de fin (user input) -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="tourStartTime" class="form-label">Hora de inicio</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                        <input type="text" class="form-control time-input" id="tourStartTime" placeholder="__:__" maxlength="5">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label for="tourEndTime" class="form-label">Hora de fin</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                        <input type="text" class="form-control time-input" id="tourEndTime" placeholder="__:__" maxlength="5">
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Tour duration field -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label for="tourDuration" class="form-label">Duración del tour (horas)</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-clock-hour-3"></i></span>
                                        <input type="number" class="form-control" id="tourDuration" min="0.5" step="0.5" value="1">
                                        <span class="input-group-text">horas</span>
                                    </div>
                                    <small id="tourDurationWarning" class="text-warning d-none">
                                        <i class="ti ti-alert-triangle"></i> Duración menor al mínimo recomendado
                                    </small>
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <!-- Tour People Limits Alert -->
                            <div class="alert alert-info py-2 mb-3" id="tourPeopleLimitsAlert" style="display: none;">
                                <i class="ti ti-users me-2"></i>
                                <span id="tourPeopleLimitsText">Mínimo: 1 persona • Máximo: 10 personas</span>
                                <small class="float-end text-primary">
                                    Total actual: <strong id="tourCurrentTotalPeople">0</strong>
                                </small>
                            </div>
                            
                            
                            <div id="vehicleTourPricingSection">
                            <!-- Passenger Counts for Tour -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label for="tourAdultsQuantity" class="form-label">Número de adultos (12+)</label>
                                    <input type="number" class="form-control tour-quantity-input" id="tourAdultsQuantity" min="0" max="50" placeholder="0">
                                </div>
                                <div class="col-md-4">
                                    <label for="tourChildrenQuantity" class="form-label">Número de niños (3-12)</label>
                                    <input type="number" class="form-control tour-quantity-input" id="tourChildrenQuantity" min="0" max="50" placeholder="0">
                                </div>
                                <div class="col-md-4">
                                    <label for="tourInfantsQuantity" class="form-label">Número de infantes (0-2)</label>
                                    <input type="number" class="form-control tour-quantity-input" id="tourInfantsQuantity" min="0" max="50" placeholder="0">
                                </div>
                            </div>
                            </div>

                            <div id="walkingTourPricingSection" class="d-none">
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label for="walkingTourAdultsQuantity" class="form-label">Número de adultos (12+)</label>
                                        <input type="number" class="form-control walking-tour-quantity-input" id="walkingTourAdultsQuantity" min="0" max="50" placeholder="0">
                                    </div>
                                    <div class="col-md-4">
                                        <label for="walkingTourChildrenQuantity" class="form-label">Número de niños (3-12)</label>
                                        <input type="number" class="form-control walking-tour-quantity-input" id="walkingTourChildrenQuantity" min="0" max="50" placeholder="0">
                                    </div>
                                    <div class="col-md-4">
                                        <label for="walkingTourInfantsQuantity" class="form-label">Número de infantes (0-2)</label>
                                        <input type="number" class="form-control walking-tour-quantity-input" id="walkingTourInfantsQuantity" min="0" max="50" placeholder="0">
                                    </div>
                                </div>
                                <!-- Hidden field for total people count (used by tier pricing logic) -->
                                <input type="hidden" id="walkingTourPeopleCount" value="1">
                                <input type="hidden" id="walkingTourCurrency" value="MXN">
                                <label class="form-label mb-2">Precios por Grupo</label>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <div class="card walking-tier-card" id="walkingTierSmall">
                                            <div class="card-body text-center p-2">
                                                <small class="text-muted d-block" id="walkingRangeSmallLabel">—</small>
                                                <h5 class="mb-0" id="walkingPriceSmallLabel">$0.00</h5>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card walking-tier-card" id="walkingTierMedium">
                                            <div class="card-body text-center p-2">
                                                <small class="text-muted d-block" id="walkingRangeMediumLabel">—</small>
                                                <h5 class="mb-0" id="walkingPriceMediumLabel">$0.00</h5>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card walking-tier-card" id="walkingTierLarge">
                                            <div class="card-body text-center p-2">
                                                <small class="text-muted d-block" id="walkingRangeLargeLabel">—</small>
                                                <h5 class="mb-0" id="walkingPriceLargeLabel">$0.00</h5>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Group breakdown when people exceed max tier -->
                                <div id="walkingTourGroupBreakdown" class="alert alert-info py-2 mt-3 d-none">
                                    <div id="walkingTourGroupBreakdownContent"></div>
                                </div>
                                
                                <!-- Manual Price Field for Walking Tours (Hidden by default) -->
                                <div id="walkingTourManualPriceContainer" class="d-none">
                                    <!-- Toggle between total and per-group pricing -->
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <label class="form-label mb-0">Modo de edición de precios</label>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <input type="radio" class="btn-check" name="walkingPriceMode" id="walkingPriceModeTotal" value="total" checked>
                                            <label class="btn btn-outline-primary" for="walkingPriceModeTotal">
                                                <i class="ti ti-calculator"></i> Precio Total
                                            </label>
                                            <input type="radio" class="btn-check" name="walkingPriceMode" id="walkingPriceModeGroup" value="group">
                                            <label class="btn btn-outline-primary" for="walkingPriceModeGroup">
                                                <i class="ti ti-users"></i> Por Grupo
                                            </label>
                                        </div>
                                    </div>
                                    
                                    <!-- Total price input (default) -->
                                    <div id="walkingTourTotalPriceSection">
                                        <label for="walkingTourManualPrice" class="form-label">Precio Total <span class="text-danger">*</span></label>
                                        <div class="input-group mb-2">
                                            <span class="input-group-text">$</span>
                                            <input type="number" class="form-control" id="walkingTourManualPrice" placeholder="0.00" step="0.01" min="0" readonly>
                                            <span class="input-group-text currency-symbol">MXN</span>
                                        </div>
                                        <small class="text-muted">Precio manual para el tour a pie (reemplaza el cálculo por niveles)</small>
                                    </div>
                                    
                                    <!-- Per-group price inputs (hidden by default) -->
                                    <div id="walkingTourGroupPricesSection" class="d-none">
                                        <label class="form-label mb-2">Precios por Grupo</label>
                                        <div id="walkingTourGroupPricesContainer">
                                            <!-- Dynamic group price inputs will be inserted here -->
                                        </div>
                                        <div class="mt-2">
                                            <small class="text-muted">Total: </small>
                                            <strong id="walkingTourGroupPricesTotal">$0.00</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Tour Price Override Toggle (Admin Only) -->
                            <% if (canEditPrices) { %>
                            <div class="form-check mt-3 mb-3" id="tourOverridePricesContainer">
                                <input class="form-check-input" type="checkbox" id="tourOverridePrices">
                                <label class="form-check-label" for="tourOverridePrices">
                                    <i class="ti ti-edit me-1"></i>Editar precios manualmente
                                </label>
                                <small class="text-muted d-block ms-4">Permite modificar los precios calculados automáticamente</small>
                            </div>
                            <% } %>
                        </div>

                        <!-- Transport Fields -->
                        <div id="transportContent" class="service-content d-none">
                            <!-- One Way Form -->
                            <div id="oneWayForm" class="transport-trip-form">
                                <div class="border rounded p-3 bg-light">
                                    <!-- Arrival/Departure Selection (only for one-way) -->
                                    <div id="arrivalDepartureSelector" class="mb-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <label class="form-label mb-0">Tipo <span class="text-danger">*</span></label>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <input type="radio" class="btn-check" name="directionType" id="typeArrival" value="arrival" checked>
                                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeArrival">
                                                    <i class="ti ti-plane-arrival me-1" style="font-size: 1.1rem;"></i>
                                                    <span style="font-size: 0.9rem;">Arrival</span>
                                                </label>
                                                
                                                <input type="radio" class="btn-check" name="directionType" id="typeDeparture" value="departure">
                                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeDeparture">
                                                    <i class="ti ti-plane-departure me-1" style="font-size: 1.1rem;"></i>
                                                    <span style="font-size: 0.9rem;">Departure</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" id="transportOriginLabel">Origen <span class="text-danger">*</span></label>
                                        <!-- Arrival: Dropdown Origin (airports) -->
                                        <select class="form-select transport-origin-arrival" id="transportOriginSelect" required>
                                            <option value="">-- Seleccionar origen --</option>
                                        </select>
                                        <!-- Departure: Combo Origin (hotels, cities) -->
                                        <div class="position-relative d-none" id="transportOriginComboWrapper">
                                            <input type="text"
                                                   class="form-control"
                                                   id="transportOriginCombo"
                                                   list="transportOriginList"
                                                   placeholder="Seleccionar o escribir origen...">
                                            <datalist id="transportOriginList">
                                            </datalist>
                                            <small class="text-muted d-none" id="originOptionsIndicator">
                                                <i class="ti ti-arrow-down"></i> Opciones disponibles
                                            </small>
                                        </div>
                                        <!-- Other types: Text Origin -->
                                        <input type="text" class="form-control transport-origin-departure d-none" id="transportOriginText" placeholder="Ej: Hotel Xcaret, Airbnb Playa">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" id="transportDestinationLabel">Destino <span class="text-danger">*</span></label>
                                        <!-- Arrival/default: Combo Box destination -->
                                        <div class="position-relative" id="transportDestinationComboWrapper">
                                            <input type="text"
                                                   class="form-control"
                                                   id="transportDestinationCombo"
                                                   list="transportDestinationList"
                                                   placeholder="Seleccionar o escribir destino..."
                                                   required>
                                            <datalist id="transportDestinationList">
                                                <!-- Options will be populated dynamically from Services table -->
                                            </datalist>
                                            <!-- Indicator for available options -->
                                            <small class="text-muted d-none" id="destinationOptionsIndicator">
                                                <i class="ti ti-arrow-down"></i> Opciones disponibles
                                            </small>
                                        </div>
                                        <!-- Departure: Dropdown destination (airports) -->
                                        <select class="form-select d-none" id="transportDestinationSelect">
                                            <option value="">-- Seleccionar destino --</option>
                                        </select>
                                        <!-- Local Vuelta: Text destination -->
                                        <input type="text" class="form-control d-none" id="transportDestinationText" placeholder="Ej: Hotel Rosewood, Casa en Aldama 15...">
                                    </div>
                                </div>
                                
                                <!-- Specific Location field (shown only for certain destinations) -->
                                <div class="row d-none" id="specificLocationRow">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Dirección <span class="text-info">(Hotel, Airbnb, Particular, etc.)</span></label>
                                        <input type="text" 
                                               class="form-control" 
                                               id="transportSpecificLocation" 
                                               placeholder="Ej: Hotel Rosewood, Casa en Aldama 15, Centro Histórico..."
                                               aria-describedby="specificLocationHelp">
                                        <small id="specificLocationHelp" class="form-text text-muted">
                                            Especifique el hotel, dirección o lugar exacto en <span class="fw-bold selectedDestinationName"></span>
                                        </small>
                                    </div>
                                </div>
                                
                                <!-- Transport Schedule (shown for Punto a Punto and Local) -->
                                <div id="transportScheduleSection" class="d-none">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="transportStartTime" class="form-label">Horario Inicio</label>
                                            <input type="text" class="form-control time-input" id="transportStartTime" placeholder="__:__" maxlength="5">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="transportEndTime" class="form-label">Horario Fin</label>
                                            <input type="text" class="form-control time-input" id="transportEndTime" placeholder="__:__" maxlength="5">
                                        </div>
                                    </div>
                                </div>

                                <!-- Flight Details (only show if Aeropuerto is selected) -->
                                <div id="flightDetailsSection" class="d-none">
                                    <hr class="my-2">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="airline" class="form-label">Aerolínea</label>
                                            <input type="text" class="form-control" id="airline" placeholder="Ej: American Airlines">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="flightNumber" class="form-label">Número de Vuelo</label>
                                            <input type="text" class="form-control" id="flightNumber" placeholder="Ej: AA1234">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="flightTime" class="form-label">Hora Vuelo</label>
                                            <input type="text" class="form-control time-input" id="flightTime" placeholder="__:__" maxlength="5">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="flightDepartureTimeSuggested" class="form-label">Hora de salida sugerida</label>
                                            <input type="text" class="form-control time-input" id="flightDepartureTimeSuggested" placeholder="__:__" maxlength="5">
