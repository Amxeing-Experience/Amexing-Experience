                    </div>

                    <div class="form-check mb-3" id="includeInTotalContainer" style="display: none;">
                        <input class="form-check-input" type="checkbox" id="includeInTotal" checked>
                        <label class="form-check-label" for="includeInTotal">
                            Incluir en el total de la <%= e %>
                        </label>
                        <small class="form-text text-muted d-block">Desmarcar si el cliente paga este servicio por separado</small>
                    </div>

                    <!-- Asistentes (participantes / pasajeros) -->
                    <div class="mb-3" id="serviceAttendeesSection">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0" id="serviceAttendeesLabel">Asistentes</label>
                            <button type="button" class="btn btn-outline-primary" id="addAttendeeBtn">
                                <i class="ti ti-plus me-1"></i><span id="addAttendeeBtnText">Agregar asistente</span>
                            </button>
                        </div>
                        <small class="form-text text-muted d-block mb-2">Nombre completo de cada persona que toma este servicio</small>
                        <div id="serviceAttendeesList"></div>
                    </div>

                    <div class="mb-3" id="adminNotesWrap">
                        <label for="serviceNotes" class="form-label">Notas del administrador<% if (!canEditAdminNotes) { %> <span class="text-muted fw-normal">(solo lectura)</span><% } %></label>
                        <textarea class="form-control" id="serviceNotes" rows="2" placeholder="<%= canEditAdminNotes ? 'Notas del administrador para este servicio...' : 'Sin notas del administrador' %>" style="min-height: 60px; resize: none; overflow-y: hidden;" <% if (!canEditAdminNotes) { %>readonly<% } %>></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="serviceAgencyNotes" class="form-label">Notas del cliente</label>
                        <textarea class="form-control" id="serviceAgencyNotes" rows="2" placeholder="Notas del cliente para este servicio..." style="min-height: 60px; resize: none; overflow-y: hidden;"></textarea>
                    </div>

                    <!-- Preview -->
                    <div class="service-preview bg-light rounded p-3 d-none">
                        <h6 class="mb-2">Vista Previa</h6>
                        <div id="servicePreview">
                            <!-- Preview content will be generated here -->
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="saveServiceBtn">
                    <i class="ti ti-device-floppy me-1"></i>Guardar Servicio
