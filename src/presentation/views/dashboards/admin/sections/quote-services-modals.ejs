<%
/**
 * Quote Services Modals - Modal components for the itinerary builder
 * Created by Denisse Maldonado
 */
%>

<!-- Day Modal -->
<div class="modal fade" id="dayModal" tabindex="-1" aria-labelledby="dayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title" id="dayModalLabel">
                    <i class="ti ti-calendar-plus me-2"></i>Agregar Día
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Alert Container for Modal -->
                <div id="dayModalAlert" class="modal-alert-container"></div>
                
                <form id="dayForm">
                    <div class="mb-3">
                        <label for="dayTitle" class="form-label">Título del Día <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="dayTitle" placeholder="Ej: Llegada y City Tour" required>
                        <div class="form-text">Dale un nombre descriptivo a este día del itinerario</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="dayDate" class="form-label">Fecha</label>
                        <input type="date" class="form-control" id="dayDate">
                        <div class="form-text">Opcional: Asigna una fecha específica</div>
                    </div>

                    <div class="mb-3">
                        <label for="dayDescription" class="form-label">Descripción</label>
                        <textarea class="form-control" id="dayDescription" rows="3" placeholder="Descripción general del día..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="saveDayBtn">
                    <i class="ti ti-device-floppy me-1"></i>Guardar Día
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Service Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-labelledby="serviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title" id="serviceModalLabel">
                    <i class="ti ti-plus-circle me-2"></i>Agregar Servicio
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Alert Container for Modal -->
                <div id="serviceModalAlert" class="modal-alert-container"></div>
                
                <form id="serviceForm">
                    <!-- Service Type Selection -->
                    <div class="service-type-selector mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0">Servicio <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="serviceType" id="typeExperience" value="experience" checked>
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeExperience">
                                    <i class="ti ti-beach me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Experiencia</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="serviceType" id="typeTour" value="tour">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeTour">
                                    <i class="ti ti-map-2 me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Tour</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="serviceType" id="typeTransport" value="transport">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeTransport">
                                    <i class="ti ti-car me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Transporte</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="serviceType" id="typeADisposicion" value="a-disposicion">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeADisposicion">
                                    <i class="ti ti-clock-hour-4 me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">A Disposición</span>
                                </label>

                                <input type="radio" class="btn-check" name="serviceType" id="typeConcepto" value="concepto">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeConcepto">
                                    <i class="ti ti-file-text me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Concepto</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Transport Type Selection (only visible when transport is selected) -->
                    <div id="transportTypeSelector" class="mb-3 d-none">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0">Transporte <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="transportType" id="transportAeropuerto" value="aeropuerto" checked>
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="transportAeropuerto">
                                    <i class="ti ti-plane me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Aeropuerto</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="transportType" id="transportPuntoAPunto" value="punto-a-punto">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="transportPuntoAPunto">
                                    <i class="ti ti-route me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Punto a Punto</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="transportType" id="transportLocal" value="local">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="transportLocal">
                                    <i class="ti ti-map-pin me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Local</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Trip Type Selection (only visible when transport is selected) -->
                    <div id="tripTypeSelector" class="mb-3 d-none">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0">Viaje <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="tripType" id="tripOneWay" value="one-way" checked>
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="tripOneWay">
                                    <i class="ti ti-arrow-right me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">One Way</span>
                                </label>
                                
                                <input type="radio" class="btn-check" name="tripType" id="tripRoundTrip" value="round-trip">
                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="tripRoundTrip">
                                    <i class="ti ti-arrows-right-left me-1" style="font-size: 1.1rem;"></i>
                                    <span style="font-size: 0.9rem;">Round Trip</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Content Based on Service Type -->
                    <div id="serviceTypeContent">
                        <!-- Experience/Tour Selection -->
                        <div id="experienceContent" class="service-content">
                            <div class="mb-3">
                                <label for="experienceSelect" class="form-label">Seleccionar Experiencia <span class="text-danger">*</span></label>
                                <select class="form-select" id="experienceSelect" required>
                                    <option value="">-- Selecciona una experiencia --</option>
                                </select>
                                <div class="form-text">Las experiencias disponibles se cargan según el día seleccionado</div>
                            </div>
                            
                        </div>

                        <!-- Tour Selection -->
                        <div id="tourContent" class="service-content d-none">
                            <div class="mb-3">
                                <label for="tourSelect" class="form-label">Seleccionar Tour <span class="text-danger">*</span></label>
                                <select class="form-select" id="tourSelect" required>
                                    <option value="">-- Selecciona un tour --</option>
                                </select>
                                <div class="form-text">Los tours disponibles se cargan según el día seleccionado</div>
                            </div>
                            <!-- Tour Details Container -->
                            <div id="tourDetails" class="mt-2"></div>
                            
                            <!-- Tour Details Fields (Read-only) -->
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="tourDescription" class="form-label">Descripción</label>
                                    <textarea class="form-control bg-light" id="tourDescription" rows="2" readonly></textarea>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="tourAdvanceBookingTime" class="form-label">Tiempo de Reserva Anticipada</label>
                                    <input type="text" class="form-control bg-light" id="tourAdvanceBookingTime" readonly>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="tourLanguages" class="form-label">Idiomas</label>
                                    <input type="text" class="form-control bg-light" id="tourLanguages" readonly>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="tourIncludes" class="form-label">Incluye</label>
                                    <textarea class="form-control bg-light" id="tourIncludes" rows="2" readonly></textarea>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="tourNotIncludes" class="form-label">No Incluye</label>
                                    <textarea class="form-control bg-light" id="tourNotIncludes" rows="2" readonly></textarea>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="tourClientNotes" class="form-label">Notas para el Cliente</label>
                                <textarea class="form-control bg-light" id="tourClientNotes" rows="2" readonly></textarea>
                            </div>
                            
                            <!-- Tour Time Schedule -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold text-primary">Horarios Disponibles</label>
                                    <!-- Single time display (read-only) -->
                                    <input type="text" class="form-control bg-light" id="tourSingleTime" readonly style="display: none !important;">
                                    <!-- Multiple times selection -->
                                    <select class="form-select" id="tourMultipleTime" style="display: none;">
                                        <option value="">-- Selecciona un horario --</option>
                                    </select>
                                    <!-- Availability status message -->
                                    <div class="text-muted" id="tourAvailabilityStatus">
                                        <i class="ti ti-info-circle me-1"></i><span id="tourAvailabilityMessage">Horario según disponibilidad</span>
                                    </div>
                                </div>
                            </div>
                            
                            <hr class="my-4">
                            
                            <!-- Tour People Limits Alert -->
                            <div class="alert alert-info py-2 mb-3" id="tourPeopleLimitsAlert" style="display: none;">
                                <i class="ti ti-users me-2"></i>
                                <span id="tourPeopleLimitsText">Mínimo: 1 persona • Máximo: 10 personas</span>
                                <small class="float-end text-primary">
                                    Total actual: <strong id="tourCurrentTotalPeople">0</strong>
                                </small>
                            </div>
                            
                            <!-- People Quantities for Tour -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label for="tourAdultsQuantity" class="form-label">Adultos</label>
                                    <input type="number" class="form-control tour-quantity-input" id="tourAdultsQuantity" min="0" max="50" value="0">
                                </div>
                                <div class="col-md-4">
                                    <label for="tourChildrenQuantity" class="form-label">Niños</label>
                                    <input type="number" class="form-control tour-quantity-input" id="tourChildrenQuantity" min="0" max="50" value="0">
                                </div>
                                <div class="col-md-4">
                                    <label for="tourAdultsNoAlcoholQuantity" class="form-label">Adultos sin Alcohol</label>
                                    <input type="number" class="form-control tour-quantity-input" id="tourAdultsNoAlcoholQuantity" min="0" max="50" value="0">
                                </div>
                            </div>
                            
                            <!-- Tour Pricing -->
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="tourAdultPrice" class="form-label">Precio Adulto</label>
                                    <input type="number" class="form-control" id="tourAdultPrice" min="0" step="0.01" placeholder="0.00">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="tourChildPrice" class="form-label">Precio Niño</label>
                                    <input type="number" class="form-control" id="tourChildPrice" min="0" step="0.01" placeholder="0.00">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="tourNoAlcoholPrice" class="form-label">Precio sin Alcohol</label>
                                    <input type="number" class="form-control" id="tourNoAlcoholPrice" min="0" step="0.01" placeholder="0.00">
                                </div>
                            </div>
                        </div>

                        <!-- Transport Fields -->
                        <div id="transportContent" class="service-content d-none">
                            <!-- One Way Form -->
                            <div id="oneWayForm" class="transport-trip-form">
                                <div class="border rounded p-3 bg-light">
                                    <!-- Arrival/Departure Selection (only for one-way) -->
                                    <div id="arrivalDepartureSelector" class="mb-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <label class="form-label mb-0">Tipo <span class="text-danger">*</span></label>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <input type="radio" class="btn-check" name="directionType" id="typeArrival" value="arrival" checked>
                                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeArrival">
                                                    <i class="ti ti-plane-arrival me-1" style="font-size: 1.1rem;"></i>
                                                    <span style="font-size: 0.9rem;">Arrival</span>
                                                </label>
                                                
                                                <input type="radio" class="btn-check" name="directionType" id="typeDeparture" value="departure">
                                                <label class="btn btn-outline-primary d-flex align-items-center px-3" for="typeDeparture">
                                                    <i class="ti ti-plane-departure me-1" style="font-size: 1.1rem;"></i>
                                                    <span style="font-size: 0.9rem;">Departure</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" id="transportOriginLabel">Origen <span class="text-danger">*</span></label>
                                        <!-- Arrival: Dropdown Origin (airports) -->
                                        <select class="form-select transport-origin-arrival" id="transportOriginSelect" required>
                                            <option value="">-- Seleccionar origen --</option>
                                        </select>
                                        <!-- Departure: Combo Origin (hotels, cities) -->
                                        <div class="position-relative d-none" id="transportOriginComboWrapper">
                                            <input type="text"
                                                   class="form-control"
                                                   id="transportOriginCombo"
                                                   list="transportOriginList"
                                                   placeholder="Seleccionar o escribir origen...">
                                            <datalist id="transportOriginList">
                                            </datalist>
                                            <small class="text-muted d-none" id="originOptionsIndicator">
                                                <i class="ti ti-arrow-down"></i> Opciones disponibles
                                            </small>
                                        </div>
                                        <!-- Other types: Text Origin -->
                                        <input type="text" class="form-control transport-origin-departure d-none" id="transportOriginText" placeholder="Ej: Hotel Xcaret, Airbnb Playa">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" id="transportDestinationLabel">Destino <span class="text-danger">*</span></label>
                                        <!-- Arrival/default: Combo Box destination -->
                                        <div class="position-relative" id="transportDestinationComboWrapper">
                                            <input type="text"
                                                   class="form-control"
                                                   id="transportDestinationCombo"
                                                   list="transportDestinationList"
                                                   placeholder="Seleccionar o escribir destino..."
                                                   required>
                                            <datalist id="transportDestinationList">
                                                <!-- Options will be populated dynamically from Services table -->
                                            </datalist>
                                            <!-- Indicator for available options -->
                                            <small class="text-muted d-none" id="destinationOptionsIndicator">
                                                <i class="ti ti-arrow-down"></i> Opciones disponibles
                                            </small>
                                        </div>
                                        <!-- Departure: Dropdown destination (airports) -->
                                        <select class="form-select d-none" id="transportDestinationSelect">
                                            <option value="">-- Seleccionar destino --</option>
                                        </select>
                                        <!-- Local Vuelta: Text destination -->
                                        <input type="text" class="form-control d-none" id="transportDestinationText" placeholder="Ej: Hotel Rosewood, Casa en Aldama 15...">
                                    </div>
                                </div>
                                
                                <!-- Specific Location field (shown only for certain destinations) -->
                                <div class="row d-none" id="specificLocationRow">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Ubicación Específica <span class="text-info">(Hotel, Dirección, etc.)</span></label>
                                        <input type="text" 
                                               class="form-control" 
                                               id="transportSpecificLocation" 
                                               placeholder="Ej: Hotel Rosewood, Casa en Aldama 15, Centro Histórico..."
                                               aria-describedby="specificLocationHelp">
                                        <small id="specificLocationHelp" class="form-text text-muted">
                                            Especifique el hotel, dirección o lugar exacto dentro de <span id="selectedDestinationName"></span>
                                        </small>
                                    </div>
                                </div>
                                
                                <!-- Transport Schedule (shown for Punto a Punto and Local) -->
                                <div id="transportScheduleSection" class="d-none">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="transportStartTime" class="form-label">Horario Inicio</label>
                                            <input type="text" class="form-control time-input" id="transportStartTime" placeholder="__:__" maxlength="5">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="transportEndTime" class="form-label">Horario Fin</label>
                                            <input type="text" class="form-control time-input" id="transportEndTime" placeholder="__:__" maxlength="5">
                                        </div>
                                    </div>
                                </div>

                                <!-- Flight Details (only show if Aeropuerto is selected) -->
                                <div id="flightDetailsSection" class="d-none">
                                    <hr class="my-2">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="airline" class="form-label">Aerolínea</label>
                                            <input type="text" class="form-control" id="airline" placeholder="Ej: American Airlines">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="flightNumber" class="form-label">Número de Vuelo</label>
                                            <input type="text" class="form-control" id="flightNumber" placeholder="Ej: AA1234">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="flightTime" class="form-label">Hora de Llegada</label>
                                            <input type="text" class="form-control time-input" id="flightTime" placeholder="__:__" maxlength="5">
                                        </div>
                                        <!-- Removed Número de Personas field as requested
                                        <div class="col-md-6 mb-3">
                                            <label for="transportPersons" class="form-label">Número de Personas <span class="text-danger">*</span></label>
                                            <input type="number" class="form-control" id="transportPersons" min="1" max="50" value="1" required>
                                        </div>
                                        -->
                                    </div>
                                </div>
                                </div>
                            </div>
                            
                            <!-- Round Trip Form -->
                            <div id="roundTripForm" class="transport-trip-form d-none">
                                <!-- Arrival -->
                                <div class="border rounded p-3 mb-3 bg-light">
                                    <h6 class="mb-3 text-info">
                                        <i class="ti ti-plane-arrival me-2"></i>Arrival
                                    </h6>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Origen <span class="text-danger">*</span></label>
                                            <!-- Arrival: Dropdown Origin -->
                                            <select class="form-select" id="roundTripOriginIdaSelect" required>
                                                <option value="">-- Seleccionar origen --</option>
                                                <option value="cancun">Cancún</option>
                                                <option value="cozumel">Cozumel</option>
                                                <option value="playa">Playa del Carmen</option>
                                                <option value="tulum">Tulum</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Destino <span class="text-danger">*</span></label>
                                            <!-- Arrival: Text Destination -->
                                            <input type="text" class="form-control" id="roundTripDestinationIda" placeholder="Ej: Hotel Xcaret, Airbnb Playa" required>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="roundTripDateIda" class="form-label">Fecha de Llegada</label>
                                            <input type="date" class="form-control" id="roundTripDateIda">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="roundTripTimeIda" class="form-label">Hora de Llegada</label>
                                            <input type="time" class="form-control" id="roundTripTimeIda">
                                        </div>
                                    </div>
                                    
                                    <!-- Flight Details for Ida (only show if Aeropuerto is selected) -->
                                    <div class="roundtrip-flight-details-ida d-none">
                                        <hr class="my-2">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="roundTripAirlineIda" class="form-label">Aerolínea</label>
                                                <input type="text" class="form-control" id="roundTripAirlineIda" placeholder="Ej: American Airlines">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="roundTripFlightNumberIda" class="form-label">Número de Vuelo</label>
                                                <input type="text" class="form-control" id="roundTripFlightNumberIda" placeholder="Ej: AA1234">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Departure -->
                                <div class="border rounded p-3 bg-light">
                                    <h6 class="mb-3 text-primary">
                                        <i class="ti ti-plane-departure me-2"></i>Departure
                                    </h6>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Origen <span class="text-danger">*</span></label>
                                            <!-- Departure: Text Origin -->
                                            <input type="text" class="form-control" id="roundTripOriginVuelta" placeholder="Ej: Hotel Xcaret, Airbnb Playa" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Destino <span class="text-danger">*</span></label>
                                            <!-- Combo Box: Input with datalist for autocomplete -->
                                            <input type="text" 
                                                   class="form-control" 
                                                   id="roundTripDestinationCombo" 
                                                   list="roundTripDestinationList"
                                                   placeholder="Seleccionar o escribir destino..." 
                                                   required>
                                            <datalist id="roundTripDestinationList">
                                                <!-- Options will be populated dynamically from Services table -->
                                            </datalist>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="roundTripDateVuelta" class="form-label">Fecha de Salida</label>
                                            <input type="date" class="form-control" id="roundTripDateVuelta">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="roundTripTimeVuelta" class="form-label">Hora de Salida</label>
                                            <input type="time" class="form-control" id="roundTripTimeVuelta">
                                        </div>
                                    </div>
                                    
                                    <!-- Flight Details for Vuelta (only show if Aeropuerto is selected) -->
                                    <div class="roundtrip-flight-details-vuelta d-none">
                                        <hr class="my-2">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="roundTripAirlineVuelta" class="form-label">Aerolínea</label>
                                                <input type="text" class="form-control" id="roundTripAirlineVuelta" placeholder="Ej: American Airlines">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="roundTripFlightNumberVuelta" class="form-label">Número de Vuelo</label>
                                                <input type="text" class="form-control" id="roundTripFlightNumberVuelta" placeholder="Ej: AA5678">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Number of Persons - Removed as requested
                                <div class="row mt-3">
                                    <div class="col-md-6 mb-3">
                                        <label for="roundTripPersons" class="form-label">Número de Personas <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control" id="roundTripPersons" min="1" max="50" value="1" required>
                                    </div>
                                </div>
                                -->
                            </div>
                        </div>

                        <!-- A Disposición Fields -->
                        <div id="aDisposicionContent" class="service-content d-none">
                            <div class="mb-3">
                                <label for="aDisposicionConcept" class="form-label">Concepto <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="aDisposicionConcept" placeholder="Ej: Servicio a disposición 8 horas...">
                            </div>

                            <!-- Schedule -->
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="aDisposicionStartTime" class="form-label">Hora de inicio</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                        <input type="text" class="form-control time-input" id="aDisposicionStartTime" placeholder="__:__" maxlength="5" data-placeholder="09:00">
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="aDisposicionEndTime" class="form-label">Hora de fin</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                        <input type="text" class="form-control time-input" id="aDisposicionEndTime" placeholder="__:__" maxlength="5" data-placeholder="17:00">
                                    </div>
                                </div>
                            </div>

                            <!-- People counts -->
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="aDisposicionAdults" class="form-label">Adultos</label>
                                    <input type="number" class="form-control" id="aDisposicionAdults" min="0" max="50" value="1">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="aDisposicionChildren" class="form-label">Niños</label>
                                    <input type="number" class="form-control" id="aDisposicionChildren" min="0" max="50" value="0">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="aDisposicionInfants" class="form-label">Infantes</label>
                                    <input type="number" class="form-control" id="aDisposicionInfants" min="0" max="50" value="0">
                                </div>
                            </div>
                        </div>

                        <!-- Concepto Fields -->
                        <div id="conceptoContent" class="service-content d-none">
                            <div class="mb-3">
                                <label for="conceptoConcept" class="form-label">Concepto <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="conceptoConcept" placeholder="Describe el servicio...">
                            </div>
                            
                            <!-- Schedule Toggle -->
                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="conceptoHasSchedule">
                                    <label class="form-check-label" for="conceptoHasSchedule">
                                        <i class="ti ti-clock me-1"></i>Incluir horario
                                    </label>
                                </div>
                            </div>
                            
                            <!-- Schedule Fields (hidden by default) -->
                            <div id="conceptoScheduleFields" class="d-none">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="conceptoStartTime" class="form-label">Hora de inicio</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                            <input type="text" class="form-control time-input" id="conceptoStartTime" placeholder="__:__" maxlength="5" data-placeholder="09:00">
                                        </div>
                                        <small class="form-text text-muted">Ej: 09:00, 14:30</small>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="conceptoEndTime" class="form-label">Hora de fin</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                            <input type="text" class="form-control time-input" id="conceptoEndTime" placeholder="__:__" maxlength="5" data-placeholder="17:00">
                                        </div>
                                        <small class="form-text text-muted">Ej: 17:00, 20:30</small>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- People Quantities for Concepto -->
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="conceptoAdultsQuantity" class="form-label">Adultos</label>
                                    <input type="number" class="form-control concepto-quantity-input" id="conceptoAdultsQuantity" min="0" max="50" value="1">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="conceptoChildrenQuantity" class="form-label">Niños</label>
                                    <input type="number" class="form-control concepto-quantity-input" id="conceptoChildrenQuantity" min="0" max="50" value="0">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="conceptoAdultsNoAlcoholQuantity" class="form-label">Adultos sin Alcohol</label>
                                    <input type="number" class="form-control concepto-quantity-input" id="conceptoAdultsNoAlcoholQuantity" min="0" max="50" value="0">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Common Fields -->
                    <hr class="my-4">
                    
                    <!-- Tour Transport Checkbox - Only visible for Tours -->
                    <div class="mb-3" id="tourTransportCheckboxContainer" style="display: none;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="tourRequiresTransport">
                            <label class="form-check-label" for="tourRequiresTransport">
                                <i class="ti ti-car me-1"></i>Se requiere traslado
                            </label>
                        </div>
                    </div>
                    
                    <!-- Number of People Fields for Transport -->
                    <div class="row mb-3" id="transportPeopleFieldsRow">
                        <div class="col-md-4">
                            <label for="transportAdults" class="form-label">Número de adultos (12+)</label>
                            <input type="number" class="form-control" id="transportAdults" min="0" max="100" value="0">
                        </div>
                        <div class="col-md-4">
                            <label for="transportChildren" class="form-label">Número de niños (3-12)</label>
                            <input type="number" class="form-control" id="transportChildren" min="0" max="100" value="0">
                        </div>
                        <div class="col-md-4">
                            <label for="transportInfants" class="form-label">Número de infantes (0-2)</label>
                            <input type="number" class="form-control" id="transportInfants" min="0" max="100" value="0">
                        </div>
                    </div>
                    
                    <div class="row" id="transportFieldsRow">
                        <div class="col-md-6 mb-3">
                            <label for="transportCategory" class="form-label">Segmento <span class="text-danger">*</span></label>
                            <select class="form-select" id="transportCategory" required>
                                <option value="">-- Seleccionar segmento --</option>
                                <!-- Options will be loaded dynamically from Rate table -->
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="vehicleSelect" class="form-label">Vehículo <span id="vehicleLoadingSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status" style="width: 14px; height: 14px; border-width: 2px;"></span></label>
                            <select class="form-select" id="vehicleSelect">
                                <option value="">-- Sin vehículo --</option>
                            </select>
                            <small id="vehicleCapacityNote" class="text-info d-none"><i class="ti ti-info-circle me-1"></i><span id="vehicleCapacityNoteText"></span></small>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label d-block">Opcional</label>
                            <div class="d-flex flex-column align-items-start" style="min-height: 38px;">
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" value="" id="includeGuide">
                                    <label class="form-check-label small" for="includeGuide" id="guideLabel" style="font-size: 0.875rem; line-height: 1.2;">
                                        Guía + Chofer
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="includeGreeter">
                                    <label class="form-check-label small" for="includeGreeter" id="greeterLabel" style="font-size: 0.875rem; line-height: 1.2;">
                                        Greeter
                                    </label>
                                </div>
                                <div class="form-check ms-3 d-none" id="greeterInVehicleContainer">
                                    <input class="form-check-input" type="checkbox" value="" id="greeterInVehicle">
                                    <label class="form-check-label small text-muted" for="greeterInVehicle" style="font-size: 0.75rem; line-height: 1.2;">
                                        Viaja en el vehículo
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Standard pricing for non-experience services -->
                    <div class="row" id="standardPricingSection">
                        <div class="col-md-6 mb-3">
                            <label for="servicePrice" class="form-label">Precio <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="servicePrice" placeholder="0.00" step="0.01" min="0" required>
                                <span class="input-group-text">MXN</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="serviceQuantity" class="form-label">Cantidad</label>
                            <input type="number" class="form-control" id="serviceQuantity" value="1" min="1" required>
                        </div>
                    </div>
                    <!-- Experience pricing with adult/child/no-alcohol options -->
                    <div id="experiencePricingSection" class="d-none">
                        <!-- Experience Information (Read-only) -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-primary">Descripción</label>
                                <textarea class="form-control bg-light" id="experienceDescription" rows="3" readonly></textarea>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-primary">Tiempo de reserva anticipada</label>
                                <input type="text" class="form-control bg-light" id="advanceBookingTime" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-primary">Idiomas</label>
                                <input type="text" class="form-control bg-light" id="experienceLanguages" readonly>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-primary">Incluye</label>
                                <textarea class="form-control bg-light" id="experienceIncludes" rows="4" readonly></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-primary">No incluye</label>
                                <textarea class="form-control bg-light" id="experienceNotIncludes" rows="4" readonly></textarea>
                            </div>
                        </div>
                        
                        <!-- Client Notes Field -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-primary">Notas para Cliente</label>
                                <textarea class="form-control bg-light" id="experienceClientNotes" rows="3" readonly></textarea>
                            </div>
                        </div>
                        
                        <!-- Experience Time Schedule -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-primary">Horarios Disponibles</label>
                                <!-- Single time display (read-only) -->
                                <input type="text" class="form-control bg-light" id="experienceSingleTime" readonly style="display: none;">
                                <!-- Multiple times selection -->
                                <select class="form-select" id="experienceMultipleTime" style="display: none;">
                                    <option value="">-- Selecciona un horario --</option>
                                </select>
                                <!-- Availability status message -->
                                <div class="text-muted" id="experienceAvailabilityStatus" style="display: none;">
                                    <i class="ti ti-info-circle me-1"></i><span id="experienceAvailabilityMessage">Horario según disponibilidad</span>
                                </div>
                            </div>
                        </div>
                        
                        <hr class="my-4">
                        
                        <!-- People limits display -->
                        <div class="alert alert-info py-2 mb-3" id="peopleLimitsAlert" style="display: none;">
                            <i class="ti ti-users me-2"></i>
                            <span id="peopleLimitsText">Mínimo: 1 persona • Máximo: 10 personas</span>
                            <small class="float-end text-primary">
                                Total actual: <strong id="currentTotalPeople">0</strong>
                            </small>
                        </div>
                        
                        <!-- Quantity fields for adults, children, adults without alcohol -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="adultsQuantity" class="form-label">Adultos</label>
                                <input type="number" class="form-control experience-quantity-input" id="adultsQuantity" value="0" min="0" max="50">
                            </div>
                            <div class="col-md-4">
                                <label for="childrenQuantity" class="form-label">Niños</label>
                                <input type="number" class="form-control experience-quantity-input" id="childrenQuantity" value="0" min="0" max="50">
                            </div>
                            <div class="col-md-4">
                                <label for="adultsNoAlcoholQuantity" class="form-label">Adultos sin alcohol</label>
                                <input type="number" class="form-control experience-quantity-input" id="adultsNoAlcoholQuantity" value="0" min="0" max="50">
                            </div>
                        </div>
                        
                        <!-- Price fields for each type -->
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="adultPrice" class="form-label">Precio Adulto <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="adultPrice" placeholder="0.00" step="0.01" min="0">
                                    <span class="input-group-text currency-symbol">MXN</span>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="childPrice" class="form-label">Precio Niño</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="childPrice" placeholder="0.00" step="0.01" min="0">
                                    <span class="input-group-text currency-symbol">MXN</span>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="noAlcoholPrice" class="form-label">Precio sin alcohol</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="noAlcoholPrice" placeholder="0.00" step="0.01" min="0">
                                    <span class="input-group-text currency-symbol">MXN</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    

                    <div id="servicePriceBreakdown" class="d-none mb-3 p-2 bg-light rounded small">
                        <div class="fw-semibold mb-1 text-muted"><i class="ti ti-list-details me-1"></i>Desglose</div>
                        <div id="breakdownItems"></div>
                        <hr class="my-1">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Total servicio</span>
                            <span id="breakdownTotal"></span>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="includeInTotal" checked>
                        <label class="form-check-label" for="includeInTotal">
                            Incluir en el total de la cotización
                        </label>
                        <small class="form-text text-muted d-block">Desmarcar si el cliente paga este servicio por separado</small>
                    </div>

                    <div class="mb-3">
                        <label for="serviceNotes" class="form-label">Notas Adicionales</label>
                        <textarea class="form-control" id="serviceNotes" rows="2" placeholder="Información adicional del servicio..."></textarea>
                    </div>

                    <!-- Preview -->
                    <div class="service-preview bg-light rounded p-3 d-none">
                        <h6 class="mb-2">Vista Previa</h6>
                        <div id="servicePreview">
                            <!-- Preview content will be generated here -->
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="saveServiceBtn">
                    <i class="ti ti-device-floppy me-1"></i>Guardar Servicio
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom bg-danger text-white">
                <h5 class="modal-title">
                    <i class="ti ti-alert-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="deleteConfirmMessage">¿Estás seguro de que deseas eliminar este elemento?</p>
                <p class="text-muted">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="ti ti-trash me-1"></i>Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title">
                    <i class="ti ti-eye me-2"></i>Vista Previa del Itinerario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="previewContent">
                <!-- Preview content will be generated here -->
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="exportPdfBtn">
                    <i class="ti ti-file-download me-1"></i>Exportar PDF
                </button>
            </div>
        </div>
    </div>
</div>