                    <!-- Tour Transport Checkbox - Only visible for Tours -->
                    <div class="mb-3" id="tourTransportCheckboxContainer" style="display: none;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="tourRequiresTransport">
                            <label class="form-check-label" for="tourRequiresTransport">
                                <i class="ti ti-car me-1"></i>Se requiere traslado
                            </label>
                        </div>
                    </div>
                    
                    <!-- Number of People Fields for Transport -->
                    <div class="row mb-3" id="transportPeopleFieldsRow">
                        <div class="col-md-4">
                            <label for="transportAdults" class="form-label">Número de adultos (12+)</label>
                            <input type="number" class="form-control" id="transportAdults" min="0" max="100" placeholder="0">
                        </div>
                        <div class="col-md-4">
                            <label for="transportChildren" class="form-label">Número de niños (3-12)</label>
                            <input type="number" class="form-control" id="transportChildren" min="0" max="100" placeholder="0">
                        </div>
                        <div class="col-md-4">
                            <label for="transportInfants" class="form-label">Número de infantes (0-2)</label>
                            <input type="number" class="form-control" id="transportInfants" min="0" max="100" placeholder="0">
                        </div>
                    </div>
                    
                    <!-- Duración estimada de viaje (horas/minutos): común a one-way y round-trip. Se
                         autollena de la ruta y es editable. La usan guía/greeter y la hora de salida
                         sugerida. Si la ruta no la trae, captúrala aquí. -->
                    <div class="row" id="routeDurationRow">
                        <div class="col-md-5 mb-3">
                            <label class="form-label">Duración estimada de viaje <small class="text-muted">(horas y minutos)</small></label>
                            <div class="input-group">
                                <input type="number" min="0" step="1" class="form-control" id="routeDurationHours" placeholder="0" autocomplete="off" aria-label="Horas">
                                <span class="input-group-text">h</span>
                                <input type="number" min="0" max="59" step="5" class="form-control" id="routeDurationMinutes" placeholder="0" autocomplete="off" aria-label="Minutos">
                                <span class="input-group-text">min</span>
                            </div>
                            <small class="text-muted d-block">Se autollena de la ruta; usada para guía/greeter y hora de salida sugerida.</small>
                            <small class="text-info d-block d-none" id="routeDurationRoundTripHint"></small>
                        </div>
                    </div>

                    <div class="row" id="transportFieldsRow">
                        <div class="col-md-4 mb-3 transport-main-field">
                            <label for="transportCategory" class="form-label">Segmento <span class="text-danger">*</span></label>
                            <select class="form-select" id="transportCategory" required>
                                <option value="">-- Seleccionar segmento --</option>
                                <!-- Options will be loaded dynamically from Rate table -->
                            </select>
                        </div>
                        <div class="col-md-4 mb-3 transport-main-field">
                            <label for="vehicleSelect" class="form-label">Vehículo <span id="vehicleLoadingSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status" style="width: 14px; height: 14px; border-width: 2px;"></span></label>
                            <select class="form-select" id="vehicleSelect">
                                <option value="">-- Sin vehículo --</option>
                            </select>
                            <small id="vehicleCapacityNote" class="text-info d-none"><i class="ti ti-info-circle me-1"></i><span id="vehicleCapacityNoteText"></span></small>
                        </div>
                    </div>

                    <!-- Opcionales (transporte / tour): guía + greeter -->
                    <div class="row" id="transportOptionsRow">
                        <div class="col-12 mb-3">
                            <label class="form-label d-block mb-1">Opcionales</label>
                            <div class="d-flex flex-wrap align-items-center gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="includeGuide">
                                    <label class="form-check-label small" for="includeGuide" id="guideLabel">Guía + Chofer</label>
                                </div>
                                <div class="form-check" id="greeterCheckboxContainer">
                                    <input class="form-check-input" type="checkbox" value="" id="includeGreeter">
                                    <label class="form-check-label small" for="includeGreeter" id="greeterLabel">Greeter</label>
                                </div>
                                <div class="form-check ms-2 d-none" id="greeterInVehicleContainer">
                                    <input class="form-check-input" type="checkbox" value="" id="greeterInVehicle">
                                    <label class="form-check-label small text-muted" for="greeterInVehicle">Viaja en el vehículo</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Standard pricing for non-experience services -->
                    <div class="row" id="standardPricingSection">
                        <div class="col-md-6 mb-3" id="servicePriceCol">
                            <label for="servicePrice" class="form-label">Precio <small class="text-muted">(efectivo)</small> <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="servicePrice" placeholder="0.00" step="0.01" min="0" required>
                                <span class="input-group-text">MXN</span>
                            </div>
                            <small class="text-muted d-block" id="servicePriceListPrice"></small>

                            <!-- Tour Vehicle Price Override Toggle (Admin Only) -->
                            <% if (canEditPrices) { %>
                            <div class="form-check mt-2 d-none" id="tourVehicleOverridePricesContainer">
                                <input class="form-check-input" type="checkbox" id="tourVehicleOverridePrices">
                                <label class="form-check-label" for="tourVehicleOverridePrices">
                                    <i class="ti ti-edit me-1"></i>Editar precio manualmente
                                </label>
                                <small class="text-muted d-block ms-4">Permite modificar el precio calculado del vehículo</small>
                            </div>
                            <% } %>
                            
                            <!-- Transport Price Override Toggle (Admin Only) -->
                            <% if (canEditPrices) { %>
                            <div class="form-check mt-2 d-none" id="transportOverridePricesContainer">
                                <input class="form-check-input" type="checkbox" id="transportOverridePrices">
                                <label class="form-check-label" for="transportOverridePrices">
                                    <i class="ti ti-edit me-1"></i>Editar precio manualmente
                                </label>
                                <small class="text-muted d-block ms-4">Permite modificar el precio calculado automáticamente</small>
                            </div>
                            <% } %>
                            
                            <!-- A Disposición Price Override Toggle (Admin Only) -->
                            <% if (canEditPrices) { %>
                            <div class="form-check mt-2 d-none" id="aDisposicionOverridePricesContainer">
                                <input class="form-check-input" type="checkbox" id="aDisposicionOverridePrices">
                                <label class="form-check-label" for="aDisposicionOverridePrices">
                                    <i class="ti ti-edit me-1"></i>Editar precio manualmente
                                </label>
                                <small class="text-muted d-block ms-4">Permite modificar el precio calculado automáticamente</small>
                            </div>
                            <% } %>
                        </div>
                        <!-- Tiempo de espera del vehículo principal — junto al precio base (solo transporte). -->
                        <div class="col-md-4 mb-3 d-none" id="tiempoEsperaSection">
                            <label class="form-label"><i class="ti ti-clock me-1"></i>Tiempo de espera</label>
                            <div class="d-flex gap-1">
                                <div class="input-group input-group-sm" style="max-width: 92px;">
                                    <input type="number" class="form-control" id="waitingTimeHours" min="0" step="0.5" value="0" placeholder="0">
                                    <span class="input-group-text">h</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="waitingTimePrice" min="0" step="0.01" placeholder="0.00" title="Tarifa por hora (editable)">
                                    <span class="input-group-text">/h</span>
                                </div>
                            </div>
                            <small class="text-muted d-block" id="waitingTimeRate"></small>
                        </div>
                        <div class="col-md-6 mb-3" id="serviceQuantityCol">
                            <label for="serviceQuantity" class="form-label">Cantidad</label>
                            <input type="number" class="form-control" id="serviceQuantity" value="1" min="1" required>
                            <small class="text-muted d-none" id="roundTripQuantityHint">Vehículo Ida y Regreso</small>
                        </div>
                        <!-- Vehículos adicionales (lista). Reemplaza al antiguo "vehículo adicional"
                             único. Se muestra para transporte / tour con vehículo; el botón se
                             habilita solo cuando hay un vehículo principal seleccionado. -->
                        <div class="col-12 d-none mt-2" id="extraAdditionalVehiclesContainer">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0"><i class="ti ti-car me-1"></i>Vehículos adicionales</label>
                                <button type="button" class="btn btn-outline-primary" id="addExtraAdditionalVehicleBtn" disabled>
                                    <i class="ti ti-plus me-1"></i>Agregar vehículo
                                </button>
                            </div>
                            <small class="text-muted d-block mb-2" id="extraVehiclesMainHint">
                                <i class="ti ti-info-circle me-1"></i>Selecciona primero el vehículo principal para agregar adicionales.
                            </small>
                            <!-- Headers tipo tabla (una sola fila); se muestra solo cuando hay vehículos. -->
                            <div class="row g-2 mb-1 d-none" id="extraAdditionalVehiclesHeader">
                                <div class="col-md-3"><small class="text-muted fw-semibold">Segmento</small></div>
                                <div class="col-md-3"><small class="text-muted fw-semibold">Vehículo</small></div>
                                <div class="col-md-2"><small class="text-muted fw-semibold">Precio (efectivo)</small></div>
                                <div class="col-md-3"><small class="text-muted fw-semibold">Tiempo de espera</small></div>
                                <div class="col-md-1"></div>
                            </div>
                            <div id="extraAdditionalVehiclesList"></div>
                        </div>
                    </div>
                    <!-- Experience pricing with adult/child/no-alcohol options -->
                    <div id="experiencePricingSection" class="d-none">
                        <!-- Experience Details Card (minimalist) -->
                        <div id="experienceDetailsCard" class="card border mb-3 d-none">
                            <div class="card-body p-3" id="experienceDetailsCardBody">
                                <!-- Populated dynamically by JS -->
                            </div>
                        </div>
                        
                        <!-- Hora de inicio / Hora de fin (user input) -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="experienceStartTime" class="form-label">Hora de inicio</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                    <input type="text" class="form-control time-input" id="experienceStartTime" list="quoteTimeOptions" placeholder="__:__" maxlength="5" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="experienceEndTime" class="form-label">Hora de fin</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                    <input type="text" class="form-control time-input" id="experienceEndTime" list="quoteTimeOptions" placeholder="__:__" maxlength="5" autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <!-- Duración (horas): se autollena de la experiencia seleccionada y es editable. Full width, debajo del horario. -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label for="experienceDuration" class="form-label">Duración <small class="text-muted">(horas)</small></label>
                                <input type="number" min="0" step="0.5" class="form-control" id="experienceDuration" placeholder="Ej: 2" autocomplete="off">
                                <small class="text-muted d-block">Se autollena de la experiencia; puedes modificarla.</small>
                            </div>
                        </div>
                        
                        <hr class="my-4">
                        
                        <!-- People limits display -->
                        <div class="alert alert-info py-2 mb-3" id="peopleLimitsAlert" style="display: none;">
                            <i class="ti ti-users me-2"></i>
                            <span id="peopleLimitsText">Mínimo: 1 persona • Máximo: 10 personas</span>
                            <small class="float-end text-primary">
                                Total actual: <strong id="currentTotalPeople">0</strong>
                            </small>
                        </div>
                        
                        <!-- Quantity fields for adults, children, adults without alcohol -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="adultsQuantity" class="form-label">Adultos</label>
                                <input type="number" class="form-control experience-quantity-input" id="adultsQuantity" placeholder="0" min="0" max="50">
                            </div>
                            <div class="col-md-4">
                                <label for="childrenQuantity" class="form-label">Niños</label>
                                <input type="number" class="form-control experience-quantity-input" id="childrenQuantity" placeholder="0" min="0" max="50">
                            </div>
                            <div class="col-md-4">
                                <label for="adultsNoAlcoholQuantity" class="form-label">Adultos sin alcohol</label>
                                <input type="number" class="form-control experience-quantity-input" id="adultsNoAlcoholQuantity" placeholder="0" min="0" max="50">
                            </div>
                        </div>
                        
                        <!-- Price fields for each type -->
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="adultPrice" class="form-label">Precio Adulto <small class="text-muted">(efectivo)</small> <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="adultPrice" placeholder="0.00" step="0.01" min="0">
                                    <span class="input-group-text currency-symbol">MXN</span>
                                </div>
                                <small class="text-muted d-block" id="adultPriceListPrice"></small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="childPrice" class="form-label">Precio Niño <small class="text-muted">(efectivo)</small></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="childPrice" placeholder="0.00" step="0.01" min="0">
                                    <span class="input-group-text currency-symbol">MXN</span>
                                </div>
                                <small class="text-muted d-block" id="childPriceListPrice"></small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="noAlcoholPrice" class="form-label">Precio sin alcohol <small class="text-muted">(efectivo)</small></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="noAlcoholPrice" placeholder="0.00" step="0.01" min="0">
                                    <span class="input-group-text currency-symbol">MXN</span>
                                </div>
                                <small class="text-muted d-block" id="noAlcoholPriceListPrice"></small>
                            </div>
                        </div>
                        
                        <!-- Price Override Toggle (Admin Only) — OCULTO: los precios de experiencia
                             ahora son siempre editables (sin checkbox), consistente con los demás
                             tipos. Se mantiene el elemento (d-none) porque el JS aún fuerza
                             #experienceOverridePrices activo. -->
                        <% if (canEditPrices) { %>
                        <div class="form-check mb-3 d-none">
                            <input class="form-check-input" type="checkbox" id="experienceOverridePrices">
                            <label class="form-check-label" for="experienceOverridePrices">
                                <i class="ti ti-edit me-1"></i>Editar precios manualmente
                            </label>
                            <small class="text-muted d-block ms-4">Permite modificar los precios calculados automáticamente</small>
                        </div>
                        <% } %>
                    </div>
                    

                    <div id="servicePriceBreakdown" class="d-none mb-3 p-2 bg-light rounded small">
                        <div id="desgloseTitle" class="fw-semibold mb-1 text-muted"><i class="ti ti-list-details me-1"></i>Desglose</div>
                        <div id="breakdownItems"></div>
                        <hr class="my-1">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Total servicio</span>
                            <span id="breakdownTotal"></span>
                        </div>
                    </div>

                    <!-- Development Mode: Payment Type Breakdown Display -->
                    <div id="devPaymentBreakdown" class="d-none mb-3">
                        <div class="fw-semibold mb-2 text-muted">
                            <i class="ti ti-calculator me-1"></i>Desglose por Tipo de Pago (Dev)
                        </div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label text-muted small">💰 Desglose Efectivo</label>
                                <textarea class="form-control form-control-sm" id="devBreakdownEfectivo" rows="3" readonly style="font-size: 0.75rem; font-family: monospace;"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small">🏦 Desglose Transferencia</label>
                                <textarea class="form-control form-control-sm" id="devBreakdownTransferencia" rows="3" readonly style="font-size: 0.75rem; font-family: monospace;"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small">💳 Desglose Tarjeta</label>
                                <textarea class="form-control form-control-sm" id="devBreakdownTarjeta" rows="3" readonly style="font-size: 0.75rem; font-family: monospace;"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Debug Payment Types Section (Development Mode Only) -->
                    <div id="debugPaymentTypes" class="d-none mb-3">
                        <!-- Content will be populated by JavaScript -->
                    </div>

                    <div class="form-check mb-3" id="includeInTotalContainer" style="display: none;">
                        <input class="form-check-input" type="checkbox" id="includeInTotal" checked>
                        <label class="form-check-label" for="includeInTotal">
                            Incluir en el total de la <%= e %>
                        </label>
                        <small class="form-text text-muted d-block">Desmarcar si el cliente paga este servicio por separado</small>
                    </div>

                    <!-- Asistentes (participantes / pasajeros) -->
                    <div class="mb-3" id="serviceAttendeesSection">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0" id="serviceAttendeesLabel">Asistentes</label>
                            <button type="button" class="btn btn-outline-primary" id="addAttendeeBtn">
                                <i class="ti ti-plus me-1"></i><span id="addAttendeeBtnText">Agregar asistente</span>
                            </button>
                        </div>
                        <small class="form-text text-muted d-block mb-2">Nombre completo de cada persona que toma este servicio</small>
                        <div id="serviceAttendeesList"></div>
                    </div>

                    <div class="mb-3">
                        <label for="serviceNotes" class="form-label">Notas Adicionales</label>
                        <textarea class="form-control" id="serviceNotes" rows="2" placeholder="Información adicional del servicio..."></textarea>
                    </div>

                    <!-- Preview -->
                    <div class="service-preview bg-light rounded p-3 d-none">
                        <h6 class="mb-2">Vista Previa</h6>
                        <div id="servicePreview">
                            <!-- Preview content will be generated here -->
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="saveServiceBtn">
                    <i class="ti ti-device-floppy me-1"></i>Guardar Servicio
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom bg-danger text-white">
                <h5 class="modal-title">
                    <i class="ti ti-alert-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="deleteConfirmMessage">¿Estás seguro de que deseas eliminar este elemento?</p>
                <p class="text-muted">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="ti ti-trash me-1"></i>Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title">
                    <i class="ti ti-eye me-2"></i>Vista Previa del Itinerario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="previewContent">
                <!-- Preview content will be generated here -->
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="exportPdfBtn">
                    <i class="ti ti-file-download me-1"></i>Exportar PDF
                </button>
            </div>
        </div>
    </div>
</div>