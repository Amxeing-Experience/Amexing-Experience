            <div class="modal-header border-bottom">
                <h5 class="modal-title">
                    <i class="ti ti-eye me-2"></i>Vista Previa del Itinerario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
