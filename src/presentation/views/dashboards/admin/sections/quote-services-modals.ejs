                                <div class="col-md-4 mb-3">
                                    <label for="aDisposicionRate" class="form-label">Segmento <span class="text-danger">*</span></label>
                                    <select class="form-select" id="aDisposicionRate" required>
                                        <option value="">-- Seleccionar segmento --</option>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="aDisposicionVehicle" class="form-label">Vehículo <span class="text-danger">*</span></label>
                                    <select class="form-select" id="aDisposicionVehicle" required>
                                        <option value="">-- Seleccionar vehículo --</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Vehicle Quantity & Hours -->
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="aDisposicionVehicleCount" class="form-label">Cantidad de Vehículos</label>
                                    <input type="number" class="form-control" id="aDisposicionVehicleCount" min="1" value="1">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="aDisposicionHours" class="form-label">Horas</label>
                                    <input type="number" class="form-control" id="aDisposicionHours" min="3" max="24" step="0.5" value="4">
                                </div>
                                <div class="col-md-4 mb-3 d-flex align-items-end">
                                    <small class="text-muted" id="aDisposicionDiscountInfo"></small>
                                </div>
                            </div>

                            <!-- Guía / Greeter Options -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="aDisposicionGuide">
                                        <label class="form-check-label" for="aDisposicionGuide">
                                            <i class="ti ti-user me-1"></i>Incluir Guía
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="aDisposicionGreeter">
                                        <label class="form-check-label" for="aDisposicionGreeter">
                                            <i class="ti ti-user-check me-1"></i>Incluir Greeter
                                        </label>
                                    </div>
                                    <!-- Sub-opción: el greeter viaja en el vehículo (ocupa 1 asiento). Espejo de transporte. -->
                                    <div class="form-check ms-3 d-none" id="aDisposicionGreeterInVehicleContainer">
                                        <input class="form-check-input" type="checkbox" id="aDisposicionGreeterInVehicle">
                                        <label class="form-check-label small text-muted" for="aDisposicionGreeterInVehicle">Viaja en el vehículo</label>
                                    </div>
                                </div>
                                <!-- Nota de capacidad (a-disposición): el guía/greeter que viaja ocupa un asiento -->
                                <div class="col-12">
                                    <small id="aDisposicionVehicleCapacityNote" class="text-info d-none d-block mt-1"><i class="ti ti-info-circle me-1"></i><span id="aDisposicionVehicleCapacityNoteText"></span></small>
                                </div>
                            </div>

                            <!-- Vehículos adicionales (a-disposición; segmento por fila) -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label mb-0"><i class="ti ti-car me-1"></i>Vehículos adicionales</label>
                                    <button type="button" class="btn btn-outline-primary" id="aDisposicionAddVehicleBtn">
                                        <i class="ti ti-plus me-1"></i>Agregar vehículo
                                    </button>
                                </div>
                                <small class="text-muted d-block mb-2">Cada vehículo adicional usa su tarifa por hora × las horas del servicio.</small>
                                <!-- Headers tipo tabla (una sola fila); se muestra solo cuando hay vehículos. -->
                                <div class="row g-2 mb-1 d-none" id="aDisposicionAdditionalVehiclesHeader">
                                    <div class="col-md-4"><small class="text-muted fw-semibold">Segmento</small></div>
                                    <div class="col-md-4"><small class="text-muted fw-semibold">Vehículo</small></div>
                                    <div class="col-md-3"><small class="text-muted fw-semibold">Precio (efectivo)</small></div>
                                    <div class="col-md-1"></div>
                                </div>
                                <div id="aDisposicionAdditionalVehiclesList"></div>
                            </div>
                        </div>

                        <!-- Concepto Fields -->
                        <div id="conceptoContent" class="service-content d-none">
                            <div class="mb-3">
                                <label for="conceptoConcept" class="form-label">Concepto <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="conceptoConcept" placeholder="Describe el servicio...">
                            </div>
                            
                            <!-- Client Price -->
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="conceptoClientPrice" class="form-label">Precio Unitario (efectivo)</label>
                                    <input type="number" class="form-control" id="conceptoClientPrice" placeholder="0.00" step="0.01" min="0">
                                    <small class="text-muted">Precio unitario del concepto</small>
                                    <!-- Aplicar/excluir el precio unitario del desglose (el valor se conserva). -->
                                    <div class="form-check mt-1">
                                        <input class="form-check-input" type="checkbox" id="conceptoApplyUnitPrice" checked>
                                        <label class="form-check-label small" for="conceptoApplyUnitPrice">Aplicar al total</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="conceptoPricePerPerson" class="form-label">Precio por Persona (efectivo)</label>
                                    <input type="number" class="form-control" id="conceptoPricePerPerson" placeholder="0.00" step="0.01" min="0">
                                    <small class="text-muted">Precio por persona del concepto</small>
                                    <!-- Aplicar/excluir el precio por persona del desglose (el valor se conserva). -->
                                    <div class="form-check mt-1">
                                        <input class="form-check-input" type="checkbox" id="conceptoApplyPerPerson" checked>
                                        <label class="form-check-label small" for="conceptoApplyPerPerson">Aplicar al total</label>
                                    </div>
                                </div>
                            </div>
                            <!-- Surcharges checkbox kept in DOM (hidden) so existing JS handlers still work -->
                            <div class="d-none">
                                <input class="form-check-input" type="checkbox" id="conceptoApplySurcharges" checked>
                            </div>
                            
                            <!-- Schedule Fields (opcionales: si se llenan se guardan, si no, se ignoran) -->
                            <div id="conceptoScheduleFields">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="conceptoStartTime" class="form-label">Hora de inicio</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                            <input type="text" class="form-control time-input" id="conceptoStartTime" list="quoteTimeOptions" placeholder="__:__" maxlength="5" autocomplete="off">
                                        </div>
                                        <small class="form-text text-muted">Ej: 09:00, 14:30</small>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="conceptoEndTime" class="form-label">Hora de fin</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                            <input type="text" class="form-control time-input" id="conceptoEndTime" list="quoteTimeOptions" placeholder="__:__" maxlength="5" autocomplete="off">
                                        </div>
                                        <small class="form-text text-muted">Ej: 17:00, 20:30</small>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- People Quantities for Concepto -->
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="conceptoAdultsQuantity" class="form-label">Número de adultos (12+)</label>
                                    <input type="number" class="form-control concepto-quantity-input" id="conceptoAdultsQuantity" min="0" max="50" placeholder="0">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="conceptoChildrenQuantity" class="form-label">Número de niños (3-12)</label>
                                    <input type="number" class="form-control concepto-quantity-input" id="conceptoChildrenQuantity" min="0" max="50" placeholder="0">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="conceptoAdultsNoAlcoholQuantity" class="form-label">Número de infantes (0-2)</label>
                                    <input type="number" class="form-control concepto-quantity-input" id="conceptoAdultsNoAlcoholQuantity" min="0" max="50" placeholder="0">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Common Fields -->
                    <hr class="my-4">
                    
                    <!-- Tour Transport Checkbox - Only visible for Tours -->
                    <div class="mb-3" id="tourTransportCheckboxContainer" style="display: none;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="tourRequiresTransport">
                            <label class="form-check-label" for="tourRequiresTransport">
                                <i class="ti ti-car me-1"></i>Se requiere traslado
                            </label>
                        </div>
                    </div>
                    
                    <!-- Number of People Fields for Transport -->
                    <div class="row mb-3" id="transportPeopleFieldsRow">
                        <div class="col-md-4">
                            <label for="transportAdults" class="form-label">Número de adultos (12+)</label>
                            <input type="number" class="form-control" id="transportAdults" min="0" max="100" placeholder="0">
                        </div>
                        <div class="col-md-4">
                            <label for="transportChildren" class="form-label">Número de niños (3-12)</label>
                            <input type="number" class="form-control" id="transportChildren" min="0" max="100" placeholder="0">
                        </div>
                        <div class="col-md-4">
                            <label for="transportInfants" class="form-label">Número de infantes (0-2)</label>
                            <input type="number" class="form-control" id="transportInfants" min="0" max="100" placeholder="0">
                        </div>
                    </div>
                    
                    <!-- Duración estimada de viaje (horas/minutos): común a one-way y round-trip. Se
                         autollena de la ruta y es editable. La usan guía/greeter y la hora de salida
                         sugerida. Si la ruta no la trae, captúrala aquí. -->
                    <div class="row" id="routeDurationRow">
                        <div class="col-md-5 mb-3">
                            <label class="form-label">Duración estimada de viaje <small class="text-muted">(horas y minutos)</small></label>
                            <div class="input-group">
                                <input type="number" min="0" step="1" class="form-control" id="routeDurationHours" placeholder="0" autocomplete="off" aria-label="Horas">
                                <span class="input-group-text">h</span>
                                <input type="number" min="0" max="59" step="5" class="form-control" id="routeDurationMinutes" placeholder="0" autocomplete="off" aria-label="Minutos">
                                <span class="input-group-text">min</span>
                            </div>
                            <small class="text-muted d-block">Se autollena de la ruta; usada para guía/greeter y hora de salida sugerida.</small>
                            <small class="text-info d-block d-none" id="routeDurationRoundTripHint"></small>
                        </div>
                    </div>

                    <div class="row" id="transportFieldsRow">
                        <div class="col-md-4 mb-3 transport-main-field">
                            <label for="transportCategory" class="form-label">Segmento <span class="text-danger">*</span></label>
                            <select class="form-select" id="transportCategory" required>
                                <option value="">-- Seleccionar segmento --</option>
                                <!-- Options will be loaded dynamically from Rate table -->
                            </select>
                        </div>
                        <div class="col-md-4 mb-3 transport-main-field">
                            <label for="vehicleSelect" class="form-label">Vehículo <span id="vehicleLoadingSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status" style="width: 14px; height: 14px; border-width: 2px;"></span></label>
                            <select class="form-select" id="vehicleSelect">
                                <option value="">-- Sin vehículo --</option>
                            </select>
                            <small id="vehicleCapacityNote" class="text-info d-none"><i class="ti ti-info-circle me-1"></i><span id="vehicleCapacityNoteText"></span></small>
                        </div>
                    </div>

                    <!-- Aviso full-width: ruta sin precio en catálogo -> "precio pendiente" (Parte B/C).
                         Banda ancha debajo del vehículo (arriba de Opcionales) para que abarque ambos campos. -->
                    <div class="row">
                        <div class="col-12">
                            <div class="alert alert-warning d-flex align-items-start gap-2 py-2 px-3 mb-3 d-none" id="transportPricePendingNotice" role="alert">
                                <i class="ti ti-alert-triangle mt-1"></i>
                                <div>
                                    <strong>Precio pendiente</strong>
                                    <span class="d-block small" id="transportPricePendingNoticeText">Esta ruta no está en el catálogo de precios. Los vehículos y el precio mostrados ($0) son solo de referencia; el administrador confirmará la tarifa. El servicio se guarda igual.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Opcionales (transporte / tour): guía + greeter -->
                    <div class="row" id="transportOptionsRow">
                        <div class="col-12 mb-3">
                            <label class="form-label d-block mb-1">Opcionales</label>
                            <div class="d-flex flex-wrap align-items-center gap-4">
                                <div class="form-check d-flex align-items-center gap-2">
                                    <input class="form-check-input m-0" type="checkbox" value="" id="includeGuide" style="width: 1.35rem; height: 1.35rem;">
                                    <label class="form-check-label" for="includeGuide" id="guideLabel">Guía + Chofer</label>
                                </div>
                                <div class="form-check d-flex align-items-center gap-2" id="greeterCheckboxContainer">
                                    <input class="form-check-input m-0" type="checkbox" value="" id="includeGreeter" style="width: 1.35rem; height: 1.35rem;">
                                    <label class="form-check-label" for="includeGreeter" id="greeterLabel">Greeter</label>
                                </div>
                                <div class="form-check ms-2 d-none" id="greeterInVehicleContainer">
                                    <input class="form-check-input" type="checkbox" value="" id="greeterInVehicle">
                                    <label class="form-check-label small text-muted" for="greeterInVehicle">Viaja en el vehículo</label>
                                </div>
                            </div>
                            <!-- Aviso: guía/greeter marcado pero la ruta SIN duración → el costo no se
                                 puede calcular y queda pendiente hasta capturar la "Duración de ruta". -->
                            <small class="text-warning d-block mt-2 d-none" id="guideGreeterDurationNotice">
                                <i class="ti ti-alert-triangle me-1"></i>Falta la <strong>duración de la ruta</strong> para calcular el costo de guía/greeter. Ingrésala en “Duración de ruta”; si no, ese costo quedará <strong>pendiente</strong>.
                            </small>
                        </div>
                    </div>

                    <!-- Standard pricing for non-experience services -->
                    <div class="row" id="standardPricingSection">
                        <div class="col-md-6 mb-3" id="servicePriceCol">
                            <label for="servicePrice" class="form-label">Precio <small class="text-muted">(efectivo)</small> <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="servicePrice" placeholder="0.00" step="0.01" min="0" required>
                                <span class="input-group-text">MXN</span>
                            </div>
                            <small class="text-muted d-block" id="servicePriceListPrice"></small>

                            <!-- Tour Vehicle Price Override Toggle (Admin Only) -->
                            <% if (canEditPrices) { %>
                            <div class="form-check mt-2 d-none" id="tourVehicleOverridePricesContainer">
                                <input class="form-check-input" type="checkbox" id="tourVehicleOverridePrices">
                                <label class="form-check-label" for="tourVehicleOverridePrices">
                                    <i class="ti ti-edit me-1"></i>Editar precio manualmente
                                </label>
                                <small class="text-muted d-block ms-4">Permite modificar el precio calculado del vehículo</small>
                            </div>
                            <% } %>
                            
                            <!-- Transport Price Override Toggle (Admin Only) -->
                            <% if (canEditPrices) { %>
                            <div class="form-check mt-2 d-none" id="transportOverridePricesContainer">
                                <input class="form-check-input" type="checkbox" id="transportOverridePrices">
                                <label class="form-check-label" for="transportOverridePrices">
                                    <i class="ti ti-edit me-1"></i>Editar precio manualmente
                                </label>
                                <small class="text-muted d-block ms-4">Permite modificar el precio calculado automáticamente</small>
                            </div>
                            <% } %>
                            
                            <!-- A Disposición Price Override Toggle (Admin Only) -->
                            <% if (canEditPrices) { %>
                            <div class="form-check mt-2 d-none" id="aDisposicionOverridePricesContainer">
                                <input class="form-check-input" type="checkbox" id="aDisposicionOverridePrices">
                                <label class="form-check-label" for="aDisposicionOverridePrices">
                                    <i class="ti ti-edit me-1"></i>Editar precio manualmente
                                </label>
                                <small class="text-muted d-block ms-4">Permite modificar el precio calculado automáticamente</small>
                            </div>
                            <% } %>
                        </div>
                        <!-- Tiempo de espera del vehículo principal — junto al precio base (solo transporte). -->
                        <div class="col-md-4 mb-3 d-none" id="tiempoEsperaSection">
                            <label class="form-label"><i class="ti ti-clock me-1"></i>Tiempo de espera</label>
                            <div class="row g-1">
                                <div class="col-5">
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="waitingTimeHours" min="0" step="0.5" value="0" placeholder="0">
                                        <span class="input-group-text">h</span>
                                    </div>
                                </div>
                                <div class="col-7">
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control" id="waitingTimePrice" min="0" step="0.01" placeholder="0.00" title="Tarifa por hora (editable)">
                                        <span class="input-group-text">/h</span>
                                    </div>
                                    <small class="text-muted d-block" id="waitingTimeRate"></small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3" id="serviceQuantityCol">
                            <label for="serviceQuantity" class="form-label">Cantidad</label>
                            <input type="number" class="form-control" id="serviceQuantity" value="1" min="1" required>
                            <small class="text-muted d-none" id="roundTripQuantityHint">Vehículo Ida y Regreso</small>
                        </div>
                        <!-- Vehículos adicionales (lista). Reemplaza al antiguo "vehículo adicional"
                             único. Se muestra para transporte / tour con vehículo; el botón se
                             habilita solo cuando hay un vehículo principal seleccionado. -->
                        <div class="col-12 d-none mt-2" id="extraAdditionalVehiclesContainer">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0"><i class="ti ti-car me-1"></i>Vehículos adicionales</label>
                                <button type="button" class="btn btn-outline-primary" id="addExtraAdditionalVehicleBtn" disabled>
                                    <i class="ti ti-plus me-1"></i>Agregar vehículo
                                </button>
                            </div>
                            <small class="text-muted d-block mb-2" id="extraVehiclesMainHint">
                                <i class="ti ti-info-circle me-1"></i>Selecciona primero el vehículo principal para agregar adicionales.
                            </small>
                            <!-- Headers tipo tabla (una sola fila); se muestra solo cuando hay vehículos. -->
                            <div class="row g-2 mb-1 d-none" id="extraAdditionalVehiclesHeader">
                                <div class="col-md-2"><small class="text-muted fw-semibold">Segmento</small></div>
                                <div class="col-md-3"><small class="text-muted fw-semibold">Vehículo</small></div>
                                <div class="col-md-2 extra-price-col"><small class="text-muted fw-semibold">Precio (efectivo)</small></div>
                                <div class="col-md-4 extra-waiting-col"><small class="text-muted fw-semibold">Tiempo de espera</small></div>
                                <div class="col-md-1"></div>
                            </div>
                            <div id="extraAdditionalVehiclesList"></div>
                        </div>
                    </div>
                    <!-- Experience pricing with adult/child/no-alcohol options -->
                    <div id="experiencePricingSection" class="d-none">
                        <!-- Experience Details Card (minimalist) -->
                        <div id="experienceDetailsCard" class="card border mb-3 d-none">
                            <div class="card-body p-3" id="experienceDetailsCardBody">
                                <!-- Populated dynamically by JS -->
                            </div>
                        </div>
                        
                        <!-- Hora de inicio / Hora de fin (user input) -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="experienceStartTime" class="form-label">Hora de inicio</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                    <input type="text" class="form-control time-input" id="experienceStartTime" list="quoteTimeOptions" placeholder="__:__" maxlength="5" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="experienceEndTime" class="form-label">Hora de fin</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-clock"></i></span>
                                    <input type="text" class="form-control time-input" id="experienceEndTime" list="quoteTimeOptions" placeholder="__:__" maxlength="5" autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <!-- Duración (horas): se autollena de la experiencia seleccionada y es editable.
                             Al lado, checkbox opcional "Guía". -->
                        <div class="row mb-3">
                            <div class="col-md-10">
                                <label class="form-label">Duración</label>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="input-group" style="max-width: 140px;">
                                        <input type="number" min="0" step="1" class="form-control" id="experienceDurationHours" placeholder="0" autocomplete="off">
                                        <span class="input-group-text">h</span>
                                    </div>
                                    <div class="input-group" style="max-width: 140px;">
                                        <input type="number" min="0" max="59" step="5" class="form-control" id="experienceDurationMinutes" placeholder="0" autocomplete="off">
                                        <span class="input-group-text">min</span>
                                    </div>
                                </div>
                                <!-- Valor canónico en horas decimales (fuente de verdad para la fórmula del guía). -->
                                <input type="hidden" id="experienceDuration">
                                <small class="text-muted d-block">Se autollena de la experiencia; puedes modificarla.</small>
                                <!-- Duración real calculada del horario (inicio/fin): solo si difiere de la de catálogo. -->
                                <small class="text-info d-block d-none" id="experienceRealDuration"></small>
                            </div>
                            <div class="col-md-2 d-flex align-items-center">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="experienceGuide">
                                    <label class="form-check-label" for="experienceGuide">Guía</label>
                                </div>
                            </div>
                        </div>

                        <!-- Dirección de pickup (texto libre) para experiencias. -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label for="experiencePickupAddress" class="form-label"><i class="ti ti-map-pin me-1"></i>Dirección de pickup</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="experiencePickupAddress" placeholder="Hotel, dirección o punto de encuentro" autocomplete="off">
                                    <button class="btn btn-outline-secondary use-lodging-btn d-none" type="button" data-target="experiencePickupAddress" title="Usar el hospedaje de la cotización"><i class="ti ti-bed"></i></button>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">
                        
                        <!-- People limits display -->
                        <div class="alert alert-info py-2 mb-3" id="peopleLimitsAlert" style="display: none;">
                            <i class="ti ti-users me-2"></i>
                            <span id="peopleLimitsText">Mínimo: 1 persona • Máximo: 10 personas</span>
