    // Objeto de opción (firstName/lastName/email/phone) del Cliente Final por valor.
    // clientFinalId usa el dropdown custom (customSelect.getOption) — NO expone .options
    // como TomSelect, por eso hay que resolverlo por ambas vías.
    function getFinalClientOptionByValue(val) {
        if (!val) return null;
        const el = document.getElementById('clientFinalId');
        if (el && el.customSelect && el.customSelect.getOption) {
            const o = el.customSelect.getOption(val);
            if (o) return o;
        }
        const ts = el && el.tomselect;
        if (ts && ts.options && ts.options[val]) return ts.options[val];
        return null;
    }

