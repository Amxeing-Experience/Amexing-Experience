    // Save quick client
    async function saveQuickClient() {
        const form = document.getElementById('quickClientForm');

        // Validate form
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return;
        }

        // Get form data
        const formData = {
            firstName: document.getElementById('qc_firstName').value.trim(),
            lastName: document.getElementById('qc_lastName').value.trim(),
            email: document.getElementById('qc_email').value.trim() || undefined,
            companyName: document.getElementById('qc_companyName').value.trim() || undefined,
            phone: document.getElementById('qc_phone').value.trim() || undefined
        };

        // Show loader
        showQuickClientModalLoader('quickClientModal');
        clearAlerts('quickClientModalAlerts');

        try {
            // Use different endpoint based on user role
            const endpoint = (userRole === 'department_manager' || userRole === 'client') 
                ? '/api/owned-clients/quick' 
                : '/api/clients/quick';
            
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (result.success && result.data) {
                // Add new client to Tom Select
                const clientTS = await waitForTomSelect('clientId');

                clientTS.addOption({
                    value: result.data.value,
                    text: result.data.label,
                    email: result.data.email,
                    contactPerson: result.data.contactPerson,
                    phone: result.data.phone
                });

                // Select the new client
                clientTS.setValue(result.data.value);

                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('quickClientModal'));
                modal.hide();

                // Show success message
                showAlert('quoteInformationAlerts', 'Cliente creado exitosamente', 'success');
            } else {
                // Handle specific error cases
                let errorMessage = result.error || 'Error al crear el cliente';

                if (response.status === 409 || errorMessage.includes('email') || errorMessage.includes('Email')) {
                    errorMessage = 'Ya existe un cliente con este nombre. Por favor, usa un nombre diferente o proporciona un email único.';
                }

                showAlert('quickClientModalAlerts', errorMessage, 'danger');
            }
        } catch (error) {
            console.error('Error creating quick client:', error);
            showAlert('quickClientModalAlerts', 'Error de conexión al crear el cliente', 'danger');
        } finally {
            hideQuickClientModalLoader('quickClientModal');
        }
    }

    // Load existing quote data
    async function loadQuoteData(quoteId) {
        try {
            const response = await fetch(`/api/quotes/${quoteId}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();

            if (result.success && result.data) {
                const quote = result.data;

                // Handle client population - DUAL FIELD ARCHITECTURE
                const clientTS = await waitForTomSelect('clientId');
                
                // Role-based client field prioritization
                let selectedClientId = null;
                let selectedClientData = null;
                
                if (userRole === 'admin' || userRole === 'superadmin') {
                    // Admin/superadmin: prioritize legacy client field (AmexingUser objects)
                    if (quote.client && quote.client.id) {
                        selectedClientId = quote.client.id;
                        selectedClientData = quote.client;
                    } else if (quote.companyClientPtr && quote.companyClientPtr.id) {
                        selectedClientId = quote.companyClientPtr.id;
                        selectedClientData = quote.companyClientPtr;
                    }
                } else {
                    // Hierarchical roles: prioritize companyClientPtr (Client objects)
                    if (quote.companyClientPtr && quote.companyClientPtr.id) {
                        selectedClientId = quote.companyClientPtr.id;
                        selectedClientData = quote.companyClientPtr;
                    } else if (quote.client && quote.client.id) {
                        selectedClientId = quote.client.id;
                        selectedClientData = quote.client;
                    }
                }
                
                if (selectedClientId && selectedClientData) {
                    console.log('🔍 Loading quote client data:', {
                        clientId: selectedClientId,
                        clientData: selectedClientData,
                        hasContextualData: !!selectedClientData.contextualData,
                        contextualCompanyName: selectedClientData.contextualData?.companyName,
                        directCompanyName: selectedClientData.companyName,
                        firstName: selectedClientData.firstName,
                        lastName: selectedClientData.lastName,
                        fullName: selectedClientData.fullName,
                        name: selectedClientData.name
                    });
                    
                    // Build display text based on available data
                    let displayText = '';
                    
                    // Check if we have contextualData with companyName
                    if (selectedClientData.contextualData && selectedClientData.contextualData.companyName) {
                        displayText = selectedClientData.contextualData.companyName;
                        console.log('✅ Using contextualData.companyName:', displayText);
                    } else if (selectedClientData.companyName) {
                        displayText = selectedClientData.companyName;
                        console.log('✅ Using direct companyName:', displayText);
                    } else {
                        // Fall back to name fields
                        const fullName = selectedClientData.fullName || 
                                       selectedClientData.name || 
                                       `${selectedClientData.firstName || ''} ${selectedClientData.lastName || ''}`.trim();
                        displayText = fullName || `Cliente ${selectedClientId}`;
                        console.log('⚠️ Falling back to person name:', displayText, {
                            fullName: selectedClientData.fullName,
                            name: selectedClientData.name,
                            constructed: `${selectedClientData.firstName || ''} ${selectedClientData.lastName || ''}`.trim()
                        });
                    }
                    
                    console.log('📋 Final display text for loaded quote client:', {
                        clientId: selectedClientId,
                        displayText: displayText
                    });
                    
                    // TomSelect doesn't have updateOption, we need to remove and re-add
                    // First check if the option already exists
                    const existingOptions = clientTS.options;
                    
                    if (existingOptions && existingOptions[selectedClientId]) {
                        // Store current value to restore selection
                        const currentValue = clientTS.getValue();
                        
                        // Clear the current selection silently
                        clientTS.clear(true);
                        
                        // Remove the old option
                        delete clientTS.options[selectedClientId];
                        
                        // Add the updated option
                        clientTS.addOption({
                            value: selectedClientId,
                            text: displayText,
                            email: selectedClientData.email || '',
                            contactPerson: selectedClientData.contactPerson || '',
                            phone: selectedClientData.phone || ''
                        });
                        
                        // Restore selection
                        clientTS.setValue(selectedClientId);
                    } else {
                        // Add new option if it doesn't exist
                        clientTS.addOption({
                            value: selectedClientId,
                            text: displayText,
                            email: selectedClientData.email || '',
                            contactPerson: selectedClientData.contactPerson || '',
                            phone: selectedClientData.phone || ''
                        });
                        
                        // Set the selected value
                        clientTS.setValue(selectedClientId);
                    }
                } else {
                    // No client data in quote
                }

                // Load employees for the selected client (to populate the employee dropdown)
                // Pass the clientFinalId if we have one so it can be selected after loading
                console.log('🔍 Quote data for Cliente Final:', {
                    hasClientFinalId: 'clientFinalId' in quote,
                    clientFinalId: quote.clientFinalId,
                    clientFinalIdType: typeof quote.clientFinalId,
                    fullQuote: quote
                });
                
                if (selectedClientId) {
                    await loadClientEmployees(selectedClientId, quote.clientFinalId || null);
                }

                // Populate form fields
                if (quote.eventType) {
                    document.getElementById('eventType').value = quote.eventType;
                }

                if (quote.numberOfPeople) {
                    document.getElementById('numberOfPeople').value = quote.numberOfPeople;
                }
                if (quote.numberOfAdults !== undefined && quote.numberOfAdults !== 0) {
                    document.getElementById('numberOfAdults').value = quote.numberOfAdults;
                }
                if (quote.numberOfChildren !== undefined && quote.numberOfChildren !== 0) {
                    document.getElementById('numberOfChildren').value = quote.numberOfChildren;
                }
                if (quote.numberOfInfants !== undefined && quote.numberOfInfants !== 0) {
                    document.getElementById('numberOfInfants').value = quote.numberOfInfants;
                }
                if (quote.preferredLanguage) {
                    document.getElementById('preferredLanguage').value = quote.preferredLanguage;
                }

                // Check for separate name fields first, fall back to splitting contactPerson
                if (quote.contactFirstName || quote.contactLastName) {
                    // Use separate fields if they exist
                    document.getElementById('contactFirstName').value = quote.contactFirstName || '';
                    document.getElementById('contactLastName').value = quote.contactLastName || '';
                } else if (quote.contactPerson) {
                    // Fall back to splitting contactPerson for backward compatibility
                    const nameParts = quote.contactPerson.trim().split(/\s+/);
                    if (nameParts.length === 1) {
                        document.getElementById('contactFirstName').value = nameParts[0];
                        document.getElementById('contactLastName').value = '';
                    } else if (nameParts.length === 2) {
                        document.getElementById('contactFirstName').value = nameParts[0];
                        document.getElementById('contactLastName').value = nameParts[1];
                    } else if (nameParts.length > 2) {
                        document.getElementById('contactFirstName').value = nameParts[0];
                        document.getElementById('contactLastName').value = nameParts.slice(1).join(' ');
                    }
                }

                if (quote.contactEmail) {
                    document.getElementById('contactEmail').value = quote.contactEmail;
                }

                if (quote.contactPhone) {
                    // Strip country code if present (for Mexico, it's 52)
                    let phoneNumber = quote.contactPhone;
                    // Check if phone starts with common country codes and remove them
                    if (phoneNumber.startsWith('52') && phoneNumber.length > 10) {
                        // Remove Mexico country code
                        phoneNumber = phoneNumber.substring(2);
                    } else if (phoneNumber.startsWith('1') && phoneNumber.length === 11) {
                        // Remove US/Canada country code
                        phoneNumber = phoneNumber.substring(1);
                    }
                    document.getElementById('contactPhone').value = phoneNumber;
                }

                if (quote.notes) {
                    document.getElementById('notes').value = quote.notes;
                }

                // Change button text to "Actualizar"
                const submitBtn = document.getElementById('createQuoteBtn');
                submitBtn.innerHTML = '<i class="ti ti-check me-1"></i>Actualizar Cotización';
            } else {
                showAlert('quoteInformationAlerts', 'Error al cargar la cotización', 'danger');
            }
        } catch (error) {
            console.error('Error loading quote data:', error);
            showAlert('quoteInformationAlerts', 'Error al cargar los datos de la cotización', 'danger');
        }
    }

    // Update existing quote
    async function updateQuote(quoteId, event) {
        event.preventDefault();

        const form = document.getElementById('quoteInformationForm');

        // Validate form
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return;
        }

        clearAlerts('quoteInformationAlerts');

        // Get client ID - all user roles now use TomSelect
        const clientTS = await waitForTomSelect('clientId');
        const clientId = clientTS.getValue();

        if (!clientId) {
            showAlert('quoteInformationAlerts', 'Por favor selecciona un cliente', 'danger');
            return;
        }

        // Get employee selection if any
        let clientFinalId = null;
        try {
            const employeeTS = await waitForTomSelect('clientFinalId');
            const value = employeeTS.getValue();
            // Only set if there's an actual value
            if (value && value !== '') {
                clientFinalId = value;
            }
        } catch (e) {
            console.log('Cliente Final dropdown not initialized yet');
        }

        // Get form data
        const firstName = document.getElementById('contactFirstName').value.trim();
        const lastName = document.getElementById('contactLastName').value.trim();
        const contactPerson = [firstName, lastName].filter(n => n).join(' ') || undefined;
        
        const formData = {
            eventType: document.getElementById('eventType').value.trim() || undefined,
            numberOfPeople: document.getElementById('numberOfPeople').value ? parseInt(document.getElementById('numberOfPeople').value, 10) : undefined,
            numberOfAdults: parseInt(document.getElementById('numberOfAdults').value || 0),
            numberOfChildren: parseInt(document.getElementById('numberOfChildren').value || 0),
            numberOfInfants: parseInt(document.getElementById('numberOfInfants').value || 0),
            preferredLanguage: document.getElementById('preferredLanguage').value || 'es',
            contactPerson: contactPerson,
            contactFirstName: firstName || undefined,
            contactLastName: lastName || undefined,
            contactEmail: document.getElementById('contactEmail').value.trim() || undefined,
            contactPhone: document.getElementById('contactPhone').value.trim() || undefined,
            notes: document.getElementById('notes').value.trim() || undefined
        };

        // Only include clientFinalId if it has a value
        if (clientFinalId) {
            formData.clientFinalId = clientFinalId;
        }
        
        // Include status from global header segmented control if exists
        const checkedStatus = document.querySelector('input[name="quoteStatus"]:checked');
        if (checkedStatus) {
            formData.status = checkedStatus.value;
        }

        // Disable submit button
        const submitBtn = document.getElementById('createQuoteBtn');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="ti ti-loader-2 me-1 spinner-border spinner-border-sm"></i>Actualizando...';

        try {
            const response = await fetch(`/api/quotes/${quoteId}`, {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (result.success) {
                showAlert('quoteInformationAlerts', 'Cotización actualizada exitosamente', 'success');

                // Redirect to quote detail page with services section (use appropriate dashboard path)
                const dashboardPathMap = { department_manager: '/dashboard/department_manager', client: '/dashboard/client' };
                const dashboardPath = dashboardPathMap[userRole] || '/dashboard/admin';
                setTimeout(() => {
                    window.location.href = `${dashboardPath}/quotes/${quoteId}?section=services`;
                }, 1500);
            } else {
                showAlert('quoteInformationAlerts', result.error || 'Error al actualizar la cotización', 'danger');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        } catch (error) {
            console.error('Error updating quote:', error);
            showAlert('quoteInformationAlerts', 'Error de conexión al actualizar la cotización', 'danger');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }

