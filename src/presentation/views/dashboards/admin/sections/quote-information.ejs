    // Load existing quote data
    async function loadQuoteData(quoteId) {
        try {
            const response = await fetch(`/api/quotes/${quoteId}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();

            if (result.success && result.data) {
                const quote = result.data;

                // Check if this is a direct client quote
                // Primary: Check clientType field
                // Fallback: Check if has companyClientPtr but no client (for older quotes)
                const isDirectClient = quote.clientType === 'direct' || 
                                     (quote.companyClientPtr && !quote.client);
                
                // If admin user and direct client quote, switch the UI to direct mode
                if ((userRole === 'admin' || userRole === 'superadmin') && isDirectClient) {
                    const directRadio = document.getElementById('clientTypeDirect');
                    if (directRadio) {
                        directRadio.checked = true;
                        currentClientType = 'direct';
                        
                        // Update help text visibility
                        document.querySelectorAll('.client-type-agency').forEach(el => {
                            el.style.display = 'none';
                        });
                        document.querySelectorAll('.client-type-direct').forEach(el => {
                            el.style.display = 'inline';
                        });
                        
                        // Cargar la lista de clientes DIRECTOS en el dropdown #directClientId (el que
                        // usa admin en modo directo). Antes llamaba loadActiveClients(...,'direct'), que
                        // llena #clientId (agencia) → el dropdown directo quedaba SIN opciones.
                        await loadDirectClients('', 1);
                    }
                }

                // Handle client population - DUAL FIELD ARCHITECTURE
                // Get the correct client field based on quote type
                let clientTS;
                if (isDirectClient && (userRole === 'admin' || userRole === 'superadmin')) {
                    // For direct client quotes, populate the directClientId field
                    clientTS = await waitForTomSelect('directClientId');
                    
                    // Also make sure the direct client row is visible
                    const directClientRow = document.getElementById('directClientRow');
                    if (directClientRow) {
                        directClientRow.style.display = 'flex';
                    }
                    
                    // Hide the agency client row
                    const agencyClientRow = document.getElementById('agencyClientRow');
                    if (agencyClientRow) {
                        agencyClientRow.style.display = 'none';
                    }
                    
                    // Hide the final client row for direct clients
                    const finalClientRow = document.getElementById('finalClientRow');
                    if (finalClientRow) {
                        finalClientRow.style.display = 'none';
                    }
                } else {
                    // For agency quotes, use the regular clientId field
                    clientTS = await waitForTomSelect('clientId');
                }
                
                // Role-based client field prioritization
                let selectedClientId = null;
                let selectedClientData = null;
                
                if (userRole === 'admin' || userRole === 'superadmin') {
                    if (isDirectClient) {
                        // Cliente directo (end_client): el cliente vive en quote.client (AmexingUser).
                        // Antes estaba en companyClientPtr (Client legado, YA MIGRADO); esta preselección
                        // seguía leyendo el campo viejo → no seleccionaba nada. Se usa quote.client y se
                        // deja companyClientPtr como fallback para quotes legacy.
                        if (quote.client && quote.client.id) {
                            selectedClientId = quote.client.id;
                            selectedClientData = quote.client;
                        } else if (quote.companyClientPtr && quote.companyClientPtr.id) {
                            selectedClientId = quote.companyClientPtr.id;
                            selectedClientData = quote.companyClientPtr;
                        }
                    } else {
                        // For agency quotes, prioritize client field
                        if (quote.client && quote.client.id) {
                            selectedClientId = quote.client.id;
                            selectedClientData = quote.client;
                        } else if (quote.companyClientPtr && quote.companyClientPtr.id) {
                            selectedClientId = quote.companyClientPtr.id;
                            selectedClientData = quote.companyClientPtr;
                        }
                    }
                } else {
                    // Hierarchical roles: prioritize companyClientPtr (Client objects)
                    if (quote.companyClientPtr && quote.companyClientPtr.id) {
                        selectedClientId = quote.companyClientPtr.id;
                        selectedClientData = quote.companyClientPtr;
                    } else if (quote.client && quote.client.id) {
                        selectedClientId = quote.client.id;
                        selectedClientData = quote.client;
                    }
                }
                
                if (selectedClientId && selectedClientData) {
                    console.log('🔍 Loading quote client data:', {
                        clientId: selectedClientId,
                        clientData: selectedClientData,
                        hasContextualData: !!selectedClientData.contextualData,
                        contextualCompanyName: selectedClientData.contextualData?.companyName,
                        directCompanyName: selectedClientData.companyName,
                        firstName: selectedClientData.firstName,
                        lastName: selectedClientData.lastName,
                        fullName: selectedClientData.fullName,
                        name: selectedClientData.name
                    });
                    
                    // Build display text based on available data
                    let displayText = '';
                    
                    // Check if we have contextualData with companyName
                    if (selectedClientData.contextualData && selectedClientData.contextualData.companyName) {
                        displayText = selectedClientData.contextualData.companyName;
                        console.log('✅ Using contextualData.companyName:', displayText);
                    } else if (selectedClientData.companyName) {
                        displayText = selectedClientData.companyName;
                        console.log('✅ Using direct companyName:', displayText);
                    } else {
                        // Fall back to name fields
                        const fullName = selectedClientData.fullName || 
                                       selectedClientData.name || 
                                       `${selectedClientData.firstName || ''} ${selectedClientData.lastName || ''}`.trim();
                        displayText = fullName || `Cliente ${selectedClientId}`;
                        console.log('⚠️ Falling back to person name:', displayText, {
                            fullName: selectedClientData.fullName,
                            name: selectedClientData.name,
                            constructed: `${selectedClientData.firstName || ''} ${selectedClientData.lastName || ''}`.trim()
                        });
                    }
                    
                    console.log('📋 Final display text for loaded quote client:', {
                        clientId: selectedClientId,
                        displayText: displayText
                    });
                    
                    // TomSelect doesn't have updateOption, we need to remove and re-add
                    // First check if the option already exists
                    const existingOptions = clientTS.options;
                    
                    if (existingOptions && existingOptions[selectedClientId]) {
                        // Store current value to restore selection
                        const currentValue = clientTS.getValue();
                        
                        // Clear the current selection silently
                        clientTS.clear(true);
                        
                        // Remove the old option
                        delete clientTS.options[selectedClientId];
                        
                        // Add the updated option
                        clientTS.addOption({
                            value: selectedClientId,
                            text: displayText,
                            email: selectedClientData.email || '',
                            contactPerson: selectedClientData.contactPerson || '',
                            phone: selectedClientData.phone || ''
                        });
                        
                        // Restore selection
                        clientTS.setValue(selectedClientId);
                    } else {
                        // Add new option if it doesn't exist
                        clientTS.addOption({
                            value: selectedClientId,
                            text: displayText,
                            email: selectedClientData.email || '',
                            contactPerson: selectedClientData.contactPerson || '',
                            phone: selectedClientData.phone || ''
                        });
                        
                        // Set the selected value
                        clientTS.setValue(selectedClientId);
                    }
                } else {
                    // No client data in quote
                }

                // Load employees for the selected client (to populate the employee dropdown)
                // Pass the clientFinalId if we have one so it can be selected after loading
                console.log('🔍 Quote data for Cliente Final:', {
                    hasClientFinalId: 'clientFinalId' in quote,
                    clientFinalId: quote.clientFinalId,
                    clientFinalIdType: typeof quote.clientFinalId,
                    fullQuote: quote
                });
                
                // Store clientFinalId for later use after dropdowns are loaded
                const quoteClientFinalId = quote.clientFinalId || null;
                
                if (selectedClientId) {
                    await loadClientEmployees(selectedClientId, quoteClientFinalId);
                } else if (userRole === 'department_manager' || userRole === 'client') {
                    // For restricted roles, load sub-clients with their default clientId
                    const clientField = document.getElementById('clientId');
                    if (clientField && clientField.value) {
                        console.log('🚀 Loading sub-clients for restricted role on existing quote:', userRole, 'clientId:', clientField.value);
                        await loadClientEmployees(clientField.value, quoteClientFinalId);
                    }
                }
                
                // Additional retry mechanism for clientFinalId selection
                if (quoteClientFinalId) {
                    setTimeout(async () => {
                        try {
                            const employeeTS = await waitForTomSelect('clientFinalId');
                            const currentValue = employeeTS.getValue();
                            
                            if (!currentValue || currentValue !== quoteClientFinalId) {
                                const optionExists = employeeTS.getOption && employeeTS.getOption(quoteClientFinalId);
                                if (optionExists) {
                                    employeeTS.setValue(quoteClientFinalId);
                                    console.log('✅ Successfully set clientFinalId in retry:', quoteClientFinalId);
                                } else {
                                    console.warn('⚠️ ClientFinalId option still not found in retry:', quoteClientFinalId);
                                }
                            }
                        } catch (error) {
                            console.error('❌ Error in clientFinalId retry mechanism:', error);
                        }
                    }, 1000); // Wait 1 second for dropdown to fully load
                }

                // Cliente Final tecleado (texto libre, sin id): restaurar el display del combobox.
                const quoteClientFinalName = quote.clientFinalName || '';
                if (quoteClientFinalName && !quoteClientFinalId) {
                    setTimeout(async () => {
                        try {
                            const ts = await waitForTomSelect('clientFinalId');
                            if (ts.setTypedValue) ts.setTypedValue(quoteClientFinalName, true);
                        } catch (e) { /* combobox no listo */ }
                    }, 1000);
                }

                // Lead Guest (modo agencia): restaurar el display del combobox desde el nombre
                // guardado — si coincide con una opción usar su id, si no mostrarlo como tecleado.
                setTimeout(async () => {
                    try {
                        if (!isAgencyModeVisible()) return;
                        const lgFirst = quote.leadGuestFirstName || '';
                        const lgLast = quote.leadGuestLastName || '';
                        const full = `${lgFirst} ${lgLast}`.trim();
                        if (!full) return;
                        const ts = await waitForTomSelect('leadGuestClientId');
                        if (quoteClientFinalId && ts.getOption && ts.getOption(quoteClientFinalId)
                            && document.getElementById('leadGuestIsFinalClient')?.checked) {
                            ts.setValue(quoteClientFinalId);
                        } else if (ts.setTypedValue) {
                            ts.setTypedValue(full, true);
                        }
                    } catch (e) { /* combobox no listo */ }
                }, 1100);

                // Populate form fields
                if (quote.eventType) {
                    document.getElementById('eventType').value = quote.eventType;
                }

                if (quote.numberOfPeople) {
                    document.getElementById('numberOfPeople').value = quote.numberOfPeople;
                }
                if (quote.numberOfAdults !== undefined && quote.numberOfAdults !== 0) {
                    document.getElementById('numberOfAdults').value = quote.numberOfAdults;
                }
                if (quote.numberOfChildren !== undefined && quote.numberOfChildren !== 0) {
                    document.getElementById('numberOfChildren').value = quote.numberOfChildren;
                }
                if (quote.numberOfInfants !== undefined && quote.numberOfInfants !== 0) {
                    document.getElementById('numberOfInfants').value = quote.numberOfInfants;
                }
                if (quote.preferredLanguage) {
                    document.getElementById('preferredLanguage').value = quote.preferredLanguage;
                }

                // Check for separate name fields first, fall back to splitting contactPerson
                if (quote.contactFirstName || quote.contactLastName) {
                    // Use separate fields if they exist
                    document.getElementById('contactFirstName').value = quote.contactFirstName || '';
                    document.getElementById('contactLastName').value = quote.contactLastName || '';
                } else if (quote.contactPerson) {
                    // Fall back to splitting contactPerson for backward compatibility
                    const nameParts = quote.contactPerson.trim().split(/\s+/);
                    if (nameParts.length === 1) {
                        document.getElementById('contactFirstName').value = nameParts[0];
                        document.getElementById('contactLastName').value = '';
                    } else if (nameParts.length === 2) {
                        document.getElementById('contactFirstName').value = nameParts[0];
                        document.getElementById('contactLastName').value = nameParts[1];
                    } else if (nameParts.length > 2) {
                        document.getElementById('contactFirstName').value = nameParts[0];
                        document.getElementById('contactLastName').value = nameParts.slice(1).join(' ');
                    }
                }

                // Lead Guest fields (huésped principal)
                const leadGuestFirstNameEl = document.getElementById('leadGuestFirstName');
                const leadGuestLastNameEl = document.getElementById('leadGuestLastName');
                if (leadGuestFirstNameEl) leadGuestFirstNameEl.value = quote.leadGuestFirstName || '';
                if (leadGuestLastNameEl) leadGuestLastNameEl.value = quote.leadGuestLastName || '';

                // Cotización existente: por defecto NO asumir "es el cliente final" (evita marcar el
                // checkbox cuando el Lead Guest guardado no corresponde al cliente final). Si hay un
                // cliente final que coincide, loadClientEmployees lo re-marca al cargar el dropdown.
                const lgFinalCbLoad = document.getElementById('leadGuestIsFinalClient');
                if (lgFinalCbLoad) {
                    lgFinalCbLoad.checked = false;
                    if (typeof syncLeadGuestMode === 'function') syncLeadGuestMode();
                }

                // Guardar propietario y derivar el checkbox "el contacto es el propietario"
                // (contacto = Lead Guest por defecto; se marca solo si el contacto guardado == propietario).
                window.__quoteOwner = quote.owner || null;
                initContactDifferentFromQuote(quote);

                if (quote.contactEmail) {
                    document.getElementById('contactEmail').value = quote.contactEmail;
                }

                if (quote.contactPhone) {
                    // Strip country code if present (for Mexico, it's 52)
                    let phoneNumber = quote.contactPhone;
                    // Check if phone starts with common country codes and remove them
                    if (phoneNumber.startsWith('52') && phoneNumber.length > 10) {
                        // Remove Mexico country code
                        phoneNumber = phoneNumber.substring(2);
                    } else if (phoneNumber.startsWith('1') && phoneNumber.length === 11) {
                        // Remove US/Canada country code
                        phoneNumber = phoneNumber.substring(1);
                    }
                    document.getElementById('contactPhone').value = phoneNumber;
                }

                if (quote.notes) {
                    document.getElementById('notes').value = quote.notes;
                }

                // Change button text to "Actualizar"
                const submitBtn = document.getElementById('createQuoteBtn');
                submitBtn.innerHTML = 'Siguiente <i class="ti ti-arrow-right ms-1"></i>';
            } else {
                showAlert('quoteInformationAlerts', `Error al cargar la ${Qe}`, 'danger');
            }
        } catch (error) {
            console.error('Error loading quote data:', error);
            showAlert('quoteInformationAlerts', `Error al cargar los datos de la ${Qe}`, 'danger');
        }
    }

    // Update existing quote
    async function updateQuote(quoteId, event) {
        event.preventDefault();

        const form = document.getElementById('quoteInformationForm');

        // Trigger phone validation before form validation
        const phoneInput = document.getElementById('contactPhone');
        if (phoneInput) {
            // Trigger blur to ensure phone validation runs
            phoneInput.dispatchEvent(new Event('blur'));
        }

        // Validate form
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return;
        }

        clearAlerts('quoteInformationAlerts');

        // Get client ID based on current mode
        let clientId;
        if (currentClientType === 'direct' && (userRole === 'admin' || userRole === 'superadmin')) {
            // For direct clients, use the directClientId field
            const directClientTS = await waitForTomSelect('directClientId');
            clientId = directClientTS.getValue();
            
            if (!clientId) {
                showAlert('quoteInformationAlerts', 'Por favor selecciona un cliente directo', 'danger');
                return;
            }
        } else {
            // For agencies, use the regular clientId field
            const clientTS = await waitForTomSelect('clientId');
            clientId = clientTS.getValue();
            
            if (!clientId) {
                showAlert('quoteInformationAlerts', 'Por favor selecciona un cliente', 'danger');
                return;
            }
        }

        // Cliente Final: existente (id), typed-guardado (crea cliente → id) o typed-libre (texto).
        const cfSel = await resolveClientFinalForSave();

        // Get form data — contacto = propietario por defecto. Si NO se marcó "diferente al
        // propietario", se copian nombre/email/teléfono del propietario (evita doble captura).
        const contactVals = resolveContactValues();
        const { firstName, lastName, contactEmail, contactPhone } = contactVals;
        const contactPerson = [firstName, lastName].filter(n => n).join(' ') || undefined;

        const formData = {
            clientId: clientId,  // Include clientId for update
            eventType: document.getElementById('eventType').value.trim() || undefined,
            numberOfPeople: document.getElementById('numberOfPeople').value ? parseInt(document.getElementById('numberOfPeople').value, 10) : undefined,
            numberOfAdults: parseInt(document.getElementById('numberOfAdults').value || 0),
            numberOfChildren: parseInt(document.getElementById('numberOfChildren').value || 0),
            numberOfInfants: parseInt(document.getElementById('numberOfInfants').value || 0),
            preferredLanguage: document.getElementById('preferredLanguage').value || 'es',
            contactPerson: contactPerson,
            contactFirstName: firstName || undefined,
            contactLastName: lastName || undefined,
            contactEmail: contactEmail || undefined,
            contactPhone: contactPhone || undefined,
            leadGuestFirstName: document.getElementById('leadGuestFirstName')?.value.trim() || undefined,
            leadGuestLastName: document.getElementById('leadGuestLastName')?.value.trim() || undefined,
            notes: document.getElementById('notes').value.trim() || undefined
        };

        // clientFinalId o clientFinalName (excluyentes; se envía el otro vacío para limpiar).
        formData.clientFinalId = cfSel.clientFinalId || '';
        formData.clientFinalName = cfSel.clientFinalName || '';

        // Include clientType for admin users updating direct client quotes
        if (userRole === 'admin' || userRole === 'superadmin') {
            const directRadio = document.getElementById('clientTypeDirect');
            if (directRadio && directRadio.checked) {
                formData.clientType = 'direct';
            }
        }
        
        // Include status from global header segmented control if exists
        const checkedStatus = document.querySelector('input[name="quoteStatus"]:checked');
        if (checkedStatus) {
            formData.status = checkedStatus.value;
        }

        // Disable submit button
        const submitBtn = document.getElementById('createQuoteBtn');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="ti ti-loader-2 me-1 spinner-border spinner-border-sm"></i>Actualizando...';

        try {
            const response = await fetch(`/api/quotes/${quoteId}`, {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (result.success) {
                // Si se marcó "Guardar cliente en el sistema", crear el lead guest como cliente.
                const clientSaved = await maybeSaveLeadGuestAsClient();
                showAlert('quoteInformationAlerts', `${QE} actualizada exitosamente${clientSaved ? ' · Cliente guardado en el sistema' : ''}`, 'success');

                // Redirect to quote detail page with services section (use appropriate dashboard path)
                const dashboardPathMap = { department_manager: '/dashboard/department_manager', client: '/dashboard/client' };
                const dashboardPath = dashboardPathMap[userRole] || '/dashboard/admin';
                setTimeout(() => {
                    // Preserve the reservation context so the header keeps reading
                    // "Reservación" (not "Cotización") after auto-advancing.
                    const resCtx = window.__isReservation ? '&context=reservation' : '';
                    window.location.href = `${dashboardPath}/quotes/${quoteId}?section=services${resCtx}`;
                }, 1500);
            } else {
                showAlert('quoteInformationAlerts', result.error || `Error al actualizar la ${Qe}`, 'danger');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        } catch (error) {
            console.error('Error updating quote:', error);
            showAlert('quoteInformationAlerts', `Error de conexión al actualizar la ${Qe}`, 'danger');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }

    // Create quote
    async function createQuote(event) {
        event.preventDefault();

        // Defensive check - if quote already exists, update instead
        const quoteIdField = document.getElementById('quoteId');
        const existingQuoteId = quoteIdField?.value;
        
        if (existingQuoteId && existingQuoteId.trim() !== '' && existingQuoteId !== 'new') {
            console.warn('createQuote() called but quote already exists, calling updateQuote instead:', existingQuoteId);
            return updateQuote(existingQuoteId, event);
        }

        const form = document.getElementById('quoteInformationForm');

        // Trigger phone validation before form validation
        const phoneInput = document.getElementById('contactPhone');
        if (phoneInput) {
            // Trigger blur to ensure phone validation runs
            phoneInput.dispatchEvent(new Event('blur'));
        }

        // Validate form
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return;
        }

        clearAlerts('quoteInformationAlerts');

        // Get client ID based on current mode
        let clientId;
        if (currentClientType === 'direct' && (userRole === 'admin' || userRole === 'superadmin')) {
            // For direct clients, use the directClientId field
            const directClientTS = await waitForTomSelect('directClientId');
            clientId = directClientTS.getValue();
            
            if (!clientId) {
                showAlert('quoteInformationAlerts', 'Por favor selecciona un cliente directo', 'danger');
                return;
            }
        } else {
            // For agencies, use the regular clientId field
            const clientTS = await waitForTomSelect('clientId');
            clientId = clientTS.getValue();
            
            if (!clientId) {
                showAlert('quoteInformationAlerts', 'Por favor selecciona un cliente', 'danger');
                return;
            }
        }

        // Cliente Final: existente (id), typed-guardado (crea cliente → id) o typed-libre (texto).
        const cfSel = await resolveClientFinalForSave();

        // Get form data — contacto = propietario por defecto (ver resolveContactValues).
        const contactVals = resolveContactValues();
        const { firstName, lastName, contactEmail, contactPhone } = contactVals;
        const contactPerson = [firstName, lastName].filter(n => n).join(' ') || undefined;

        const formData = {
            clientId: clientId,
            eventType: document.getElementById('eventType').value.trim() || undefined,
            numberOfPeople: document.getElementById('numberOfPeople').value ? parseInt(document.getElementById('numberOfPeople').value, 10) : undefined,
            numberOfAdults: parseInt(document.getElementById('numberOfAdults').value || 0),
            numberOfChildren: parseInt(document.getElementById('numberOfChildren').value || 0),
            numberOfInfants: parseInt(document.getElementById('numberOfInfants').value || 0),
            preferredLanguage: document.getElementById('preferredLanguage').value || 'es',
            contactPerson: contactPerson,
            contactFirstName: firstName || undefined,
            contactLastName: lastName || undefined,
            contactEmail: contactEmail || undefined,
            contactPhone: contactPhone || undefined,
            leadGuestFirstName: document.getElementById('leadGuestFirstName')?.value.trim() || undefined,
            leadGuestLastName: document.getElementById('leadGuestLastName')?.value.trim() || undefined,
            notes: document.getElementById('notes').value.trim() || undefined
        };

        // clientFinalId o clientFinalName (excluyentes; se envía el otro vacío para limpiar).
        formData.clientFinalId = cfSel.clientFinalId || '';
        formData.clientFinalName = cfSel.clientFinalName || '';
        
        // Include clientType for admin users creating direct client quotes
        if (userRole === 'admin' || userRole === 'superadmin') {
            const directRadio = document.getElementById('clientTypeDirect');
            if (directRadio && directRadio.checked) {
                formData.clientType = 'direct';
            }
        }

        // Debug: Log the form data being sent
        console.log('🚀 Creating quote with form data:', {
            clientId: formData.clientId,
            clientType: formData.clientType,
            currentClientType: currentClientType,
            isDirectMode: currentClientType === 'direct',
            fullFormData: formData
        });

        // Disable submit button
        const submitBtn = document.getElementById('createQuoteBtn');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="ti ti-loader-2 me-1 spinner-border spinner-border-sm"></i>Creando...';

        try {
            const response = await fetch('/api/quotes', {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (result.success && result.data) {
                // Si se marcó "Guardar cliente en el sistema", crear el lead guest como cliente.
                const clientSaved = await maybeSaveLeadGuestAsClient();
                showAlert('quoteInformationAlerts', `${result.message || 'Cotización creada exitosamente'}${clientSaved ? ' · Cliente guardado en el sistema' : ''}`, 'success');

                // Redirect to quote detail page with services section (use appropriate dashboard path)
                const dashboardPathMap = { department_manager: '/dashboard/department_manager', client: '/dashboard/client' };
                const dashboardPath = dashboardPathMap[userRole] || '/dashboard/admin';
                setTimeout(() => {
                    // A freshly created quote is always a "Cotización", but preserve the
                    // context if somehow set so the header label stays consistent.
                    const resCtx = window.__isReservation ? '&context=reservation' : '';
                    window.location.href = `${dashboardPath}/quotes/${result.data.id}?section=services${resCtx}`;
                }, 1500);
            } else {
                showAlert('quoteInformationAlerts', result.error || 'Error al crear la cotización', 'danger');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        } catch (error) {
            console.error('Error creating quote:', error);
            showAlert('quoteInformationAlerts', 'Error de conexión al crear la cotización', 'danger');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }

    // Handle client type selector changes (for admin users)
    function setupClientTypeSelector(isEditMode = false) {
        const agencyRadio = document.getElementById('clientTypeAgency');
        const directRadio = document.getElementById('clientTypeDirect');
        
        if (!agencyRadio || !directRadio) {
            // Not an admin user, no selector present
            return;
        }
        
        // If editing existing quote, disable the selector
        if (isEditMode) {
            agencyRadio.disabled = true;
            directRadio.disabled = true;
            
            // Add help text explaining why it's disabled
            const selectorGroup = agencyRadio.closest('.btn-group');
            if (selectorGroup) {
                // Check if help text already exists
                let helpText = selectorGroup.parentElement.querySelector('.client-type-disabled-help');
                if (!helpText) {
                    helpText = document.createElement('small');
                    helpText.className = 'text-muted d-block mt-1 client-type-disabled-help';
                    helpText.innerHTML = `<i class="ti ti-info-circle me-1"></i>El tipo de cliente no se puede cambiar después de crear la ${Qe}`;
                    selectorGroup.parentElement.appendChild(helpText);
                }
            }
            
            // Style the labels to look disabled
            const labels = selectorGroup?.querySelectorAll('label');
            labels?.forEach(label => {
                label.style.opacity = '0.6';
                label.style.cursor = 'not-allowed';
            });
        }
        
        // Handle radio button changes
        [agencyRadio, directRadio].forEach(radio => {
            radio.addEventListener('change', async (e) => {
                if (!e.target.checked) return;
                
                const newType = e.target.value;
                if (newType === currentClientType) return; // No change
                
                currentClientType = newType;
                
                // Update help text visibility
                document.querySelectorAll('.client-type-agency').forEach(el => {
                    el.style.display = newType === 'agency' ? 'inline' : 'none';
                });
                document.querySelectorAll('.client-type-direct').forEach(el => {
                    el.style.display = newType === 'direct' ? 'inline' : 'none';
                });
                
                // Show/hide appropriate rows
                const agencyClientRow = document.getElementById('agencyClientRow');
                const directClientRow = document.getElementById('directClientRow');
                const finalClientRow = document.getElementById('finalClientRow');
                
                if (newType === 'direct') {
                    // Hide agency client row, show direct client row
                    agencyClientRow.style.display = 'none';
                    directClientRow.style.display = 'flex';
                    finalClientRow.style.display = 'none';

                    // Reset the category sub-filter to "Todos" when entering direct mode
                    currentDirectClientCategory = '';
                    const allCategoryRadio = document.getElementById('directCategoryAll');
                    if (allCategoryRadio) {
                        allCategoryRadio.checked = true;
                    }

                    // Make clientId not required, directClientId required
                    const clientSelect = document.getElementById('clientId');
                    if (clientSelect) {
                        clientSelect.removeAttribute('required');
                        const clientWrapper = clientSelect.closest('.mb-3');
                        if (clientWrapper) {
                            const label = clientWrapper.querySelector('label');
                            if (label) {
                                label.innerHTML = label.innerHTML.replace(' <span class="text-danger">*</span>', '');
                            }
                        }
                    }
                    
                    // Clear and load direct clients
                    try {
                        const directClientTS = await waitForTomSelect('directClientId');
                        if (directClientTS.clear) {
                            directClientTS.clear();
                        } else if (directClientTS.setValue) {
                            directClientTS.setValue('');
                        }
                        directClientTS.clearOptions();
                        
                        // Load direct Amexing clients
                        await loadDirectClients('', 1);
                    } catch (e) {
                        console.log('Direct client dropdown not ready:', e);
                    }
                    
                } else {
                    // Show agency client row, hide direct client row
                    agencyClientRow.style.display = 'flex';
                    directClientRow.style.display = 'none';
                    finalClientRow.style.display = 'flex';
                    
                    // Make clientId required again
                    const clientSelect = document.getElementById('clientId');
                    if (clientSelect) {
                        clientSelect.setAttribute('required', 'required');
                        const clientWrapper = clientSelect.closest('.mb-3');
                        if (clientWrapper) {
                            const label = clientWrapper.querySelector('label');
                            if (label && !label.innerHTML.includes('text-danger')) {
                                label.innerHTML = label.innerHTML.replace('Cliente', 'Cliente <span class="text-danger">*</span>');
                            }
                        }
                    }
                    
                    // Clear and reload agency clients
                    try {
                        const clientTS = await waitForTomSelect('clientId');
                        if (clientTS.clear) {
                            clientTS.clear();
                        } else if (clientTS.setValue) {
                            clientTS.setValue('');
                        }
                        clientTS.clearOptions();
                    
                        // Clear sub-clients too
                        try {
                            const employeeTS = await waitForTomSelect('clientFinalId');
                            if (employeeTS.clear) {
                                employeeTS.clear();
                            } else if (employeeTS.setValue) {
                                employeeTS.setValue('');
                            }
                            employeeTS.clearOptions();
                        } catch (e) {
                            // Sub-client dropdown might not be initialized
                        }
                        
                        // Load agency clients
                        await loadActiveClients('', 1, 'agency');
                    } catch (e) {
                        console.log('Client dropdown not ready:', e);
                    }
                }
                
                // Clear contact fields
                document.getElementById('contactFirstName').value = '';
                document.getElementById('contactLastName').value = '';
                document.getElementById('contactEmail').value = '';
                document.getElementById('contactPhone').value = '';
                
                // Reset preferred language to default
                const languageSelect = document.getElementById('preferredLanguage');
                if (languageSelect) {
                    languageSelect.value = 'es';
                }

                // Al cambiar agencia/directo cambia dónde se guardará el cliente del Lead Guest.
                if (typeof updateSaveClientNote === 'function') updateSaveClientNote();
            });
        });

        // Handle direct-client category sub-filter changes: re-filter the
        // directClientId picker by clientCategory without touching submission.
        document.querySelectorAll('input[name="directClientCategory"]').forEach(radio => {
            radio.addEventListener('change', async (e) => {
                if (!e.target.checked) return;

                const newCategory = e.target.value;
                if (newCategory === currentDirectClientCategory) return;

                currentDirectClientCategory = newCategory;

                try {
                    const directClientTS = await waitForTomSelect('directClientId');
                    if (directClientTS.clear) {
                        directClientTS.clear();
                    } else if (directClientTS.setValue) {
                        directClientTS.setValue('');
                    }
                    directClientTS.clearOptions();

                    // Reload the picker filtered by the selected category
                    await loadDirectClients('', 1, newCategory);
                } catch (err) {
                    console.log('Direct client dropdown not ready for category filter:', err);
                }
            });
        });
    }

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', async function() {
        // Show loader immediately
        showPageLoader('quoteInformationCard');

        try {
            // Small delay to ensure Tom Select can initialize
            await new Promise(resolve => setTimeout(resolve, 200));
            
            // Check if we're in edit mode first
            const quoteIdInput = document.getElementById('quoteId');
            const quoteId = quoteIdInput ? quoteIdInput.value : '';
            const isEditMode = quoteId && quoteId !== '' && quoteId !== 'new';
            
            // Setup client type selector for admin users (pass edit mode flag)
            setupClientTypeSelector(isEditMode);
            
            // Load active clients for all users (different endpoints based on role)
            await loadActiveClients();
            
            // Setup client selection handler for all users
            await handleClientSelection();
            
            // Setup direct client selection handler
            await handleDirectClientSelection();
            
            // Setup employee selection handler
            await handleEmployeeSelection();

            // If edit mode, load quote data
            if (isEditMode) {
                await loadQuoteData(quoteId);
                
                // After loading quote data, also set current user as client for restricted roles
                if (userRole === 'department_manager' || userRole === 'client') {
                    console.log('🔧 EDIT MODE - Ensuring client dropdown shows enterprise name for restricted role:', userRole);
                    await loadCurrentUserAsClient();
                    
                    // Ensure finalClientRow is visible for restricted roles in edit mode
                    const finalClientRow = document.getElementById('finalClientRow');
                    if (finalClientRow) {
                        finalClientRow.style.display = 'flex';
                    }
                }
            } else if (userRole === 'department_manager' || userRole === 'client') {
                // For new quotes, ensure clientId is populated for these roles
                await loadCurrentUserAsClient();
            }

            // Ensure finalClientRow is visible for department_manager and client roles
            if (userRole === 'department_manager' || userRole === 'client') {
                const finalClientRow = document.getElementById('finalClientRow');
                if (finalClientRow) {
                    finalClientRow.style.display = 'flex';
                }
            }

            // Auto-sum people fields into hidden numberOfPeople
            document.querySelectorAll('.quote-people-input').forEach(input => {
                input.addEventListener('change', () => {
                    const adults = parseInt(document.getElementById('numberOfAdults').value || 0);
                    const children = parseInt(document.getElementById('numberOfChildren').value || 0);
                    const infants = parseInt(document.getElementById('numberOfInfants').value || 0);
                    document.getElementById('numberOfPeople').value = adults + children + infants;
                });
            });

            // Event listeners for quick client buttons (all users who have the button)
            const createBtn = document.getElementById('createQuickClientBtn');
            const saveBtn = document.getElementById('saveQuickClientBtn');
            
            if (createBtn) {
                createBtn.addEventListener('click', openQuickClientModal);
            }
            if (saveBtn) {
                saveBtn.addEventListener('click', saveQuickClient);
            }
            
            // Event listeners for direct client buttons
            const createDirectBtn = document.getElementById('createQuickDirectClientBtn');
            const saveDirectBtn = document.getElementById('saveQuickDirectClientBtn');
            
            if (createDirectBtn) {
                createDirectBtn.addEventListener('click', openQuickDirectClientModal);
            }
            if (saveDirectBtn) {
                saveDirectBtn.addEventListener('click', saveQuickDirectClient);
            }
            
            // Event listeners for final client button (role-based behavior)
            const createFinalBtn = document.getElementById('createFinalClientBtn');
            const saveOwnedBtn = document.getElementById('saveOwnedClientBtn');
            
            if (createFinalBtn) {
                createFinalBtn.addEventListener('click', function() {
                    // Check user role to determine which modal to open
                    const userRole = window.currentUserRole || '<%= userRole %>';
                    
                    if (userRole === 'admin' || userRole === 'superadmin') {
                        // Admin/SuperAdmin: Open admin sub-client modal (creates sub-clients for selected enterprise)
                        openAdminSubClientModal();
                    } else if (userRole === 'department_manager' || userRole === 'client') {
                        // Department Manager/Client: Open owned client modal (creates sub-clients for their own organization)
                        openOwnedClientModal();
                    }
                });
            }
            
            if (saveOwnedBtn) {
                saveOwnedBtn.addEventListener('click', saveOwnedClient);
            }
            
            // Event listeners for admin sub-client button
            const saveAdminSubBtn = document.getElementById('saveAdminSubClientBtn');
            if (saveAdminSubBtn) {
                saveAdminSubBtn.addEventListener('click', saveAdminSubClient);
            }

            // Form submission - use appropriate function based on current state
            document.getElementById('quoteInformationForm').addEventListener('submit', function(event) {
                // Check current quote ID dynamically (not just initial page load state)
                const quoteIdField = document.getElementById('quoteId');
                const currentQuoteId = quoteIdField?.value;
                const hasExistingQuote = currentQuoteId && currentQuoteId.trim() !== '' && currentQuoteId !== 'new';
                
                if (hasExistingQuote) {
                    console.log('Form submission: Updating existing quote', currentQuoteId);
                    updateQuote(currentQuoteId, event);
                } else {
                    console.log('Form submission: Creating new quote');
                    createQuote(event);
                }
            });

            // Hide loader after everything is loaded
            hidePageLoader('quoteInformationCard');
        } catch (error) {
            console.error('Error initializing quote information form:', error);
            showAlert('quoteInformationAlerts', 'Error al inicializar el formulario', 'danger');

            // Hide loader even if there's an error
            hidePageLoader('quoteInformationCard');
        }
    });
})();
</script>
