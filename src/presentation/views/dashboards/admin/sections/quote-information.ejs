    let currentClientType = 'agency';
    // Track the active direct-client category sub-filter ('' = all categories)
    let currentDirectClientCategory = '';

    // Load direct Amexing clients into the direct client dropdown
    window.loadDirectClients = async function loadDirectClients(searchTerm = '', page = 1, clientCategory = currentDirectClientCategory) {
        try {
            const endpoint = '/api/clients/amexing-direct';

            // Build query parameters
            const params = new URLSearchParams();
            if (searchTerm) params.append('search', searchTerm);
            if (clientCategory) params.append('clientCategory', clientCategory);
            params.append('page', page.toString());
            params.append('limit', '100');
            
            const url = `${endpoint}${params.toString() ? '?' + params.toString() : ''}`;
            
            const response = await fetch(url, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();
            
            if (result.success && result.data) {
                const directClientTS = await waitForTomSelect('directClientId');
                
                if (page === 1) {
                    directClientTS.clearOptions();
                }
                
                const clients = result.data.clients || result.data;
                
                // Add client options
                clients.forEach(client => {
                    directClientTS.addOption({
                        value: client.value,
                        text: client.label,
                        email: client.email,
                        contactPerson: client.contactPerson,
                        phone: client.phone,
                        firstName: client.firstName,
                        lastName: client.lastName,
                        companyName: client.companyName,
                        preferredLanguage: client.preferredLanguage
                    });
                });
                
                directClientTS.refreshOptions(false);
                
                return {
                    hasMore: result.data.pagination?.hasMore || false,
                    total: result.data.pagination?.total || clients.length
                };
            } else {
                console.error('No direct client data or API error:', result);
                return { hasMore: false, total: 0 };
            }
        } catch (error) {
            console.error('Error loading direct clients:', error);
            showAlert('quoteInformationAlerts', 'Error al cargar clientes directos', 'danger');
            return { hasMore: false, total: 0 };
        }
    }
    
    // Load active clients for Tom Select with optional search
    // Make this function globally available for the custom dropdown component
    window.loadActiveClients = async function loadActiveClients(searchTerm = '', page = 1, clientType = null) {
        // Skip loading clients for department_manager and client roles (they don't see the dropdown)
        if (userRole === 'department_manager' || userRole === 'client') {
            return;
        }
        
        // Use provided clientType or fall back to current selection
        const typeToLoad = clientType || currentClientType;
        
        try {
            // Choose endpoint based on client type
            const endpoint = typeToLoad === 'direct' ? '/api/clients/amexing-direct' : '/api/clients/active';
            
            // Build query parameters
            const params = new URLSearchParams();
            if (searchTerm) params.append('search', searchTerm);
            params.append('page', page.toString());
            params.append('limit', '100'); // Get 100 results per search
            
            const url = `${endpoint}${params.toString() ? '?' + params.toString() : ''}`;
            
            const response = await fetch(url, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();
            
            console.log('🌐 API Response from /api/clients/active:', {
                success: result.success,
                dataStructure: result.data ? Object.keys(result.data) : null,
                clientsCount: result.data?.clients?.length || result.data?.length || 0,
                firstClient: result.data?.clients?.[0] || result.data?.[0] || null
            });

            if (result.success && result.data) {
                const clientTS = await waitForTomSelect('clientId');

                // For server-side search, clear options only on new search (page 1)
                if (page === 1) {
                    clientTS.clearOptions();
                }

                // Handle different response formats
                const clients = result.data.clients || result.data;
                
                console.log('📦 Clients array to process:', {
                    count: clients.length,
                    sample: clients.slice(0, 3).map(c => ({
                        label: c.label,
                        value: c.value,
                        email: c.email
                    }))
                });
                
                // Add client options
                // Agency mode dedupe: the API returns one row per department-manager USER,
                // so multiple managers of the same agency produce duplicates. Keep the first
                // user with a given companyName as the agency's representative. Also skip
                // managers without a companyName entirely — those are personal/test accounts
                // that shouldn't pollute the agency dropdown.
                const seenCompanyNames = new Set();
                clients.forEach(client => {
                    console.log('🔍 Processing client for dropdown:', {
                        raw: client,
                        label: client.label,
                        value: client.value,
                        contactPerson: client.contactPerson,
                        companyName: client.companyName
                    });

                    // Display logic:
                    // - Agencies → ALWAYS show the company name (admins want to see the
                    //   agency / enterprise, never the department manager's personal name).
                    //   Falls back to the legacy "Name (Company)" parse if companyName
                    //   isn't on the payload (e.g. older API responses).
                    // - Direct clients → keep current parse (company-in-parens preferred).
                    let displayText = client.label;
                    const parenthesesMatch = client.label.match(/^(.+?)\s*\(([^)]+)\)$/);

                    if (typeToLoad === 'agency') {
                        // Resolve a companyName from any of the sources we have.
                        let resolvedCompany = '';
                        if (client.companyName && client.companyName.trim()) {
                            resolvedCompany = client.companyName.trim();
                        } else if (parenthesesMatch && parenthesesMatch[2]) {
                            resolvedCompany = parenthesesMatch[2].trim();
                        }

                        if (!resolvedCompany) {
                            // Skip agency rows that have no company — they're department
                            // managers without an assigned agency.
                            console.warn('⚠️ Agency without companyName — skipping option:', client.label);
                            return;
                        }

                        // Dedupe: case-insensitive comparison so "Acme" and "ACME" collapse.
                        const key = resolvedCompany.toLowerCase();
                        if (seenCompanyNames.has(key)) {
                            console.log('🧹 Agency dedupe: skipping duplicate of', resolvedCompany);
                            return;
                        }
                        seenCompanyNames.add(key);

                        displayText = resolvedCompany;
                        console.log('✅ Agency: using companyName:', displayText);
                    } else if (parenthesesMatch && parenthesesMatch[2]) {
                        displayText = parenthesesMatch[2];
                        console.log('✅ Direct: using company name from parentheses:', displayText);
                    } else if (!client.label.includes('(')) {
                        displayText = client.label;
                        console.log('ℹ️ Direct: no parentheses, using label as-is:', displayText);
                    }

                    console.log('📋 Final display text for client:', {
                        clientId: client.value,
                        displayText: displayText,
                        originalLabel: client.label,
                        typeToLoad
                    });

                    clientTS.addOption({
                        value: client.value,
                        text: displayText,
                        email: client.email,
                        contactPerson: client.contactPerson,
                        phone: client.phone,
                        companyName: client.companyName
                    });
                });

                // Refresh to apply changes
                clientTS.refreshOptions(false);
                
                // Return pagination info for possible future use
                return {
                    hasMore: result.data.pagination?.hasMore || false,
                    total: result.data.pagination?.total || clients.length
                };
            } else {
                console.error('No client data or API error:', result);
                return { hasMore: false, total: 0 };
            }
        } catch (error) {
            console.error('Error loading clients:', error);
            showAlert('quoteInformationAlerts', 'Error al cargar la lista de clientes', 'danger');
            return { hasMore: false, total: 0 };
        }
    }

    // Load sub-clients (final clients) when a client is selected
    async function loadClientEmployees(clientId, selectedClientFinalId = null) {
        try {
            console.log('🔍 loadClientEmployees called with clientId:', clientId, 'selectedClientFinalId:', selectedClientFinalId);
            
            if (!clientId) {
                // Clear sub-client dropdown if no client selected
                const employeeTS = await waitForTomSelect('clientFinalId');
                employeeTS.clearOptions();
                employeeTS.addOption({ value: '', text: 'No hay clientes disponibles' });
                employeeTS.setValue('');
                return;
            }

            // Fetch sub-clients for this client
            const apiUrl = `/api/clients/${clientId}/sub-clients`;
            console.log('📡 Fetching sub-clients from:', apiUrl);
            
            const response = await fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                }
            });

            console.log('📥 Response received:', {
                ok: response.ok,
                status: response.status,
                statusText: response.statusText,
                url: response.url,
                headers: Object.fromEntries(response.headers.entries())
            });

            const result = await response.json();
            
            console.log('📊 Result data:', {
                success: result.success,
                error: result.error,
                message: result.message,
                dataStructure: result.data,
                clientsCount: result.data?.clients?.length || 0,
                clients: result.data?.clients || []
            });

            if (result.success && result.data?.clients && result.data.clients.length > 0) {
                const employeeTS = await waitForTomSelect('clientFinalId');
                employeeTS.clearOptions();
                
                // Add empty option first
                employeeTS.addOption({ value: '', text: 'Seleccionar cliente final (opcional)' });

                // Recolecta las mismas opciones para alimentar el combobox de Lead Guest (agencia).
                const leadGuestOpts = [];

                // Add sub-client options
                result.data.clients.forEach(client => {
                    // Build display name - prioritize company name, then contact person, then constructed name
                    let displayName = client.companyName || 
                                     client.name || 
                                     client.contactPerson ||
                                     `${client.firstName || ''} ${client.lastName || ''}`.trim() || 
                                     client.email;
                    
                    // Ensure firstName and lastName are properly extracted
                    let firstName = client.firstName || '';
                    let lastName = client.lastName || '';
                    
                    // If no separate firstName/lastName, try to extract from name or contactPerson
                    if (!firstName && !lastName) {
                        const nameToSplit = client.name || client.contactPerson || '';
                        if (nameToSplit) {
                            const nameParts = nameToSplit.trim().split(/\s+/);
                            if (nameParts.length === 1) {
                                firstName = nameParts[0];
                            } else if (nameParts.length === 2) {
                                firstName = nameParts[0];
                                lastName = nameParts[1];
                            } else if (nameParts.length > 2) {
                                firstName = nameParts[0];
                                lastName = nameParts.slice(1).join(' ');
                            }
                        }
                    }
                    
                    console.log('🔍 Adding Cliente Final option:', {
                        clientId: client.id,
                        displayName,
                        firstName,
                        lastName,
                        originalData: client
                    });
                    
                    const cfOpt = {
                        value: client.id,
                        text: displayName,
                        email: client.email,
                        contactPerson: client.contactPerson || displayName,
                        firstName: firstName,
                        lastName: lastName,
                        phone: client.phone || '',
                        companyName: client.companyName || '',
                        preferredLanguage: client.preferredLanguage || 'es'
                    };
                    employeeTS.addOption(cfOpt);
                    leadGuestOpts.push(cfOpt);
                });

                employeeTS.refreshOptions(false);
                // Mismo listado para el combobox de Lead Guest (modo agencia).
                populateLeadGuestOptions(leadGuestOpts);
                
                // If a specific clientFinalId was provided, set it now
                if (selectedClientFinalId) {
                    // Check if the option exists and set it
                    const optionExists = employeeTS.getOption && employeeTS.getOption(selectedClientFinalId);

                    if (optionExists) {
                        // Deriva "El Lead Guest es el cliente final" comparando el Lead Guest GUARDADO
                        // con el cliente final. Se pone el checkbox en false ANTES del setValue para que
                        // el auto-llenado no pise el Lead Guest guardado durante la carga.
                        const lgCb = document.getElementById('leadGuestIsFinalClient');
                        if (lgCb) lgCb.checked = false;
                        employeeTS.setValue(selectedClientFinalId);
                        if (lgCb) {
                            const opt = getFinalClientOptionByValue(selectedClientFinalId) || {};
                            const norm = (s) => (s || '').trim().toLowerCase();
                            const lgFirst = norm(document.getElementById('leadGuestFirstName')?.value);
                            const lgLast = norm(document.getElementById('leadGuestLastName')?.value);
                            const noLeadGuest = !lgFirst && !lgLast;
                            // Marcado solo si no hay Lead Guest capturado, o si coincide con el cliente final.
                            lgCb.checked = noLeadGuest || (lgFirst === norm(opt.firstName) && lgLast === norm(opt.lastName));
                            if (typeof syncLeadGuestMode === 'function') syncLeadGuestMode();
                        }
                    } else {
                        console.warn('⚠️ Cliente Final option not found:', selectedClientFinalId);
                    }
                }
            } else {
                // No sub-clients found
                console.log('⚠️ No sub-clients condition triggered:', {
                    success: result.success,
                    hasData: !!result.data,
                    hasClients: !!result.data?.clients,
                    clientsLength: result.data?.clients?.length,
                    error: result.error,
                    message: result.message,
                    fullResult: result
                });
                
                const employeeTS = await waitForTomSelect('clientFinalId');
                employeeTS.clearOptions();
                employeeTS.addOption({ value: '', text: 'No hay clientes disponibles' });
                employeeTS.setValue('');
            }
        } catch (error) {
            console.error('❌ Error loading sub-clients - Full details:', {
                error: error,
                message: error.message,
                stack: error.stack,
                clientId: clientId,
                errorType: error.constructor.name
            });
            // Clear dropdown on error
            try {
                const employeeTS = await waitForTomSelect('clientFinalId');
                employeeTS.clearOptions();
                employeeTS.addOption({ value: '', text: 'Error al cargar clientes' });
                employeeTS.setValue('');
            } catch (e) {
                console.error('Error clearing sub-client dropdown:', e);
            }
        }
    }

    // Handle direct client selection for auto-fill
    async function handleDirectClientSelection() {
        try {
            const directClientInput = document.getElementById('directClientId');
            if (!directClientInput) {
                console.log('Direct client input not found');
                return;
            }
            
            directClientInput.addEventListener('change', async function(event) {
                console.log('🔄 Direct Client selection changed:', event.target.value);
                const value = event.target.value;
                
                if (value) {
                    try {
                        // Get the option data using dual approach like Cliente Final
                        const directClientInput = document.getElementById('directClientId');
                        let option = null;
                        
                        // First try the customSelect property (preferred method)
                        if (directClientInput.customSelect) {
                            console.log('📊 Using customSelect property for direct client');
                            option = directClientInput.customSelect.getOption(value);
                        }
                        
                        // If that didn't work, try waitForTomSelect (fallback)
                        if (!option) {
                            console.log('📊 Using waitForTomSelect fallback for direct client');
                            const directClientTS = await waitForTomSelect('directClientId');
                            console.log('📋 Direct client TomSelect instance:', directClientTS);
                            option = directClientTS.options ? directClientTS.options[value] : null;
                        }
                        
                        console.log('🎯 Direct client option data:', option);
                        
                        if (option) {
                            // Use direct firstName/lastName if available, otherwise parse contactPerson
                            let firstName = option.firstName || '';
                            let lastName = option.lastName || '';
                            
                            // Fallback to parsing contactPerson if firstName/lastName not available
                            if (!firstName && !lastName && option.contactPerson) {
                                const nameParts = option.contactPerson.trim().split(/\s+/);
                                if (nameParts.length === 1) {
                                    firstName = nameParts[0];
                                } else if (nameParts.length >= 2) {
                                    firstName = nameParts[0];
                                    lastName = nameParts.slice(1).join(' ');
                                }
                            }
                            
                            // Auto-fill contact fields
                            document.getElementById('contactFirstName').value = firstName;
                            document.getElementById('contactLastName').value = lastName;
                            document.getElementById('contactEmail').value = option.email || '';
                            
                            // Strip country code from phone if present
                            let phoneNumber = option.phone || '';
                            if (phoneNumber.startsWith('52') && phoneNumber.length > 10) {
                                phoneNumber = phoneNumber.substring(2);
                            } else if (phoneNumber.startsWith('1') && phoneNumber.length === 11) {
                                phoneNumber = phoneNumber.substring(1);
                            }
                            document.getElementById('contactPhone').value = phoneNumber;
                            
                            // Auto-fill preferred language
                            const languageSelect = document.getElementById('preferredLanguage');
                            if (languageSelect && option.preferredLanguage) {
                                languageSelect.value = option.preferredLanguage;
                                console.log('✅ Language preference set to:', option.preferredLanguage);
                            }
                            
                            console.log('✅ Direct client contact fields auto-filled successfully');
                        } else {
                            console.warn('⚠️ Direct client option not found for value:', value);
                        }
                    } catch (error) {
                        console.error('Error getting direct client data:', error);
                    }
                } else {
                    // Clear contact fields when no client selected
                    document.getElementById('contactFirstName').value = '';
                    document.getElementById('contactLastName').value = '';
                    document.getElementById('contactEmail').value = '';
                    document.getElementById('contactPhone').value = '';
                    
                    // Reset preferred language to default
                    const languageSelect = document.getElementById('preferredLanguage');
                    if (languageSelect) {
                        languageSelect.value = 'es';
                    }
                }
            });
        } catch (error) {
            console.error('Error setting up direct client selection handler:', error);
        }
    }
    
