    // Resuelve el Cliente Final para el payload. { clientFinalId, clientFinalName }.
    // Typed-new + "guardar como cliente" marcado → crea el cliente (y setea su id en el combobox).
    async function resolveClientFinalForSave() {
        const el = document.getElementById('clientFinalId');
        const inst = el && el.customSelect;
        if (!inst) return { clientFinalId: (el && el.value) || '', clientFinalName: '' };
        const typed = inst.isTyped && inst.isTyped();
        if (!typed) return { clientFinalId: inst.getValue() || '', clientFinalName: '' };
        const text = (inst.getTypedText && inst.getTypedText()) || '';
        const saveCb = document.getElementById('saveFinalClientAsClient');
        if (saveCb && saveCb.checked && text) {
            const { firstName, lastName } = splitLeadName(text);
            if (firstName && lastName) {
                const asAgency = leadGuestSavesAsAgencyClient();
                const endpoint = asAgency ? '/api/owned-clients/admin-create-subclient' : '/api/owned-clients/quick';
                const payload = asAgency
                    ? { firstName, lastName, enterpriseId: document.getElementById('clientId')?.value || '' }
                    : { firstName, lastName };
                try {
                    const resp = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${getAccessToken()}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                    });
                    const result = await resp.json();
                    if (result && result.success && result.data) {
                        inst.addOption({
                            value: result.data.value, text: result.data.label,
                            email: result.data.email || '', contactPerson: result.data.contactPerson || result.data.label,
                            phone: result.data.phone || '', firstName, lastName,
                        });
                        inst.setValue(result.data.value);
                        saveCb.checked = false;
                        return { clientFinalId: result.data.value, clientFinalName: '' };
                    }
                } catch (err) { console.error('Error creando cliente final:', err); }
            }
        }
        return { clientFinalId: '', clientFinalName: text };
    }
    // Al marcar "El Lead Guest es el cliente final": el Lead Guest debe volverse el cliente final.
    // Si hay uno seleccionado y el Lead Guest actual DIFIERE, se confirma antes de reemplazar (si
    // cancelan, se desmarca). Sin cliente final → solo se muestra el resumen que pide seleccionar uno.
    document.getElementById('leadGuestIsFinalClient')?.addEventListener('change', async function () {
        const cb = this;
        if (cb.checked) {
            let opt = null;
            try {
                opt = getFinalClientOptionByValue(getSelectedFinalClientValue());
