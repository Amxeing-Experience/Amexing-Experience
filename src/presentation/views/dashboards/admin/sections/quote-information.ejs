<%
/**
 * Quote Information Section
 * Basic information form for quote creation/editing
 */
// Entity label: this view is reused for quotes and, once scheduled, reservations.
const __isRes = typeof isReservation !== 'undefined' && isReservation;
const E = __isRes ? 'Reservación' : 'Cotización';
const e = __isRes ? 'reservación' : 'cotización';
%>

<div class="card border-0 shadow-sm" id="quoteInformationCard">
    <!-- Page Loader -->
    <%- include('../../../atoms/common/page-loader', {
        text: `Cargando información de la ${e}...`,
        spinnerColor: 'primary',
        containerId: 'quoteInformationCard'
    }) %>

    <div class="card-header bg-white border-bottom">
        <h5 class="card-title mb-0">
            <i class="ti ti-info-circle me-2"></i>Información de la <%= (typeof isReservation !== 'undefined' && isReservation) ? 'Reservación' : 'Cotización' %>
        </h5>
    </div>

    <div class="card-body">
        <!-- Alerts Container -->
        <div id="quoteInformationAlerts"></div>

        <form id="quoteInformationForm" class="needs-validation" novalidate>
            <!-- Hidden field for quote ID (for editing) -->
            <input type="hidden" id="quoteId" name="quoteId" value="<%= typeof quoteId !== 'undefined' ? quoteId : '' %>">

            <!-- Sección: Información del Cliente -->
            <div class="border rounded p-3 mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="ti ti-user me-1"></i>
                    Información del Cliente
                </h6>

                <% 
                // Determine if dropdown should be disabled
                const isRestrictedRole = (typeof userRole !== 'undefined' && (userRole === 'department_manager' || userRole === 'client'));
                const isAdminRole = (typeof userRole !== 'undefined' && (userRole === 'admin' || userRole === 'superadmin'));
                const helpTextMessage = isRestrictedRole 
                    ? 'Cliente asignado automáticamente según tu rol' 
                    : 'Selecciona un cliente existente o crea uno nuevo';
                %>

                <% if (isAdminRole) { %>
                <!-- Client Type Selector - Only visible for admins -->
                <div class="mb-3">
                    <div class="btn-group w-100" role="group" aria-label="Tipo de cliente">
                        <input type="radio" class="btn-check" name="clientTypeSelector" id="clientTypeAgency" value="agency" checked>
                        <label class="btn btn-outline-primary" for="clientTypeAgency">
                            <i class="ti ti-building me-1"></i>Agencias
                        </label>
                        <input type="radio" class="btn-check" name="clientTypeSelector" id="clientTypeDirect" value="direct">
                        <label class="btn btn-outline-primary" for="clientTypeDirect">
                            <i class="ti ti-user-check me-1"></i>Clientes Directos
                        </label>
                    </div>
                </div>
                <% } %>

                <!-- Agency Client Selection (hidden for direct clients) -->
                <div class="row" id="agencyClientRow">
                    <div class="col-md-<%= isRestrictedRole ? '12' : '10' %>">
                        <!-- Client selection - disabled for department_manager/client roles -->
                        <%- include('../../../atoms/common/tom-select', {
                            id: 'clientId',
                            name: 'clientId',
                            multiple: false,
                            placeholder: 'Buscar cliente por nombre o empresa',
                            label: 'Cliente',
                            required: true,
                            helpText: helpTextMessage,
                            options: [],
                            selected: [],
                            disabled: isRestrictedRole
                        }) %>
                    </div>
                    <% if (!isRestrictedRole) { %>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button type="button" class="btn btn-outline-primary w-100 px-2 py-2" id="createQuickClientBtn">
                            <i class="ti ti-plus me-1"></i>Crear Cliente
                        </button>
                    </div>
                    <% } %>
                </div>
                
                <!-- Direct Client Selection (moved up when in direct mode) -->
                <div class="row" id="directClientRow" style="display: none;">
                    <!-- Category sub-filter: narrows the direct-client list by clientCategory -->
                    <div class="col-md-12 mb-2">
                        <style>
                            #directClientCategoryGroup { display: flex; flex-wrap: wrap; gap: .25rem; }
                            #directClientCategoryGroup .cat-chip { margin: 0; border: 0; background: transparent; border-radius: 999px;
                                padding: .35rem .85rem; font-size: .875rem; font-weight: 600; color: #7a7f70; cursor: pointer; transition: all .12s; }
                            #directClientCategoryGroup .cat-chip:hover { background: rgba(var(--bs-primary-rgb), .08); color: var(--bs-primary); }
                            #directClientCategoryGroup .btn-check:checked + .cat-chip { background: rgba(var(--bs-primary-rgb), .15); color: var(--bs-primary); }
                        </style>
                        <div role="group" aria-label="Categoría de cliente directo" id="directClientCategoryGroup">
                            <input type="radio" class="btn-check" name="directClientCategory" id="directCategoryAll" value="" checked>
                            <label class="cat-chip" for="directCategoryAll">Todos</label>
                            <input type="radio" class="btn-check" name="directClientCategory" id="directCategoryDirect" value="direct_client">
                            <label class="cat-chip" for="directCategoryDirect">Cliente Directo</label>
                            <input type="radio" class="btn-check" name="directClientCategory" id="directCategoryWedding" value="wedding_planner">
                            <label class="cat-chip" for="directCategoryWedding">Wedding Planner</label>
                            <input type="radio" class="btn-check" name="directClientCategory" id="directCategoryConcierge" value="concierge">
                            <label class="cat-chip" for="directCategoryConcierge">Concierge</label>
                            <input type="radio" class="btn-check" name="directClientCategory" id="directCategoryHomeOwner" value="home_owner">
                            <label class="cat-chip" for="directCategoryHomeOwner">Home Owner</label>
                        </div>
                    </div>
                    <div class="col-md-10">
                        <%- include('../../../atoms/common/tom-select', {
                            id: 'directClientId',
                            name: 'directClientId',
                            multiple: false,
                            placeholder: 'Buscar cliente directo de Amexing',
                            label: 'Cliente',
                            required: true,
                            helpText: '',
                            options: [],
                            selected: [],
                            disabled: false
                        }) %>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button type="button" class="btn btn-outline-primary w-100 px-2 py-2" id="createQuickDirectClientBtn">
                            <i class="ti ti-plus me-1"></i>Crear Cliente
                        </button>
                    </div>
                </div>
            </div>
                
            <!-- Sección: Propietario -->
            <div class="border rounded p-3 mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3 d-flex justify-content-between align-items-center">
                    <span><i class="ti ti-user me-1"></i>Propietario</span>
                    <button type="button" class="btn btn-sm btn-primary" id="btnManageCollaborators">
                        <i class="ti ti-user-plus me-1"></i>Compartir
                    </button>
                </h6>
                <div>
                    <div class="fw-medium" id="compactOwnerName">
                        <div class="placeholder-glow" id="ownerLoader">
                            <span class="placeholder col-6 placeholder-sm"></span>
                        </div>
                    </div>
                    <small class="text-muted" id="compactOwnerEmail">
                        <div class="placeholder-glow" id="ownerEmailLoader">
                            <span class="placeholder col-8 placeholder-xs"></span>
                        </div>
                    </small>
                </div>
            </div>

            <!-- Sección: Cliente Final (solo agencias; la tarjeta se togglea por modo vía #finalClientRow) -->
            <div class="border rounded p-3 mb-4 mt-4 flex-column" id="finalClientRow">
                <!-- Encabezado con acción "Crear Cliente" a la derecha. Cubre el caso de una
                     agencia SIN clientes finales (dropdown vacío): el listener #createFinalClientBtn
                     ya existe y abre el modal correcto según rol (admin → sub-cliente de empresa;
                     dept_manager/client → cliente propio), y al guardar lo agrega al dropdown y lo
                     selecciona. La tarjeta solo se muestra en modo agencia. -->
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h6 class="fw-bold text-primary mb-0">
                        <i class="ti ti-user-check me-1"></i>
                        Cliente Final
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="createFinalClientBtn">
                        <i class="ti ti-plus me-1"></i>Crear Cliente
                    </button>
                </div>
                <!-- Alertas locales de esta sección (p.ej. "selecciona una empresa antes de
                     crear un cliente final"), para que se vean junto al botón y no arriba del
                     formulario donde quedan fuera de vista. -->
                <div id="finalClientAlerts"></div>
                <div class="mb-2">
                    <%- include('../../../atoms/common/tom-select', {
                        id: 'clientFinalId',
                        name: 'clientFinalId',
                        multiple: false,
                        placeholder: 'Buscar o escribir cliente final',
                        label: '',
                        required: false,
                        allowCreate: true,
                        createLabel: 'Crear',
                        helpText: 'Elige un cliente de la agencia o escribe un nombre nuevo',
                        options: [],
                        selected: []
                    }) %>
                </div>
                <!-- Cliente Final tecleado (nuevo): opción de guardarlo como cliente de la agencia.
                     Oculto salvo cuando el CF es "typed-new" (evento customselect:create). -->
                <div class="form-check mb-2 d-none" id="saveFinalClientWrap">
                    <input class="form-check-input" type="checkbox" id="saveFinalClientAsClient">
                    <label class="form-check-label" for="saveFinalClientAsClient">
                        <i class="ti ti-user-plus me-1"></i>Guardar cliente en el sistema
                    </label>
                    <div class="form-text">Si no lo marcas, el nombre se usará solo en esta cotización.</div>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="leadGuestIsFinalClient">
                    <label class="form-check-label" for="leadGuestIsFinalClient">
                        El Lead Guest es el cliente final
                    </label>
                </div>
            </div>

            <!-- Sección: Lead Guest -->
            <div class="border rounded p-3 mb-4 mt-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="ti ti-user-star me-1"></i>
                    Lead Guest
                    <small class="text-muted fw-normal ms-1">(huésped principal)</small>
                </h6>

                <!-- Resumen cuando "es el cliente final" (oculto por defecto): quién es el Lead Guest -->
                <div id="leadGuestFinalSummary" class="d-none d-flex align-items-center border rounded bg-light py-2 px-3 mb-0" style="color:#495057;">
                    <i class="ti ti-user-star me-2 text-success"></i>
                    <small style="color:#495057;">El Lead Guest es el <strong>cliente final</strong>: <span id="leadGuestFinalSummaryText" class="fw-semibold" style="color:#212529;">—</span></small>
                </div>

                <!-- Lead Guest manual: se oculta cuando "es el cliente final" está marcado (agencia) -->
                <div id="leadGuestManualFields">
                    <!-- Modo AGENCIA: combobox (elegir cliente de la agencia o escribir uno nuevo).
                         Escribe en los inputs ocultos leadGuestFirstName/LastName (fuente de verdad
                         del payload). Se muestra solo en agencia (toggle por JS: syncLeadGuestNameUi). -->
                    <div class="d-none" id="leadGuestComboRow">
                        <%- include('../../../atoms/common/tom-select', {
                            id: 'leadGuestClientId',
                            name: 'leadGuestClientId',
                            multiple: false,
                            placeholder: 'Buscar o escribir Lead Guest',
                            label: '',
                            required: false,
                            allowCreate: true,
                            createLabel: 'Crear',
                            helpText: 'Elige un cliente de la agencia o escribe un nombre nuevo',
                            options: [],
                            selected: []
                        }) %>
                    </div>
                    <!-- Modo DIRECTO: nombre/apellido a mano (sin cambios). En agencia se oculta,
                         pero los inputs siguen siendo la fuente de verdad (los alimenta el combobox). -->
                    <div class="row" id="leadGuestNameRow">
                        <div class="col-md-6 mb-3">
                            <label for="leadGuestFirstName" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="leadGuestFirstName" name="leadGuestFirstName" placeholder="Nombre">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="leadGuestLastName" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="leadGuestLastName" name="leadGuestLastName" placeholder="Apellido">
                        </div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="saveLeadGuestAsClient">
                        <label class="form-check-label" for="saveLeadGuestAsClient">
                            <i class="ti ti-user-plus me-1"></i>Guardar cliente en el sistema<% if (typeof userRole !== 'undefined' && (userRole === 'admin' || userRole === 'superadmin')) { %> <span class="text-muted fw-normal" id="saveClientCategoryNote">(se guardará como cliente directo)</span><% } %>
                        </label>
                        <div class="form-text">Al guardar la cotización, se creará este cliente en el sistema para reutilizarlo.</div>
                        <% if (typeof userRole !== 'undefined' && (userRole === 'admin' || userRole === 'superadmin')) { %>
                        <!-- Categoría del cliente directo (solo admin, modo directo). En agencia se oculta. -->
                        <div class="mt-2 d-none" id="saveClientCategoryWrap" style="max-width: 260px;">
                            <label for="saveClientCategory" class="form-label small mb-1">Categoría del cliente</label>
                            <select class="form-select form-select-sm" id="saveClientCategory">
                                <option value="direct_client" selected>Cliente Directo</option>
                                <option value="wedding_planner">Wedding Planner</option>
                                <option value="concierge">Concierge</option>
                                <option value="home_owner">Home Owner</option>
                            </select>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Sección: Información de Contacto -->
            <div class="border rounded p-3 mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="ti ti-phone me-1"></i>
                    Información de Contacto
                </h6>

                <!-- Contacto = Lead Guest por defecto (id conserva el nombre viejo, pero la
                     semántica se INVIRTIÓ: marcado = el contacto es el propietario). -->
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="contactDifferentFromOwner">
                    <label class="form-check-label" for="contactDifferentFromOwner">
                        El contacto es el propietario de la cotización
                    </label>
                </div>

                <!-- Resumen cuando el contacto = propietario (oculto por defecto): se ve a quién se usará -->
                <div id="contactOwnerSummary" class="d-none d-flex align-items-center border rounded bg-light py-2 px-3 mb-0" style="color:#495057;">
                    <i class="ti ti-user-check me-2 text-success"></i>
                    <small style="color:#495057;">Se usará al <strong>propietario</strong> como contacto: <span id="contactOwnerSummaryText" class="fw-semibold" style="color:#212529;">—</span></small>
                </div>

                <!-- Campos de contacto (= Lead Guest): visibles por defecto; se ocultan si el contacto es el propietario -->
                <div id="contactFieldsWrapper">
                    <div class="alert alert-info d-flex align-items-start" role="alert">
                        <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                        <div>
                            <small>Esta información se autocompletará al seleccionar un cliente, pero puedes editarla para esta <%= e %> específica.</small>
                        </div>
                    </div>

                    <!-- Contact Name Fields -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="contactFirstName" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="contactFirstName" name="contactFirstName" placeholder="Nombre">
                            <div class="form-text">Nombre de la persona de contacto</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="contactLastName" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="contactLastName" name="contactLastName" placeholder="Apellido">
                            <div class="form-text">Apellido de la persona de contacto</div>
                        </div>
                    </div>

                    <!-- Contact Email and Phone -->
                    <div class="row">
                        <div class="col-md-6">
                            <%- include('../../../atoms/common/email-input', {
                                name: 'contactEmail',
                                id: 'contactEmail',
                                label: 'Email de Contacto',
                                required: false,
                                placeholder: 'email@ejemplo.com',
                                helpText: `Email para enviar la ${e}`,
                                containerClass: 'mb-3'
                            }) %>
                        </div>

                        <div class="col-md-6">
                            <%- include('../../../atoms/common/phone-input', {
                                name: 'contactPhone',
                                id: 'contactPhone',
                                label: 'Teléfono de Contacto',
                                required: false,
                                helpText: 'Teléfono de contacto directo',
                                countryCode: 'MX',
                                containerClass: 'mb-3'
                            }) %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección: Detalles del Evento -->
            <div class="border rounded p-3 mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="ti ti-calendar-event me-1"></i>
                    Detalles del Evento
                </h6>

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label for="eventType" class="form-label">Motivo de viaje</label>
                        <input type="text" class="form-control" id="eventType" name="eventType"
                               placeholder="Ej: Experiencias para despedida de soltera">
                        <div class="form-text">Describe el tipo de evento o el motivo del viaje</div>
                    </div>

                    <div class="col-md-4">
                        <%- include('../../../atoms/common/language-select', {
                            id: 'preferredLanguage',
                            name: 'preferredLanguage',
                            label: 'Idioma de Preferencia',
                            required: false,
                            helpText: 'Idioma preferido para comunicación y documentos',
                            value: 'es'
                        }) %>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="numberOfAdults" class="form-label">Número de adultos (12+)</label>
                        <input type="number" class="form-control quote-people-input" id="numberOfAdults" name="numberOfAdults" min="0" placeholder="0">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="numberOfChildren" class="form-label">Número de niños (3-12)</label>
                        <input type="number" class="form-control quote-people-input" id="numberOfChildren" name="numberOfChildren" min="0" placeholder="0">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="numberOfInfants" class="form-label">Número de infantes (0-2)</label>
                        <input type="number" class="form-control quote-people-input" id="numberOfInfants" name="numberOfInfants" min="0" placeholder="0">
                    </div>
                </div>
                <input type="hidden" id="numberOfPeople" name="numberOfPeople" value="0">
            </div>

            <!-- Sección: Notas Adicionales -->
            <div class="border rounded p-3 mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="ti ti-notes me-1"></i>
                    Notas Adicionales
                </h6>

                <div class="mb-3">
                    <label for="notes" class="form-label">Notas</label>
                    <textarea class="form-control" id="notes" name="notes" rows="3" placeholder="Notas adicionales sobre la <%= e %>..."></textarea>
                    <div class="form-text">Máximo 500 caracteres (opcional)</div>
                </div>
            </div>

            <!-- Status is now managed via the global dropdown in the page header -->

            <!-- Alert informativo -->
            <div class="alert alert-success d-flex align-items-start" role="alert">
                <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                <div>
                    <strong><%= E %>:</strong>
                    <p class="mb-0 mt-1">Define la información básica del cliente. Una vez creada, podrás agregar servicios y seleccionar tarifas específicas para cada traslado en la siguiente sección.</p>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="d-flex justify-content-end gap-2">
                <a href="/dashboard/admin/quotes" class="btn btn-secondary">
                    <i class="ti ti-x me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary" id="createQuoteBtn">
                    <i class="ti ti-check me-1"></i>Crear Cotización
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Quick Client Creation Modal -->
<div class="modal fade client-modal-v2" id="quickClientModal" tabindex="-1" aria-labelledby="quickClientModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="asc-hdr-icon"><i class="ti ti-user-plus"></i></div>
                <div class="flex-grow-1">
                    <h5 class="modal-title" id="quickClientModalLabel">Crear Cliente Rápido</h5>
                    <div class="asc-subtitle">Se creará con la información mínima necesaria</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Alerts Container -->
                <div id="quickClientModalAlerts"></div>

                <form id="quickClientForm" class="needs-validation" novalidate>
                    <p class="asc-section-label">Datos del cliente</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="qc_firstName" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="qc_firstName" name="firstName" required placeholder="Ej: Juan">
                            <div class="invalid-feedback">Por favor ingresa el nombre</div>
                        </div>
                        <div class="col-md-6">
                            <label for="qc_lastName" class="form-label">Apellido <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="qc_lastName" name="lastName" required placeholder="Ej: Pérez">
                            <div class="invalid-feedback">Por favor ingresa el apellido</div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <%- include('../../../atoms/common/email-input', {
                            name: 'email',
                            id: 'qc_email',
                            label: 'Email',
                            required: false,
                            placeholder: 'email@ejemplo.com',
                            helpText: 'Si no lo proporcionas, se generará un email temporal',
                            containerClass: 'mb-3'
                        }) %>

                        <div class="mb-3">
                            <label for="qc_companyName" class="form-label">Nombre de Empresa <span class="text-muted">(opcional)</span></label>
                            <input type="text" class="form-control" id="qc_companyName" name="companyName" placeholder="Ej: Empresa S.A. de C.V.">
                            <div class="form-text">Nombre de la empresa del cliente</div>
                        </div>

                        <%- include('../../../atoms/common/phone-input', {
                            name: 'phone',
                            id: 'qc_phone',
                            label: 'Teléfono',
                            required: false,
                            helpText: 'Número de contacto del cliente',
                            countryCode: 'MX',
                            containerClass: 'mb-3'
                        }) %>
                    </div>

                    <div class="alert alert-info d-flex align-items-start" role="alert">
                        <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                        <div>
                            <small><strong>Cliente rápido:</strong> Este cliente se creará con la información mínima necesaria. Podrás completar sus datos desde la sección de Clientes más adelante.</small>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn asc-btn-ghost" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="saveQuickClientBtn">
                    <i class="ti ti-check me-1"></i>Crear Cliente
                </button>
            </div>

            <%- include('../../../atoms/common/modal-loader', { text: 'Creando cliente...' }) %>
        </div>
    </div>
</div>

<!-- Quick Direct Client Creation Modal -->
<div class="modal fade" id="quickDirectClientModal" tabindex="-1" aria-labelledby="quickDirectClientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickDirectClientModalLabel">
                    <i class="ti ti-user-plus me-2"></i>Crear Cliente Directo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Alerts Container -->
                <div id="quickDirectClientModalAlerts"></div>

                <form id="quickDirectClientForm" class="needs-validation" novalidate>
