                const lgLast = document.getElementById('leadGuestLastName')?.value.trim() || '';
                const hasLeadGuest = !!(lgFirst || lgLast);
                const differs = norm(lgFirst) !== norm(opt.firstName) || norm(lgLast) !== norm(opt.lastName);
                if (hasLeadGuest && differs) {
                    const ok = window.confirm('Se reemplazará el Lead Guest actual por el cliente final seleccionado. ¿Continuar?');
                    if (!ok) { cb.checked = false; syncLeadGuestMode(); return; }
