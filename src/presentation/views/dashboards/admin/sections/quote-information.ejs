    // del dropdown Cliente Final → se ocultan los campos manuales. Desmarcado (o en directo, donde el
    // dropdown no se muestra) → captura manual.
    function syncLeadGuestMode() {
        const finalRow = document.getElementById('finalClientRow');
        const agencyVisible = !!finalRow && window.getComputedStyle(finalRow).display !== 'none';
        const isFinal = !!document.getElementById('leadGuestIsFinalClient')?.checked;
        const linked = agencyVisible && isFinal;
        document.getElementById('leadGuestManualFields')?.classList.toggle('d-none', linked);
        // "Guardar cliente" sobra (y duplicaría) cuando el Lead Guest ya existe como cliente final:
        // sea porque está enlazado (checkbox), o porque —aun desmarcado— el nombre capturado COINCIDE
        // con el cliente final seleccionado. En ambos casos se desmarca y deshabilita; si no, se rehabilita.
        const norm = (s) => (s || '').trim().toLowerCase();
        const lgFirst = norm(document.getElementById('leadGuestFirstName')?.value);
        const lgLast = norm(document.getElementById('leadGuestLastName')?.value);
        const selOpt = agencyVisible ? getFinalClientOptionByValue(getSelectedFinalClientValue()) : null;
        const matchesFinal = !!selOpt && (lgFirst || lgLast) &&
            lgFirst === norm(selOpt.firstName) && lgLast === norm(selOpt.lastName);
        const alreadySaved = linked || matchesFinal;
        const saveCb = document.getElementById('saveLeadGuestAsClient');
        if (saveCb) {
            if (alreadySaved) saveCb.checked = false;
            saveCb.disabled = alreadySaved;
            saveCb.closest('.form-check')?.classList.toggle('opacity-50', alreadySaved);
