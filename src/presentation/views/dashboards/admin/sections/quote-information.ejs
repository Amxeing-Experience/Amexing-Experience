    // Aplica los datos del cliente final al Lead Guest (y al contacto).
    function applyFinalClientToLeadGuest(opt) {
        const first = opt.firstName || '';
        const last = opt.lastName || '';
        const set = (id, v, clearEdited) => {
            const el = document.getElementById(id);
            if (el) { el.value = v; if (clearEdited) el.dataset.userEdited = ''; }
        };
        set('leadGuestFirstName', first);
        set('leadGuestLastName', last);
        set('contactFirstName', first, true);
        set('contactLastName', last, true);
        set('contactEmail', opt.email || '');
        let p = opt.phone || '';
        if (p.startsWith('52') && p.length > 10) p = p.substring(2);
        else if (p.startsWith('1') && p.length === 11) p = p.substring(1);
        set('contactPhone', p);
    }
    // Valor seleccionado del dropdown Cliente Final (soporta customSelect y TomSelect).
    function getSelectedFinalClientValue() {
