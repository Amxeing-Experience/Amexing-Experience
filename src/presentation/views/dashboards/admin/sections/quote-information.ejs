<%
/**
 * Quote Information Section
 * Basic information form for quote creation/editing
 */
%>

<div class="card border-0 shadow-sm" id="quoteInformationCard">
    <!-- Page Loader -->
    <%- include('../../../atoms/common/page-loader', {
        text: 'Cargando información de la cotización...',
        spinnerColor: 'primary',
        containerId: 'quoteInformationCard'
    }) %>

    <div class="card-header bg-white border-bottom">
        <h5 class="card-title mb-0">
            <i class="ti ti-info-circle me-2"></i>Información de la Cotización
        </h5>
    </div>

    <div class="card-body">
        <!-- Alerts Container -->
        <div id="quoteInformationAlerts"></div>

        <form id="quoteInformationForm" class="needs-validation" novalidate>
            <!-- Hidden field for quote ID (for editing) -->
            <input type="hidden" id="quoteId" name="quoteId" value="<%= typeof quoteId !== 'undefined' ? quoteId : '' %>">

            <!-- Sección: Información del Cliente -->
            <div class="mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="ti ti-user me-1"></i>
                    Información del Cliente
                </h6>

                <% 
                // Determine if dropdown should be disabled
                const isRestrictedRole = (typeof userRole !== 'undefined' && (userRole === 'department_manager' || userRole === 'client'));
                const helpTextMessage = isRestrictedRole 
                    ? 'Cliente asignado automáticamente según tu rol' 
                    : 'Selecciona un cliente existente o crea uno nuevo';
                %>

                <div class="row">
                    <div class="col-md-<%= isRestrictedRole ? '12' : '10' %>">
                        <!-- Client selection - disabled for department_manager/client roles -->
                        <%- include('../../../atoms/common/tom-select', {
                            id: 'clientId',
                            name: 'clientId',
                            multiple: false,
                            placeholder: 'Buscar cliente por nombre o empresa',
                            label: 'Cliente',
                            required: true,
                            helpText: helpTextMessage,
                            options: [],
                            selected: [],
                            disabled: isRestrictedRole
                        }) %>
                    </div>
                    <% if (!isRestrictedRole) { %>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button type="button" class="btn btn-outline-primary w-100 px-2 py-2" id="createQuickClientBtn">
                            <i class="ti ti-plus me-1"></i>Crear Cliente
                        </button>
                    </div>
                    <% } %>
                </div>
            </div>
                
            <!-- Ownership and Sharing Controls -->
            <div class="mb-4">
                <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded border">
                    <!-- Left: Owner Info -->
                    <div class="d-flex align-items-center">
                        <div class="badge bg-secondary me-3">
                            <i class="ti ti-user me-1"></i>
                            Propietario
                        </div>
                        <div>
                            <div class="fw-medium" id="compactOwnerName">
                                <div class="placeholder-glow" id="ownerLoader">
                                    <span class="placeholder col-6 placeholder-sm"></span>
                                </div>
                            </div>
                            <small class="text-muted" id="compactOwnerEmail">
                                <div class="placeholder-glow" id="ownerEmailLoader">
                                    <span class="placeholder col-8 placeholder-xs"></span>
                                </div>
                            </small>
                        </div>
                    </div>
                    
                    <!-- Right: Compartir Button -->
                    <button type="button" class="btn btn-primary" id="btnManageCollaborators">
                        <i class="ti ti-user-plus me-1"></i>
                        Compartir
                    </button>
                </div>

            <!-- Sección: Información de Contacto -->
            <div class="mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="ti ti-phone me-1"></i>
                    Información de Contacto
                </h6>
                <div class="alert alert-info d-flex align-items-start" role="alert">
                    <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                    <div>
                        <small>Esta información se autocompletará al seleccionar un cliente, pero puedes editarla para esta cotización específica.</small>
                    </div>
                </div>

                <!-- Final Client Selection -->
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <%- include('../../../atoms/common/tom-select', {
                            id: 'clientFinalId',
                            name: 'clientFinalId',
                            multiple: false,
                            placeholder: 'Seleccionar cliente final (opcional)',
                            label: 'Cliente Final',
                            required: false,
                            helpText: 'Selecciona un cliente final específico para prellenar la información de contacto',
                            options: [],
                            selected: []
                        }) %>
                    </div>
                </div>

                <!-- Contact Name Fields -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="contactFirstName" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="contactFirstName" name="contactFirstName" placeholder="Nombre">
                        <div class="form-text">Nombre de la persona de contacto</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="contactLastName" class="form-label">Apellido</label>
                        <input type="text" class="form-control" id="contactLastName" name="contactLastName" placeholder="Apellido">
                        <div class="form-text">Apellido de la persona de contacto</div>
                    </div>
                </div>

                <!-- Contact Email and Phone -->
                <div class="row">
                    <div class="col-md-6">
                        <%- include('../../../atoms/common/email-input', {
                            name: 'contactEmail',
                            id: 'contactEmail',
                            label: 'Email de Contacto',
                            required: false,
                            placeholder: 'email@ejemplo.com',
                            helpText: 'Email para enviar la cotización',
                            containerClass: 'mb-3'
                        }) %>
                    </div>

                    <div class="col-md-6">
                        <%- include('../../../atoms/common/phone-input', {
                            name: 'contactPhone',
                            id: 'contactPhone',
                            label: 'Teléfono de Contacto',
                            required: false,
                            helpText: 'Teléfono de contacto directo',
                            countryCode: 'MX',
                            containerClass: 'mb-3'
                        }) %>
                    </div>
                </div>
            </div>

            <!-- Sección: Detalles del Evento -->
            <div class="mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="ti ti-calendar-event me-1"></i>
                    Detalles del Evento
                </h6>

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label for="eventType" class="form-label">Tipo de Evento / Motivo</label>
                        <input type="text" class="form-control" id="eventType" name="eventType"
                               placeholder="Ej: Experiencias para despedida de soltera">
                        <div class="form-text">Describe el tipo de evento o el motivo del viaje</div>
                    </div>

                    <div class="col-md-4">
                        <%- include('../../../atoms/common/language-select', {
                            id: 'preferredLanguage',
                            name: 'preferredLanguage',
                            label: 'Idioma de Preferencia',
                            required: false,
                            helpText: 'Idioma preferido para comunicación y documentos',
                            value: 'es'
                        }) %>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="numberOfAdults" class="form-label">Número de adultos (12+)</label>
                        <input type="number" class="form-control quote-people-input" id="numberOfAdults" name="numberOfAdults" min="0" placeholder="0">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="numberOfChildren" class="form-label">Número de niños (3-12)</label>
                        <input type="number" class="form-control quote-people-input" id="numberOfChildren" name="numberOfChildren" min="0" placeholder="0">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="numberOfInfants" class="form-label">Número de infantes (0-2)</label>
                        <input type="number" class="form-control quote-people-input" id="numberOfInfants" name="numberOfInfants" min="0" placeholder="0">
                    </div>
                </div>
                <input type="hidden" id="numberOfPeople" name="numberOfPeople" value="0">
            </div>

            <!-- Sección: Notas Adicionales -->
            <div class="mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="ti ti-notes me-1"></i>
                    Notas Adicionales
                </h6>

                <div class="mb-3">
                    <label for="notes" class="form-label">Notas</label>
                    <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="500" placeholder="Notas adicionales sobre la cotización..."></textarea>
                    <div class="form-text">Máximo 500 caracteres (opcional)</div>
                </div>
            </div>

            <!-- Status is now managed via the global dropdown in the page header -->

            <!-- Alert informativo -->
            <div class="alert alert-success d-flex align-items-start" role="alert">
                <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                <div>
                    <strong>Cotización:</strong>
                    <p class="mb-0 mt-1">Define la información básica del cliente. Una vez creada, podrás agregar servicios y seleccionar tarifas específicas para cada traslado en la siguiente sección.</p>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="d-flex justify-content-end gap-2">
                <a href="/dashboard/admin/quotes" class="btn btn-secondary">
                    <i class="ti ti-x me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary" id="createQuoteBtn">
                    <i class="ti ti-check me-1"></i>Crear Cotización
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Quick Client Creation Modal -->
<div class="modal fade" id="quickClientModal" tabindex="-1" aria-labelledby="quickClientModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickClientModalLabel">
                    <i class="ti ti-user-plus me-2"></i>Crear Cliente Rápido
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Alerts Container -->
                <div id="quickClientModalAlerts"></div>

                <form id="quickClientForm" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="qc_firstName" class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="qc_firstName" name="firstName" required placeholder="Ej: Juan">
                        <div class="invalid-feedback">Por favor ingresa el nombre</div>
                    </div>

                    <div class="mb-3">
                        <label for="qc_lastName" class="form-label">Apellido <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="qc_lastName" name="lastName" required placeholder="Ej: Pérez">
                        <div class="invalid-feedback">Por favor ingresa el apellido</div>
                    </div>

                    <%- include('../../../atoms/common/email-input', {
                        name: 'email',
                        id: 'qc_email',
                        label: 'Email',
                        required: false,
                        placeholder: 'email@ejemplo.com',
                        helpText: 'Si no lo proporcionas, se generará un email temporal',
                        containerClass: 'mb-3'
                    }) %>

                    <div class="mb-3">
                        <label for="qc_companyName" class="form-label">Nombre de Empresa <span class="text-muted">(opcional)</span></label>
                        <input type="text" class="form-control" id="qc_companyName" name="companyName" placeholder="Ej: Empresa S.A. de C.V.">
                        <div class="form-text">Nombre de la empresa del cliente</div>
                    </div>

                    <%- include('../../../atoms/common/phone-input', {
                        name: 'phone',
                        id: 'qc_phone',
                        label: 'Teléfono',
                        required: false,
                        helpText: 'Número de contacto del cliente',
                        countryCode: 'MX',
                        containerClass: 'mb-3'
                    }) %>

                    <div class="alert alert-info d-flex align-items-start" role="alert">
                        <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                        <div>
                            <small><strong>Cliente rápido:</strong> Este cliente se creará con la información mínima necesaria. Podrás completar sus datos desde la sección de Clientes más adelante.</small>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="saveQuickClientBtn">
                    <i class="ti ti-check me-1"></i>Crear Cliente
                </button>
            </div>

            <%- include('../../../atoms/common/modal-loader', { text: 'Creando cliente...' }) %>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';

    let clientTomSelect = null;
    const userRole = '<%= typeof userRole !== "undefined" ? userRole : "admin" %>';
    
    // Current user data for department_manager (passed from server)
    const currentUserData = {
        id: '<%= typeof user !== "undefined" && user ? user.id : "" %>',
        name: '<%= typeof user !== "undefined" && user ? (user.firstName && user.lastName ? user.firstName + " " + user.lastName : user.name || user.email || "") : "" %>',
        email: '<%= typeof user !== "undefined" && user ? user.email || "" : "" %>',
        firstName: '<%= typeof user !== "undefined" && user ? user.firstName || "" : "" %>',
        lastName: '<%= typeof user !== "undefined" && user ? user.lastName || "" : "" %>',
        phone: '<%= typeof user !== "undefined" && user ? user.phone || "" : "" %>',
        clientId: '<%= typeof user !== "undefined" && user ? user.clientId || "" : "" %>'
    };
    
    // Make currentUserData available globally for other scripts
    window.currentUserData = currentUserData;
    
    // Also set currentUser if not already set (for compatibility with ownership manager)
    if (!window.currentUser) {
        window.currentUser = {
            role: userRole,
            id: currentUserData.id
        };
    }

    // Get JWT token from cookies
    function getAccessToken() {
        const cookies = document.cookie.split(';');
        for (let cookie of cookies) {
            const [name, value] = cookie.trim().split('=');
            if (name === 'accessToken') {
                return value;
            }
        }
        return null;
    }

    // Helper function to wait for Custom Select to be initialized  
    function waitForTomSelect(elementId, maxAttempts = 100) {
        return new Promise((resolve, reject) => {
            const element = document.getElementById(elementId);
            
            // For department_manager and client roles, clientId is just a hidden input
            if (elementId === 'clientId' && (userRole === 'department_manager' || userRole === 'client')) {
                // Return a mock object that works like TomSelect for the hidden input
                resolve({
                    getValue: () => element.value,
                    setValue: (val) => { element.value = val; },
                    addOption: () => {}, // no-op
                    clearOptions: () => {}, // no-op
                    options: {},
                    refreshOptions: () => {} // no-op
                });
                return;
            }
            
            // Check if already initialized (support both tomselect and customSelect)
            if (element && (element.tomselect || element.customSelect)) {
                resolve(element.tomselect || element.customSelect);
                return;
            }
            
            // Listen for the ready event
            const handleReady = (e) => {
                element.removeEventListener('tomselect:ready', handleReady);
                clearInterval(checkInterval);
                resolve(e.detail.instance);
            };
            
            if (element) {
                element.addEventListener('tomselect:ready', handleReady);
            }
            
            // Also poll as a fallback
            let attempts = 0;
            const checkInterval = setInterval(() => {
                const el = document.getElementById(elementId);
                if (el && (el.tomselect || el.customSelect)) {
                    if (element) {
                        element.removeEventListener('tomselect:ready', handleReady);
                    }
                    clearInterval(checkInterval);
                    resolve(el.tomselect || el.customSelect);
                } else {
                    attempts++;
                    if (attempts >= maxAttempts) {
                        if (element) {
                            element.removeEventListener('tomselect:ready', handleReady);
                        }
                        clearInterval(checkInterval);
                        reject(new Error(`Custom Select not initialized on #${elementId} after ${maxAttempts} attempts`));
                    }
                }
            }, 100);
        });
    }

    // Show alert in a container
    function showAlert(containerId, message, type = 'danger') {
        const container = document.getElementById(containerId);
        if (!container) return;

        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
        alertDiv.role = 'alert';
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        `;
        container.appendChild(alertDiv);

        // Auto-dismiss after 5 seconds with null check
        setTimeout(() => {
            if (alertDiv && alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 5000);
    }

    // Clear alerts from a container
    function clearAlerts(containerId) {
        const container = document.getElementById(containerId);
        if (container) {
            container.querySelectorAll('.alert').forEach(el => el.remove());
        }
    }

    // Show modal loader (for quick client modal only)
    function showQuickClientModalLoader(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            const loader = modal.querySelector('.modal-loader-overlay');
            if (loader) {
                loader.style.display = 'flex';
            }
        }
    }

    // Hide modal loader (for quick client modal only)
    function hideQuickClientModalLoader(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            const loader = modal.querySelector('.modal-loader-overlay');
            if (loader) {
                loader.style.display = 'none';
            }
        }
    }

    // Load current user info for department manager / client role
    async function loadCurrentUserAsClient() {
        try {
            const clientField = document.getElementById('clientId');
            if (!clientField) return;
            
            let clientUserId = null;
            let clientName = '';
            
            // For client role, use the clientId (org owner) instead of current user
            if (userRole === 'client' && currentUserData.clientId) {
                clientUserId = currentUserData.clientId;
                
                // Fetch org owner's name from API
                try {
                    const token = getAccessToken();
                    const resp = await fetch(`/api/users/${clientUserId}`, {
                        headers: { Authorization: `Bearer ${token}` }
                    });
                    if (resp.ok) {
                        const result = await resp.json();
                        const owner = result.data || result;
                        clientName = [owner.firstName, owner.lastName].filter(Boolean).join(' ') || owner.companyName || owner.email || 'Cliente';
                    } else {
                        clientName = 'Cliente';
                    }
                } catch {
                    clientName = 'Cliente';
                }
            } else if (userRole === 'department_manager' && currentUserData.id) {
                // Department manager: use current user as client
                clientUserId = currentUserData.id;
                clientName = currentUserData.name || 
                            `${currentUserData.firstName || ''} ${currentUserData.lastName || ''}`.trim() || 
                            currentUserData.email || 
                            'Usuario actual';
            } else {
                console.error('No client ID available for restricted role');
                return;
            }
            
            // Set the value in the hidden input
            clientField.value = clientUserId;
            
            // Update the display if using custom dropdown
            const displayElement = document.getElementById('clientId_display');
            if (displayElement) {
                const textSpan = displayElement.querySelector('.dropdown-selected-text');
                if (textSpan) {
                    textSpan.textContent = clientName;
                    textSpan.classList.remove('text-muted');
                }
                
                // Add the option to the dropdown if it doesn't exist
                const optionsContainer = document.getElementById('clientId_options');
                if (optionsContainer && !optionsContainer.querySelector(`[data-value="${clientUserId}"]`)) {
                    const optionHtml = `<a class="dropdown-item dropdown-option" href="#" data-value="${clientUserId}" data-text="${clientName}">${clientName}</a>`;
                    optionsContainer.innerHTML = optionHtml;
                }
            }
            
            // If the custom dropdown has a setValue method, use it
            if (clientField.customSelect && clientField.customSelect.setValue) {
                clientField.customSelect.setValue(clientUserId);
            }
            
            // Auto-fill contact info from current user
            if (currentUserData.firstName || currentUserData.lastName) {
                const firstName = currentUserData.firstName || '';
                const lastName = currentUserData.lastName || '';
                if (firstName) document.getElementById('contactFirstName').value = firstName;
                if (lastName) document.getElementById('contactLastName').value = lastName;
            }
            if (currentUserData.email) document.getElementById('contactEmail').value = currentUserData.email;
            if (currentUserData.phone) document.getElementById('contactPhone').value = currentUserData.phone;
            
        } catch (error) {
            console.error('Error loading current user as client:', error);
        }
    }

    // Load active clients for Tom Select with optional search
    // Make this function globally available for the custom dropdown component
    window.loadActiveClients = async function loadActiveClients(searchTerm = '', page = 1) {
        // Skip loading clients for department_manager and client roles (they don't see the dropdown)
        if (userRole === 'department_manager' || userRole === 'client') {
            return;
        }
        
        try {
            const endpoint = '/api/clients/active';
            
            // Build query parameters
            const params = new URLSearchParams();
            if (searchTerm) params.append('search', searchTerm);
            params.append('page', page.toString());
            params.append('limit', '100'); // Get 100 results per search
            
            const url = `${endpoint}${params.toString() ? '?' + params.toString() : ''}`;
            
            const response = await fetch(url, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();
            
            console.log('🌐 API Response from /api/clients/active:', {
                success: result.success,
                dataStructure: result.data ? Object.keys(result.data) : null,
                clientsCount: result.data?.clients?.length || result.data?.length || 0,
                firstClient: result.data?.clients?.[0] || result.data?.[0] || null
            });

            if (result.success && result.data) {
                const clientTS = await waitForTomSelect('clientId');

                // For server-side search, clear options only on new search (page 1)
                if (page === 1) {
                    clientTS.clearOptions();
                }

                // Handle different response formats
                const clients = result.data.clients || result.data;
                
                console.log('📦 Clients array to process:', {
                    count: clients.length,
                    sample: clients.slice(0, 3).map(c => ({
                        label: c.label,
                        value: c.value,
                        email: c.email
                    }))
                });
                
                // Add client options
                clients.forEach(client => {
                    console.log('🔍 Processing client for dropdown:', {
                        raw: client,
                        label: client.label,
                        value: client.value,
                        contactPerson: client.contactPerson
                    });
                    
                    // Smart display logic:
                    // 1. If label has company name in parentheses, prioritize company name
                    // 2. If no parentheses but label looks like "FirstName LastName", keep as is
                    // 3. Otherwise use the full label
                    let displayText = client.label;
                    const parenthesesMatch = client.label.match(/^(.+?)\s*\(([^)]+)\)$/);
                    
                    if (parenthesesMatch && parenthesesMatch[2]) {
                        // Has format "Name (Company)" - use company name
                        displayText = parenthesesMatch[2];
                        console.log('✅ Using company name from parentheses:', displayText);
                    } else if (!client.label.includes('(')) {
                        // No parentheses - likely just the company or person name, use as is
                        displayText = client.label;
                        console.log('ℹ️ No parentheses found, using label as-is:', displayText);
                    }
                    
                    console.log('📋 Final display text for client:', {
                        clientId: client.value,
                        displayText: displayText,
                        originalLabel: client.label
                    });
                    
                    clientTS.addOption({
                        value: client.value,
                        text: displayText,
                        email: client.email,
                        contactPerson: client.contactPerson,
                        phone: client.phone
                    });
                });

                // Refresh to apply changes
                clientTS.refreshOptions(false);
                
                // Return pagination info for possible future use
                return {
                    hasMore: result.data.pagination?.hasMore || false,
                    total: result.data.pagination?.total || clients.length
                };
            } else {
                console.error('No client data or API error:', result);
                return { hasMore: false, total: 0 };
            }
        } catch (error) {
            console.error('Error loading clients:', error);
            showAlert('quoteInformationAlerts', 'Error al cargar la lista de clientes', 'danger');
            return { hasMore: false, total: 0 };
        }
    }

    // Load sub-clients (final clients) when a client is selected
    async function loadClientEmployees(clientId, selectedClientFinalId = null) {
        try {
            if (!clientId) {
                // Clear sub-client dropdown if no client selected
                const employeeTS = await waitForTomSelect('clientFinalId');
                employeeTS.clearOptions();
                employeeTS.addOption({ value: '', text: 'No hay clientes disponibles' });
                employeeTS.setValue('');
                return;
            }

            // Fetch sub-clients for this client
            const response = await fetch(`/api/clients/${clientId}/sub-clients`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();
            
            console.log('🏢 Sub-clients API Response:', {
                clientId: clientId,
                success: result.success,
                clientsCount: result.data?.clients?.length || 0,
                clients: result.data?.clients?.map(client => ({
                    id: client.id,
                    name: client.name,
                    companyName: client.companyName,
                    contactPerson: client.contactPerson,
                    email: client.email,
                    phone: client.phone,
                    preferredLanguage: client.preferredLanguage
                }))
            });

            if (result.success && result.data?.clients && result.data.clients.length > 0) {
                const employeeTS = await waitForTomSelect('clientFinalId');
                employeeTS.clearOptions();
                
                // Add empty option first
                employeeTS.addOption({ value: '', text: 'Seleccionar cliente final (opcional)' });
                
                // Add sub-client options
                result.data.clients.forEach(client => {
                    // Build display name - prioritize company name, then contact person, then constructed name
                    let displayName = client.companyName || 
                                     client.name || 
                                     client.contactPerson ||
                                     `${client.firstName || ''} ${client.lastName || ''}`.trim() || 
                                     client.email;
                    
                    employeeTS.addOption({
                        value: client.id,
                        text: displayName,
                        email: client.email,
                        contactPerson: client.contactPerson || displayName,
                        firstName: client.firstName || '',
                        lastName: client.lastName || '',
                        phone: client.phone || '',
                        preferredLanguage: client.preferredLanguage || 'es'
                    });
                });
                
                employeeTS.refreshOptions(false);
                
                // If a specific clientFinalId was provided, set it now
                if (selectedClientFinalId) {
                    console.log('🔍 Attempting to set clientFinalId:', {
                        selectedClientFinalId: selectedClientFinalId,
                        selectedType: typeof selectedClientFinalId,
                        availableOptions: result.data.clients.map(c => ({
                            id: c.id,
                            idType: typeof c.id,
                            name: c.name || c.companyName
                        }))
                    });
                    
                    // Check if the option exists
                    const optionExists = employeeTS.getOption && employeeTS.getOption(selectedClientFinalId);
                    console.log('🔍 getOption result:', {
                        optionExists: !!optionExists,
                        optionDetails: optionExists
                    });
                    
                    if (optionExists) {
                        console.log('✅ Option found, setting value...');
                        employeeTS.setValue(selectedClientFinalId);
                        
                        // Verify it was set
                        setTimeout(() => {
                            const currentValue = employeeTS.getValue();
                            console.log('✅ Verification - current value:', currentValue);
                        }, 100);
                    } else {
                        console.log('⚠️ Cliente Final option not found in dropdown');
                        // Try to find a matching option manually
                        const manualFind = result.data.clients.find(c => c.id === selectedClientFinalId);
                        console.log('🔍 Manual find result:', manualFind);
                    }
                }
            } else {
                // No sub-clients found
                const employeeTS = await waitForTomSelect('clientFinalId');
                employeeTS.clearOptions();
                employeeTS.addOption({ value: '', text: 'No hay clientes disponibles' });
                employeeTS.setValue('');
            }
        } catch (error) {
            console.error('Error loading sub-clients:', error);
            // Clear dropdown on error
            try {
                const employeeTS = await waitForTomSelect('clientFinalId');
                employeeTS.clearOptions();
                employeeTS.addOption({ value: '', text: 'Error al cargar clientes' });
                employeeTS.setValue('');
            } catch (e) {
                console.error('Error clearing sub-client dropdown:', e);
            }
        }
    }

    // Auto-fill contact information when client is selected (admin/superadmin only)
    async function handleClientSelection() {
        try {
            // Get the hidden input element for client
            const clientInput = document.getElementById('clientId');
            if (!clientInput) {
                console.log('Client input not found');
                return;
            }
            
            // Listen for change events on the hidden input
            clientInput.addEventListener('change', async function(event) {
                const value = event.target.value;
                
                if (value) {
                    // Load employees for the selected client
                    loadClientEmployees(value);
                    
                    try {
                        // Get the custom select instance to access options
                        const clientTS = await waitForTomSelect('clientId');
                        const option = clientTS.options ? clientTS.options[value] : null;
                        
                        if (option) {
                            // Parse contactPerson into first and last name
                            let firstName = '';
                            let lastName = '';
                            
                            if (option.contactPerson) {
                                const nameParts = option.contactPerson.trim().split(/\s+/);
                                if (nameParts.length === 1) {
                                    firstName = nameParts[0];
                                } else if (nameParts.length >= 2) {
                                    firstName = nameParts[0];
                                    lastName = nameParts.slice(1).join(' ');
                                }
                            }
                            
                            // Auto-fill contact fields
                            document.getElementById('contactFirstName').value = firstName;
                            document.getElementById('contactLastName').value = lastName;
                            document.getElementById('contactEmail').value = option.email || '';
                            
                            // Strip country code from phone if present
                            let phoneNumber = option.phone || '';
                            if (phoneNumber.startsWith('52') && phoneNumber.length > 10) {
                                // Remove Mexico country code
                                phoneNumber = phoneNumber.substring(2);
                            } else if (phoneNumber.startsWith('1') && phoneNumber.length === 11) {
                                // Remove US/Canada country code
                                phoneNumber = phoneNumber.substring(1);
                            }
                            document.getElementById('contactPhone').value = phoneNumber;
                        }
                    } catch (error) {
                        console.error('Error getting client data:', error);
                    }
                } else {
                    // Clear contact fields and employees when no client selected
                    document.getElementById('contactFirstName').value = '';
                    document.getElementById('contactLastName').value = '';
                    document.getElementById('contactEmail').value = '';
                    document.getElementById('contactPhone').value = '';
                    
                    // Clear employee dropdown
                    loadClientEmployees(null);
                }
            });
        } catch (error) {
            console.error('Error setting up client selection handler:', error);
        }
    }

