            numberOfAdults: parseInt(document.getElementById('numberOfAdults').value || 0),
            numberOfChildren: parseInt(document.getElementById('numberOfChildren').value || 0),
            numberOfInfants: parseInt(document.getElementById('numberOfInfants').value || 0),
            preferredLanguage: document.getElementById('preferredLanguage').value || 'es',
            contactPerson: contactPerson,
            contactFirstName: firstName || undefined,
            contactLastName: lastName || undefined,
            contactEmail: document.getElementById('contactEmail').value.trim() || undefined,
            contactPhone: document.getElementById('contactPhone').value.trim() || undefined,
            notes: document.getElementById('notes').value.trim() || undefined
        };

        // Only include clientFinalId if it has a value
        if (clientFinalId) {
            formData.clientFinalId = clientFinalId;
        }

        // Disable submit button
        const submitBtn = document.getElementById('createQuoteBtn');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="ti ti-loader-2 me-1 spinner-border spinner-border-sm"></i>Creando...';

        try {
            const response = await fetch('/api/quotes', {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (result.success && result.data) {
                showAlert('quoteInformationAlerts', result.message || 'Cotización creada exitosamente', 'success');

                // Redirect to quote detail page with services section (use appropriate dashboard path)
                const dashboardPathMap = { department_manager: '/dashboard/department_manager', client: '/dashboard/client' };
                const dashboardPath = dashboardPathMap[userRole] || '/dashboard/admin';
                setTimeout(() => {
                    window.location.href = `${dashboardPath}/quotes/${result.data.id}?section=services`;
                }, 1500);
            } else {
                showAlert('quoteInformationAlerts', result.error || 'Error al crear la cotización', 'danger');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        } catch (error) {
            console.error('Error creating quote:', error);
            showAlert('quoteInformationAlerts', 'Error de conexión al crear la cotización', 'danger');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    }

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', async function() {
        // Show loader immediately
        showPageLoader('quoteInformationCard');

        try {
            // Small delay to ensure Tom Select can initialize
            await new Promise(resolve => setTimeout(resolve, 200));
            
            // Check if we're in edit mode first
            const quoteIdInput = document.getElementById('quoteId');
            const quoteId = quoteIdInput ? quoteIdInput.value : '';
            const isEditMode = quoteId && quoteId !== '' && quoteId !== 'new';
            
            // Load active clients for all users (different endpoints based on role)
            await loadActiveClients();
            
            // Setup client selection handler for all users
            await handleClientSelection();
            
            // Setup employee selection handler
            await handleEmployeeSelection();

            // If edit mode, load quote data
            if (isEditMode) {
                await loadQuoteData(quoteId);
            } else if (userRole === 'department_manager' || userRole === 'client') {
                // For new quotes, ensure clientId is populated for these roles
                await loadCurrentUserAsClient();
            }

            // Auto-sum people fields into hidden numberOfPeople
            document.querySelectorAll('.quote-people-input').forEach(input => {
                input.addEventListener('change', () => {
                    const adults = parseInt(document.getElementById('numberOfAdults').value || 0);
                    const children = parseInt(document.getElementById('numberOfChildren').value || 0);
                    const infants = parseInt(document.getElementById('numberOfInfants').value || 0);
                    document.getElementById('numberOfPeople').value = adults + children + infants;
                });
            });

            // Event listeners for quick client buttons (all users who have the button)
            const createBtn = document.getElementById('createQuickClientBtn');
            const saveBtn = document.getElementById('saveQuickClientBtn');
            
            if (createBtn) {
                createBtn.addEventListener('click', openQuickClientModal);
            }
            if (saveBtn) {
                saveBtn.addEventListener('click', saveQuickClient);
            }

            // Form submission - use appropriate function based on current state
            document.getElementById('quoteInformationForm').addEventListener('submit', function(event) {
                // Check current quote ID dynamically (not just initial page load state)
                const quoteIdField = document.getElementById('quoteId');
                const currentQuoteId = quoteIdField?.value;
                const hasExistingQuote = currentQuoteId && currentQuoteId.trim() !== '' && currentQuoteId !== 'new';
                
                if (hasExistingQuote) {
                    console.log('Form submission: Updating existing quote', currentQuoteId);
                    updateQuote(currentQuoteId, event);
                } else {
                    console.log('Form submission: Creating new quote');
                    createQuote(event);
                }
            });

            // Hide loader after everything is loaded
            hidePageLoader('quoteInformationCard');
        } catch (error) {
            console.error('Error initializing quote information form:', error);
            showAlert('quoteInformationAlerts', 'Error al inicializar el formulario', 'danger');

            // Hide loader even if there's an error
            hidePageLoader('quoteInformationCard');
        }
    });
})();
</script>
