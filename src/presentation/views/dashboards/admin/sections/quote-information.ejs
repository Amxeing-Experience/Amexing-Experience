<script>
// Entity label (client-side): "Reservación" once the quote is scheduled.
const QE = window.__isReservation ? 'Reservación' : 'Cotización';
const Qe = window.__isReservation ? 'reservación' : 'cotización';
(function() {
    'use strict';

    let clientTomSelect = null;
    const userRole = '<%= typeof userRole !== "undefined" ? userRole : "admin" %>';
    
    // Current user data for department_manager (passed from server)
    const currentUserData = {
        id: '<%= typeof user !== "undefined" && user ? user.id : "" %>',
        name: '<%= typeof user !== "undefined" && user ? (user.firstName && user.lastName ? user.firstName + " " + user.lastName : user.name || user.email || "") : "" %>',
        email: '<%= typeof user !== "undefined" && user ? user.email || "" : "" %>',
        firstName: '<%= typeof user !== "undefined" && user ? user.firstName || "" : "" %>',
        lastName: '<%= typeof user !== "undefined" && user ? user.lastName || "" : "" %>',
        phone: '<%= typeof user !== "undefined" && user ? user.phone || "" : "" %>',
        clientId: '<%= typeof user !== "undefined" && user ? user.clientId || "" : "" %>',
        contextualData: <%-
            typeof user !== "undefined" && user && user.contextualData 
                ? JSON.stringify(user.contextualData) 
                : "{}"
        %>
    };
    
    // 🔍 DEBUG: Log currentUserData to verify contextualData is available
    console.log('🚀 DEBUG - currentUserData structure:', {
        userRole,
        hasContextualData: !!currentUserData.contextualData,
        contextualDataKeys: Object.keys(currentUserData.contextualData || {}),
        companyName: currentUserData.contextualData?.companyName,
        fullUserData: currentUserData
    });
    
    // Make currentUserData available globally for other scripts
    window.currentUserData = currentUserData;

    // ---- Contacto = propietario por defecto / Guardar lead guest como cliente ----
    // Datos del propietario: al editar vienen del quote (window.__quoteOwner); al crear, el
    // propietario es el usuario actual.
    function getOwnerData() {
        if (window.__quoteOwner && (window.__quoteOwner.firstName || window.__quoteOwner.email)) {
            return window.__quoteOwner;
        }
        return {
            firstName: currentUserData.firstName || '',
            lastName: currentUserData.lastName || '',
            email: currentUserData.email || '',
            phone: currentUserData.phone || '',
            fullName: currentUserData.name || `${currentUserData.firstName || ''} ${currentUserData.lastName || ''}`.trim(),
        };
    }

    // Valores de contacto a guardar. Por defecto el contacto es el Lead Guest (campos de
    // contacto, con fallback al Lead Guest si están vacíos). Si el checkbox "es propietario"
    // está marcado, se usan los datos del propietario.
    function resolveContactValues() {
        const isOwner = !!document.getElementById('contactDifferentFromOwner')?.checked;
        if (isOwner) {
            const o = getOwnerData();
            return {
                firstName: (o.firstName || '').trim(),
                lastName: (o.lastName || '').trim(),
                contactEmail: (o.email || '').trim(),
                contactPhone: (o.phone || '').trim(),
            };
        }
        const cf = document.getElementById('contactFirstName').value.trim();
        const cl = document.getElementById('contactLastName').value.trim();
        const lgf = document.getElementById('leadGuestFirstName')?.value.trim() || '';
        const lgl = document.getElementById('leadGuestLastName')?.value.trim() || '';
        return {
            firstName: cf || lgf,
            lastName: cl || lgl,
            contactEmail: document.getElementById('contactEmail').value.trim(),
            contactPhone: document.getElementById('contactPhone').value.trim(),
        };
    }

    // El checkbox "El contacto es el propietario" INVIERTE el default: por defecto el contacto es
    // el Lead Guest (campos visibles); si se marca, el contacto es el propietario (campos ocultos
    // + resumen con a quién se usará).
    function syncContactFieldsVisibility() {
        const isOwner = !!document.getElementById('contactDifferentFromOwner')?.checked;
        document.getElementById('contactFieldsWrapper')?.classList.toggle('d-none', isOwner);
        const summary = document.getElementById('contactOwnerSummary');
        if (summary) {
            summary.classList.toggle('d-none', !isOwner);
            if (isOwner) {
                const o = getOwnerData();
                const name = (o.fullName || `${o.firstName || ''} ${o.lastName || ''}`).trim() || '—';
                const email = (o.email || '').trim();
                const txtEl = document.getElementById('contactOwnerSummaryText');
                if (txtEl) txtEl.textContent = email ? `${name} · ${email}` : name;
            }
        }
    }

    // Deriva el estado del checkbox al cargar: marcado ("es propietario") si el contacto guardado
    // coincide con el propietario; si hay contacto/lead guest que difiere → desmarcado (contacto =
    // Lead Guest); si no hay nada capturado → propietario por defecto.
    function initContactDifferentFromQuote(quote) {
        const cb = document.getElementById('contactDifferentFromOwner');
        if (!cb) return;
        const o = getOwnerData();
        const norm = (s) => (s || '').trim().toLowerCase();
        const cEmail = norm(quote.contactEmail);
        const oEmail = norm(o.email);
        const cName = norm(quote.contactPerson) || norm(`${quote.contactFirstName || ''} ${quote.contactLastName || ''}`);
        const oName = norm(o.fullName) || norm(`${o.firstName || ''} ${o.lastName || ''}`);
        const hasLeadGuest = !!(quote.leadGuestFirstName || quote.leadGuestLastName);
        let isOwner;
        if (cEmail && oEmail) {
            isOwner = cEmail === oEmail;
        } else if (cName && oName) {
            isOwner = cName === oName;
        } else if (cEmail || cName || hasLeadGuest) {
            isOwner = false; // hay contacto/lead guest capturado → no es el propietario
        } else {
            isOwner = true; // nada capturado → propietario por defecto
        }
        cb.checked = isOwner;
        syncContactFieldsVisibility();
    }

    // ¿El cliente guardado desde Lead Guest quedará como cliente de una AGENCIA?
    // Solo aplica a admin/superadmin en modo agencia (con agencia seleccionada): en ese caso el
    // cliente debe pertenecer a esa agencia, no guardarse como directo de Amexing.
    // DM/agente NO entran aquí: su /quick ya los guarda como agency_client de su propia agencia.
    // (Detección por DOM, no por currentClientType, para evitar TDZ en llamadas tempranas.)
    function leadGuestSavesAsAgencyClient() {
        const isAmexingAdmin = (userRole === 'admin' || userRole === 'superadmin');
        if (!isAmexingAdmin) return false;
        const enterpriseId = document.getElementById('clientId')?.value || '';
        if (!enterpriseId) return false;
        const agencyRow = document.getElementById('agencyClientRow');
        const directRow = document.getElementById('directClientRow');
        const agencyVisible = !!agencyRow && window.getComputedStyle(agencyRow).display !== 'none';
        const directVisible = !!directRow && window.getComputedStyle(directRow).display !== 'none';
        return agencyVisible && !directVisible;
    }
    // Nota + selector junto a "Guardar cliente" (solo admin). En modo DIRECTO se puede elegir la
    // categoría del cliente (selector visible, nota oculta); en modo AGENCIA queda como cliente de la
    // agencia (nota visible, selector oculto).
    function updateSaveClientNote() {
        const note = document.getElementById('saveClientCategoryNote');
        if (!note) return; // solo existe para admin/superadmin
        const agencyRow = document.getElementById('agencyClientRow');
        const directRow = document.getElementById('directClientRow');
        const agencyVisible = !!agencyRow && window.getComputedStyle(agencyRow).display !== 'none';
        const directVisible = !!directRow && window.getComputedStyle(directRow).display !== 'none';
        const isDirect = directVisible && !agencyVisible;
        note.textContent = isDirect
            ? '(se guardará como cliente directo)'
            : '(se guardará como cliente de la agencia)';
        note.classList.toggle('d-none', isDirect); // en directo lo reemplaza el selector de categoría
        const wrap = document.getElementById('saveClientCategoryWrap');
        if (wrap) wrap.classList.toggle('d-none', !isDirect); // selector de categoría solo en directo
    }
    document.getElementById('clientId')?.addEventListener('change', updateSaveClientNote);

    // Guarda el lead guest como cliente en el sistema (owned-clients) si se marcó el checkbox.
    async function maybeSaveLeadGuestAsClient() {
        const cb = document.getElementById('saveLeadGuestAsClient');
        if (!cb || !cb.checked) return false;
        const firstName = document.getElementById('leadGuestFirstName')?.value.trim();
        const lastName = document.getElementById('leadGuestLastName')?.value.trim();
        if (!firstName || !lastName) return false; // el endpoint requiere nombre y apellido
        // Admin en cotización de AGENCIA → guardar como cliente de esa agencia (agency_client bajo
        // el enterpriseId) vía admin-create-subclient. En cualquier otro caso → /quick (directo para
        // admin; agencia propia para DM/agente).
        const asAgencySubclient = leadGuestSavesAsAgencyClient();
        const endpoint = asAgencySubclient
            ? '/api/owned-clients/admin-create-subclient'
            : '/api/owned-clients/quick';
        // En /quick (admin directo) se manda la categoría elegida (Cliente Directo / Wedding Planner /
        // Concierge / Home Owner). El backend la valida y solo la aplica al crear como directo; para
        // DM/agente la ignora (siempre agency_client). En agencia va por enterpriseId, sin categoría.
        const catSel = document.getElementById('saveClientCategory');
        const payload = asAgencySubclient
            ? { firstName, lastName, enterpriseId: document.getElementById('clientId')?.value || '' }
            : { firstName, lastName, ...(catSel && catSel.value ? { clientCategory: catSel.value } : {}) };
        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${getAccessToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });
            const result = await response.json();
            if (result && result.success) {
                cb.checked = false; // evitar recrearlo en un guardado posterior
                // Agregar el nuevo cliente al selector "Cliente Final" en caliente.
                if (result.data) {
