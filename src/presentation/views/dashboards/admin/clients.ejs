<%
/**
 * Admin Clients Management Page
 * Follows main dashboard layout structure with atomic design components
 *
 * Layout Structure (matching main dashboard):
 * - Direct row/column structure (no body-wrapper)
 * - Container-fluid from Flexy Bootstrap
 * - Consistent spacing and alignment
 *
 * Note: DataTables CSS/JS libraries are loaded via controller (pageStyles & footerScripts)
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const currentPath = '/dashboard/admin/clients';
%>

<!-- Page Header with Breadcrumb -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1 fw-bold">Gestión de Clientes</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/dashboard/admin" class="text-decoration-none">
                                <i class="ti ti-home me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <i class="ti ti-building me-1"></i>Clientes
                        </li>
                    </ol>
                </nav>
            </div>
            <div class="text-muted">
                <small class="d-block">Total clientes registrados</small>
                <strong id="total-clients-count">-</strong>
            </div>
        </div>
    </div>
</div>


<!-- Clients DataTable -->
<div class="row">
    <div class="col-12">
        <%- include('../../organisms/datatable/clients-table', {
            tableId: 'clients-table',
            apiEndpoint: '/api/clients/mixed',
            userRole: currentUserRole,
            showActions: true
        }) %>
    </div>
</div>

<!-- Client Management Modals -->
<!-- Create Client Modal -->
<div class="modal fade" id="createClientModal" tabindex="-1" aria-labelledby="createClientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="createClientModalLabel">
                    <i class="ti ti-building-plus me-2"></i>Crear Nuevo Cliente
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Modal Alert Container -->
                <div id="modalAlertContainer" class="mb-3" style="display: none;">
                    <div id="modalAlert" class="alert" role="alert">
                        <i id="modalAlertIcon" class="me-2"></i>
                        <span id="modalAlertMessage"></span>
                    </div>
                </div>

                <!-- Client Type Selector -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="ti ti-category me-1"></i>
                        Tipo de Cliente
                    </h6>
                    
                    <!-- Segmented Control -->
                    <div class="btn-group w-100" role="group" aria-label="Client Type Selector" id="clientTypeSelector">
                        <input type="radio" class="btn-check" name="clientType" id="agencyType" value="agency" checked>
                        <label class="btn btn-outline-primary" for="agencyType">
                            <i class="ti ti-building me-2"></i>Agencia
                        </label>

                        <input type="radio" class="btn-check" name="clientType" id="clientType" value="client">
                        <label class="btn btn-outline-primary" for="clientType">
                            <i class="ti ti-user me-2"></i>Cliente
                        </label>
                    </div>
                    
                    <div class="form-text mt-2">
                        <span id="typeHelpText">
                            <strong>Agencia:</strong> Usuario con acceso al sistema para gestionar sus propios clientes y reservas.
                        </span>
                    </div>
                </div>

                <!-- Agency Form -->
                <div id="agencyForm">
                    <form id="createAgencyForm">
                    <!-- Sección: Información del Representante -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-user me-1"></i>
                            Información del Representante
                        </h6>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'firstName',
                                    id: 'clientFirstName',
                                    label: 'Nombre del Representante',
                                    required: true,
                                    placeholder: 'Ej: Juan',
                                    helpText: 'Nombre del contacto principal',
                                    inputAttributes: { maxlength: '100' }
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'lastName',
                                    id: 'clientLastName',
                                    label: 'Apellido del Representante',
                                    required: true,
                                    placeholder: 'Ej: Pérez García',
                                    inputAttributes: { maxlength: '100' }
                                }) %>
                            </div>
                        </div>

                        <%- include('../../atoms/common/email-input', {
                            name: 'email',
                            id: 'clientEmail',
                            label: 'Email Corporativo',
                            required: true,
                            placeholder: 'contacto@empresa.com',
                            helpText: 'Email del representante para acceso al sistema',
                            maxlength: 255
                        }) %>

                        <!-- Custom Password Field with Toggle and Copy -->
                        <div class="mb-3">
                            <label for="clientPassword" class="form-label fw-semibold">
                                Contraseña <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input 
                                    type="password" 
                                    class="form-control" 
                                    id="clientPassword" 
                                    name="password" 
                                    placeholder="Contraseña segura"
                                    minlength="12"
                                    maxlength="100"
                                    autocomplete="new-password"
                                    required
                                >
                                <button 
                                    class="btn btn-outline-primary" 
                                    type="button" 
                                    id="generatePassword"
                                    title="Generar contraseña segura"
                                >
                                    <i class="ti ti-key" id="generateIcon"></i>
                                </button>
                                <button 
                                    class="btn btn-outline-secondary" 
                                    type="button" 
                                    id="togglePasswordVisibility"
                                    title="Mostrar/Ocultar contraseña"
                                >
                                    <i class="ti ti-eye" id="passwordToggleIcon"></i>
                                </button>
                                <button 
                                    class="btn btn-outline-secondary" 
                                    type="button" 
                                    id="copyPassword"
                                    title="Copiar contraseña"
                                >
                                    <i class="ti ti-copy" id="copyIcon"></i>
                                </button>
                            </div>
                            <div class="form-text">
                                Mínimo 12 caracteres, incluir mayúsculas, minúsculas, números y caracteres especiales
                            </div>
                            <!-- Password validation feedback -->
                            <div id="passwordValidationFeedback" class="invalid-feedback" style="display: none;">
                                <ul class="mb-0" id="passwordValidationList">
                                    <li id="lengthRequirement" class="text-danger">
                                        <i class="ti ti-x-circle me-1"></i>Mínimo 12 caracteres
                                    </li>
                                    <li id="uppercaseRequirement" class="text-danger">
                                        <i class="ti ti-x-circle me-1"></i>Al menos una letra mayúscula
                                    </li>
                                    <li id="lowercaseRequirement" class="text-danger">
                                        <i class="ti ti-x-circle me-1"></i>Al menos una letra minúscula
                                    </li>
                                    <li id="numberRequirement" class="text-danger">
                                        <i class="ti ti-x-circle me-1"></i>Al menos un número
                                    </li>
                                    <li id="specialCharRequirement" class="text-danger">
                                        <i class="ti ti-x-circle me-1"></i>Al menos un carácter especial (!@#$%^&*...)
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Sección: Información de la Empresa -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-building me-1"></i>
                            Información de la Empresa
                        </h6>

                        <%- include('../../molecules/common/form-field', {
                            type: 'text',
                            name: 'companyName',
                            id: 'companyName',
                            label: 'Nombre de la Empresa',
                            required: true,
                            placeholder: 'Ej: Tecnología y Servicios S.A. de C.V.',
                            helpText: 'Razón social o nombre comercial',
                            inputAttributes: { maxlength: '200' }
                        }) %>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../atoms/common/phone-input', {
                                    name: 'phone',
                                    id: 'clientPhone',
                                    label: 'Teléfono de Contacto',
                                    required: false,
                                    helpText: 'Número de contacto del representante',
                                    countryCode: 'MX'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'taxId',
                                    id: 'clientTaxId',
                                    label: 'RFC / Tax ID',
                                    required: false,
                                    placeholder: 'ABC123456XXX',
                                    helpText: 'Registro Federal de Contribuyentes',
                                    inputAttributes: { maxlength: '13' }
                                }) %>
                            </div>
                        </div>

                        <%- include('../../molecules/common/form-field', {
                            type: 'url',
                            name: 'website',
                            id: 'clientWebsite',
                            label: 'Sitio Web',
                            required: false,
                            placeholder: 'https://www.empresa.com'
                        }) %>
                    </div>

                    <!-- Sección: Dirección Fiscal -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-map-pin me-1"></i>
                            Dirección Fiscal
                        </h6>

                        <%- include('../../molecules/common/form-field', {
                            type: 'text',
                            name: 'addressStreet',
                            id: 'addressStreet',
                            label: 'Calle y Número',
                            required: false,
                            placeholder: 'Av. Principal #123, Col. Centro',
                            inputAttributes: { maxlength: '200' }
                        }) %>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'addressCity',
                                    id: 'addressCity',
                                    label: 'Ciudad',
                                    required: false,
                                    placeholder: 'Mérida',
                                    inputAttributes: { maxlength: '100' }
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'addressState',
                                    id: 'addressState',
                                    label: 'Estado',
                                    required: false,
                                    placeholder: 'Yucatán',
                                    inputAttributes: { maxlength: '100' }
                                }) %>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'addressZipCode',
                                    id: 'addressZipCode',
                                    label: 'Código Postal',
                                    required: false,
                                    placeholder: '97000',
                                    inputAttributes: { maxlength: '10' }
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../molecules/common/form-field', {
                                    type: 'text',
                                    name: 'addressCountry',
                                    id: 'addressCountry',
                                    label: 'País',
                                    required: false,
                                    value: 'México',
                                    inputAttributes: { maxlength: '100' }
                                }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Sección: Notas Adicionales -->
                    <div class="mb-3">
                        <%- include('../../molecules/common/form-field', {
                            type: 'textarea',
                            name: 'notes',
                            id: 'clientNotes',
                            label: 'Notas Adicionales',
                            required: false,
                            placeholder: 'Información relevante sobre el cliente...',
                            inputAttributes: { maxlength: '500', rows: '3' }
                        }) %>
                        <!-- Contenedor flex para helpText y contador en la misma línea -->
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted">Máximo 500 caracteres</small>
                            <small id="notesCharCount" class="text-muted">0/500</small>
                        </div>
                    </div>

                    <!-- Alert informativo -->
                    <div class="alert alert-info d-flex align-items-start" role="alert">
                        <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                        <div>
                            <strong>Acceso al sistema:</strong>
                            <p class="mb-0 mt-1">El cliente podrá acceder al sistema con el email corporativo y la contraseña proporcionada. Podrá cambiar su contraseña desde su perfil.</p>
                        </div>
                    </div>
                    </form>
                </div>

                <!-- Client Form (Hidden by default) -->
                <div id="clientForm" style="display: none;">
                    <form id="createClientDirectForm">
                        <!-- Sección: Información del Cliente -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="ti ti-user me-1"></i>
                                Información del Cliente
                            </h6>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="directClientCategory">Tipo de Cliente</label>
                                    <select class="form-select" id="directClientCategory" name="clientCategory">
                                        <option value="direct_client" selected>Cliente Directo</option>
                                        <option value="wedding_planner">Wedding Planner</option>
                                        <option value="concierge">Concierge</option>
                                        <option value="home_owner">Home Owner</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/first-name-input', {
                                        name: 'firstName',
                                        id: 'directClientFirstName',
                                        label: 'Nombre',
                                        required: true,
                                        placeholder: 'Ej: Juan',
                                        helpText: 'Primer nombre del cliente'
                                    }) %>
                                </div>
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/last-name-input', {
                                        name: 'lastName',
                                        id: 'directClientLastName',
                                        label: 'Apellido',
                                        required: true,
                                        placeholder: 'Ej: Pérez',
                                        helpText: 'Apellido(s) del cliente'
                                    }) %>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/email-input', {
                                        name: 'email',
                                        id: 'directClientEmail',
                                        label: 'Correo Electrónico',
                                        required: false,
                                        placeholder: 'cliente@empresa.com',
                                        helpText: 'Email de contacto principal'
                                    }) %>
                                </div>
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/phone-input', {
                                        name: 'phone',
                                        id: 'directClientPhone',
                                        label: 'Teléfono',
                                        required: false,
                                        countryCode: 'MX',
                                        placeholder: '999 123 4567',
                                        helpText: 'Número de contacto principal'
                                    }) %>
                                </div>
                            </div>
                        </div>

                        <!-- Sección: Persona de Contacto y Emergencia -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="ti ti-users me-1"></i>
                                Contactos
                            </h6>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/first-name-input', {
                                        name: 'contactFirstName',
                                        id: 'directClientContactFirstName',
                                        label: 'Nombre de Contacto',
                                        required: false,
                                        placeholder: 'Ej: María',
                                        helpText: 'Nombre de la persona de contacto en la empresa'
                                    }) %>
                                </div>
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/last-name-input', {
                                        name: 'contactLastName',
                                        id: 'directClientContactLastName',
                                        label: 'Apellido de Contacto',
                                        required: false,
                                        placeholder: 'Ej: García',
                                        helpText: 'Apellido de la persona de contacto'
                                    }) %>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/emergency-contact-input', {
                                        name: 'emergencyContactName',
                                        id: 'directClientEmergencyContactName',
                                        label: 'Contacto de Emergencia',
                                        required: false,
                                        placeholder: 'Ej: Carlos Pérez',
                                        helpText: 'Persona a contactar en caso de emergencia'
                                    }) %>
                                </div>
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/emergency-phone-input', {
                                        name: 'emergencyContactPhone',
                                        id: 'directClientEmergencyContactPhone',
                                        label: 'Teléfono de Emergencia',
                                        required: false,
                                        countryCode: 'MX',
                                        placeholder: '999 123 4567',
                                        helpText: 'Número disponible 24/7'
                                    }) %>
                                </div>
                            </div>
                        </div>

                        <!-- Sección: Información de la Empresa -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="ti ti-building me-1"></i>
                                Información de la Empresa
                            </h6>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../molecules/common/form-field', {
                                        type: 'select',
                                        name: 'companyType',
                                        id: 'directClientCompanyType',
                                        label: 'Tipo de Empresa',
                                        required: false,
                                        options: [
                                            { value: '', text: 'Seleccione un tipo' },
                                            { value: 'individual', text: 'Persona Física' },
                                            { value: 'corporate', text: 'Persona Moral' },
                                            { value: 'travel_agency', text: 'Agencia de Viajes' },
                                            { value: 'tour_operator', text: 'Tour Operador' },
                                            { value: 'other', text: 'Otro' }
                                        ],
                                        helpText: 'Tipo de organización'
                                    }) %>
                                </div>
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/rfc-input', {
                                        name: 'taxId',
                                        id: 'directClientTaxId',
                                        label: 'RFC / ID Fiscal',
                                        required: false,
                                        placeholder: 'ABC123456789 o ABCD123456ABC',
                                        helpText: 'Registro Federal de Contribuyentes'
                                    }) %>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/url-input', {
                                        name: 'website',
                                        id: 'directClientWebsite',
                                        label: 'Sitio Web',
                                        required: false,
                                        placeholder: 'https://www.ejemplo.com',
                                        helpText: 'URL completa del sitio web de la empresa'
                                    }) %>
                                </div>
                            </div>

                            <!-- Sección: Dirección Detallada -->
                            <div class="row">
                                <div class="col-12 mb-2">
                                    <h6 class="text-muted small fw-bold">
                                        <i class="ti ti-map-pin me-1"></i>
                                        Dirección Completa
                                    </h6>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-3">
                                    <%- include('../../atoms/common/street-type-select', {
                                        name: 'streetType',
                                        id: 'directClientStreetType',
                                        label: 'Tipo de Vialidad',
                                        required: false,
                                        helpText: 'Tipo de vía',
                                        value: 'Calle'
                                    }) %>
                                </div>
                                <div class="col-md-5">
                                    <%- include('../../atoms/common/street-name-input', {
                                        name: 'streetName',
                                        id: 'directClientStreetName',
                                        label: 'Nombre de la Calle',
                                        required: false,
                                        placeholder: 'Ej: Reforma, 60, Insurgentes',
                                        helpText: 'Nombre de la calle'
                                    }) %>
                                </div>
                                <div class="col-md-2">
                                    <%- include('../../atoms/common/exterior-number-input', {
                                        name: 'exteriorNumber',
                                        id: 'directClientExteriorNumber',
                                        label: 'No. Exterior',
                                        required: false,
                                        placeholder: '123',
                                        helpText: 'Número exterior'
                                    }) %>
                                </div>
                                <div class="col-md-2">
                                    <%- include('../../atoms/common/interior-number-input', {
                                        name: 'interiorNumber',
                                        id: 'directClientInteriorNumber',
                                        label: 'No. Interior',
                                        required: false,
                                        placeholder: '4B',
                                        helpText: 'Depto/oficina'
                                    }) %>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <%- include('../../atoms/common/colonia-input', {
                                        name: 'colonia',
                                        id: 'directClientColonia',
                                        label: 'Colonia',
                                        required: false,
                                        placeholder: 'Ej: Centro, Roma Norte',
                                        helpText: 'Nombre de la colonia'
                                    }) %>
                                </div>
                                <div class="col-md-4">
                                    <%- include('../../atoms/common/city-input', {
                                        name: 'city',
                                        id: 'directClientCity',
                                        label: 'Ciudad / Municipio',
                                        required: false,
                                        placeholder: 'Ej: Mérida, Guadalajara',
                                        helpText: 'Ciudad o municipio'
                                    }) %>
                                </div>
                                <div class="col-md-4">
                                    <%- include('../../atoms/common/state-select', {
                                        name: 'state',
                                        id: 'directClientState',
                                        label: 'Estado',
                                        required: false,
                                        helpText: 'Estado o región',
                                        value: ''
                                    }) %>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <%- include('../../atoms/common/postal-code-input', {
                                        name: 'postalCode',
                                        id: 'directClientPostalCode',
                                        label: 'Código Postal',
                                        required: false,
                                        placeholder: '12345',
                                        helpText: '5 dígitos',
                                        country: 'MX'
                                    }) %>
                                </div>
                                <div class="col-md-8">
                                    <!-- Spacer -->
                                </div>
                            </div>
                        </div>

                        <!-- Sección: Requerimientos Especiales -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="ti ti-heart me-1"></i>
                                Requerimientos Especiales
                            </h6>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/language-select', {
                                        name: 'preferredLanguage',
                                        id: 'directClientPreferredLanguage',
                                        label: 'Idioma Preferido',
                                        required: false,
                                        helpText: 'Idioma para comunicaciones y servicios',
                                        value: 'es'
                                    }) %>
                                </div>
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/accessibility-input', {
                                        name: 'accessibilityRequirements',
                                        id: 'directClientAccessibilityRequirements',
                                        label: 'Requerimientos de Accesibilidad',
                                        required: false,
                                        placeholder: 'Ej: Silla de ruedas, bastón, asistencia visual...',
                                        helpText: 'Necesidades especiales de accesibilidad'
                                    }) %>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/allergies-input', {
                                        name: 'allergies',
                                        id: 'directClientAllergies',
                                        label: 'Alergias',
                                        required: false,
                                        placeholder: 'Ingrese cada alergia en una línea separada',
                                        helpText: 'Una alergia por línea para mejor organización'
                                    }) %>
                                </div>
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/dietary-restrictions-input', {
                                        name: 'dietaryRestrictions',
                                        id: 'directClientDietaryRestrictions',
                                        label: 'Restricciones Alimenticias',
                                        required: false,
                                        placeholder: 'Ingrese cada restricción en una línea separada',
                                        helpText: 'Una restricción por línea para mejor organización'
                                    }) %>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12">
