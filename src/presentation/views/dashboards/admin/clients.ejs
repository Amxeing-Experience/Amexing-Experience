    /**
     * Initialize validations for copied form elements
     * Since innerHTML copying doesn't execute scripts, we need to manually attach validation logic
     */
    function initializeFormValidations(form) {
        // Email validation
        const emailInputs = form.querySelectorAll('input[type="email"]');
        emailInputs.forEach(emailInput => {
            const EMAIL_PATTERN = /^[a-zA-Z0-9.!#$%&'*+\/=?^_`{\|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
            
            // Email normalization on blur
            emailInput.addEventListener('blur', function() {
                if (this.value) {
                    this.value = this.value.toLowerCase().trim();
                }
            });

            // Real-time validation on input
            emailInput.addEventListener('input', function() {
                const value = this.value.trim();
                const isRequired = this.hasAttribute('required');

                if (!value && !isRequired) {
                    this.classList.remove('is-invalid', 'is-valid');
                    return;
                }

                if (!value && isRequired) {
                    this.classList.add('is-invalid');
                    this.classList.remove('is-valid');
                    return;
                }

                if (EMAIL_PATTERN.test(value)) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.add('is-invalid');
                    this.classList.remove('is-valid');
                }
            });
        });

        // Phone validation is now handled by the phone-input component
        // which provides proper country-specific validation

        // RFC validation
        const rfcInputs = form.querySelectorAll('input[data-rfc-input]');
        rfcInputs.forEach(rfcInput => {
            const RFC_MORAL_PATTERN = /^[A-ZÑ&]{3}[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[A-Z0-9]{3}$/;
            const RFC_FISICA_PATTERN = /^[A-ZÑ&]{4}[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[A-Z0-9]{3}$/;
            const RFC_GENERIC = /^XAXX010101000$/;
            const RFC_FOREIGN = /^XEXX010101000$/;

            // Auto-uppercase on input
            rfcInput.addEventListener('input', function() {
                let value = this.value.toUpperCase();
                value = value.replace(/[^A-ZÑ&0-9]/g, '');
                
                if (value !== this.value) {
                    this.value = value;
                }

                const isRequired = this.hasAttribute('required');
                if (!value && !isRequired) {
                    this.classList.remove('is-invalid', 'is-valid');
                } else if (!value && isRequired) {
                    this.classList.add('is-invalid');
                    this.classList.remove('is-valid');
                } else {
                    const isValidMoral = RFC_MORAL_PATTERN.test(value);
                    const isValidFisica = RFC_FISICA_PATTERN.test(value);
                    const isGeneric = RFC_GENERIC.test(value);
                    const isForeign = RFC_FOREIGN.test(value);
                    
                    const isValid = isValidMoral || isValidFisica || isGeneric || isForeign;

                    if (isValid) {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                    } else {
                        this.classList.add('is-invalid');
                        this.classList.remove('is-valid');
                    }
                }
            });

            // Prevent invalid characters on keypress
            rfcInput.addEventListener('keypress', function(e) {
                const char = String.fromCharCode(e.which || e.keyCode);
                if ([8, 9, 27, 13, 46].indexOf(e.keyCode) !== -1) {
                    return true;
                }
                if (!/[A-ZÑ&0-9]/i.test(char)) {
                    e.preventDefault();
                    return false;
                }
            });
        });

        // Name inputs validation
        const nameInputs = form.querySelectorAll('input[pattern*="a-zA-Z"]');
        nameInputs.forEach(nameInput => {
            nameInput.addEventListener('input', function() {
                const value = this.value.trim();
                const pattern = this.getAttribute('pattern');
                const isRequired = this.hasAttribute('required');

                if (!value && !isRequired) {
                    this.classList.remove('is-invalid', 'is-valid');
                } else if (!value && isRequired) {
                    this.classList.add('is-invalid');
                    this.classList.remove('is-valid');
                } else if (pattern && new RegExp(pattern).test(value)) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else if (pattern) {
                    this.classList.add('is-invalid');
                    this.classList.remove('is-valid');
                } else if (value.length >= 2) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.add('is-invalid');
                    this.classList.remove('is-valid');
                }
            });
        });

        // Postal code validation (matching atomic component behavior)
        const postalInputs = form.querySelectorAll('input[inputmode="numeric"]');
        postalInputs.forEach(postalInput => {
            // Input event - strip non-digits and validate
            postalInput.addEventListener('input', function() {
                let value = this.value;
                
                // Only allow numbers (Mexican postal codes)
                value = value.replace(/\D/g, '');
                this.value = value;
                
                // Validate Mexican postal code (5 digits)
                if (/^[0-9]{5}$/.test(value)) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else if (value.length > 0) {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                } else {
                    this.classList.remove('is-valid', 'is-invalid');
                }
            });
            
            // Prevent invalid characters on keypress
            postalInput.addEventListener('keypress', function(e) {
                const char = String.fromCharCode(e.which);
                if (!/[0-9]/.test(char)) {
                    e.preventDefault();
                }
            });
            
            // Trim on blur
            postalInput.addEventListener('blur', function() {
                this.value = this.value.trim();
            });
        });

        // Initialize accessibility input quick buttons
        // This is needed because the form is copied with innerHTML which doesn't run scripts
        const accessibilityInputs = form.querySelectorAll('[id$="AccessibilityRequirements"]');
        accessibilityInputs.forEach(input => {
            if (window.initializeAccessibilityInput) {
                window.initializeAccessibilityInput(input.id);
            }
        });

        console.log('Form validations initialized for edit modal');
    }

    /**
     * Save client changes
     */
    document.addEventListener('click', function(e) {
        if (e.target.id === 'saveClientChanges') {
            saveClientChanges();
        }
    });

    /**
     * Execute save client changes
     */
    async function saveClientChanges() {
        const form = document.getElementById('editClientForm');
        const saveBtn = document.getElementById('saveClientChanges');
        
        if (!form) return;

        // Get client ID and type from hidden fields
        const clientId = document.getElementById('editClientId')?.value;
        const clientType = document.getElementById('editClientType')?.value;
        
        if (!clientId || !clientType) {
            console.error('Missing client ID or type');
            return;
        }
        
        const formData = new FormData(form);
        
        // Convert FormData to regular object
        const data = {};
        for (const [key, value] of formData.entries()) {
            if (key !== 'clientId' && key !== 'clientType') {
                data[key] = value;
            }
        }

        // Show loading state
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

        try {
            // Determine API endpoint based on client type
            let apiEndpoint;
            if (clientType === 'agency') {
                apiEndpoint = `/api/clients/${clientId}`;
            } else {
                apiEndpoint = `/api/owned-clients/${clientId}`;
            }

            const response = await fetch(apiEndpoint, {
                method: 'PUT',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(data)
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const result = await response.json();
            
            if (!result.success) {
                throw new Error(result.error || 'Error al guardar los cambios');
            }

            // Show success message
            showEditModalAlert('success', 'ti-check-circle', 'Cliente actualizado exitosamente');
            
            // Reload the clients table
            if (window.clientsTable) {
                window.clientsTable.ajax.reload();
            }

            // Close modal after a short delay
            setTimeout(() => {
                bootstrap.Modal.getInstance(document.getElementById('editClientModal')).hide();
            }, 1500);

        } catch (error) {
            console.error('Error saving client changes:', error);
            showEditModalAlert('danger', 'ti-alert-circle', error.message || 'Error al guardar los cambios');
        } finally {
            // Restore button state
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="ti ti-device-floppy me-1"></i>Guardar Cambios';
        }
    }

    /**
     * Show alert in edit modal
     */
    function showEditModalAlert(type, icon, message) {
        const alertContainer = document.getElementById('editModalAlertContainer');
        const alert = document.getElementById('editModalAlert');
        const alertIcon = document.getElementById('editModalAlertIcon');
        const alertMessage = document.getElementById('editModalAlertMessage');

        alert.className = `alert alert-${type}`;
        alertIcon.className = `ti ${icon} me-2`;
        alertMessage.textContent = message;
        alertContainer.style.display = 'block';
    }

    /**
     * Hide alert in edit modal
     */
    function hideEditModalAlert() {
        const alertContainer = document.getElementById('editModalAlertContainer');
        alertContainer.style.display = 'none';
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Update total count when table loads (listen to custom event)
        document.addEventListener('clientsTableLoaded', function(e) {
            const count = e.detail?.count || 0;
            const countEl = document.getElementById('total-clients-count');
            if (countEl) {
                countEl.textContent = count;
            }
        });

        // Initialize client type selector
        initializeClientTypeSelector();
        
        // Initialize create client modal
        console.log('About to initialize create client modal');
        initializeCreateClientModal();
        console.log('Create client modal initialization completed');
    });
</script>

