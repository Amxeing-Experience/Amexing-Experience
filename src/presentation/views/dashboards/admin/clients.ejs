    // ========================================================================

    /**
     * Initialize client type selector functionality
     */
    function initializeClientTypeSelector() {
        const agencyRadio = document.getElementById('agencyType');
        const clientRadio = document.getElementById('clientType');
        const agencyForm = document.getElementById('agencyForm');
        const clientForm = document.getElementById('clientForm');
        const helpText = document.getElementById('typeHelpText');

        if (!agencyRadio || !clientRadio || !agencyForm || !clientForm || !helpText) {
            return;
        }

        function updateFormVisibility() {
            if (agencyRadio.checked) {
                agencyForm.style.display = 'block';
                clientForm.style.display = 'none';
                helpText.innerHTML = '<strong>Agencia:</strong> Usuario con acceso al sistema para gestionar sus propios clientes y reservas.';
            } else {
                agencyForm.style.display = 'none';
                clientForm.style.display = 'block';
                helpText.innerHTML = '<strong>Cliente:</strong> Cliente directo de Amexing sin acceso al sistema de gestión.';
            }
        }

        // Add event listeners
        agencyRadio.addEventListener('change', updateFormVisibility);
        clientRadio.addEventListener('change', updateFormVisibility);

        // Set initial state
        updateFormVisibility();
    }


    // ========================================================================
    // EDIT CLIENT MODAL FUNCTIONALITY
    // ========================================================================

    /**
     * Handle edit client modal opening
     */
    document.addEventListener('openEditClientModal', async function(e) {
        const { clientId, clientType } = e.detail;
        await openEditClientModal(clientId, clientType);
    });

    /**
     * Open edit client modal and load data
     */
    async function openEditClientModal(clientId, clientType) {
        const modal = new bootstrap.Modal(document.getElementById('editClientModal'));
        const loadingEl = document.getElementById('editClientLoading');
        const formContainerEl = document.getElementById('editClientFormContainer');
        const saveBtn = document.getElementById('saveClientChanges');

        // Show modal and loading state
        modal.show();
        loadingEl.style.display = 'block';
        formContainerEl.style.display = 'none';
        saveBtn.style.display = 'none';
        hideEditModalAlert();

        try {
            // Determine the API endpoint based on client type
            let apiEndpoint;
            if (clientType === 'agency') {
                // For agencies, use regular clients endpoint
                apiEndpoint = `/api/clients/${clientId}`;
            } else {
                // For direct clients, use owned-clients endpoint
                apiEndpoint = `/api/owned-clients/${clientId}`;
            }

            // Fetch client data
            const response = await fetch(apiEndpoint, {
                method: 'GET',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const result = await response.json();
            
            if (!result.success) {
                throw new Error(result.error || 'Error al cargar los datos del cliente');
            }

            const clientData = result.data;

            // Populate edit form
            await populateEditForm(clientData, clientType);

            // Hide loading, show form
            loadingEl.style.display = 'none';
            formContainerEl.style.display = 'block';
            saveBtn.style.display = 'inline-block';

        } catch (error) {
            console.error('Error loading client data:', error);
            showEditModalAlert('danger', 'ti-alert-circle', error.message || 'Error al cargar los datos del cliente');
            loadingEl.style.display = 'none';
        }
    }

