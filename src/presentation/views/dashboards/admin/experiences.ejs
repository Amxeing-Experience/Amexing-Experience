<%
/**
 * Admin Experiences Management Page
 * Manages experiences catalog and experience categories
 * Features responsive detection for mobile optimization
 *
 * Layout Structure:
 * - Responsive detection and conditional loading
 * - Desktop: Vertical navigation menu (collapsible) + complex DataTables
 * - Mobile: Simplified mobile-first interface
 *
 * Note: DataTables CSS/JS libraries are loaded via controller
 * Created by Denisse Maldonado
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const activeSection = typeof section !== 'undefined' ? section : 'experiences';
const userAgent = typeof req !== 'undefined' ? req.get('User-Agent') : '';
const isMobileRequest = typeof req !== 'undefined' ? req.get('User-Agent').match(/Mobile|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i) : false;

// Menu items configuration
const menuItems = [
    { label: 'Experiencias', icon: 'star', section: 'experiences', href: '/dashboard/admin/experiences' },
    { label: 'Proveedores', icon: 'building-store', section: 'providers', href: '/dashboard/admin/experiences?section=providers' },
    { label: 'Establecimientos', icon: 'building', section: 'establishments', href: '/dashboard/admin/experiences?section=establishments' }
];

// Check if mobile version should be rendered
const forceMobile = typeof req !== 'undefined' ? req.query.mobile === 'true' : false;
const forceDesktop = typeof req !== 'undefined' ? req.query.desktop === 'true' : false;
const shouldRenderMobile = (forceMobile || isMobileRequest) && !forceDesktop;
%>

<!-- Mobile Detection and Conditional Loading -->
<script>
(function() {
    'use strict';
    
    // Check if we're already processing a mobile redirect
    const isProcessingRedirect = sessionStorage.getItem('mobileRedirectProcessing');
    if (isProcessingRedirect === 'true') {
        console.log('Mobile redirect already in progress, skipping...');
        return;
    }
    
    // Client-side mobile detection
    const MOBILE_BREAKPOINT = 992;
    const isMobile = window.innerWidth < MOBILE_BREAKPOINT;
    const isMobileDevice = /Mobile|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    const shouldUseMobile = isMobile || isMobileDevice;
    
    // Check URL parameters for manual override
    const urlParams = new URLSearchParams(window.location.search);
    const forceMobile = urlParams.get('mobile') === 'true';
    const forceDesktop = urlParams.get('desktop') === 'true';
    
    // Check if mobile version is already loaded server-side
    const mobileHeader = document.querySelector('.mobile-header');
    const isMobileVersionLoaded = !!mobileHeader;
    
    console.log('Mobile detection:', {
        isMobile,
        isMobileDevice,
        shouldUseMobile,
        forceMobile,
        forceDesktop,
        isMobileVersionLoaded
    });
    
    // Only redirect if we need mobile but don't have it, or vice versa
    if ((shouldUseMobile || forceMobile) && !forceDesktop && !isMobileVersionLoaded) {
        console.log('Switching to mobile experiences view...');
        
        // Set processing flag to prevent loops
        sessionStorage.setItem('mobileRedirectProcessing', 'true');
        
        // Show loading indicator
        document.body.innerHTML = `
            <div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column; color: #6b7280;">
                <div style="width: 40px; height: 40px; border: 4px solid #f3f4f6; border-top: 4px solid #f59e0b; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 1rem;"></div>
                <span>Optimizando para móvil...</span>
            </div>
            <style>
                @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
            </style>
        `;
        
        // Switch to mobile version after short delay
        setTimeout(() => {
            const currentUrl = new URL(window.location);
            currentUrl.searchParams.set('mobile', 'true');
            window.location.href = currentUrl.toString();
        }, 800);
        
        return; // Stop execution
    }
    
    // If we have mobile version but shouldn't (desktop override)
    if ((!shouldUseMobile || forceDesktop) && isMobileVersionLoaded && !forceMobile) {
        console.log('Switching to desktop experiences view...');
        
        // Set processing flag to prevent loops
        sessionStorage.setItem('mobileRedirectProcessing', 'true');
        
        setTimeout(() => {
            const currentUrl = new URL(window.location);
            currentUrl.searchParams.delete('mobile');
            if (forceDesktop) {
                currentUrl.searchParams.set('desktop', 'true');
            }
            window.location.href = currentUrl.toString();
        }, 100);
        
        return;
    }
    
    // Clear processing flag if no redirect needed
    sessionStorage.removeItem('mobileRedirectProcessing');
    
    // Mark body with appropriate class
    if (isMobileVersionLoaded) {
        document.body.classList.add('mobile-experiences');
    } else {
        document.body.classList.add('desktop-experiences');
    }
})();
</script>

<% if (shouldRenderMobile) { %>
    <!-- Load Mobile Version -->
    <%- include('./experiences-mobile', {
        userRole: currentUserRole,
        section: activeSection
    }) %>
<% } else { %>
    <!-- Load Desktop Version -->

<!-- Page Header with Breadcrumb -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-1 fw-bold">Gestión de Experiencias</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/dashboard/admin"><i class="ti ti-home me-1"></i>Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active">
                            <i class="ti ti-star me-1"></i>Experiencias
                        </li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/dashboard/admin" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i>Volver
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Section Navigation (pills) + acción de sección a la derecha -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <ul class="nav nav-pills experiences-pills mb-0">
        <% menuItems.forEach(function(item) { %>
            <li class="nav-item">
                <a href="<%= item.href %>" class="nav-link <%= item.section === activeSection ? 'active' : '' %>">
                    <i class="ti ti-<%= item.icon %> me-1"></i><%= item.label %>
                </a>
            </li>
        <% }); %>
    </ul>
    <% if (activeSection === 'providers' && ['superadmin', 'admin'].includes(currentUserRole)) { %>
        <button type="button" class="btn btn-sm text-white" style="background: var(--brand-gradient);" id="createProviderBtn">
            <i class="ti ti-plus me-1"></i>Nuevo Proveedor
        </button>
    <% } %>
</div>

<!-- Main Content (full width) -->
<div class="row">
    <div class="col-12" id="contentColumn">
        <% if (activeSection === 'experiences') { %>
            <!-- Experiences Management Section -->
            <%- include('../../organisms/datatable/experiences-table', {
                tableId: 'experiences-table',
                apiEndpoint: '/api/experiences',
                userRole: currentUserRole,
                showActions: true
            }) %>

        <% } else if (activeSection === 'providers') { %>
            <!-- Experience Providers Management Section -->

            <%- include('../../organisms/datatable/experience-providers-table', {
                tableId: 'experience-providers-table',
                apiEndpoint: '/api/experiences',
                userRole: currentUserRole,
                showActions: true
            }) %>

        <% } else if (activeSection === 'establishments') { %>
            <!-- Establishments Management Section -->

            <%- include('../../organisms/datatable/experience-establishments-table', {
                tableId: 'experience-establishments-table',
                apiEndpoint: '/api/experiences',
                userRole: currentUserRole,
                showActions: true
            }) %>

        <% } %>
    </div>
</div>

<!-- Vertical Menu Styles -->
<style>
/* Section pills (top navigation) */
.experiences-pills {
    gap: 0.5rem;
    flex-wrap: wrap;
}
.experiences-pills .nav-link {
    color: #5a6a85;
    font-weight: 500;
    border: 1px solid #e9ecef;
    background: #fff;
    transition: all 0.2s ease;
}
.experiences-pills .nav-link:hover {
    color: #f59e0b;
    border-color: #f59e0b;
}
.experiences-pills .nav-link.active {
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    color: #fff;
    border-color: transparent;
    font-weight: 600;
}

/* Vertical Menu Styles */
.vertical-menu {
    position: sticky;
    top: 1rem;
    transition: all 0.3s ease;
}

.vertical-menu.collapsed {
    max-width: 80px;
}

.menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.3s ease;
}

.vertical-menu.collapsed .menu-header {
    justify-content: center;
}

.vertical-menu.collapsed .menu-title,
.vertical-menu.collapsed .menu-label {
    opacity: 0;
    width: 0;
    overflow: hidden;
    transition: opacity 0.2s ease, width 0.3s ease;
}

.vertical-menu:not(.collapsed) .menu-title,
.vertical-menu:not(.collapsed) .menu-label {
    opacity: 1;
    width: auto;
    transition: opacity 0.3s ease 0.1s, width 0.3s ease;
}

.menu-toggle-btn {
    text-decoration: none;
    transition: transform 0.3s ease;
}

.menu-toggle-btn:hover {
    transform: scale(1.1);
    color: #f59e0b !important;
}

.menu-item {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    color: #5a6a85;
    text-decoration: none;
    border-radius: 0.375rem;
    margin-bottom: 0.25rem;
    transition: all 0.2s ease;
    white-space: nowrap;
}

.vertical-menu.collapsed .menu-item {
    justify-content: center;
    padding: 0.75rem;
}

.menu-item:hover {
    background-color: #f8f9fa;
    color: #f59e0b;
}

.menu-item.active {
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    color: white;
    font-weight: 600;
}

.menu-icon {
    font-size: 1.25rem;
    min-width: 1.25rem;
    transition: margin 0.3s ease;
}

.vertical-menu:not(.collapsed) .menu-icon {
    margin-right: 0.5rem;
}

.vertical-menu.collapsed .menu-icon {
    margin-right: 0;
}

.menu-label {
    transition: opacity 0.2s ease, width 0.3s ease;
}

/* Column transitions */
#menuColumn, #contentColumn {
    transition: all 0.3s ease;
}

#menuColumn.collapsed {
    flex: 0 0 auto;
    width: auto;
}

#contentColumn.expanded {
    flex: 1;
}

/* Breadcrumb styles */
.breadcrumb-item a {
    color: #5a6a85;
    text-decoration: none;
}

.breadcrumb-item a:hover {
    color: #f59e0b;
}

/* Responsive styles */
@media (max-width: 991.98px) {
    .vertical-menu {
        position: static;
    }
    #menuToggle {
        display: none;
    }
}
</style>

<!-- Menu Toggle Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.getElementById('menuToggle');
    const verticalMenu = document.querySelector('.vertical-menu');
    const menuColumn = document.getElementById('menuColumn');
    const contentColumn = document.getElementById('contentColumn');

    if (menuToggle && verticalMenu) {
        // Check localStorage for saved state
        const isCollapsed = localStorage.getItem('experiencesMenuCollapsed') === 'true';
        if (isCollapsed) {
            verticalMenu.classList.add('collapsed');
            menuColumn.classList.add('collapsed');
            contentColumn.classList.add('expanded');
        }

        // Toggle menu on button click
        menuToggle.addEventListener('click', function() {
            const isCurrentlyCollapsed = verticalMenu.classList.toggle('collapsed');
            menuColumn.classList.toggle('collapsed');
            contentColumn.classList.toggle('expanded');

            // Save state to localStorage
            localStorage.setItem('experiencesMenuCollapsed', isCurrentlyCollapsed);

            // Update aria-label
            this.setAttribute('aria-label', isCurrentlyCollapsed ? 'Expandir menú' : 'Colapsar menú');
        });
    }
});
</script>

<!-- Load Dropzone.js from CDN -->
<script src="https://unpkg.com/dropzone@6.0.0-beta.2/dist/dropzone-min.js"></script>
<link href="https://unpkg.com/dropzone@6.0.0-beta.2/dist/dropzone.css" rel="stylesheet" type="text/css" />

<!-- Mobile Detection Enhancement Script -->
<script>
// Add desktop experience enhancements
if (window.innerWidth >= 992) {
    document.body.classList.add('desktop-experiences');
    
    // Add desktop-specific features
    console.log('Desktop experiences view loaded');
    
    // Add toggle for mobile preview (dev feature)
    if (typeof isDevelopment !== 'undefined' && isDevelopment) {
        const mobilePreviewBtn = document.createElement('button');
        mobilePreviewBtn.innerHTML = '<i class="ti ti-device-mobile me-1"></i>Vista Móvil';
        mobilePreviewBtn.className = 'btn btn-outline-info btn-sm position-fixed';
        mobilePreviewBtn.style.cssText = 'top: 20px; right: 20px; z-index: 9999;';
        mobilePreviewBtn.onclick = () => {
            const url = new URL(window.location);
            url.searchParams.set('mobile', 'true');
            window.location.href = url.toString();
        };
        document.body.appendChild(mobilePreviewBtn);
    }
}
</script>

<% } /* End desktop version conditional */ %>

<!-- Responsive Detection Enhancement -->
<style>
/* Ensure smooth transitions between mobile and desktop */
body.switching-to-mobile {
    opacity: 0;
    transition: opacity 0.3s ease;
}

/* Desktop indicator */
@media (min-width: 992px) {
    body.desktop-experiences::after {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, #f59e0b, #fbbf24);
        z-index: 9999;
    }
}

/* Mobile optimization indicator */
@media (max-width: 991.98px) {
    body.mobile-experiences::after {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, #10b981, #34d399);
        z-index: 9999;
    }
}
</style>
