<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= pageTitle || 'Cotización' %></title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tabler Icons -->
    <link rel="stylesheet" href="/dashboard/css/icons/tabler-icons/tabler-icons.css">

    <!-- Custom favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
            padding: 2rem 0;
        }

        .public-quote-container {
            max-width: 1200px;
            margin: 0 auto;
            background: #fff;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            border-radius: 8px;
            padding: 2rem;
        }

        .public-header {
            text-align: center;
            /* margin-bottom: 2rem; */
            padding-bottom: 1rem;
        }

        .header-logo {
            margin-bottom: 1.5rem;
        }

        .header-folio {
            margin-top: 1rem;
        }

        .public-header h1 {
            background: #969b81;
            color: white;
            font-size: 1.2rem;
            font-weight: 400;
            letter-spacing: 0.3rem;
            text-transform: uppercase;
            padding: 0.75rem;
            margin: 0;
            display: block;
            border-radius: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            width: 100%;
            text-align: center;
        }

        .public-header p {
            color: #6c757d;
            font-size: 1rem;
            margin: 0;
        }

        .public-footer {
            text-align: center;
            padding-top: 2rem;
            color: #6c757d;
            font-size: 1.1rem;
        }

        .public-footer a {
            color: black;
            text-decoration: none;
        }

        .public-footer a:hover {
            text-decoration: underline;
        }

        /* Print styles */
        @media print {
            body {
                background: #fff;
                padding: 0;
            }

            .public-quote-container {
                box-shadow: none;
                border-radius: 0;
                padding: 0;
            }

            .public-header,
            .public-footer {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="public-quote-container">
        <!-- Include quote-summary section (reuse existing template) -->
        <%- include('./sections/quote-summary', {
            quote: quote,
            isPublicView: true
        }) %>

        <!-- Public Footer -->
        <div class="public-footer">
            <p>
                <a href="https://amexing.com" target="_blank" rel="noopener">amexingexperience.com</a>
            </p>
        </div>
    </div>

    <!-- Bootstrap 5 JS (for responsive features) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Services Renderer Scripts for unified service display -->
    <script src="/js/services-renderer-config.js"></script>
    <script src="/js/services-renderer.js"></script>
</body>
</html>
