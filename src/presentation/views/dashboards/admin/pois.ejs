<%
/**
 * Admin Destinations Management Page
 * Manages Destinations catalog (POIs - Points of Interest) and Service Types
 *
 * Layout Structure:
 * - Vertical navigation menu (collapsible)
 * - Two sections: Destinos (destinations list) and Tipos de Traslado (service types management)
 * - Section-based content rendering
 *
 * Note: DataTables CSS/JS libraries are loaded via controller
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const activeSection = typeof section !== 'undefined' ? section : 'pois';

// Menu items configuration
const menuItems = [
    { label: 'Destinos', icon: 'map-pin', section: 'pois', href: '/dashboard/admin/pois' },
    { label: 'Tipos de Traslado', icon: 'list', section: 'types', href: '/dashboard/admin/pois?section=types' }
];
%>

<!-- Page Header with Breadcrumb -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-1 fw-bold">Gestión de Destinos</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/dashboard/admin"><i class="ti ti-home me-1"></i>Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active">
                            <i class="ti ti-map-pin me-1"></i>Destinos
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row mt-4">
    <!-- Section tabs (horizontal) -->
    <div class="col-12">
        <nav class="pois-nav-tabs mb-3">
            <% menuItems.forEach(function(item) { %>
                <a href="<%= item.href %>" class="pois-nav-tab <%= item.section === activeSection ? 'active' : '' %>">
                    <i class="ti ti-<%= item.icon %> me-2"></i><%= item.label %>
                </a>
            <% }); %>
        </nav>
    </div>

    <!-- Content Column -->
    <div class="col-12" id="contentColumn">
        <% if (activeSection === 'pois') { %>
            <!-- Destinations Management Section -->
            <%- include('../../organisms/datatable/pois-table', {
                tableId: 'pois-table',
                apiEndpoint: '/api/pois',
                userRole: currentUserRole,
                showActions: true
            }) %>

        <% } else if (activeSection === 'types') { %>
            <!-- Service Types Management Section -->

            <%- include('../../organisms/datatable/service-types-table', {
                tableId: 'service-types-table',
                apiEndpoint: '/api/service-types',
                userRole: currentUserRole,
                showActions: true
            }) %>

        <% } %>
    </div>
</div>

<!-- Vertical Menu Styles -->
<style>
/* Section tabs (horizontal, salvia) */
.pois-nav-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 1px solid #e9ecef;
    overflow-x: auto;
}

.pois-nav-tab {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.1rem;
    color: var(--brand-primary-active);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    border-radius: 0.5rem 0.5rem 0 0;
    transition: all 0.2s ease;
}

.pois-nav-tab:hover {
    background: rgba(var(--brand-primary-rgb), 0.08);
    color: var(--brand-primary-active);
}

.pois-nav-tab.active {
    color: #fff;
    background: var(--brand-gradient);
    border-bottom-color: var(--brand-primary);
}

/* Breadcrumb styles */
.breadcrumb-item a {
    color: #5a6a85;
    text-decoration: none;
}

.breadcrumb-item a:hover {
    color: var(--brand-primary-active);
}
</style>
