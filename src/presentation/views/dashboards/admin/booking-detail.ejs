}
#paymentsOffcanvas .pay-file-name.has-file { color: #2b2b2b; font-weight: 600; }
/* Pie de botones separado del cuerpo, para cerrar visualmente el formulario. "Cancelar" se retoña a la
   paleta olivo: el btn-outline-secondary del tema entra en azul oscuro y desentona con el carrito. */
#paymentsOffcanvas .pay-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid #f1efe8;
    /* Si el formulario queda mas alto que el area visible del carrito, la barra se pega al borde
       inferior para que "Guardar" nunca quede debajo del pliegue. Con el formulario corto no hace
       nada: se queda en su sitio natural. */
    position: sticky;
    bottom: 0;
    background: #fff;
}
#paymentsOffcanvas .pay-form-actions .btn {
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.55rem 1.6rem;
    border-radius: 8px;
}
#paymentsOffcanvas .pay-form-actions .btn-outline-secondary { border-color: #dcdccf; color: #6b7256; }
#paymentsOffcanvas .pay-form-actions .btn-outline-secondary:hover { background: #f1f2ec; border-color: #c9cdbb; color: #4f5838; }
/* Encabezados ordenables (Fecha / Monto): boton plano que hereda el estilo del th. */
#paymentsOffcanvas .pay-hist-sort {
    border: none;
    background: transparent;
    padding: 0;
    font: inherit;
    color: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
#paymentsOffcanvas .pay-hist-sort:hover { color: #4f5838; }
#paymentsOffcanvas .pay-hist-sort .ti { font-size: 0.85rem; opacity: 0.35; }
#paymentsOffcanvas .pay-hist-sort.is-active { color: #4f5838; }
#paymentsOffcanvas .pay-hist-sort.is-active .ti { opacity: 1; }
/* Separador de mes: solo aparece al ordenar por fecha (agrupar por mes con orden por monto no
   significaria nada). */
#paymentsOffcanvas .pay-hist-group td {
    background: #edeee4;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: #6b7256;
    padding: 0.4rem 0.7rem;
}
#paymentsOffcanvas .pay-hist-group .pay-hist-group-sum { float: right; color: #8a8f78; }
/* El monto es EL dato de cada renglon: mas grande y con mas peso que el resto de la fila. */
#paymentsOffcanvas .pay-hist-amount { text-align: right; white-space: nowrap; font-weight: 700; font-size: 1.02rem; color: #2b2b2b; }
#paymentsOffcanvas .pay-hist-curr { font-size: 0.7rem; font-weight: 700; color: #8a8f78; margin-left: 3px; }
/* Moneda distinta a la de la reservacion: se resalta en ambar con el monto original debajo, porque
   antes se veia igual que un pago en la moneda de la reserva. */
#paymentsOffcanvas .pay-hist-curr.is-foreign {
    background: #f6efe2;
    color: #96682f;
    border: 1px solid #e7d6bd;
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
}
#paymentsOffcanvas .pay-hist-orig { font-size: 0.76rem; font-weight: 600; color: #96682f; margin-top: 2px; }
/* Pie: total de los pagos listados, para cuadrar contra "Pagado" de la card de cobertura. */
#paymentsOffcanvas .pay-hist tfoot td {
    border-top: 2px solid #ddddd2;
    padding: 0.7rem 0.55rem;
    font-weight: 700;
    color: #2b2b2b;
}
#paymentsOffcanvas .pay-hist tfoot .pay-hist-foot-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8a8f78; }
/* Chip de metodo con color propio (misma paleta suave que la pildora de estado de la card de
   cobertura): permite distinguir efectivo/transferencia/tarjeta de un vistazo, no solo leyendo. */
#paymentsOffcanvas .pay-hist-method {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.24rem 0.62rem;
    white-space: nowrap;
}
/* Acciones "fantasma" (sin borde en reposo) para que no compitan con el monto; el color aparece en
   hover. Area de 32px = comodo para tocar en movil. */
#paymentsOffcanvas .pay-hist-actions { text-align: right; white-space: nowrap; }
#paymentsOffcanvas .pay-hist-act {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: #8a8f78;
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
    transition: all 0.12s ease;
}
#paymentsOffcanvas .pay-hist-act:hover { background: #f1f2ec; color: #4f5838; border-color: #e0e3d6; }
#paymentsOffcanvas .pay-hist-act.is-danger:hover { background: #f7ecea; color: #a1443a; border-color: #e6c9c4; }
#paymentsOffcanvas .pay-hist-act.is-receipt { color: #566040; }
/* Bajo 576px el offcanvas es full-width (~360px reales): 5 columnas siguen apretando, asi que cada
   pago se apila como tarjeta. Las etiquetas de columna vuelven via data-label, ya que el thead se
   oculta. */
@media (max-width: 576px) {
    #paymentsOffcanvas .pay-hist thead { display: none; }
    #paymentsOffcanvas .pay-hist,
    #paymentsOffcanvas .pay-hist tbody,
    #paymentsOffcanvas .pay-hist tfoot,
    #paymentsOffcanvas .pay-hist tr,
    #paymentsOffcanvas .pay-hist td { display: block; width: 100%; }
    /* Sin panel detras, cada pago ES la tarjeta: fondo blanco propio sobre el gris del carrito. */
    #paymentsOffcanvas .pay-hist tbody tr {
        background: #fff;
        border: 1px solid #ece9df;
        border-radius: 10px;
        margin-bottom: 0.6rem;
        overflow: hidden;
    }
    #paymentsOffcanvas .pay-hist tbody td {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        border-top: 1px solid #f5f3ec;
        padding: 0.5rem 0.75rem;
        text-align: left;
    }
    #paymentsOffcanvas .pay-hist tbody td::before {
        content: attr(data-label);
        flex: 0 0 auto;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        color: #8a8f78;
        padding-top: 3px;
    }
    /* Celdas sin etiqueta visible: la fecha de pago encabeza la tarjeta y las acciones cierran. */
    #paymentsOffcanvas .pay-hist tbody td.pay-hist-date::before,
    #paymentsOffcanvas .pay-hist tbody td.pay-hist-actions::before { content: none; }
    #paymentsOffcanvas .pay-hist tbody td.pay-hist-date { background: #faf9f4; display: block; }
    #paymentsOffcanvas .pay-hist tbody td.pay-hist-actions { justify-content: flex-end; }
    #paymentsOffcanvas .pay-hist tbody td.pay-hist-amount { text-align: right; }
    /* Registro apila fecha + persona dentro de .pay-hist-stack, alineado a la derecha para no chocar
       con la etiqueta "REGISTRO" que la celda pone a la izquierda. */
    #paymentsOffcanvas .pay-hist tbody td.pay-hist-meta .pay-hist-stack { text-align: right; }
    #paymentsOffcanvas .pay-hist tbody td.pay-hist-meta .pay-hist-person { justify-content: flex-end; }
    /* La fila de edición no es una tarjeta más: se pega a la tarjeta del pago que está editando. */
    #paymentsOffcanvas .pay-hist tbody tr.pay-hist-edit { border: none; margin: -0.6rem 0 0.6rem; }
    #paymentsOffcanvas .pay-hist tbody tr.pay-hist-edit td { display: block; border-top: none; padding: 0; }
    #paymentsOffcanvas .pay-hist tbody tr.pay-hist-edit td::before { content: none; }
    /* En movil SI es tarjeta, porque aqui cada pago tambien lo es: se enchufa a la de arriba. */
    #paymentsOffcanvas .pay-hist-form {
        border: 1px solid #ece9df;
        border-top: none;
        border-radius: 0 0 10px 10px;
    }
    #paymentsOffcanvas .pay-hist-group td { border-radius: 8px; margin-bottom: 0.4rem; }
    #paymentsOffcanvas .pay-hist-group .pay-hist-group-sum { float: none; margin-left: 6px; }
    #paymentsOffcanvas .pay-hist tfoot td { display: flex; justify-content: space-between; border-radius: 10px; }
    /* Botones a todo el ancho y "Guardar" arriba (column-reverse: va último en el DOM), que es donde
       cae el pulgar. Apilados a la derecha quedarian chicos en ~360px. */
    #paymentsOffcanvas .pay-form-actions { flex-direction: column-reverse; gap: 8px; }
    #paymentsOffcanvas .pay-form-actions .btn { width: 100%; }
    /* La etiqueta de contexto sobra en movil: la tarjeta del pago que se edita está justo arriba. */
    #paymentsOffcanvas .pay-form-context { display: none; }
}
/* Tabs del drawer — control segmentado full-width (mismo estilo que el catálogo de servicios) */
#paymentsTabs.payments-seg { flex-wrap: nowrap; gap: 4px; background: #f1f2ec; border: 1px solid #e6e4dd; border-radius: 12px; padding: 4px; }
#paymentsTabs.payments-seg .nav-item { flex: 1 1 0; min-width: 0; }
#paymentsTabs.payments-seg .nav-link { width: 100%; border: none; border-radius: 9px; font-size: 0.92rem; font-weight: 600; padding: 0.55rem 0.4rem; color: #6b7256; background: transparent; display: flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; transition: all 0.12s ease; }
#paymentsTabs.payments-seg .nav-link:hover { color: #4f5838; background: rgba(110,122,80,0.08); }
#paymentsTabs.payments-seg .nav-link.active { background: #6E7A50; color: #fff; font-weight: 700; box-shadow: 0 1px 3px rgba(79,88,56,0.25); }
#paymentsTabs.payments-seg .nav-link.active .badge { background: rgba(255,255,255,0.28) !important; color: #fff !important; }
/* Mismo radio de borde explicito para el bloque de descuento/ahorro (fondo verde claro propio). */
#paymentCoverageCard .rounded { border-radius: 0.5rem; }
/* Hint de ahorro bajo "Total a pagar" (mismo estilo que .fin-hero-hint del Resumen Financiero). */
#paymentsOffcanvas .pay-savings-hint {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 7px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #4b6b3f;
}
#paymentsOffcanvas .pay-savings-hint i { font-size: 0.95rem; }
/* Esqueleto de carga del carrito: el panel se puede abrir mientras GET .../payments sigue en vuelo,
   asi que las tarjetas muestran barras "shimmer" con la forma del contenido real en vez de quedar
   vacias (parecia que el drawer estaba roto). */
#paymentsOffcanvas .pay-skel {
    background: linear-gradient(90deg, #eceee6 25%, #f7f8f3 50%, #eceee6 75%);
    background-size: 200% 100%;
    animation: paySkelShimmer 1.2s ease-in-out infinite;
    border-radius: 6px;
}
@keyframes paySkelShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}
@media (prefers-reduced-motion: reduce) {
    #paymentsOffcanvas .pay-skel { animation: none; }
}
/* Panel de Servicios: mismo contenedor que el Resumen Financiero (fin-wrap + fin-section-head) en vez
   del card-header con gradiente verde, que era el único bloque de la página fuera de la paleta. La
   lista sangra hasta el borde con margen negativo para que las bandas de día y los separadores de fila
   sigan corriendo a todo lo ancho, como cuando el card-body llevaba p-0; overflow:hidden recorta la
   última fila contra la esquina redondeada. */
.svc-wrap {
    border: 1px solid #ece8dd;
    border-radius: 14px;
    background: #fff;
    padding: 20px 22px 0;
    overflow: hidden;
}
.svc-wrap #servicesContainer { margin: 0 -22px; }
/* El botón de exportar venía en btn-light (pensado para el header de color): sobre blanco se perdía. */
.svc-wrap .btn-outline-secondary { border-color: #dcdccf; color: #6b7256; }
.svc-wrap .btn-outline-secondary:hover { background: #f1f2ec; border-color: #c9cdbb; color: #4f5838; }
/* ===== Lista de servicios con la maqueta del itinerario =====
   Misma línea de tiempo que /reservations/:folio/itinerary: barra de día, riel con ícono circular y
   el cuerpo del servicio a la derecha. Lo que el itinerario YA acomoda (hora, título, Desde/Hacia)
   toma su formato; lo que no contempla —detalles del subconcepto, asignaciones, estado, precio y las
   acciones— se conserva dentro del mismo cuerpo, sin perder nada. */
/* Misma tipografía que el itinerario: Myriad Pro en el cuerpo y Arpona en la barra de día (allá son
   las variantes *PDF, incrustadas en base64 para el render de puppeteer; aquí las de /css/fonts.css).
   Se limita a la lista de servicios: el resto del dashboard va en Inter y mezclar en toda la página
   sería otro cambio, mucho mayor. */
.svc-timeline {
    --svc-pad: 15px;
    --svc-icon: 56px;
    --svc-gutter: 22px;
    font-family: var(--font-myriad, 'Segoe UI', Tahoma, sans-serif);
}
/* Barra de día igual que .itin-day-bar del itinerario: franja gris sólida a todo lo ancho, texto
   blanco, 0.8rem con peso 500 y letter-spacing de 1px. */
.svc-day-bar {
    background: #888888;
    color: #fff;
    font-family: var(--font-arpona, 'Helvetica Neue', Arial, sans-serif);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 1px;
    padding: 3px var(--svc-gutter, 22px);
}
.svc-entry {
    position: relative;
    display: flex;
    gap: 14px;
    padding: var(--svc-pad) var(--svc-gutter);
}
/* Sin realce al pasar el mouse: los PNG del riel no tienen canal alfa, así que su recuadro blanco se
   recortaba contra el tinte de la fila. */
/* La línea baja del ícono de este servicio al del siguiente: el tramo negativo cruza el relleno que
   los separa. En el último de cada día no se dibuja, así el riel no cuelga sobre la barra siguiente. */
.svc-entry:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--svc-gutter) + var(--svc-icon) / 2 - 0.75px);
    top: calc(var(--svc-pad) + var(--svc-icon));
    bottom: calc(-1 * var(--svc-pad));
    width: 1.5px;
    background: #e4e6d8;
}
/* Sin círculo propio: los PNG de /images/icons ya traen el suyo dibujado, así que un borde alrededor
   duplicaba el aro. La imagen ocupa toda la casilla del riel.
   El fondo se queda BLANCO —igual que .itin-icon en el itinerario— porque esos PNG no tienen canal
   alfa: pintan un recuadro opaco. Coincidir con su blanco evita la costura y de paso tapa la línea
   del riel, que es lo que hace que se vea perforada por cada ícono. */
.svc-icon {
    position: relative;
    z-index: 1;
    width: var(--svc-icon);
    height: var(--svc-icon);
    flex-shrink: 0;
    background: #fff;
}
.svc-icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
.svc-body { flex: 1; min-width: 0; }
.svc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
.svc-head-main { min-width: 0; flex: 1; }
/* Misma tipografía que .itin-time del itinerario: 0.95rem, peso 700, en un solo tono — la duración no
   se distingue de la hora, se lee como una sola línea. */
.svc-time { font-size: 0.95rem; font-weight: 700; color: #1b1b1b; }
.svc-title { font-size: 1.02rem; font-weight: 700; color: #2b2b2b; line-height: 1.3; word-break: break-word; }
.svc-route { margin-top: 2px; font-size: 0.86rem; color: #6b6656; line-height: 1.45; }
.svc-route b { color: #2b2b2b; font-weight: 600; }
.svc-route .lbl { color: #8a8f78; }
/* Personas: línea destacada bajo el título, igual que el .itin-sub en negrita del itinerario. */
.svc-people { margin-top: 6px; font-size: 0.86rem; color: #6c757d; }
/* Nombres de las personas: mismo tono que el conteo, sin negrita — el conteo es el dato destacado. */
.svc-names { margin-top: 2px; font-size: 0.86rem; color: #6c757d; }
/* Vuelos: misma mini tabla que .itin-flight del itinerario — encabezado chico en gris y el valor en
   negrita debajo. Con varios vuelos, cada uno añade un renglón de valores bajo el mismo encabezado
   (el itinerario solo contempla uno). */
.svc-flight {
    display: grid;
    grid-template-columns: repeat(5, auto);
    justify-content: start;
    gap: 2px 28px;
    margin-top: 8px;
}
.svc-flight .h { font-size: 0.7rem; color: #8a8a8a; }
.svc-flight .v { font-size: 0.9rem; color: #1b1b1b; font-weight: 600; }
/* Notas: mismo tratamiento que .itin-desc — texto corrido justificado, sin caja ni filete de color.
   El rótulo del canal se conserva en versalitas porque aquí sí hay que distinguir a quién va dirigida
   cada nota (proveedor / equipo / interna), cosa que el itinerario no necesita.

   El color del rótulo pasó de los cinco tonos de Bootstrap (cian, azul, verde, naranja, morado) a
   tres de la paleta de marca, y los tres CODIFICAN algo cierto: quién puede leer la nota. Antes eran
   cinco matices arbitrarios que además peleaban con el olivo del resto de la lista. */
.svc-note { margin-top: 8px; }
.svc-note-lbl {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    /* 0.09em, igual que .svc-assign-role: los dos son rótulos en versalitas del mismo nivel. */
    letter-spacing: 0.09em;
    color: #8a8f78;
}
/* Visible para el cliente. */
.svc-note-lbl.is-client { color: #6e7a50; }
/* Operación con terceros: proveedor y equipo. */
.svc-note-lbl.is-ops { color: #b8894a; }
/* Solo interno. */
.svc-note-lbl.is-internal { color: #6b6656; }
.svc-note-body {
    margin-top: 2px;
    color: #555;
    line-height: 1.55;
    white-space: pre-line;
    text-align: justify;
    word-break: break-word;
}
.svc-notes-list { margin: 6px 0 0; padding-left: 1.2em; }
.svc-notes-list li { list-style: disc; margin: 2px 0; }
.svc-vehicle { margin-top: 2px; font-size: 0.8rem; color: #8a8f78; }
.svc-side { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
.svc-price { font-weight: 700; color: #2b2b2b; white-space: nowrap; text-align: right; min-width: 90px; }
/* Asignaciones en el formato del itinerario (opción B): un renglón por pareja chofer+vehículo y
   los roles al final. Sin marco ni filete lateral: los avatares ya forman su propia columna y el
   bloque queda alineado con el título y la ruta del servicio, como en el itinerario. */
.svc-assign {
    margin-top: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
}
.svc-assign-empty { font-size: 0.8rem; color: #a8ac98; font-style: italic; }
.svc-assign-row { display: flex; align-items: center; gap: 0.7rem; }
.svc-av {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef0e8;
    color: #6f7459;
    font-size: 0.92rem;
    font-weight: 700;
}
.svc-av img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; cursor: pointer; }
.svc-av-veh { background: #f3f1ea; color: #a89a7a; font-size: 1.35rem; }
/* Plaza vacía: punteada y sin relleno, para que el hueco se lea sin gritar. */
.svc-av-pend { background: #fff; border: 1.5px dashed #d4d0c2; color: #b9b5a6; font-size: 1.35rem; }
/* Los dos avatares se solapan para que la pareja se lea como una sola unidad. El aro blanco que
   los separa va en box-shadow, NO en border: con border, este selector (más específico) le ganaba
   a .svc-av-pend y le borraba el punteado al segundo círculo de una plaza vacía. */
.svc-duo { display: flex; flex-shrink: 0; }
.svc-duo .svc-av + .svc-av { margin-left: -13px; box-shadow: 0 0 0 2px #fff; }
.svc-assign-meta { font-size: 0.86rem; line-height: 1.45; color: #6b6656; min-width: 0; }
.svc-assign-meta .n { font-size: 0.94rem; font-weight: 700; color: #2b2b2b; }
/* Va después de `.n` y con la clase encadenada: si no, `.svc-assign-meta .n` le gana el peso y
   el color, y el renglón pendiente se vería igual que uno asignado. */
.svc-assign-meta .svc-pend-txt,
.svc-assign-meta .n.svc-pend-txt { font-style: italic; font-weight: 400; color: #a09c8d; }
/* El tipo esperado de una plaza vacía: conserva la negrita porque ES el sujeto del renglón, pero
   apagado para que no compita con un vehículo ya asignado. Sin itálica: es un dato, no un estado.
   Encadenada por lo mismo que la regla de arriba — `.svc-assign-meta .n` le ganaría el color. */
.svc-assign-meta .n.svc-pend-name { color: #8a8f78; }
.svc-assign-role { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.09em; font-weight: 700; color: #8a8f78; }
.svc-assign-tel { color: #6b6656; text-decoration: none; }
.svc-assign-tel:hover { color: #566040; text-decoration: underline; }
.svc-seg-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 4px; vertical-align: 1px; }
@media (max-width: 576px) {
    .svc-timeline { --svc-gutter: 14px; --svc-icon: 44px; }
    .svc-side { width: 100%; justify-content: flex-end; }
}
.service-row {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    transition: background-color 0.15s;
}
.service-row:hover {
    background-color: #f8f9fa;
}
.service-row:last-child {
    border-bottom: none;
}
.day-header {
    background-color: #f8f9fa;
    padding: 0.5rem 1rem;
    font-weight: 600;
    border-bottom: 2px solid #e9ecef;
}
.assignment-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
}
.detail-tag {
    font-size: 0.9rem;
    padding: 0.15rem 0.4rem;
    font-weight: 500;
}
.assign-field-group {
    margin-bottom: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: #f8f9fa;
    border-radius: 0.5rem;
}
.assign-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
}
.vehicle-pair-group {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 0.5rem;
    padding: 0.6rem 0.75rem;
    margin-bottom: 0.5rem;
}
.vehicle-pair-group .pair-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #6c757d;
    font-weight: 600;
    margin-bottom: 0.4rem;
}
</style>

<!-- Shared cancel utilities -->
<script src="/js/reservation-cancel-utils.js"></script>
<!-- Shared payment breakdown helpers (isomorphic; also require'd by Jest) -->
<script src="/shared/payments/paymentBreakdownHelpers.js"></script>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    const token = localStorage.getItem('token') || sessionStorage.getItem('token');
    // Read the freshest token at call time: the const above is captured once on page load and can go
    // stale during a long session (token rotation/expiry) → 401 "malformed token" until a hard reload.
    const authToken = () => localStorage.getItem('token') || sessionStorage.getItem('token') || token;
    const reservationId = '<%= reservationId %>';
    // Role from server-side renderRoleView (admin / superadmin / department_manager / client / etc.)
    // Used to gate visibility of internal note channels.
    const userRole = '<%= typeof userRole !== "undefined" ? userRole : "" %>';
    let reservationData = null;
    let employeesCache = null;
    let vehiclesCache = null;

    function getInitials(name) {
        if (!name) return '?';
        return name.split(' ').map(w => w[0]).filter(Boolean).join('').substring(0, 2).toUpperCase();
    }

    // Precio base en efectivo de un servicio (0 si está excluido del total). Es el precio de
    // referencia para el desglose Subtotal/recargo -- no se usa para calcular el cobro de
    // otros métodos.
    function getServiceBase(svc) {
        if (svc?.subconcept?.includeInTotal === false) return 0;
        const pbt = svc?.subconcept?.pricesByType;
        if (pbt && typeof pbt === 'object' && pbt.efectivo != null) {
            const v = Number(pbt.efectivo);
            if (!Number.isNaN(v)) return v;
        }
        return Number(svc?.total) || 0;
    }

    // Lógica de cálculo/desglose compartida (pura, probada por Jest) — ver
    // /shared/payments/paymentBreakdownHelpers.js. Wrappers finos para no tocar los call sites.
    function getServicePriceByType(svc, paymentType) {
        return PaymentBreakdownHelpers.getServicePriceByType(svc, paymentType);
    }
    // Precio REAL para la LÍNEA del servicio: no pone $0 en "Pago externo" (includeInTotal:false); la
    // exclusión del Total/Saldo la sigue haciendo getServicePriceByType en el agregado financiero.
    function getServicePriceByTypeGross(svc, paymentType) {
        return PaymentBreakdownHelpers.getServicePriceByTypeGross(svc, paymentType);
    }
    function getServiceDiscountByType(svc, paymentType) {
        return PaymentBreakdownHelpers.getServiceDiscountByType(svc, paymentType);
    }
    function computeServicesSubtotalByType(services, paymentType) {
        const currency = (reservationData && reservationData.currency) || 'MXN';
        return PaymentBreakdownHelpers.computeServicesSubtotalByType(services, paymentType, currency);
    }

    function buildPersonCard(person, roleLabel, roleIcon, colorClass) {
        if (!person) return '';
        const name = person.fullName || 'Sin nombre';
        const phone = person.phone || '';
        const photo = person.profilePhotoUrl || '';
        const initials = getInitials(name);
        const photoHtml = photo
            ? `<img src="${photo}" class="rounded-circle photo-preview-trigger" width="36" height="36" style="object-fit:cover;cursor:pointer" data-photo="${photo}" data-name="${name.replace(/"/g, '&quot;')}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
            : '';
        const initialsDisplay = photo ? 'display:none' : 'display:flex';
        return `
            <div class="d-flex align-items-center gap-2 mb-2">
                ${photoHtml}
                <span class="rounded-circle bg-${colorClass}-subtle text-${colorClass} align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;${initialsDisplay};font-size:0.8rem;font-weight:600">${initials}</span>
                <div>
                    <div class="fw-semibold small">${name}</div>
                    <small class="text-${colorClass}"><i class="ti ${roleIcon} me-1"></i>${roleLabel}</small>
                    ${phone ? `<a href="tel:${phone}" class="text-muted small d-block"><i class="ti ti-phone me-1"></i>${phone}</a>` : ''}
                </div>
            </div>`;
    }

    // ------------------------------------------------------------------
    // Asignaciones en el formato del itinerario (opción B): chofer y vehículo van EMPAREJADOS
    // porque se leen como una sola cosa —«Juan en la Hiace, placas ABC-12-34»—. En tarjetas o
    // renglones separados la relación quedaba a merced de la adyacencia, y con dos vehículos
    // dejaba de leerse. El segmento (Green Class / Premium) identifica cada unidad.
    //
    // A diferencia del itinerario, aquí se conservan las dos afordancias que el operador ya
    // tenía: la foto se amplía al clic (photo-preview-trigger) y el teléfono es un enlace tel:.
    // También se conserva su vocabulario: "pendiente", no el "por confirmar" del cliente.
    // ------------------------------------------------------------------
    // `vehicleType` guarda normalmente el objectId del catálogo, pero en algunos registros trae el
    // NOMBRE ("SEDAN") en ese campo. Aprovecharlo sirve —el tipo se recupera sin tocar la base—,
    // salvo que un objectId real se colaría a la pantalla como si fuera un modelo de camioneta.
    // Los objectId de Parse son 10 alfanuméricos con mayúsculas y minúsculas mezcladas; ningún
    // nombre del catálogo tiene esa forma (SEDAN, SUBURBAN, JAC Sunray, Van Turística…).
    function vehicleTypeAsName(value) {
        const v = String(value == null ? '' : value).trim();
        if (!v) return '';
        const looksLikeObjectId = /^[A-Za-z0-9]{10}$/.test(v) && /[a-z]/.test(v) && /[A-Z]/.test(v);
        return looksLikeObjectId ? '' : v;
    }

    // La foto va ENCIMA de las iniciales, así que si la URL falla quedan las iniciales visibles
    // en vez de un círculo vacío (el patrón anterior alternaba display y dependía del hermano).
    function svcAvatar(person) {
        const esc = PaymentBreakdownHelpers.escapeHtml;
        const name = (person && person.fullName) || '';
        const photo = (person && person.profilePhotoUrl) || '';
        const img = photo
            ? `<img src="${esc(photo)}" class="photo-preview-trigger" data-photo="${esc(photo)}" data-name="${esc(name)}" onerror="this.remove()">`
            : '';
        return `<span class="svc-av">${esc(getInitials(name) || '·')}${img}</span>`;
    }

    function svcVehicleAvatar(vehicle) {
        const esc = PaymentBreakdownHelpers.escapeHtml;
        const name = (vehicle && vehicle.name) || '';
        const photo = (vehicle && vehicle.imageUrl) || '';
        const img = photo
            ? `<img src="${esc(photo)}" class="photo-preview-trigger" data-photo="${esc(photo)}" data-name="${esc(name)}" onerror="this.remove()">`
            : '';
        return `<span class="svc-av svc-av-veh"><i class="ti ti-car"></i>${img}</span>`;
    }

    function svcPendingAvatar(icon) {
        return `<span class="svc-av svc-av-pend"><i class="ti ti-${icon}"></i></span>`;
    }

    // Punto del segmento: el color se VALIDA en vez de escaparse, porque entra a un style inline.
    function svcSegmentBit(pair) {
        const esc = PaymentBreakdownHelpers.escapeHtml;
        if (!pair.segmentName) return '';
        const color = /^(#[0-9a-fA-F]{3,8}|[a-zA-Z]{3,20})$/.test(String(pair.segmentColor || '').trim())
            ? String(pair.segmentColor).trim() : '';
        const dot = color ? `<span class="svc-seg-dot" style="background:${color};"></span>` : '';
        return `${dot}${esc(pair.segmentName)}`;
    }

    // Segunda línea: segmento, plaza, lo que falta, placas y teléfono. La mitad faltante va antes
    // de las placas porque es la información accionable para quien está asignando.
    function svcPairDetail(pair) {
        const esc = PaymentBreakdownHelpers.escapeHtml;
        const bits = [];
        const seg = svcSegmentBit(pair);
        if (seg) bits.push(seg);
        if (pair.slotLabel) bits.push(esc(pair.slotLabel));
        if (pair.needsDriver) bits.push('<span class="svc-pend-txt">Conductor pendiente</span>');
        if (pair.needsVehicle) {
            bits.push(`<span class="svc-pend-txt">${pair.expectedVehicleName
                ? `${esc(pair.expectedVehicleName)} pendiente` : 'Vehículo pendiente'}</span>`);
        }
        if (pair.vehicle && pair.vehicle.plate) bits.push(`Placas ${esc(pair.vehicle.plate)}`);
        if (pair.driver && pair.driver.phone) {
            bits.push(`<a href="tel:${esc(pair.driver.phone)}" class="svc-assign-tel">${esc(pair.driver.phone)}</a>`);
        }
        return bits.join(' · ');
    }

    function svcPairRow(pair) {
        const esc = PaymentBreakdownHelpers.escapeHtml;
        const duo = `<span class="svc-duo">${
            pair.driver ? svcAvatar(pair.driver) : (pair.pending || pair.needsDriver ? svcPendingAvatar('steering-wheel') : '')
        }${
            pair.vehicle ? svcVehicleAvatar(pair.vehicle) : (pair.pending || pair.needsVehicle ? svcPendingAvatar('car') : '')
        }</span>`;
        if (pair.pending) {
            // La negrita lleva el tipo esperado; el estado baja a la segunda línea, junto al
            // segmento y a la plaza que ocupa.
            const bits = [];
            const seg = svcSegmentBit(pair);
            if (seg) bits.push(seg);
            if (pair.slotLabel) bits.push(esc(pair.slotLabel));
            bits.push('<span class="svc-pend-txt">Pendiente</span>');
            return `<div class="svc-assign-row">${duo}<div class="svc-assign-meta">
                <div class="n svc-pend-name">${esc(pair.label)}</div>
                <div>${bits.join(' · ')}</div>
            </div></div>`;
        }
        const name = [pair.driver && pair.driver.fullName, pair.vehicle && pair.vehicle.name]
            .filter(Boolean).map(esc).join(' · ');
        const detail = svcPairDetail(pair);
        return `<div class="svc-assign-row">${duo}<div class="svc-assign-meta">
            <div class="n">${name}</div>${detail ? `<div>${detail}</div>` : ''}
        </div></div>`;
    }

    function svcRoleRow(row) {
        const esc = PaymentBreakdownHelpers.escapeHtml;
        const p = row.person;
        const avatar = p ? svcAvatar(p) : svcPendingAvatar('user');
        const body = p
            ? `<div class="n">${esc(p.fullName)}</div>${p.phone
                ? `<div><a href="tel:${esc(p.phone)}" class="svc-assign-tel">${esc(p.phone)}</a></div>` : ''}`
            : '<div class="n svc-pend-txt">Pendiente</div>';
        return `<div class="svc-assign-row">${avatar}<div class="svc-assign-meta">
            <div class="svc-assign-role">${esc(row.role)}</div>${body}
        </div></div>`;
    }

    // Quote statuses — kept as an ORDERED array (lifecycle: cotizada → solicitada →
    // bloqueada → agendada → rechazada) so the dropdown matches the segmented control on
    // the quote detail page.
    const QUOTE_STATUS_ORDER = [
        { key: 'quoted', label: 'Cotizada', cls: 'bg-primary text-white' },
        { key: 'requested', label: 'Solicitada', cls: 'bg-info text-white' },
        { key: 'hold', label: 'Bloqueada', cls: 'bg-warning text-dark' },
        { key: 'scheduled', label: 'Agendada', cls: 'bg-success text-white' },
        { key: 'rejected', label: 'Rechazada', cls: 'bg-danger text-white' },
    ];
    const QUOTE_STATUS_MAP = Object.fromEntries(QUOTE_STATUS_ORDER.map((s) => [s.key, s]));

    function getQuoteStatusBadge(status) {
        if (!status) return '';
        const s = QUOTE_STATUS_MAP[status] || { label: status, cls: 'bg-secondary text-white' };
        const isAdmin = userRole === 'admin' || userRole === 'superadmin';
        // Admin gets a dropdown to change the quote status inline. Other roles see a
        // plain badge.
        if (!isAdmin) {
            return `<span class="badge ${s.cls}" title="Estado de cotización origen">${s.label}</span>`;
        }
        // Same lifecycle lock as the quote detail page: once a quote is scheduled, the
        // admin can't change it away from this dashboard (must go through the quote
        // detail flow to handle cancellation properly).
        const isLocked = status === 'scheduled';
        if (isLocked) {
            return `<span class="badge ${s.cls}" title="Cotización agendada — bloqueada">${s.label}</span>`;
        }
        const options = QUOTE_STATUS_ORDER
            .map((opt) => `<li><button type="button" class="dropdown-item d-flex justify-content-between align-items-center quote-status-option" data-status="${opt.key}">
                    <span>${opt.label}</span>
                    ${opt.key === status ? '<i class="ti ti-check text-success ms-2"></i>' : ''}
                </button></li>`)
            .join('');
        return `<span class="dropdown d-inline-block">
                    <button type="button" class="badge ${s.cls} border-0 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Cambiar estado de cotización">
                        ${s.label}
                    </button>
                    <ul class="dropdown-menu shadow-sm">
                        <li><h6 class="dropdown-header">Cambiar estado de cotización</h6></li>
                        ${options}
                    </ul>
                </span>`;
    }

    // Wires the quote-status dropdown options to the PUT /api/quotes/:id endpoint.
    // Called after the badge is (re)rendered.
    function wireQuoteStatusDropdown() {
        document.querySelectorAll('.quote-status-option').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const newStatus = btn.dataset.status;
                const currentStatus = reservationData?.quoteStatus;
                if (!newStatus || newStatus === currentStatus) return;
                const quoteId = reservationData?.quoteId;
                if (!quoteId) {
                    alert('Cotización no disponible');
                    return;
                }
                const label = QUOTE_STATUS_MAP[newStatus]?.label || newStatus;
                if (!confirm(`¿Cambiar el estado de la cotización a "${label}"?`)) return;
                try {
                    const res = await fetch(`/api/quotes/${quoteId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${authToken()}` },
                        body: JSON.stringify({ status: newStatus, reason: 'Updated from booking detail' }),
                    });
                    const json = await res.json();
                    if (!res.ok || json?.success === false) {
                        throw new Error(json?.error || `HTTP ${res.status}`);
                    }
                    // Refresh local data and re-render the status row.
                    reservationData.quoteStatus = newStatus;
                    const quoteBadge = getQuoteStatusBadge(reservationData.quoteStatus);
                    const reservationBadge = getReservationOverallStatusBadge(reservationData.status);
                    document.getElementById('infoStatus').innerHTML = `${quoteBadge} ${reservationBadge}`;
                    wireQuoteStatusDropdown();
                } catch (err) {
                    console.error('Failed to update quote status', err);
                    alert(`Error al actualizar estado: ${err.message}`);
                }
            });
        });
    }
    
    function getReservationStatusBadge(status) {
        const map = {
            pending: { label: 'Asignaciones pendientes', cls: 'bg-warning text-dark' },
            assigned: { label: 'Asignada', cls: 'bg-info text-white' },
            in_progress: { label: 'En Progreso', cls: 'bg-primary text-white' },
            completed: { label: 'Completada', cls: 'bg-success text-white' },
            cancelled: { label: 'Cancelada', cls: 'bg-danger text-white' },
            confirmed: { label: 'Confirmada', cls: 'bg-success text-white' },
            hold: { label: 'En Espera', cls: 'bg-warning text-dark' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado operacional de reservación">${s.label}</span>`;
    }

    // Estado GENERAL de la reservación: mismo modelo (y colores) que el segmented
    // control en el detalle de cotización. 'assigned'/'in_progress' = Confirmada
    // (definición del negocio: todo asignado = confirmada). No usar por-servicio.
    function getReservationOverallStatusBadge(status) {
        const map = {
            hold: { label: 'Bloqueado', cls: 'bg-warning text-dark' },
            pending: { label: 'Asignaciones pendientes', cls: 'bg-info text-white' },
            assigned: { label: 'Confirmada', cls: 'bg-primary text-white' },
            in_progress: { label: 'Confirmada', cls: 'bg-primary text-white' },
            confirmed: { label: 'Confirmada', cls: 'bg-primary text-white' },
            completed: { label: 'Finalizada', cls: 'bg-success text-white' },
            cancelled: { label: 'Cancelada', cls: 'bg-danger text-white' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado de la reservación">${s.label}</span>`;
    }

    // Estado de pago — delegado al módulo compartido (mismo PAYMENT_STATUS_MAP en las 3 plantillas).
    function getPaymentStatusBadge(status) {
        return PaymentBreakdownHelpers.getPaymentStatusBadge(status);
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
    }

    // Rango de fechas compacto (es-MX, UTC): mismo día → una sola fecha; mismo mes → "16 → 17 ago
    // 2026"; mismo año → "28 jul → 03 ago 2026"; años distintos → ambas completas.
    function formatDateRange(startStr, endStr) {
        if (!startStr) return '—';
        const start = new Date(startStr);
        if (Number.isNaN(start.getTime())) return '—';
        if (!endStr) return formatDate(startStr);
        const end = new Date(endStr);
        if (Number.isNaN(end.getTime())) return formatDate(startStr);
        // Se formatea día y mes por separado para evitar el guion del locale ("28-jul" → "28 jul").
        const fmt = (dt, o) => dt.toLocaleDateString('es-MX', Object.assign({ timeZone: 'UTC' }, o));
        const day = (dt) => fmt(dt, { day: '2-digit' });
        const dayMonth = (dt) => `${fmt(dt, { day: '2-digit' })} ${fmt(dt, { month: 'short' })}`;
        const full = (dt) => `${dayMonth(dt)} ${fmt(dt, { year: 'numeric' })}`;
        const sameYear = start.getUTCFullYear() === end.getUTCFullYear();
        const sameMonth = sameYear && start.getUTCMonth() === end.getUTCMonth();
        const sameDay = sameMonth && start.getUTCDate() === end.getUTCDate();
        const arrow = ' <span class="bkg-arrow">&rarr;</span> ';
        if (sameDay) return formatDate(startStr);
        if (sameMonth) return `${day(start)}${arrow}${full(end)}`;
        if (sameYear) return `${dayMonth(start)}${arrow}${full(end)}`;
        return `${full(start)}${arrow}${full(end)}`;
    }

    function formatCurrency(amount, currency) {
        const sym = currency === 'USD' ? 'USD $' : '$';
        return `${sym}${(amount || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    // Live thousands-separator for amount text inputs: groups the integer part with commas while
    // typing (100000 -> 100,000), keeps up to 2 decimals, and preserves the caret position.
    function formatThousandsInput(el) {
        const raw = el.value;
        const caret = el.selectionStart || 0;
        const digitsBeforeCaret = (raw.slice(0, caret).match(/\d/g) || []).length;
        let clean = raw.replace(/[^\d.]/g, '');
        const dot = clean.indexOf('.');
        if (dot !== -1) clean = clean.slice(0, dot + 1) + clean.slice(dot + 1).replace(/\./g, '');
        let [intPart = '', decPart] = clean.split('.');
        intPart = intPart.replace(/^0+(?=\d)/, '');
        const grouped = intPart ? Number(intPart).toLocaleString('en-US') : '';
        let out = grouped;
        if (decPart !== undefined) out += `.${decPart.slice(0, 2)}`;
        el.value = out;
        // Restore the caret after the same number of digits it was before reformatting.
        let pos = 0;
        let seen = 0;
        while (pos < out.length && seen < digitsBeforeCaret) {
            if (/\d/.test(out[pos])) seen += 1;
            pos += 1;
        }
        el.setSelectionRange(pos, pos);
    }

    // Attach live thousands formatting to a text amount input and format its initial value.
    function attachThousands(el) {
        if (!el) return;
        el.addEventListener('input', () => formatThousandsInput(el));
        if (el.value) formatThousandsInput(el);
    }

    // Parse an amount that may carry thousands separators ("1,234.56" -> 1234.56).
    function parseAmount(value) {
        return parseFloat(String(value == null ? '' : value).replace(/,/g, ''));
    }

    function getServiceTypeIcon(type) {
        const icons = {
            transport: 'ti-car',
            tour: 'ti-map-pin',
            experience: 'ti-sparkles',
            concepto: 'ti-tag',
            'a-disposicion': 'ti-clock',
        };
        return icons[type] || 'ti-point';
    }

    // Notas en el formato del itinerario (renderNotes): las líneas que empiezan con "-" se convierten
    // en viñetas y el resto queda como párrafos. ESCAPA el texto — antes se interpolaba crudo en el
    // innerHTML, así que una nota con HTML se ejecutaba (stored XSS, el mismo vector que los tests ya
    // cubren para referencia de pago y descripción de ajuste).
    function renderServiceNotes(text) {
        const esc = PaymentBreakdownHelpers.escapeHtml;
        const lines = String(text == null ? '' : text).split('\n');
        if (!lines.some((l) => l.trim().startsWith('-'))) return esc(text);
        let html = '';
        let inList = false;
        for (const raw of lines) {
            const line = raw.trim();
            if (line.startsWith('-')) {
                if (!inList) { html += '<ul class="svc-notes-list">'; inList = true; }
                html += `<li>${esc(line.replace(/^-\s*/, ''))}</li>`;
            } else {
                if (inList) { html += '</ul>'; inList = false; }
                if (line) html += `<div>${esc(line)}</div>`;
            }
        }
        if (inList) html += '</ul>';
        return html;
    }

    // Composición de personas en el formato del itinerario ("3 adultos, 1 niño"), para mostrarla como
    // una línea destacada bajo el título en vez de un renglón perdido dentro de la sección PERSONAS.
    // A diferencia de peopleLabel() del itinerario, respeta los campos POR TIPO que usa esta vista
    // (un traslado guarda su conteo en transportAdults, no en adultsQuantity) y conserva la distinción
    // de "sin alcohol", que el itinerario fusiona con los adultos.
    function servicePeopleLabel(svc) {
        const sub = svc.subconcept || {};
        const parts = [];
        const push = (n, sing, plur) => { const v = Number(n) || 0; if (v > 0) parts.push(`${v} ${v === 1 ? sing : plur}`); };

        if (svc.type === 'transport') {
            push(sub.transportAdults, 'adulto', 'adultos');
            push(sub.transportChildren, 'niño', 'niños');
            push(sub.transportInfants, 'infante', 'infantes');
        } else if (svc.type === 'experience') {
            push(sub.adultsQuantity, 'adulto', 'adultos');
            push(sub.childrenQuantity, 'niño', 'niños');
            push(sub.adultsNoAlcoholQuantity, 'sin alcohol', 'sin alcohol');
        } else if (svc.type === 'tour' && sub.isWalkingTour) {
            push(sub.adultsQuantity, 'adulto', 'adultos');
            push(sub.childrenQuantity, 'niño', 'niños');
            push(sub.infantsQuantity, 'infante', 'infantes');
            if (!parts.length) push(sub.walkingTourPeopleCount, 'persona', 'personas');
        }
        // Respaldo común: el conteo plano del servicio (o el de la reservación) cuando no hay desglose.
        if (!parts.length) push(sub.persons || sub.numberOfPeople, 'persona', 'personas');
        return parts.join(', ');
    }

    // Ubicaciones del servicio, como renglones etiquetados bajo el título (el hueco que dejó
    // "Desde/Hacia"). En los TRASLADOS son las DIRECCIONES exactas de pick-up y drop-off: la ruta ya la
    // dice el título, pero la calle y el punto de encuentro no estaban a la vista — vivían enterrados en
    // la sección UBICACIONES. En tours y experiencias se conserva el origen/destino por nombre, porque
    // ahí el título es el nombre del servicio y no dice de dónde sale.
    function serviceLocationLines(svc) {
        const sub = svc.subconcept || {};
        const lines = [];
        const add = (label, value) => {
            const v = String(value == null ? '' : value).trim();
            if (v) lines.push({ label, value: v });
        };
        if (svc.type === 'transport') {
            if (sub.tripType === 'round-trip') {
                add('Pick-up (ida)', sub.pickupAddressIda);
                add('Drop-off (ida)', sub.dropoffAddressIda);
                add('Pick-up (regreso)', sub.pickupAddressVuelta);
                add('Drop-off (regreso)', sub.dropoffAddressVuelta);
            } else {
                add('Pick-up', sub.pickupAddress);
                add('Drop-off', sub.dropoffAddress);
            }
        } else {
            add('Desde', svc.originName);
            add('Hacia', svc.destinationName);
            add('Pick-up', sub.pickupAddress);
        }
        return lines;
    }

    // Nombres de las personas del servicio, justo bajo el conteo: esa línea dice CUÁNTOS ("3 adultos,
    // 1 niño"), esta QUIÉNES. Sin rótulo ni contador: apiladas se entiende la relación, y un segundo
    // conteo junto al primero invitaba a leer un error cuando difieren (los nombres capturados no
    // tienen por qué ser todos los pasajeros).
    function serviceAttendeesLine(svc) {
        const sub = svc.subconcept || {};
        if (!Array.isArray(sub.attendees)) return '';
        const names = sub.attendees.map((n) => String(n == null ? '' : n).trim()).filter(Boolean);
        if (!names.length) return '';
        return `<div class="svc-names">${PaymentBreakdownHelpers.escapeHtml(names.join(', '))}</div>`;
    }

    // Hora OPERATIVA del servicio: cuándo hay que estar ahí. En un traslado de SALIDA a aeropuerto hay
    // DOS horas distintas y no son intercambiables:
    //   svc.time                     -> hora del VUELO (18:00) — su lugar es la tabla de Vuelos
    //   flightDepartureTimeSuggested -> hora de PICK-UP (14:15), calculada hacia atrás desde el vuelo
    //                                   restando la ruta y la anticipación de aeropuerto
    // Para el chofer manda la de pick-up, así que es la que encabeza el servicio. En LLEGADAS hay una
    // sola —el chofer pasa cuando aterriza el avión—, así que ahí no cambia nada.
    function servicePickupTime(svc) {
        const sub = svc.subconcept || {};
        if (svc.type === 'transport' && sub.transportType === 'aeropuerto' && sub.directionType === 'departure') {
            const suggested = svc.flightDepartureTimeSuggested || sub.flightDepartureTimeSuggested;
            if (suggested) return roundTimeToNearest15(suggested) || suggested;
        }
        let t = svc.time || sub.startTime || sub.time || '';
        if (!t && sub.selectedSchedule) {
            const m = String(sub.selectedSchedule).match(/^(\d{1,2}:\d{2})/);
            if (m) [, t] = m;
        }
        return t;
    }

    // Hora del VUELO, cuando es un dato distinto al pick-up (solo salidas a aeropuerto). Sirve para
    // aclarar en el encabezado que la hora mostrada NO es la del avión.
    function serviceFlightTime(svc) {
        const sub = svc.subconcept || {};
        if (svc.type !== 'transport' || sub.transportType !== 'aeropuerto') return '';
        const m = String(svc.time || sub.time || sub.selectedSchedule || '').match(/^(\d{1,2}:\d{2})/);
        return m ? m[1] : '';
    }

    // Duración del servicio POR TIPO, mismo criterio que serviceDuration() del itinerario: cada tipo la
    // guarda en un campo distinto y no son intercambiables.
    //   a-disposición      -> hours          (horas contratadas)
    //   tour / experiencia -> duration       (duración del catálogo, en horas)
    //   traslado           -> routeDuration  (duración de la ruta, en MINUTOS)
    //   concepto           -> ninguna
    // El orden importa: los subconceptos arrastran un `duration: 1` espurio en todo lo que no es tour,
    // así que con `duration` primero un a-disposición de 6 h se anunciaba como "1 h".
    // El texto sigue el mismo formato que durationLabel() del itinerario ("4 hours", "1 h 45 min"),
    // pero con la palabra en español: aquella plantilla es de cara al cliente y está en inglés, esta
    // vista es interna. Misma forma, mismo idioma que el resto de la pantalla.
    function serviceDurationLabel(svc) {
        const sub = svc.subconcept || {};
        const hoursLabel = (h) => `${h} hora${h === 1 ? '' : 's'}`;
        if (svc.type === 'a-disposicion') {
            const h = Number(sub.hours || 0);
            return h > 0 ? hoursLabel(h) : '';
        }
        if (svc.type === 'tour' || svc.type === 'experience') {
            const h = Number(sub.duration || sub.hours || 0);
            return h > 0 ? hoursLabel(h) : '';
        }
        if (svc.type === 'transport') {
            const min = Number(sub.routeDuration || 0);
            if (min <= 0) return '';
            const h = Math.floor(min / 60);
            const m = min % 60;
            if (h === 0) return `${m} min`;
            return m ? `${h} h ${m} min` : hoursLabel(h);
        }
        return '';
    }

    // Etiqueta del día con el mismo formato que dayLabel() de reservation-itinerary.ejs
    // ("Miércoles. Jul 29"), pero con los días en español: aquella plantilla es de cara al cliente y
    // está en inglés, esta vista es interna y va en español (usa el mismo DOW_ES que ya declara).
    const SVC_DOW = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
    const SVC_MONTHS = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto',
        'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    function itinDayLabel(dateStr) {
        if (!dateStr) return '';
        // "YYYY-MM-DD" se arma como fecha LOCAL (igual que toDate del itinerario): pasarla por
        // new Date(str) la interpretaría como UTC y correría el día en zonas con offset negativo.
        const plain = /^\d{4}-\d{2}-\d{2}$/.test(String(dateStr));
        const d = plain
            ? (() => { const [y, m, dd] = String(dateStr).split('-').map(Number); return new Date(y, m - 1, dd); })()
            : new Date(dateStr);
        if (Number.isNaN(d.getTime())) return '';
        return `${SVC_DOW[d.getDay()]}. ${SVC_MONTHS[d.getMonth()].slice(0, 3)} ${d.getDate()}`;
    }

    // Ícono del riel de la línea de tiempo: MISMO criterio que iconKey() de reservation-itinerary.ejs,
    // para que un servicio se vea igual en la lista y en el itinerario. Son PNG de /images/icons, no
    // la fuente Tabler (que además no tenía glifo para todos los tipos).
    // Los tipos que el itinerario no distingue caen en su mismo default ('experience'), salvo
    // a-disposición: es transporte con vehículo, así que comparte el ícono de traslado.
    function getServiceIconKey(svc) {
        const sub = svc.subconcept || {};
        const transportType = sub.transportType || svc.transportType;
        const directionType = sub.directionType || svc.directionType;
        if (svc.type === 'transport' || svc.type === 'traslado') {
            if (transportType === 'aeropuerto') return directionType === 'departure' ? 'departure' : 'arrival';
            return 'transfer';
        }
        if (svc.type === 'tour') return 'city';
        if (svc.type === 'a-disposicion') return 'transfer';
        return 'experience';
    }

    function getServiceTypeLabel(type) {
        const labels = {
            transport: 'Transporte',
            tour: 'Tour',
            experience: 'Experiencia',
            concepto: 'Concepto',
            'a-disposicion': 'A Disposición',
        };
        return labels[type] || type || '';
    }

    // Returns a human-readable concept for a service. A-disposición services often have
    // an empty concept field — fall back to the literal type label instead of a dash.
    function getDisplayConcept(svc) {
        const raw = (svc?.concept || '').trim();
        if (raw) return raw;
        if (svc?.type === 'a-disposicion') return 'A Disposición';
        return '—';
    }

    function getRoleBadge(role, displayRole) {
        const r = displayRole || role || '';
        const map = {
            driver: { label: 'Conductor', cls: 'bg-info-subtle text-info' },
            guia: { label: 'Guia', cls: 'bg-success-subtle text-success' },
            greeter: { label: 'Greeter', cls: 'bg-warning-subtle text-warning' },
            employee_amexing: { label: 'Amexing', cls: 'bg-primary-subtle text-primary' },
            limpieza: { label: 'Limpieza', cls: 'bg-secondary-subtle text-secondary' },
            admin: { label: 'Admin', cls: 'bg-danger-subtle text-danger' },
        };
        const s = map[r] || map[role] || { label: r || 'N/A', cls: 'bg-secondary-subtle text-secondary' };
        return `<span class="badge ${s.cls}" style="font-size:0.65rem;">${s.label}</span>`;
    }

    // Failure modes are kept DISTINCT so the message points at the real cause instead of a
    // single opaque "Error al cargar": (1) network/HTTP or API success:false vs (2) an
    // exception thrown while rendering valid data. Both are logged with detail to the console.
    async function loadReservation() {
        let result;
        try {
            const response = await fetch(`/api/reservations/${reservationId}`, {
                headers: { 'Authorization': `Bearer ${authToken()}` }
            });
            result = await response.json().catch(() => null);
            if (!response.ok || !result || !result.success) {
                const reason = (result && result.error) ? result.error : `HTTP ${response.status}`;
                console.error('Error loading reservation:', reason, result);
                document.getElementById('loadingState').innerHTML = `<p class="text-danger">Error al cargar la reservacion (${reason})</p>`;
                return;
            }
        } catch (error) {
            console.error('Error loading reservation (red):', error);
            document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al cargar la reservacion (sin conexion)</p>';
            return;
        }

        // Render separately: a render-time exception (unexpected/malformed data) is reported
        // distinctly from a fetch/API failure, and no longer masquerades as "no se pudo cargar".
        try {
            reservationData = result.data;
            renderReservation();
        } catch (error) {
            console.error('Error rendering reservation:', error);
            document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al mostrar la reservacion. Revisa la consola para el detalle.</p>';
        }
    }

    function renderReservation() {
        const d = reservationData;

        document.getElementById('breadcrumbFolio').textContent = d.folio;
        document.getElementById('pageTitle').innerHTML = `<i class="ti ti-clipboard-list me-2 text-primary"></i>${d.folio}`;

        const quoteLink = document.getElementById('infoQuoteLink');
        if (d.quoteId) {
            // Abrimos desde una reservación → activamos la bandera de contexto para que
            // el detalle muestre títulos/estado como "Reservación".
            quoteLink.href = `/dashboard/admin/quotes/${d.quoteId}?context=reservation`;
            quoteLink.textContent = d.quoteFolio;
        }

        const quoteBadge = getQuoteStatusBadge(d.quoteStatus);
        const reservationBadge = getReservationOverallStatusBadge(d.status);
        document.getElementById('infoStatus').innerHTML = `${quoteBadge} ${reservationBadge}`;
        wireQuoteStatusDropdown();
        // Display company name first, then fallback to fullName or contactPerson
        const clientDisplay = d.client?.companyName || d.client?.fullName || d.contactPerson || '—';
        document.getElementById('infoClient').textContent = clientDisplay;
        // Contacto: nombre (si existe) + email + teléfono, cada uno en su línea y solo si viene.
        const contactName = (d.contactPerson
            || `${d.contactFirstName || ''} ${d.contactLastName || ''}`.trim()).trim();
        const contactLines = [];
        if (contactName) contactLines.push(`<span class="fw-semibold">${PaymentBreakdownHelpers.escapeHtml(contactName)}</span>`);
        if (d.contactEmail) contactLines.push(PaymentBreakdownHelpers.escapeHtml(d.contactEmail));
        if (d.contactPhone) contactLines.push(PaymentBreakdownHelpers.escapeHtml(d.contactPhone));
        document.getElementById('infoContact').innerHTML = contactLines.length ? contactLines.join('<br>') : '&mdash;';
        document.getElementById('infoEventType').textContent = d.eventType || '—';
        document.getElementById('infoPeople').textContent = d.numberOfPeople || '—';

        // Lead guest — only render row when at least one name is present. Falls back to
        // contactFirstName/contactPerson so a reservation that has the actual traveler in
        // the contact fields still surfaces it as the lead guest.
        const leadGuestParts = [d.leadGuestFirstName, d.leadGuestLastName]
            .map((p) => (p || '').trim())
            .filter(Boolean);
        const leadGuestName = leadGuestParts.length > 0
            ? leadGuestParts.join(' ')
            : (d.contactPerson || '').trim();
        const leadGuestRow = document.getElementById('infoLeadGuestRow');
        const leadGuestEl = document.getElementById('infoLeadGuest');
        if (leadGuestEl && leadGuestRow) {
            // La celda siempre ocupa su lugar en la rejilla; solo se vacía cuando no hay lead guest.
            leadGuestEl.textContent = leadGuestName || '—';
            leadGuestRow.classList.toggle('is-empty', !leadGuestName);
        }

        // Quote-level notes — same callout style as service notes.
        const quoteNotesRow = document.getElementById('infoQuoteNotesRow');
        const quoteNotesEl = document.getElementById('infoQuoteNotes');
        const quoteNotesText = (d.notes || '').trim();
        if (quoteNotesText && quoteNotesEl && quoteNotesRow) {
            quoteNotesEl.textContent = quoteNotesText;
            quoteNotesRow.classList.remove('d-none');
        }
        document.getElementById('infoDates').innerHTML = formatDateRange(d.startDate, d.endDate);
        // Duración (noches) = diferencia en días; se oculta en reservaciones de un solo día.
        const nightsEl = document.getElementById('infoNights');
        if (nightsEl) {
            if (d.startDate && d.endDate) {
                const nights = Math.max(0, Math.round((new Date(d.endDate) - new Date(d.startDate)) / 86400000));
                nightsEl.textContent = nights <= 0 ? '' : (nights === 1 ? '1 noche' : `${nights} noches`);
            } else {
                nightsEl.textContent = '';
            }
        }
        // Tipo de Pago y Total se movieron fuera de este encabezado: el Tipo de Pago ahora se
        // muestra dentro del "Resumen Financiero" (renderFinancialSummary), donde también vive el
        // Total; así el encabezado queda solo con datos generales.

        // Assignment counter
        const totalSvc = (d.services || []).length;
        // Los servicios 'concepto' no requieren asignación → cuentan como asignados.
        const assignedSvc = (d.services || []).filter(s => s.status === 'assigned' || s.status === 'completed' || s.type === 'concepto').length;
        const completedSvc = (d.services || []).filter(s => s.status === 'completed').length;
        const counterEl = document.getElementById('infoAssignmentCounter');
        // Color del avance por estado (coincide con la barra de progreso de abajo).
        const assignColor = completedSvc === totalSvc ? '#4b6b3f'
            : assignedSvc === totalSvc ? '#6E7A50'
                : assignedSvc > 0 ? '#b8894a' : '#8a8f78';
        if (totalSvc > 0) {
            counterEl.innerHTML = `<span class="bkg-count" style="color:${assignColor}">${assignedSvc}</span>`
                + `<span class="bkg-count-total">/${totalSvc}</span>`
                + '<span class="bkg-count-cap">asignados</span>';
        } else {
            counterEl.innerHTML = '<span class="text-muted">Sin servicios</span>';
        }
        const assignSubEl = document.getElementById('infoAssignmentSub');
        if (assignSubEl) {
            assignSubEl.textContent = (totalSvc > 0 && completedSvc > 0) ? `${completedSvc} completados` : '';
        }

        // Barra de progreso de asignación (avance = asignados / total).
        const progWrap = document.getElementById('infoAssignmentProgress');
        const progBar = document.getElementById('infoAssignmentBar');
        if (progWrap && progBar && totalSvc > 0) {
            const pct = Math.round((assignedSvc / totalSvc) * 100);
            progBar.style.width = `${pct}%`;
            progBar.style.background = assignColor;
            progWrap.classList.remove('d-none');
        } else if (progWrap) {
            progWrap.classList.add('d-none');
        }

        const scEl = document.getElementById('infoServiceCustomer');
        if (d.serviceCustomer) {
            scEl.innerHTML = buildPersonCard(d.serviceCustomer, 'Customer Support', 'ti-headset', 'primary');
        } else {
            scEl.innerHTML = '<span class="text-muted">Sin asignar</span>';
        }

        const canAssign = d.status !== 'cancelled' && d.status !== 'completed';
        const changeScBtn = document.getElementById('changeServiceCustomerBtn');
        if (canAssign) {
            changeScBtn.classList.remove('d-none');
        } else {
            changeScBtn.classList.add('d-none');
        }

        const actions = document.getElementById('headerActions');
        const folio = encodeURIComponent(d.folio || '');
        // Las dos exportaciones van juntas en un control segmentado: son la misma acción con dos
        // variantes, así que "Exportar" queda implícito en el grupo y cada botón solo nombra el
        // documento. El aria-label/title conserva la frase completa para lector de pantalla y hover.
        // El contrato es un placeholder: la vista/ruta aún no existe; se cablea después.
        const exportSegHtml = folio
            ? `<span class="hdr-seg" role="group" aria-label="Exportar">
                <a class="hdr-seg-btn" href="/reservations/${folio}" target="_blank" rel="noopener"
                   title="Exportar confirmación — abre la vista pública, exportable a PDF"
                   aria-label="Exportar confirmación"><i class="ti ti-file-export"></i>Confirmación</a>
                <button type="button" class="hdr-seg-btn" id="exportContractBtn"
                   title="Exportar contrato de servicio — próximamente"
                   aria-label="Exportar contrato de servicio" disabled><i class="ti ti-file-text"></i>Contrato</button>
              </span>`
            : '';
        // En vez del botón de cancelar: si ya está cancelada, mostrar etiqueta
        // "Cancelada"; si tiene una solicitud de cancelación pendiente, mostrar
        // "Pendiente de cancelación" (evita además crear solicitudes duplicadas).
        let cancelBtnHtml = '';
        if (d.status === 'cancelled') {
            cancelBtnHtml = `<span class="badge bg-danger text-white"><i class="ti ti-x me-1"></i>Cancelada</span>`;
        } else if (d.hasPendingCancellation) {
            cancelBtnHtml = `<span class="badge bg-warning text-dark border border-danger-subtle" title="Tiene una solicitud de cancelación pendiente de aprobación"><i class="ti ti-clock me-1"></i>Pendiente de cancelación</span>`;
        } else if (canAssign) {
            cancelBtnHtml = `<button type="button" class="hdr-danger" id="cancelResBtn"><i class="ti ti-x"></i>Cancelar reservación</button>`;
        }
        actions.innerHTML = `<div class="d-flex gap-2 align-items-center">${exportSegHtml}${cancelBtnHtml}</div>`;
        // Botón "Exportar itinerario" del header de Servicios → página de itinerario (exportable a PDF).
        const itinBtn = document.getElementById('exportItineraryBtn');
        if (itinBtn && folio) {
            itinBtn.href = `/reservations/${folio}/itinerary`;
            itinBtn.classList.remove('d-none');
        }
        // El listener solo aplica cuando se renderizó el botón (no en las etiquetas).
        document.getElementById('cancelResBtn')?.addEventListener('click', () => {
            // Use shared utility with existing reservation data and loadReservation callback
            openReservationCancelModalWithData(reservationData, loadReservation);
        });

        renderServices(d.services);
        renderFinancialSummary();
        loadPayments();

        document.getElementById('loadingState').style.display = 'none';
        document.getElementById('reservationContent').style.display = '';
    }

    // Round a HH:MM string DOWN to the previous 15-minute mark — same strategy used
    // in the quote services list so timestamps stay consistent across views.
    function roundTimeToNearest15(timeStr) {
        if (!timeStr || !timeStr.includes(':')) return timeStr || '';
        const [hours, minutes] = timeStr.split(':').map(Number);
        if (Number.isNaN(hours) || Number.isNaN(minutes)) return timeStr;
        let totalMinutes = hours * 60 + minutes;
        totalMinutes = Math.floor(totalMinutes / 15) * 15;
        const h = Math.floor(totalMinutes / 60) % 24;
        const m = totalMinutes % 60;
        return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
    }

    // Build a single detail line: small icon + label (optional) + value.
    function detailLine(icon, value, label) {
        if (value == null || value === '') return '';
        const labelHtml = label ? `<span class="text-muted me-1">${label}:</span>` : '';
        return `<div class="d-flex align-items-center gap-1 small text-dark">
                    <i class="ti ti-${icon} text-secondary" style="font-size: 0.9rem;"></i>
                    ${labelHtml}<span>${value}</span>
                </div>`;
    }

    // Build a section: small header + flex-wrap of items.
    function detailSection(icon, title, items) {
        const filtered = items.filter(Boolean);
        if (filtered.length === 0) return '';
        return `<div class="mt-2">
                    <div class="d-flex align-items-center gap-1 text-secondary mb-1" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">
                        <i class="ti ti-${icon}"></i>${title}
                    </div>
                    <div class="d-flex flex-wrap" style="row-gap: 0.15rem; column-gap: 1.25rem;">
                        ${filtered.join('')}
                    </div>
                </div>`;
    }

    function getSubconceptDetails(svc) {
        const sub = svc.subconcept;
        if (!sub) return '';
        // Legacy tags array kept for non-categorized stuff; new sections below replace
        // most of the old badge rows.
        const tags = [];
        const tag = (icon, text, color) => `<span class="badge detail-tag bg-${color}-subtle text-${color}"><i class="ti ti-${icon} me-1"></i>${text}</span>`;

        // ===== Sections (replaces the legacy badge row) =====
        // Build categorized detail lines so the operator can scan the info quickly.

        // SERVICIO — vehicle count, included roles, hotel, etc.
        // "Sencillo — Salida" salió de aquí: la DIRECCIÓN ya la dice el ícono del riel (arrival.png vs
        // departure.png en traslados de aeropuerto) y el REDONDO se ve en Ubicaciones, que en ese caso
        // desglosa pick-up y drop-off de ida y de regreso.
        const servicioItems = [];
        if (svc.type === 'a-disposicion' && sub.vehicleCount && sub.vehicleCount > 0) {
            servicioItems.push(detailLine('car', `${sub.vehicleCount} vehículo${sub.vehicleCount > 1 ? 's' : ''}`));
        }
        if (svc.type !== 'a-disposicion' && sub.quantity && sub.quantity > 1) {
            servicioItems.push(detailLine('car', `${sub.quantity} vehículos`));
        }
        const guideLabel = svc.type === 'a-disposicion' ? 'Chofer' : 'Guía';
        if (sub.includeGuide === true) {
            servicioItems.push(detailLine('map-pin', `${guideLabel} incluido`));
        }
        if (sub.includeGreeter === true) {
            const inVehicle = sub.greeterInVehicle ? ' (en vehículo)' : ' (en punto)';
            servicioItems.push(detailLine('hand-stop', `Greeter incluido${inVehicle}`));
        }
        if (svc.type === 'tour' && sub.hotelName) {
            servicioItems.push(detailLine('building', sub.hotelName, 'Hotel'));
        }
        // Entradas asociadas a la experiencia (boletos de acceso): nombre + ×cantidad si > 1.
        if (svc.type === 'experience' && Array.isArray(sub.experienceEntradas)) {
            const incEntradas = sub.experienceEntradas.filter((e) => e && e.included !== false);
            if (incEntradas.length > 0) {
                const escEnt = (t) => String(t == null ? '' : t).replace(/[&<>"]/g, (ch) => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;',
                }[ch]));
                const listEnt = incEntradas
                    .map((e) => `${escEnt(e.name || 'Entrada')}${Number(e.quantity) > 1 ? ` ×${e.quantity}` : ''}`)
                    .join(', ');
                servicioItems.push(detailLine('ticket', `Entradas: ${listEnt}`));
            }
        }
        // Entradas asociadas al/los destino(s) del tour (boletos de acceso): nombre + ×cantidad si > 1.
        if (svc.type === 'tour' && Array.isArray(sub.tourEntradas)) {
            const incEntradas = sub.tourEntradas.filter((e) => e && e.included !== false);
            if (incEntradas.length > 0) {
                const escEnt = (t) => String(t == null ? '' : t).replace(/[&<>"]/g, (ch) => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;',
                }[ch]));
                const listEnt = incEntradas
                    .map((e) => `${escEnt(e.name || 'Entrada')}${Number(e.quantity) > 1 ? ` ×${e.quantity}` : ''}`)
                    .join(', ');
                servicioItems.push(detailLine('ticket', `Entradas: ${listEnt}`));
            }
        }

        // HORARIO — solo lo que NO está ya en el encabezado del servicio.
        // La hora de pick-up de los traslados de aeropuerto salió de aquí: ahora encabeza el servicio
        // (servicePickupTime), donde se lee de inmediato en vez de bajo un rótulo "Horario" que no
        // decía de qué hora hablaba. La del vuelo vive en la tabla de Vuelos.
        const horarioItems = [];
        // El "Horario" de experiencias y a-disposición (selectedSchedule) también salió: su hora de
        // inicio ya encabeza el servicio, y cuando es un rango ("09:00 – 15:00") el final se deduce de
        // la duración que va al lado ("09:00 - 6 horas").
        // La DURACIÓN (horas contratadas de a-disposición y duración de ruta de un traslado) ya se
        // muestra junto a la hora, arriba del título — ver serviceDurationLabel. Aquí se repetía.
        if (sub.waitingTimeHours) {
            horarioItems.push(detailLine('clock-pause', `${sub.waitingTimeHours}h`, 'Espera'));
        }
        if (Array.isArray(sub.extraAdditionalVehicles)) {
            sub.extraAdditionalVehicles.forEach((v) => {
                const wh = parseFloat(v && v.waitingHours) || 0;
                if (wh > 0) horarioItems.push(detailLine('clock-pause', `${wh}h`, `Espera ${(v.vehicleTypeName || 'adicional')}`));
            });
        }

        // PERSONAS desapareció como sección: el CONTEO se movió a la línea destacada bajo el título
        // (servicePeopleLabel) y la lista nominal de ASISTENTES a su propio renglón etiquetado, junto a
        // las ubicaciones (serviceAttendeesLine). No quedaba nada más que mostrar aquí.
        // "Walking tour" era lo único que se perdía al mover el conteo: su etiqueta describía la
        // naturaleza del tour, no su gente. Pasa a SERVICIO, que es donde vive ese tipo de dato.
        if (svc.type === 'tour' && sub.isWalkingTour) {
            servicioItems.push(detailLine('walk', 'Walking tour'));
        }

        // VUELOS — mini tabla en el formato del itinerario (.itin-flight): encabezado chico arriba y el
        // valor en negrita abajo, en vez del renglón "AeroMéxico AM123 @ 14:15".
        // Se conservan dos columnas que el itinerario no tiene: la HORA del vuelo (distinta al pick-up
        // del Horario) y los VUELOS ADICIONALES, que aquí van como renglones extra de la misma tabla.
        // Terminal y Puerta se incluyen por fidelidad, pero hoy siempre salen "—": el dato no existe en
        // el modelo, y el itinerario también los deja fijos en "—".
        const flightRows = [];
        if (svc.type === 'transport') {
            if (sub.airline || sub.flightNumber) {
                // Hora real del vuelo (llegada o salida del avión), distinta al pick-up del Horario.
                const fm = String(svc.time || sub.selectedSchedule || sub.time || '').match(/^(\d{1,2}:\d{2})/);
                flightRows.push({ airline: sub.airline, flightNumber: sub.flightNumber, time: fm ? fm[1] : '' });
            }
            if (Array.isArray(sub.additionalFlights)) {
                sub.additionalFlights.forEach((f) => {
                    const airline = (f.airline || '').trim();
                    const flightNumber = (f.flightNumber || '').trim();
                    const time = (f.flightTime || '').trim();
                    if (airline || flightNumber || time) flightRows.push({ airline, flightNumber, time });
                });
            }
        }
        // El texto de aerolínea/vuelo lo escribe el usuario: se escapa (antes se interpolaba crudo).
        const escF = PaymentBreakdownHelpers.escapeHtml;
        const vuelosHtml = flightRows.length
            ? `<div class="svc-flight">
                 <div class="h">Aerolínea</div><div class="h">Vuelo</div><div class="h">Hora</div><div class="h">Terminal</div><div class="h">Puerta</div>
                 ${flightRows.map((f) => `<div class="v">${escF(f.airline) || '—'}</div><div class="v">${escF(f.flightNumber) || '—'}</div><div class="v">${escF(f.time) || '—'}</div><div class="v">—</div><div class="v">—</div>`).join('')}
               </div>`
            : '';

        // OTROS — discounts, etc.
        const otrosItems = [];
        if (svc.type === 'a-disposicion' && sub.discountPercent) {
            otrosItems.push(detailLine('discount-2', `${sub.discountPercent}% descuento`));
        }
        // Fase 2d: descuento y propina por servicio (ya reflejados en el total del servicio). El
        // descuento se escala por la forma de pago (getServiceDiscountByType) para coincidir con el
        // precio por método mostrado arriba (getServicePriceByType), en vez del monto bruto en efectivo.
        if (Number(sub.discountAmount) > 0) {
            const dPct = (sub.discountType === 'percent' && sub.discountValue) ? ` ${sub.discountValue}%` : '';
            const dScaled = getServiceDiscountByType(svc, reservationData.paymentType);
            otrosItems.push(detailLine('discount-2', `Descuento${dPct} −${formatCurrency(dScaled, reservationData.currency)}`));
        }
        if (Number(sub.tipAmount) > 0) {
            const tPct = (sub.tipType === 'percent' && sub.tipValue) ? ` ${sub.tipValue}%` : '';
            const tMand = sub.tipMandatory ? ' (obligatoria)' : '';
            otrosItems.push(detailLine('coin', `Propina${tPct} +${formatCurrency(sub.tipAmount, reservationData.currency)}${tMand}`));
        }

        // UBICACIONES salió de las secciones: sus direcciones ahora encabezan el servicio como
        // renglones etiquetados (serviceLocationLines), donde se leen sin tener que bajar la vista.

        const sectionsHtml = [
            detailSection('info-circle', 'Servicio', servicioItems),
            detailSection('clock', 'Horario', horarioItems),
            // Sin encabezado de sección: la mini tabla ya rotula sus columnas (Aerolínea / Vuelo / …),
            // así que un "VUELOS" encima solo repetía. El itinerario tampoco lo lleva.
            vuelosHtml,
            detailSection('award', 'Otros', otrosItems),
        ].filter(Boolean).join('');

        // Notes — render each note channel as its own callout so the operator can quickly
        // tell who the note is for. Prefer the subconcept snapshot, with sensible fallbacks.
        // Visibility by role:
        //   notes (general)  → all roles
        //   clientNotes      → client + department_manager + admin/superadmin
        //   providerNotes    → admin/superadmin only
        //   teamNotes        → admin/superadmin only
        //   internalNotes    → admin/superadmin only
        const isAdmin = userRole === 'admin' || userRole === 'superadmin';
        const isClientFacing = isAdmin || userRole === 'department_manager' || userRole === 'client';
        const noteChannels = [
            // Sin rótulo: es el canal general y por defecto, así que anunciarlo no distinguía nada —
            // a diferencia de proveedor / equipo / internas, donde saber a quién va dirigida es el dato.
            { label: '', icon: 'notes', tier: '', text: (sub.notes || svc.notes || '').trim(), visible: true },
            { label: 'Notas del cliente', icon: 'user', tier: 'is-client', text: (sub.agencyNotes || '').trim(), visible: true },
            { label: 'Notas del cliente (catálogo)', icon: 'book', tier: 'is-client', text: (sub.clientNotes || '').trim(), visible: isClientFacing },
            { label: 'Notas del proveedor', icon: 'building', tier: 'is-ops', text: (sub.providerNotes || '').trim(), visible: isAdmin },
            { label: 'Notas del equipo', icon: 'users', tier: 'is-ops', text: (sub.teamNotes || '').trim(), visible: isAdmin },
            { label: 'Notas internas', icon: 'lock', tier: 'is-internal', text: (sub.internalNotes || '').trim(), visible: isAdmin },
        ].filter((n) => n.visible && n.text);

        // Formato del itinerario (.itin-desc + renderNotes): texto corrido justificado, sin caja gris
        // ni filete de color. Se CONSERVA la etiqueta del canal —reducida a un rótulo en versalitas—
        // porque el itinerario solo tiene notas de cara al cliente y no necesita distinguirlas, pero
        // aquí saber si una nota es del proveedor, del equipo o interna es justo lo que importa.
        const notesHtml = noteChannels.map((n) => `
            <div class="svc-note">
                ${n.label ? `<span class="svc-note-lbl ${n.tier}"><i class="ti ti-${n.icon}"></i>${n.label}</span>` : ''}
                <div class="svc-note-body">${renderServiceNotes(n.text)}</div>
            </div>
        `).join('');

        return sectionsHtml + notesHtml;
    }

    function renderServices(services) {
        const container = document.getElementById('servicesContainer');

        const days = {};
        services.forEach(svc => {
            const key = svc.dayNumber || 1;
            // El título se guarda TAL CUAL (sin caer a "Dia N"): la barra ya nombra el día, así que un
            // título de respaldo se leería duplicado ("Día 1 — Dia 1").
            if (!days[key]) days[key] = { title: svc.dayTitle || '', date: svc.serviceDate, services: [] };
            days[key].services.push(svc);
        });

        // Order services within each day chronologically — same strategy used by the
        // quote services list (sortSubconceptsByTime). Empty times go to the end.
        const parseTimeToMinutes = (timeStr) => {
            if (!timeStr) return null;
            // Range format "HH:MM - HH:MM" → use the start of the range
            const rangeMatch = String(timeStr).match(/^(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})/);
            if (rangeMatch) return parseInt(rangeMatch[1], 10) * 60 + parseInt(rangeMatch[2], 10);
            const singleMatch = String(timeStr).match(/^(\d{1,2}):(\d{2})/);
            if (singleMatch) return parseInt(singleMatch[1], 10) * 60 + parseInt(singleMatch[2], 10);
            return null;
        };
        Object.values(days).forEach((d) => {
            d.services.sort((a, b) => {
                const ma = parseTimeToMinutes(a.time);
                const mb = parseTimeToMinutes(b.time);
                if (ma === null && mb === null) return 0;
                if (ma === null) return 1;
                if (mb === null) return -1;
                return ma - mb;
            });
        });

        if (Object.keys(days).length === 0) {
            container.innerHTML = '<div class="text-center py-4 text-muted">No hay servicios en esta reservacion</div>';
            return;
        }

        const canAssign = reservationData.status !== 'cancelled' && reservationData.status !== 'completed';

        let html = '<div class="svc-timeline">';
        Object.keys(days).sort((a, b) => a - b).forEach(dayNum => {
            const day = days[dayNum];
            // Cada día es su propio contenedor para que el riel de la línea de tiempo se corte al
            // final del día (el :last-child de .svc-entry es por día, no de toda la lista).
            // "Miércoles. Jul 29 · Día 1 — Llegada". El día del paquete y su título se conservan
            // porque identifican el día en la operación; el itinerario del cliente no los necesita.
            const dayDate = itinDayLabel(day.date);
            const dayLbl = `${dayDate ? `${dayDate} · ` : ''}Día ${dayNum}${day.title ? ` — ${day.title}` : ''}`;
            html += `<div class="svc-day"><div class="svc-day-bar">${dayLbl}</div>`;

            day.services.forEach(svc => {
                const includeGuide = svc.subconcept?.includeGuide;
                const includeGreeter = svc.subconcept?.includeGreeter;
                // Decide whether this service actually needs vehicle assignment slots.
                // Experiences, conceptos and walking tours never need a vehicle even if
                // their subconcept.quantity is > 0 (that's people count for them).
                const isWalkingTour = !!svc.subconcept?.isWalkingTour;
                const hasVehicleData = !!(svc.subconcept?.vehicleType || svc.subconcept?.vehicleTypeName
                    || svc.subconcept?.requiresTransport
                    || svc.subconcept?.additionalVehicleId
                    || (Array.isArray(svc.subconcept?.extraAdditionalVehicles) && svc.subconcept.extraAdditionalVehicles.length > 0));
                const needsVehicle = (svc.type === 'transport'
                    || svc.type === 'a-disposicion'
                    || (svc.type === 'tour' && !isWalkingTour && hasVehicleData));
                // For a-disposición the "quantity" field on the subconcept is the count of
                // the service entry; the actual vehicle count lives in `vehicleCount`.
                let vehicleQty = 0;
                if (needsVehicle) {
                    if (svc.type === 'a-disposicion') {
                        vehicleQty = Number(svc.subconcept?.vehicleCount) || 1;
                    } else {
                        vehicleQty = Number(svc.subconcept?.quantity) || 1;
                    }
                }

                // Parejas chofer+vehículo (una por plaza) y los roles que no van amarrados a un
                // vehículo. Las plazas que el servicio pide y nadie ha llenado se dibujan en gris
                // punteado: el hueco es justo lo que quien asigna necesita ver.
                const extras = svc.extraAssignments || [];
                // En «a disposición» el chofer se captura en el campo de guía, no en el de
                // conductor, así que la pareja nunca debe pedirlo ahí: diría «Conductor pendiente»
                // con el chofer ya asignado en el renglón de abajo.
                const isAtDisposal = svc.type === 'a-disposicion';
                const pairs = [];
                const pushPair = (driver, vehicle, segmentName, segmentColor, expectedVehicleName) => {
                    const hasDriver = !!(driver && driver.fullName);
                    const hasVehicle = !!(vehicle && vehicle.name);
                    if (!hasDriver && !hasVehicle) return;
                    pairs.push({
                        driver: hasDriver ? driver : null,
                        vehicle: hasVehicle ? vehicle : null,
                        needsDriver: !hasDriver && !isAtDisposal,
                        needsVehicle: !hasVehicle && vehicleQty > 0,
                        expectedVehicleName: expectedVehicleName || '',
                        segmentName: segmentName || '',
                        segmentColor: segmentColor || '',
                    });
                };
                pushPair(svc.assignedDriver, svc.assignedVehicle,
                    svc.subconcept?.categoryName, svc.subconcept?.categoryColor, svc.vehicleTypeName || '');
                extras.forEach((ea) => {
                    if (!ea.driverId && !ea.vehicleId) return;
                    pushPair(
                        ea.driverId ? { fullName: ea.driverName, phone: '', profilePhotoUrl: '' } : null,
                        ea.vehicleId ? { name: ea.vehicleName, imageUrl: ea.vehicleImageUrl || '' } : null,
                        ea.segmentName, ea.segmentColor, ea.vehicleName || ''
                    );
                });

                // Tipo y segmento ESPERADOS de cada plaza. Es el mismo mapeo que arma el modal de
                // asignación (ver slotSpecs en openAssignModal): plaza 0 = vehículo principal,
                // plaza 1 = adicional cuando venía marcado, 2+ = extras en orden. Se replica aquí
                // para que la lista y el formulario nombren la misma plaza igual.
                const sub = svc.subconcept || {};
                const hasPrimaryAdditional = !!(sub.additionalVehicleTypeName || svc.additionalVehicleTypeName);
                const slotSpecs = [{
                    type: sub.vehicleTypeName || vehicleTypeAsName(sub.vehicleType) || svc.vehicleTypeName || '',
                    segment: sub.categoryName || '',
                    color: sub.categoryColor || '',
                }];
                // hasPrimaryAdditional se define igual que en el modal (por el nombre del tipo) a
                // propósito: de él depende el índice de plaza, y si las dos vistas no coincidieran,
                // la lista diría "Vehículo adicional" donde el formulario dice "Vehículo extra 1".
                if (hasPrimaryAdditional) {
                    slotSpecs.push({
                        type: sub.additionalVehicleTypeName || svc.additionalVehicleTypeName || '',
                        segment: sub.additionalVehicleSegmentName || svc.additionalVehicleSegmentName || '',
                        color: sub.additionalVehicleSegmentColor || '',
                    });
                }
                // Las plazas 3+ se leen de `extraAdditionalVehicles` —la lista COTIZADA— y no de
                // `extraAssignments`, que solo tiene lo ya asignado: por eso una plaza extra vacía
                // salía como «Vehículo» pelón. La cotizada siempre trae vehicleTypeName, segmentName
                // y segmentColor, así que las extras se ven igual que la principal.
                const expectedExtras = Array.isArray(sub.extraAdditionalVehicles) ? sub.extraAdditionalVehicles : [];
                const extraSlotCount = Math.max(expectedExtras.length, extras.length);
                for (let i = 0; i < extraSlotCount; i += 1) {
                    const exp = expectedExtras[i] || {};
                    const asg = extras[i] || {};
                    slotSpecs.push({
                        type: exp.vehicleTypeName || asg.vehicleName || '',
                        segment: exp.segmentName || asg.segmentName || '',
                        color: exp.segmentColor || asg.segmentColor || '',
                    });
                }

                // Math.max: si hay más parejas asignadas —o más vehículos cotizados— que el
                // `quantity` capturado, manda lo mayor. Nunca se oculta a nadie real ni una plaza
                // que la cotización sí pidió. El piso por slotSpecs solo aplica cuando el servicio
                // de verdad lleva vehículo: slotSpecs siempre tiene la plaza principal, y sin este
                // guardia un tour caminando acabaría pidiendo camioneta.
                const totalSlots = vehicleQty > 0
                    ? Math.max(vehicleQty, pairs.length, slotSpecs.length)
                    : pairs.length;
                for (let i = pairs.length; i < totalSlots; i += 1) {
                    const spec = slotSpecs[i] || {};
                    // La negrita lleva el TIPO esperado (SEDAN, SUBURBAN) y «Pendiente» baja a la
                    // segunda línea: así el renglón vacío se lee igual que uno asignado, donde la
                    // negrita dice qué es y la línea de abajo el detalle y el estado.
                    //
                    // El segmento se hereda del servicio cuando la plaza no trae uno propio. Los
                    // campos por plaza existen para poder DIFERIR del servicio y casi nunca están
                    // capturados: sin la herencia, un traslado Premium de dos vehículos mostraba
                    // "Premium" en la primera plaza y nada en la segunda, siendo las dos Premium.
                    pairs.push({
                        pending: true,
                        label: spec.type || 'Vehículo',
                        segmentName: spec.segment || sub.categoryName || '',
                        segmentColor: spec.color || sub.categoryColor || '',
                    });
                }
                // La etiqueta de plaza solo aparece cuando hay más de una: con una sola, "Vehículo
                // principal" no distingue nada. Usa el vocabulario del modal para que coincidan.
                if (totalSlots > 1) {
                    pairs.forEach((p, i) => {
                        p.slotLabel = i === 0
                            ? 'Vehículo principal'
                            : (i === 1 && hasPrimaryAdditional
                                ? 'Vehículo adicional'
                                : `Vehículo extra ${i - (hasPrimaryAdditional ? 1 : 0)}`);
                    });
                }

                // includeGuide / includeGreeter dicen si el servicio los lleva contratados, así que
                // un rol contratado y sin asignar también se muestra pendiente. El Customer Support
                // por servicio es OPCIONAL —siempre se puede asignar, pero no se contrata—, así que
                // no lleva plaza pendiente: un «Pendiente» ahí haría creer que falta algo.
                const roles = [
                    { person: svc.assignedGuide, role: isAtDisposal ? 'Chofer' : 'Guía', expected: !!includeGuide },
                    { person: svc.assignedGreeter, role: 'Greeter', expected: !!includeGreeter },
                    { person: svc.assignedServiceCustomer, role: 'Customer Support', expected: false },
                ].filter((r) => (r.person && r.person.fullName) || r.expected)
                 .map((r) => (r.person && r.person.fullName ? r : { role: r.role, person: null }));

                const pairsHtml = pairs.map(svcPairRow).join('');
                const rolesHtml = roles.map(svcRoleRow).join('');
                const hasAssignments = pairsHtml || rolesHtml;

                // Ubicaciones en renglones etiquetados, formato del itinerario (ver serviceLocationLines).
                // Se escapan: son direcciones escritas a mano y antes se interpolaban crudas.
                const routeParts = serviceLocationLines(svc).map((l) =>
                    `<span class="lbl">${l.label}:</span> <b>${PaymentBreakdownHelpers.escapeHtml(l.value)}</b>`);
                const route = routeParts.length ? `<div class="svc-route">${routeParts.join('<br>')}</div>` : '';

                // Hora + duración, como en el itinerario ("09:00 · 2 h"). La duración también aparece
                // en la sección HORARIO de los detalles; queda duplicada a propósito hasta que decidas
                // de cuál de los dos sitios quitarla.
                // "09:00 - 4 horas", con el guion como separador igual que .itin-time del itinerario.
                // La hora es la de PICK-UP (ver servicePickupTime): en una salida a aeropuerto difiere de
                // la del vuelo, y es la que necesita quien opera. Cuando son distintas, el title lo
                // aclara para que nadie lea 14:15 pensando que es la hora del avión.
                const durLabel = serviceDurationLabel(svc);
                const pickupTime = servicePickupTime(svc);
                const flightTime = serviceFlightTime(svc);
                const timeTitle = (flightTime && flightTime !== pickupTime)
                    ? ` title="Hora de pick-up · el vuelo es a las ${flightTime}"` : '';
                const timeHtml = (pickupTime || durLabel)
                    ? `<div class="svc-time"${timeTitle}>${pickupTime}${pickupTime && durLabel ? ' - ' : ''}${durLabel}</div>`
                    : '';

                // El badge "Pago externo" (includeInTotal:false) se retiró del título en el rediseño de
                // la lista. Lo que resolvía sigue en pie: el precio mostrado es el REAL (nunca $0), vía
                // getServicePriceByTypeGross, para no aparentar un servicio gratis. Agencia y agente
                // todavía lo pintan; se alinean al portar esta maqueta.

                html += `
                <div class="svc-entry">
                    <div class="svc-rail"><div class="svc-icon"><img src="/images/icons/${getServiceIconKey(svc)}.png" alt="" onerror="this.style.display='none'"></div></div>
                    <div class="svc-body">
                        <div class="svc-head">
                            <div class="svc-head-main">
                                ${timeHtml}
                                <div class="svc-title">${getDisplayConcept(svc)}</div>
                                ${route}
                                ${servicePeopleLabel(svc) ? `<div class="svc-people"><strong>${servicePeopleLabel(svc)}</strong></div>` : ''}
                                ${serviceAttendeesLine(svc)}
                                ${(svc.vehicleTypeName && needsVehicle && vehicleQty === 1) ? `<div class="svc-vehicle">${svc.vehicleTypeName}</div>` : ''}
                            </div>
                            <div class="svc-side">
                        ${svc.type === 'concepto' && svc.status !== 'cancelled' ? '<span class="badge bg-success text-white">Lista</span>' : getReservationStatusBadge(svc.status)}
                        <span class="svc-price">${formatCurrency(getServicePriceByTypeGross(svc, reservationData.paymentType), reservationData.currency)}</span>
                        ${canAssign && svc.status !== 'cancelled' && svc.type !== 'concepto' ? `<button class="btn btn-sm ${svc.status === 'completed' ? 'btn-success' : (svc.status === 'assigned' ? 'btn-outline-success' : 'btn-outline-secondary')} status-toggle-btn" data-service-id="${svc.id}" data-current-status="${svc.status}" title="${svc.status === 'completed' ? 'Revertir a asignada' : (svc.status === 'assigned' ? 'Marcar completada' : 'Marcar asignada')}"><i class="ti ${svc.status === 'completed' ? 'ti-circle-check-filled' : (svc.status === 'assigned' ? 'ti-circle-check' : 'ti-circle')}"></i></button>` : ''}
                        ${canAssign ? (() => {
            // Build the extras payload merging the REQUESTED list (from subconcept blob — never
            // overwritten by assignments) with any current assignment info already on the record.
            // svc.extraAssignments was seeded at conversion from sub.extraAdditionalVehicles, but
            // if a future flow only updates assignment fields we still want the requested type/
            // segment to come from the snapshot.
            const requestedExtras = Array.isArray(svc.subconcept?.extraAdditionalVehicles) ? svc.subconcept.extraAdditionalVehicles : [];
            const existing = Array.isArray(svc.extraAssignments) ? svc.extraAssignments : [];
            const mergedExtras = requestedExtras.length > 0
                ? requestedExtras.map((v) => {
                    const match = existing.find((ea) => ea.vehicleTypeId === (v.vehicleId || ''));
                    return {
                        vehicleTypeId: v.vehicleId || '',
                        vehicleName: v.vehicleTypeName || '',
                        segmentId: v.segment || '',
                        segmentName: v.segmentName || '',
                        segmentColor: v.segmentColor || '',
                        driverId: match?.driverId || null,
                        vehicleId: match?.vehicleId || null,
                        vehicleImageUrl: match?.vehicleImageUrl || '',
                    };
                })
                : existing;
            return `<button class="btn btn-sm btn-outline-primary assign-btn" data-service-id="${svc.id}" data-service-type="${svc.type || ''}" data-service-concept="${getDisplayConcept(svc)}" data-service-route="${svc.originName && svc.destinationName ? `${svc.originName} → ${svc.destinationName}` : (svc.originName || svc.destinationName || '')}" data-include-guide="${includeGuide}" data-include-greeter="${includeGreeter}" data-vehicle-qty="${vehicleQty}" data-driver-id="${svc.assignedDriver?.id || ''}" data-guide-id="${svc.assignedGuide?.id || ''}" data-greeter-id="${svc.assignedGreeter?.id || ''}" data-vehicle-id="${svc.assignedVehicle?.id || ''}" data-service-customer-id="${svc.assignedServiceCustomer?.id || ''}" data-vehicle-type-name="${svc.subconcept?.vehicleTypeName || svc.subconcept?.vehicleType || svc.vehicleTypeName || ''}" data-segment-name="${svc.subconcept?.categoryName || ''}" data-segment-color="${svc.subconcept?.categoryColor || ''}" data-additional-vehicle-type-name="${svc.subconcept?.additionalVehicleTypeName || svc.additionalVehicleTypeName || ''}" data-additional-segment-name="${svc.subconcept?.additionalVehicleSegmentName || svc.additionalVehicleSegmentName || ''}" data-additional-segment-color="${svc.subconcept?.additionalVehicleSegmentColor || ''}" data-extra='${JSON.stringify(mergedExtras)}'><i class="ti ti-user-plus"></i></button>`;
        })() : ''}
                            </div>
                        </div>
                        ${getSubconceptDetails(svc)}
                        ${hasAssignments
                            ? `<div class="svc-assign">${pairsHtml}${rolesHtml}</div>`
                            : `<div class="svc-assign"><span class="svc-assign-empty">${svc.type === 'concepto' ? 'No requiere asignación' : 'Sin asignar'}</span></div>`}
                    </div>
                </div>`;
            });
            html += '</div>';
        });
        html += '</div>';

        container.innerHTML = html;

        container.querySelectorAll('.assign-btn').forEach(btn => {
            btn.addEventListener('click', () => openAssignModal(btn));
        });

        container.querySelectorAll('.status-toggle-btn').forEach(btn => {
            btn.addEventListener('click', () => toggleServiceStatus(btn));
        });
    }

    async function toggleServiceStatus(btn) {
        const serviceId = btn.dataset.serviceId;
        const current = btn.dataset.currentStatus;
        const nextMap = { pending: 'assigned', assigned: 'completed', completed: 'assigned' };
        const newStatus = nextMap[current];
        if (!newStatus) return;

        btn.disabled = true;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/services/${serviceId}/status`, {
                method: 'PATCH',
                headers: { 'Authorization': `Bearer ${authToken()}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus }),
            });
            const result = await response.json();
            if (result.success) {
                await loadReservation();
            } else {
                alert(result.error || 'Error al actualizar estado');
            }
        } catch (err) {
            console.error('Status toggle error:', err);
            alert('Error al actualizar estado');
        }
        btn.disabled = false;
    }

    async function loadEmployees() {
        if (employeesCache) return employeesCache;
        try {
            const response = await fetch('/api/employees?limit=500', {
                headers: { 'Authorization': `Bearer ${authToken()}` }
            });
            const result = await response.json();
            employeesCache = result.data?.users || result.data || result.results || [];
            return employeesCache;
        } catch { return []; }
    }

    async function loadVehicles() {
        if (vehiclesCache) return vehiclesCache;
        try {
            const response = await fetch('/api/vehicles?limit=500', {
                headers: { 'Authorization': `Bearer ${authToken()}` }
            });
            const result = await response.json();
            vehiclesCache = result.data || result.results || [];
            return vehiclesCache;
        } catch { return []; }
    }

    const roleTranslations = {
        'driver': 'Conductor',
        'conductor': 'Conductor',
        'guia': 'Guía',
        'guide': 'Guía',
        'greeter': 'Greeter',
        'employee_amexing': 'Amexing',
        'limpieza': 'Limpieza',
        'admin': 'Admin'
    };

    function translateRole(role) {
        if (!role) return '';
        return roleTranslations[role.toLowerCase()] || role;
    }

    function buildOptionHtml(items, selectedId, nameField, showRole) {
        let html = '<option value="">— Sin asignar —</option>';
        items.forEach(item => {
            const firstName = item.firstName || '';
            const lastName = item.lastName || '';
            const name = (firstName && lastName) ? `${firstName} ${lastName}` : (item[nameField] || item.fullName || item.username || item.name || 'Sin nombre');
            const id = item.id || item.objectId;
            let roleLabel = '';
            if (showRole) {
                let rolesText = '';
                if (Array.isArray(item.futureRoles) && item.futureRoles.length > 0) {
                    rolesText = item.futureRoles.map(r => translateRole(r)).join(', ');
                } else {
                    rolesText = translateRole(item.displayRole || item.role || '');
                }
                if (rolesText) roleLabel = ` · ${rolesText}`;
            }
            html += `<option value="${id}" ${id === selectedId ? 'selected' : ''}>${name}${roleLabel}</option>`;
        });
        return html;
    }

    function buildVehicleOptionHtml(vehicles, selectedId) {
        let html = '<option value="">— Sin asignar —</option>';
        vehicles.forEach(v => {
            const id = v.id || v.objectId;
            const typeName = v.vehicleTypeId?.name || '';
            const label = `${v.brand || ''} ${v.model || ''}`.trim();
            const plate = v.licensePlate ? ` (${v.licensePlate})` : '';
            const cap = v.capacity ? ` · ${v.capacity} pax` : '';
            const typePrefix = typeName ? `[${typeName}] ` : '';
            const display = `${typePrefix}${label}${plate}${cap}`;
            html += `<option value="${id}" data-name="${label}${plate}" ${id === selectedId ? 'selected' : ''}>${display}</option>`;
        });
        return html;
    }

    async function openAssignModal(btn) {
        const serviceId = btn.dataset.serviceId;
        const serviceType = btn.dataset.serviceType;
        const serviceConcept = btn.dataset.serviceConcept;
        const serviceRoute = btn.dataset.serviceRoute;
        const includeGuide = btn.dataset.includeGuide;
        const includeGreeter = btn.dataset.includeGreeter;
        // Important: parse without the `|| 1` fallback because `parseInt('0') || 1` would
        // coerce a legitimate 0 (service doesn't need vehicles) to 1.
        const parsedQty = parseInt(btn.dataset.vehicleQty, 10);
        const vehicleQty = Number.isNaN(parsedQty) ? 1 : parsedQty;
        const driverId = btn.dataset.driverId;
        const guideId = btn.dataset.guideId;
        const greeterId = btn.dataset.greeterId;
        const vehicleId = btn.dataset.vehicleId;
        const serviceCustomerId = btn.dataset.serviceCustomerId;
        const vehicleTypeName = btn.dataset.vehicleTypeName || '';
        const segmentName = btn.dataset.segmentName || '';
        const segmentColor = btn.dataset.segmentColor || '';
        const additionalVehicleTypeName = btn.dataset.additionalVehicleTypeName || '';
        const additionalSegmentName = btn.dataset.additionalSegmentName || '';
        const additionalSegmentColor = btn.dataset.additionalSegmentColor || '';
        let extraAssignments = [];
        try { extraAssignments = JSON.parse(btn.dataset.extra || '[]'); } catch { extraAssignments = []; }

        // Build per-slot expected vehicle type + segment so each pair label tells the operator
        // exactly which type of vehicle and segment goes in that slot (Sprinter / Green Class):
        //   slot 0 → main vehicle type + segment
        //   slot 1 → primary additional vehicle type + segment (if checkbox was on)
        //   slot 2+ → extras in order
        const slotSpecs = [{ type: vehicleTypeName, segment: segmentName, color: segmentColor }];
        if (additionalVehicleTypeName) {
            slotSpecs.push({ type: additionalVehicleTypeName, segment: additionalSegmentName, color: additionalSegmentColor });
        }
        extraAssignments.forEach((ea) => {
            slotSpecs.push({
                type: ea?.vehicleName || '',
                segment: ea?.segmentName || '',
                color: ea?.segmentColor || '',
            });
        });

        document.getElementById('assignServiceId').value = serviceId;

        // Modal header
        const typeLabel = getServiceTypeLabel(serviceType);
        const typeIcon = getServiceTypeIcon(serviceType);
        document.getElementById('assignModalTitle').innerHTML = `<i class="ti ${typeIcon} me-2"></i>${serviceConcept || typeLabel}`;
        const subtitleParts = [typeLabel];
        if (serviceRoute) subtitleParts.push(serviceRoute);
        document.getElementById('assignModalSubtitle').textContent = subtitleParts.join(' — ');

        const [employees, vehicles] = await Promise.all([loadEmployees(), loadVehicles()]);

        const hasFutureRole = (e, role) => Array.isArray(e.futureRoles) && e.futureRoles.some(r => r.toLowerCase() === role);
        const drivers = employees.filter(e => e.role === 'driver' || e.role === 'employee_amexing' || e.role === 'admin' || hasFutureRole(e, 'driver') || hasFutureRole(e, 'conductor'));
        const guides = employees.filter(e => e.role === 'guia' || e.role === 'employee_amexing' || e.role === 'admin' || e.displayRole === 'guia' || hasFutureRole(e, 'guia') || hasFutureRole(e, 'guide'));
        const greeters = employees.filter(e => e.role === 'greeter' || e.role === 'employee_amexing' || e.role === 'admin' || e.displayRole === 'greeter' || hasFutureRole(e, 'greeter'));
        const amexingEmployees = employees;

        // Build modal body dynamically
        const body = document.getElementById('assignModalBody');
        let html = '<input type="hidden" id="assignServiceId" value="' + serviceId + '">';

        // Vehicle/Driver pairs section
        if (vehicleQty > 1) {
            html += `<div class="mb-2"><small class="text-muted fw-semibold"><i class="ti ti-car me-1"></i>${vehicleQty} vehículos requeridos</small></div>`;
        } else if (vehicleTypeName || segmentName) {
            const inlineTypeBadge = vehicleTypeName
                ? `<span class="badge bg-secondary-subtle text-secondary ms-2"><i class="ti ti-car me-1"></i>${vehicleTypeName}</span>`
                : '';
            const inlineSegmentBadge = segmentName
                ? `<span class="badge ms-1" style="background-color: ${segmentColor || '#6c757d'}; color: #fff;">${segmentName}</span>`
                : '';
            html += `<div class="mb-2"><small class="text-muted fw-semibold">Vehículo solicitado:</small>${inlineTypeBadge}${inlineSegmentBadge}</div>`;
        }

        // Primary additional vehicle had its own dedicated checkbox in the quote modal
        // (separate from the "extras" list). To keep the slot order consistent (main → primary
        // additional → extras), the primary-additional sits at slot index 1 when present.
        const hasPrimaryAdditional = !!additionalVehicleTypeName;

        for (let i = 0; i < vehicleQty; i++) {
            // Slot mapping for assigned IDs:
            //  - i === 0           → main driver/vehicle (driverId / vehicleId top-level)
            //  - i === 1 && primary additional → no top-level legacy field; falls through to extras[0] if any
            //  - i > 0             → extraAssignments at offset (i - 1 - primaryOffset)
            const primaryOffset = hasPrimaryAdditional && i >= 1 ? 1 : 0;
            const pairDriverId = i === 0 ? driverId : (extraAssignments[i - 1 - primaryOffset]?.driverId || '');
            const pairVehicleId = i === 0 ? vehicleId : (extraAssignments[i - 1 - primaryOffset]?.vehicleId || '');
            const spec = slotSpecs[i] || { type: '', segment: '', color: '' };
            const slotLabelText = vehicleQty > 1
                ? (i === 0 ? 'Vehículo principal' : (i === 1 && hasPrimaryAdditional ? 'Vehículo adicional' : `Vehículo extra ${i - (hasPrimaryAdditional ? 1 : 0)}`))
                : '';
            const slotTypeBadge = spec.type
                ? `<span class="badge bg-secondary-subtle text-secondary ms-2"><i class="ti ti-car me-1"></i>${spec.type}</span>`
                : '';
            const slotSegmentBadge = spec.segment
                ? `<span class="badge ms-1" style="background-color: ${spec.color || '#6c757d'}; color: #fff;">${spec.segment}</span>`
                : '';

            html += `<div class="${vehicleQty > 1 ? 'vehicle-pair-group' : ''}">`;
            if (slotLabelText || slotTypeBadge || slotSegmentBadge) {
                html += `<div class="pair-label d-flex align-items-center flex-wrap">${slotLabelText}${slotTypeBadge}${slotSegmentBadge}</div>`;
            }
            html += `
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="assign-field-group mb-0">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="assign-icon bg-info-subtle text-info"><i class="ti ti-steering-wheel"></i></span>
                                <label class="form-label mb-0 fw-semibold small">Conductor</label>
                            </div>
                            <select class="form-select form-select-sm assign-driver-select" data-pair-index="${i}">
                                ${buildOptionHtml(drivers, pairDriverId, 'fullName', true)}
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="assign-field-group mb-0">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="assign-icon bg-secondary-subtle text-secondary"><i class="ti ti-car"></i></span>
                                <label class="form-label mb-0 fw-semibold small">Vehiculo</label>
                            </div>
                            <select class="form-select form-select-sm assign-vehicle-select" data-pair-index="${i}">
                                ${buildVehicleOptionHtml(vehicles, pairVehicleId)}
                            </select>
                        </div>
                    </div>
                </div>
            </div>`;
        }

        // Guide (conditionally shown) — labeled "Chofer" for a-disposición services,
        // "Guia" otherwise. Same underlying assignment field, just a clearer label.
        if (includeGuide !== 'false') {
            const guideFieldLabel = serviceType === 'a-disposicion' ? 'Chofer' : 'Guia';
            html += `
            <div class="assign-field-group" id="guideGroup">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="assign-icon bg-success-subtle text-success"><i class="ti ti-map-pin"></i></span>
                    <label class="form-label mb-0 fw-semibold small">${guideFieldLabel}</label>
                </div>
                <select class="form-select form-select-sm" id="assignGuide">
                    ${buildOptionHtml(guides, guideId, 'fullName', true)}
                </select>
            </div>`;
        }

        // Greeter (conditionally shown)
        if (includeGreeter !== 'false') {
            html += `
            <div class="assign-field-group" id="greeterGroup">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="assign-icon bg-warning-subtle text-warning"><i class="ti ti-hand-stop"></i></span>
                    <label class="form-label mb-0 fw-semibold small">Greeter</label>
                </div>
                <select class="form-select form-select-sm" id="assignGreeter">
                    ${buildOptionHtml(greeters, greeterId, 'fullName', true)}
                </select>
            </div>`;
        }

        // Service Customer
        html += `
        <div class="assign-field-group mb-0" id="serviceCustomerGroup">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="assign-icon bg-primary-subtle text-primary"><i class="ti ti-user"></i></span>
                <label class="form-label mb-0 fw-semibold small">Customer Support</label>
            </div>
            <select class="form-select form-select-sm" id="assignServiceCustomer">
                ${buildOptionHtml(amexingEmployees, serviceCustomerId, 'fullName', true)}
            </select>
        </div>`;

        body.innerHTML = html;

        const modal = new bootstrap.Modal(document.getElementById('assignModal'));
        modal.show();
    }

    document.getElementById('saveAssignmentBtn')?.addEventListener('click', async function() {
        const serviceId = document.getElementById('assignServiceId')?.value
            || document.querySelector('#assignModalBody input[type="hidden"]')?.value;
        if (!serviceId) return;

        const driverSelects = document.querySelectorAll('.assign-driver-select');
        const vehicleSelects = document.querySelectorAll('.assign-vehicle-select');

        // Primary assignment (index 0)
        const driverId = driverSelects[0]?.value || '';
        const vehicleId = vehicleSelects[0]?.value || '';
        const guideId = document.getElementById('assignGuide')?.value || '';
        const greeterId = document.getElementById('assignGreeter')?.value || '';
        const serviceCustomerId = document.getElementById('assignServiceCustomer')?.value || '';

        // Extra assignments (index 1+)
        const extraAssignments = [];
        for (let i = 1; i < driverSelects.length; i++) {
            const eDriverId = driverSelects[i]?.value || '';
            const eVehicleId = vehicleSelects[i]?.value || '';
            const driverOpt = driverSelects[i]?.selectedOptions[0];
            const vehicleOpt = vehicleSelects[i]?.selectedOptions[0];
            extraAssignments.push({
                driverId: eDriverId,
                vehicleId: eVehicleId,
                driverName: eDriverId ? (driverOpt?.textContent?.split(' · ')[0]?.trim() || '') : '',
                vehicleName: eVehicleId ? (vehicleOpt?.dataset?.name || vehicleOpt?.textContent?.trim() || '') : '',
            });
        }

        try {
            const response = await fetch(`/api/reservations/${reservationId}/services/${serviceId}/assign`, {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ driverId, guideId, greeterId, vehicleId, serviceCustomerId, extraAssignments }),
            });

            const result = await response.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('assignModal'))?.hide();
                await loadReservation();
            } else {
                alert(result.error || 'Error al guardar asignacion');
            }
        } catch (err) {
            console.error('Assignment error:', err);
            alert('Error al guardar asignacion');
        }
    });

    // Service Customer at reservation level
    document.getElementById('changeServiceCustomerBtn')?.addEventListener('click', async function() {
        const employees = await loadEmployees();
        const currentId = reservationData.serviceCustomer?.id || '';
        const select = document.getElementById('resServiceCustomerSelect');
        select.innerHTML = buildOptionHtml(employees, currentId, 'fullName', true);

        const modal = new bootstrap.Modal(document.getElementById('serviceCustomerModal'));
        modal.show();
    });

    document.getElementById('saveResServiceCustomerBtn')?.addEventListener('click', async function() {
        const serviceCustomerId = document.getElementById('resServiceCustomerSelect').value;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/service-customer`, {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ serviceCustomerId }),
            });
            const result = await response.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('serviceCustomerModal'))?.hide();
                await loadReservation();
            } else {
                alert(result.error || 'Error al asignar seguidor');
            }
        } catch (err) {
            console.error('Service customer error:', err);
            alert('Error al asignar seguidor');
        }
    });

    // ===== FINANCIAL SUMMARY =====

    function renderFinancialSummary() {
        const d = reservationData;
        const card = document.getElementById('financialSummaryCard');
        const body = document.getElementById('financialSummaryBody');
        const addBtn = document.getElementById('addAdjustmentBtn');
        const adjustments = d.adjustments || [];
        // Subtotal recomputed from per-service pricesByType[paymentType] so the booking
        // matches the quote's totals when both use the same payment type, and updates
        // correctly if payment type changes on the reservation. Falls back to the
        // stored values for very old data without pricesByType.
        const computedSubtotal = computeServicesSubtotalByType(d.services, d.paymentType);
        const servicesSubtotal = computedSubtotal > 0
            ? computedSubtotal
            : (d.servicesSubtotal || d.totalAmount || 0);
        const canEdit = d.status !== 'cancelled' && d.status !== 'completed';

        card.style.display = '';
        if (canEdit) addBtn.classList.remove('d-none');
        else addBtn.classList.add('d-none');
        // "Agregar pago" ahora se renderiza dentro del hero (solo si canEdit), así que su visibilidad
        // ya no se maneja aquí. Su click se cablea por delegación (el hero se re-renderiza).

        const charges = adjustments.filter(a => a.type === 'charge');
        const discounts = adjustments.filter(a => a.type === 'discount');
        const pay = d.payment;
        // Propina cobrada (Fase 2): SIEMPRE del summary del servidor (d.payment), NUNCA de d.globalTip del
        // snapshot bruto de la cotización (fuente no confiable) ni recalculada localmente. general +
        // por servicio suman pay.tip; el motor de pagos ya la incluye en pay.total.
        const generalTip = pay ? PaymentBreakdownHelpers.round2(pay.generalTip) : 0;
        const serviceTipsTotal = pay ? PaymentBreakdownHelpers.round2(pay.serviceTipsTotal) : 0;
        const curr = d.currency || 'MXN';

        // Tipo de pago (se muestra en el hero, junto al estado; ya no como fila del desglose).
        const paymentTypeLabel = d.paymentType
            ? d.paymentType.charAt(0).toUpperCase() + d.paymentType.slice(1)
            : '—';

        // Comparativo por método: los precios de servicios cambian por método. Se despliega desde el
        // chip de método (Transferencia ▾), no como sección suelta — queda pegado a lo que explica.
        const comparisonMethods = [
            { method: 'efectivo', label: 'Efectivo', icon: 'ti-cash' },
            { method: 'transferencia', label: 'Transferencia', icon: 'ti-building-bank' },
            { method: 'tarjeta', label: 'Tarjeta', icon: 'ti-credit-card' },
        ];
        // El método solo cambia el SUBTOTAL de servicios; el resto (ajustes, propinas) es igual. Por eso
        // el TOTAL por método = total actual + Δsubtotal — así cada fila es el "Total a pagar" en ese
        // método, y el actual coincide con el número grande del hero.
        const cmpSubtotals = comparisonMethods.map(m => ({ ...m, subtotal: computeServicesSubtotalByType(d.services, m.method) }));
        const cmpCurrentSubtotal = (cmpSubtotals.find(m => m.method === d.paymentType) || {}).subtotal || 0;
        const cmpBaseTotal = pay ? (Number(pay.total) || 0) : cmpCurrentSubtotal;
        const cmpAmounts = cmpSubtotals.map(m => ({ ...m, amount: cmpBaseTotal + (m.subtotal - cmpCurrentSubtotal) }));
        const cmpCurrent = (cmpAmounts.find(m => m.method === d.paymentType) || {}).amount || 0;
        const cmpCheapest = Math.min(...cmpAmounts.map(m => m.amount));
        const comparisonRows = cmpAmounts.map(m => {
            const isActive = m.method === d.paymentType;
            const delta = m.amount - cmpCurrent;
            let tag;
            if (isActive) {
                tag = '<span class="fin-cmp-badge">Actual</span>';
            } else if (Math.abs(delta) >= 0.005) {
                const c = delta > 0 ? '#b8894a' : '#4b6b3f';
                tag = `<span class="fin-cmp-delta" style="color:${c}">${delta > 0 ? '+' : '-'}${formatCurrency(Math.abs(delta), curr)}</span>`;
            } else {
                tag = '<span class="fin-cmp-delta" style="color:#8a8f78">igual</span>';
            }
            const cheap = (!isActive && m.amount === cmpCheapest && cmpCheapest < cmpCurrent)
                ? '<span class="fin-cmp-cheap">más barato</span>' : '';
            return `<div class="fin-cmp-row ${isActive ? 'active' : ''}">
                <span class="fin-cmp-method"><i class="ti ${m.icon}"></i>${m.label}${cheap}</span>
                <span class="fin-cmp-right"><span class="fin-cmp-amount">${formatCurrency(m.amount, curr)}</span>${tag}</span>
            </div>`;
        }).join('');
        // Chip de método = disparador del comparativo (collapse INLINE, no dropdown flotante).
        const methodChipHtml = '<button type="button" class="fin-hero-method" data-bs-toggle="collapse" data-bs-target="#paymentMethodComparison" aria-expanded="false" aria-controls="paymentMethodComparison" title="Comparar por método de pago">'
            + `<i class="ti ti-credit-card"></i>${PaymentBreakdownHelpers.escapeHtml(paymentTypeLabel)}<i class="ti ti-arrows-exchange fin-chev" title="Comparar métodos de pago"></i></button>`;
        // El comparativo se expande inline (empuja el contenido), no como panel flotante.
        const comparisonInlineHtml = '<div class="collapse fin-cmp-inline" id="paymentMethodComparison">'
            + `<div class="fin-cmp-cap">Total a pagar según el método de pago:</div>${comparisonRows}</div>`;
        // Hint de ahorro SIEMPRE visible: si otro método es más barato que el actual, lo anuncia sin
        // tener que abrir el comparativo (p. ej. "En efectivo ahorras $7,542").
        const cmpCheapestMethod = cmpAmounts.find(m => m.amount === cmpCheapest);
        const cmpSavings = cmpCurrent - cmpCheapest;
        const savingsHint = (cmpCheapestMethod && cmpCheapestMethod.method !== d.paymentType && cmpSavings >= 0.005)
            ? `<div class="fin-hero-hint"><i class="ti ti-discount-2"></i>En ${PaymentBreakdownHelpers.escapeHtml(cmpCheapestMethod.label.toLowerCase())} ahorras ${formatCurrency(cmpSavings, curr)}</div>`
            : '';

        let html = '';
        // ===== Hero de pago: cifras clave + barra de cobertura (solo si hay datos de pago) =====
        if (pay) {
            const heroResolved = PaymentBreakdownHelpers.resolveDisplayedBalance(pay);
            const heroPaid = Number(pay.paidAmount) || 0;
            const heroTotal = Number(pay.total) || 0;
            const heroBal = heroResolved.displayedBalance;
            const heroPct = heroTotal > 0 ? Math.min(100, Math.round((heroPaid / heroTotal) * 100)) : 0;
            const heroBarColor = '#4b6b3f'; // el llenado = lo pagado → verde (coincide con "Pagado")
            const heroSavings = heroResolved.savings
                ? `<div class="fin-savings"><i class="ti ti-discount-2 me-2"></i><strong>${PaymentBreakdownHelpers.escapeHtml(heroResolved.savings.label)}</strong><div class="small">${PaymentBreakdownHelpers.escapeHtml(heroResolved.savings.sublabel)}</div></div>`
                : '';
            html += `<div class="fin-hero">
                <div class="fin-hero-top">
                    <div>
                        <div class="fin-hero-lbl">Total a pagar ${methodChipHtml}</div>
                        <div class="fin-hero-total">${formatCurrency(heroTotal, curr)}</div>
                        ${savingsHint}
                    </div>
                    <div class="fin-hero-meta">
                        ${getPaymentStatusBadge(pay.paymentStatus)}
                        ${canEdit ? '<button class="fin-pay-btn" id="addPaymentBtn"><i class="ti ti-cash"></i>Agregar pago</button>' : ''}
                    </div>
                </div>
                ${comparisonInlineHtml}
                <div class="fin-hero-pct">${heroPct}% pagado</div>
                <div class="fin-bar"><span style="width:${heroPct}%;background:${heroBarColor}"></span></div>
                <div class="fin-hero-foot">
                    <div><span class="lbl">Pagado</span><div class="val" style="color:#4b6b3f">${formatCurrency(heroPaid, curr)}</div></div>
                    <div class="text-end"><span class="lbl">Saldo</span><div class="val" style="color:${heroBal > 0 ? '#b8894a' : '#4b6b3f'}">${formatCurrency(heroBal, curr)}</div></div>
                </div>
                ${heroSavings}
            </div>`;
        }

        // El comparativo por método ahora se despliega desde el chip de método en el hero (methodChipHtml).

        // ===== Desglose ===== (sin rótulo; los renglones ya se leen como desglose)
        // Sin datos de pago no hay hero: mostramos el chip de método (con su comparativo inline) aquí.
        if (!pay) {
            html += `<div class="fin-row"><span class="lbl"><i class="ti ti-credit-card"></i>Tipo de pago</span><span class="val">${methodChipHtml}</span></div>${comparisonInlineHtml}`;
        }
        html += `<div class="fin-row"><span class="lbl"><i class="ti ti-list-details"></i>Subtotal servicios</span><span class="val">${formatCurrency(servicesSubtotal, curr)}</span></div>`;

        // Propina cobrada (Fase 2): líneas leídas del summary del servidor para que el Subtotal + propina +
        // ajustes reconcilie con el Total a pagar. La general va en su línea; la de por-servicio se agrega
        // (los tips por servicio también aparecen por servicio en el itinerario, aquí es el agregado).
        if (generalTip > 0) {
            html += `<div class="fin-row"><span class="lbl"><i class="ti ti-coin fin-tip"></i>Propina general</span><span class="val fin-tip">+${formatCurrency(generalTip, curr)}</span></div>`;
        }
        if (serviceTipsTotal > 0) {
            html += `<div class="fin-row"><span class="lbl"><i class="ti ti-coin fin-tip"></i>Propinas por servicio</span><span class="val fin-tip">+${formatCurrency(serviceTipsTotal, curr)}</span></div>`;
        }

        // Ajustes (cargos/descuentos) al final del desglose, pegados al "+ Agregar ajuste", para que
        // al agregar uno aparezca de forma natural justo encima del disparador.
        charges.forEach(adj => {
            html += `<div class="fin-row">
                <span class="lbl"><i class="ti ti-plus fin-charge"></i>${PaymentBreakdownHelpers.escapeHtml(adj.description)}</span>
                <span class="d-flex align-items-center gap-2"><span class="val fin-charge">+${formatCurrency(adj.amount, curr)}</span>${canEdit ? `<button class="btn btn-sm btn-outline-secondary py-0 px-1 remove-adj-btn" data-adj-id="${adj.id}" title="Eliminar"><i class="ti ti-x" style="font-size:0.75rem"></i></button>` : ''}</span>
            </div>`;
        });
        discounts.forEach(adj => {
            const pctLabel = adj.percentage ? ` (${adj.percentage}%)` : '';
            html += `<div class="fin-row">
                <span class="lbl"><i class="ti ti-discount-2 fin-discount"></i>${PaymentBreakdownHelpers.escapeHtml(adj.description)}${pctLabel}</span>
                <span class="d-flex align-items-center gap-2"><span class="val fin-discount">-${formatCurrency(adj.amount, curr)}</span>${canEdit ? `<button class="btn btn-sm btn-outline-secondary py-0 px-1 remove-adj-btn" data-adj-id="${adj.id}" title="Eliminar"><i class="ti ti-x" style="font-size:0.75rem"></i></button>` : ''}</span>
            </div>`;
        });

        // El bloque de pago (estado + total + pagado + saldo + ahorro) se muestra ahora en el "hero"
        // de arriba (fin-hero). El detalle completo (chips, cobertura, desglose por método, historial y
        // registro) vive en #paymentsOffcanvas.

        body.innerHTML = html;

        // Bind remove buttons
        body.querySelectorAll('.remove-adj-btn').forEach(btn => {
            btn.addEventListener('click', () => removeAdjustment(btn.dataset.adjId));
        });
    }

    async function removeAdjustment(adjId) {
        if (!(await pmConfirm({
            title: 'Eliminar ajuste', message: '¿Eliminar este ajuste?', confirmText: 'Eliminar', danger: true,
        }))) return;
        // Loader en el botón (y en sus pares) para que se vea que algo está pasando durante el
        // borrado + recarga. loadReservation vuelve a renderizar el desglose, así que no hay que
        // restaurar el botón manualmente en el caso de éxito.
        const btn = document.querySelector(`.remove-adj-btn[data-adj-id="${adjId}"]`);
        const original = btn ? btn.innerHTML : '';
        document.querySelectorAll('.remove-adj-btn').forEach((b) => { b.disabled = true; });
        if (btn) btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:.7rem;height:.7rem;border-width:.13em;"></span>';
        try {
            const response = await fetch(`/api/reservations/${reservationId}/adjustments/${adjId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            const result = await response.json();
            if (result.success) {
                await loadReservation();
                pmToast('Ajuste eliminado', 'success');
            } else {
                pmToast(result.error || 'Error al eliminar ajuste', 'error');
                document.querySelectorAll('.remove-adj-btn').forEach((b) => { b.disabled = false; });
                if (btn) btn.innerHTML = original;
            }
        } catch (err) {
            console.error('Remove adjustment error:', err);
            pmToast('Error al eliminar ajuste', 'error');
            document.querySelectorAll('.remove-adj-btn').forEach((b) => { b.disabled = false; });
            if (btn) btn.innerHTML = original;
        }
    }

    // ===== PAYMENTS =====

    let paymentsCache = [];
    // Último summary AMPLIO de GET .../payments (coveragePercent/availableMethods/anchoredMethod/
    // montoParaSaldar). El summary ANGOSTO de getReservationById NO trae estos campos, así que el carrito
    // se puebla solo desde aquí.
    let latestSummary = null;

    function paymentsOffcanvasInstance() {
        const el = document.getElementById('paymentsOffcanvas');
        return el ? bootstrap.Offcanvas.getOrCreateInstance(el) : null;
    }

    const PAYMENT_METHOD_LABELS = { efectivo: 'Efectivo', transferencia: 'Transferencia', tarjeta: 'Tarjeta' };
    // [fondo, texto, borde] por método para el chip del historial. Misma paleta suave de marca que la
    // píldora de estado de la card de cobertura, para que el drawer se lea como una sola pieza.
    const PAYMENT_METHOD_COLORS = {
        efectivo: ['#e6efe1', '#3f5a34', '#cfe0c6'],
        transferencia: ['#eaf1f0', '#3a6b63', '#cfe1dd'],
        tarjeta: ['#f6efe2', '#96682f', '#e7d6bd'],
        _default: ['#f0eee7', '#6b6656', '#ded9cb'],
    };
    // Orden del historial. Vive fuera de renderPayments para sobrevivir a los re-render que dispara
    // cada alta/edición/borrado de pago.
    let paymentsSort = { key: 'date', dir: 'desc' };
    // Pago que se está editando. El formulario de edición se abre INLINE, en una fila expandida bajo el
    // pago tocado: el #paymentFormWrap del alta vive en el tab "Pago", así que editar desde "Historial"
    // dibujaba el formulario en un panel oculto y parecía que el botón no hacía nada.
    let editingPaymentId = null;
    // Formulario de alta abierto (el del tab "Pago"). Su par de edición es editingPaymentId.
    let addPaymentFormOpen = false;
    // El carrito solo se abre desde "Agregar pago", así que la intención al abrirlo es siempre registrar
    // uno: el formulario se despliega solo. Esta bandera se levanta al pedir la apertura y se baja
    // cuando el formulario ya se pudo dibujar (o cuando resulta que no se puede).
    let pendingAddForm = false;

    // El formulario necesita availableMethods del summary AMPLIO para poblar el select de método; si se
    // dibujara antes de que llegue, saldría con el select vacío y el guardado bloqueado, y no se volvería
    // a construir solo. Por eso se intenta en dos momentos: al terminar de abrir el panel y al llegar el
    // summary — lo que ocurra al final.
    function maybeOpenAddForm() {
        if (!pendingAddForm) return;
        const status = reservationData ? reservationData.status : null;
        const canEdit = status !== 'cancelled' && status !== 'completed';
        if (!canEdit || addPaymentFormOpen || editingPaymentId) { pendingAddForm = false; return; }
        if (!latestSummary) return; // Aún cargando: se reintenta desde applyPaymentSummary.
        pendingAddForm = false;
        renderPaymentForm(null);
    }

    // "Registrar pago" se OCULTA mientras hay un formulario abierto, en vez de quedarse abajo con su
    // aspecto de llamada a la acción: ahí parecía que otro clic agregaría un segundo formulario. Además
    // impide abrir el alta encima de una edición inline (savePayment lee los campos por id global, así
    // que un segundo formulario guardaría los valores del equivocado).
    function syncAddPaymentBtn() {
        const btn = document.getElementById('showPaymentFormBtn');
        if (!btn) return;
        const status = reservationData ? reservationData.status : null;
        const canEdit = status !== 'cancelled' && status !== 'completed';
        const formOpen = addPaymentFormOpen || !!editingPaymentId;
        btn.classList.toggle('d-none', !canEdit || formOpen);
    }

    // Cierra el formulario abierto, sea el del alta (tab "Pago") o el inline del historial. NUNCA puede
    // haber dos abiertos a la vez, por lo mismo de los ids globales.
    function closePaymentForm() {
        const wasEditing = !!editingPaymentId;
        editingPaymentId = null;
        addPaymentFormOpen = false;
        const wrap = document.getElementById('paymentFormWrap');
        if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; wrap.classList.remove('pay-form'); }
        syncAddPaymentBtn();
        // Re-render para quitar la fila expandida y reactivar los encabezados de orden.
        if (wasEditing) renderPayments();
    }

    // Las dos fechas del historial son de naturaleza distinta y por eso se leen distinto:
    //  · PAGO (paidAt): viene de un <input type="date">, se guarda como medianoche UTC y NO tiene hora
    //    útil. Se lee en UTC — en local (México, offset negativo) caería un día antes.
    //  · REGISTRO (createdAt): instante real en que se capturó el pago. Se lee en hora local.
    // Cada una trae además su propia persona: quién recibió el dinero vs. quién lo capturó.
    const PAYMENT_DATE_FIELDS = {
        date: { get: (p) => p.paidAt || p.createdAt, utc: true },
        created: { get: (p) => p.createdAt, utc: false },
    };
    const paymentMs = (p, key) => {
        const field = PAYMENT_DATE_FIELDS[key] || PAYMENT_DATE_FIELDS.date;
        const t = new Date(field.get(p) || 0).getTime();
        return Number.isNaN(t) ? 0 : t;
    };
    const monthKey = (p, key) => {
        const utc = (PAYMENT_DATE_FIELDS[key] || PAYMENT_DATE_FIELDS.date).utc;
        const dt = new Date(paymentMs(p, key));
        const year = utc ? dt.getUTCFullYear() : dt.getFullYear();
        const month = (utc ? dt.getUTCMonth() : dt.getMonth()) + 1;
        return `${year}-${String(month).padStart(2, '0')}`;
    };
    const monthLabel = (p, key) => {
        const utc = (PAYMENT_DATE_FIELDS[key] || PAYMENT_DATE_FIELDS.date).utc;
        const opts = { month: 'long', year: 'numeric' };
        if (utc) opts.timeZone = 'UTC';
        const s = new Date(paymentMs(p, key)).toLocaleDateString('es-MX', opts);
        return s.charAt(0).toUpperCase() + s.slice(1);
    };
    // Fecha + hora de registro, en hora local (ver PAYMENT_DATE_FIELDS).
    function formatDateTimeShort(dateStr) {
        const dt = new Date(dateStr);
        if (Number.isNaN(dt.getTime())) return '—';
        // Día y mes por separado para evitar el guion del locale ("10-jun" → "10 jun"), igual que
        // formatDateRange. Hora en 24h: más compacta que "02:32 p.m." y sin ambigüedad.
        const day = dt.toLocaleDateString('es-MX', { day: '2-digit' });
        const month = dt.toLocaleDateString('es-MX', { month: 'short' });
        const time = dt.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', hour12: false });
        return `${day} ${month}, ${time}`;
    }

    // Copiar al portapapeles con respaldo para contextos sin navigator.clipboard (HTTP, navegadores
    // viejos), donde la API no existe y el botón quedaría muerto sin avisar.
    async function copyToClipboard(text) {
        if (!text) return;
        try {
            if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(text);
            } else {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.setAttribute('readonly', '');
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
            }
            pmToast('Referencia copiada', 'success');
        } catch (err) {
            console.error('Error copiando al portapapeles:', err);
            pmToast('No se pudo copiar la referencia', 'warning');
        }
    }

    // Esqueleto de carga del carrito. "Agregar pago" aparece en el hero apenas carga la reservación,
    // así que el panel se puede abrir mientras GET .../payments sigue en vuelo: sin esto salía en
    // blanco y parecía que no funcionaba. Las barras imitan la forma de la card de cobertura, la tabla
    // por método y el historial para que el contenido real entre sin saltos.
    function renderPaymentsSkeleton() {
        const bar = (w, h, extra = '') => `<div class="pay-skel" style="width:${w};height:${h};${extra}"></div>`;
        const coverage = document.getElementById('paymentCoverageCard');
        if (coverage) {
            coverage.innerHTML = `<div aria-busy="true" aria-live="polite">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
                  <div style="flex:1;">
                    ${bar('190px', '12px')}
                    ${bar('220px', '32px', 'margin-top:9px;')}
                  </div>
                  ${bar('118px', '30px', 'border-radius:999px;')}
                </div>
                ${bar('96px', '11px', 'margin:14px 0 0 auto;')}
                ${bar('100%', '11px', 'border-radius:999px;margin:7px 0 18px;')}
                <div style="display:flex;justify-content:space-between;gap:12px;">
                  <div>${bar('64px', '10px')}${bar('120px', '22px', 'margin-top:7px;')}</div>
                  <div style="text-align:right;">${bar('64px', '10px', 'margin-left:auto;')}${bar('120px', '22px', 'margin:7px 0 0 auto;')}</div>
                </div>
                <div class="d-flex align-items-center gap-2 mt-3 text-muted" style="font-size:.82rem;">
                  <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>Cargando pagos…
                </div>
              </div>`;
        }
        const methodTable = document.getElementById('paymentMethodTable');
        if (methodTable) {
            const rows = [1, 2, 3].map(() => `<div style="display:flex;align-items:center;gap:12px;padding:.55rem 0;border-top:1px solid #f1efe8;">
                ${bar('120px', '13px')}<div style="flex:1;"></div>${bar('80px', '13px')}${bar('44px', '13px')}${bar('90px', '13px')}
              </div>`).join('');
            methodTable.innerHTML = `<div aria-busy="true">${bar('100%', '10px', 'margin-bottom:.35rem;')}${rows}</div>`;
            methodTable.style.display = '';
        }
        const body = document.getElementById('paymentsBody');
        if (body) {
            body.innerHTML = `<div aria-busy="true">${[1, 2, 3].map(() => `<div style="display:flex;align-items:center;gap:12px;padding:.6rem .55rem;border-bottom:1px solid #e6e6da;">
                ${bar('86px', '12px')}${bar('96px', '12px')}<div style="flex:1;"></div>${bar('70px', '12px')}
              </div>`).join('')}</div>`;
        }
    }

    // Si el GET falla no hay summary que pintar: dejar el esqueleto girando para siempre es peor que el
    // panel vacío, así que mostramos el error con reintento en la card de cobertura.
    function renderPaymentsLoadError() {
        const coverage = document.getElementById('paymentCoverageCard');
        if (coverage) {
            coverage.innerHTML = `<div class="text-center py-2">
                <div class="text-muted mb-2"><i class="ti ti-alert-triangle me-1"></i>No se pudo cargar la información de pagos.</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="retryPaymentsBtn"><i class="ti ti-refresh me-1"></i>Reintentar</button>
              </div>`;
            document.getElementById('retryPaymentsBtn')?.addEventListener('click', () => loadPayments());
        }
        const methodTable = document.getElementById('paymentMethodTable');
        if (methodTable) { methodTable.innerHTML = ''; methodTable.style.display = 'none'; }
        // El tab Historial se queda con su propio esqueleto si no lo limpiamos acá (renderPayments no
        // corre en esta rama).
        const body = document.getElementById('paymentsBody');
        if (body) body.innerHTML = '<div class="text-center py-3 text-muted">No se pudo cargar el historial de pagos.</div>';
    }

    async function loadPayments() {
        // Solo en la primera carga: las recargas posteriores a registrar/editar/borrar un pago ya tienen
        // contenido en pantalla y reemplazarlo por barras se vería como un parpadeo.
        if (!latestSummary) renderPaymentsSkeleton();
        let loaded = false;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/payments`, {
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            const result = await response.json().catch(() => null);
            loaded = response.ok && !!result?.data;
            // Keep the existing cache on a transient error instead of blanking the list.
            if (loaded) {
                paymentsCache = result.data.payments || [];
                // GET returns the fresh summary too — keep el saldo y el carrito en sync en cada recarga.
                if (result.data.summary) applyPaymentSummary(result.data.summary);
            } else {
                console.error('Error loading payments:', response.status, result);
            }
        } catch (err) {
            console.error('Error loading payments:', err);
        }
        if (!loaded && !latestSummary) { renderPaymentsLoadError(); return; }
        renderPayments();
    }

    // Rellena las secciones del offcanvas (chips / cobertura / saldo restante / descuento) desde el
    // Tabla "Por método de pago": un renglón por método con Total y Restante (reemplaza los chips con
    // barras idénticas + la sección de saldo restante). Total = subtotal por método + ajustes + propina;
    // restante = montoParaSaldar del backend.
    function buildMethodTableHtml(summary, services, curr) {
        const H = PaymentBreakdownHelpers;
        const s = summary || {};
        const methods = Array.isArray(s.availableMethods) ? s.availableMethods : [];
        if (!methods.length) return '';
        const adjustments = H.round2(s.adjustments);
        const tip = H.round2(s.tip);
        const mps = s.montoParaSaldar || {};
        const isPaid = s.paymentStatus === 'paid';
        const paid = H.round2(s.paidAmount);
        const rows = methods.map((m) => {
            const total = Math.max(0, H.round2(H.computeServicesSubtotalByType(services, m, curr) + adjustments + tip));
            return {
                method: m,
                label: H.methodLabel(m),
                total,
                // % cubierto CORRECTO por método = pagado ÷ total del método (distinto en cada método).
                pct: total > 0 ? Math.min(100, Math.round((paid / total) * 100)) : 0,
                // Monto cubierto de ESTE total. Se topa al total del método por la misma razón que el
                // porcentaje: si lo pagado supera el total de un método más barato, lo excedente es
                // saldo a favor, no cobertura de este renglón.
                covered: Math.min(paid, total),
                remaining: H.round2(mps[m]),
            };
        });
        const cheapest = H.cheapestAvailableMethod(methods, services, curr);
        const anchor = s.anchoredMethod;
        const showCheaper = cheapest && anchor && cheapest !== anchor;
        // Ahorro del método más barato vs. el cotizado (se muestra dentro del tag "Más barato",
        // reemplazando el bloque "Descuentos disponibles" que estaba aparte).
        const anchorTotal = (rows.find((r) => r.method === anchor) || {}).total || 0;
        const savingsVsAnchor = H.round2(anchorTotal - ((rows.find((r) => r.method === cheapest) || {}).total || 0));
        const thR ='text-align:right;padding:.45rem .3rem;font-size:.66rem;text-transform:uppercase;letter-spacing:.05em;color:#8a8f78;font-weight:700;';
        const body = rows.map((r) => {
            const cheap = (showCheaper && r.method === cheapest)
                ? `<span class="badge ms-2" style="background:#146c43;color:#fff;font-size:.74rem;padding:.32em .6em;">Más barato · ahorra ${formatCurrency(savingsVsAnchor, curr)}</span>` : '';
            const remainingCell = isPaid
                ? '<span style="color:#4b6b3f;font-weight:700;">Pagado</span>'
                : `<span style="font-weight:700;color:#2b2b2b;">${formatCurrency(r.remaining, curr)}</span>`;
            return `<tr style="border-top:1px solid #f1efe8;">
                <td style="padding:.55rem .3rem;font-weight:600;">${H.escapeHtml(r.label)}${cheap}</td>
                <td style="padding:.55rem .3rem;text-align:right;color:#6b6656;">${formatCurrency(r.total, curr)}</td>
                <td style="padding:.55rem .3rem;text-align:right;">
                    <div style="font-weight:700;color:#4b6b3f;">${formatCurrency(r.covered, curr)}</div>
                    <div style="font-size:.76rem;font-weight:600;color:#8a8f78;">${r.pct}%</div>
                </td>
                <td style="padding:.55rem .3rem;text-align:right;">${remainingCell}</td>
            </tr>`;
        }).join('');
        return `<table style="width:100%;border-collapse:collapse;">
            <thead><tr>
              <th style="text-align:left;padding:.45rem .3rem;font-size:.66rem;text-transform:uppercase;letter-spacing:.05em;color:#8a8f78;font-weight:700;">Método</th>
              <th style="${thR}">Total</th>
              <th style="${thR}">Cubierto</th>
              <th style="${thR}">Restante</th>
            </tr></thead>
            <tbody>${body}</tbody>
          </table>`;
    }

    // summary AMPLIO. Los % de cada chip y la barra usan coveragePercent/remainingPercent del backend TAL
    // CUAL (no re-derivar en cliente: rompería con ajustes manuales).
    // "En efectivo ahorras $X" bajo el total: el mismo hint del hero del Resumen Financiero, para que
    // el ahorro se vea al registrar el pago y no solo al bajar a la tabla por método. Devuelve '' si no
    // hay un método más barato que el cotizado.
    function cheapestSavingsHint(summary, services, curr) {
        const H = PaymentBreakdownHelpers;
        const s = summary || {};
        const methods = Array.isArray(s.availableMethods) ? s.availableMethods : [];
        const anchor = s.anchoredMethod;
        const cheapest = H.cheapestAvailableMethod(methods, services, curr);
        if (!cheapest || !anchor || cheapest === anchor) return '';
        // Mismos totales por método que la tabla de abajo (subtotal del método + ajustes + propina),
        // así el ahorro anunciado aquí y el del tag "Más barato" no pueden discrepar.
        const extras = H.round2(s.adjustments) + H.round2(s.tip);
        const totalFor = (m) => Math.max(0, H.round2(H.computeServicesSubtotalByType(services, m, curr) + extras));
        const savings = H.round2(totalFor(anchor) - totalFor(cheapest));
        if (savings < 0.005) return '';
        return `<div class="pay-savings-hint"><i class="ti ti-discount-2"></i>En ${H.escapeHtml(H.methodLabel(cheapest).toLowerCase())} ahorras ${formatCurrency(savings, curr)}</div>`;
    }

    function renderPaymentsOffcanvas() {
        if (!latestSummary) return;
        const services = reservationData?.services || [];
        const curr = reservationData?.currency || 'MXN';
        const coverage = document.getElementById('paymentCoverageCard');
        const methodTable = document.getElementById('paymentMethodTable');
        if (coverage) {
            const hint = cheapestSavingsHint(latestSummary, services, curr);
            coverage.innerHTML = PaymentBreakdownHelpers.buildCoverageCard(latestSummary, curr, hint);
        }
        // "Por método de pago" simplificado: un renglón por método con Total + Cubierto + Restante, y el
        // ahorro del más barato dentro del tag "Más barato" (reemplaza el bloque "Descuentos disponibles").
        if (methodTable) {
            const html = buildMethodTableHtml(latestSummary, services, curr);
            methodTable.innerHTML = html;
            methodTable.style.display = html ? '' : 'none';
        }
    }

    function renderPayments() {
        const body = document.getElementById('paymentsBody');
        if (!body) return;

        const d = reservationData;
        const canEdit = d.status !== 'cancelled' && d.status !== 'completed';
        const curr = d.currency || 'MXN';

        // "Agregar pago" (header) ya se habilita en renderFinancialSummary, justo tras loadReservation.
        // "Registrar pago" (dentro del carrito) depende además de que no haya un formulario abierto.
        syncAddPaymentBtn();
        // Contador de pagos en el tab "Historial".
        const histCount = document.getElementById('historialCount');
        if (histCount) histCount.textContent = paymentsCache.length ? String(paymentsCache.length) : '';

        if (!paymentsCache.length) {
            body.innerHTML = `<div class="text-center py-4">
                <i class="ti ti-receipt-off" style="font-size:2rem;color:#c9cdbb;"></i>
                <div class="mt-2 fw-semibold" style="color:#6b6656;">Sin pagos registrados</div>
                <div class="small text-muted">Los pagos que registres aparecerán aquí.</div>
            </div>`;
            return;
        }

        // El backend entrega los pagos ascendentes por paidAt; el historial los muestra por defecto del
        // más reciente al más viejo (lo último es lo que se viene a revisar).
        const isDateSort = paymentsSort.key === 'date' || paymentsSort.key === 'created';
        const sorted = paymentsCache.slice().sort((a, b) => {
            const dir = paymentsSort.dir === 'asc' ? 1 : -1;
            if (paymentsSort.key === 'amount') {
                const diff = (a.amount || 0) - (b.amount || 0);
                if (diff) return diff * dir;
            } else {
                const diff = paymentMs(a, paymentsSort.key) - paymentMs(b, paymentsSort.key);
                if (diff) return diff * dir;
            }
            // Desempate estable (dos pagos del mismo día, o dos del mismo monto): el orden de captura.
            return (paymentMs(a, 'created') - paymentMs(b, 'created')) * dir;
        });

        // Agrupar por mes solo tiene sentido con un orden cronológico —y por el mes de LA fecha que se
        // está ordenando—, y solo aporta cuando hay varios pagos repartidos en más de un mes.
        const months = new Set(sorted.map((p) => monthKey(p, paymentsSort.key)));
        const grouped = isDateSort && sorted.length > 4 && months.size > 1;

        let lastMonth = null;
        const rows = sorted.map((p) => {
            let groupRow = '';
            if (grouped && monthKey(p, paymentsSort.key) !== lastMonth) {
                lastMonth = monthKey(p, paymentsSort.key);
                const inMonth = sorted.filter((q) => monthKey(q, paymentsSort.key) === lastMonth);
                const monthSum = inMonth.reduce((acc, q) => acc + (q.amount || 0), 0);
                groupRow = `<tr class="pay-hist-group"><td colspan="6">${PaymentBreakdownHelpers.escapeHtml(monthLabel(p, paymentsSort.key))}
                    <span class="pay-hist-group-sum">${inMonth.length} ${inMonth.length === 1 ? 'pago' : 'pagos'} · ${formatCurrency(monthSum, curr)}</span></td></tr>`;
            }
            const refLine = p.reference
                ? `<span class="pay-hist-ref">${PaymentBreakdownHelpers.escapeHtml(p.reference)}</span>
                   <button type="button" class="pay-hist-act copy-ref-btn" data-ref="${PaymentBreakdownHelpers.escapeHtml(p.reference)}" title="Copiar referencia" aria-label="Copiar referencia" style="width:24px;height:24px;font-size:.85rem;vertical-align:middle;"><i class="ti ti-copy"></i></button>`
                : '<span class="text-muted">—</span>';
            // Columna PAGO: cuándo se pagó y quién recibió el dinero. "Recibió" solo aplica al efectivo
            // (en transferencia/tarjeta no hay una persona que lo tome en mano).
            const receivedLine = (p.method === 'efectivo' && p.receivedBy)
                ? `<div class="pay-hist-person" title="Recibió el dinero"><i class="ti ti-user"></i>${PaymentBreakdownHelpers.escapeHtml(p.receivedBy)}</div>` : '';
            // Columna REGISTRO: cuándo se capturó en el sistema y quién lo capturó. Es el par de la
            // columna de pago, no lo mismo: un pago del día 10 puede capturarse el 28 por otra persona.
            const registeredLine = p.registeredByName
                ? `<div class="pay-hist-person" title="Registró el pago"><i class="ti ti-user"></i>${PaymentBreakdownHelpers.escapeHtml(p.registeredByName)}</div>` : '';
            const registeredAt = p.createdAt ? formatDateTimeShort(p.createdAt) : '<span class="text-muted">—</span>';
            // El comprobante es una acción más (abrir el archivo), así que vive junto a editar/eliminar.
            const receipt = p.receiptUrl
                ? `<a href="${PaymentBreakdownHelpers.escapeHtml(p.receiptUrl)}" target="_blank" rel="noopener" class="pay-hist-act is-receipt" title="Ver comprobante" aria-label="Ver comprobante"><i class="ti ti-file-invoice"></i></a>`
                : '';
            const [mBg, mFg, mBd] = PAYMENT_METHOD_COLORS[p.method] || PAYMENT_METHOD_COLORS._default;
            // Moneda distinta a la de la reservación: el monto listado está en la moneda de la reserva,
            // así que el original se muestra aparte en ámbar en vez de dejar solo un código ambiguo.
            const isForeign = !!p.origCurrency && p.origCurrency !== curr;
            const origLine = (isForeign && p.origAmount)
                ? `<div class="pay-hist-orig">Original ${formatCurrency(p.origAmount, p.origCurrency)}${p.exchangeRate ? ` · TC ${p.exchangeRate}` : ''}</div>` : '';
            // Fila expandida con el formulario de edición, justo bajo el pago tocado. El contenido lo
            // dibuja renderPaymentForm después de montar la tabla (necesita el nodo ya en el DOM).
            const editRow = p.id === editingPaymentId
                ? `<tr class="pay-hist-edit"><td colspan="6"><div class="pay-hist-form" id="paymentEditWrap"></div></td></tr>` : '';
            return `${groupRow}<tr${p.id === editingPaymentId ? ' class="is-editing"' : ''}>
                <td class="pay-hist-date" data-label="Pago">${formatDate(p.paidAt || p.createdAt)}${receivedLine}</td>
                <td data-label="Método"><span class="pay-hist-method" style="background:${mBg};color:${mFg};border-color:${mBd};">${PaymentBreakdownHelpers.escapeHtml(PAYMENT_METHOD_LABELS[p.method] || p.method || '—')}</span></td>
                <td data-label="Referencia">${refLine}</td>
                <td class="pay-hist-meta" data-label="Registro"><div class="pay-hist-stack">${registeredAt}${registeredLine}</div></td>
                <td class="pay-hist-amount" data-label="Monto">${formatCurrency(p.amount, curr)}<span class="pay-hist-curr${isForeign ? ' is-foreign' : ''}">${PaymentBreakdownHelpers.escapeHtml(p.origCurrency || curr)}</span>${origLine}</td>
                <td class="pay-hist-actions" data-label="Acciones">
                    ${receipt}
                    ${canEdit ? `<button type="button" class="pay-hist-act edit-payment-btn" data-payment-id="${p.id}" title="Editar" aria-label="Editar pago"><i class="ti ti-edit"></i></button>
                    <button type="button" class="pay-hist-act is-danger delete-payment-btn" data-payment-id="${p.id}" title="Eliminar" aria-label="Eliminar pago"><i class="ti ti-trash"></i></button>` : ''}
                </td>
            </tr>${editRow}`;
        }).join('');

        // Total de lo listado: ancla el historial contra el "Pagado" de la card de cobertura y delata
        // capturas duplicadas.
        const total = paymentsCache.reduce((acc, p) => acc + (p.amount || 0), 0);
        const arrow = paymentsSort.dir === 'asc' ? 'ti-arrow-up' : 'ti-arrow-down';
        // Reordenar re-monta la tabla, y con ella el formulario inline: se deshabilita mientras hay una
        // edición abierta para no borrar lo que el usuario está escribiendo.
        const sortTh = (key, label, align) => `<th style="text-align:${align};">
            <button type="button" class="pay-hist-sort${paymentsSort.key === key ? ' is-active' : ''}" data-sort-key="${key}"
                ${editingPaymentId ? 'disabled title="Termina de editar el pago para reordenar"' : ''}
                aria-label="Ordenar por ${label.toLowerCase()}">${label} <i class="ti ${paymentsSort.key === key ? arrow : 'ti-arrows-sort'}"></i></button>
        </th>`;

        body.innerHTML = `<table class="pay-hist">
                <thead>
                    <tr>
                        ${sortTh('date', 'Pago', 'left')}
                        <th>Método</th>
                        <th>Referencia</th>
                        ${sortTh('created', 'Registro', 'left')}
                        ${sortTh('amount', 'Monto', 'right')}
                        <th style="text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="pay-hist-foot-label">Total registrado · ${paymentsCache.length} ${paymentsCache.length === 1 ? 'pago' : 'pagos'}</td>
                        <td class="pay-hist-amount" data-label="Total">${formatCurrency(total, curr)}</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>`;

        body.querySelectorAll('.pay-hist-sort').forEach((btn) => {
            btn.addEventListener('click', () => {
                const key = btn.dataset.sortKey;
                // Volver a la misma columna invierte el sentido; cambiar de columna arranca descendente
                // (lo más nuevo / lo más grande primero, que es lo que se busca en ambos casos).
                if (paymentsSort.key === key) paymentsSort.dir = paymentsSort.dir === 'asc' ? 'desc' : 'asc';
                else paymentsSort = { key, dir: 'desc' };
                renderPayments();
            });
        });
        body.querySelectorAll('.copy-ref-btn').forEach((btn) => {
            btn.addEventListener('click', () => copyToClipboard(btn.dataset.ref || ''));
        });
        body.querySelectorAll('.edit-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.paymentId;
                // Cerrar primero descarta el otro formulario (alta u otra fila) antes de abrir este.
                closePaymentForm();
                editingPaymentId = id;
                renderPayments();
            });
        });
        body.querySelectorAll('.delete-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => deletePayment(btn.dataset.paymentId));
        });

        // El formulario inline se dibuja al final, cuando su contenedor ya está en el DOM. Si el pago
        // en edición desapareció (lo borró otra pestaña), el estado se limpia solo.
        if (editingPaymentId) {
            const editWrap = document.getElementById('paymentEditWrap');
            if (editWrap) renderPaymentForm(editingPaymentId, editWrap);
            else editingPaymentId = null;
        }
    }

    // Read a File as base64 (strip the "data:...;base64," prefix) for the JSON receipt upload.
    function fileToBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result).split(',')[1] || '');
            reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
            reader.readAsDataURL(file);
        });
    }

    // Upload a payment receipt in a SEPARATE request (decoupled from the save). The payment is
    // already persisted, so this never risks it: returns null on success, or a warning string if
    // the comprobante couldn't be uploaded (the user can retry by editing the payment).
    async function uploadReceipt(paymentId, file) {
        try {
            const body = JSON.stringify({
                fileBase64: await fileToBase64(file), fileName: file.name, mimeType: file.type,
            });
            const resp = await fetch(`/api/reservations/${reservationId}/payments/${paymentId}/receipt`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${authToken()}`, 'Content-Type': 'application/json' },
                body,
            });
            const r = await resp.json().catch(() => ({}));
            if (resp.ok && r.success) return null;
            return r.error
                ? `Pago guardado, pero el comprobante no se subió: ${r.error}`
                : 'Pago guardado, pero el comprobante no se subió. Reinténtalo editando el pago.';
        } catch (err) {
            console.error('Receipt upload error:', err);
            return 'Pago guardado, pero el comprobante no se subió (se cortó la conexión). Reinténtalo editando el pago.';
        }
    }

    // Inline payment form (relocated into #paymentsOffcanvas). null = nuevo, id = editar el pago.
    // targetWrap permite dibujar el mismo formulario en dos sitios: el contenedor fijo del tab "Pago"
    // (alta) o la fila expandida del historial (edición). Todo lo demás es idéntico.
    function renderPaymentForm(paymentId, targetWrap) {
        const wrap = targetWrap || document.getElementById('paymentFormWrap');
        if (!wrap) return;
        // Alta = sin id y en el contenedor fijo del tab "Pago". Marca el estado para que el botón que lo
        // abrió ceda su lugar al formulario.
        if (!paymentId && !targetWrap) addPaymentFormOpen = true;
        syncAddPaymentBtn();
        const existing = paymentId ? paymentsCache.find((p) => p.id === paymentId) : null;
        const curr = existing?.origCurrency || 'MXN';
        const paidAt = existing?.paidAt ? new Date(existing.paidAt).toISOString().slice(0, 10) : '';
        // Payment date allows the future (reservations later); shared standard 1900 .. today + 20y.
        const paidAtMax = (() => { const dt = new Date(); dt.setFullYear(dt.getFullYear() + 20); return dt.toISOString().slice(0, 10); })();
        const opt = (v, label, sel) => `<option value="${v}" ${sel === v ? 'selected' : ''}>${label}</option>`;
        const receiptLink = existing?.receiptUrl
            ? `<a href="${existing.receiptUrl}" target="_blank" rel="noopener" class="pay-receipt-chip"><i class="ti ti-file-invoice"></i>Ver comprobante actual</a>` : '';

        // Método: poblado dinámicamente desde availableMethods (Fase C), NUNCA hardcodeado a 3 opciones.
        // Al editar, se conserva el método guardado aunque ya no esté disponible (no cambiarlo en silencio).
        // Sin métodos disponibles (H3): select deshabilitado con mensaje y guardado bloqueado.
        const available = (latestSummary && Array.isArray(latestSummary.availableMethods)) ? latestSummary.availableMethods.slice() : [];
        const method = existing?.method || available[0] || '';
        const methodOrder = available.slice();
        if (existing?.method && !methodOrder.includes(existing.method)) methodOrder.push(existing.method);
        const methodDisabled = methodOrder.length === 0;
        const methodSelectHtml = methodDisabled
            ? `<select class="form-select form-select-sm" id="paymentMethod" disabled><option value="">Sin métodos disponibles</option></select>
               <div class="form-text text-danger">No hay métodos de pago disponibles para esta reservación.</div>`
            : `<select class="form-select form-select-sm" id="paymentMethod">${methodOrder.map((m) => opt(m, PAYMENT_METHOD_LABELS[m] || m, method)).join('')}</select>`;

        const amountInit = existing ? (existing.origAmount ?? existing.amount ?? '') : '';

        // Sin encabezado propio: la fila resaltada de arriba ya dice QUÉ pago se está editando y el
        // formulario cuelga pegado a ella, así que un título + separador solo restaba alto útil. El dato
        // se conserva como etiqueta en el pie, que tenía todo el lado izquierdo vacío.
        const contextLabel = existing
            ? `Editando el pago del ${formatDate(existing.paidAt || existing.createdAt)}`
            : 'Nuevo pago';
        wrap.classList.add('pay-form');
        wrap.innerHTML = `
            <input type="hidden" id="paymentId" value="${existing ? existing.id : ''}">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentAmount">Monto</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" id="paymentAmountPrefix">${curr === 'USD' ? 'USD $' : '$'}</span>
                        <input type="text" inputmode="decimal" maxlength="17" class="form-control form-control-sm" id="paymentAmount" placeholder="0.00" value="${amountInit}">
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentCurrency">Moneda</label>
                    <select class="form-select form-select-sm" id="paymentCurrency">${opt('MXN', 'MXN', curr)}${opt('USD', 'USD', curr)}</select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentMethod">Método</label>
                    ${methodSelectHtml}
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentPaidAt">Fecha de pago</label>
                    <input type="date" class="form-control form-control-sm" id="paymentPaidAt" min="1900-01-01" max="${paidAtMax}" value="${paidAt}" required>
                </div>
                <div class="${method === 'efectivo' ? 'col-md-4' : 'col-md-8'}" id="paymentReferenceWrap">
                    <label class="form-label fw-semibold small" for="paymentReference">Referencia</label>
                    <input type="text" class="form-control form-control-sm" id="paymentReference" maxlength="100" placeholder="Folio / autorización" value="${PaymentBreakdownHelpers.escapeHtml(existing?.reference || '')}">
                </div>
                <div class="col-md-4" id="paymentReceivedByWrap" style="display:${method === 'efectivo' ? '' : 'none'};">
                    <label class="form-label fw-semibold small" for="paymentReceivedBy">¿Quién recibió el efectivo?</label>
                    <input type="text" class="form-control form-control-sm" id="paymentReceivedBy" maxlength="100" placeholder="Nombre de quien recibió" value="${PaymentBreakdownHelpers.escapeHtml(existing?.receivedBy || '')}" ${method === 'efectivo' ? 'required' : ''}>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold small" for="paymentReceipt">Comprobante (imagen o PDF)</label>
                    <div class="pay-drop" id="paymentReceiptDrop">
                        <input type="file" id="paymentReceipt" accept="image/*,application/pdf">
                        <div class="pay-file-row">
                            <label class="pay-file-btn" for="paymentReceipt"><i class="ti ti-paperclip"></i>Adjuntar</label>
                            <button type="button" class="pay-file-clear d-none" id="paymentReceiptClear" title="Quitar archivo" aria-label="Quitar archivo"><i class="ti ti-x"></i></button>
                        </div>
                        <span class="pay-file-name" id="paymentReceiptName">o arrastra el archivo aquí</span>
                        ${receiptLink}
                    </div>
                </div>
                <div class="col-md-7">
                    <label class="form-label fw-semibold small" for="paymentNotes">Notas</label>
                    <textarea class="form-control form-control-sm" id="paymentNotes" rows="2" maxlength="300" placeholder="Notas del pago">${PaymentBreakdownHelpers.escapeHtml(existing?.notes || '')}</textarea>
                </div>
            </div>
            <div class="pay-form-actions">
                <span class="pay-form-context">${existing ? '<i class="ti ti-edit"></i>' : '<i class="ti ti-cash"></i>'}${PaymentBreakdownHelpers.escapeHtml(contextLabel)}</span>
                <button type="button" class="btn btn-outline-secondary" id="cancelPaymentBtn">Cancelar</button>
                <button type="button" class="btn btn-primary" id="savePaymentBtn"><i class="ti ti-check me-1"></i>Guardar</button>
            </div>`;
        // El formulario vive dentro del offcanvas (posición fija con scroll propio): se muestra en su
        // sitio y se desplaza a la vista dentro del panel, sin scrollIntoView de página ni borde inline.
        wrap.style.display = '';
        wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const saveBtn = document.getElementById('savePaymentBtn');
        // Sin métodos disponibles (H3): no se puede registrar/editar el pago — bloquea el guardado.
        if (methodDisabled && saveBtn) saveBtn.disabled = true;
        document.getElementById('cancelPaymentBtn').addEventListener('click', () => closePaymentForm());
        saveBtn.addEventListener('click', () => savePayment(existing ? existing.id : ''));
        attachThousands(document.getElementById('paymentAmount'));

        // "¿Quién recibió el efectivo?" es visible + required SOLO cuando el método es efectivo, y
        // reacciona en vivo si el usuario cambia el método DESPUÉS de abrir el formulario.
        const methodSel = document.getElementById('paymentMethod');
        function syncReceivedByVisibility() {
            const isCash = methodSel && methodSel.value === 'efectivo';
            const wrapEl = document.getElementById('paymentReceivedByWrap');
            const inputEl = document.getElementById('paymentReceivedBy');
            if (wrapEl) wrapEl.style.display = isCash ? '' : 'none';
            if (inputEl) inputEl.required = !!isCash;
            // Referencia absorbe el ancho de "¿Quién recibió?" cuando está oculto, para que el renglón
            // siempre cierre las 12 columnas y no quede el hueco a la derecha.
            const refWrap = document.getElementById('paymentReferenceWrap');
            if (refWrap) {
                refWrap.classList.toggle('col-md-4', !!isCash);
                refWrap.classList.toggle('col-md-8', !isCash);
            }
        }
        if (methodSel) methodSel.addEventListener('change', syncReceivedByVisibility);
        syncReceivedByVisibility();

        // Zona de comprobante: el input nativo está oculto, así que el nombre del archivo elegido y el
        // botón para quitarlo son la única señal de qué se adjuntó.
        const receiptInput = document.getElementById('paymentReceipt');
        const receiptName = document.getElementById('paymentReceiptName');
        const receiptClear = document.getElementById('paymentReceiptClear');
        const receiptDrop = document.getElementById('paymentReceiptDrop');
        function syncReceiptName() {
            if (!receiptInput || !receiptName) return;
            const picked = receiptInput.files && receiptInput.files[0];
            receiptName.textContent = picked ? picked.name : 'o arrastra el archivo aquí';
            receiptName.title = picked ? picked.name : '';
            receiptName.classList.toggle('has-file', !!picked);
            if (receiptClear) receiptClear.classList.toggle('d-none', !picked);
        }
        if (receiptInput) receiptInput.addEventListener('change', syncReceiptName);
        if (receiptClear && receiptInput) {
            receiptClear.addEventListener('click', () => { receiptInput.value = ''; syncReceiptName(); });
        }
        // Arrastrar y soltar sobre la zona. Se asigna vía DataTransfer porque input.files es de solo
        // lectura salvo con una FileList real.
        if (receiptDrop && receiptInput) {
            ['dragenter', 'dragover'].forEach((ev) => receiptDrop.addEventListener(ev, (e) => {
                e.preventDefault();
                receiptDrop.classList.add('is-dragover');
            }));
            // relatedTarget dentro de la zona = solo se pasó sobre un hijo, no es una salida real.
            receiptDrop.addEventListener('dragleave', (e) => {
                if (!receiptDrop.contains(e.relatedTarget)) receiptDrop.classList.remove('is-dragover');
            });
            receiptDrop.addEventListener('drop', (e) => {
                e.preventDefault();
                receiptDrop.classList.remove('is-dragover');
                const dropped = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
                if (!dropped) return;
                const dt = new DataTransfer();
                dt.items.add(dropped);
                receiptInput.files = dt.files;
                syncReceiptName();
            });
        }

        // El prefijo del monto sigue a la moneda elegida, para que no quede "$" sobre un importe en USD.
        const currencySel = document.getElementById('paymentCurrency');
        const amountPrefix = document.getElementById('paymentAmountPrefix');
        if (currencySel && amountPrefix) {
            currencySel.addEventListener('change', () => {
                amountPrefix.textContent = currencySel.value === 'USD' ? 'USD $' : '$';
            });
        }
    }

    // Refresh the Financial Summary numbers + el carrito desde un summary de respuesta (POST/PUT/DELETE)
    // o de GET, sin recargar la página. Guarda el summary AMPLIO para poblar el offcanvas.
    function applyPaymentSummary(summary) {
        if (!summary) return;
        latestSummary = summary;
        if (reservationData.payment) Object.assign(reservationData.payment, summary);
        else reservationData.payment = { ...summary };
        renderFinancialSummary();
        renderPaymentsOffcanvas();
        // Si el panel se abrió antes de que llegara el summary, este es el momento de desplegar el alta.
        maybeOpenAddForm();
    }

    // "Agregar pago" (header): abre el carrito. El formulario queda colapsado detrás de
    // "Registrar pago" dentro del panel (menos amontonado al abrir).
    // "Agregar pago" vive dentro del hero (re-renderizado por renderFinancialSummary), así que se
    // cablea por delegación sobre el contenedor estable del Resumen Financiero.
    document.getElementById('financialSummaryCard')?.addEventListener('click', (e) => {
        if (e.target.closest('#addPaymentBtn')) {
            pendingAddForm = true;
            paymentsOffcanvasInstance()?.show();
        }
    });
    // Al terminar la animación de apertura: si el summary ya está, el formulario se despliega solo.
    document.getElementById('paymentsOffcanvas')?.addEventListener('shown.bs.offcanvas', () => maybeOpenAddForm());
    // El hint "En efectivo ahorras…" solo tiene sentido colapsado (al expandir se duplica con la fila
    // del comparativo), así que se oculta mientras el comparativo está abierto. Eventos de Bootstrap
    // Collapse (burbujean) delegados en el contenedor estable, para sobrevivir al re-render del hero.
    const toggleSavingsHint = (show) => {
        const hint = document.querySelector('.fin-hero-hint');
        if (hint) hint.style.display = show ? '' : 'none';
    };
    document.getElementById('financialSummaryCard')?.addEventListener('show.bs.collapse', (e) => {
        if (e.target.id === 'paymentMethodComparison') toggleSavingsHint(false);
    });
    document.getElementById('financialSummaryCard')?.addEventListener('hide.bs.collapse', (e) => {
        if (e.target.id === 'paymentMethodComparison') toggleSavingsHint(true);
    });
    // "Registrar pago" (dentro del carrito): muestra el formulario de nuevo pago sin reabrir el panel.
    // Cierra antes cualquier edición inline abierta en el historial (un solo formulario a la vez).
    document.getElementById('showPaymentFormBtn')?.addEventListener('click', () => {
        closePaymentForm();
        renderPaymentForm(null);
    });
    // Cerrar el carrito (backdrop-click / Escape / botón) descarta el formulario en silencio (H5).
    document.getElementById('paymentsOffcanvas')?.addEventListener('hidden.bs.offcanvas', () => {
        // Cerrar con el summary aún en vuelo dejaría la bandera levantada y el formulario se abriría solo
        // la próxima vez, sin que nadie lo pidiera.
        pendingAddForm = false;
        closePaymentForm();
    });

    async function savePayment(paymentId) {
        const amount = parseAmount(document.getElementById('paymentAmount').value);
        const paidAt = document.getElementById('paymentPaidAt').value;
        const method = document.getElementById('paymentMethod').value;
        const receivedByEl = document.getElementById('paymentReceivedBy');
        const receivedBy = receivedByEl ? receivedByEl.value.trim() : '';

        if (!amount || amount <= 0) { pmToast('El monto debe ser mayor a 0', 'warning'); return; }
        if (amount > 100000000) { pmToast('El monto no puede exceder 100,000,000', 'warning'); return; }
        if (!paidAt) { pmToast('La fecha de pago es obligatoria', 'warning'); return; }
        if (method === 'efectivo' && !receivedBy) { pmToast('Indica quién recibió el efectivo', 'warning'); return; }

        const payload = {
            amount,
            currency: document.getElementById('paymentCurrency').value,
            method,
            reference: document.getElementById('paymentReference').value.trim(),
            notes: document.getElementById('paymentNotes').value.trim(),
        };
        if (paidAt) payload.paidAt = paidAt;
        if (receivedBy) payload.receivedBy = receivedBy;

        // Receipt (optional) — validated here but uploaded in a SEPARATE request AFTER the payment is
        // saved (see uploadReceipt). The receipt no longer travels inside the payment save, so a slow
        // S3 upload can never block or lose the payment itself.
        const fileInput = document.getElementById('paymentReceipt');
        const file = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
        if (file) {
            if (file.size > 10 * 1024 * 1024) { pmToast('El comprobante supera el límite de 10MB', 'warning'); return; }
            if (!/^image\//.test(file.type) && file.type !== 'application/pdf') { pmToast('El comprobante debe ser imagen o PDF', 'warning'); return; }
        }

        const isEdit = !!paymentId;
        const url = isEdit
            ? `/api/reservations/${reservationId}/payments/${paymentId}`
            : `/api/reservations/${reservationId}/payments`;
        const httpMethod = isEdit ? 'PUT' : 'POST';
        // Snapshot the current payment count so a LOST response can be reconciled afterwards:
        // the request usually reaches the server and saves even when the reply never comes back.
        const prevCount = paymentsCache.length;

        const btn = document.getElementById('savePaymentBtn');
        if (btn) btn.disabled = true;
        try {
            const response = await fetch(url, {
                method: httpMethod,
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });
            // Read the raw body first so a non-JSON response (e.g. an HTML error page) surfaces a
            // clear message instead of the generic "Error al guardar el pago".
            const rawBody = await response.text();
            let result;
            try {
                result = JSON.parse(rawBody);
            } catch (parseErr) {
                pmToast(`Error del servidor (HTTP ${response.status})`, 'error');
                if (btn) btn.disabled = false;
                return;
            }
            if (result.success) {
                const savedId = result.data?.payment?.id || paymentId;
                // Upload the receipt in its own request now that the payment is safely saved. If it
                // fails, the payment stays — we just warn so the user can retry the comprobante.
                let receiptWarn = result.warning || null;
                if (file && savedId) receiptWarn = await uploadReceipt(savedId, file);
                closePaymentForm();
                applyPaymentSummary(result.data?.summary);
                await loadPayments();
                if (receiptWarn) pmToast(receiptWarn, 'warning');
                else pmToast('Pago guardado', 'success');
            } else {
                // Build a clear message from the real reason (status + server detail/code).
                let msg = result.error || 'No se pudo guardar el pago';
                if (result.detail) msg += ` — ${result.detail}`;
                if (response.status === 401) {
                    msg = `Sesión/token inválido (${result.detail || result.code || '401'}). Recarga la página (Ctrl+Shift+R) e intenta de nuevo.`;
                }
                pmToast(msg, 'error');
                if (btn) btn.disabled = false;
            }
        } catch (err) {
            // Network error (e.g. "Failed to fetch"): the request commonly reaches the server and
            // saves even though the response is lost in transit (connection dropped). Instead of a
            // false failure, reconcile from the server — the same thing a manual Ctrl+R would show.
            console.error('Save payment network error, reconciling from server:', err);
            await loadPayments(); // refreshes paymentsCache + saldo
            let saved = !isEdit && paymentsCache.length > prevCount;
            if (!saved && !isEdit) {
                // The save may still be finishing — give it one more reload before giving up.
                await new Promise((resolve) => setTimeout(resolve, 700));
                await loadPayments();
                saved = paymentsCache.length > prevCount;
            }
            if (saved) {
                closePaymentForm();
                pmToast('Pago guardado (se recuperó tras un corte de conexión)', 'success');
            } else if (isEdit) {
                closePaymentForm();
                pmToast('La respuesta se perdió, pero la lista ya se actualizó — verifica que el pago sea correcto.', 'warning');
            } else {
                pmToast('No se pudo confirmar el guardado. Revisa la lista; si el pago no aparece, regístralo otra vez.', 'warning');
                if (btn) btn.disabled = false;
            }
        }
    }

    // ---- Styled confirm + toasts (replace the native confirm/alert in the payments card) ----
    const pmEsc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    function pmConfirm({ title = 'Confirmar', message = '', confirmText = 'Aceptar', danger = false } = {}) {
        return new Promise((resolve) => {
            let el = document.getElementById('pmConfirmModal');
            if (!el) {
                document.body.insertAdjacentHTML('beforeend', `
                    <div class="modal fade" id="pmConfirmModal" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg" style="border-radius:0.85rem;overflow:hidden">
                          <div class="modal-body text-center px-4 pt-4 pb-2">
                            <div data-pm-icon class="d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;border-radius:50%"></div>
                            <h5 class="fw-bold mb-2" data-pm-title></h5>
                            <p class="text-muted mb-0" data-pm-msg></p>
                          </div>
                          <div class="modal-footer border-0 justify-content-center pt-1 pb-4 gap-2">
                            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn px-4" data-pm-ok></button>
                          </div>
                        </div>
                      </div>
                    </div>`);
                el = document.getElementById('pmConfirmModal');
            }
            el.querySelector('[data-pm-title]').textContent = title;
            el.querySelector('[data-pm-msg]').textContent = message;
            const icon = el.querySelector('[data-pm-icon]');
            icon.classList.remove('bg-danger-subtle', 'text-danger', 'bg-primary-subtle', 'text-primary');
            icon.classList.add(danger ? 'bg-danger-subtle' : 'bg-primary-subtle', danger ? 'text-danger' : 'text-primary');
            icon.innerHTML = `<i class="ti ${danger ? 'ti-alert-triangle' : 'ti-help-circle'}" style="font-size:1.75rem"></i>`;
            const old = el.querySelector('[data-pm-ok]');
            const ok = old.cloneNode(true);
            ok.textContent = confirmText;
            ok.className = `btn px-4 ${danger ? 'btn-danger' : 'btn-primary'}`;
            old.replaceWith(ok);
            const modal = bootstrap.Modal.getOrCreateInstance(el);
            let confirmed = false;
            ok.addEventListener('click', () => { confirmed = true; modal.hide(); });
            el.addEventListener('hidden.bs.modal', () => resolve(confirmed), { once: true });
            modal.show();
        });
    }

    function pmToast(message, type = 'info') {
        let c = document.getElementById('pmToastContainer');
        if (!c) {
            document.body.insertAdjacentHTML('beforeend', '<div id="pmToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090"></div>');
            c = document.getElementById('pmToastContainer');
        }
        const bg = {
            error: 'bg-danger text-white', success: 'bg-success text-white',
            warning: 'bg-warning text-dark', info: 'bg-dark text-white',
        }[type] || 'bg-dark text-white';
        const wrap = document.createElement('div');
        wrap.className = `toast align-items-center ${bg} border-0`;
        wrap.setAttribute('role', 'alert');
        wrap.innerHTML = `<div class="d-flex"><div class="toast-body">${pmEsc(message)}</div>`
            + `<button type="button" class="btn-close ${type === 'warning' ? '' : 'btn-close-white'} me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button></div>`;
        c.appendChild(wrap);
        const t = new bootstrap.Toast(wrap, { delay: 4500 });
        t.show();
        wrap.addEventListener('hidden.bs.toast', () => wrap.remove());
    }

    async function deletePayment(paymentId) {
        if (!(await pmConfirm({
            title: 'Eliminar pago', message: '¿Eliminar este pago? Esta acción no se puede deshacer.',
            confirmText: 'Eliminar', danger: true,
        }))) return;
        const existedBefore = paymentsCache.some((p) => p.id === paymentId);
        try {
            const response = await fetch(`/api/reservations/${reservationId}/payments/${paymentId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            const result = await response.json();
            if (result.success) {
                applyPaymentSummary(result.data?.summary);
                await loadPayments();
                pmToast('Pago eliminado', 'success');
            } else {
                pmToast(result.error || 'Error al eliminar el pago', 'error');
            }
        } catch (err) {
            // Lost response — the delete may have gone through. Reconcile from the server instead
            // of reporting a false failure (same idea as the save path).
            console.error('Delete payment network error, reconciling from server:', err);
            await loadPayments();
            const stillThere = paymentsCache.some((p) => p.id === paymentId);
            if (existedBefore && !stillThere) {
                pmToast('Pago eliminado (se recuperó tras un corte de conexión)', 'success');
            } else {
                pmToast('No se pudo confirmar la eliminación. Revisa la lista; si el pago sigue ahí, inténtalo otra vez.', 'warning');
            }
        }
    }

    // Ajuste — formulario inline (dentro del Resumen Financiero, ya no es modal).
    const adjForm = document.getElementById('adjustmentInlineForm');

    // Vista previa del impacto en el total: Total actual → Total nuevo.
    function updateAdjPreview() {
        const preview = document.getElementById('adjPreview');
        if (!preview) return;
        const type = document.querySelector('input[name="adjType"]:checked')?.value;
        const raw = parseAmount(document.getElementById('adjAmount').value);
        const isPercent = type === 'discount' && document.getElementById('adjModePercent').checked;
        const dd = reservationData || {};
        const base = (dd.payment && Number(dd.payment.total))
            || computeServicesSubtotalByType(dd.services || [], dd.paymentType) || 0;
        const curr = dd.currency || 'MXN';
        if (!raw || raw <= 0) { preview.innerHTML = ''; return; }
        const delta = isPercent ? -(base * (raw / 100)) : (type === 'discount' ? -raw : raw);
        const nuevo = Math.max(0, base + delta);
        const deltaColor = delta >= 0 ? '#b8894a' : '#4b6b3f';
        const deltaStr = `${delta >= 0 ? '+' : '-'}${formatCurrency(Math.abs(delta), curr)}`;
        preview.innerHTML = `<span class="fin-adj-delta" style="color:${deltaColor}">${deltaStr}</span>`
            + ` · Total: ${formatCurrency(base, curr)} → <strong>${formatCurrency(nuevo, curr)}</strong>`;
    }

    function openAdjustmentForm() {
        document.getElementById('adjTypeCharge').checked = true;
        document.getElementById('adjDescription').value = '';
        document.getElementById('adjAmount').value = '';
        document.getElementById('adjModeFixed').checked = true;
        document.getElementById('adjAmountModeGroup').style.display = 'none';
        document.getElementById('adjAmountPrefix').textContent = '$';
        document.getElementById('adjAmountLabel').textContent = 'Monto';
        document.getElementById('adjPreview').innerHTML = '';
        // Nota: a qué reservación/cliente se le aplica el ajuste.
        const adjNoteEl = document.getElementById('adjNote');
        if (adjNoteEl) {
            const dd = reservationData || {};
            const cli = dd.client?.companyName || dd.client?.fullName || dd.contactPerson || '';
            adjNoteEl.innerHTML = `<i class="ti ti-info-circle"></i> Se aplica al total de esta reservación`
                + `${dd.folio ? ` <strong>${PaymentBreakdownHelpers.escapeHtml(dd.folio)}</strong>` : ''}`
                + `${cli ? ` · ${PaymentBreakdownHelpers.escapeHtml(cli)}` : ''}`;
        }
        document.getElementById('addAdjustmentBtn')?.classList.add('d-none');
        if (adjForm) {
            adjForm.classList.remove('d-none');
            adjForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            document.getElementById('adjDescription').focus();
        }
    }
    function closeAdjustmentForm() {
        if (adjForm) adjForm.classList.add('d-none');
        document.getElementById('addAdjustmentBtn')?.classList.remove('d-none');
    }

    // El botón "+ Ajuste" del header alterna el formulario inline.
    document.getElementById('addAdjustmentBtn')?.addEventListener('click', () => {
        if (adjForm && !adjForm.classList.contains('d-none')) closeAdjustmentForm();
        else openAdjustmentForm();
    });
    document.getElementById('cancelAdjustmentBtn')?.addEventListener('click', closeAdjustmentForm);

    // Toggle amount mode group when discount selected
    document.querySelectorAll('input[name="adjType"]').forEach(radio => {
        radio.addEventListener('change', () => {
            const isDiscount = document.getElementById('adjTypeDiscount').checked;
            document.getElementById('adjAmountModeGroup').style.display = isDiscount ? '' : 'none';
            if (!isDiscount) {
                document.getElementById('adjModeFixed').checked = true;
                document.getElementById('adjAmountPrefix').textContent = '$';
                document.getElementById('adjAmountLabel').textContent = 'Monto';
            }
            updateAdjPreview();
        });
    });

    // Toggle amount prefix when percentage mode selected
    document.querySelectorAll('input[name="adjAmountMode"]').forEach(radio => {
        radio.addEventListener('change', () => {
            const isPercent = document.getElementById('adjModePercent').checked;
            document.getElementById('adjAmountPrefix').textContent = isPercent ? '%' : '$';
            document.getElementById('adjAmountLabel').textContent = isPercent ? 'Porcentaje' : 'Monto';
            updateAdjPreview();
        });
    });

    attachThousands(document.getElementById('adjAmount'));
    document.getElementById('adjAmount')?.addEventListener('input', updateAdjPreview);
    // Enter en Descripción/Monto guarda el ajuste.
    adjForm?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && (e.target.id === 'adjDescription' || e.target.id === 'adjAmount')) {
            e.preventDefault();
            document.getElementById('saveAdjustmentBtn')?.click();
        }
    });

    document.getElementById('saveAdjustmentBtn')?.addEventListener('click', async () => {
        const type = document.querySelector('input[name="adjType"]:checked').value;
        const description = document.getElementById('adjDescription').value.trim();
        const rawValue = parseAmount(document.getElementById('adjAmount').value);
        const isPercent = type === 'discount' && document.getElementById('adjModePercent').checked;

        if (!description) { pmToast('La descripción es requerida', 'warning'); return; }
        if (!rawValue || rawValue <= 0) { pmToast('El valor debe ser mayor a 0', 'warning'); return; }
        if (isPercent && rawValue > 100) { pmToast('El porcentaje no puede ser mayor a 100', 'warning'); return; }

        const payload = { type, description };
        if (isPercent) {
            payload.percentage = rawValue;
        } else {
            payload.amount = rawValue;
        }

        // Loader en Guardar (y deshabilita Cancelar) durante el POST + recarga, para que se vea
        // que está trabajando. En éxito, loadReservation re-renderiza; solo restauramos en error.
        const btn = document.getElementById('saveAdjustmentBtn');
        const cancelBtn = document.getElementById('cancelAdjustmentBtn');
        const originalBtn = btn.innerHTML;
        btn.disabled = true;
        if (cancelBtn) cancelBtn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:.8rem;height:.8rem;border-width:.13em;"></span>';
        try {
            const response = await fetch(`/api/reservations/${reservationId}/adjustments`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });
            const result = await response.json();
            if (result.success) {
                closeAdjustmentForm();
                await loadReservation();
                pmToast('Ajuste agregado', 'success');
            } else {
                pmToast(result.error || 'Error al agregar ajuste', 'error');
            }
        } catch (err) {
            console.error('Add adjustment error:', err);
            pmToast('Error al agregar ajuste', 'error');
        }
        btn.disabled = false;
        if (cancelBtn) cancelBtn.disabled = false;
        btn.innerHTML = originalBtn;
    });

    // Cancel functionality now handled by shared utilities

    await loadReservation();
});

document.addEventListener('click', function(e) {
    const trigger = e.target.closest('.photo-preview-trigger');
    if (!trigger) return;
    document.getElementById('photoPreviewImg').src = trigger.dataset.photo;
    document.getElementById('photoPreviewName').textContent = trigger.dataset.name;
    new bootstrap.Modal(document.getElementById('photoPreviewModal')).show();
});
</script>

