    transition: border-color 0.12s ease, background 0.12s ease;
}
#paymentsOffcanvas .pay-drop.is-dragover { border-color: #6E7A50; background: #f1f2ec; }
#paymentsOffcanvas .pay-drop input[type="file"] { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
#paymentsOffcanvas .pay-file-row { display: flex; align-items: center; gap: 6px; max-width: 100%; }
/* Chip del comprobante ya guardado: antes era un link suelto colgando bajo el boton. Dentro de la zona
   se lee como "esto es lo que hay hoy", junto a lo que lo reemplazaria. */
#paymentsOffcanvas .pay-receipt-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.76rem;
    font-weight: 600;
    color: #566040;
    background: #eef0e6;
    border: 1px solid #dce2d0;
    border-radius: 999px;
    padding: 0.22rem 0.6rem;
    text-decoration: none;
}
#paymentsOffcanvas .pay-receipt-chip:hover { background: #e4e8d8; color: #4f5838; }
#paymentsOffcanvas .pay-file-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
