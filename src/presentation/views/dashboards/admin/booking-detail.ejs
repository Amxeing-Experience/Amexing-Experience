#paymentsOffcanvas { --pay-attach-h: 96px; }
#paymentsOffcanvas .pay-form textarea#paymentNotes { height: var(--pay-attach-h); min-height: var(--pay-attach-h); }
#paymentsOffcanvas .pay-drop {
