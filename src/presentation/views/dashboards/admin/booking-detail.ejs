    // ===== FINANCIAL SUMMARY =====

    function renderFinancialSummary() {
        const d = reservationData;
        const card = document.getElementById('financialSummaryCard');
        const body = document.getElementById('financialSummaryBody');
        const addBtn = document.getElementById('addAdjustmentBtn');
        const addPaymentBtn = document.getElementById('addPaymentBtn');
        const adjustments = d.adjustments || [];
        // Subtotal recomputed from per-service pricesByType[paymentType] so the booking
        // matches the quote's totals when both use the same payment type, and updates
        // correctly if payment type changes on the reservation. Falls back to the
        // stored values for very old data without pricesByType.
        const computedSubtotal = computeServicesSubtotalByType(d.services, d.paymentType);
        const servicesSubtotal = computedSubtotal > 0
            ? computedSubtotal
            : (d.servicesSubtotal || d.totalAmount || 0);
        const canEdit = d.status !== 'cancelled' && d.status !== 'completed';

        card.style.display = '';
        if (canEdit) addBtn.classList.remove('d-none');
        else addBtn.classList.add('d-none');
        // "Agregar pago" solo depende de d.status (ya disponible aquí, tras loadReservation), no de
        // paymentsCache — se habilita en el mismo punto que "+ Ajuste" para no esperar el fetch aparte
        // de loadPayments (evita el retraso visible del botón tras un hard reload).
        if (addPaymentBtn) {
            if (canEdit) addPaymentBtn.classList.remove('d-none');
            else addPaymentBtn.classList.add('d-none');
        }

        const charges = adjustments.filter(a => a.type === 'charge');
        const discounts = adjustments.filter(a => a.type === 'discount');
        const chargesTotal = charges.reduce((s, a) => s + (a.amount || 0), 0);
        const discountsTotal = discounts.reduce((s, a) => s + (a.amount || 0), 0);
        // Final total = subtotal + charges - discounts (computed instead of using
        // the stored d.totalAmount so payment-type changes recompute correctly).
        // Nunca negativo: un descuento mayor al total lo deja en 0 (igual que el server).
        const finalTotal = Math.max(0, servicesSubtotal + chargesTotal - discountsTotal);
        const curr = d.currency || 'MXN';

        let html = '';
        // Subtotal line
        html += `<div class="d-flex justify-content-between align-items-center py-2 border-bottom">
            <span class="text-muted"><i class="ti ti-list-details me-2"></i>Subtotal Servicios</span>
            <span class="fw-semibold">${formatCurrency(servicesSubtotal, curr)}</span>
        </div>`;

        // Charges
        charges.forEach(adj => {
            html += `<div class="d-flex justify-content-between align-items-center py-2 border-bottom ps-3">
                <div>
                    <i class="ti ti-plus text-danger me-1"></i>
                    <span class="small">${PaymentBreakdownHelpers.escapeHtml(adj.description)}</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-danger fw-semibold">+${formatCurrency(adj.amount, curr)}</span>
                    ${canEdit ? `<button class="btn btn-sm btn-outline-danger py-0 px-1 remove-adj-btn" data-adj-id="${adj.id}" title="Eliminar"><i class="ti ti-x" style="font-size:0.75rem"></i></button>` : ''}
                </div>
            </div>`;
        });

        // Discounts
        discounts.forEach(adj => {
            const pctLabel = adj.percentage ? ` (${adj.percentage}%)` : '';
            html += `<div class="d-flex justify-content-between align-items-center py-2 border-bottom ps-3">
                <div>
                    <i class="ti ti-discount-2 text-success me-1"></i>
                    <span class="small">${PaymentBreakdownHelpers.escapeHtml(adj.description)}${pctLabel}</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-success fw-semibold">-${formatCurrency(adj.amount, curr)}</span>
                    ${canEdit ? `<button class="btn btn-sm btn-outline-danger py-0 px-1 remove-adj-btn" data-adj-id="${adj.id}" title="Eliminar"><i class="ti ti-x" style="font-size:0.75rem"></i></button>` : ''}
                </div>
            </div>`;
        });

        // Final total
        html += `<div class="d-flex justify-content-between align-items-center py-2 mt-1">
            <span class="fw-bold"><i class="ti ti-receipt me-2"></i>Total Final</span>
            <span class="fw-bold fs-5 text-success">${formatCurrency(finalTotal, curr)}</span>
        </div>`;

        // Payment block — estado + total + pagado + saldo. El "Saldo" se resuelve con
        // resolveDisplayedBalance: cuando está pagado el saldo mostrado es 0 y, si el pago se hizo en un
        // método más barato que el ancla de la cotización, el residuo físico aparece como línea de AHORRO
        // aparte (nunca restado del saldo). El detalle completo (chips, cobertura, desglose por método,
        // historial y registro) vive en #paymentsOffcanvas.
        const pay = d.payment;
        if (pay) {
            const resolved = PaymentBreakdownHelpers.resolveDisplayedBalance(pay);
            const balanceCls = resolved.displayedBalance > 0 ? 'text-danger' : 'text-success';
            const savingsRow = resolved.savings
                ? `<div class="py-2 border-top" style="color:#146c43;">
                    <div class="fw-semibold"><i class="ti ti-discount-2 me-2"></i>${PaymentBreakdownHelpers.escapeHtml(resolved.savings.label)}</div>
                    <div class="small">${PaymentBreakdownHelpers.escapeHtml(resolved.savings.sublabel)}</div>
                </div>` : '';
            html += `<div class="border-top mt-2 pt-2">
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted"><i class="ti ti-cash me-2"></i>Estado de pago</span>
                    ${getPaymentStatusBadge(pay.paymentStatus)}
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted"><i class="ti ti-receipt-2 me-2"></i>Total a pagar</span>
                    <span class="fw-semibold">${formatCurrency(pay.total, curr)}</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted"><i class="ti ti-check me-2"></i>Pagado</span>
                    <span class="fw-semibold text-success">${formatCurrency(pay.paidAmount, curr)}</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-muted"><i class="ti ti-wallet me-2"></i>Saldo</span>
                    <span class="fw-semibold ${balanceCls}">${formatCurrency(resolved.displayedBalance, curr)}</span>
                </div>
                ${savingsRow}
            </div>`;
        }

        // Comparativo por método de pago (staff-facing): subtotal de servicios en los 3 métodos,
        // con marcador sobre el método actual. Reutiliza computeServicesSubtotalByType (sin fetch).
        const comparisonMethods = [
            { key: 'efectivo', label: 'Efectivo' },
            { key: 'transferencia', label: 'Transferencia' },
            { key: 'tarjeta', label: 'Tarjeta' },
        ];
        const comparisonRows = comparisonMethods.map(m => {
            const amount = computeServicesSubtotalByType(d.services, m.key);
            const isActive = m.key === d.paymentType;
            const marker = isActive
                ? `<i class="ti ti-point-filled text-primary me-1"></i>${m.label} <span class="small text-primary">(Método actual: ${m.label})</span>`
                : `<i class="ti ti-point text-muted me-1"></i>${m.label}`;
            return `<div class="d-flex justify-content-between align-items-center py-1">
                <span class="${isActive ? 'fw-semibold' : 'text-muted'}">${marker}</span>
                <span class="${isActive ? 'fw-semibold' : ''}">${formatCurrency(amount, curr)}</span>
            </div>`;
        }).join('');
        html += `<div class="border-top mt-2 pt-2">
            <button class="btn btn-sm btn-link text-decoration-none p-0" type="button" data-bs-toggle="collapse" data-bs-target="#paymentMethodComparison" aria-expanded="false" aria-controls="paymentMethodComparison" id="paymentMethodComparisonToggle">
                <i class="ti ti-arrows-left-right me-1"></i>Ver comparativo por método de pago
            </button>
            <div class="collapse mt-2" id="paymentMethodComparison">${comparisonRows}</div>
        </div>`;

        body.innerHTML = html;

        // Bind remove buttons
        body.querySelectorAll('.remove-adj-btn').forEach(btn => {
            btn.addEventListener('click', () => removeAdjustment(btn.dataset.adjId));
        });
    }

    async function removeAdjustment(adjId) {
        if (!(await pmConfirm({
            title: 'Eliminar ajuste', message: '¿Eliminar este ajuste?', confirmText: 'Eliminar', danger: true,
        }))) return;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/adjustments/${adjId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            const result = await response.json();
            if (result.success) {
                await loadReservation();
                pmToast('Ajuste eliminado', 'success');
            } else {
                pmToast(result.error || 'Error al eliminar ajuste', 'error');
            }
        } catch (err) {
            console.error('Remove adjustment error:', err);
            pmToast('Error al eliminar ajuste', 'error');
        }
    }

    // ===== PAYMENTS =====

    let paymentsCache = [];
    // Último summary AMPLIO de GET .../payments (coveragePercent/availableMethods/anchoredMethod/
    // montoParaSaldar). El summary ANGOSTO de getReservationById NO trae estos campos, así que el carrito
    // se puebla solo desde aquí.
    let latestSummary = null;

    function paymentsOffcanvasInstance() {
        const el = document.getElementById('paymentsOffcanvas');
        return el ? bootstrap.Offcanvas.getOrCreateInstance(el) : null;
    }

    const PAYMENT_METHOD_LABELS = { efectivo: 'Efectivo', transferencia: 'Transferencia', tarjeta: 'Tarjeta' };

    async function loadPayments() {
        try {
            const response = await fetch(`/api/reservations/${reservationId}/payments`, {
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            const result = await response.json();
            paymentsCache = result?.data?.payments || [];
            // GET returns the fresh summary too — keep the saldo y el carrito en sync en cada recarga.
            if (result?.data?.summary) applyPaymentSummary(result.data.summary);
        } catch (err) {
            // Keep the existing cache on a transient network error instead of blanking the list.
            console.error('Error loading payments:', err);
        }
        renderPayments();
    }

    // Rellena las secciones del offcanvas (chips / cobertura / saldo restante / descuento) desde el
    // summary AMPLIO. Los % de cada chip y la barra usan coveragePercent/remainingPercent del backend TAL
    // CUAL (no re-derivar en cliente: rompería con ajustes manuales).
    function renderPaymentsOffcanvas() {
        if (!latestSummary) return;
        const services = reservationData?.services || [];
        const curr = reservationData?.currency || 'MXN';
        const chips = document.getElementById('paymentChips');
        const coverage = document.getElementById('paymentCoverageCard');
        const remaining = document.getElementById('paymentRemainingByMethod');
        const discount = document.getElementById('paymentDiscountEmphasis');
        if (chips) chips.innerHTML = PaymentBreakdownHelpers.buildMethodChips(latestSummary, services, curr);
        if (coverage) coverage.innerHTML = PaymentBreakdownHelpers.buildCoverageCard(latestSummary, curr);
        if (remaining) {
            const html = PaymentBreakdownHelpers.buildRemainingByMethod(latestSummary, curr);
            remaining.innerHTML = html;
            remaining.style.display = html ? '' : 'none';
        }
        if (discount) {
            const html = PaymentBreakdownHelpers.buildDiscountEmphasis(latestSummary, services, curr);
            discount.innerHTML = html;
            discount.style.display = html ? '' : 'none';
        }
    }

    function renderPayments() {
        const body = document.getElementById('paymentsBody');
        const showFormBtn = document.getElementById('showPaymentFormBtn');
        if (!body) return;

        const d = reservationData;
        const canEdit = d.status !== 'cancelled' && d.status !== 'completed';
        const curr = d.currency || 'MXN';

        // "Agregar pago" (header) ya se habilita en renderFinancialSummary, justo tras loadReservation.
        // "Registrar pago" (dentro del carrito) solo es relevante una vez abierto el offcanvas.
        if (showFormBtn) { if (canEdit) showFormBtn.classList.remove('d-none'); else showFormBtn.classList.add('d-none'); }

        if (!paymentsCache.length) {
            body.innerHTML = '<div class="text-center py-3 text-muted">Sin pagos registrados</div>';
            return;
        }

        const rows = paymentsCache.map((p) => {
            const ref = p.reference ? PaymentBreakdownHelpers.escapeHtml(p.reference) : '<span class="text-muted">—</span>';
            const receipt = p.receiptUrl
                ? `<a href="${PaymentBreakdownHelpers.escapeHtml(p.receiptUrl)}" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Ver comprobante"><i class="ti ti-file-invoice"></i></a>`
                : '<span class="text-muted">—</span>';
            return `<tr>
                <td>${formatDate(p.paidAt || p.createdAt)}</td>
                <td><span class="badge bg-secondary-subtle text-secondary">${PAYMENT_METHOD_LABELS[p.method] || p.method || '—'}</span></td>
                <td>${ref}</td>
                <td class="text-end">${formatCurrency(p.amount, curr)}</td>
                <td>${p.origCurrency || curr}</td>
                <td class="text-center">${receipt}</td>
                <td class="text-end">
                    ${canEdit ? `<button class="btn btn-sm btn-outline-primary py-0 px-1 edit-payment-btn" data-payment-id="${p.id}" title="Editar"><i class="ti ti-edit"></i></button>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1 delete-payment-btn" data-payment-id="${p.id}" title="Eliminar"><i class="ti ti-trash"></i></button>` : ''}
                </td>
            </tr>`;
        }).join('');

        body.innerHTML = `<div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Método</th>
                        <th>Referencia</th>
                        <th class="text-end">Monto</th>
                        <th>Moneda</th>
                        <th class="text-center">Comprobante</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
        </div>`;

        body.querySelectorAll('.edit-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => renderPaymentForm(btn.dataset.paymentId));
        });
        body.querySelectorAll('.delete-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => deletePayment(btn.dataset.paymentId));
        });
    }

    // Read a File as base64 (strip the "data:...;base64," prefix) for the JSON receipt upload.
    function fileToBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result).split(',')[1] || '');
            reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
            reader.readAsDataURL(file);
        });
    }

    // Upload a payment receipt in a SEPARATE request (decoupled from the save). The payment is
    // already persisted, so this never risks it: returns null on success, or a warning string if
    // the comprobante couldn't be uploaded (the user can retry by editing the payment).
    async function uploadReceipt(paymentId, file) {
        try {
            const body = JSON.stringify({
                fileBase64: await fileToBase64(file), fileName: file.name, mimeType: file.type,
            });
            const resp = await fetch(`/api/reservations/${reservationId}/payments/${paymentId}/receipt`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${authToken()}`, 'Content-Type': 'application/json' },
                body,
            });
            const r = await resp.json().catch(() => ({}));
            if (resp.ok && r.success) return null;
            return r.error
                ? `Pago guardado, pero el comprobante no se subió: ${r.error}`
                : 'Pago guardado, pero el comprobante no se subió. Reinténtalo editando el pago.';
        } catch (err) {
            console.error('Receipt upload error:', err);
            return 'Pago guardado, pero el comprobante no se subió (se cortó la conexión). Reinténtalo editando el pago.';
        }
    }

    // Inline payment form (relocated into #paymentsOffcanvas). null = nuevo, id = editar el pago.
    function renderPaymentForm(paymentId) {
        const wrap = document.getElementById('paymentFormWrap');
        if (!wrap) return;
        const existing = paymentId ? paymentsCache.find((p) => p.id === paymentId) : null;
        const curr = existing?.origCurrency || 'MXN';
        const paidAt = existing?.paidAt ? new Date(existing.paidAt).toISOString().slice(0, 10) : '';
        // Payment date allows the future (reservations later); shared standard 1900 .. today + 20y.
        const paidAtMax = (() => { const dt = new Date(); dt.setFullYear(dt.getFullYear() + 20); return dt.toISOString().slice(0, 10); })();
        const opt = (v, label, sel) => `<option value="${v}" ${sel === v ? 'selected' : ''}>${label}</option>`;
        const receiptLink = existing?.receiptUrl
            ? `<a href="${existing.receiptUrl}" target="_blank" class="small d-block mt-1"><i class="ti ti-file-invoice me-1"></i>Ver comprobante actual</a>` : '';

        // Método: poblado dinámicamente desde availableMethods (Fase C), NUNCA hardcodeado a 3 opciones.
        // Al editar, se conserva el método guardado aunque ya no esté disponible (no cambiarlo en silencio).
        // Sin métodos disponibles (H3): select deshabilitado con mensaje y guardado bloqueado.
        const available = (latestSummary && Array.isArray(latestSummary.availableMethods)) ? latestSummary.availableMethods.slice() : [];
        const method = existing?.method || available[0] || '';
        const methodOrder = available.slice();
        if (existing?.method && !methodOrder.includes(existing.method)) methodOrder.push(existing.method);
        const methodDisabled = methodOrder.length === 0;
        const methodSelectHtml = methodDisabled
            ? `<select class="form-select form-select-sm" id="paymentMethod" disabled><option value="">Sin métodos disponibles</option></select>
               <div class="form-text text-danger">No hay métodos de pago disponibles para esta reservación.</div>`
            : `<select class="form-select form-select-sm" id="paymentMethod">${methodOrder.map((m) => opt(m, PAYMENT_METHOD_LABELS[m] || m, method)).join('')}</select>`;

        const amountInit = existing ? (existing.origAmount ?? existing.amount ?? '') : '';

        wrap.innerHTML = `
            <h6 class="fw-bold mb-2">${existing ? '<i class="ti ti-edit me-1"></i>Editar pago' : '<i class="ti ti-cash me-1"></i>Registrar pago'}</h6>
            <input type="hidden" id="paymentId" value="${existing ? existing.id : ''}">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentAmount">Monto</label>
                    <input type="text" inputmode="decimal" maxlength="17" class="form-control form-control-sm" id="paymentAmount" placeholder="0.00" value="${amountInit}">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentCurrency">Moneda</label>
                    <select class="form-select form-select-sm" id="paymentCurrency">${opt('MXN', 'MXN', curr)}${opt('USD', 'USD', curr)}</select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentMethod">Método</label>
                    ${methodSelectHtml}
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentPaidAt">Fecha de pago</label>
                    <input type="date" class="form-control form-control-sm" id="paymentPaidAt" min="1900-01-01" max="${paidAtMax}" value="${paidAt}">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold small" for="paymentReference">Referencia</label>
                    <input type="text" class="form-control form-control-sm" id="paymentReference" maxlength="100" placeholder="Folio / autorización" value="${PaymentBreakdownHelpers.escapeHtml(existing?.reference || '')}">
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold small" for="paymentReceipt">Comprobante (imagen o PDF)</label>
                    <input type="file" class="form-control form-control-sm" id="paymentReceipt" accept="image/*,application/pdf">
                    ${receiptLink}
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold small" for="paymentNotes">Notas</label>
                    <textarea class="form-control form-control-sm" id="paymentNotes" rows="2" maxlength="300" placeholder="Notas del pago">${PaymentBreakdownHelpers.escapeHtml(existing?.notes || '')}</textarea>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="cancelPaymentBtn">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary px-4" id="savePaymentBtn"><i class="ti ti-check me-1"></i>Guardar</button>
            </div>`;
        // El formulario vive dentro del offcanvas (posición fija con scroll propio): se muestra en su
        // sitio y se desplaza a la vista dentro del panel, sin scrollIntoView de página ni borde inline.
        wrap.style.display = '';
        wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const saveBtn = document.getElementById('savePaymentBtn');
        // Sin métodos disponibles (H3): no se puede registrar/editar el pago — bloquea el guardado.
        if (methodDisabled && saveBtn) saveBtn.disabled = true;
        document.getElementById('cancelPaymentBtn').addEventListener('click', () => { wrap.style.display = 'none'; wrap.innerHTML = ''; });
        saveBtn.addEventListener('click', () => savePayment(existing ? existing.id : ''));
        attachThousands(document.getElementById('paymentAmount'));
    }

    // Refresh the Financial Summary numbers + el carrito desde un summary de respuesta (POST/PUT/DELETE)
    // o de GET, sin recargar la página. Guarda el summary AMPLIO para poblar el offcanvas.
    function applyPaymentSummary(summary) {
        if (!summary) return;
        latestSummary = summary;
        if (reservationData.payment) Object.assign(reservationData.payment, summary);
        else reservationData.payment = { ...summary };
        renderFinancialSummary();
        renderPaymentsOffcanvas();
    }

    // "Agregar pago" (header): abre el carrito. El formulario queda colapsado detrás de
    // "Registrar pago" dentro del panel (menos amontonado al abrir).
    document.getElementById('addPaymentBtn')?.addEventListener('click', () => {
        paymentsOffcanvasInstance()?.show();
    });
    // "Registrar pago" (dentro del carrito): muestra el formulario de nuevo pago sin reabrir el panel.
    document.getElementById('showPaymentFormBtn')?.addEventListener('click', () => renderPaymentForm(null));
    // Cerrar el carrito (backdrop-click / Escape / botón) descarta el formulario en silencio (H5).
    document.getElementById('paymentsOffcanvas')?.addEventListener('hidden.bs.offcanvas', () => {
        const wrap = document.getElementById('paymentFormWrap');
        if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; }
    });

    async function savePayment(paymentId) {
        const amount = parseAmount(document.getElementById('paymentAmount').value);
        const paidAt = document.getElementById('paymentPaidAt').value;

        if (!amount || amount <= 0) { pmToast('El monto debe ser mayor a 0', 'warning'); return; }
        if (amount > 100000000) { pmToast('El monto no puede exceder 100,000,000', 'warning'); return; }

        const payload = {
            amount,
            currency: document.getElementById('paymentCurrency').value,
            method: document.getElementById('paymentMethod').value,
            reference: document.getElementById('paymentReference').value.trim(),
            notes: document.getElementById('paymentNotes').value.trim(),
        };
        if (paidAt) payload.paidAt = paidAt;

        // Receipt (optional) — validated here but uploaded in a SEPARATE request AFTER the payment is
        // saved (see uploadReceipt). The receipt no longer travels inside the payment save, so a slow
        // S3 upload can never block or lose the payment itself.
        const fileInput = document.getElementById('paymentReceipt');
        const file = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
        if (file) {
            if (file.size > 10 * 1024 * 1024) { pmToast('El comprobante supera el límite de 10MB', 'warning'); return; }
            if (!/^image\//.test(file.type) && file.type !== 'application/pdf') { pmToast('El comprobante debe ser imagen o PDF', 'warning'); return; }
        }

        const isEdit = !!paymentId;
        const url = isEdit
            ? `/api/reservations/${reservationId}/payments/${paymentId}`
            : `/api/reservations/${reservationId}/payments`;
        const httpMethod = isEdit ? 'PUT' : 'POST';
        // Snapshot the current payment count so a LOST response can be reconciled afterwards:
        // the request usually reaches the server and saves even when the reply never comes back.
        const prevCount = paymentsCache.length;

        const btn = document.getElementById('savePaymentBtn');
        if (btn) btn.disabled = true;
        try {
            const response = await fetch(url, {
                method: httpMethod,
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });
            // Read the raw body first so a non-JSON response (e.g. an HTML error page) surfaces a
            // clear message instead of the generic "Error al guardar el pago".
            const rawBody = await response.text();
            let result;
            try {
                result = JSON.parse(rawBody);
            } catch (parseErr) {
                pmToast(`Error del servidor (HTTP ${response.status})`, 'error');
                if (btn) btn.disabled = false;
                return;
            }
            if (result.success) {
                const savedId = result.data?.payment?.id || paymentId;
                // Upload the receipt in its own request now that the payment is safely saved. If it
                // fails, the payment stays — we just warn so the user can retry the comprobante.
                let receiptWarn = result.warning || null;
                if (file && savedId) receiptWarn = await uploadReceipt(savedId, file);
                const wrap = document.getElementById('paymentFormWrap');
                if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; }
                applyPaymentSummary(result.data?.summary);
                await loadPayments();
                if (receiptWarn) pmToast(receiptWarn, 'warning');
                else pmToast('Pago guardado', 'success');
            } else {
                // Build a clear message from the real reason (status + server detail/code).
                let msg = result.error || 'No se pudo guardar el pago';
                if (result.detail) msg += ` — ${result.detail}`;
                if (response.status === 401) {
                    msg = `Sesión/token inválido (${result.detail || result.code || '401'}). Recarga la página (Ctrl+Shift+R) e intenta de nuevo.`;
                }
                pmToast(msg, 'error');
                if (btn) btn.disabled = false;
            }
        } catch (err) {
            // Network error (e.g. "Failed to fetch"): the request commonly reaches the server and
            // saves even though the response is lost in transit (connection dropped). Instead of a
            // false failure, reconcile from the server — the same thing a manual Ctrl+R would show.
            console.error('Save payment network error, reconciling from server:', err);
            await loadPayments(); // refreshes paymentsCache + saldo
            let saved = !isEdit && paymentsCache.length > prevCount;
            if (!saved && !isEdit) {
                // The save may still be finishing — give it one more reload before giving up.
                await new Promise((resolve) => setTimeout(resolve, 700));
                await loadPayments();
                saved = paymentsCache.length > prevCount;
            }
            const wrap = document.getElementById('paymentFormWrap');
            if (saved) {
                if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; }
                pmToast('Pago guardado (se recuperó tras un corte de conexión)', 'success');
            } else if (isEdit) {
                if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; }
                pmToast('La respuesta se perdió, pero la lista ya se actualizó — verifica que el pago sea correcto.', 'warning');
            } else {
                pmToast('No se pudo confirmar el guardado. Revisa la lista; si el pago no aparece, regístralo otra vez.', 'warning');
                if (btn) btn.disabled = false;
            }
        }
    }

    // ---- Styled confirm + toasts (replace the native confirm/alert in the payments card) ----
    const pmEsc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    function pmConfirm({ title = 'Confirmar', message = '', confirmText = 'Aceptar', danger = false } = {}) {
        return new Promise((resolve) => {
            let el = document.getElementById('pmConfirmModal');
            if (!el) {
                document.body.insertAdjacentHTML('beforeend', `
                    <div class="modal fade" id="pmConfirmModal" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg" style="border-radius:0.85rem;overflow:hidden">
                          <div class="modal-body text-center px-4 pt-4 pb-2">
                            <div data-pm-icon class="d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;border-radius:50%"></div>
                            <h5 class="fw-bold mb-2" data-pm-title></h5>
                            <p class="text-muted mb-0" data-pm-msg></p>
                          </div>
                          <div class="modal-footer border-0 justify-content-center pt-1 pb-4 gap-2">
                            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn px-4" data-pm-ok></button>
                          </div>
                        </div>
                      </div>
                    </div>`);
                el = document.getElementById('pmConfirmModal');
            }
            el.querySelector('[data-pm-title]').textContent = title;
            el.querySelector('[data-pm-msg]').textContent = message;
            const icon = el.querySelector('[data-pm-icon]');
            icon.classList.remove('bg-danger-subtle', 'text-danger', 'bg-primary-subtle', 'text-primary');
            icon.classList.add(danger ? 'bg-danger-subtle' : 'bg-primary-subtle', danger ? 'text-danger' : 'text-primary');
            icon.innerHTML = `<i class="ti ${danger ? 'ti-alert-triangle' : 'ti-help-circle'}" style="font-size:1.75rem"></i>`;
            const old = el.querySelector('[data-pm-ok]');
            const ok = old.cloneNode(true);
            ok.textContent = confirmText;
            ok.className = `btn px-4 ${danger ? 'btn-danger' : 'btn-primary'}`;
            old.replaceWith(ok);
            const modal = bootstrap.Modal.getOrCreateInstance(el);
            let confirmed = false;
            ok.addEventListener('click', () => { confirmed = true; modal.hide(); });
            el.addEventListener('hidden.bs.modal', () => resolve(confirmed), { once: true });
            modal.show();
        });
    }

    function pmToast(message, type = 'info') {
        let c = document.getElementById('pmToastContainer');
        if (!c) {
            document.body.insertAdjacentHTML('beforeend', '<div id="pmToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090"></div>');
            c = document.getElementById('pmToastContainer');
        }
        const bg = {
            error: 'bg-danger text-white', success: 'bg-success text-white',
            warning: 'bg-warning text-dark', info: 'bg-dark text-white',
        }[type] || 'bg-dark text-white';
        const wrap = document.createElement('div');
        wrap.className = `toast align-items-center ${bg} border-0`;
        wrap.setAttribute('role', 'alert');
        wrap.innerHTML = `<div class="d-flex"><div class="toast-body">${pmEsc(message)}</div>`
            + `<button type="button" class="btn-close ${type === 'warning' ? '' : 'btn-close-white'} me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button></div>`;
        c.appendChild(wrap);
        const t = new bootstrap.Toast(wrap, { delay: 4500 });
        t.show();
        wrap.addEventListener('hidden.bs.toast', () => wrap.remove());
    }

    async function deletePayment(paymentId) {
        if (!(await pmConfirm({
            title: 'Eliminar pago', message: '¿Eliminar este pago? Esta acción no se puede deshacer.',
            confirmText: 'Eliminar', danger: true,
        }))) return;
        const existedBefore = paymentsCache.some((p) => p.id === paymentId);
        try {
            const response = await fetch(`/api/reservations/${reservationId}/payments/${paymentId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            const result = await response.json();
            if (result.success) {
                applyPaymentSummary(result.data?.summary);
                await loadPayments();
                pmToast('Pago eliminado', 'success');
            } else {
                pmToast(result.error || 'Error al eliminar el pago', 'error');
            }
        } catch (err) {
            // Lost response — the delete may have gone through. Reconcile from the server instead
            // of reporting a false failure (same idea as the save path).
            console.error('Delete payment network error, reconciling from server:', err);
            await loadPayments();
            const stillThere = paymentsCache.some((p) => p.id === paymentId);
            if (existedBefore && !stillThere) {
                pmToast('Pago eliminado (se recuperó tras un corte de conexión)', 'success');
            } else {
                pmToast('No se pudo confirmar la eliminación. Revisa la lista; si el pago sigue ahí, inténtalo otra vez.', 'warning');
            }
        }
    }

    // Add Adjustment Modal logic
    document.getElementById('addAdjustmentBtn')?.addEventListener('click', () => {
        // Reset form
        document.getElementById('adjTypeCharge').checked = true;
        document.getElementById('adjDescription').value = '';
        document.getElementById('adjAmount').value = '';
        document.getElementById('adjModeFixed').checked = true;
        document.getElementById('adjAmountModeGroup').style.display = 'none';
        document.getElementById('adjAmountPrefix').textContent = '$';
        document.getElementById('adjAmountLabel').textContent = 'Monto';
        new bootstrap.Modal(document.getElementById('addAdjustmentModal')).show();
    });

    // Toggle amount mode group when discount selected
    document.querySelectorAll('input[name="adjType"]').forEach(radio => {
        radio.addEventListener('change', () => {
            const isDiscount = document.getElementById('adjTypeDiscount').checked;
            document.getElementById('adjAmountModeGroup').style.display = isDiscount ? '' : 'none';
            if (!isDiscount) {
                document.getElementById('adjModeFixed').checked = true;
                document.getElementById('adjAmountPrefix').textContent = '$';
                document.getElementById('adjAmountLabel').textContent = 'Monto';
            }
        });
    });

    // Toggle amount prefix when percentage mode selected
    document.querySelectorAll('input[name="adjAmountMode"]').forEach(radio => {
        radio.addEventListener('change', () => {
            const isPercent = document.getElementById('adjModePercent').checked;
            document.getElementById('adjAmountPrefix').textContent = isPercent ? '%' : '$';
            document.getElementById('adjAmountLabel').textContent = isPercent ? 'Porcentaje' : 'Monto';
        });
    });

    attachThousands(document.getElementById('adjAmount'));

    document.getElementById('saveAdjustmentBtn')?.addEventListener('click', async () => {
        const type = document.querySelector('input[name="adjType"]:checked').value;
        const description = document.getElementById('adjDescription').value.trim();
        const rawValue = parseAmount(document.getElementById('adjAmount').value);
        const isPercent = type === 'discount' && document.getElementById('adjModePercent').checked;

        if (!description) { pmToast('La descripción es requerida', 'warning'); return; }
        if (!rawValue || rawValue <= 0) { pmToast('El valor debe ser mayor a 0', 'warning'); return; }
        if (isPercent && rawValue > 100) { pmToast('El porcentaje no puede ser mayor a 100', 'warning'); return; }

        const payload = { type, description };
        if (isPercent) {
            payload.percentage = rawValue;
        } else {
            payload.amount = rawValue;
        }

        const btn = document.getElementById('saveAdjustmentBtn');
        btn.disabled = true;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/adjustments`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });
            const result = await response.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('addAdjustmentModal'))?.hide();
                await loadReservation();
                pmToast('Ajuste agregado', 'success');
            } else {
                pmToast(result.error || 'Error al agregar ajuste', 'error');
            }
        } catch (err) {
            console.error('Add adjustment error:', err);
            pmToast('Error al agregar ajuste', 'error');
        }
        btn.disabled = false;
    });

    // Cancel functionality now handled by shared utilities

    await loadReservation();
});

document.addEventListener('click', function(e) {
    const trigger = e.target.closest('.photo-preview-trigger');
    if (!trigger) return;
    document.getElementById('photoPreviewImg').src = trigger.dataset.photo;
    document.getElementById('photoPreviewName').textContent = trigger.dataset.name;
    new bootstrap.Modal(document.getElementById('photoPreviewModal')).show();
});
</script>

