<!-- Shared cancel utilities -->
<script src="/js/reservation-cancel-utils.js"></script>
<!-- Shared payment breakdown helpers (isomorphic; also require'd by Jest) -->
<script src="/shared/payments/paymentBreakdownHelpers.js"></script>
<!-- Modelo compartido de la lista de servicios: el MISMO archivo que usa el itinerario del cliente
     (ahí vía require, desde su controlador) y que prueba Jest. Existe porque esa lista vivía escrita
     dos veces y divergía sola: el orden difería en 9 de 93 grupos día y el conteo de personas en
     122 de 291 servicios, sin que nadie lo hubiera decidido. -->
<script src="/shared/services/serviceListHelpers.js"></script>
    <script src="/shared/services/serviceListRenderer.js"></script>
    <script src="/shared/services/itineraryExport.js"></script>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    const token = localStorage.getItem('token') || sessionStorage.getItem('token');
    // Read the freshest token at call time: the const above is captured once on page load and can go
    // stale during a long session (token rotation/expiry) → 401 "malformed token" until a hard reload.
    const authToken = () => localStorage.getItem('token') || sessionStorage.getItem('token') || token;
    const reservationId = '<%= reservationId %>';
    // Role from server-side renderRoleView (admin / superadmin / department_manager / client / etc.)
    // Used to gate visibility of internal note channels.
    const userRole = '<%= typeof userRole !== "undefined" ? userRole : "" %>';
    let reservationData = null;
    let employeesCache = null;
    let vehiclesCache = null;


    // Precio base en efectivo de un servicio (0 si está excluido del total). Es el precio de
    // referencia para el desglose Subtotal/recargo -- no se usa para calcular el cobro de
    // otros métodos.
    function getServiceBase(svc) {
        if (svc?.subconcept?.includeInTotal === false) return 0;
        const pbt = svc?.subconcept?.pricesByType;
        if (pbt && typeof pbt === 'object' && pbt.efectivo != null) {
            const v = Number(pbt.efectivo);
            if (!Number.isNaN(v)) return v;
        }
        return Number(svc?.total) || 0;
    }

    // Lógica de cálculo/desglose compartida (pura, probada por Jest) — ver
    // /shared/payments/paymentBreakdownHelpers.js. Wrappers finos para no tocar los call sites.
    function getServicePriceByType(svc, paymentType) {
        return PaymentBreakdownHelpers.getServicePriceByType(svc, paymentType);
    }
    function computeServicesSubtotalByType(services, paymentType) {
        const currency = (reservationData && reservationData.currency) || 'MXN';
        return PaymentBreakdownHelpers.computeServicesSubtotalByType(services, paymentType, currency);
    }

// buildPersonCard se retiró: su último uso era la tarjeta del Customer Support a nivel reservación,
    // que ahora es un avatar con el mismo selector que los servicios. getInitials sigue vivo (svcAvatar).

    // ------------------------------------------------------------------
    // Asignaciones en el formato del itinerario (opción B): chofer y vehículo van EMPAREJADOS
    // porque se leen como una sola cosa —«Juan en la Hiace, placas ABC-12-34»—. En tarjetas o
    // renglones separados la relación quedaba a merced de la adyacencia, y con dos vehículos
    // dejaba de leerse. El segmento (Green Class / Premium) identifica cada unidad.
    //
    // A diferencia del itinerario, aquí se conservan las dos afordancias que el operador ya
    // tenía: la foto se amplía al clic (photo-preview-trigger) y el teléfono es un enlace tel:.
    // También se conserva su vocabulario: "pendiente", no el "por confirmar" del cliente.
    // ------------------------------------------------------------------
    // `vehicleType` guarda normalmente el objectId del catálogo, pero en algunos registros trae el
    // NOMBRE ("SEDAN") en ese campo. Aprovecharlo sirve —el tipo se recupera sin tocar la base—,
    // salvo que un objectId real se colaría a la pantalla como si fuera un modelo de camioneta.
    // Los objectId de Parse son 10 alfanuméricos con mayúsculas y minúsculas mezcladas; ningún
    // nombre del catálogo tiene esa forma (SEDAN, SUBURBAN, JAC Sunray, Van Turística…).
    function vehicleTypeAsName(value) {
        const v = String(value == null ? '' : value).trim();
        if (!v) return '';
        const looksLikeObjectId = /^[A-Za-z0-9]{10}$/.test(v) && /[a-z]/.test(v) && /[A-Z]/.test(v);
        return looksLikeObjectId ? '' : v;
    }










    // Quote statuses — kept as an ORDERED array (lifecycle: cotizada → solicitada →
    // bloqueada → agendada → rechazada) so the dropdown matches the segmented control on
    // the quote detail page.
    const QUOTE_STATUS_ORDER = [
        { key: 'quoted', label: 'Cotizada', cls: 'bg-primary text-white' },
        { key: 'requested', label: 'Solicitada', cls: 'bg-info text-white' },
        { key: 'hold', label: 'Bloqueada', cls: 'bg-warning text-dark' },
        { key: 'scheduled', label: 'Agendada', cls: 'bg-success text-white' },
        { key: 'rejected', label: 'Rechazada', cls: 'bg-danger text-white' },
    ];
    const QUOTE_STATUS_MAP = Object.fromEntries(QUOTE_STATUS_ORDER.map((s) => [s.key, s]));

    function getQuoteStatusBadge(status) {
        if (!status) return '';
        const s = QUOTE_STATUS_MAP[status] || { label: status, cls: 'bg-secondary text-white' };
        const isAdmin = userRole === 'admin' || userRole === 'superadmin';
        // Admin gets a dropdown to change the quote status inline. Other roles see a
        // plain badge.
        if (!isAdmin) {
            return `<span class="badge ${s.cls}" title="Estado de cotización origen">${s.label}</span>`;
        }
        // Same lifecycle lock as the quote detail page: once a quote is scheduled, the
        // admin can't change it away from this dashboard (must go through the quote
        // detail flow to handle cancellation properly).
        const isLocked = status === 'scheduled';
        if (isLocked) {
            return `<span class="badge ${s.cls}" title="Cotización agendada — bloqueada">${s.label}</span>`;
        }
        const options = QUOTE_STATUS_ORDER
            .map((opt) => `<li><button type="button" class="dropdown-item d-flex justify-content-between align-items-center quote-status-option" data-status="${opt.key}">
                    <span>${opt.label}</span>
                    ${opt.key === status ? '<i class="ti ti-check text-success ms-2"></i>' : ''}
                </button></li>`)
            .join('');
        return `<span class="dropdown d-inline-block">
                    <button type="button" class="badge ${s.cls} border-0 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Cambiar estado de cotización">
                        ${s.label}
                    </button>
                    <ul class="dropdown-menu shadow-sm">
                        <li><h6 class="dropdown-header">Cambiar estado de cotización</h6></li>
                        ${options}
                    </ul>
                </span>`;
    }

    // Wires the quote-status dropdown options to the PUT /api/quotes/:id endpoint.
    // Called after the badge is (re)rendered.
    function wireQuoteStatusDropdown() {
        document.querySelectorAll('.quote-status-option').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const newStatus = btn.dataset.status;
                const currentStatus = reservationData?.quoteStatus;
                if (!newStatus || newStatus === currentStatus) return;
                const quoteId = reservationData?.quoteId;
                if (!quoteId) {
                    alert('Cotización no disponible');
                    return;
                }
                const label = QUOTE_STATUS_MAP[newStatus]?.label || newStatus;
                if (!confirm(`¿Cambiar el estado de la cotización a "${label}"?`)) return;
                try {
                    const res = await fetch(`/api/quotes/${quoteId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${authToken()}` },
                        body: JSON.stringify({ status: newStatus, reason: 'Updated from booking detail' }),
                    });
                    const json = await res.json();
                    if (!res.ok || json?.success === false) {
                        throw new Error(json?.error || `HTTP ${res.status}`);
                    }
                    // Refresh local data and re-render the status row.
                    reservationData.quoteStatus = newStatus;
                    const quoteBadge = getQuoteStatusBadge(reservationData.quoteStatus);
                    const reservationBadge = getReservationOverallStatusBadge(reservationData.status);
                    document.getElementById('infoStatus').innerHTML = `${quoteBadge} ${reservationBadge}`;
                    wireQuoteStatusDropdown();
                } catch (err) {
                    console.error('Failed to update quote status', err);
                    alert(`Error al actualizar estado: ${err.message}`);
                }
            });
        });
    }
    


    // Estado GENERAL de la reservación: mismo modelo (y colores) que el segmented
    // control en el detalle de cotización. 'assigned'/'in_progress' = Confirmada
    // (definición del negocio: todo asignado = confirmada). No usar por-servicio.
    function getReservationOverallStatusBadge(status) {
        const map = {
            hold: { label: 'Bloqueado', cls: 'bg-warning text-dark' },
            pending: { label: 'Asignaciones pendientes', cls: 'bg-info text-white' },
            assigned: { label: 'Confirmada', cls: 'bg-primary text-white' },
            in_progress: { label: 'Confirmada', cls: 'bg-primary text-white' },
            confirmed: { label: 'Confirmada', cls: 'bg-primary text-white' },
            completed: { label: 'Finalizada', cls: 'bg-success text-white' },
            cancelled: { label: 'Cancelada', cls: 'bg-danger text-white' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado de la reservación">${s.label}</span>`;
    }

    // Estado de pago — delegado al módulo compartido (mismo PAYMENT_STATUS_MAP en las 3 plantillas).
    function getPaymentStatusBadge(status) {
        return PaymentBreakdownHelpers.getPaymentStatusBadge(status);
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
    }

    // Rango de fechas compacto (es-MX, UTC): mismo día → una sola fecha; mismo mes → "16 → 17 ago
    // 2026"; mismo año → "28 jul → 03 ago 2026"; años distintos → ambas completas.
    function formatDateRange(startStr, endStr) {
        if (!startStr) return '—';
        const start = new Date(startStr);
        if (Number.isNaN(start.getTime())) return '—';
        if (!endStr) return formatDate(startStr);
        const end = new Date(endStr);
        if (Number.isNaN(end.getTime())) return formatDate(startStr);
        // Se formatea día y mes por separado para evitar el guion del locale ("28-jul" → "28 jul").
        const fmt = (dt, o) => dt.toLocaleDateString('es-MX', Object.assign({ timeZone: 'UTC' }, o));
        const day = (dt) => fmt(dt, { day: '2-digit' });
        const dayMonth = (dt) => `${fmt(dt, { day: '2-digit' })} ${fmt(dt, { month: 'short' })}`;
        const full = (dt) => `${dayMonth(dt)} ${fmt(dt, { year: 'numeric' })}`;
        const sameYear = start.getUTCFullYear() === end.getUTCFullYear();
        const sameMonth = sameYear && start.getUTCMonth() === end.getUTCMonth();
        const sameDay = sameMonth && start.getUTCDate() === end.getUTCDate();
        const arrow = ' <span class="bkg-arrow">&rarr;</span> ';
        if (sameDay) return formatDate(startStr);
        if (sameMonth) return `${day(start)}${arrow}${full(end)}`;
        if (sameYear) return `${dayMonth(start)}${arrow}${full(end)}`;
        return `${full(start)}${arrow}${full(end)}`;
    }

    function formatCurrency(amount, currency) {
        const sym = currency === 'USD' ? 'USD $' : '$';
        return `${sym}${(amount || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    // Live thousands-separator for amount text inputs: groups the integer part with commas while
    // typing (100000 -> 100,000), keeps up to 2 decimals, and preserves the caret position.
    function formatThousandsInput(el) {
        const raw = el.value;
        const caret = el.selectionStart || 0;
        const digitsBeforeCaret = (raw.slice(0, caret).match(/\d/g) || []).length;
        let clean = raw.replace(/[^\d.]/g, '');
        const dot = clean.indexOf('.');
        if (dot !== -1) clean = clean.slice(0, dot + 1) + clean.slice(dot + 1).replace(/\./g, '');
        let [intPart = '', decPart] = clean.split('.');
        intPart = intPart.replace(/^0+(?=\d)/, '');
        const grouped = intPart ? Number(intPart).toLocaleString('en-US') : '';
        let out = grouped;
        if (decPart !== undefined) out += `.${decPart.slice(0, 2)}`;
        el.value = out;
        // Restore the caret after the same number of digits it was before reformatting.
        let pos = 0;
        let seen = 0;
        while (pos < out.length && seen < digitsBeforeCaret) {
            if (/\d/.test(out[pos])) seen += 1;
            pos += 1;
        }
        el.setSelectionRange(pos, pos);
    }

    // Attach live thousands formatting to a text amount input and format its initial value.
    function attachThousands(el) {
        if (!el) return;
        el.addEventListener('input', () => formatThousandsInput(el));
        if (el.value) formatThousandsInput(el);
    }

    // Parse an amount that may carry thousands separators ("1,234.56" -> 1234.56).
    function parseAmount(value) {
        return parseFloat(String(value == null ? '' : value).replace(/,/g, ''));
    }

    function getServiceTypeIcon(type) {
        const icons = {
            transport: 'ti-car',
            tour: 'ti-map-pin',
            // `ti-sparkles` no existe en este icon font (verificado contra los 3000 del CSS): pintaba
            // una caja vacía para toda experiencia. `ti-stars` sí, y es el mismo sentido.
            experience: 'ti-stars',
            concepto: 'ti-tag',
            'a-disposicion': 'ti-clock',
        };
        return icons[type] || 'ti-point';
    }













    function getServiceTypeLabel(type) {
        const labels = {
            transport: 'Transporte',
            tour: 'Tour',
            experience: 'Experiencia',
            concepto: 'Concepto',
            'a-disposicion': 'A Disposición',
        };
        return labels[type] || type || '';
    }


    function getRoleBadge(role, displayRole) {
        const r = displayRole || role || '';
        const map = {
            driver: { label: 'Conductor', cls: 'bg-info-subtle text-info' },
            guia: { label: 'Guia', cls: 'bg-success-subtle text-success' },
            greeter: { label: 'Greeter', cls: 'bg-warning-subtle text-warning' },
            employee_amexing: { label: 'Amexing', cls: 'bg-primary-subtle text-primary' },
            limpieza: { label: 'Limpieza', cls: 'bg-secondary-subtle text-secondary' },
            admin: { label: 'Admin', cls: 'bg-danger-subtle text-danger' },
        };
        const s = map[r] || map[role] || { label: r || 'N/A', cls: 'bg-secondary-subtle text-secondary' };
        return `<span class="badge ${s.cls}" style="font-size:0.65rem;">${s.label}</span>`;
    }

    // Failure modes are kept DISTINCT so the message points at the real cause instead of a
    // single opaque "Error al cargar": (1) network/HTTP or API success:false vs (2) an
    // exception thrown while rendering valid data. Both are logged with detail to the console.
    async function loadReservation() {
        let result;
        try {
            const response = await fetch(`/api/reservations/${reservationId}`, {
                headers: { 'Authorization': `Bearer ${authToken()}` }
            });
            result = await response.json().catch(() => null);
            if (!response.ok || !result || !result.success) {
                const reason = (result && result.error) ? result.error : `HTTP ${response.status}`;
                console.error('Error loading reservation:', reason, result);
                document.getElementById('loadingState').innerHTML = `<p class="text-danger">Error al cargar la reservacion (${reason})</p>`;
                return;
            }
        } catch (error) {
            console.error('Error loading reservation (red):', error);
            document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al cargar la reservacion (sin conexion)</p>';
            return;
        }

        // Render separately: a render-time exception (unexpected/malformed data) is reported
        // distinctly from a fetch/API failure, and no longer masquerades as "no se pudo cargar".
        try {
            reservationData = result.data;
            renderReservation();
        } catch (error) {
            console.error('Error rendering reservation:', error);
            // #loadingState queda en display:none desde la primera carga, así que escribir SOLO ahí
            // volvía invisible cualquier fallo de render posterior: la lista vieja se quedaba en
            // pantalla y parecía que la acción no había hecho nada. El toast sí se ve siempre.
            document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al mostrar la reservacion. Revisa la consola para el detalle.</p>';
            pmToast('No se pudo actualizar la vista. Recarga la página; el guardado sí se hizo.', 'warning');
        }
    }

    function renderReservation() {
        const d = reservationData;

        document.getElementById('breadcrumbFolio').textContent = d.folio;
        document.getElementById('pageTitle').innerHTML = `<i class="ti ti-clipboard-list me-2 text-primary"></i>${d.folio}`;

        const quoteLink = document.getElementById('infoQuoteLink');
        if (d.quoteId) {
            // Abrimos desde una reservación → activamos la bandera de contexto para que
            // el detalle muestre títulos/estado como "Reservación".
            quoteLink.href = `/dashboard/admin/quotes/${d.quoteId}?context=reservation`;
            quoteLink.textContent = d.quoteFolio;
        }

        const quoteBadge = getQuoteStatusBadge(d.quoteStatus);
        const reservationBadge = getReservationOverallStatusBadge(d.status);
        document.getElementById('infoStatus').innerHTML = `${quoteBadge} ${reservationBadge}`;
        wireQuoteStatusDropdown();
        // Display company name first, then fallback to fullName or contactPerson
        const clientDisplay = d.client?.companyName || d.client?.fullName || d.contactPerson || '—';
        document.getElementById('infoClient').textContent = clientDisplay;
        // Contacto: nombre (si existe) + email + teléfono, cada uno en su línea y solo si viene.
        const contactName = (d.contactPerson
            || `${d.contactFirstName || ''} ${d.contactLastName || ''}`.trim()).trim();
        const contactLines = [];
        // Cuando el cliente es persona fisica, "Cliente" y "Contacto" traen el MISMO nombre y la
        // tarjeta lo decia dos veces en la misma linea de lectura. Si coinciden, Contacto se queda
        // solo con lo que Cliente no dice: correo y telefono.
        if (contactName && contactName !== clientDisplay) {
            contactLines.push(`<span class="fw-semibold">${PaymentBreakdownHelpers.escapeHtml(contactName)}</span>`);
        }
        if (d.contactEmail) contactLines.push(PaymentBreakdownHelpers.escapeHtml(d.contactEmail));
        if (d.contactPhone) contactLines.push(PaymentBreakdownHelpers.escapeHtml(d.contactPhone));
        document.getElementById('infoContact').innerHTML = contactLines.length ? contactLines.join('<br>') : '&mdash;';
        document.getElementById('infoEventType').textContent = d.eventType || '—';
        // Pasajero: lead guest si existe, y si no el contacto —muchas reservaciones traen al viajero
        // real en los campos de contacto—. Encabeza el panel solo cuando no hay fechas.
        const leadGuestParts = [d.leadGuestFirstName, d.leadGuestLastName]
            .map((p) => (p || '').trim())
            .filter(Boolean);
        const leadGuestName = leadGuestParts.length > 0
            ? leadGuestParts.join(' ')
            : (d.contactPerson || '').trim();
        // El panel se encabeza con el rango de fechas: es lo que identifica un itinerario y lo que
        // mas veces existe. Sobre las 77 reservaciones de la base: 63 traen fechas, 45 traen pasajero
        // (solo 6 un lead guest de verdad; el resto cae al contacto) y 13 no traen ninguno de los dos.
        // De ahi la cascada fecha -> pasajero -> "Servicios": el rotulo generico deja de ser el titulo
        // de siempre y pasa a ser el ultimo recurso, el unico caso en que no hay dato que poner.
        const rango = (d.startDate ? formatDateRange(d.startDate, d.endDate) : '').trim();
        const tituloEl = document.getElementById('docTitulo');
        const icono = rango ? 'ti-calendar-event' : leadGuestName ? 'ti-user' : 'ti-list-details';
        tituloEl.innerHTML = `<i class="ti ${icono} svc-doc-icono"></i>`
            + (rango || (leadGuestName ? PaymentBreakdownHelpers.escapeHtml(leadGuestName) : 'Servicios'));

        // Duración (noches) = diferencia en días; se omite en reservaciones de un solo día.
        let noches = '';
        if (d.startDate && d.endDate) {
            const n = Math.max(0, Math.round((new Date(d.endDate) - new Date(d.startDate)) / 86400000));
            noches = n <= 0 ? '' : (n === 1 ? '1 noche' : `${n} noches`);
        }
        const personas = Number(d.numberOfPeople) || 0;
        // Se arma la lista y se une con separadores, en vez de spans fijos: asi un dato que falta no
        // deja su "·" colgando. El pasajero solo baja aqui si NO es ya el titulo.
        const meta = [
            noches ? `<span class="svc-doc-menor">${noches}</span>` : '',
            personas ? `${personas} ${personas === 1 ? 'persona' : 'personas'}` : '',
        ].filter(Boolean);
        document.getElementById('docMeta').innerHTML = meta.join('<span class="svc-doc-sep">·</span>');

        // El pasajero va en su propio renglon, no perdido entre las noches y las personas: es QUIEN
        // viaja, no un dato mas de la ficha. Solo aparece aqui cuando el titulo son las fechas; si el
        // titulo ya es el, no se dice dos veces.
        const paxEl = document.getElementById('docPax');
        paxEl.classList.toggle('d-none', !(rango && leadGuestName));
        if (rango && leadGuestName) {
            paxEl.innerHTML = `<i class="ti ti-user svc-doc-pax-icono"></i>`
                + PaymentBreakdownHelpers.escapeHtml(leadGuestName);
        }

        // Notas de la cotización: mismo bloque de siempre, al pie de la tarjeta de arriba.
        const quoteNotesRow = document.getElementById('infoQuoteNotesRow');
        const quoteNotesEl = document.getElementById('infoQuoteNotes');
        const quoteNotesText = (d.notes || '').trim();
        if (quoteNotesText && quoteNotesEl && quoteNotesRow) {
            quoteNotesEl.textContent = quoteNotesText;
            quoteNotesRow.classList.remove('d-none');
        }

        // Tipo de Pago y Total se movieron fuera de este encabezado: el Tipo de Pago ahora se
        // muestra dentro del "Resumen Financiero" (renderFinancialSummary), donde también vive el
        // Total; así el encabezado queda solo con datos generales.

        // Assignment counter
        const totalSvc = (d.services || []).length;
        // Los servicios 'concepto' no requieren asignación → cuentan como asignados.
        const assignedSvc = (d.services || []).filter(s => s.status === 'assigned' || s.status === 'completed' || s.type === 'concepto').length;
        const completedSvc = (d.services || []).filter(s => s.status === 'completed').length;
        const counterEl = document.getElementById('docAssignCounter');
        // Color del avance por estado (coincide con la barra de progreso de abajo).
        const assignColor = completedSvc === totalSvc ? '#4b6b3f'
            : assignedSvc === totalSvc ? '#6E7A50'
                : assignedSvc > 0 ? '#b8894a' : '#8a8f78';
        if (totalSvc > 0) {
            // El rótulo de arriba ya dice "Asignación", así que la cifra no lo repite.
            counterEl.innerHTML = `<span style="color:${assignColor}">${assignedSvc}</span>`
                + `<span style="color:#8a8f78"> / ${totalSvc}</span>`
                + ((completedSvc > 0) ? `<span class="svc-doc-menor"> · ${completedSvc} completados</span>` : '');
        } else {
            counterEl.textContent = '';
        }
        // Barra de progreso de asignación (avance = asignados / total).
        const progWrap = document.getElementById('docAssignProgress');
        const progBar = document.getElementById('docAssignBar');
        if (progWrap && progBar && totalSvc > 0) {
            const pct = Math.round((assignedSvc / totalSvc) * 100);
            progBar.style.width = `${pct}%`;
            progBar.style.background = assignColor;
            progWrap.classList.remove('d-none');
        } else if (progWrap) {
            progWrap.classList.add('d-none');
        }

        const scEl = document.getElementById('infoServiceCustomer');
        // Mismo selector que los círculos de los servicios, con su propia clase de plaza: el chip ya
        // dice "Customer Support" arriba, así que el renglón no repite el rótulo.
        const scPerson = d.serviceCustomer || null;
        const scCanAssign = d.status !== 'cancelled' && d.status !== 'completed';
        const scPick = svcPickAttrs({ serviceId: '', canAssign: scCanAssign }, {
            'slot-kind': 'res-support',
            'role-label': 'Customer Support',
            'role-pool': 'admins',
            'current-id': scPerson ? scPerson.id : '',
        }, `${scPerson ? 'Cambiar' : 'Asignar'} Customer Support`);
        scEl.innerHTML = `<span class="bkg-cs-row">${
            scPerson ? svcAvatar(scPerson, scPick, 'is-sm') : svcPendingAvatar('user', scPick)
        }<span>${scPerson
            ? PaymentBreakdownHelpers.escapeHtml(scPerson.fullName) + svcTelLink(scPerson.phone)
            : 'Sin asignar'}</span></span>`;

        const canAssign = scCanAssign;

        const actions = document.getElementById('headerActions');
        const folio = encodeURIComponent(d.folio || '');
        // Las dos exportaciones van juntas en un control segmentado: son la misma acción con dos
        // variantes, así que "Exportar" queda implícito en el grupo y cada botón solo nombra el
        // documento. El aria-label/title conserva la frase completa para lector de pantalla y hover.
        // El contrato es un placeholder: la vista/ruta aún no existe; se cablea después.
        const exportSegHtml = folio
            ? `<span class="hdr-seg" role="group" aria-label="Exportar">
                <a class="hdr-seg-btn" href="/reservations/${folio}" target="_blank" rel="noopener"
                   title="Exportar confirmación — abre la vista pública, exportable a PDF"
                   aria-label="Exportar confirmación"><i class="ti ti-file-export"></i>Confirmación</a>
                <button type="button" class="hdr-seg-btn" id="exportContractBtn"
                   title="Exportar contrato de servicio — próximamente"
                   aria-label="Exportar contrato de servicio" disabled><i class="ti ti-file-text"></i>Contrato</button>
              </span>`
            : '';
        // En vez del botón de cancelar: si ya está cancelada, mostrar etiqueta
        // "Cancelada"; si tiene una solicitud de cancelación pendiente, mostrar
        // "Pendiente de cancelación" (evita además crear solicitudes duplicadas).
        let cancelBtnHtml = '';
        if (d.status === 'cancelled') {
            cancelBtnHtml = `<span class="badge bg-danger text-white"><i class="ti ti-x me-1"></i>Cancelada</span>`;
        } else if (d.hasPendingCancellation) {
            cancelBtnHtml = `<span class="badge bg-warning text-dark border border-danger-subtle" title="Tiene una solicitud de cancelación pendiente de aprobación"><i class="ti ti-clock me-1"></i>Pendiente de cancelación</span>`;
        } else if (canAssign) {
            cancelBtnHtml = `<button type="button" class="hdr-danger" id="cancelResBtn"><i class="ti ti-x"></i>Cancelar reservación</button>`;
        }
        actions.innerHTML = `<div class="d-flex gap-2 align-items-center">${exportSegHtml}${cancelBtnHtml}</div>`;
        // Los dos botones del itinerario los cablea ItineraryExport, compartido con los detalles de
        // client, department_manager y end_client: la descarga por fetch con su indicador de progreso
        // es la misma en las cuatro.
        ItineraryExport.wire({ folio, alFallar: (msg) => pmToast(msg, 'warning') });
        // El listener solo aplica cuando se renderizó el botón (no en las etiquetas).
        document.getElementById('cancelResBtn')?.addEventListener('click', () => {
            // Use shared utility with existing reservation data and loadReservation callback
            openReservationCancelModalWithData(reservationData, loadReservation);
        });

        renderServices(d.services);
        renderFinancialSummary();
        renderPaymentBar();
        loadPayments();

        document.getElementById('loadingState').style.display = 'none';
        document.getElementById('reservationContent').style.display = '';
    }

    // Round a HH:MM string DOWN to the previous 15-minute mark — same strategy used
    // in the quote services list so timestamps stay consistent across views.
    function roundTimeToNearest15(timeStr) {
        return ServiceListHelpers.roundDownTo15(timeStr);
    }





    // El control de estado tiene UNA intención: declarar que el servicio ya se operó. Antes era un
    // ciclo de tres posiciones (pending → assigned → completed → assigned) y las otras dos sobraban:
    //
    //   - `assigned` lo pone el API solo, en cuanto se asigna un chofer. Ponerlo a mano no asignaba a
    //     nadie, solo cambiaba la etiqueta —y el endpoint valida que la cadena esté en una lista, no
    //     que corresponda a la realidad. En la base quedaron 3 servicios "assigned" y 1 "completed"
    //     SIN chofer, que es exactamente eso.
    //   - "Marcar completada" no se puede deducir de nada, así que es la única que necesita un humano.
    //
    // Se disponible en cualquier estado no completado, y NO condicionado a `assigned`: un walking tour
    // nunca tiene chofer, así que se quedaría en `pending` para siempre sin poder marcarse como operado.
    // La lista la arma ServiceListRenderer; aquí solo se decide DÓNDE va y qué queda enganchado.
    // El módulo devuelve una cadena y no se suscribe a nada, así que el botón de estatus —que solo
    // existe en esta vista— se enlaza desde afuera.
    function renderServices(services) {
        const container = document.getElementById('servicesContainer');
        container.innerHTML = ServiceListRenderer.buildHtml(services, {
            reservationData,
            formatCurrency,
            allowAssign: true,
        });
        container.querySelectorAll('.status-toggle-btn').forEach(btn => {
            btn.addEventListener('click', () => toggleServiceStatus(btn));
        });
    }

    // El chip de Customer Support del ENCABEZADO reusa los círculos de la lista: es el mismo control
    // y debe verse igual. Envoltorios delgados en vez de llamar al módulo por su nombre completo en
    // cada punto, que es como estaban antes de la extracción.
    function svcAvatar(...args) { return ServiceListRenderer.svcAvatar(...args); }
    function svcPendingAvatar(...args) { return ServiceListRenderer.svcPendingAvatar(...args); }
    function svcPickAttrs(...args) { return ServiceListRenderer.svcPickAttrs(...args); }
    function svcTelLink(...args) { return ServiceListRenderer.svcTelLink(...args); }

    // Una sola puerta al carrito. Eran dos —"Ver desglose" y "Agregar pago"— que abrían el MISMO
    // panel; la única diferencia era que la segunda además desplegaba el formulario. Dos botones
    // contiguos con el mismo destino se leen como una decisión que no existe, y lo que la barra ya
    // muestra —saldo, avance, pagado de total, método y estado— es justo lo que se iba a "ver".
    // ¿Hay algo que comparar? Sin filas el chip del método no se ofrece como botón.
    function hayComparativo() {
        const cmp = document.getElementById('payCmp');
        return Boolean(cmp && cmp.children.length);
    }

    // El chip del método abre y cierra el comparativo. Se cablea por delegación porque el chip lo
    // vuelve a escribir buildCoverageCard en cada render del carrito.
    document.getElementById('paymentsOffcanvas')?.addEventListener('click', (e) => {
        const chip = e.target.closest('[data-cmp-toggle]');
        if (!chip) return;
        const sec = document.getElementById('payCmpSec');
        if (!sec) return;
        bootstrap.Collapse.getOrCreateInstance(sec, { toggle: false }).toggle();
        chip.setAttribute('aria-expanded', String(!sec.classList.contains('show')));
    });

    document.getElementById('payBarPagarBtn')?.addEventListener('click', () => {
        paymentsOffcanvasInstance()?.show();
    });

    async function toggleServiceStatus(btn) {
        const serviceId = btn.dataset.serviceId;
        const newStatus = btn.dataset.nextStatus;
        if (!serviceId || !newStatus) return;

        // Completar afirma un hecho del mundo real y no tenía confirmación de ningún tipo. Revertir no
        // la pide: es reversible por definición.
        if (newStatus === 'completed') {
            const ok = await pmConfirm({
                title: 'Marcar como completada',
                message: `¿Confirmas que "${btn.dataset.serviceName || 'este servicio'}" ya se operó?`,
                confirmText: 'Sí, ya se operó',
                icon: 'ti-circle-check',
            });
            if (!ok) return;
        }

        btn.disabled = true;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/services/${serviceId}/status`, {
                method: 'PATCH',
                headers: { 'Authorization': `Bearer ${authToken()}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus }),
            });
            const result = await response.json();
            if (result.success) {
                await loadReservation();
            } else {
                pmToast(result.error || 'No se pudo actualizar el estado', 'warning');
                btn.disabled = false;
            }
        } catch (err) {
            console.error('Status toggle error:', err);
            pmToast('No se pudo actualizar el estado', 'warning');
            btn.disabled = false;
        }
        btn.disabled = false;
    }

    async function loadEmployees() {
        if (employeesCache) return employeesCache;
        try {
            const response = await fetch('/api/employees?limit=500', {
                headers: { 'Authorization': `Bearer ${authToken()}` }
            });
            const result = await response.json();
            employeesCache = result.data?.users || result.data || result.results || [];
            return employeesCache;
        } catch { return []; }
    }

    async function loadVehicles() {
        if (vehiclesCache) return vehiclesCache;
        try {
            const response = await fetch('/api/vehicles?limit=500', {
                headers: { 'Authorization': `Bearer ${authToken()}` }
            });
            const result = await response.json();
            vehiclesCache = result.data || result.results || [];
            return vehiclesCache;
        } catch { return []; }
    }

    const roleTranslations = {
        'driver': 'Conductor',
        'conductor': 'Conductor',
        'guia': 'Guía',
        'guide': 'Guía',
        'greeter': 'Greeter',
        'employee_amexing': 'Amexing',
        'limpieza': 'Limpieza',
        'admin': 'Admin'
    };

    function translateRole(role) {
        if (!role) return '';
        return roleTranslations[role.toLowerCase()] || role;
    }

    // -----------------------------------------------------------------------
    // Asignar desde el renglón
    //
    // Cada renglón de asignación es un punto de entrada: un clic abre un selector con búsqueda,
    // filtrado por rol y —en vehículos— ordenado por el TIPO que pide esa plaza. Eso último el modal
    // no lo hace: ofrece los 9 vehículos aunque la plaza pida SUBURBAN. No se ocultan los otros
    // tipos, solo van después, bajo su propio encabezado.
    //
    // El modal SIGUE siendo el camino completo: un rol no contratado (includeGuide en falso) no
    // dibuja renglón, así que no habría dónde hacer clic para agregarlo. Esto es el atajo.
    //
    // El guardado manda SOLO el campo que cambió. El endpoint protege cada campo con
    // `if (x !== undefined)`, así que asignar un chofer ya no reescribe guía, greeter ni Customer
    // Support: dos personas trabajando plazas distintas del mismo servicio dejan de pisarse. Las
    // plazas extra son la excepción —extraAssignments se persiste como arreglo completo—, así que
    // ahí se relee el estado fresco del servidor justo antes de mandar.
    // -----------------------------------------------------------------------
    let assignPopSlot = null;

    function closeAssignPop() {
        document.getElementById('assignPop')?.classList.add('d-none');
        assignPopSlot = null;
        assignOptTaken = false;
        // Recarga que se postergó por tener el selector abierto (ver flushAssignReload).
        if (assignNeedsReload && assignPending === 0) {
            assignNeedsReload = false;
            loadReservation()
                .catch((err) => {
                    console.error('Deferred reload failed:', err);
                    pmToast('No se pudo refrescar la lista. Recarga la página; el guardado sí se hizo.', 'warning');
                })
                .then(clearAssignSpinners);
        }
    }

    // Coordenadas del viewport tal cual (el panel es `fixed`). Si no cabe abajo, abre hacia arriba.
    function positionAssignPop(pop, anchor) {
        const r = anchor.getBoundingClientRect();
        const vw = document.documentElement.clientWidth;
        const vh = document.documentElement.clientHeight;
        const w = pop.offsetWidth || 320;
        const h = pop.offsetHeight || 260;
        pop.style.left = `${Math.max(12, Math.min(r.left, vw - w - 12))}px`;
        const below = r.bottom + 6;
        pop.style.top = `${below + h > vh - 12 && r.top - h - 6 > 12 ? r.top - h - 6 : Math.min(below, Math.max(12, vh - h - 12))}px`;
    }

    // El renglón se mueve con el scroll de su contenedor pero el panel es fixed, así que hay que
    // reposicionarlo. `capture: true` para atrapar el scroll de cualquier contenedor, no solo la
    // ventana. Si el renglón se salió de vista, se cierra.
    function repositionAssignPopOnScroll() {
        if (!assignPopSlot || !assignPopSlot.anchor) return;
        const pop = document.getElementById('assignPop');
        if (!pop || pop.classList.contains('d-none')) return;
        const r = assignPopSlot.anchor.getBoundingClientRect();
        if (r.bottom < 0 || r.top > document.documentElement.clientHeight) { closeAssignPop(); return; }
        positionAssignPop(pop, assignPopSlot.anchor);
    }
    document.addEventListener('scroll', repositionAssignPopOnScroll, { capture: true, passive: true });
    window.addEventListener('resize', repositionAssignPopOnScroll);

    function assignPopOption(kind, value, name, sub, isCurrent) {
        const esc = PaymentBreakdownHelpers.escapeHtml;
        return `<button type="button" class="assign-pop-opt${isCurrent ? ' is-current' : ''}"
            data-kind="${esc(kind)}" data-value="${esc(value)}" data-name="${esc(name)}">
            <span>${esc(name)}${sub ? `<span class="sub"> · ${esc(sub)}</span>` : ''}</span>
            ${isCurrent ? '<i class="ti ti-check tick"></i>' : ''}</button>`;
    }

    // Vaciar el campo no siempre significa "nadie": en Customer Support significa volver al de la
    // reservación, y decirlo así es la diferencia entre entender la acción y adivinarla.
    function assignPopClearOption(kind, hasCurrent, inheritLabel) {
        if (!hasCurrent) return '';
        const esc = PaymentBreakdownHelpers.escapeHtml;
        const label = inheritLabel
            ? `Usar el de la reservación (${esc(inheritLabel)})`
            : 'Quitar asignación';
        return `<button type="button" class="assign-pop-opt is-clear" data-kind="${kind}" data-value="" data-name="">
            <i class="ti ti-${inheritLabel ? 'arrow-back-up' : 'x'}"></i><span>${label}</span></button>`;
    }

    function assignPopPeopleGroup(label, kind, people, currentId, inheritLabel) {
        if (!people.length) return `<div class="assign-pop-grp">${label}</div><div class="assign-pop-empty">Sin candidatos</div>`;
        const roleOf = (e) => (Array.isArray(e.futureRoles) && e.futureRoles.length
            ? e.futureRoles.map((r) => translateRole(r)).join(', ')
            : translateRole(e.displayRole || e.role || ''));
        return `<div class="assign-pop-grp">${label}</div>`
            + assignPopClearOption(kind, !!currentId, inheritLabel)
            + people.map((e) => assignPopOption(kind, e.id || e.objectId, employeeName(e), roleOf(e),
                (e.id || e.objectId) === currentId)).join('');
    }

    function assignPopVehicleGroup(vehicles, expectedType, currentId) {
        const label = (v) => `${v.brand || ''} ${v.model || ''}`.trim() || v.licensePlate || 'Vehículo';
        const sub = (v) => [v.licensePlate, v.capacity ? `${v.capacity} pax` : ''].filter(Boolean).join(' · ');
        const typeOf = (v) => (v.vehicleTypeId && v.vehicleTypeId.name) || '';
        const match = expectedType ? vehicles.filter((v) => typeOf(v) === expectedType) : vehicles;
        const rest = expectedType ? vehicles.filter((v) => typeOf(v) !== expectedType) : [];
        const render = (list) => list.map((v) => assignPopOption('vehicle', v.id || v.objectId,
            label(v), sub(v), (v.id || v.objectId) === currentId)).join('');
        let html = `<div class="assign-pop-grp">Vehículo${expectedType ? ` · ${PaymentBreakdownHelpers.escapeHtml(expectedType)}` : ''}</div>`;
        html += assignPopClearOption('vehicle', !!currentId);
        html += match.length ? render(match) : '<div class="assign-pop-empty">Ningún vehículo de ese tipo</div>';
        if (rest.length) html += `<div class="assign-pop-grp">Otros tipos</div>${render(rest)}`;
        return html;
    }

    async function openAssignPop(row) {
        const pop = document.getElementById('assignPop');
        const body = document.getElementById('assignPopBody');
        const search = document.getElementById('assignPopSearch');
        assignPopSlot = { ...row.dataset, anchor: row };
        assignOptTaken = false;
        // Al body: `.dashboard-content` tiene overflow-y y recortaría el panel dentro de su caja.
        if (pop.parentElement !== document.body) document.body.appendChild(pop);

        const ttl = { driver: 'Chofer', vehicle: 'Vehículo' }[row.dataset.slotKind]
            || row.dataset.roleLabel || 'Asignar';
        document.getElementById('assignPopTitle').textContent = row.dataset.slotLabel
            ? `${ttl} · ${row.dataset.slotLabel}`
            : ttl;
        body.innerHTML = '<div class="assign-pop-loading">Cargando…</div>';
        search.value = '';
        pop.classList.remove('d-none');
        positionAssignPop(pop, row);

        const [employees, vehicles] = await Promise.all([loadEmployees(), loadVehicles()]);
        // Otro renglón pudo abrirse mientras cargaba.
        if (!assignPopSlot || assignPopSlot.serviceId !== row.dataset.serviceId) return;
        const pools = employeePools(employees);
        const ds = row.dataset;

        // Un solo grupo por selector: el círculo que se tocó dice exactamente qué se está eligiendo.
        let html = '';
        if (ds.slotKind === 'res-support') {
            html = assignPopPeopleGroup('Customer Support de la reservación', 'role',
                pools.admins, ds.currentId || '');
        } else if (ds.slotKind === 'driver') {
            html = assignPopPeopleGroup('Chofer', 'driver', pools.drivers, ds.currentId || '');
        } else if (ds.slotKind === 'vehicle') {
            html = assignPopVehicleGroup(vehicles, ds.expectedType || '', ds.currentId || '');
        } else {
            html = assignPopPeopleGroup(ds.roleLabel || 'Persona', 'role',
                pools[ds.rolePool] || pools.all, ds.currentId || '', ds.inheritLabel || '');
        }
        if (body) body.innerHTML = html;
        positionAssignPop(pop, row);
        search.focus();
    }

    // Relee el arreglo de extras del servidor: extraAssignments se persiste completo, así que
    // escribirlo con una copia vieja borraría lo que otro haya asignado mientras.
    async function fetchServiceExtras(serviceId) {
        try {
            const r = await fetch(`/api/reservations/${reservationId}`, {
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            if (!r.ok) return null;
            const j = await r.json();
            const svc = (j.data?.services || []).find((x) => x.id === serviceId);
            // Distinguir "no encontré el servicio" de "el servicio no tiene extras" es crítico: este
            // arreglo se persiste COMPLETO, así que devolver [] ante una respuesta inesperada haría
            // que el guardado siguiente borrara todas las asignaciones extra sin que nadie se entere.
            // null aborta el guardado y avisa; [] solo cuando de verdad no hay ninguna.
            if (!svc) return null;
            return Array.isArray(svc.extraAssignments) ? svc.extraAssignments : [];
        } catch { return null; }
    }

    // -------------------------------------------------------------------
    // Cola de guardados
    //
    // Al elegir una opción el panel se cierra al instante y la espera se muestra en el círculo, así
    // que se pueden encolar varias asignaciones seguidas. La cola las SERIALIZA por dos razones:
    //
    //   1. Las plazas extra se persisten como `extraAssignments` COMPLETO. Dos guardados a la vez
    //      sobre el mismo servicio leerían el arreglo antes de que el otro escribiera, y el segundo
    //      borraría el primero.
    //   2. La lista se vuelve a pintar UNA vez, cuando la cola se vacía, en vez de una por selección.
    //
    // Si queda un selector abierto al vaciarse, la recarga se posterga hasta cerrarlo: repintar
    // borraría los círculos que el usuario tiene debajo del cursor.
    // -------------------------------------------------------------------
    let assignQueue = Promise.resolve();
    let assignPending = 0;
    let assignNeedsReload = false;
    let assignOptTaken = false;

    // Los círculos que están girando. Se llevan en un conjunto para poder apagarlos TODOS cuando la
    // lista se repinta —o cuando la recarga falla—, en vez de apagar cada uno al terminar su tarea.
    const assignSpinners = new Set();

    function clearAssignSpinners() {
        assignSpinners.forEach((el) => unmarkAvatarSaving(el));
        assignSpinners.clear();
    }

    function markAvatarSaving(el) {
        if (!el) return;
        assignSpinners.add(el);
        el.classList.add('is-saving');
        el.insertAdjacentHTML('beforeend',
            '<span class="svc-av-busy"><span class="spinner-border spinner-border-sm" style="width:1rem;height:1rem;border-width:.14em;"></span></span>');
    }

    function unmarkAvatarSaving(el) {
        if (!el) return;
        assignSpinners.delete(el);
        el.classList.remove('is-saving');
        el.querySelector('.svc-av-busy')?.remove();
    }

    function assignPopIsOpen() {
        const pop = document.getElementById('assignPop');
        return !!pop && !pop.classList.contains('d-none');
    }

    async function flushAssignReload() {
        if (assignPending > 0) return;
        if (assignPopIsOpen()) { assignNeedsReload = true; return; }
        assignNeedsReload = false;
        try {
            await loadReservation();
        } catch (err) {
            console.error('Reload after assignment failed:', err);
            pmToast('No se pudo refrescar la lista. Recarga la página; el guardado sí se hizo.', 'warning');
        }
        // Se haya repintado o no, ningún círculo puede quedar girando. Si repintó, estos nodos ya
        // están fuera del DOM y apagarlos no cuesta nada; si falló, evita spinners eternos.
        clearAssignSpinners();
    }

    // Arma el payload de UNA asignación. Devuelve null si no hay nada que mandar.
    async function buildAssignPayload(slot, value, name) {
        if (slot.slotKind === 'role') return { [slot.roleField]: value };
        if (slot.extraIndex === undefined || slot.extraIndex === '') {
            return slot.slotKind === 'driver' ? { driverId: value } : { vehicleId: value };
        }
        const idx = Number(slot.extraIndex);
        // Se relee AQUÍ, ya dentro de la cola, para que traiga lo que escribió el guardado anterior.
        const fresh = await fetchServiceExtras(slot.serviceId);
        if (fresh === null) return null;
        const arr = fresh.map((e) => ({ ...e }));
        while (arr.length <= idx) arr.push({ driverId: '', vehicleId: '', driverName: '', vehicleName: '' });
        if (slot.slotKind === 'driver') {
            arr[idx].driverId = value;
            arr[idx].driverName = value ? name : '';
        } else {
            arr[idx].vehicleId = value;
            arr[idx].vehicleName = value ? name : '';
        }
        return { extraAssignments: arr };
    }

    async function runAssignTask(slot, value, name, anchor) {
        try {
            // El Customer Support de la RESERVACIÓN vive en otro endpoint: no es una asignación por
            // servicio, es el global del que heredan todos.
            const isReservationLevel = slot.slotKind === 'res-support';
            const payload = isReservationLevel
                ? { serviceCustomerId: value }
                : await buildAssignPayload(slot, value, name);
            if (payload === null) {
                unmarkAvatarSaving(anchor);
                alert('No se pudo leer el estado actual del servicio. Intenta de nuevo.');
                return;
            }
            const url = isReservationLevel
                ? `/api/reservations/${reservationId}/service-customer`
                : `/api/reservations/${reservationId}/services/${slot.serviceId}/assign`;
            const response = await fetch(url, {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });
            const result = await response.json();
            if (!response.ok || result.success === false) {
                unmarkAvatarSaving(anchor);
                alert(result.error || 'No se pudo guardar la asignación');
            }
        } catch (e) {
            unmarkAvatarSaving(anchor);
            alert('No se pudo guardar la asignación');
        }
        // OJO: en el camino feliz el spinner NO se quita aquí. Quitarlo al terminar cada tarea dejaba
        // ver el avatar viejo —punteado— hasta que la lista se repintara al vaciarse la cola, y ese
        // instante se lee como "no se asignó". Dejándolo girando, el círculo pasa de girando a
        // asignado sin pasar por vacío. Los apaga clearAssignSpinners cuando la lista ya se repintó.
    }

    function enqueueSlotAssignment(opt) {
        const slot = assignPopSlot;
        // Una sola opción por apertura: un doble clic rápido alcanza a disparar dos eventos antes de
        // que el panel se oculte.
        if (!slot || assignOptTaken) return;
        assignOptTaken = true;

        const value = opt.dataset.value || '';
        const name = opt.dataset.name || '';
        const anchor = slot.anchor;
        const payloadSlot = { ...slot };
        delete payloadSlot.anchor;

        // ORDEN: primero se contabiliza el pendiente y se marca el círculo, y hasta después se cierra
        // el panel. Al revés, `closeAssignPop` veía `assignPending === 0` y disparaba la recarga que
        // estaba postergada por tener el selector abierto: la lista se repintaba en ese instante y el
        // avatar que iba a girar quedaba fuera del DOM, así que la segunda selección parecía detener
        // la primera. Con este orden, la recarga solo puede correr cuando la cola queda vacía.
        assignPending += 1;
        markAvatarSaving(anchor);
        closeAssignPop();
        // El contador baja en `finally` y la cadena lleva `catch`: sin eso, un rechazo en cualquier
        // eslabón dejaba `assignQueue` en estado rechazado, los `.then` siguientes se saltaban y
        // `assignPending` se quedaba en >0 para siempre — con lo cual flushAssignReload salía temprano
        // en cada intento y la lista no volvía a repintarse nunca, aunque los guardados sí ocurrieran.
        assignQueue = assignQueue
            .then(async () => {
                try {
                    await runAssignTask(payloadSlot, value, name, anchor);
                } finally {
                    assignPending -= 1;
                }
                await flushAssignReload();
            })
            .catch((err) => {
                console.error('Assign queue error:', err);
                pmToast('No se pudo completar una asignación. Recarga la página para ver el estado real.', 'warning');
            });
    }

    // Delegación en document: la lista de servicios se re-renderiza completa en cada guardado, así
    // que enlazar sobre los renglones se perdería.
    document.addEventListener('click', (ev) => {
        const opt = ev.target.closest('.assign-pop-opt');
        if (opt) { enqueueSlotAssignment(opt); return; }
        if (ev.target.closest('#assignPopClose')) { closeAssignPop(); return; }
        if (ev.target.closest('#assignPop')) return;
        const av = ev.target.closest('.svc-av.is-pick');
        if (av) { openAssignPop(av); return; }
        closeAssignPop();
    });

    document.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape') { closeAssignPop(); return; }
        if (ev.key !== 'Enter' && ev.key !== ' ') return;
        const av = ev.target.closest?.('.svc-av.is-pick');
        if (av && document.activeElement === av) { ev.preventDefault(); openAssignPop(av); }
    });

    document.getElementById('assignPopSearch')?.addEventListener('input', (ev) => {
        const q = ev.target.value.trim().toLowerCase();
        document.querySelectorAll('#assignPopBody .assign-pop-opt').forEach((el) => {
            if (el.classList.contains('is-clear')) return;
            el.style.display = !q || el.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });

    // Quién puede ocupar cada rol. Vive en una sola función porque la usan el modal y el selector
    // por renglón: si divergieran, el mismo servicio ofrecería listas distintas según por dónde entres.
    function employeePools(employees) {
        const hasFutureRole = (e, role) => Array.isArray(e.futureRoles)
            && e.futureRoles.some((r) => String(r).toLowerCase() === role);
        return {
            drivers: employees.filter((e) => e.role === 'driver' || e.role === 'employee_amexing' || e.role === 'admin' || hasFutureRole(e, 'driver') || hasFutureRole(e, 'conductor')),
            guides: employees.filter((e) => e.role === 'guia' || e.role === 'employee_amexing' || e.role === 'admin' || e.displayRole === 'guia' || hasFutureRole(e, 'guia') || hasFutureRole(e, 'guide')),
            greeters: employees.filter((e) => e.role === 'greeter' || e.role === 'employee_amexing' || e.role === 'admin' || e.displayRole === 'greeter' || hasFutureRole(e, 'greeter')),
            // Customer Support solo lo pueden ocupar administradores. `role` aquí es el NOMBRE del
            // Role resuelto (ver UserManagementService: `role: roleName || 'guest'`), el mismo campo
            // con el que ya se filtran choferes y guías. /api/employees los incluye porque mezcla
            // employee_amexing/driver con getAmexingUsers.
            admins: employees.filter((e) => e.role === 'admin' || e.role === 'superadmin'),
            all: employees,
        };
    }

    // Nombre visible de un empleado, con el mismo orden de respaldos que usaba el formulario.
    function employeeName(e) {
        const fn = e.firstName || '';
        const ln = e.lastName || '';
        return (fn && ln) ? `${fn} ${ln}` : (e.fullName || e.username || e.name || 'Sin nombre');
    }

    // buildOptionHtml y buildVehicleOptionHtml se retiraron: solo alimentaban los <select> de ese
    // formulario. El selector por círculo arma sus opciones en assignPopPeopleGroup/VehicleGroup.




    // openAssignModal se retiró con el formulario completo (ver el comentario del markup).


    // El guardado del formulario completo se fue con él: cada círculo guarda su propio campo.

    // Service Customer at reservation level
    // Los manejadores del modal de Customer Support se retiraron con el modal: ahora el chip abre el
    // mismo selector que los servicios y el guardado va por la cola (ver runAssignTask).

    // ===== FINANCIAL SUMMARY =====

    // Barra de cobranza del pie. Toma sus cifras del summary del servidor, igual que el carrito, así
    // que no puede desviarse de él. Se descubre sólo cuando hay datos: una barra con guiones sería
    // peor que ninguna.
    function renderPaymentBar() {
        const bar = document.getElementById('payBar');
        if (!bar) return;
        const pay = reservationData && reservationData.payment;
        if (!pay) { bar.classList.add('d-none'); return; }

        const curr = reservationData.currency || 'MXN';
        const resuelto = PaymentBreakdownHelpers.resolveDisplayedBalance(pay);
        const total = Number(pay.total) || 0;
        const pagado = Number(pay.paidAmount) || 0;
        const saldo = resuelto.displayedBalance;
        const pct = total > 0 ? Math.min(100, Math.round((pagado / total) * 100)) : 0;

        document.getElementById('payBarSaldo').textContent = formatCurrency(saldo, curr);
        document.getElementById('payBarFill').style.width = `${pct}%`;
        // El monto pagado va del mismo verde que la barra: son el mismo dato dicho de dos formas —lo
        // que ya se cubrió— y el color los ata. El total queda neutro: es la referencia, no el avance.
        document.getElementById('payBarDetalle').innerHTML =
            `<strong>${pct}%</strong> pagado · `
            + `<span class="pay-bar-pagado">${formatCurrency(pagado, curr)}</span>`
            + ` de ${formatCurrency(total, curr)}`;
        document.getElementById('payBarEstado').innerHTML =
            PaymentBreakdownHelpers.getPaymentStatusBadge(pay.paymentStatus);

        // Método de pago: es el que decide CUÁL de los tres precios se está cobrando.
        const metodoEl = document.getElementById('payBarMetodo');
        const metodo = reservationData.paymentType || '';
        metodoEl.textContent = metodo
            ? metodo.charAt(0).toUpperCase() + metodo.slice(1)
            : '';
        metodoEl.classList.toggle('d-none', !metodo);

        // Saldo cubierto: deja de teñirse de ámbar, que es la señal de que falta algo.
        document.getElementById('payBarSaldo').classList.toggle('is-cubierto', saldo <= 0);
        bar.classList.remove('d-none');
    }

    function renderFinancialSummary() {
        const d = reservationData;
        // El desglose se pinta DENTRO del carrito: es donde se consulta y donde se actúa sobre él.
        const body = document.getElementById('payDesglose');
        const addBtn = document.getElementById('addAdjustmentBtn');
        const adjustments = d.adjustments || [];
        // Subtotal recomputed from per-service pricesByType[paymentType] so the booking
        // matches the quote's totals when both use the same payment type, and updates
        // correctly if payment type changes on the reservation. Falls back to the
        // stored values for very old data without pricesByType.
        const computedSubtotal = computeServicesSubtotalByType(d.services, d.paymentType);
        const servicesSubtotal = computedSubtotal > 0
            ? computedSubtotal
            : (d.servicesSubtotal || d.totalAmount || 0);
        const canEdit = d.status !== 'cancelled' && d.status !== 'completed';

        if (canEdit) addBtn.classList.remove('d-none');
        else addBtn.classList.add('d-none');
        // "Agregar pago" ahora se renderiza dentro del hero (solo si canEdit), así que su visibilidad
        // ya no se maneja aquí. Su click se cablea por delegación (el hero se re-renderiza).

        const charges = adjustments.filter(a => a.type === 'charge');
        const discounts = adjustments.filter(a => a.type === 'discount');
        const pay = d.payment;
        // Propina cobrada (Fase 2): SIEMPRE del summary del servidor (d.payment), NUNCA de d.globalTip del
        // snapshot bruto de la cotización (fuente no confiable) ni recalculada localmente. general +
        // por servicio suman pay.tip; el motor de pagos ya la incluye en pay.total.
        const generalTip = pay ? PaymentBreakdownHelpers.round2(pay.generalTip) : 0;
        const serviceTipsTotal = pay ? PaymentBreakdownHelpers.round2(pay.serviceTipsTotal) : 0;
        const curr = d.currency || 'MXN';

        // Tipo de pago (se muestra en el hero, junto al estado; ya no como fila del desglose).
        const paymentTypeLabel = d.paymentType
            ? d.paymentType.charAt(0).toUpperCase() + d.paymentType.slice(1)
            : '—';

        // Comparativo por método: los precios de servicios cambian por método. Se despliega desde el
        // chip de método (Transferencia ▾), no como sección suelta — queda pegado a lo que explica.
        const comparisonMethods = [
            { method: 'efectivo', label: 'Efectivo', icon: 'ti-cash' },
            { method: 'transferencia', label: 'Transferencia', icon: 'ti-building-bank' },
            { method: 'tarjeta', label: 'Tarjeta', icon: 'ti-credit-card' },
        ];
        // El método solo cambia el SUBTOTAL de servicios; el resto (ajustes, propinas) es igual. Por eso
        // el TOTAL por método = total actual + Δsubtotal — así cada fila es el "Total a pagar" en ese
        // método, y el actual coincide con el número grande del hero.
        const cmpSubtotals = comparisonMethods.map(m => ({ ...m, subtotal: computeServicesSubtotalByType(d.services, m.method) }));
        const cmpCurrentSubtotal = (cmpSubtotals.find(m => m.method === d.paymentType) || {}).subtotal || 0;
        const cmpBaseTotal = pay ? (Number(pay.total) || 0) : cmpCurrentSubtotal;
        const cmpAmounts = cmpSubtotals.map(m => ({ ...m, amount: cmpBaseTotal + (m.subtotal - cmpCurrentSubtotal) }));
        const cmpCurrent = (cmpAmounts.find(m => m.method === d.paymentType) || {}).amount || 0;
        const cmpCheapest = Math.min(...cmpAmounts.map(m => m.amount));
        // Lo pagado es uno solo; lo que cambia por método es el total, y con él cuánto de ese total
        // queda cubierto y cuánto falta. El saldo se calcula como total − cubierto para que el renglón
        // del método vigente dé EXACTAMENTE el saldo de la cobertura de arriba: dos cifras distintas
        // para "lo que falta" en el mismo panel serían una contradicción a la vista.
        const cmpPagado = pay ? PaymentBreakdownHelpers.round2(pay.paidAmount) : 0;
        const comparisonRows = cmpAmounts.map(m => {
            const isActive = m.method === d.paymentType;
            // Se topa al total del método: si lo pagado supera un total más barato, el excedente es
            // saldo a favor, no cobertura de este renglón.
            const cubierto = Math.min(cmpPagado, m.amount);
            const pctCubierto = m.amount > 0 ? Math.min(100, Math.round((cubierto / m.amount) * 100)) : 0;
            const saldo = PaymentBreakdownHelpers.round2(m.amount - cubierto);
            const cheap = (!isActive && m.amount === cmpCheapest && cmpCheapest < cmpCurrent)
                ? '<span class="pay-cmp-barato">más barato</span>' : '';
            return `<div class="pay-cmp-row ${isActive ? 'is-actual' : ''}">
                <span class="pay-cmp-met"><i class="ti ${m.icon}"></i>${m.label}${cheap}${
                    isActive ? '<span class="pay-cmp-dif is-actual">Actual</span>' : ''}</span>
                <span class="pay-cmp-monto">${formatCurrency(m.amount, curr)}</span>
                <span class="pay-cmp-cubierto">${formatCurrency(cubierto, curr)}
                    <span class="pay-cmp-pct">${pctCubierto}%</span></span>
                <span class="pay-cmp-saldo">${formatCurrency(saldo, curr)}</span>
            </div>`;
        }).join('');
        const comparisonHead = comparisonRows
            ? `<div class="pay-cmp-row is-cabeza">
                <span>Método</span><span>Total</span><span>Cubierto</span><span>Saldo</span>
              </div>` : '';
        // Chip de método = disparador del comparativo (collapse INLINE, no dropdown flotante).
        // El comparativo se pinta en su propia sección, arriba del desglose. Ya no cuelga de un chip
        // que había que descubrir y que además llamaba a toggleSavingsHint(), una función que en esta
        // vista nunca existió: abrirlo tiraba un ReferenceError.
        const cmpSec = document.getElementById('payCmpSec');
        if (cmpSec) {
            // La sección vive colapsada: la abre el chip del método. Sin filas que comparar no hay
            // nada que abrir, y el chip vuelve a ser una etiqueta (lo decide renderPaymentsOffcanvas).
            document.getElementById('payCmp').innerHTML = comparisonHead + comparisonRows;
            if (!comparisonRows) bootstrap.Collapse.getOrCreateInstance(cmpSec, { toggle: false }).hide();
        }
        // Hint de ahorro SIEMPRE visible: si otro método es más barato que el actual, lo anuncia sin
        // tener que abrir el comparativo (p. ej. "En efectivo ahorras $7,542").
        const cmpCheapestMethod = cmpAmounts.find(m => m.amount === cmpCheapest);
        const cmpSavings = cmpCurrent - cmpCheapest;
        const savingsHint = (cmpCheapestMethod && cmpCheapestMethod.method !== d.paymentType && cmpSavings >= 0.005)
            ? `<div class="fin-hero-hint"><i class="ti ti-discount-2"></i>En ${PaymentBreakdownHelpers.escapeHtml(cmpCheapestMethod.label.toLowerCase())} ahorras ${formatCurrency(cmpSavings, curr)}</div>`
            : '';

        let html = '';
        // El HERO se retiró de aquí: sus cifras —total, estado, %, pagado y saldo— viven en la barra
        // del pie y, completas, en la tarjeta de cobertura del carrito. Estaban en los dos lados.

        // ===== Desglose ===== (sin rótulo; los renglones ya se leen como desglose)
        // El chip de método y su comparativo van SIEMPRE, no sólo cuando falta el summary. Vivían
        // dentro del hero; al mudarse el hero a la barra del pie se habrían quedado sin dónde
        // insertarse, y con ellos el aviso de ahorro, que es el único que sugiere cambiar de método.
        if (savingsHint) {
            html += savingsHint;
        }
        html += `<div class="fin-row"><span class="lbl"><i class="ti ti-list-details"></i>Subtotal servicios</span><span class="val">${formatCurrency(servicesSubtotal, curr)}</span></div>`;

        // Propina cobrada (Fase 2): líneas leídas del summary del servidor para que el Subtotal + propina +
        // ajustes reconcilie con el Total a pagar. La general va en su línea; la de por-servicio se agrega
        // (los tips por servicio también aparecen por servicio en el itinerario, aquí es el agregado).
        if (generalTip > 0) {
            html += `<div class="fin-row"><span class="lbl"><i class="ti ti-coin fin-tip"></i>Propina general</span><span class="val fin-tip">+${formatCurrency(generalTip, curr)}</span></div>`;
        }
        if (serviceTipsTotal > 0) {
            html += `<div class="fin-row"><span class="lbl"><i class="ti ti-coin fin-tip"></i>Propinas por servicio</span><span class="val fin-tip">+${formatCurrency(serviceTipsTotal, curr)}</span></div>`;
        }

        // Ajustes (cargos/descuentos) al final del desglose, pegados al "+ Agregar ajuste", para que
        // al agregar uno aparezca de forma natural justo encima del disparador.
        charges.forEach(adj => {
            html += `<div class="fin-row">
                <span class="lbl"><i class="ti ti-plus fin-charge"></i>${PaymentBreakdownHelpers.escapeHtml(adj.description)}</span>
                <span class="d-flex align-items-center gap-2"><span class="val fin-charge">+${formatCurrency(adj.amount, curr)}</span>${canEdit ? `<button class="btn btn-sm btn-outline-secondary py-0 px-1 remove-adj-btn" data-adj-id="${adj.id}" title="Eliminar"><i class="ti ti-x" style="font-size:0.75rem"></i></button>` : ''}</span>
            </div>`;
        });
        discounts.forEach(adj => {
            const pctLabel = adj.percentage ? ` (${adj.percentage}%)` : '';
            html += `<div class="fin-row">
                <span class="lbl"><i class="ti ti-discount-2 fin-discount"></i>${PaymentBreakdownHelpers.escapeHtml(adj.description)}${pctLabel}</span>
                <span class="d-flex align-items-center gap-2"><span class="val fin-discount">-${formatCurrency(adj.amount, curr)}</span>${canEdit ? `<button class="btn btn-sm btn-outline-secondary py-0 px-1 remove-adj-btn" data-adj-id="${adj.id}" title="Eliminar"><i class="ti ti-x" style="font-size:0.75rem"></i></button>` : ''}</span>
            </div>`;
        });

        // El bloque de pago (estado + total + pagado + saldo + ahorro) se muestra ahora en el "hero"
        // de arriba (fin-hero). El detalle completo (chips, cobertura, desglose por método, historial y
        // registro) vive en #paymentsOffcanvas.

        if (body) body.innerHTML = html;

        // Bind remove buttons
        body.querySelectorAll('.remove-adj-btn').forEach(btn => {
            btn.addEventListener('click', () => removeAdjustment(btn.dataset.adjId));
        });
    }

    async function removeAdjustment(adjId) {
        if (!(await pmConfirm({
            title: 'Eliminar ajuste', message: '¿Eliminar este ajuste?', confirmText: 'Eliminar', danger: true,
        }))) return;
        // Loader en el botón (y en sus pares) para que se vea que algo está pasando durante el
        // borrado + recarga. loadReservation vuelve a renderizar el desglose, así que no hay que
        // restaurar el botón manualmente en el caso de éxito.
        const btn = document.querySelector(`.remove-adj-btn[data-adj-id="${adjId}"]`);
        const original = btn ? btn.innerHTML : '';
        document.querySelectorAll('.remove-adj-btn').forEach((b) => { b.disabled = true; });
        if (btn) btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:.7rem;height:.7rem;border-width:.13em;"></span>';
        try {
            const response = await fetch(`/api/reservations/${reservationId}/adjustments/${adjId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            const result = await response.json();
            if (result.success) {
                await loadReservation();
                pmToast('Ajuste eliminado', 'success');
            } else {
                pmToast(result.error || 'Error al eliminar ajuste', 'error');
                document.querySelectorAll('.remove-adj-btn').forEach((b) => { b.disabled = false; });
                if (btn) btn.innerHTML = original;
            }
        } catch (err) {
            console.error('Remove adjustment error:', err);
            pmToast('Error al eliminar ajuste', 'error');
            document.querySelectorAll('.remove-adj-btn').forEach((b) => { b.disabled = false; });
            if (btn) btn.innerHTML = original;
        }
    }

    // ===== PAYMENTS =====

    let paymentsCache = [];
    // Último summary AMPLIO de GET .../payments (coveragePercent/availableMethods/anchoredMethod/
    // montoParaSaldar). El summary ANGOSTO de getReservationById NO trae estos campos, así que el carrito
    // se puebla solo desde aquí.
    let latestSummary = null;

    function paymentsOffcanvasInstance() {
        const el = document.getElementById('paymentsOffcanvas');
        return el ? bootstrap.Offcanvas.getOrCreateInstance(el) : null;
    }

    const PAYMENT_METHOD_LABELS = { efectivo: 'Efectivo', transferencia: 'Transferencia', tarjeta: 'Tarjeta' };
    // [fondo, texto, borde] por método para el chip del historial. Misma paleta suave de marca que la
    // píldora de estado de la card de cobertura, para que el drawer se lea como una sola pieza.
    const PAYMENT_METHOD_COLORS = {
        efectivo: ['#e6efe1', '#3f5a34', '#cfe0c6'],
        transferencia: ['#eaf1f0', '#3a6b63', '#cfe1dd'],
        tarjeta: ['#f6efe2', '#96682f', '#e7d6bd'],
        _default: ['#f0eee7', '#6b6656', '#ded9cb'],
    };
    // Orden del historial. Vive fuera de renderPayments para sobrevivir a los re-render que dispara
    // cada alta/edición/borrado de pago.
    let paymentsSort = { key: 'date', dir: 'desc' };
    // Pago que se está editando. El formulario de edición se abre INLINE, en una fila expandida bajo el
    // pago tocado: el #paymentFormWrap del alta vive en el tab "Pago", así que editar desde "Historial"
    // dibujaba el formulario en un panel oculto y parecía que el botón no hacía nada.
    let editingPaymentId = null;
    // Formulario de alta abierto (el del tab "Pago"). Su par de edición es editingPaymentId.
    let addPaymentFormOpen = false;
    // El carrito solo se abre desde "Agregar pago", así que la intención al abrirlo es siempre
    // registrar uno: el formulario se despliega solo, se haya llegado por donde se haya llegado. La
    // bandera se levanta al abrir el panel y se baja cuando el formulario ya se pudo dibujar (o
    // cuando resulta que no se puede). Si quien lo abrió lo cierra con "Cancelar", no vuelve solo:
    // la bandera solo se levanta en la apertura del panel, no en cada render.
    let pendingAddForm = false;

    // El formulario necesita availableMethods del summary AMPLIO para poblar el select de método; si se
    // dibujara antes de que llegue, saldría con el select vacío y el guardado bloqueado, y no se volvería
    // a construir solo. Por eso se intenta en dos momentos: al terminar de abrir el panel y al llegar el
    // summary — lo que ocurra al final.
    function maybeOpenAddForm() {
        if (!pendingAddForm) return;
        const status = reservationData ? reservationData.status : null;
        const canEdit = status !== 'cancelled' && status !== 'completed';
        if (!canEdit || addPaymentFormOpen || editingPaymentId) { pendingAddForm = false; return; }
        if (!latestSummary) return; // Aún cargando: se reintenta desde applyPaymentSummary.
        pendingAddForm = false;
        renderPaymentForm(null);
    }

    // "Registrar pago" se OCULTA mientras hay un formulario abierto, en vez de quedarse abajo con su
    // aspecto de llamada a la acción: ahí parecía que otro clic agregaría un segundo formulario. Además
    // impide abrir el alta encima de una edición inline (savePayment lee los campos por id global, así
    // que un segundo formulario guardaría los valores del equivocado).
    function syncAddPaymentBtn() {
        const btn = document.getElementById('showPaymentFormBtn');
        if (!btn) return;
        const status = reservationData ? reservationData.status : null;
        const canEdit = status !== 'cancelled' && status !== 'completed';
        const formOpen = addPaymentFormOpen || !!editingPaymentId;
        btn.classList.toggle('d-none', !canEdit || formOpen);
    }

    // Cierra el formulario abierto, sea el del alta (tab "Pago") o el inline del historial. NUNCA puede
    // haber dos abiertos a la vez, por lo mismo de los ids globales.
    function closePaymentForm() {
        const wasEditing = !!editingPaymentId;
        editingPaymentId = null;
        addPaymentFormOpen = false;
        const wrap = document.getElementById('paymentFormWrap');
        if (wrap) { wrap.style.display = 'none'; wrap.innerHTML = ''; wrap.classList.remove('pay-form'); }
        syncAddPaymentBtn();
        // Re-render para quitar la fila expandida y reactivar los encabezados de orden.
        if (wasEditing) renderPayments();
    }

    // Las dos fechas del historial son de naturaleza distinta y por eso se leen distinto:
    //  · PAGO (paidAt): viene de un <input type="date">, se guarda como medianoche UTC y NO tiene hora
    //    útil. Se lee en UTC — en local (México, offset negativo) caería un día antes.
    //  · REGISTRO (createdAt): instante real en que se capturó el pago. Se lee en hora local.
    // Cada una trae además su propia persona: quién recibió el dinero vs. quién lo capturó.
    const PAYMENT_DATE_FIELDS = {
        date: { get: (p) => p.paidAt || p.createdAt, utc: true },
        created: { get: (p) => p.createdAt, utc: false },
    };
    const paymentMs = (p, key) => {
        const field = PAYMENT_DATE_FIELDS[key] || PAYMENT_DATE_FIELDS.date;
        const t = new Date(field.get(p) || 0).getTime();
        return Number.isNaN(t) ? 0 : t;
    };
    const monthKey = (p, key) => {
        const utc = (PAYMENT_DATE_FIELDS[key] || PAYMENT_DATE_FIELDS.date).utc;
        const dt = new Date(paymentMs(p, key));
        const year = utc ? dt.getUTCFullYear() : dt.getFullYear();
        const month = (utc ? dt.getUTCMonth() : dt.getMonth()) + 1;
        return `${year}-${String(month).padStart(2, '0')}`;
    };
    const monthLabel = (p, key) => {
        const utc = (PAYMENT_DATE_FIELDS[key] || PAYMENT_DATE_FIELDS.date).utc;
        const opts = { month: 'long', year: 'numeric' };
        if (utc) opts.timeZone = 'UTC';
        const s = new Date(paymentMs(p, key)).toLocaleDateString('es-MX', opts);
        return s.charAt(0).toUpperCase() + s.slice(1);
    };
    // Fecha + hora de registro, en hora local (ver PAYMENT_DATE_FIELDS).
    function formatDateTimeShort(dateStr) {
        const dt = new Date(dateStr);
        if (Number.isNaN(dt.getTime())) return '—';
        // Día y mes por separado para evitar el guion del locale ("10-jun" → "10 jun"), igual que
        // formatDateRange. Hora en 24h: más compacta que "02:32 p.m." y sin ambigüedad.
        const day = dt.toLocaleDateString('es-MX', { day: '2-digit' });
        const month = dt.toLocaleDateString('es-MX', { month: 'short' });
        const time = dt.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', hour12: false });
        return `${day} ${month}, ${time}`;
    }

    // Copiar al portapapeles con respaldo para contextos sin navigator.clipboard (HTTP, navegadores
    // viejos), donde la API no existe y el botón quedaría muerto sin avisar.
    async function copyToClipboard(text) {
        if (!text) return;
        try {
            if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(text);
            } else {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.setAttribute('readonly', '');
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
            }
            pmToast('Referencia copiada', 'success');
        } catch (err) {
            console.error('Error copiando al portapapeles:', err);
            pmToast('No se pudo copiar la referencia', 'warning');
        }
    }

    // Esqueleto de carga del carrito. "Agregar pago" aparece en el hero apenas carga la reservación,
    // así que el panel se puede abrir mientras GET .../payments sigue en vuelo: sin esto salía en
    // blanco y parecía que no funcionaba. Las barras imitan la forma de la card de cobertura, la tabla
    // por método y el historial para que el contenido real entre sin saltos.
    function renderPaymentsSkeleton() {
        const bar = (w, h, extra = '') => `<div class="pay-skel" style="width:${w};height:${h};${extra}"></div>`;
        const coverage = document.getElementById('paymentCoverageCard');
        if (coverage) {
            coverage.innerHTML = `<div aria-busy="true" aria-live="polite">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
                  <div style="flex:1;">
                    ${bar('190px', '12px')}
                    ${bar('220px', '32px', 'margin-top:9px;')}
                  </div>
                  ${bar('118px', '30px', 'border-radius:999px;')}
                </div>
                ${bar('96px', '11px', 'margin:14px 0 0 auto;')}
                ${bar('100%', '11px', 'border-radius:999px;margin:7px 0 18px;')}
                <div style="display:flex;justify-content:space-between;gap:12px;">
                  <div>${bar('64px', '10px')}${bar('120px', '22px', 'margin-top:7px;')}</div>
                  <div style="text-align:right;">${bar('64px', '10px', 'margin-left:auto;')}${bar('120px', '22px', 'margin:7px 0 0 auto;')}</div>
                </div>
                <div class="d-flex align-items-center gap-2 mt-3 text-muted" style="font-size:.82rem;">
                  <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>Cargando pagos…
                </div>
              </div>`;
        }
        const body = document.getElementById('paymentsBody');
        if (body) {
            body.innerHTML = `<div aria-busy="true">${[1, 2, 3].map(() => `<div style="display:flex;align-items:center;gap:12px;padding:.6rem .55rem;border-bottom:1px solid #e6e6da;">
                ${bar('86px', '12px')}${bar('96px', '12px')}<div style="flex:1;"></div>${bar('70px', '12px')}
              </div>`).join('')}</div>`;
        }
    }

    // Si el GET falla no hay summary que pintar: dejar el esqueleto girando para siempre es peor que el
    // panel vacío, así que mostramos el error con reintento en la card de cobertura.
    function renderPaymentsLoadError() {
        const coverage = document.getElementById('paymentCoverageCard');
        if (coverage) {
            coverage.innerHTML = `<div class="text-center py-2">
                <div class="text-muted mb-2"><i class="ti ti-alert-triangle me-1"></i>No se pudo cargar la información de pagos.</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="retryPaymentsBtn"><i class="ti ti-refresh me-1"></i>Reintentar</button>
              </div>`;
            document.getElementById('retryPaymentsBtn')?.addEventListener('click', () => loadPayments());
        }
        // El tab Historial se queda con su propio esqueleto si no lo limpiamos acá (renderPayments no
        // corre en esta rama).
        const body = document.getElementById('paymentsBody');
        if (body) body.innerHTML = '<div class="text-center py-3 text-muted">No se pudo cargar el historial de pagos.</div>';
    }

    async function loadPayments() {
        // Solo en la primera carga: las recargas posteriores a registrar/editar/borrar un pago ya tienen
        // contenido en pantalla y reemplazarlo por barras se vería como un parpadeo.
        if (!latestSummary) renderPaymentsSkeleton();
        let loaded = false;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/payments`, {
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            const result = await response.json().catch(() => null);
            loaded = response.ok && !!result?.data;
            // Keep the existing cache on a transient error instead of blanking the list.
            if (loaded) {
                paymentsCache = result.data.payments || [];
                // GET returns the fresh summary too — keep el saldo y el carrito en sync en cada recarga.
                if (result.data.summary) applyPaymentSummary(result.data.summary);
            } else {
                console.error('Error loading payments:', response.status, result);
            }
        } catch (err) {
            console.error('Error loading payments:', err);
        }
        if (!loaded && !latestSummary) { renderPaymentsLoadError(); return; }
        renderPayments();
    }

    // Rellena las secciones del offcanvas (chips / cobertura / saldo restante / descuento) desde el
    // Tabla "Por método de pago": un renglón por método con Total y Restante (reemplaza los chips con


    // "En efectivo ahorras $X" bajo el total. Se había retirado cuando el comparativo vivía siempre
    // a la vista —decía lo mismo con la cifra—, pero ahora está colapsado tras el chip del método:
    // sin el aviso, quien no lo abra no se entera de que hay una forma más barata de cobrar.
    // Devuelve '' si el método cotizado ya es el más barato.
    function cheapestSavingsHint(summary, services, curr) {
        const H = PaymentBreakdownHelpers;
        const s = summary || {};
        const methods = Array.isArray(s.availableMethods) ? s.availableMethods : [];
        const anchor = s.anchoredMethod;
        const cheapest = H.cheapestAvailableMethod(methods, services, curr);
        if (!cheapest || !anchor || cheapest === anchor) return '';
        // Mismos totales por método que el comparativo (subtotal del método + ajustes + propina), así
        // el ahorro anunciado aquí y la diferencia que se ve al abrirlo no pueden discrepar.
        const extras = H.round2(s.adjustments) + H.round2(s.tip);
        const totalFor = (m) => Math.max(0, H.round2(H.computeServicesSubtotalByType(services, m, curr) + extras));
        const savings = H.round2(totalFor(anchor) - totalFor(cheapest));
        if (savings < 0.005) return '';
        return `<div class="pay-savings-hint"><i class="ti ti-discount-2"></i>En ${H.escapeHtml(H.methodLabel(cheapest).toLowerCase())} ahorras ${formatCurrency(savings, curr)}</div>`;
    }

    function renderPaymentsOffcanvas() {
        if (!latestSummary) return;
        const services = reservationData?.services || [];
        const curr = reservationData?.currency || 'MXN';
        const coverage = document.getElementById('paymentCoverageCard');
        if (coverage) {
            // Sin el hint de ahorro: la sección "Total según el método" ya está a la vista y dice lo
            // mismo —cuál cuesta menos y cuánto—, con la cifra en vez de una frase.
            // Sin píldora de estado: "Pago parcial" ya lo dicen el porcentaje, lo pagado y el saldo
            // de este mismo bloque —y la barra del pie, que es de donde se abre el panel—. Su esquina
            // la toma el chip del método, que ahí se lee como lo que es: un control.
            const hint = cheapestSavingsHint(latestSummary, services, curr);
            coverage.innerHTML = PaymentBreakdownHelpers.buildCoverageCard(latestSummary, curr, hint,
                { metodoInteractivo: hayComparativo(), ocultarEstado: true });
        }
    }

    function renderPayments() {
        const body = document.getElementById('paymentsBody');
        if (!body) return;

        const d = reservationData;
        const canEdit = d.status !== 'cancelled' && d.status !== 'completed';
        const curr = d.currency || 'MXN';

        // "Agregar pago" (header) ya se habilita en renderFinancialSummary, justo tras loadReservation.
        // "Registrar pago" (dentro del carrito) depende además de que no haya un formulario abierto.
        syncAddPaymentBtn();
        // Contador de pagos en el tab "Historial".
        const histCount = document.getElementById('historialCount');
        if (histCount) histCount.textContent = paymentsCache.length ? String(paymentsCache.length) : '';

        if (!paymentsCache.length) {
            body.innerHTML = `<div class="text-center py-4">
                <i class="ti ti-receipt-off" style="font-size:2rem;color:#c9cdbb;"></i>
                <div class="mt-2 fw-semibold" style="color:#6b6656;">Sin pagos registrados</div>
                <div class="small text-muted">Los pagos que registres aparecerán aquí.</div>
            </div>`;
            return;
        }

        // El backend entrega los pagos ascendentes por paidAt; el historial los muestra por defecto del
        // más reciente al más viejo (lo último es lo que se viene a revisar).
        const isDateSort = paymentsSort.key === 'date' || paymentsSort.key === 'created';
        const sorted = paymentsCache.slice().sort((a, b) => {
            const dir = paymentsSort.dir === 'asc' ? 1 : -1;
            if (paymentsSort.key === 'amount') {
                const diff = (a.amount || 0) - (b.amount || 0);
                if (diff) return diff * dir;
            } else {
                const diff = paymentMs(a, paymentsSort.key) - paymentMs(b, paymentsSort.key);
                if (diff) return diff * dir;
            }
            // Desempate estable (dos pagos del mismo día, o dos del mismo monto): el orden de captura.
            return (paymentMs(a, 'created') - paymentMs(b, 'created')) * dir;
        });

        // Agrupar por mes solo tiene sentido con un orden cronológico —y por el mes de LA fecha que se
        // está ordenando—, y solo aporta cuando hay varios pagos repartidos en más de un mes.
        const months = new Set(sorted.map((p) => monthKey(p, paymentsSort.key)));
        const grouped = isDateSort && sorted.length > 4 && months.size > 1;

        let lastMonth = null;
        const rows = sorted.map((p) => {
            let groupRow = '';
            if (grouped && monthKey(p, paymentsSort.key) !== lastMonth) {
                lastMonth = monthKey(p, paymentsSort.key);
                const inMonth = sorted.filter((q) => monthKey(q, paymentsSort.key) === lastMonth);
                const monthSum = inMonth.reduce((acc, q) => acc + (q.amount || 0), 0);
                groupRow = `<tr class="pay-hist-group"><td colspan="6">${PaymentBreakdownHelpers.escapeHtml(monthLabel(p, paymentsSort.key))}
                    <span class="pay-hist-group-sum">${inMonth.length} ${inMonth.length === 1 ? 'pago' : 'pagos'} · ${formatCurrency(monthSum, curr)}</span></td></tr>`;
            }
            const refLine = p.reference
                ? `<span class="pay-hist-ref">${PaymentBreakdownHelpers.escapeHtml(p.reference)}</span>
                   <button type="button" class="pay-hist-act copy-ref-btn" data-ref="${PaymentBreakdownHelpers.escapeHtml(p.reference)}" title="Copiar referencia" aria-label="Copiar referencia" style="width:24px;height:24px;font-size:.85rem;vertical-align:middle;"><i class="ti ti-copy"></i></button>`
                : '<span class="text-muted">—</span>';
            // Columna PAGO: cuándo se pagó y quién recibió el dinero. "Recibió" solo aplica al efectivo
            // (en transferencia/tarjeta no hay una persona que lo tome en mano).
            const receivedLine = (p.method === 'efectivo' && p.receivedBy)
                ? `<div class="pay-hist-person" title="Recibió el dinero"><i class="ti ti-user"></i>${PaymentBreakdownHelpers.escapeHtml(p.receivedBy)}</div>` : '';
            // Columna REGISTRO: cuándo se capturó en el sistema y quién lo capturó. Es el par de la
            // columna de pago, no lo mismo: un pago del día 10 puede capturarse el 28 por otra persona.
            const registeredLine = p.registeredByName
                ? `<div class="pay-hist-person" title="Registró el pago"><i class="ti ti-user"></i>${PaymentBreakdownHelpers.escapeHtml(p.registeredByName)}</div>` : '';
            const registeredAt = p.createdAt ? formatDateTimeShort(p.createdAt) : '<span class="text-muted">—</span>';
            // El comprobante es una acción más (abrir el archivo), así que vive junto a editar/eliminar.
            const receipt = p.receiptUrl
                ? `<a href="${PaymentBreakdownHelpers.escapeHtml(p.receiptUrl)}" target="_blank" rel="noopener" class="pay-hist-act is-receipt" title="Ver comprobante" aria-label="Ver comprobante"><i class="ti ti-file-invoice"></i></a>`
                : '';
            const [mBg, mFg, mBd] = PAYMENT_METHOD_COLORS[p.method] || PAYMENT_METHOD_COLORS._default;
            // Moneda distinta a la de la reservación: el monto listado está en la moneda de la reserva,
            // así que el original se muestra aparte en ámbar en vez de dejar solo un código ambiguo.
            const isForeign = !!p.origCurrency && p.origCurrency !== curr;
            const origLine = (isForeign && p.origAmount)
                ? `<div class="pay-hist-orig">Original ${formatCurrency(p.origAmount, p.origCurrency)}${p.exchangeRate ? ` · TC ${p.exchangeRate}` : ''}</div>` : '';
            // Fila expandida con el formulario de edición, justo bajo el pago tocado. El contenido lo
            // dibuja renderPaymentForm después de montar la tabla (necesita el nodo ya en el DOM).
            const editRow = p.id === editingPaymentId
                ? `<tr class="pay-hist-edit"><td colspan="6"><div class="pay-hist-form" id="paymentEditWrap"></div></td></tr>` : '';
            return `${groupRow}<tr${p.id === editingPaymentId ? ' class="is-editing"' : ''}>
                <td class="pay-hist-date" data-label="Pago">${formatDate(p.paidAt || p.createdAt)}${receivedLine}</td>
                <td data-label="Método"><span class="pay-hist-method" style="background:${mBg};color:${mFg};border-color:${mBd};">${PaymentBreakdownHelpers.escapeHtml(PAYMENT_METHOD_LABELS[p.method] || p.method || '—')}</span></td>
                <td data-label="Referencia">${refLine}</td>
                <td class="pay-hist-meta" data-label="Registro"><div class="pay-hist-stack">${registeredAt}${registeredLine}</div></td>
                <td class="pay-hist-amount" data-label="Monto">${formatCurrency(p.amount, curr)}<span class="pay-hist-curr${isForeign ? ' is-foreign' : ''}">${PaymentBreakdownHelpers.escapeHtml(p.origCurrency || curr)}</span>${origLine}</td>
                <td class="pay-hist-actions" data-label="Acciones">
                    ${receipt}
                    ${canEdit ? `<button type="button" class="pay-hist-act edit-payment-btn" data-payment-id="${p.id}" title="Editar" aria-label="Editar pago"><i class="ti ti-edit"></i></button>
                    <button type="button" class="pay-hist-act is-danger delete-payment-btn" data-payment-id="${p.id}" title="Eliminar" aria-label="Eliminar pago"><i class="ti ti-trash"></i></button>` : ''}
                </td>
            </tr>${editRow}`;
        }).join('');

        // Total de lo listado: ancla el historial contra el "Pagado" de la card de cobertura y delata
        // capturas duplicadas.
        const total = paymentsCache.reduce((acc, p) => acc + (p.amount || 0), 0);
        const arrow = paymentsSort.dir === 'asc' ? 'ti-arrow-up' : 'ti-arrow-down';
        // Reordenar re-monta la tabla, y con ella el formulario inline: se deshabilita mientras hay una
        // edición abierta para no borrar lo que el usuario está escribiendo.
        const sortTh = (key, label, align) => `<th style="text-align:${align};">
            <button type="button" class="pay-hist-sort${paymentsSort.key === key ? ' is-active' : ''}" data-sort-key="${key}"
                ${editingPaymentId ? 'disabled title="Termina de editar el pago para reordenar"' : ''}
                aria-label="Ordenar por ${label.toLowerCase()}">${label} <i class="ti ${paymentsSort.key === key ? arrow : 'ti-arrows-sort'}"></i></button>
        </th>`;

        body.innerHTML = `<table class="pay-hist">
                <thead>
                    <tr>
                        ${sortTh('date', 'Pago', 'left')}
                        <th>Método</th>
                        <th>Referencia</th>
                        ${sortTh('created', 'Registro', 'left')}
                        ${sortTh('amount', 'Monto', 'right')}
                        <th style="text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="pay-hist-foot-label">Total registrado · ${paymentsCache.length} ${paymentsCache.length === 1 ? 'pago' : 'pagos'}</td>
                        <td class="pay-hist-amount" data-label="Total">${formatCurrency(total, curr)}</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>`;

        body.querySelectorAll('.pay-hist-sort').forEach((btn) => {
            btn.addEventListener('click', () => {
                const key = btn.dataset.sortKey;
                // Volver a la misma columna invierte el sentido; cambiar de columna arranca descendente
                // (lo más nuevo / lo más grande primero, que es lo que se busca en ambos casos).
                if (paymentsSort.key === key) paymentsSort.dir = paymentsSort.dir === 'asc' ? 'desc' : 'asc';
                else paymentsSort = { key, dir: 'desc' };
                renderPayments();
            });
        });
        body.querySelectorAll('.copy-ref-btn').forEach((btn) => {
            btn.addEventListener('click', () => copyToClipboard(btn.dataset.ref || ''));
        });
        body.querySelectorAll('.edit-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.paymentId;
                // Cerrar primero descarta el otro formulario (alta u otra fila) antes de abrir este.
                closePaymentForm();
                editingPaymentId = id;
                renderPayments();
            });
        });
        body.querySelectorAll('.delete-payment-btn').forEach((btn) => {
            btn.addEventListener('click', () => deletePayment(btn.dataset.paymentId));
        });

        // El formulario inline se dibuja al final, cuando su contenedor ya está en el DOM. Si el pago
        // en edición desapareció (lo borró otra pestaña), el estado se limpia solo.
        if (editingPaymentId) {
            const editWrap = document.getElementById('paymentEditWrap');
            if (editWrap) renderPaymentForm(editingPaymentId, editWrap);
            else editingPaymentId = null;
        }
    }

    // Read a File as base64 (strip the "data:...;base64," prefix) for the JSON receipt upload.
    function fileToBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result).split(',')[1] || '');
            reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
            reader.readAsDataURL(file);
        });
    }

    // Upload a payment receipt in a SEPARATE request (decoupled from the save). The payment is
    // already persisted, so this never risks it: returns null on success, or a warning string if
    // the comprobante couldn't be uploaded (the user can retry by editing the payment).
    async function uploadReceipt(paymentId, file) {
        try {
            const body = JSON.stringify({
                fileBase64: await fileToBase64(file), fileName: file.name, mimeType: file.type,
            });
            const resp = await fetch(`/api/reservations/${reservationId}/payments/${paymentId}/receipt`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${authToken()}`, 'Content-Type': 'application/json' },
                body,
            });
            const r = await resp.json().catch(() => ({}));
            if (resp.ok && r.success) return null;
            return r.error
                ? `Pago guardado, pero el comprobante no se subió: ${r.error}`
                : 'Pago guardado, pero el comprobante no se subió. Reinténtalo editando el pago.';
        } catch (err) {
            console.error('Receipt upload error:', err);
            return 'Pago guardado, pero el comprobante no se subió (se cortó la conexión). Reinténtalo editando el pago.';
        }
    }

    // Inline payment form (relocated into #paymentsOffcanvas). null = nuevo, id = editar el pago.
    // targetWrap permite dibujar el mismo formulario en dos sitios: el contenedor fijo del tab "Pago"
    // (alta) o la fila expandida del historial (edición). Todo lo demás es idéntico.
    function renderPaymentForm(paymentId, targetWrap) {
        const wrap = targetWrap || document.getElementById('paymentFormWrap');
        if (!wrap) return;
        // Alta = sin id y en el contenedor fijo del tab "Pago". Marca el estado para que el botón que lo
        // abrió ceda su lugar al formulario.
        if (!paymentId && !targetWrap) addPaymentFormOpen = true;
        syncAddPaymentBtn();
        const existing = paymentId ? paymentsCache.find((p) => p.id === paymentId) : null;
        const curr = existing?.origCurrency || 'MXN';
        const paidAt = existing?.paidAt ? new Date(existing.paidAt).toISOString().slice(0, 10) : '';
        // Payment date allows the future (reservations later); shared standard 1900 .. today + 20y.
        const paidAtMax = (() => { const dt = new Date(); dt.setFullYear(dt.getFullYear() + 20); return dt.toISOString().slice(0, 10); })();
        const opt = (v, label, sel) => `<option value="${v}" ${sel === v ? 'selected' : ''}>${label}</option>`;
        const receiptLink = existing?.receiptUrl
            ? `<a href="${existing.receiptUrl}" target="_blank" rel="noopener" class="pay-receipt-chip"><i class="ti ti-file-invoice"></i>Ver comprobante actual</a>` : '';

        // Método: poblado dinámicamente desde availableMethods (Fase C), NUNCA hardcodeado a 3 opciones.
        // Al editar, se conserva el método guardado aunque ya no esté disponible (no cambiarlo en silencio).
        // Sin métodos disponibles (H3): select deshabilitado con mensaje y guardado bloqueado.
        const available = (latestSummary && Array.isArray(latestSummary.availableMethods)) ? latestSummary.availableMethods.slice() : [];
        const method = existing?.method || available[0] || '';
        const methodOrder = available.slice();
        if (existing?.method && !methodOrder.includes(existing.method)) methodOrder.push(existing.method);
        const methodDisabled = methodOrder.length === 0;
        const methodSelectHtml = methodDisabled
            ? `<select class="form-select form-select-sm" id="paymentMethod" disabled><option value="">Sin métodos disponibles</option></select>
               <div class="form-text text-danger">No hay métodos de pago disponibles para esta reservación.</div>`
            : `<select class="form-select form-select-sm" id="paymentMethod">${methodOrder.map((m) => opt(m, PAYMENT_METHOD_LABELS[m] || m, method)).join('')}</select>`;

        const amountInit = existing ? (existing.origAmount ?? existing.amount ?? '') : '';

        // Sin encabezado propio: la fila resaltada de arriba ya dice QUÉ pago se está editando y el
        // formulario cuelga pegado a ella, así que un título + separador solo restaba alto útil. El dato
        // se conserva como etiqueta en el pie, que tenía todo el lado izquierdo vacío.
        const contextLabel = existing
            ? `Editando el pago del ${formatDate(existing.paidAt || existing.createdAt)}`
            : 'Nuevo pago';
        wrap.classList.add('pay-form');
        wrap.innerHTML = `
            <input type="hidden" id="paymentId" value="${existing ? existing.id : ''}">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentAmount">Monto</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" id="paymentAmountPrefix">${curr === 'USD' ? 'USD $' : '$'}</span>
                        <input type="text" inputmode="decimal" maxlength="17" class="form-control form-control-sm" id="paymentAmount" placeholder="0.00" value="${amountInit}">
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentCurrency">Moneda</label>
                    <select class="form-select form-select-sm" id="paymentCurrency">${opt('MXN', 'MXN', curr)}${opt('USD', 'USD', curr)}</select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentMethod">Método</label>
                    ${methodSelectHtml}
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="paymentPaidAt">Fecha de pago</label>
                    <input type="date" class="form-control form-control-sm" id="paymentPaidAt" min="1900-01-01" max="${paidAtMax}" value="${paidAt}" required>
                </div>
                <div class="${method === 'efectivo' ? 'col-md-4' : 'col-md-8'}" id="paymentReferenceWrap">
                    <label class="form-label fw-semibold small" for="paymentReference">Referencia</label>
                    <input type="text" class="form-control form-control-sm" id="paymentReference" maxlength="100" placeholder="Folio / autorización" value="${PaymentBreakdownHelpers.escapeHtml(existing?.reference || '')}">
                </div>
                <div class="col-md-4" id="paymentReceivedByWrap" style="display:${method === 'efectivo' ? '' : 'none'};">
                    <label class="form-label fw-semibold small" for="paymentReceivedBy">¿Quién recibió el efectivo?</label>
                    <input type="text" class="form-control form-control-sm" id="paymentReceivedBy" maxlength="100" placeholder="Nombre de quien recibió" value="${PaymentBreakdownHelpers.escapeHtml(existing?.receivedBy || '')}" ${method === 'efectivo' ? 'required' : ''}>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold small" for="paymentReceipt">Comprobante (imagen o PDF)</label>
                    <div class="pay-drop" id="paymentReceiptDrop">
                        <input type="file" id="paymentReceipt" accept="image/*,application/pdf">
                        <div class="pay-file-row">
                            <label class="pay-file-btn" for="paymentReceipt"><i class="ti ti-paperclip"></i>Adjuntar</label>
                            <button type="button" class="pay-file-clear d-none" id="paymentReceiptClear" title="Quitar archivo" aria-label="Quitar archivo"><i class="ti ti-x"></i></button>
                        </div>
                        <span class="pay-file-name" id="paymentReceiptName">o arrastra el archivo aquí</span>
                        ${receiptLink}
                    </div>
                </div>
                <div class="col-md-7">
                    <label class="form-label fw-semibold small" for="paymentNotes">Notas</label>
                    <textarea class="form-control form-control-sm" id="paymentNotes" rows="2" maxlength="300" placeholder="Notas del pago">${PaymentBreakdownHelpers.escapeHtml(existing?.notes || '')}</textarea>
                </div>
            </div>
            <div class="pay-form-actions">
                <span class="pay-form-context">${existing ? '<i class="ti ti-edit"></i>' : '<i class="ti ti-cash"></i>'}${PaymentBreakdownHelpers.escapeHtml(contextLabel)}</span>
                <button type="button" class="btn btn-outline-secondary" id="cancelPaymentBtn">Cancelar</button>
                <button type="button" class="btn btn-primary" id="savePaymentBtn"><i class="ti ti-check me-1"></i>Guardar</button>
            </div>`;
        // El formulario vive dentro del offcanvas (posición fija con scroll propio): se muestra en su
        // sitio y se desplaza a la vista dentro del panel, sin scrollIntoView de página ni borde inline.
        wrap.style.display = '';
        wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const saveBtn = document.getElementById('savePaymentBtn');
        // Sin métodos disponibles (H3): no se puede registrar/editar el pago — bloquea el guardado.
        if (methodDisabled && saveBtn) saveBtn.disabled = true;
        document.getElementById('cancelPaymentBtn').addEventListener('click', () => closePaymentForm());
        saveBtn.addEventListener('click', () => savePayment(existing ? existing.id : ''));
        attachThousands(document.getElementById('paymentAmount'));

        // "¿Quién recibió el efectivo?" es visible + required SOLO cuando el método es efectivo, y
        // reacciona en vivo si el usuario cambia el método DESPUÉS de abrir el formulario.
        const methodSel = document.getElementById('paymentMethod');
        function syncReceivedByVisibility() {
            const isCash = methodSel && methodSel.value === 'efectivo';
            const wrapEl = document.getElementById('paymentReceivedByWrap');
            const inputEl = document.getElementById('paymentReceivedBy');
            if (wrapEl) wrapEl.style.display = isCash ? '' : 'none';
            if (inputEl) inputEl.required = !!isCash;
            // Referencia absorbe el ancho de "¿Quién recibió?" cuando está oculto, para que el renglón
            // siempre cierre las 12 columnas y no quede el hueco a la derecha.
            const refWrap = document.getElementById('paymentReferenceWrap');
            if (refWrap) {
                refWrap.classList.toggle('col-md-4', !!isCash);
                refWrap.classList.toggle('col-md-8', !isCash);
            }
        }
        if (methodSel) methodSel.addEventListener('change', syncReceivedByVisibility);
        syncReceivedByVisibility();

        // Zona de comprobante: el input nativo está oculto, así que el nombre del archivo elegido y el
        // botón para quitarlo son la única señal de qué se adjuntó.
        const receiptInput = document.getElementById('paymentReceipt');
        const receiptName = document.getElementById('paymentReceiptName');
        const receiptClear = document.getElementById('paymentReceiptClear');
        const receiptDrop = document.getElementById('paymentReceiptDrop');
        function syncReceiptName() {
            if (!receiptInput || !receiptName) return;
            const picked = receiptInput.files && receiptInput.files[0];
            receiptName.textContent = picked ? picked.name : 'o arrastra el archivo aquí';
            receiptName.title = picked ? picked.name : '';
            receiptName.classList.toggle('has-file', !!picked);
            if (receiptClear) receiptClear.classList.toggle('d-none', !picked);
        }
        if (receiptInput) receiptInput.addEventListener('change', syncReceiptName);
        if (receiptClear && receiptInput) {
            receiptClear.addEventListener('click', () => { receiptInput.value = ''; syncReceiptName(); });
        }
        // Arrastrar y soltar sobre la zona. Se asigna vía DataTransfer porque input.files es de solo
        // lectura salvo con una FileList real.
        if (receiptDrop && receiptInput) {
            ['dragenter', 'dragover'].forEach((ev) => receiptDrop.addEventListener(ev, (e) => {
                e.preventDefault();
                receiptDrop.classList.add('is-dragover');
            }));
            // relatedTarget dentro de la zona = solo se pasó sobre un hijo, no es una salida real.
            receiptDrop.addEventListener('dragleave', (e) => {
                if (!receiptDrop.contains(e.relatedTarget)) receiptDrop.classList.remove('is-dragover');
            });
            receiptDrop.addEventListener('drop', (e) => {
                e.preventDefault();
                receiptDrop.classList.remove('is-dragover');
                const dropped = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
                if (!dropped) return;
                const dt = new DataTransfer();
                dt.items.add(dropped);
                receiptInput.files = dt.files;
                syncReceiptName();
            });
        }

        // El prefijo del monto sigue a la moneda elegida, para que no quede "$" sobre un importe en USD.
        const currencySel = document.getElementById('paymentCurrency');
        const amountPrefix = document.getElementById('paymentAmountPrefix');
        if (currencySel && amountPrefix) {
            currencySel.addEventListener('change', () => {
                amountPrefix.textContent = currencySel.value === 'USD' ? 'USD $' : '$';
            });
        }
    }

    // Refresh the Financial Summary numbers + el carrito desde un summary de respuesta (POST/PUT/DELETE)
    // o de GET, sin recargar la página. Guarda el summary AMPLIO para poblar el offcanvas.
    function applyPaymentSummary(summary) {
        if (!summary) return;
        latestSummary = summary;
        if (reservationData.payment) Object.assign(reservationData.payment, summary);
        else reservationData.payment = { ...summary };
        renderFinancialSummary();
        renderPaymentBar();
        renderPaymentsOffcanvas();
        // Si el panel se abrió antes de que llegara el summary, este es el momento de desplegar el alta.
        maybeOpenAddForm();
    }

    // "Agregar pago" (header): abre el carrito. El formulario queda colapsado detrás de
    // "Registrar pago" dentro del panel (menos amontonado al abrir).
    // "Agregar pago" vive dentro del hero (re-renderizado por renderFinancialSummary), así que se
    // cablea por delegación sobre el contenedor estable del Resumen Financiero.
    // El comparativo vive ahora dentro del carrito, así que sus eventos cuelgan del panel de pagos y
    // no de la tarjeta financiera, que dejó de existir. "Agregar pago" del hero también se fue: la
    // barra del pie tiene su propio botón.
    // "Registrar pago" (dentro del carrito): muestra el formulario de nuevo pago sin reabrir el panel.
    // Cierra antes cualquier edición inline abierta en el historial (un solo formulario a la vez).
    document.getElementById('showPaymentFormBtn')?.addEventListener('click', () => {
        closePaymentForm();
        renderPaymentForm(null);
    });
    // Cerrar el carrito (backdrop-click / Escape / botón) descarta el formulario en silencio (H5).
    // El alta sale desplegada al abrir el panel: no hay más razón para abrirlo. El intento se repite
    // al llegar el summary (applyPaymentSummary), porque el formulario necesita availableMethods para
    // poblar el select de método y sin él saldría vacío y con el guardado bloqueado.
    document.getElementById('paymentsOffcanvas')?.addEventListener('shown.bs.offcanvas', () => {
        pendingAddForm = true;
        maybeOpenAddForm();
    });

    document.getElementById('paymentsOffcanvas')?.addEventListener('hidden.bs.offcanvas', () => {
        // Cerrar con el summary aún en vuelo dejaría la bandera levantada y el formulario se abriría solo
        // la próxima vez, sin que nadie lo pidiera.
        pendingAddForm = false;
        closePaymentForm();
    });

    async function savePayment(paymentId) {
        const amount = parseAmount(document.getElementById('paymentAmount').value);
        const paidAt = document.getElementById('paymentPaidAt').value;
        const method = document.getElementById('paymentMethod').value;
        const receivedByEl = document.getElementById('paymentReceivedBy');
        const receivedBy = receivedByEl ? receivedByEl.value.trim() : '';

        if (!amount || amount <= 0) { pmToast('El monto debe ser mayor a 0', 'warning'); return; }
        if (amount > 100000000) { pmToast('El monto no puede exceder 100,000,000', 'warning'); return; }
        if (!paidAt) { pmToast('La fecha de pago es obligatoria', 'warning'); return; }
        if (method === 'efectivo' && !receivedBy) { pmToast('Indica quién recibió el efectivo', 'warning'); return; }

        const payload = {
            amount,
            currency: document.getElementById('paymentCurrency').value,
            method,
            reference: document.getElementById('paymentReference').value.trim(),
            notes: document.getElementById('paymentNotes').value.trim(),
        };
        if (paidAt) payload.paidAt = paidAt;
        if (receivedBy) payload.receivedBy = receivedBy;

        // Receipt (optional) — validated here but uploaded in a SEPARATE request AFTER the payment is
        // saved (see uploadReceipt). The receipt no longer travels inside the payment save, so a slow
        // S3 upload can never block or lose the payment itself.
        const fileInput = document.getElementById('paymentReceipt');
        const file = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
        if (file) {
            if (file.size > 10 * 1024 * 1024) { pmToast('El comprobante supera el límite de 10MB', 'warning'); return; }
            if (!/^image\//.test(file.type) && file.type !== 'application/pdf') { pmToast('El comprobante debe ser imagen o PDF', 'warning'); return; }
        }

        const isEdit = !!paymentId;
        const url = isEdit
            ? `/api/reservations/${reservationId}/payments/${paymentId}`
            : `/api/reservations/${reservationId}/payments`;
        const httpMethod = isEdit ? 'PUT' : 'POST';
        // Snapshot the current payment count so a LOST response can be reconciled afterwards:
        // the request usually reaches the server and saves even when the reply never comes back.
        const prevCount = paymentsCache.length;

        const btn = document.getElementById('savePaymentBtn');
        if (btn) btn.disabled = true;
        try {
            const response = await fetch(url, {
                method: httpMethod,
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });
            // Read the raw body first so a non-JSON response (e.g. an HTML error page) surfaces a
            // clear message instead of the generic "Error al guardar el pago".
            const rawBody = await response.text();
            let result;
            try {
                result = JSON.parse(rawBody);
            } catch (parseErr) {
                pmToast(`Error del servidor (HTTP ${response.status})`, 'error');
                if (btn) btn.disabled = false;
                return;
            }
            if (result.success) {
                const savedId = result.data?.payment?.id || paymentId;
                // Upload the receipt in its own request now that the payment is safely saved. If it
                // fails, the payment stays — we just warn so the user can retry the comprobante.
                let receiptWarn = result.warning || null;
                if (file && savedId) receiptWarn = await uploadReceipt(savedId, file);
                closePaymentForm();
                applyPaymentSummary(result.data?.summary);
                await loadPayments();
                if (receiptWarn) pmToast(receiptWarn, 'warning');
                else pmToast('Pago guardado', 'success');
            } else {
                // Build a clear message from the real reason (status + server detail/code).
                let msg = result.error || 'No se pudo guardar el pago';
                if (result.detail) msg += ` — ${result.detail}`;
                if (response.status === 401) {
                    msg = `Sesión/token inválido (${result.detail || result.code || '401'}). Recarga la página (Ctrl+Shift+R) e intenta de nuevo.`;
                }
                pmToast(msg, 'error');
                if (btn) btn.disabled = false;
            }
        } catch (err) {
            // Network error (e.g. "Failed to fetch"): the request commonly reaches the server and
            // saves even though the response is lost in transit (connection dropped). Instead of a
            // false failure, reconcile from the server — the same thing a manual Ctrl+R would show.
            console.error('Save payment network error, reconciling from server:', err);
            await loadPayments(); // refreshes paymentsCache + saldo
            let saved = !isEdit && paymentsCache.length > prevCount;
            if (!saved && !isEdit) {
                // The save may still be finishing — give it one more reload before giving up.
                await new Promise((resolve) => setTimeout(resolve, 700));
                await loadPayments();
                saved = paymentsCache.length > prevCount;
            }
            if (saved) {
                closePaymentForm();
                pmToast('Pago guardado (se recuperó tras un corte de conexión)', 'success');
            } else if (isEdit) {
                closePaymentForm();
                pmToast('La respuesta se perdió, pero la lista ya se actualizó — verifica que el pago sea correcto.', 'warning');
            } else {
                pmToast('No se pudo confirmar el guardado. Revisa la lista; si el pago no aparece, regístralo otra vez.', 'warning');
                if (btn) btn.disabled = false;
            }
        }
    }

    // ---- Styled confirm + toasts (replace the native confirm/alert in the payments card) ----
    const pmEsc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // `icon` deja que quien confirma use el mismo símbolo de su botón, en vez del genérico.
    // El default era `ti-help-circle`, que NO existe en este icon font: el círculo del modal salía
    // vacío en TODA confirmación no destructiva, no solo en las nuevas. El que existe es `ti-help`.
    function pmConfirm({
        title = 'Confirmar', message = '', confirmText = 'Aceptar', danger = false, icon: iconName = '',
    } = {}) {
        return new Promise((resolve) => {
            let el = document.getElementById('pmConfirmModal');
            if (!el) {
                document.body.insertAdjacentHTML('beforeend', `
                    <div class="modal fade" id="pmConfirmModal" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg" style="border-radius:0.85rem;overflow:hidden">
                          <div class="modal-body text-center px-4 pt-4 pb-2">
                            <div data-pm-icon class="d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;border-radius:50%"></div>
                            <h5 class="fw-bold mb-2" data-pm-title></h5>
                            <p class="text-muted mb-0" data-pm-msg></p>
                          </div>
                          <div class="modal-footer border-0 justify-content-center pt-1 pb-4 gap-2">
                            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn px-4" data-pm-ok></button>
                          </div>
                        </div>
                      </div>
                    </div>`);
                el = document.getElementById('pmConfirmModal');
            }
            el.querySelector('[data-pm-title]').textContent = title;
            el.querySelector('[data-pm-msg]').textContent = message;
            const icon = el.querySelector('[data-pm-icon]');
            icon.classList.remove('bg-danger-subtle', 'text-danger', 'bg-primary-subtle', 'text-primary');
            icon.classList.add(danger ? 'bg-danger-subtle' : 'bg-primary-subtle', danger ? 'text-danger' : 'text-primary');
            icon.innerHTML = `<i class="ti ${pmEsc(iconName || (danger ? 'ti-alert-triangle' : 'ti-help'))}" style="font-size:1.75rem"></i>`;
            const old = el.querySelector('[data-pm-ok]');
            const ok = old.cloneNode(true);
            ok.textContent = confirmText;
            ok.className = `btn px-4 ${danger ? 'btn-danger' : 'btn-primary'}`;
            old.replaceWith(ok);
            const modal = bootstrap.Modal.getOrCreateInstance(el);
            let confirmed = false;
            ok.addEventListener('click', () => { confirmed = true; modal.hide(); });
            el.addEventListener('hidden.bs.modal', () => resolve(confirmed), { once: true });
            modal.show();
        });
    }

    function pmToast(message, type = 'info') {
        let c = document.getElementById('pmToastContainer');
        if (!c) {
            document.body.insertAdjacentHTML('beforeend', '<div id="pmToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090"></div>');
            c = document.getElementById('pmToastContainer');
        }
        const bg = {
            error: 'bg-danger text-white', success: 'bg-success text-white',
            warning: 'bg-warning text-dark', info: 'bg-dark text-white',
        }[type] || 'bg-dark text-white';
        const wrap = document.createElement('div');
        wrap.className = `toast align-items-center ${bg} border-0`;
        wrap.setAttribute('role', 'alert');
        wrap.innerHTML = `<div class="d-flex"><div class="toast-body">${pmEsc(message)}</div>`
            + `<button type="button" class="btn-close ${type === 'warning' ? '' : 'btn-close-white'} me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button></div>`;
        c.appendChild(wrap);
        const t = new bootstrap.Toast(wrap, { delay: 4500 });
        t.show();
        wrap.addEventListener('hidden.bs.toast', () => wrap.remove());
    }

    async function deletePayment(paymentId) {
        if (!(await pmConfirm({
            title: 'Eliminar pago', message: '¿Eliminar este pago? Esta acción no se puede deshacer.',
            confirmText: 'Eliminar', danger: true,
        }))) return;
        const existedBefore = paymentsCache.some((p) => p.id === paymentId);
        try {
            const response = await fetch(`/api/reservations/${reservationId}/payments/${paymentId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${authToken()}` },
            });
            const result = await response.json();
            if (result.success) {
                applyPaymentSummary(result.data?.summary);
                await loadPayments();
                pmToast('Pago eliminado', 'success');
            } else {
                pmToast(result.error || 'Error al eliminar el pago', 'error');
            }
        } catch (err) {
            // Lost response — the delete may have gone through. Reconcile from the server instead
            // of reporting a false failure (same idea as the save path).
            console.error('Delete payment network error, reconciling from server:', err);
            await loadPayments();
            const stillThere = paymentsCache.some((p) => p.id === paymentId);
            if (existedBefore && !stillThere) {
                pmToast('Pago eliminado (se recuperó tras un corte de conexión)', 'success');
            } else {
                pmToast('No se pudo confirmar la eliminación. Revisa la lista; si el pago sigue ahí, inténtalo otra vez.', 'warning');
            }
        }
    }

    // Ajuste — formulario inline (dentro del Resumen Financiero, ya no es modal).
    const adjForm = document.getElementById('adjustmentInlineForm');

    // Vista previa del impacto en el total: Total actual → Total nuevo.
    function updateAdjPreview() {
        const preview = document.getElementById('adjPreview');
        if (!preview) return;
        const type = document.querySelector('input[name="adjType"]:checked')?.value;
        const raw = parseAmount(document.getElementById('adjAmount').value);
        const isPercent = type === 'discount' && document.getElementById('adjModePercent').checked;
        const dd = reservationData || {};
        const base = (dd.payment && Number(dd.payment.total))
            || computeServicesSubtotalByType(dd.services || [], dd.paymentType) || 0;
        const curr = dd.currency || 'MXN';
        if (!raw || raw <= 0) { preview.innerHTML = ''; return; }
        const delta = isPercent ? -(base * (raw / 100)) : (type === 'discount' ? -raw : raw);
        const nuevo = Math.max(0, base + delta);
        const deltaColor = delta >= 0 ? '#b8894a' : '#4b6b3f';
        const deltaStr = `${delta >= 0 ? '+' : '-'}${formatCurrency(Math.abs(delta), curr)}`;
        preview.innerHTML = `<span class="fin-adj-delta" style="color:${deltaColor}">${deltaStr}</span>`
            + ` · Total: ${formatCurrency(base, curr)} → <strong>${formatCurrency(nuevo, curr)}</strong>`;
    }

    function openAdjustmentForm() {
        document.getElementById('adjTypeCharge').checked = true;
        document.getElementById('adjDescription').value = '';
        document.getElementById('adjAmount').value = '';
        document.getElementById('adjModeFixed').checked = true;
        document.getElementById('adjAmountModeGroup').style.display = 'none';
        document.getElementById('adjAmountPrefix').textContent = '$';
        document.getElementById('adjAmountLabel').textContent = 'Monto';
        document.getElementById('adjPreview').innerHTML = '';
        // Nota: a qué reservación/cliente se le aplica el ajuste.
        const adjNoteEl = document.getElementById('adjNote');
        if (adjNoteEl) {
            const dd = reservationData || {};
            const cli = dd.client?.companyName || dd.client?.fullName || dd.contactPerson || '';
            adjNoteEl.innerHTML = `<i class="ti ti-info-circle"></i> Se aplica al total de esta reservación`
                + `${dd.folio ? ` <strong>${PaymentBreakdownHelpers.escapeHtml(dd.folio)}</strong>` : ''}`
                + `${cli ? ` · ${PaymentBreakdownHelpers.escapeHtml(cli)}` : ''}`;
        }
        document.getElementById('addAdjustmentBtn')?.classList.add('d-none');
        if (adjForm) {
            adjForm.classList.remove('d-none');
            adjForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            document.getElementById('adjDescription').focus();
        }
    }
    function closeAdjustmentForm() {
        if (adjForm) adjForm.classList.add('d-none');
        document.getElementById('addAdjustmentBtn')?.classList.remove('d-none');
    }

    // El botón "+ Ajuste" del header alterna el formulario inline.
    document.getElementById('addAdjustmentBtn')?.addEventListener('click', () => {
        if (adjForm && !adjForm.classList.contains('d-none')) closeAdjustmentForm();
        else openAdjustmentForm();
    });
    document.getElementById('cancelAdjustmentBtn')?.addEventListener('click', closeAdjustmentForm);

    // Toggle amount mode group when discount selected
    document.querySelectorAll('input[name="adjType"]').forEach(radio => {
        radio.addEventListener('change', () => {
            const isDiscount = document.getElementById('adjTypeDiscount').checked;
            document.getElementById('adjAmountModeGroup').style.display = isDiscount ? '' : 'none';
            if (!isDiscount) {
                document.getElementById('adjModeFixed').checked = true;
                document.getElementById('adjAmountPrefix').textContent = '$';
                document.getElementById('adjAmountLabel').textContent = 'Monto';
            }
            updateAdjPreview();
        });
    });

    // Toggle amount prefix when percentage mode selected
    document.querySelectorAll('input[name="adjAmountMode"]').forEach(radio => {
        radio.addEventListener('change', () => {
            const isPercent = document.getElementById('adjModePercent').checked;
            document.getElementById('adjAmountPrefix').textContent = isPercent ? '%' : '$';
            document.getElementById('adjAmountLabel').textContent = isPercent ? 'Porcentaje' : 'Monto';
            updateAdjPreview();
        });
    });

    attachThousands(document.getElementById('adjAmount'));
    document.getElementById('adjAmount')?.addEventListener('input', updateAdjPreview);
    // Enter en Descripción/Monto guarda el ajuste.
    adjForm?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && (e.target.id === 'adjDescription' || e.target.id === 'adjAmount')) {
            e.preventDefault();
            document.getElementById('saveAdjustmentBtn')?.click();
        }
    });

    document.getElementById('saveAdjustmentBtn')?.addEventListener('click', async () => {
        const type = document.querySelector('input[name="adjType"]:checked').value;
        const description = document.getElementById('adjDescription').value.trim();
        const rawValue = parseAmount(document.getElementById('adjAmount').value);
        const isPercent = type === 'discount' && document.getElementById('adjModePercent').checked;

        if (!description) { pmToast('La descripción es requerida', 'warning'); return; }
        if (!rawValue || rawValue <= 0) { pmToast('El valor debe ser mayor a 0', 'warning'); return; }
        if (isPercent && rawValue > 100) { pmToast('El porcentaje no puede ser mayor a 100', 'warning'); return; }

        const payload = { type, description };
        if (isPercent) {
            payload.percentage = rawValue;
        } else {
            payload.amount = rawValue;
        }

        // Loader en Guardar (y deshabilita Cancelar) durante el POST + recarga, para que se vea
        // que está trabajando. En éxito, loadReservation re-renderiza; solo restauramos en error.
        const btn = document.getElementById('saveAdjustmentBtn');
        const cancelBtn = document.getElementById('cancelAdjustmentBtn');
        const originalBtn = btn.innerHTML;
        btn.disabled = true;
        if (cancelBtn) cancelBtn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:.8rem;height:.8rem;border-width:.13em;"></span>';
        try {
            const response = await fetch(`/api/reservations/${reservationId}/adjustments`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload),
            });
            const result = await response.json();
            if (result.success) {
                closeAdjustmentForm();
                await loadReservation();
                pmToast('Ajuste agregado', 'success');
            } else {
                pmToast(result.error || 'Error al agregar ajuste', 'error');
            }
        } catch (err) {
            console.error('Add adjustment error:', err);
            pmToast('Error al agregar ajuste', 'error');
        }
        btn.disabled = false;
        if (cancelBtn) cancelBtn.disabled = false;
        btn.innerHTML = originalBtn;
    });

    // Cancel functionality now handled by shared utilities

    await loadReservation();
});

document.addEventListener('click', function(e) {
    const trigger = e.target.closest('.photo-preview-trigger');
    if (!trigger) return;
    document.getElementById('photoPreviewImg').src = trigger.dataset.photo;
    document.getElementById('photoPreviewName').textContent = trigger.dataset.name;
    new bootstrap.Modal(document.getElementById('photoPreviewModal')).show();
});
</script>

