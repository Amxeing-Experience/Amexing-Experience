    document.getElementById('saveAssignmentBtn')?.addEventListener('click', async function() {
        const serviceId = document.getElementById('assignServiceId')?.value
            || document.querySelector('#assignModalBody input[type="hidden"]')?.value;
        if (!serviceId) return;

        const driverSelects = document.querySelectorAll('.assign-driver-select');
        const vehicleSelects = document.querySelectorAll('.assign-vehicle-select');

        // Primary assignment (index 0)
        const driverId = driverSelects[0]?.value || '';
        const vehicleId = vehicleSelects[0]?.value || '';
        const guideId = document.getElementById('assignGuide')?.value || '';
        const greeterId = document.getElementById('assignGreeter')?.value || '';
        const serviceCustomerId = document.getElementById('assignServiceCustomer')?.value || '';

        // Extra assignments (index 1+)
        const extraAssignments = [];
        for (let i = 1; i < driverSelects.length; i++) {
            const eDriverId = driverSelects[i]?.value || '';
            const eVehicleId = vehicleSelects[i]?.value || '';
            const driverOpt = driverSelects[i]?.selectedOptions[0];
            const vehicleOpt = vehicleSelects[i]?.selectedOptions[0];
            extraAssignments.push({
                driverId: eDriverId,
                vehicleId: eVehicleId,
                driverName: eDriverId ? (driverOpt?.textContent?.split(' · ')[0]?.trim() || '') : '',
                vehicleName: eVehicleId ? (vehicleOpt?.dataset?.name || vehicleOpt?.textContent?.trim() || '') : '',
            });
        }

        try {
            const response = await fetch(`/api/reservations/${reservationId}/services/${serviceId}/assign`, {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${authToken()}`,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ driverId, guideId, greeterId, vehicleId, serviceCustomerId, extraAssignments }),
            });

            const result = await response.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('assignModal'))?.hide();
                await loadReservation();
            } else {
                alert(result.error || 'Error al guardar asignacion');
