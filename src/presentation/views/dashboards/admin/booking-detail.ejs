<%
/**
 * Booking Detail Page
 * Admin dashboard page for viewing and managing a single reservation
 *
 * @author Denisse Maldonado
 * @version 1.0.0
 */
%>

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/dashboard/admin/bookings" class="text-decoration-none">Reservaciones</a></li>
                        <li class="breadcrumb-item active" id="breadcrumbFolio">Cargando...</li>
                    </ol>
                </nav>
                <h2 class="mb-0 fw-bold" id="pageTitle">
                    <i class="ti ti-clipboard-list me-2 text-primary"></i>
                    Reservacion
                </h2>
            </div>
            <div id="headerActions"></div>
        </div>
    </div>
</div>

<!-- Loading State -->
<div id="loadingState" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
    <p class="text-muted mt-2">Cargando reservacion...</p>
</div>

<!-- Reservation Content -->
<div id="reservationContent" style="display: none;">
    <!-- Info Card -->
    <style>
      /* Sin overflow:hidden ni rejilla dibujada: el bloque se lee por su AIRE, no por las cajas. Antes
         cada dato vivia en una celda con lineas por dos de sus lados —un box-shadow inset— y el
         conjunto parecia una tabla de base de datos. Ahora el unico trazo es el borde de la tarjeta. */
      .bkg-info{border:1px solid #ece8dd;border-radius:14px;background:#fff;padding:24px 26px 20px;}
      .bkg-top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;}
      .bkg-title{font-size:1.35rem;font-weight:700;color:#2b2b2b;line-height:1.2;word-break:break-word;}
      .bkg-status{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end;}
      #infoServiceCustomer{font-weight:600;color:#2b2b2b;}
      /* Badges de estado suavizados SOLO en la tarjeta de info (paleta de marca, sin tocar las
         funciones compartidas getQuoteStatusBadge / getReservationOverallStatusBadge). */
      .bkg-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px 32px;margin-top:26px;}
      .bkg-tile{min-width:0;}
      /* Celda sin dato (hoy solo Lead Guest): se oculta el CONTENIDO, no la celda. Con d-none la celda
         salia del flujo del grid y todo lo de atras se recorria una posicion, cambiando el orden de las
         demas. Asi conserva su lugar en la rejilla, y visibility:hidden ademas la saca del
         arbol de accesibilidad (el lector no anuncia "Lead Guest —"). */
      .bkg-tile.is-empty > *{visibility:hidden;}
      @media(max-width:992px){.bkg-grid{grid-template-columns:repeat(2,1fr);}}
      @media(max-width:576px){.bkg-grid{grid-template-columns:1fr;}}
      .bkg-lbl{display:flex;align-items:center;gap:6px;text-transform:uppercase;letter-spacing:.07em;font-size:.72rem;
        font-weight:700;color:#8a8f78;margin-bottom:6px;}
      .bkg-lbl i{font-size:1.05rem;color:#6E7A50;}
      .bkg-val{font-size:1.08rem;font-weight:600;color:#2b2b2b;word-break:break-word;line-height:1.35;}
      .bkg-link{color:#566040;text-decoration:none;}
      .bkg-link:hover{text-decoration:underline;}
      .bkg-dates{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
      .bkg-arrow{color:#8a8f78;font-weight:400;}
      .bkg-sub{font-size:.72rem;color:#8a8f78;margin-top:5px;font-style:italic;}
      .bkg-progress{margin-top:9px;height:6px;border-radius:999px;background:#eceadf;overflow:hidden;max-width:180px;}
      .bkg-progress > span{display:block;height:100%;width:0;border-radius:999px;background:#6E7A50;transition:width .35s ease;}
      .bkg-count{font-size:1.35rem;font-weight:700;line-height:1;}
      .bkg-count-total{font-size:1.05rem;font-weight:600;color:#8a8f78;}
      .bkg-count-cap{font-size:.66rem;text-transform:uppercase;letter-spacing:.07em;color:#8a8f78;font-weight:700;margin-left:7px;}
      .bkg-extra{margin-top:26px;}
      /* Notas de la cotización: mismo patrón que los tiles (etiqueta en versalitas + valor), sin la
         caja gris ni el filete ámbar que tenía, y ahora tampoco el borde superior. Se separa por el
         mismo aire que la rejilla. Va a un cuerpo de texto normal en vez del .bkg-val de los tiles:
         son párrafos, no un dato de una línea. */
      .bkg-note{font-size:.95rem;color:#4a4a44;line-height:1.5;white-space:pre-line;word-break:break-word;}
      /* Resumen Financiero */
      .fin-hero{padding-bottom:18px;margin-bottom:16px;border-bottom:1px solid #ece8dd;}
      .fin-hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;}
      .fin-hero-lbl{text-transform:uppercase;letter-spacing:.12em;font-size:.64rem;font-weight:700;color:#8a8f78;
        display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
      .fin-hero-total{font-size:1.9rem;font-weight:700;color:#2b2b2b;line-height:1.1;margin-top:2px;}
      .fin-hero-pct{margin-top:15px;text-align:right;font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#8a8f78;}
      .fin-bar{margin:5px 0 12px;height:8px;border-radius:999px;background:#f0e5d0;overflow:hidden;}
      /* Badge de estado suavizado SOLO en el hero (no toca getPaymentStatusBadge compartido) */
      /* Botón "Agregar pago": pastilla olivo sólida, limpia y on-brand */
      .fin-pay-btn{display:inline-flex;align-items:center;gap:6px;background:#6E7A50;color:#fff;border:1px solid #6E7A50;
        border-radius:999px;font-size:.8rem;font-weight:600;padding:.42rem .95rem;line-height:1.2;transition:background .12s,border-color .12s;}
      .fin-pay-btn:hover{background:#566040;border-color:#566040;color:#fff;}
      .fin-pay-btn:disabled{opacity:.6;}
      .fin-bar > span{display:block;height:100%;width:0;border-radius:999px;background:#6E7A50;transition:width .35s ease;}
      .fin-hero-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end;}
      .fin-hero-method{display:inline-flex;align-items:center;gap:5px;font-size:.68rem;font-weight:700;text-transform:uppercase;
        letter-spacing:.05em;color:#566040;background:#eef0e6;border:1px solid #dce2d0;border-radius:999px;padding:.2rem .6rem;
        cursor:pointer;font-family:inherit;line-height:1.2;}
      .fin-hero-method:hover{background:#e4e8d8;border-color:#c9d2b8;}
      .fin-hero-method i{font-size:.9rem;}
      .fin-chev{font-size:.9rem;margin-left:2px;}
      .fin-cmp-inline{margin-top:14px;padding:14px;border:1px solid #e6e1d5;border-radius:12px;background:#fbfaf6;}
      .fin-cmp-inline .fin-cmp-cap{margin-bottom:8px;}
      .fin-hero-hint{display:inline-flex;align-items:center;gap:5px;margin-top:7px;font-size:.75rem;font-weight:600;color:#4b6b3f;}
      .fin-hero-hint i{font-size:.95rem;}
      .fin-hero-foot{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;}
      .fin-hero-foot .lbl{font-size:.62rem;text-transform:uppercase;letter-spacing:.06em;color:#8a8f78;font-weight:700;}
      .fin-hero-foot .val{font-weight:700;font-size:1.05rem;line-height:1.2;}
      .fin-savings{margin-top:12px;padding-top:10px;border-top:1px dashed #d8cfb8;color:#4b6b3f;}
      .fin-sec-title{text-transform:uppercase;letter-spacing:.14em;font-size:.64rem;font-weight:700;color:#566040;margin:4px 0 4px;}
      .fin-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid #f1efe8;}
      .fin-row:last-child{border-bottom:0;}
      .fin-row .lbl{color:#6b6656;display:flex;align-items:center;gap:8px;min-width:0;}
      .fin-row .lbl i{color:#8a8f78;flex-shrink:0;}
      .fin-row .val{font-weight:600;color:#2b2b2b;white-space:nowrap;}
      .fin-charge{color:#b8894a !important;}
      .fin-discount{color:#4b6b3f !important;}
      .fin-tip{color:#8a7d52 !important;}
      /* Ajuste inline (una línea, debajo del desglose) */
      .fin-add-adj{background:none;border:1px dashed #d8cfb8;color:#566040;font-weight:600;font-size:.8rem;
        border-radius:8px;padding:.4rem .85rem;margin-top:10px;transition:background .12s,border-color .12s;}
      .fin-add-adj:hover{background:#f6f5ef;border-color:#8b9668;color:#3f5a34;}
      .fin-adj{margin-top:10px;padding:12px 14px;border:1px solid #e6e1d5;border-radius:12px;background:#fbfaf6;}
      .fin-adj-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
      .fin-adj-desc{flex:1 1 170px;min-width:150px;}
      .fin-adj-amt{width:132px;flex:0 0 auto;}
      .fin-seg{display:inline-flex;border:1px solid #ded9cb;border-radius:9px;overflow:hidden;background:#fff;}
      .fin-seg-btn{cursor:pointer;margin:0;padding:.42rem 1rem;font-size:.85rem;font-weight:600;color:#6b6656;
        display:inline-flex;align-items:center;user-select:none;transition:background .12s,color .12s;}
      .fin-seg-sm .fin-seg-btn{padding:.28rem .75rem;font-size:.78rem;}
      .fin-seg .fin-seg-btn:not(:first-of-type){border-left:1px solid #ded9cb;}
      .fin-seg .btn-check:checked + .fin-seg-charge{background:#b8894a;color:#fff;}
      .fin-seg .btn-check:checked + .fin-seg-discount{background:#6E7A50;color:#fff;}
      .fin-seg .btn-check:checked + .fin-seg-btn{background:#6E7A50;color:#fff;}
      .fin-adj-preview{font-size:.85rem;color:#6b6656;}
      .fin-adj-preview:empty{display:none;}
      .fin-adj-delta{font-weight:700;}
      .fin-adj-note{display:flex;align-items:center;gap:6px;font-size:.76rem;color:#8a8f78;margin-top:8px;}
      .fin-adj-note i{color:#b8894a;}
      /* Contenedor minimalista (como la tarjeta de info de arriba) */
      .fin-wrap{border:1px solid #ece8dd;border-radius:14px;background:#fff;padding:20px 22px;}
      .fin-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;
        margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #ece8dd;}
      .fin-section-title{margin:0;font-weight:700;color:#566040;font-size:1.1rem;display:flex;align-items:center;}
      /* Comparativo por método de pago */
      .fin-cmp-cap{font-size:.72rem;color:#8a8f78;margin-bottom:8px;}
      .fin-cmp-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 12px;
        border:1px solid #f0ece2;border-radius:9px;margin-bottom:6px;}
      .fin-cmp-row:last-child{margin-bottom:0;}
      .fin-cmp-row.active{border-color:#c9d2b8;background:#f4f7ee;}
      .fin-cmp-method{display:flex;align-items:center;gap:8px;color:#4a4a44;font-weight:600;}
      .fin-cmp-method i{color:#8a8f78;}
      .fin-cmp-right{display:flex;align-items:center;gap:10px;}
      .fin-cmp-amount{font-weight:700;color:#2b2b2b;}
      .fin-cmp-delta{font-weight:700;font-size:.82rem;white-space:nowrap;}
      .fin-cmp-badge{font-size:.6rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:#566040;
        background:#e7ecdd;border-radius:6px;padding:.16rem .5rem;}
      .fin-cmp-cheap{font-size:.58rem;text-transform:uppercase;letter-spacing:.05em;font-weight:700;color:#3f5a34;
        background:#e6efe1;border:1px solid #cfe0c6;border-radius:6px;padding:.08rem .42rem;}
    </style>
    <div class="bkg-info mb-4">
        <!-- Cliente a la izquierda, Estado a la derecha; el folio ya está en el título.
             Customer Support BAJÓ a la rejilla: aquí arriba vivía en un flex con otro gap, así que
             su columna no coincidía con la de Contacto —dos retículas encimadas en una tarjeta que
             se lee por columnas—. En la rejilla, además, completa las cuatro celdas: antes eran
             tres campos en cuatro columnas y el cuarto de ancho quedaba muerto. -->
        <div class="bkg-top">
            <div>
                <div class="bkg-lbl"><i class="ti ti-building"></i> Cliente</div>
                <div class="bkg-title" id="infoClient">&mdash;</div>
            </div>
            <div class="bkg-status" id="infoStatus">&mdash;</div>
        </div>

        <!-- Datos en tiles -->
        <div class="bkg-grid">
            <div class="bkg-tile">
                <div class="bkg-lbl"><i class="ti ti-headset"></i> Customer Support</div>
                <div id="serviceCustomerRow"><span id="infoServiceCustomer">&mdash;</span></div>
            </div>
            <div class="bkg-tile">
                <div class="bkg-lbl"><i class="ti ti-file-invoice"></i> Cotización</div>
                <a href="#" id="infoQuoteLink" class="bkg-val bkg-link">&mdash;</a>
            </div>
            <div class="bkg-tile">
                <div class="bkg-lbl"><i class="ti ti-mail"></i> Contacto</div>
                <div class="bkg-val" id="infoContact">&mdash;</div>
            </div>
            <div class="bkg-tile">
                <div class="bkg-lbl"><i class="ti ti-plane"></i> Motivo de viaje</div>
                <div class="bkg-val" id="infoEventType">&mdash;</div>
            </div>
        </div>

        <!-- Notas de la cotización (solo cuando existen) -->
        <div class="bkg-extra d-none" id="infoQuoteNotesRow">
            <div class="bkg-lbl"><i class="ti ti-notes"></i> Notas</div>
            <div class="bkg-note" id="infoQuoteNotes"></div>
        </div>
    </div>

    <!-- Resumen Financiero (sin panel blanco: encabezado de sección + contenido directo) -->
    <!-- El Resumen Financiero dejó de ser una tarjeta en medio de la página. Sus cifras clave viven
         ahora en la barra fija del pie —siempre a la vista mientras se asigna— y su desglose completo
         en el carrito, que es donde además se registra el pago. Antes esos cinco números estaban en
         los dos lugares a la vez. -->
    <div id="financialSummaryBody" class="d-none"></div>

    <!-- Services by Day -->
    <div class="svc-wrap">
        <!-- El encabezado del panel es el DOCUMENTO, no el rótulo de la sección. "Servicios" nombraba
             lo que ya se ve —una lista de traslados y tours con sus iconos— y era uno de dos títulos
             cuando existía el Resumen Financiero; ese se fue a la barra fija, así que ya no distingue
             de nada. En su lugar encabezan las fechas, que es como se identifica un itinerario.
             Eran dos filas de encabezado apiladas (rótulo + exportar, luego identidad + avance);
             ahora es una: identidad a la izquierda, exportar y avance a la derecha. -->
        <div class="svc-doc" id="svcDocLine">
            <div class="svc-doc-id">
                <h5 class="svc-doc-quien" id="docTitulo">&mdash;</h5>
                <div class="svc-doc-pax d-none" id="docPax"></div>
                <div class="svc-doc-meta" id="docMeta"></div>
            </div>
            <div class="svc-doc-acciones">
                <!-- Dos acciones sobre el mismo documento, en el segmento que la página ya usa para
                     exportar: ver en pantalla y descargar. Antes era un solo control, así que solo se
                     podía hacer una de las dos. -->
                <span class="hdr-seg d-none" id="exportItinerarySeg" role="group" aria-label="Itinerario">
                    <a class="hdr-seg-btn" id="previewItineraryBtn" href="#" target="_blank" rel="noopener"
                       title="Ver el itinerario en pantalla"><i class="ti ti-eye"></i>Ver itinerario</a>
                    <a class="hdr-seg-btn" id="downloadItineraryBtn" href="#"
                       title="Descargar el itinerario en PDF"><i class="ti ti-download"></i>PDF</a>
                </span>
                <div class="svc-doc-avance">
                    <div class="svc-doc-avance-linea">
                        <span class="svc-doc-cap">Asignación</span>
                        <span class="svc-doc-cifra" id="docAssignCounter"></span>
                    </div>
                    <div class="svc-doc-barra d-none" id="docAssignProgress"><span id="docAssignBar"></span></div>
                </div>
            </div>
        </div>
        <div id="servicesContainer">
            <!-- Services will be rendered here -->
        </div>
    </div>
</div>

<!-- Barra de cobranza: el saldo acompaña mientras se trabaja, sin ocupar un bloque en el flujo.
     Nace oculta y la descubre renderPaymentBar() cuando llega el summary del servidor. -->
<div class="pay-bar d-none" id="payBar">
  <div class="pay-bar-inner">
    <div class="pay-bar-cifra">
      <span class="pay-bar-lbl">Saldo</span>
      <span class="pay-bar-val" id="payBarSaldo">&mdash;</span>
    </div>
    <div class="pay-bar-prog">
      <div class="pay-bar-track"><span id="payBarFill"></span></div>
      <div class="pay-bar-pie">
        <span id="payBarDetalle"></span>
        <span class="pay-bar-derecha">
          <!-- Qué método se está cobrando. Sin esto, el total de la barra no dice de cuál de los tres
               precios habla: cambiarlo mueve la cifra en decenas de miles. El comparativo vive en el
               carrito, así que aquí sólo se nombra. -->
          <span class="pay-bar-metodo" id="payBarMetodo"></span>
          <span id="payBarEstado"></span>
        </span>
      </div>
    </div>
    <div class="pay-bar-acciones">
      <button type="button" class="pay-bar-btn is-primaria" id="payBarPagarBtn">Agregar pago</button>
    </div>
  </div>
</div>

<!-- Assign Employee Modal -->
<!-- El formulario completo de asignación se retiró: permitía asignar guía, greeter o chofer que el
     servicio NO contrató, y esa es una regla del negocio, no una comodidad. Los círculos de la lista
     solo ofrecen lo contratado, así que ahora son la única vía y la regla queda impuesta en la UI.
     Lo ya asignado fuera de contrato sigue siendo visible y corregible desde su propio círculo. -->

<!-- El modal de Customer Support se retiró: el chip del encabezado usa el mismo selector que los
     círculos de los servicios (slot-kind="res-support"), así que había dos formas de hacer lo mismo. -->

<!-- Pagos — Offcanvas (Bootstrap 5 nativo). Reemplaza la antigua #paymentsCard: chips por método,
     cobertura, saldo restante por método, énfasis de descuento, historial y (admin) el formulario de
     registro. Se abre con "Agregar pago" del Resumen Financiero. Ancho 680px; full-width bajo el
     breakpoint sm (576px) nativo de Bootstrap. -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="paymentsOffcanvas" aria-labelledby="paymentsOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title mb-0" id="paymentsOffcanvasLabel"><i class="ti ti-cash me-2"></i>Pagos</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body">
        <!-- Tabs: Pago (resumen + registrar + por método) | Historial -->
        <ul class="nav payments-seg mb-3" id="paymentsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tabPagoBtn" data-bs-toggle="tab" data-bs-target="#tabPago" type="button" role="tab" aria-selected="true"><i class="ti ti-cash me-1"></i>Pago</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tabHistorialBtn" data-bs-toggle="tab" data-bs-target="#tabHistorial" type="button" role="tab" aria-selected="false"><i class="ti ti-history me-1"></i>Historial <span id="historialCount" class="badge rounded-pill ms-1" style="background:#eef0e6;color:#566040;"></span></button>
            </li>
        </ul>
        <div class="tab-content">
            <!-- TAB PAGO -->
            <div class="tab-pane fade show active" id="tabPago" role="tabpanel" aria-labelledby="tabPagoBtn">
                <!-- Card de cobertura (total + estado + barra + Pagado/Saldo) -->
                <div id="paymentCoverageCard"></div>
                <!-- Desglose: subtotal, propinas y ajustes. Vivía en una tarjeta de la página, lejos
                     del lugar donde se registra el pago que lo modifica. -->
                <!-- Comparativo por método: ANTES estaba dos veces en el mismo carrito —una tabla de
                     cuatro columnas al fondo y un collapse que se abría desde el chip de "Tipo de
                     pago"—, con los mismos tres métodos. Queda uno solo, plano y siempre visible:
                     cuánto costaría con cada método y la diferencia contra el vigente. -->
                <div class="pay-sec collapse" id="payCmpSec">
                    <div class="pay-cap">Total según el método</div>
                    <div id="payCmp"></div>
                </div>
                <div class="pay-sec">
                    <div class="pay-cap">Desglose</div>
                    <div id="payDesglose" class="pay-desglose"></div>
                <!-- Agregar ajuste: vivía en la tarjeta financiera de la página. Al mudarse el
                     desglose aquí, su disparador tenía que venir con él o admin se quedaba viendo
                     los ajustes sin poder crear uno. Sigue siendo admin-only. -->
                <button type="button" id="addAdjustmentBtn" class="fin-add-adj d-none"><i class="ti ti-plus me-1"></i>Agregar ajuste</button>
                <div id="adjustmentInlineForm" class="fin-adj d-none">
                    <div class="fin-adj-row">
                        <div class="fin-seg fin-seg-sm" role="group" aria-label="Tipo de ajuste">
                            <input type="radio" class="btn-check" name="adjType" id="adjTypeCharge" value="charge" checked>
                            <label class="fin-seg-btn fin-seg-charge" for="adjTypeCharge">Cargo</label>
                            <input type="radio" class="btn-check" name="adjType" id="adjTypeDiscount" value="discount">
                            <label class="fin-seg-btn fin-seg-discount" for="adjTypeDiscount">Descuento</label>
                        </div>
                        <input type="text" class="form-control form-control-sm fin-adj-desc" id="adjDescription" maxlength="150" placeholder="Descripción (ej. Estacionamiento)">
                        <div class="fin-seg fin-seg-sm" id="adjAmountModeGroup" style="display:none;">
                            <input type="radio" class="btn-check" name="adjAmountMode" id="adjModeFixed" value="fixed" checked>
                            <label class="fin-seg-btn" for="adjModeFixed" title="Monto fijo">$</label>
                            <input type="radio" class="btn-check" name="adjAmountMode" id="adjModePercent" value="percentage">
                            <label class="fin-seg-btn" for="adjModePercent" title="Porcentaje">%</label>
                        </div>
                        <div class="input-group input-group-sm fin-adj-amt">
                            <span class="input-group-text" id="adjAmountPrefix">$</span>
                            <input type="text" inputmode="decimal" maxlength="17" class="form-control" id="adjAmount" placeholder="0.00">
                        </div>
                        <button class="btn btn-sm btn-primary" id="saveAdjustmentBtn" type="button" title="Guardar"><i class="ti ti-check"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" id="cancelAdjustmentBtn" type="button" title="Cancelar"><i class="ti ti-x"></i></button>
                        <span id="adjAmountLabel" class="d-none"></span>
                    </div>
                    <div class="fin-adj-note" id="adjNote"></div>
                    <div class="fin-adj-preview" id="adjPreview"></div>
                </div>
                <!-- Acción principal: registrar pago -->
                </div>
                <button class="pay-accion d-none" id="showPaymentFormBtn"><i class="ti ti-plus me-1"></i>Registrar pago</button>
                <!-- Inline payment form (aparece bajo el botón al registrar) -->
                <div id="paymentFormWrap" style="display:none;"></div>
                <!-- Por método de pago: total + cubierto + restante (el ahorro va en el tag "Más barato") -->
            </div>
            <!-- TAB HISTORIAL -->
            <div class="tab-pane fade" id="tabHistorial" role="tabpanel" aria-labelledby="tabHistorialBtn">
                <div id="paymentsBody">
                    <!-- Payments table — rendered by JS -->
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="/shared/services/serviceList.css">
<style>
#paymentsOffcanvas { --bs-offcanvas-width: 860px; }
@media (max-width: 576px) { #paymentsOffcanvas { --bs-offcanvas-width: 100%; } }
/* Backdrop mas oscuro que el default de Bootstrap (0.5): el carrito es el unico offcanvas de esta
   vista y conviene que se lea como una capa aparte. */
.offcanvas-backdrop.show { background-color: rgba(15,23,32,0.72) !important; opacity: 1 !important; }
/* El cuerpo era gris para que "flotaran" tres tarjetas blancas con filete de acento: cobertura,
   metodos y formulario. Eran cajas dentro de un panel que YA es una superficie —marco dentro de
   marco— y ademas competian entre si por el acento. Ahora el panel es una sola hoja y lo que separa
   son los rotulos en versalitas y un filete por seccion (.pay-sec). */
#paymentsOffcanvas .offcanvas-body { background: #fff; font-size: 1rem; padding: 1.35rem 1.5rem; }
#paymentFormWrap {
    background: #fbfbf7;
    border: 1px solid #ece8dd;
    border-radius: 0.5rem;
    padding: 1rem;
    /* El alta arranca pegada a "Agregar ajuste", que es el final de la sección de arriba: sin este
       aire los dos bloques se leían como uno. Mismo respiro que separa las secciones del carrito. */
    margin: 1.4rem 0 1rem;
}
/* #paymentsBody NO lleva tarjeta: la tabla del historial ya tiene estructura propia (encabezado,
   separadores, pie), asi que el panel blanco alrededor solo sumaba un marco de mas. Se apoya directo
   sobre el gris del carrito. Tampoco lleva `overflow: hidden`: creaba un contenedor de scroll que
   anulaba el `position: sticky` del encabezado. */
/* Historial: tabla propia (.pay-hist) en vez de .table-sm.small de Bootstrap. La letra chica de antes
   (0.82rem) era la consecuencia de meter 8 columnas en 860px; al fusionar Moneda dentro de Monto,
   Recibió dentro de Referencia y Comprobante dentro de Acciones quedan 5 columnas y la letra sube a
   0.95rem sin apretar nada. */
#paymentsOffcanvas .pay-hist { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
/* Encabezado pegajoso: el contenedor de scroll es .offcanvas-body, asi que ni #paymentsBody ni un
   wrapper .table-responsive pueden tener overflow propio (crearian otro contenedor y romperian el
   sticky). Por eso el ancho chico se resuelve con la vista de tarjetas de abajo, no con scroll
   horizontal. */
#paymentsOffcanvas .pay-hist thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: #8a8f78;
    background: #f8f9fa;
    padding: 0.5rem 0.55rem;
    border-bottom: 1px solid #ddddd2;
    white-space: nowrap;
}
/* Sin panel blanco detras, las filas son transparentes y los separadores tienen que pesar un poco mas
   para seguir marcando el renglon; el blanco se reserva para el hover y la fila en edicion. */
#paymentsOffcanvas .pay-hist tbody td { padding: 0.6rem 0.55rem; vertical-align: top; border-top: 1px solid #e6e6da; }
#paymentsOffcanvas .pay-hist tbody tr:first-child td { border-top: none; }
#paymentsOffcanvas .pay-hist tbody tr:hover td { background: #fff; }
/* Columnas PAGO y REGISTRO: mismo patron (fecha arriba, persona abajo). La de pago pesa mas porque es
   el dato del negocio; la de registro es metadato de auditoria, asi que va mas chica y en gris. */
#paymentsOffcanvas .pay-hist-date { white-space: nowrap; font-weight: 600; color: #2b2b2b; }
#paymentsOffcanvas .pay-hist-meta { white-space: nowrap; font-size: 0.85rem; color: #6b6656; }
/* Persona (recibio / registro). El nombre puede ser largo: se permite que salte de linea, que es lo
   unico que puede crecer sin romper la tabla de 6 columnas. */
#paymentsOffcanvas .pay-hist-person {
    display: flex;
    align-items: flex-start;
    gap: 3px;
    font-size: 0.78rem;
    color: #8a8f78;
    margin-top: 3px;
    white-space: normal;
    line-height: 1.25;
}
#paymentsOffcanvas .pay-hist-person .ti { font-size: 0.85rem; flex: 0 0 auto; margin-top: 1px; }
#paymentsOffcanvas .pay-hist-ref { word-break: break-word; }
/* Edicion inline: la fila que se esta editando se marca con el verde de marca y el formulario cuelga
   de ella en una fila expandida, para no perder de vista CUAL pago se esta tocando. El filete va SOLO
   en la primera celda: en todas dibujaba una linea vertical por columna. */
#paymentsOffcanvas .pay-hist tbody tr.is-editing td { background: #fff; }
#paymentsOffcanvas .pay-hist tbody tr.is-editing td:first-child { box-shadow: inset 3px 0 0 #6E7A50; }
#paymentsOffcanvas .pay-hist-edit td { padding: 0; border-top: none; }
#paymentsOffcanvas .pay-hist tbody tr.pay-hist-edit:hover td { background: transparent; }
/* El contenedor del alta (#paymentFormWrap) ya trae su caja desde las reglas de arriba; el inline
   necesita la suya. .pay-form es solo tipografia, para que ambos se lean igual por dentro. */
/* En escritorio las filas de la tabla no tienen bordes laterales (solo separadores horizontales), asi
   que enmarcar el formulario como tarjeta dejaba dos lineas verticales sueltas colgando de la fila que
   se edita. Aqui es un bloque mas de la tabla: fondo blanco y un separador abajo, como cualquier otro
   renglon. Sin relleno superior —los campos arrancan pegados a su fila— pero si a los lados, porque a
   ras del borde se veian apretados. */
#paymentsOffcanvas .pay-hist-form {
    background: #fff;
    border-bottom: 1px solid #e6e6da;
    padding: 0 1rem 0.9rem;
}
/* El pie se sale del relleno lateral para que su linea divisoria corte la tarjeta completa (y el fondo
   pegajoso tape todo el ancho al hacer scroll), pero recupera el relleno por dentro para que los
   botones sigan alineados con los campos. */
#paymentsOffcanvas .pay-hist-form .pay-form-actions {
    margin-left: -1rem;
    margin-right: -1rem;
    padding-left: 1rem;
    padding-right: 1rem;
}
/* Etiqueta de contexto en el pie (reemplaza al encabezado del formulario): ocupa el hueco que ya
   existia a la izquierda de los botones, asi que no suma alto. A 0.8rem se leia como un pie de
   pagina; es el titulo de lo que se esta haciendo y debe pesar como los botones que tiene enfrente. */
#paymentsOffcanvas .pay-form-context {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-right: auto;
    align-self: center;
    font-size: 1.05rem;
    font-weight: 600;
    color: #8a8f78;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#paymentsOffcanvas .pay-form .form-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: #8a8f78;
    margin-bottom: 0.3rem;
}
#paymentsOffcanvas .pay-form .form-control,
#paymentsOffcanvas .pay-form .form-select,
#paymentsOffcanvas .pay-form .input-group-text { font-size: 0.9rem; }
/* El tema le pone border-radius propio a .form-control, asi que dentro de un .input-group el prefijo y
   el campo se dibujaban como dos cajas sueltas con un hueco. Se fuerza la union a mano. */
#paymentsOffcanvas .pay-form .input-group { flex-wrap: nowrap; }
#paymentsOffcanvas .pay-form .input-group > .input-group-text {
    background: #f7f7f2;
    color: #8a8f78;
