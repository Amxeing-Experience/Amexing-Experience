<%
/**
 * Booking Detail Page
 * Admin dashboard page for viewing and managing a single reservation
 *
 * @author Denisse Maldonado
 * @version 1.0.0
 */
%>

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/dashboard/admin/bookings" class="text-decoration-none">Reservaciones</a></li>
                        <li class="breadcrumb-item active" id="breadcrumbFolio">Cargando...</li>
                    </ol>
                </nav>
                <h2 class="mb-0 fw-bold" id="pageTitle">
                    <i class="ti ti-clipboard-list me-2 text-primary"></i>
                    Reservacion
                </h2>
            </div>
            <div id="headerActions"></div>
        </div>
    </div>
</div>

<!-- Loading State -->
<div id="loadingState" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
    <p class="text-muted mt-2">Cargando reservacion...</p>
</div>

<!-- Reservation Content -->
<div id="reservationContent" style="display: none;">
    <!-- Info Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <small class="text-muted d-block">Folio</small>
                    <strong id="infoFolio">&mdash;</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Cotización</small>
                    <a href="#" id="infoQuoteLink" class="fw-semibold text-decoration-none">&mdash;</a>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Estado</small>
                    <span id="infoStatus">&mdash;</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Fecha Creación</small>
                    <span id="infoCreatedAt">&mdash;</span>
                </div>
            </div>
            <hr>
            <div class="row g-3">
                <div class="col-md-3">
                    <small class="text-muted d-block">Cliente</small>
                    <strong id="infoClient">&mdash;</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Contacto</small>
                    <span id="infoContact">&mdash;</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Motivo de viaje</small>
                    <span id="infoEventType">&mdash;</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Personas</small>
                    <span id="infoPeople">&mdash;</span>
                </div>
            </div>
            <hr>
            <div class="row g-3">
                <div class="col-md-3">
                    <small class="text-muted d-block">Fecha Inicio</small>
                    <span id="infoStartDate">&mdash;</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Fecha Fin</small>
                    <span id="infoEndDate">&mdash;</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Tipo de Pago</small>
                    <span id="infoPaymentType">&mdash;</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Total</small>
                    <strong id="infoTotal" class="text-success fs-5">&mdash;</strong>
                </div>
            </div>
            <hr>
            <div class="row g-3">
                <div class="col-md-6">
                    <small class="text-muted d-block"><i class="ti ti-list-check me-1"></i>Servicios Asignados</small>
                    <span id="infoAssignmentCounter" class="fw-semibold">&mdash;</span>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block"><i class="ti ti-user-star me-1"></i>Seguidor de Servicio (Amexing)</small>
                    <div class="d-flex align-items-center gap-2" id="serviceCustomerRow">
                        <span id="infoServiceCustomer" class="fw-semibold">&mdash;</span>
                        <button class="btn btn-sm btn-outline-primary d-none" id="changeServiceCustomerBtn" title="Cambiar seguidor">
                            <i class="ti ti-edit"></i>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Lead guest + quote-level notes (only shown when present) -->
            <div class="d-none" id="infoLeadGuestRow">
                <hr>
                <div class="row g-3">
                    <div class="col-md-12">
                        <small class="text-muted d-block"><i class="ti ti-user me-1"></i>Lead Guest</small>
                        <span id="infoLeadGuest" class="fw-semibold">&mdash;</span>
                    </div>
                </div>
            </div>
            <div class="d-none" id="infoQuoteNotesRow">
                <hr>
                <div class="p-2 rounded" style="background: #f8f9fa; border-left: 3px solid #adb5bd;">
                    <div class="d-flex align-items-center mb-1">
                        <i class="ti ti-notes me-1 text-secondary"></i>
                        <strong class="text-secondary" style="font-size: 0.85rem;">Notas de la cotización</strong>
                    </div>
                    <div id="infoQuoteNotes" class="text-dark" style="white-space: pre-line; word-break: break-word; font-size: 0.9rem;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen Financiero + Cargos Adicionales -->
    <div class="card border-0 shadow-sm mb-4" id="financialSummaryCard" style="display:none;">
        <div class="card-header" style="background: linear-gradient(135deg, #0d9488 0%, #5eead4 100%); border: none;">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-white">
                    <i class="ti ti-calculator me-2"></i>Resumen Financiero
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-light d-none" id="addPaymentBtn">
                        <i class="ti ti-cash me-1"></i>Agregar pago
                    </button>
                    <button class="btn btn-sm btn-light d-none" id="addAdjustmentBtn">
                        <i class="ti ti-plus me-1"></i>Ajuste
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div id="financialSummaryBody">
                <!-- Resumen (totales + saldo) — rendered by JS -->
            </div>
        </div>
    </div>

    <!-- Services by Day -->
    <div class="card border-0 shadow-sm">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #059669 0%, #34d399 100%); border: none;">
            <h5 class="card-title mb-0 text-white">
                <i class="ti ti-list-details me-2"></i>Servicios
            </h5>
        </div>
        <div class="card-body p-0" id="servicesContainer">
            <!-- Services will be rendered here -->
        </div>
    </div>
</div>

<!-- Assign Employee Modal -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <div>
                    <h6 class="modal-title fw-bold mb-0" id="assignModalTitle">Asignar Personal</h6>
                    <small class="text-muted" id="assignModalSubtitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="assignModalBody">
                <input type="hidden" id="assignServiceId">
                <!-- Dynamic content rendered by JS -->
            </div>
            <div class="modal-footer border-top">
                <button class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-sm btn-primary px-4" id="saveAssignmentBtn">
                    <i class="ti ti-check me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Service Customer Modal -->
<div class="modal fade" id="serviceCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h6 class="modal-title fw-bold mb-0">Seguidor de Servicio</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="assign-icon bg-primary-subtle text-primary"><i class="ti ti-user-star"></i></span>
                    <label class="form-label mb-0 fw-semibold">Empleado Amexing</label>
                </div>
                <select id="resServiceCustomerSelect" class="form-select form-select-sm">
                    <option value="">Sin asignar</option>
                </select>
            </div>
            <div class="modal-footer border-top">
                <button class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-sm btn-primary px-4" id="saveResServiceCustomerBtn">
                    <i class="ti ti-check me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Pagos — Offcanvas (Bootstrap 5 nativo). Reemplaza la antigua #paymentsCard: chips por método,
     cobertura, saldo restante por método, énfasis de descuento, historial y (admin) el formulario de
     registro. Se abre con "Agregar pago" del Resumen Financiero. Ancho 680px; full-width bajo el
     breakpoint sm (576px) nativo de Bootstrap. -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="paymentsOffcanvas" aria-labelledby="paymentsOffcanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title mb-0" id="paymentsOffcanvasLabel"><i class="ti ti-cash me-2"></i>Pagos</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body">
        <!-- Card de cobertura (total + estado + barra + Pagado/Saldo), primero para verse sin scroll,
             con acento de marca propio (payment-coverage-highlight) para distinguirla del resto del carrito -->
        <div class="rounded p-3 mb-3 payment-coverage-highlight" id="paymentCoverageCard"></div>
        <!-- Énfasis de descuento (Fase E), justo debajo de la card de cobertura -->
        <div class="mb-3" id="paymentDiscountEmphasis" style="display:none;"></div>
        <!-- Chips por método de pago (Requisito 3) -->
        <div class="mb-3" id="paymentChips"></div>
        <!-- Desglose de saldo restante por método (Requisito 8) -->
        <div class="border rounded p-3 mb-3" id="paymentRemainingByMethod" style="display:none;"></div>
        <!-- Historial de pagos (colapsado por defecto, menos amontonado) + registro (admin) -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <button class="btn btn-sm btn-link text-decoration-none ps-0 fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#paymentsHistoryCollapse" id="paymentsHistoryToggle">
                <i class="ti ti-history me-1"></i>Historial de pagos <i class="ti ti-chevron-down ms-1" style="font-size:0.75rem;"></i>
            </button>
            <button class="btn btn-sm btn-primary d-none" id="showPaymentFormBtn"><i class="ti ti-plus me-1"></i>Registrar pago</button>
        </div>
        <!-- Inline payment form (relocated from the old card; only admin renders/uses it) -->
        <div id="paymentFormWrap" class="border rounded p-3 mb-3" style="display:none;"></div>
        <div class="collapse" id="paymentsHistoryCollapse">
            <div id="paymentsBody">
                <!-- Payments table — rendered by JS -->
            </div>
        </div>
    </div>
</div>

<style>
#paymentsOffcanvas { --bs-offcanvas-width: 760px; }
@media (max-width: 576px) { #paymentsOffcanvas { --bs-offcanvas-width: 100%; } }
/* Backdrop mas oscuro que el default de Bootstrap (0.5) para que las tarjetas blancas del carrito
   resalten mas contra el resto de la pagina (unico offcanvas de esta vista). */
.offcanvas-backdrop.show { background-color: rgba(15,23,32,0.72) !important; opacity: 1 !important; }
/* Fondo gris claro (el mismo tono de fondo de pagina del resto del dashboard, #f8f9fa) para que las
   tarjetas blancas "floten" con contraste, en vez de perderse contra un panel blanco parejo. */
#paymentsOffcanvas .offcanvas-body { background: #f8f9fa; font-size: 0.82rem; }
/* Letra mas chica en todo el carrito (chips, cobertura, historial) para que quepa mas sin sentirse
   amontonado; el historial ya trae ademas la clase Bootstrap "small" encima de esta base. Radio de
   borde explicito (0.5rem, el mismo que usan las demas cards de esta pagina) porque el `.rounded`
   por defecto de Bootstrap se veia casi recto a este tamano. */
#paymentCoverageCard.payment-coverage-highlight,
#paymentChips .payment-chip-card,
#paymentRemainingByMethod,
#paymentFormWrap {
    background: #fff;
    border: 1px solid #e0e6ed;
    border-radius: 0.5rem;
}
/* El wrapper flex que envuelve los chips (buildMethodChips) no debe tener su propio borde/fondo —
   cada chip individual ya trae el suyo via .payment-chip-card. */
#paymentChips > div { background: transparent; border: none; }
/* Card de cobertura: filete de acento del verde sage de marca (--brand-primary), en vez del degradado
   turquesa anterior (no encajaba con el resto del sistema). */
#paymentCoverageCard.payment-coverage-highlight { border-left: 4px solid #969b81; }
/* Historial: letra explicitamente chica en la tabla (mas chica que el resto del panel). */
#paymentsOffcanvas #paymentsBody table { font-size: 0.72rem; }
#paymentsOffcanvas #paymentsBody .badge { font-size: 0.68rem; }
/* Mismo radio de borde explicito para el bloque de descuento/ahorro (fondo verde claro propio). */
#paymentDiscountEmphasis > div, #paymentCoverageCard .rounded { border-radius: 0.5rem; }
.service-row {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    transition: background-color 0.15s;
}
.service-row:hover {
    background-color: #f8f9fa;
}
.service-row:last-child {
    border-bottom: none;
}
.day-header {
    background-color: #f8f9fa;
    padding: 0.5rem 1rem;
    font-weight: 600;
    border-bottom: 2px solid #e9ecef;
}
.assignment-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
}
.detail-tag {
    font-size: 0.9rem;
    padding: 0.15rem 0.4rem;
    font-weight: 500;
}
.assign-field-group {
    margin-bottom: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: #f8f9fa;
    border-radius: 0.5rem;
}
.assign-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
}
.vehicle-pair-group {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 0.5rem;
    padding: 0.6rem 0.75rem;
    margin-bottom: 0.5rem;
}
.vehicle-pair-group .pair-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #6c757d;
    font-weight: 600;
    margin-bottom: 0.4rem;
}
</style>

<!-- Shared cancel utilities -->
<script src="/js/reservation-cancel-utils.js"></script>
<!-- Shared payment breakdown helpers (isomorphic; also require'd by Jest) -->
<script src="/shared/payments/paymentBreakdownHelpers.js"></script>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    const token = localStorage.getItem('token') || sessionStorage.getItem('token');
    // Read the freshest token at call time: the const above is captured once on page load and can go
    // stale during a long session (token rotation/expiry) → 401 "malformed token" until a hard reload.
    const authToken = () => localStorage.getItem('token') || sessionStorage.getItem('token') || token;
    const reservationId = '<%= reservationId %>';
    // Role from server-side renderRoleView (admin / superadmin / department_manager / client / etc.)
    // Used to gate visibility of internal note channels.
    const userRole = '<%= typeof userRole !== "undefined" ? userRole : "" %>';
    let reservationData = null;
    let employeesCache = null;
    let vehiclesCache = null;

    function getInitials(name) {
        if (!name) return '?';
        return name.split(' ').map(w => w[0]).filter(Boolean).join('').substring(0, 2).toUpperCase();
    }

    // Precio base en efectivo de un servicio (0 si está excluido del total). Es el precio de
    // referencia para el desglose Subtotal/recargo -- no se usa para calcular el cobro de
    // otros métodos.
    function getServiceBase(svc) {
        if (svc?.subconcept?.includeInTotal === false) return 0;
        const pbt = svc?.subconcept?.pricesByType;
        if (pbt && typeof pbt === 'object' && pbt.efectivo != null) {
            const v = Number(pbt.efectivo);
            if (!Number.isNaN(v)) return v;
        }
        return Number(svc?.total) || 0;
    }

    // Lógica de cálculo/desglose compartida (pura, probada por Jest) — ver
    // /shared/payments/paymentBreakdownHelpers.js. Wrappers finos para no tocar los call sites.
    function getServicePriceByType(svc, paymentType) {
        return PaymentBreakdownHelpers.getServicePriceByType(svc, paymentType);
    }
    function computeServicesSubtotalByType(services, paymentType) {
        const currency = (reservationData && reservationData.currency) || 'MXN';
        return PaymentBreakdownHelpers.computeServicesSubtotalByType(services, paymentType, currency);
    }

    function buildPersonCard(person, roleLabel, roleIcon, colorClass) {
        if (!person) return '';
        const name = person.fullName || 'Sin nombre';
        const phone = person.phone || '';
        const photo = person.profilePhotoUrl || '';
        const initials = getInitials(name);
        const photoHtml = photo
            ? `<img src="${photo}" class="rounded-circle photo-preview-trigger" width="36" height="36" style="object-fit:cover;cursor:pointer" data-photo="${photo}" data-name="${name.replace(/"/g, '&quot;')}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
            : '';
        const initialsDisplay = photo ? 'display:none' : 'display:flex';
        return `
            <div class="d-flex align-items-center gap-2 mb-2">
                ${photoHtml}
                <span class="rounded-circle bg-${colorClass}-subtle text-${colorClass} align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;${initialsDisplay};font-size:0.8rem;font-weight:600">${initials}</span>
                <div>
                    <div class="fw-semibold small">${name}</div>
                    <small class="text-${colorClass}"><i class="ti ${roleIcon} me-1"></i>${roleLabel}</small>
                    ${phone ? `<a href="tel:${phone}" class="text-muted small d-block"><i class="ti ti-phone me-1"></i>${phone}</a>` : ''}
                </div>
            </div>`;
    }

    function buildVehicleCard(vehicle) {
        if (!vehicle) return '';
        const name = vehicle.name || 'Vehiculo';
        const photo = vehicle.imageUrl || '';
        const initials = name.substring(0, 2).toUpperCase();
        const photoHtml = photo
            ? `<img src="${photo}" class="rounded-circle photo-preview-trigger" width="36" height="36" style="object-fit:cover;cursor:pointer" data-photo="${photo}" data-name="${name.replace(/"/g, '&quot;')}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
            : '';
        const initialsDisplay = photo ? 'display:none' : 'display:flex';
        return `
            <div class="d-flex align-items-center gap-2 mb-2">
                ${photoHtml}
                <span class="rounded-circle bg-secondary-subtle text-secondary align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;${initialsDisplay};font-size:0.8rem;font-weight:600">${initials}</span>
                <div>
                    <div class="fw-semibold small">${name}</div>
                    <small class="text-secondary"><i class="ti ti-car me-1"></i>Vehiculo</small>
                </div>
            </div>`;
    }

    // Group a driver and a vehicle into one visual unit so it's obvious which conductor
    // is paired with which vehicle. The label sits on top (e.g. "Vehículo principal").
    // If only one side is assigned, the other is shown as a muted "Pendiente" placeholder
    // so the operator still sees the slot exists.
    function buildPairCard(label, driver, vehicle, expectedVehicleName) {
        const hasDriver = !!(driver && driver.fullName);
        const hasVehicle = !!(vehicle && vehicle.name);
        if (!hasDriver && !hasVehicle) return '';

        const driverHtml = hasDriver
            ? buildPersonCard(driver, 'Conductor', 'ti-steering-wheel', 'info')
            : `<div class="d-flex align-items-center gap-2 mb-2 text-muted" style="opacity:0.6">
                    <span class="rounded-circle bg-light text-muted d-flex align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;font-size:0.9rem"><i class="ti ti-steering-wheel"></i></span>
                    <div>
                        <div class="small fst-italic">Conductor pendiente</div>
                    </div>
               </div>`;

        const vehicleHtml = hasVehicle
            ? buildVehicleCard(vehicle)
            : `<div class="d-flex align-items-center gap-2 mb-2 text-muted" style="opacity:0.6">
                    <span class="rounded-circle bg-light text-muted d-flex align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;font-size:0.9rem"><i class="ti ti-car"></i></span>
                    <div>
                        <div class="small fst-italic">${expectedVehicleName ? expectedVehicleName + ' pendiente' : 'Vehículo pendiente'}</div>
                    </div>
               </div>`;

        return `
            <div class="p-2 rounded" style="background: #f8f9fa; min-width: 230px; flex: 0 0 auto;">
                ${label ? `<div class="small fw-semibold text-secondary mb-1">${label}</div>` : ''}
                ${driverHtml}
                ${vehicleHtml}
            </div>`;
    }

    // Quote statuses — kept as an ORDERED array (lifecycle: cotizada → solicitada →
    // bloqueada → agendada → rechazada) so the dropdown matches the segmented control on
    // the quote detail page.
    const QUOTE_STATUS_ORDER = [
        { key: 'quoted', label: 'Cotizada', cls: 'bg-primary text-white' },
        { key: 'requested', label: 'Solicitada', cls: 'bg-info text-white' },
        { key: 'hold', label: 'Bloqueada', cls: 'bg-warning text-dark' },
        { key: 'scheduled', label: 'Agendada', cls: 'bg-success text-white' },
        { key: 'rejected', label: 'Rechazada', cls: 'bg-danger text-white' },
    ];
    const QUOTE_STATUS_MAP = Object.fromEntries(QUOTE_STATUS_ORDER.map((s) => [s.key, s]));

    function getQuoteStatusBadge(status) {
        if (!status) return '';
        const s = QUOTE_STATUS_MAP[status] || { label: status, cls: 'bg-secondary text-white' };
        const isAdmin = userRole === 'admin' || userRole === 'superadmin';
        // Admin gets a dropdown to change the quote status inline. Other roles see a
        // plain badge.
        if (!isAdmin) {
            return `<span class="badge ${s.cls}" title="Estado de cotización origen">${s.label}</span>`;
        }
        // Same lifecycle lock as the quote detail page: once a quote is scheduled, the
        // admin can't change it away from this dashboard (must go through the quote
        // detail flow to handle cancellation properly).
        const isLocked = status === 'scheduled';
        if (isLocked) {
            return `<span class="badge ${s.cls}" title="Cotización agendada — bloqueada">${s.label}</span>`;
        }
        const options = QUOTE_STATUS_ORDER
            .map((opt) => `<li><button type="button" class="dropdown-item d-flex justify-content-between align-items-center quote-status-option" data-status="${opt.key}">
                    <span>${opt.label}</span>
                    ${opt.key === status ? '<i class="ti ti-check text-success ms-2"></i>' : ''}
                </button></li>`)
            .join('');
        return `<span class="dropdown d-inline-block">
                    <button type="button" class="badge ${s.cls} border-0 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Cambiar estado de cotización">
                        ${s.label}
                    </button>
                    <ul class="dropdown-menu shadow-sm">
                        <li><h6 class="dropdown-header">Cambiar estado de cotización</h6></li>
                        ${options}
                    </ul>
                </span>`;
    }

    // Wires the quote-status dropdown options to the PUT /api/quotes/:id endpoint.
    // Called after the badge is (re)rendered.
    function wireQuoteStatusDropdown() {
        document.querySelectorAll('.quote-status-option').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const newStatus = btn.dataset.status;
                const currentStatus = reservationData?.quoteStatus;
                if (!newStatus || newStatus === currentStatus) return;
                const quoteId = reservationData?.quoteId;
                if (!quoteId) {
                    alert('Cotización no disponible');
                    return;
                }
                const label = QUOTE_STATUS_MAP[newStatus]?.label || newStatus;
                if (!confirm(`¿Cambiar el estado de la cotización a "${label}"?`)) return;
                try {
                    const res = await fetch(`/api/quotes/${quoteId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${authToken()}` },
                        body: JSON.stringify({ status: newStatus, reason: 'Updated from booking detail' }),
                    });
                    const json = await res.json();
                    if (!res.ok || json?.success === false) {
                        throw new Error(json?.error || `HTTP ${res.status}`);
                    }
                    // Refresh local data and re-render the status row.
                    reservationData.quoteStatus = newStatus;
                    const quoteBadge = getQuoteStatusBadge(reservationData.quoteStatus);
                    const reservationBadge = getReservationOverallStatusBadge(reservationData.status);
                    document.getElementById('infoStatus').innerHTML = `${quoteBadge} ${reservationBadge}`;
                    wireQuoteStatusDropdown();
                } catch (err) {
                    console.error('Failed to update quote status', err);
                    alert(`Error al actualizar estado: ${err.message}`);
                }
            });
        });
    }
    
    function getReservationStatusBadge(status) {
        const map = {
            pending: { label: 'Asignaciones pendientes', cls: 'bg-warning text-dark' },
            assigned: { label: 'Asignada', cls: 'bg-info text-white' },
            in_progress: { label: 'En Progreso', cls: 'bg-primary text-white' },
            completed: { label: 'Completada', cls: 'bg-success text-white' },
            cancelled: { label: 'Cancelada', cls: 'bg-danger text-white' },
            confirmed: { label: 'Confirmada', cls: 'bg-success text-white' },
            hold: { label: 'En Espera', cls: 'bg-warning text-dark' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado operacional de reservación">${s.label}</span>`;
    }

    // Estado GENERAL de la reservación: mismo modelo (y colores) que el segmented
    // control en el detalle de cotización. 'assigned'/'in_progress' = Confirmada
    // (definición del negocio: todo asignado = confirmada). No usar por-servicio.
    function getReservationOverallStatusBadge(status) {
        const map = {
            hold: { label: 'Bloqueado', cls: 'bg-warning text-dark' },
            pending: { label: 'Asignaciones pendientes', cls: 'bg-info text-white' },
            assigned: { label: 'Confirmada', cls: 'bg-primary text-white' },
            in_progress: { label: 'Confirmada', cls: 'bg-primary text-white' },
            confirmed: { label: 'Confirmada', cls: 'bg-primary text-white' },
            completed: { label: 'Finalizada', cls: 'bg-success text-white' },
            cancelled: { label: 'Cancelada', cls: 'bg-danger text-white' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado de la reservación">${s.label}</span>`;
    }

    // Estado de pago — delegado al módulo compartido (mismo PAYMENT_STATUS_MAP en las 3 plantillas).
    function getPaymentStatusBadge(status) {
        return PaymentBreakdownHelpers.getPaymentStatusBadge(status);
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
    }

    function formatCurrency(amount, currency) {
        const sym = currency === 'USD' ? 'USD $' : '$';
        return `${sym}${(amount || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    // Live thousands-separator for amount text inputs: groups the integer part with commas while
    // typing (100000 -> 100,000), keeps up to 2 decimals, and preserves the caret position.
    function formatThousandsInput(el) {
        const raw = el.value;
        const caret = el.selectionStart || 0;
        const digitsBeforeCaret = (raw.slice(0, caret).match(/\d/g) || []).length;
        let clean = raw.replace(/[^\d.]/g, '');
        const dot = clean.indexOf('.');
        if (dot !== -1) clean = clean.slice(0, dot + 1) + clean.slice(dot + 1).replace(/\./g, '');
        let [intPart = '', decPart] = clean.split('.');
        intPart = intPart.replace(/^0+(?=\d)/, '');
        const grouped = intPart ? Number(intPart).toLocaleString('en-US') : '';
        let out = grouped;
        if (decPart !== undefined) out += `.${decPart.slice(0, 2)}`;
        el.value = out;
        // Restore the caret after the same number of digits it was before reformatting.
        let pos = 0;
        let seen = 0;
        while (pos < out.length && seen < digitsBeforeCaret) {
            if (/\d/.test(out[pos])) seen += 1;
            pos += 1;
        }
        el.setSelectionRange(pos, pos);
    }

    // Attach live thousands formatting to a text amount input and format its initial value.
    function attachThousands(el) {
        if (!el) return;
        el.addEventListener('input', () => formatThousandsInput(el));
        if (el.value) formatThousandsInput(el);
    }

    // Parse an amount that may carry thousands separators ("1,234.56" -> 1234.56).
    function parseAmount(value) {
        return parseFloat(String(value == null ? '' : value).replace(/,/g, ''));
    }

    function getServiceTypeIcon(type) {
        const icons = {
            transport: 'ti-car',
            tour: 'ti-map-pin',
            experience: 'ti-sparkles',
            concepto: 'ti-tag',
            'a-disposicion': 'ti-clock',
        };
        return icons[type] || 'ti-point';
    }

    function getServiceTypeLabel(type) {
        const labels = {
            transport: 'Transporte',
            tour: 'Tour',
            experience: 'Experiencia',
            concepto: 'Concepto',
            'a-disposicion': 'A Disposición',
        };
        return labels[type] || type || '';
    }

    // Returns a human-readable concept for a service. A-disposición services often have
    // an empty concept field — fall back to the literal type label instead of a dash.
    function getDisplayConcept(svc) {
        const raw = (svc?.concept || '').trim();
        if (raw) return raw;
        if (svc?.type === 'a-disposicion') return 'A Disposición';
        return '—';
    }

    function getRoleBadge(role, displayRole) {
        const r = displayRole || role || '';
        const map = {
            driver: { label: 'Conductor', cls: 'bg-info-subtle text-info' },
            guia: { label: 'Guia', cls: 'bg-success-subtle text-success' },
            greeter: { label: 'Greeter', cls: 'bg-warning-subtle text-warning' },
            employee_amexing: { label: 'Amexing', cls: 'bg-primary-subtle text-primary' },
            limpieza: { label: 'Limpieza', cls: 'bg-secondary-subtle text-secondary' },
            admin: { label: 'Admin', cls: 'bg-danger-subtle text-danger' },
        };
        const s = map[r] || map[role] || { label: r || 'N/A', cls: 'bg-secondary-subtle text-secondary' };
        return `<span class="badge ${s.cls}" style="font-size:0.65rem;">${s.label}</span>`;
    }

    // Failure modes are kept DISTINCT so the message points at the real cause instead of a
    // single opaque "Error al cargar": (1) network/HTTP or API success:false vs (2) an
    // exception thrown while rendering valid data. Both are logged with detail to the console.
    async function loadReservation() {
        let result;
        try {
            const response = await fetch(`/api/reservations/${reservationId}`, {
                headers: { 'Authorization': `Bearer ${authToken()}` }
            });
            result = await response.json().catch(() => null);
            if (!response.ok || !result || !result.success) {
                const reason = (result && result.error) ? result.error : `HTTP ${response.status}`;
                console.error('Error loading reservation:', reason, result);
                document.getElementById('loadingState').innerHTML = `<p class="text-danger">Error al cargar la reservacion (${reason})</p>`;
                return;
            }
        } catch (error) {
            console.error('Error loading reservation (red):', error);
            document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al cargar la reservacion (sin conexion)</p>';
            return;
        }

        // Render separately: a render-time exception (unexpected/malformed data) is reported
        // distinctly from a fetch/API failure, and no longer masquerades as "no se pudo cargar".
        try {
            reservationData = result.data;
            renderReservation();
        } catch (error) {
            console.error('Error rendering reservation:', error);
            document.getElementById('loadingState').innerHTML = '<p class="text-danger">Error al mostrar la reservacion. Revisa la consola para el detalle.</p>';
        }
    }

    function renderReservation() {
        const d = reservationData;

        document.getElementById('breadcrumbFolio').textContent = d.folio;
        document.getElementById('pageTitle').innerHTML = `<i class="ti ti-clipboard-list me-2 text-primary"></i>${d.folio}`;
        document.getElementById('infoFolio').textContent = d.folio;

        const quoteLink = document.getElementById('infoQuoteLink');
        if (d.quoteId) {
            // Abrimos desde una reservación → activamos la bandera de contexto para que
            // el detalle muestre títulos/estado como "Reservación".
            quoteLink.href = `/dashboard/admin/quotes/${d.quoteId}?context=reservation`;
            quoteLink.textContent = d.quoteFolio;
        }

        const quoteBadge = getQuoteStatusBadge(d.quoteStatus);
        const reservationBadge = getReservationOverallStatusBadge(d.status);
        document.getElementById('infoStatus').innerHTML = `${quoteBadge} ${reservationBadge}`;
        wireQuoteStatusDropdown();
        document.getElementById('infoCreatedAt').textContent = formatDate(d.createdAt);
        // Display company name first, then fallback to fullName or contactPerson
        const clientDisplay = d.client?.companyName || d.client?.fullName || d.contactPerson || '—';
        document.getElementById('infoClient').textContent = clientDisplay;
        document.getElementById('infoContact').innerHTML = `${d.contactEmail || ''}${d.contactPhone ? `<br>${d.contactPhone}` : ''}`;
        document.getElementById('infoEventType').textContent = d.eventType || '—';
        document.getElementById('infoPeople').textContent = d.numberOfPeople || '—';

        // Lead guest — only render row when at least one name is present. Falls back to
        // contactFirstName/contactPerson so a reservation that has the actual traveler in
        // the contact fields still surfaces it as the lead guest.
        const leadGuestParts = [d.leadGuestFirstName, d.leadGuestLastName]
            .map((p) => (p || '').trim())
            .filter(Boolean);
        const leadGuestName = leadGuestParts.length > 0
            ? leadGuestParts.join(' ')
            : (d.contactPerson || '').trim();
        const leadGuestRow = document.getElementById('infoLeadGuestRow');
        const leadGuestEl = document.getElementById('infoLeadGuest');
        if (leadGuestName && leadGuestEl && leadGuestRow) {
            leadGuestEl.textContent = leadGuestName;
            leadGuestRow.classList.remove('d-none');
        }

        // Quote-level notes — same callout style as service notes.
        const quoteNotesRow = document.getElementById('infoQuoteNotesRow');
        const quoteNotesEl = document.getElementById('infoQuoteNotes');
        const quoteNotesText = (d.notes || '').trim();
        if (quoteNotesText && quoteNotesEl && quoteNotesRow) {
            quoteNotesEl.textContent = quoteNotesText;
            quoteNotesRow.classList.remove('d-none');
        }
        document.getElementById('infoStartDate').textContent = formatDate(d.startDate);
        document.getElementById('infoEndDate').textContent = formatDate(d.endDate);
        document.getElementById('infoPaymentType').textContent = d.paymentType || '—';
        // Total recomputed from each service's pricesByType[paymentType] when available so
        // the reservation reflects the quote's per-service breakdown for the current
        // payment type. Falls back to the stored d.totalAmount only if no service has
        // pricesByType (very old data).
        const headerServicesSubtotal = computeServicesSubtotalByType(d.services, d.paymentType);
        const headerTotal = headerServicesSubtotal > 0 ? headerServicesSubtotal : (d.totalAmount || 0);
        document.getElementById('infoTotal').textContent = formatCurrency(headerTotal, d.currency);

        // Assignment counter
        const totalSvc = (d.services || []).length;
        // Los servicios 'concepto' no requieren asignación → cuentan como asignados.
        const assignedSvc = (d.services || []).filter(s => s.status === 'assigned' || s.status === 'completed' || s.type === 'concepto').length;
        const completedSvc = (d.services || []).filter(s => s.status === 'completed').length;
        const counterEl = document.getElementById('infoAssignmentCounter');
        if (totalSvc > 0) {
            const counterColor = completedSvc === totalSvc ? 'success' : (assignedSvc === totalSvc ? 'info' : (assignedSvc > 0 ? 'warning' : 'secondary'));
            counterEl.innerHTML = `<span class="badge bg-${counterColor}-subtle text-${counterColor} fs-6">${assignedSvc}/${totalSvc} asignados</span>` +
                (completedSvc > 0 ? ` <span class="badge bg-success-subtle text-success fs-6">${completedSvc}/${totalSvc} completados</span>` : '');
        } else {
            counterEl.textContent = 'Sin servicios';
        }

        const scEl = document.getElementById('infoServiceCustomer');
        if (d.serviceCustomer) {
            scEl.innerHTML = buildPersonCard(d.serviceCustomer, 'Seguidor', 'ti-user-star', 'primary');
        } else {
            scEl.innerHTML = '<span class="text-muted">Sin asignar</span>';
        }

        const canAssign = d.status !== 'cancelled' && d.status !== 'completed';
        const changeScBtn = document.getElementById('changeServiceCustomerBtn');
        if (canAssign) {
            changeScBtn.classList.remove('d-none');
        } else {
            changeScBtn.classList.add('d-none');
        }

        const actions = document.getElementById('headerActions');
        const folio = encodeURIComponent(d.folio || '');
        const exportBtnHtml = folio
            ? `<a class="btn btn-sm btn-outline-secondary" href="/reservations/${folio}" target="_blank" rel="noopener" title="Abrir vista pública (incluye Exportar a PDF)"><i class="ti ti-file-export me-1"></i>Exportar</a>`
            : '';
        // En vez del botón de cancelar: si ya está cancelada, mostrar etiqueta
        // "Cancelada"; si tiene una solicitud de cancelación pendiente, mostrar
        // "Pendiente de cancelación" (evita además crear solicitudes duplicadas).
        let cancelBtnHtml = '';
        if (d.status === 'cancelled') {
            cancelBtnHtml = `<span class="badge bg-danger text-white"><i class="ti ti-x me-1"></i>Cancelada</span>`;
        } else if (d.hasPendingCancellation) {
            cancelBtnHtml = `<span class="badge bg-warning text-dark border border-danger-subtle" title="Tiene una solicitud de cancelación pendiente de aprobación"><i class="ti ti-clock me-1"></i>Pendiente de cancelación</span>`;
        } else if (canAssign) {
            cancelBtnHtml = `<button class="btn btn-sm btn-outline-danger" id="cancelResBtn"><i class="ti ti-x me-1"></i>Cancelar Reservacion</button>`;
        }
        actions.innerHTML = `<div class="d-flex gap-2 align-items-center">${exportBtnHtml}${cancelBtnHtml}</div>`;
        // El listener solo aplica cuando se renderizó el botón (no en las etiquetas).
        document.getElementById('cancelResBtn')?.addEventListener('click', () => {
            // Use shared utility with existing reservation data and loadReservation callback
            openReservationCancelModalWithData(reservationData, loadReservation);
        });

        renderServices(d.services);
        renderFinancialSummary();
        loadPayments();

        document.getElementById('loadingState').style.display = 'none';
        document.getElementById('reservationContent').style.display = '';
    }

    // Round a HH:MM string DOWN to the previous 15-minute mark — same strategy used
    // in the quote services list so timestamps stay consistent across views.
    function roundTimeToNearest15(timeStr) {
        if (!timeStr || !timeStr.includes(':')) return timeStr || '';
        const [hours, minutes] = timeStr.split(':').map(Number);
        if (Number.isNaN(hours) || Number.isNaN(minutes)) return timeStr;
        let totalMinutes = hours * 60 + minutes;
        totalMinutes = Math.floor(totalMinutes / 15) * 15;
        const h = Math.floor(totalMinutes / 60) % 24;
        const m = totalMinutes % 60;
        return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
    }

    // Build a single detail line: small icon + label (optional) + value.
    function detailLine(icon, value, label) {
        if (value == null || value === '') return '';
        const labelHtml = label ? `<span class="text-muted me-1">${label}:</span>` : '';
        return `<div class="d-flex align-items-center gap-1 small text-dark">
                    <i class="ti ti-${icon} text-secondary" style="font-size: 0.9rem;"></i>
                    ${labelHtml}<span>${value}</span>
                </div>`;
    }

    // Build a section: small header + flex-wrap of items.
    function detailSection(icon, title, items) {
        const filtered = items.filter(Boolean);
        if (filtered.length === 0) return '';
        return `<div class="mt-2">
                    <div class="d-flex align-items-center gap-1 text-secondary mb-1" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">
                        <i class="ti ti-${icon}"></i>${title}
                    </div>
                    <div class="d-flex flex-wrap" style="row-gap: 0.15rem; column-gap: 1.25rem;">
                        ${filtered.join('')}
                    </div>
                </div>`;
    }

    function getSubconceptDetails(svc) {
        const sub = svc.subconcept;
        if (!sub) return '';
        // Legacy tags array kept for non-categorized stuff; new sections below replace
        // most of the old badge rows.
        const tags = [];
        const tag = (icon, text, color) => `<span class="badge detail-tag bg-${color}-subtle text-${color}"><i class="ti ti-${icon} me-1"></i>${text}</span>`;

        // ===== Sections (replaces the legacy badge row) =====
        // Build categorized detail lines so the operator can scan the info quickly.

        // SERVICIO — trip type / direction, vehicle count, included roles, hotel, etc.
        const servicioItems = [];
        if (svc.type === 'transport' && sub.tripType) {
            const tripLabel = sub.tripType === 'round-trip' ? 'Redondo' : 'Sencillo';
            const dirLabel = sub.directionType === 'arrival' ? 'Llegada' : 'Salida';
            servicioItems.push(detailLine('arrows-exchange', `${tripLabel} — ${dirLabel}`));
        }
        if (svc.type === 'a-disposicion' && sub.vehicleCount && sub.vehicleCount > 0) {
            servicioItems.push(detailLine('car', `${sub.vehicleCount} vehículo${sub.vehicleCount > 1 ? 's' : ''}`));
        }
        if (svc.type !== 'a-disposicion' && sub.quantity && sub.quantity > 1) {
            servicioItems.push(detailLine('car', `${sub.quantity} vehículos`));
        }
        const guideLabel = svc.type === 'a-disposicion' ? 'Chofer' : 'Guía';
        if (sub.includeGuide === true) {
            servicioItems.push(detailLine('map-pin', `${guideLabel} incluido`));
        }
        if (sub.includeGreeter === true) {
            const inVehicle = sub.greeterInVehicle ? ' (en vehículo)' : ' (en punto)';
            servicioItems.push(detailLine('hand-stop', `Greeter incluido${inVehicle}`));
        }
        if (svc.type === 'tour' && sub.hotelName) {
            servicioItems.push(detailLine('building', sub.hotelName, 'Hotel'));
        }

        // HORARIO — schedule / duration / suggested times.
        const horarioItems = [];
        if (svc.type === 'transport' && sub.transportType === 'aeropuerto') {
            const isDeparture = sub.directionType === 'departure';
            const isArrival = sub.directionType === 'arrival';
            let rawTime = '';
            let timeLabel = '';
            if (isDeparture && (svc.flightDepartureTimeSuggested || sub.flightDepartureTimeSuggested)) {
                // Salida: la hora sugerida ES la hora de pick-up del servicio.
                rawTime = svc.flightDepartureTimeSuggested || sub.flightDepartureTimeSuggested;
                timeLabel = 'Horario';
            } else if (isArrival) {
                // Llegada: el pick-up ocurre a la hora de llegada del pasajero.
                rawTime = sub.startTime || sub.time || svc.time || '';
                if (!rawTime && sub.selectedSchedule) {
                    const m = String(sub.selectedSchedule).match(/^(\d{1,2}:\d{2})/);
                    if (m) rawTime = m[1];
                }
                timeLabel = 'Horario';
            }
            const rounded = rawTime ? roundTimeToNearest15(rawTime) : '';
            if (rounded) horarioItems.push(detailLine('clock', rounded, timeLabel));
        }
        if (sub.selectedSchedule && (svc.type === 'experience' || svc.type === 'a-disposicion')) {
            horarioItems.push(detailLine('clock', sub.selectedSchedule, 'Horario'));
        }
        if (sub.hours && sub.hours > 0 && svc.type === 'a-disposicion') {
            horarioItems.push(detailLine('clock-hour-4', `${sub.hours} h`, 'Duración'));
        }
        if (sub.waitingTimeHours) {
            horarioItems.push(detailLine('clock-pause', `${sub.waitingTimeHours}h`, 'Espera'));
        }
        if (Array.isArray(sub.extraAdditionalVehicles)) {
            sub.extraAdditionalVehicles.forEach((v) => {
                const wh = parseFloat(v && v.waitingHours) || 0;
                if (wh > 0) horarioItems.push(detailLine('clock-pause', `${wh}h`, `Espera ${(v.vehicleTypeName || 'adicional')}`));
            });
        }
        if (sub.routeDuration) {
            horarioItems.push(detailLine('route', `${sub.routeDuration} min`, 'Duración ruta'));
        }

        // PERSONAS — passenger / ticket counts.
        const personasItems = [];
        if (svc.type === 'transport') {
            const parts = [];
            if (sub.transportAdults) parts.push(`${sub.transportAdults} adulto${sub.transportAdults > 1 ? 's' : ''}`);
            if (sub.transportChildren) parts.push(`${sub.transportChildren} niño${sub.transportChildren > 1 ? 's' : ''}`);
            if (sub.transportInfants) parts.push(`${sub.transportInfants} infante${sub.transportInfants > 1 ? 's' : ''}`);
            if (parts.length === 0 && sub.persons) parts.push(`${sub.persons} persona${sub.persons > 1 ? 's' : ''}`);
            if (parts.length) personasItems.push(detailLine('users', parts.join(', ')));
        } else if (svc.type === 'experience') {
            const tickets = [];
            if (sub.adultsQuantity) tickets.push(`${sub.adultsQuantity} adulto${sub.adultsQuantity > 1 ? 's' : ''}`);
            if (sub.childrenQuantity) tickets.push(`${sub.childrenQuantity} niño${sub.childrenQuantity > 1 ? 's' : ''}`);
            if (sub.adultsNoAlcoholQuantity) tickets.push(`${sub.adultsNoAlcoholQuantity} sin alcohol`);
            if (tickets.length) personasItems.push(detailLine('ticket', tickets.join(', ')));
        } else if (svc.type === 'tour') {
            if (sub.isWalkingTour) {
                const adults = Number(sub.adultsQuantity) || 0;
                const children = Number(sub.childrenQuantity) || 0;
                const infants = Number(sub.infantsQuantity) || 0;
                const parts = [];
                if (adults) parts.push(`${adults} adulto${adults > 1 ? 's' : ''}`);
                if (children) parts.push(`${children} niño${children > 1 ? 's' : ''}`);
                if (infants) parts.push(`${infants} infante${infants > 1 ? 's' : ''}`);
                const totalPeople = adults + children + infants || sub.walkingTourPeopleCount || 0;
                personasItems.push(detailLine('walk', `${totalPeople} pax${parts.length ? ` (${parts.join(', ')})` : ''}`, 'Walking tour'));
            } else if (sub.persons) {
                personasItems.push(detailLine('users', `${sub.persons} persona${sub.persons > 1 ? 's' : ''}`));
            }
        }
        // Asistentes (named list) — applies to all types.
        if (Array.isArray(sub.attendees)) {
            const names = sub.attendees.map((n) => String(n || '').trim()).filter(Boolean);
            if (names.length > 0) {
                personasItems.push(detailLine('user-check', `${names.join(', ')}`, `Asistentes (${names.length})`));
            }
        }

        // VUELOS — airline + flight number + additional flights.
        const vuelosItems = [];
        if (svc.type === 'transport') {
            if (sub.airline || sub.flightNumber) {
                const flightLabel = `${sub.airline || ''} ${sub.flightNumber || ''}`.trim();
                // Hora real del vuelo (llegada o salida del avión), distinta al pick-up del Horario.
                const fm = String(svc.time || sub.selectedSchedule || sub.time || '').match(/^(\d{1,2}:\d{2})/);
                const flightTime = fm ? fm[1] : '';
                vuelosItems.push(detailLine('plane', flightTime ? `${flightLabel} @ ${flightTime}` : flightLabel));
            }
            if (Array.isArray(sub.additionalFlights) && sub.additionalFlights.length > 0) {
                sub.additionalFlights.forEach((f) => {
                    const parts = [(f.airline || '').trim(), (f.flightNumber || '').trim()].filter(Boolean).join(' ');
                    const time = (f.flightTime || '').trim();
                    const label = parts || 'Vuelo';
                    const text = time ? `${label} @ ${time}` : label;
                    vuelosItems.push(detailLine('plane', text));
                });
            }
        }

        // OTROS — discounts, etc.
        const otrosItems = [];
        if (svc.type === 'a-disposicion' && sub.discountPercent) {
            otrosItems.push(detailLine('discount-2', `${sub.discountPercent}% descuento`));
        }

        // UBICACIONES — direcciones de pick-up / drop-off (cuando existan).
        const ubicacionesItems = [];
        if (svc.type === 'transport') {
            if (sub.tripType === 'round-trip') {
                if (sub.pickupAddressIda) ubicacionesItems.push(detailLine('map-pin-up', sub.pickupAddressIda, 'Pick-up (ida)'));
                if (sub.dropoffAddressIda) ubicacionesItems.push(detailLine('map-pin-down', sub.dropoffAddressIda, 'Drop-off (ida)'));
                if (sub.pickupAddressVuelta) ubicacionesItems.push(detailLine('map-pin-up', sub.pickupAddressVuelta, 'Pick-up (regreso)'));
                if (sub.dropoffAddressVuelta) ubicacionesItems.push(detailLine('map-pin-down', sub.dropoffAddressVuelta, 'Drop-off (regreso)'));
            } else {
                if (sub.pickupAddress) ubicacionesItems.push(detailLine('map-pin-up', sub.pickupAddress, 'Pick-up'));
                if (sub.dropoffAddress) ubicacionesItems.push(detailLine('map-pin-down', sub.dropoffAddress, 'Drop-off'));
            }
        } else if (svc.type === 'tour' || svc.type === 'experience') {
            if (sub.pickupAddress) ubicacionesItems.push(detailLine('map-pin-up', sub.pickupAddress, 'Pick-up'));
        }

        const sectionsHtml = [
            detailSection('info-circle', 'Servicio', servicioItems),
            detailSection('map-pin', 'Ubicaciones', ubicacionesItems),
            detailSection('clock', 'Horario', horarioItems),
            detailSection('users', 'Personas', personasItems),
            detailSection('plane', 'Vuelos', vuelosItems),
            detailSection('award', 'Otros', otrosItems),
        ].filter(Boolean).join('');

        // Notes — render each note channel as its own callout so the operator can quickly
        // tell who the note is for. Prefer the subconcept snapshot, with sensible fallbacks.
        // Visibility by role:
        //   notes (general)  → all roles
        //   clientNotes      → client + department_manager + admin/superadmin
        //   providerNotes    → admin/superadmin only
        //   teamNotes        → admin/superadmin only
        //   internalNotes    → admin/superadmin only
        const isAdmin = userRole === 'admin' || userRole === 'superadmin';
        const isClientFacing = isAdmin || userRole === 'department_manager' || userRole === 'client';
        const noteChannels = [
            { label: 'Notas del administrador', icon: 'notes', color: '#adb5bd', text: (sub.notes || svc.notes || '').trim(), visible: true },
            { label: 'Notas del cliente', icon: 'user', color: '#0dcaf0', text: (sub.agencyNotes || '').trim(), visible: true },
            { label: 'Notas del cliente (catálogo)', icon: 'book', color: '#0d6efd', text: (sub.clientNotes || '').trim(), visible: isClientFacing },
            { label: 'Notas del proveedor', icon: 'building', color: '#198754', text: (sub.providerNotes || '').trim(), visible: isAdmin },
            { label: 'Notas del equipo', icon: 'users', color: '#fd7e14', text: (sub.teamNotes || '').trim(), visible: isAdmin },
            { label: 'Notas internas', icon: 'lock', color: '#6f42c1', text: (sub.internalNotes || '').trim(), visible: isAdmin },
        ].filter((n) => n.visible && n.text);

        const notesHtml = noteChannels.map((n) => `
            <div class="mt-2 p-2 rounded" style="background: #f8f9fa; border-left: 3px solid ${n.color};">
                <div class="d-flex align-items-center mb-1">
                    <i class="ti ti-${n.icon} me-1" style="color: ${n.color};"></i>
                    <strong style="font-size: 0.8rem; color: ${n.color};">${n.label}</strong>
                </div>
                <div class="text-dark" style="white-space: pre-line; word-break: break-word; font-size: 0.85rem;">${n.text}</div>
            </div>
        `).join('');

        return sectionsHtml + notesHtml;
    }

    function renderServices(services) {
        const container = document.getElementById('servicesContainer');

        const days = {};
        services.forEach(svc => {
            const key = svc.dayNumber || 1;
            if (!days[key]) days[key] = { title: svc.dayTitle || `Dia ${key}`, date: svc.serviceDate, services: [] };
            days[key].services.push(svc);
        });

        // Order services within each day chronologically — same strategy used by the
        // quote services list (sortSubconceptsByTime). Empty times go to the end.
        const parseTimeToMinutes = (timeStr) => {
            if (!timeStr) return null;
            // Range format "HH:MM - HH:MM" → use the start of the range
            const rangeMatch = String(timeStr).match(/^(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})/);
            if (rangeMatch) return parseInt(rangeMatch[1], 10) * 60 + parseInt(rangeMatch[2], 10);
            const singleMatch = String(timeStr).match(/^(\d{1,2}):(\d{2})/);
            if (singleMatch) return parseInt(singleMatch[1], 10) * 60 + parseInt(singleMatch[2], 10);
            return null;
        };
        Object.values(days).forEach((d) => {
            d.services.sort((a, b) => {
                const ma = parseTimeToMinutes(a.time);
                const mb = parseTimeToMinutes(b.time);
                if (ma === null && mb === null) return 0;
                if (ma === null) return 1;
                if (mb === null) return -1;
                return ma - mb;
            });
        });

        if (Object.keys(days).length === 0) {
            container.innerHTML = '<div class="text-center py-4 text-muted">No hay servicios en esta reservacion</div>';
            return;
        }

        const canAssign = reservationData.status !== 'cancelled' && reservationData.status !== 'completed';

        let html = '';
        Object.keys(days).sort((a, b) => a - b).forEach(dayNum => {
            const day = days[dayNum];
            html += `<div class="day-header"><i class="ti ti-calendar-event me-1"></i>Dia ${dayNum} — ${day.title}${day.date ? ` (${formatDate(day.date)})` : ''}</div>`;

            day.services.forEach(svc => {
                const icon = getServiceTypeIcon(svc.type);
                // Build person cards for assigned employees
                // Build paired cards (conductor + vehículo per slot) so it's obvious who's
                // driving which vehicle. Non-vehicle roles (guía/chofer, greeter, seguidor)
                // are rendered separately at the end.
                let pairsHtml = '';
                let rolesHtml = '';

                // Driver+vehicle pair for the main slot.
                const showMainPair = !!(svc.assignedDriver || svc.assignedVehicle);
                const extras = svc.extraAssignments || [];
                const hasAnyExtraSlot = extras.some((ea) => ea.driverId || ea.vehicleId);
                const useSlotLabels = hasAnyExtraSlot; // only label when there's more than one slot
                if (showMainPair) {
                    pairsHtml += buildPairCard(
                        useSlotLabels ? 'Vehículo principal' : '',
                        svc.assignedDriver,
                        svc.assignedVehicle,
                        svc.vehicleTypeName || ''
                    );
                }

                // Extras (additional vehicles + their drivers).
                extras.forEach((ea, idx) => {
                    if (!ea.driverId && !ea.vehicleId) return;
                    const driver = ea.driverId ? { fullName: ea.driverName, phone: '', profilePhotoUrl: '' } : null;
                    const vehicle = ea.vehicleId ? { name: ea.vehicleName, imageUrl: ea.vehicleImageUrl || '' } : null;
                    const label = useSlotLabels ? `Vehículo extra ${idx + 1}` : '';
                    pairsHtml += buildPairCard(label, driver, vehicle, ea.vehicleName || '');
                });

                // Non-vehicle roles
                rolesHtml += buildPersonCard(svc.assignedGuide, svc.type === 'a-disposicion' ? 'Chofer' : 'Guía', 'ti-map-pin', 'success');
                rolesHtml += buildPersonCard(svc.assignedGreeter, 'Greeter', 'ti-hand-stop', 'warning');
                rolesHtml += buildPersonCard(svc.assignedServiceCustomer, 'Seguidor', 'ti-user-star', 'primary');

                const hasAssignments = pairsHtml || rolesHtml;

                const route = svc.originName || svc.destinationName
                    ? `<small class="text-muted">${svc.originName || ''}${svc.originName && svc.destinationName ? ' &rarr; ' : ''}${svc.destinationName || ''}</small>`
                    : '';

                const includeGuide = svc.subconcept?.includeGuide;
                const includeGreeter = svc.subconcept?.includeGreeter;
                // Decide whether this service actually needs vehicle assignment slots.
                // Experiences, conceptos and walking tours never need a vehicle even if
                // their subconcept.quantity is > 0 (that's people count for them).
                const isWalkingTour = !!svc.subconcept?.isWalkingTour;
                const hasVehicleData = !!(svc.subconcept?.vehicleType || svc.subconcept?.vehicleTypeName
                    || svc.subconcept?.requiresTransport
                    || svc.subconcept?.additionalVehicleId
                    || (Array.isArray(svc.subconcept?.extraAdditionalVehicles) && svc.subconcept.extraAdditionalVehicles.length > 0));
                const needsVehicle = (svc.type === 'transport'
                    || svc.type === 'a-disposicion'
                    || (svc.type === 'tour' && !isWalkingTour && hasVehicleData));
                // For a-disposición the "quantity" field on the subconcept is the count of
                // the service entry; the actual vehicle count lives in `vehicleCount`.
                let vehicleQty = 0;
                if (needsVehicle) {
                    if (svc.type === 'a-disposicion') {
                        vehicleQty = Number(svc.subconcept?.vehicleCount) || 1;
                    } else {
                        vehicleQty = Number(svc.subconcept?.quantity) || 1;
                    }
                }

                html += `
                <div class="service-row d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center flex-grow-1">
                        <div>
                            <div class="fw-semibold">${getDisplayConcept(svc)}${svc.time ? ` <small class="text-muted">@ ${svc.time}</small>` : ''}</div>
                            ${route}
                            ${(svc.vehicleTypeName && needsVehicle && vehicleQty === 1) ? `<small class="text-muted d-block">${svc.vehicleTypeName}</small>` : ''}
                            ${getSubconceptDetails(svc)}
                            ${hasAssignments ? `
                                <div class="mt-2">
                                    ${pairsHtml ? `<div class="d-flex flex-wrap gap-2">${pairsHtml}</div>` : ''}
                                    ${rolesHtml ? `<div class="d-flex flex-wrap gap-3 mt-2">${rolesHtml}</div>` : ''}
                                </div>
                            ` : (svc.type === 'concepto' ? '<div class="mt-2"><small class="text-muted">No requiere asignación</small></div>' : '<div class="mt-2"><small class="text-muted">Sin asignar</small></div>')}
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        ${svc.type === 'concepto' && svc.status !== 'cancelled' ? '<span class="badge bg-success text-white">Lista</span>' : getReservationStatusBadge(svc.status)}
                        <span class="text-end" style="min-width: 80px;">${formatCurrency(getServicePriceByType(svc, reservationData.paymentType), reservationData.currency)}</span>
                        ${canAssign && svc.status !== 'cancelled' && svc.type !== 'concepto' ? `<button class="btn btn-sm ${svc.status === 'completed' ? 'btn-success' : (svc.status === 'assigned' ? 'btn-outline-success' : 'btn-outline-secondary')} status-toggle-btn" data-service-id="${svc.id}" data-current-status="${svc.status}" title="${svc.status === 'completed' ? 'Revertir a asignada' : (svc.status === 'assigned' ? 'Marcar completada' : 'Marcar asignada')}"><i class="ti ${svc.status === 'completed' ? 'ti-circle-check-filled' : (svc.status === 'assigned' ? 'ti-circle-check' : 'ti-circle')}"></i></button>` : ''}
                        ${canAssign ? (() => {
            // Build the extras payload merging the REQUESTED list (from subconcept blob — never
            // overwritten by assignments) with any current assignment info already on the record.
            // svc.extraAssignments was seeded at conversion from sub.extraAdditionalVehicles, but
            // if a future flow only updates assignment fields we still want the requested type/
            // segment to come from the snapshot.
            const requestedExtras = Array.isArray(svc.subconcept?.extraAdditionalVehicles) ? svc.subconcept.extraAdditionalVehicles : [];
            const existing = Array.isArray(svc.extraAssignments) ? svc.extraAssignments : [];
            const mergedExtras = requestedExtras.length > 0
                ? requestedExtras.map((v) => {
                    const match = existing.find((ea) => ea.vehicleTypeId === (v.vehicleId || ''));
                    return {
                        vehicleTypeId: v.vehicleId || '',
                        vehicleName: v.vehicleTypeName || '',
                        segmentId: v.segment || '',
                        segmentName: v.segmentName || '',
                        segmentColor: v.segmentColor || '',
                        driverId: match?.driverId || null,
                        vehicleId: match?.vehicleId || null,
                        vehicleImageUrl: match?.vehicleImageUrl || '',
                    };
                })
                : existing;
            return `<button class="btn btn-sm btn-outline-primary assign-btn" data-service-id="${svc.id}" data-service-type="${svc.type || ''}" data-service-concept="${getDisplayConcept(svc)}" data-service-route="${svc.originName && svc.destinationName ? `${svc.originName} → ${svc.destinationName}` : (svc.originName || svc.destinationName || '')}" data-include-guide="${includeGuide}" data-include-greeter="${includeGreeter}" data-vehicle-qty="${vehicleQty}" data-driver-id="${svc.assignedDriver?.id || ''}" data-guide-id="${svc.assignedGuide?.id || ''}" data-greeter-id="${svc.assignedGreeter?.id || ''}" data-vehicle-id="${svc.assignedVehicle?.id || ''}" data-service-customer-id="${svc.assignedServiceCustomer?.id || ''}" data-vehicle-type-name="${svc.subconcept?.vehicleTypeName || svc.subconcept?.vehicleType || svc.vehicleTypeName || ''}" data-segment-name="${svc.subconcept?.categoryName || ''}" data-segment-color="${svc.subconcept?.categoryColor || ''}" data-additional-vehicle-type-name="${svc.subconcept?.additionalVehicleTypeName || svc.additionalVehicleTypeName || ''}" data-additional-segment-name="${svc.subconcept?.additionalVehicleSegmentName || svc.additionalVehicleSegmentName || ''}" data-additional-segment-color="${svc.subconcept?.additionalVehicleSegmentColor || ''}" data-extra='${JSON.stringify(mergedExtras)}'><i class="ti ti-user-plus"></i></button>`;
        })() : ''}
                    </div>
                </div>`;
            });
        });

        container.innerHTML = html;

        container.querySelectorAll('.assign-btn').forEach(btn => {
            btn.addEventListener('click', () => openAssignModal(btn));
        });

        container.querySelectorAll('.status-toggle-btn').forEach(btn => {
            btn.addEventListener('click', () => toggleServiceStatus(btn));
        });
    }

    async function toggleServiceStatus(btn) {
        const serviceId = btn.dataset.serviceId;
        const current = btn.dataset.currentStatus;
        const nextMap = { pending: 'assigned', assigned: 'completed', completed: 'assigned' };
        const newStatus = nextMap[current];
        if (!newStatus) return;

        btn.disabled = true;
        try {
            const response = await fetch(`/api/reservations/${reservationId}/services/${serviceId}/status`, {
                method: 'PATCH',
                headers: { 'Authorization': `Bearer ${authToken()}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus }),
            });
            const result = await response.json();
            if (result.success) {
                await loadReservation();
            } else {
                alert(result.error || 'Error al actualizar estado');
            }
        } catch (err) {
            console.error('Status toggle error:', err);
            alert('Error al actualizar estado');
        }
        btn.disabled = false;
    }

    async function loadEmployees() {
        if (employeesCache) return employeesCache;
        try {
            const response = await fetch('/api/employees?limit=500', {
                headers: { 'Authorization': `Bearer ${authToken()}` }
            });
            const result = await response.json();
            employeesCache = result.data?.users || result.data || result.results || [];
            return employeesCache;
        } catch { return []; }
    }

    async function loadVehicles() {
        if (vehiclesCache) return vehiclesCache;
        try {
            const response = await fetch('/api/vehicles?limit=500', {
                headers: { 'Authorization': `Bearer ${authToken()}` }
            });
            const result = await response.json();
            vehiclesCache = result.data || result.results || [];
            return vehiclesCache;
        } catch { return []; }
    }

    const roleTranslations = {
        'driver': 'Conductor',
        'conductor': 'Conductor',
        'guia': 'Guía',
        'guide': 'Guía',
        'greeter': 'Greeter',
        'employee_amexing': 'Amexing',
        'limpieza': 'Limpieza',
        'admin': 'Admin'
    };

    function translateRole(role) {
        if (!role) return '';
        return roleTranslations[role.toLowerCase()] || role;
    }

    function buildOptionHtml(items, selectedId, nameField, showRole) {
        let html = '<option value="">— Sin asignar —</option>';
        items.forEach(item => {
            const firstName = item.firstName || '';
            const lastName = item.lastName || '';
            const name = (firstName && lastName) ? `${firstName} ${lastName}` : (item[nameField] || item.fullName || item.username || item.name || 'Sin nombre');
            const id = item.id || item.objectId;
            let roleLabel = '';
            if (showRole) {
                let rolesText = '';
                if (Array.isArray(item.futureRoles) && item.futureRoles.length > 0) {
                    rolesText = item.futureRoles.map(r => translateRole(r)).join(', ');
                } else {
                    rolesText = translateRole(item.displayRole || item.role || '');
                }
                if (rolesText) roleLabel = ` · ${rolesText}`;
            }
            html += `<option value="${id}" ${id === selectedId ? 'selected' : ''}>${name}${roleLabel}</option>`;
        });
        return html;
    }

    function buildVehicleOptionHtml(vehicles, selectedId) {
        let html = '<option value="">— Sin asignar —</option>';
        vehicles.forEach(v => {
            const id = v.id || v.objectId;
            const typeName = v.vehicleTypeId?.name || '';
            const label = `${v.brand || ''} ${v.model || ''}`.trim();
            const plate = v.licensePlate ? ` (${v.licensePlate})` : '';
            const cap = v.capacity ? ` · ${v.capacity} pax` : '';
            const typePrefix = typeName ? `[${typeName}] ` : '';
            const display = `${typePrefix}${label}${plate}${cap}`;
            html += `<option value="${id}" data-name="${label}${plate}" ${id === selectedId ? 'selected' : ''}>${display}</option>`;
        });
        return html;
    }

    async function openAssignModal(btn) {
        const serviceId = btn.dataset.serviceId;
        const serviceType = btn.dataset.serviceType;
        const serviceConcept = btn.dataset.serviceConcept;
        const serviceRoute = btn.dataset.serviceRoute;
        const includeGuide = btn.dataset.includeGuide;
        const includeGreeter = btn.dataset.includeGreeter;
        // Important: parse without the `|| 1` fallback because `parseInt('0') || 1` would
        // coerce a legitimate 0 (service doesn't need vehicles) to 1.
        const parsedQty = parseInt(btn.dataset.vehicleQty, 10);
        const vehicleQty = Number.isNaN(parsedQty) ? 1 : parsedQty;
        const driverId = btn.dataset.driverId;
        const guideId = btn.dataset.guideId;
        const greeterId = btn.dataset.greeterId;
        const vehicleId = btn.dataset.vehicleId;
        const serviceCustomerId = btn.dataset.serviceCustomerId;
        const vehicleTypeName = btn.dataset.vehicleTypeName || '';
        const segmentName = btn.dataset.segmentName || '';
        const segmentColor = btn.dataset.segmentColor || '';
        const additionalVehicleTypeName = btn.dataset.additionalVehicleTypeName || '';
        const additionalSegmentName = btn.dataset.additionalSegmentName || '';
        const additionalSegmentColor = btn.dataset.additionalSegmentColor || '';
        let extraAssignments = [];
        try { extraAssignments = JSON.parse(btn.dataset.extra || '[]'); } catch { extraAssignments = []; }

        // Build per-slot expected vehicle type + segment so each pair label tells the operator
        // exactly which type of vehicle and segment goes in that slot (Sprinter / Green Class):
        //   slot 0 → main vehicle type + segment
        //   slot 1 → primary additional vehicle type + segment (if checkbox was on)
        //   slot 2+ → extras in order
        const slotSpecs = [{ type: vehicleTypeName, segment: segmentName, color: segmentColor }];
        if (additionalVehicleTypeName) {
            slotSpecs.push({ type: additionalVehicleTypeName, segment: additionalSegmentName, color: additionalSegmentColor });
        }
        extraAssignments.forEach((ea) => {
            slotSpecs.push({
                type: ea?.vehicleName || '',
                segment: ea?.segmentName || '',
                color: ea?.segmentColor || '',
            });
        });

        document.getElementById('assignServiceId').value = serviceId;

        // Modal header
        const typeLabel = getServiceTypeLabel(serviceType);
        const typeIcon = getServiceTypeIcon(serviceType);
        document.getElementById('assignModalTitle').innerHTML = `<i class="ti ${typeIcon} me-2"></i>${serviceConcept || typeLabel}`;
        const subtitleParts = [typeLabel];
        if (serviceRoute) subtitleParts.push(serviceRoute);
        document.getElementById('assignModalSubtitle').textContent = subtitleParts.join(' — ');

        const [employees, vehicles] = await Promise.all([loadEmployees(), loadVehicles()]);

        const hasFutureRole = (e, role) => Array.isArray(e.futureRoles) && e.futureRoles.some(r => r.toLowerCase() === role);
        const drivers = employees.filter(e => e.role === 'driver' || e.role === 'employee_amexing' || e.role === 'admin' || hasFutureRole(e, 'driver') || hasFutureRole(e, 'conductor'));
        const guides = employees.filter(e => e.role === 'guia' || e.role === 'employee_amexing' || e.role === 'admin' || e.displayRole === 'guia' || hasFutureRole(e, 'guia') || hasFutureRole(e, 'guide'));
        const greeters = employees.filter(e => e.role === 'greeter' || e.role === 'employee_amexing' || e.role === 'admin' || e.displayRole === 'greeter' || hasFutureRole(e, 'greeter'));
        const amexingEmployees = employees;

        // Build modal body dynamically
        const body = document.getElementById('assignModalBody');
        let html = '<input type="hidden" id="assignServiceId" value="' + serviceId + '">';

        // Vehicle/Driver pairs section
        if (vehicleQty > 1) {
            html += `<div class="mb-2"><small class="text-muted fw-semibold"><i class="ti ti-car me-1"></i>${vehicleQty} vehículos requeridos</small></div>`;
        } else if (vehicleTypeName || segmentName) {
            const inlineTypeBadge = vehicleTypeName
                ? `<span class="badge bg-secondary-subtle text-secondary ms-2"><i class="ti ti-car me-1"></i>${vehicleTypeName}</span>`
                : '';
            const inlineSegmentBadge = segmentName
                ? `<span class="badge ms-1" style="background-color: ${segmentColor || '#6c757d'}; color: #fff;">${segmentName}</span>`
                : '';
            html += `<div class="mb-2"><small class="text-muted fw-semibold">Vehículo solicitado:</small>${inlineTypeBadge}${inlineSegmentBadge}</div>`;
        }

        // Primary additional vehicle had its own dedicated checkbox in the quote modal
        // (separate from the "extras" list). To keep the slot order consistent (main → primary
        // additional → extras), the primary-additional sits at slot index 1 when present.
        const hasPrimaryAdditional = !!additionalVehicleTypeName;

        for (let i = 0; i < vehicleQty; i++) {
            // Slot mapping for assigned IDs:
            //  - i === 0           → main driver/vehicle (driverId / vehicleId top-level)
            //  - i === 1 && primary additional → no top-level legacy field; falls through to extras[0] if any
            //  - i > 0             → extraAssignments at offset (i - 1 - primaryOffset)
            const primaryOffset = hasPrimaryAdditional && i >= 1 ? 1 : 0;
            const pairDriverId = i === 0 ? driverId : (extraAssignments[i - 1 - primaryOffset]?.driverId || '');
            const pairVehicleId = i === 0 ? vehicleId : (extraAssignments[i - 1 - primaryOffset]?.vehicleId || '');
            const spec = slotSpecs[i] || { type: '', segment: '', color: '' };
            const slotLabelText = vehicleQty > 1
                ? (i === 0 ? 'Vehículo principal' : (i === 1 && hasPrimaryAdditional ? 'Vehículo adicional' : `Vehículo extra ${i - (hasPrimaryAdditional ? 1 : 0)}`))
                : '';
            const slotTypeBadge = spec.type
                ? `<span class="badge bg-secondary-subtle text-secondary ms-2"><i class="ti ti-car me-1"></i>${spec.type}</span>`
                : '';
            const slotSegmentBadge = spec.segment
                ? `<span class="badge ms-1" style="background-color: ${spec.color || '#6c757d'}; color: #fff;">${spec.segment}</span>`
                : '';

            html += `<div class="${vehicleQty > 1 ? 'vehicle-pair-group' : ''}">`;
            if (slotLabelText || slotTypeBadge || slotSegmentBadge) {
                html += `<div class="pair-label d-flex align-items-center flex-wrap">${slotLabelText}${slotTypeBadge}${slotSegmentBadge}</div>`;
            }
            html += `
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="assign-field-group mb-0">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="assign-icon bg-info-subtle text-info"><i class="ti ti-steering-wheel"></i></span>
                                <label class="form-label mb-0 fw-semibold small">Conductor</label>
                            </div>
                            <select class="form-select form-select-sm assign-driver-select" data-pair-index="${i}">
                                ${buildOptionHtml(drivers, pairDriverId, 'fullName', true)}
                            </select>
