#paymentsOffcanvas .pay-file-clear:hover { background: #f7ecea; }
#paymentsOffcanvas .pay-file-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: #4f5838;
    background: #f1f2ec;
    border: 1px solid #e0e3d6;
    border-radius: 8px;
    padding: 0.36rem 0.7rem;
