<%
/**
 * Cancellation Requests Management Page
 * Admin dashboard page for managing quote and reservation cancellation requests
 *
 * @author Denisse Maldonado
 * @version 1.0.0
 */
%>

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="ti ti-x-circle me-2 text-primary"></i>
                    Solicitudes de Cancelación
                </h2>
                <p class="text-muted mb-0">
                    Gestiona solicitudes de cancelación que requieren aprobación (menos de 24 horas)
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Page Content -->
<div class="page-content">
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); border: none;">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="card-title mb-0 text-white">
                                <i class="ti ti-x-circle me-2"></i>Solicitudes Pendientes de Aprobación
                            </h5>
                            <small class="text-white" style="opacity: 0.9;">Solicitudes de cancelación con menos de 24 horas de anticipación</small>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Status Filter Pills -->
                    <div class="mb-3">
                        <div class="btn-group" role="group" aria-label="Filtro por estado">
                            <input type="radio" class="btn-check" name="statusFilter" id="filterPending" value="pending" checked>
                            <label class="btn btn-outline-warning" for="filterPending">
                                <i class="ti ti-clock me-1"></i>Pendientes
                            </label>
                            
                            <input type="radio" class="btn-check" name="statusFilter" id="filterApproved" value="approved">
                            <label class="btn btn-outline-success" for="filterApproved">
                                <i class="ti ti-check me-1"></i>Aprobadas
                            </label>
                            
                            <input type="radio" class="btn-check" name="statusFilter" id="filterRejected" value="rejected">
                            <label class="btn btn-outline-danger" for="filterRejected">
                                <i class="ti ti-x me-1"></i>Rechazadas
                            </label>
                            
                            <input type="radio" class="btn-check" name="statusFilter" id="filterAll" value="">
                            <label class="btn btn-outline-secondary" for="filterAll">
                                <i class="ti ti-list me-1"></i>Todas
                            </label>
                        </div>
                    </div>

                    <!-- Type Filter Pills -->
                    <div class="mb-4">
                        <div class="btn-group" role="group" aria-label="Filtro por tipo">
                            <input type="radio" class="btn-check" name="typeFilter" id="filterAllTypes" value="" checked>
                            <label class="btn btn-outline-info" for="filterAllTypes">
                                <i class="ti ti-list me-1"></i>Todos los tipos
                            </label>
                            
                            <input type="radio" class="btn-check" name="typeFilter" id="filterQuotes" value="quote">
                            <label class="btn btn-outline-primary" for="filterQuotes">
                                <i class="ti ti-file-text me-1"></i>Cotizaciones
                            </label>
                            
                            <input type="radio" class="btn-check" name="typeFilter" id="filterReservations" value="reservation">
                            <label class="btn btn-outline-success" for="filterReservations">
                                <i class="ti ti-calendar me-1"></i>Reservaciones
                            </label>
                        </div>
                    </div>

                    <!-- Cancellation Requests Table -->
                    <div class="table-responsive">
                        <table id="cancellationRequestsTable" class="table table-striped table-hover w-100">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-nowrap">Folio</th>
                                    <th class="text-nowrap">Tipo</th>
                                    <th class="text-nowrap">Cliente</th>
                                    <th class="text-nowrap">Motivo</th>
                                    <th class="text-nowrap">Horas Restantes</th>
                                    <th class="text-nowrap">Fecha del Evento</th>
                                    <th class="text-nowrap">Estado</th>
                                    <th class="text-nowrap">Solicitado por</th>
                                    <th class="text-nowrap">Fecha Solicitud</th>
                                    <th class="text-nowrap">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Data will be loaded via DataTables -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reviewModalLabel">
                    <i class="ti ti-eye me-2"></i>Revisar Solicitud de Cancelación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Request details will be loaded here -->
                <div id="modalContent">
                    <!-- Loading spinner -->
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" id="rejectBtn" style="display: none;">
                    <i class="ti ti-x me-2"></i>Rechazar
                </button>
                <button type="button" class="btn btn-success" id="approveBtn" style="display: none;">
                    <i class="ti ti-check me-2"></i>Aprobar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Approval Confirmation Modal -->
<div class="modal fade" id="approvalModal" tabindex="-1" aria-labelledby="approvalModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="approvalModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="approvalContent"></div>
                
                <div class="mt-3">
                    <label for="adminComments" class="form-label">Comentarios (opcional)</label>
                    <textarea 
                        class="form-control" 
                        id="adminComments" 
                        rows="3" 
                        placeholder="Agregue comentarios adicionales sobre esta decisión..."
                    ></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn" id="confirmActionBtn">Confirmar</button>
            </div>
        </div>
    </div>
</div>