<%
/**
 * Reservation itinerary — travel-itinerary style PDF, rendered by
 * PublicReservationController.viewReservationItinerary and exported via puppeteer (?pdf=1).
 */
const q = quote || {};
const si = q.serviceItems || {};
const days = Array.isArray(si.days) ? si.days : [];
const specialist = q.travelSpecialist || null;

const MONTHS = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const DOW = ['SUNDAY', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'];
const DOW_ES = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

const toDate = (v) => {
  if (!v) return null;
  if (v instanceof Date) return v;
  if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v)) {
    const [y, m, d] = v.split('-').map(Number);
    return new Date(y, m - 1, d);
  }
  const d = new Date(v);
  return Number.isNaN(d.getTime()) ? null : d;
};

const guestName = `${q.leadGuestFirstName || ''} ${q.leadGuestLastName || ''}`.trim()
  || q.contactPerson
  || `${q.contactFirstName || ''} ${q.contactLastName || ''}`.trim()
  || (q.client && q.client.companyName)
  || (q.client && `${q.client.firstName || ''} ${q.client.lastName || ''}`.trim())
  || 'Huésped';

const startDate = toDate(q.startDate) || (days[0] && toDate(days[0].date));
const endDate = toDate(q.endDate) || (days.length && toDate(days[days.length - 1].date));

let headerMonth = '';
let headerRange = '';
let headerYear = '';
if (startDate) {
  headerMonth = MONTHS[startDate.getMonth()];
  headerYear = String(startDate.getFullYear());
  const startDay = startDate.getDate();
  const endDay = endDate ? endDate.getDate() : startDay;
  headerRange = endDate && endDay !== startDay ? `${startDay}-${endDay}` : String(startDay);
}

// Duración del servicio POR TIPO: cada uno la guarda en un campo distinto y no son intercambiables.
//   a-disposición      -> hours          (horas contratadas)
//   tour / experiencia -> duration       (duración del catálogo, en horas)
//   traslado           -> routeDuration  (duración de la ruta, en MINUTOS)
//   concepto           -> ninguna
// El orden importa: los subconceptos arrastran un `duration: 1` espurio en todo lo que no es tour, así
// que evaluar `duration || hours` lo hacía ganar y un a-disposición de 6 h se anunciaba como "1 hour".
const serviceDuration = (sc) => {
  if (sc.type === 'a-disposicion') {
    const h = Number(sc.hours || 0);
    return h > 0 ? { hours: h } : null;
  }
  if (sc.type === 'tour' || sc.type === 'experience' || sc.type === 'experiencia') {
    const h = Number(sc.duration || sc.hours || 0);
    return h > 0 ? { hours: h } : null;
  }
  if (sc.type === 'transport' || sc.type === 'traslado') {
    const min = Number(sc.routeDuration || 0);
    return min > 0 ? { minutes: min } : null;
  }
  return null;
};
// Horas en una sola forma: "1 hr", "6 hrs". Igual que en el detalle de reservación.
const hoursText = (h) => {
  const n = Number(h) || 0;
  return `${n} hr${n === 1 ? '' : 's'}`;
};

const durationLabel = (sc) => {
  const d = serviceDuration(sc);
  if (!d) return '';
  if (d.minutes) {
    const h = Math.floor(d.minutes / 60);
    const m = d.minutes % 60;
    if (h === 0) return `${m} min`;
    // "hr/hrs", y en español: este documento está en español y decía "hour/hours".
    return m ? `${hoursText(h)} ${m} min` : hoursText(h);
  }
  return hoursText(d.hours);
};

// Ubicaciones del servicio, en renglones etiquetados. En los TRASLADOS son las DIRECCIONES exactas de
// pick-up y drop-off: la ruta ya la dice el título, pero la calle y el punto de encuentro no se
// mostraban en ningún lado de este documento — y son justo lo que el pasajero necesita. En tours y
// experiencias se conserva el origen/destino por nombre, porque ahí el título es el nombre del servicio.
const locationLines = (sc) => {
  const lines = [];
  const add = (label, value) => {
    const v = String(value == null ? '' : value).trim();
    if (v) lines.push({ label, value: v });
  };
  if (sc.type === 'transport' || sc.type === 'traslado') {
    if (sc.tripType === 'round-trip') {
      add('Pick-up (ida)', sc.pickupAddressIda);
      add('Drop-off (ida)', sc.dropoffAddressIda);
      add('Pick-up (regreso)', sc.pickupAddressVuelta);
      add('Drop-off (regreso)', sc.dropoffAddressVuelta);
    } else {
      add('Pick-up', sc.pickupAddress);
      add('Drop-off', sc.dropoffAddress);
    }
  } else {
    add('Desde', sc.originName);
    add('Hacia', sc.destinationName);
    add('Pick-up', sc.pickupAddress);
  }
  return lines;
};

// Nombres de las personas del servicio. El DTO ya los exponía (attendees) pero este documento nunca los
// mostraba: complementan a peopleLabel, que dice cuántos son pero no quiénes. Sin rótulo, igual que
// peopleLabel: en este documento los únicos nombres son los del propio cliente, así que no hay con qué
// confundirlos.
const attendeesLine = (sc) => {
  const names = Array.isArray(sc.attendees)
    ? sc.attendees.map((n) => String(n == null ? '' : n).trim()).filter(Boolean)
    : [];
  return names.length ? escapeHtml(names.join(', ')) : '';
};

// Hora que encabeza el servicio. En una SALIDA a aeropuerto no es la del avión sino la del PICK-UP:
// el pasajero leía "18:00" arriba y entendía que a esa hora pasaban por él, cuando la camioneta sale
// mucho antes. La del vuelo sigue visible en la tabla de vuelos, así que no se pierde nada.
// Mismo criterio que servicePickupTime del detalle de reservación.
const roundDownTo15 = (timeStr) => {
  if (!timeStr || !String(timeStr).includes(':')) return timeStr || '';
  const [hours, minutes] = String(timeStr).split(':').map(Number);
  if (Number.isNaN(hours) || Number.isNaN(minutes)) return timeStr;
  const total = Math.floor((hours * 60 + minutes) / 15) * 15;
  return `${String(Math.floor(total / 60) % 24).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
};

const serviceStartTime = (sc) => {
  const isTransport = sc.type === 'transport' || sc.type === 'traslado';
  if (isTransport && sc.transportType === 'aeropuerto' && sc.directionType === 'departure') {
    const suggested = sc.flightDepartureTimeSuggested;
    if (suggested) return roundDownTo15(suggested) || suggested;
  }
  let t = sc.time || sc.startTime || '';
  if (!t && sc.selectedSchedule) {
    const m = String(sc.selectedSchedule).match(/^(\d{1,2}:\d{2})/);
    if (m) [, t] = m;
  }
  return t;
};

const titleFor = (sc) => {
  if (sc.concept && sc.concept.trim()) return sc.concept;
  if (sc.destinationPOI) return sc.destinationPOI;
  if (sc.originName && sc.destinationName) return `${sc.originName} → ${sc.destinationName}`;
  if (sc.type === 'a-disposicion') {
    // `hours` primero por lo mismo: con duration primero, un a-disposición de 6 h se titulaba "1 hora".
    const h = Number(sc.hours || sc.duration || 0);
    return h ? `A Disposición - ${hoursText(h)}` : 'A Disposición';
  }
  return sc.serviceType || 'Servicio';
};

const peopleLabel = (sc) => {
  const parts = [];
  const adults = Number(sc.adultsQuantity || 0) + Number(sc.adultsNoAlcoholQuantity || 0);
  const children = Number(sc.childrenQuantity || 0);
  const infants = Number(sc.infantsQuantity || 0);
  if (adults) parts.push(`${adults} ${adults === 1 ? 'adulto' : 'adultos'}`);
  if (children) parts.push(`${children} ${children === 1 ? 'niño' : 'niños'}`);
  if (infants) parts.push(`${infants} ${infants === 1 ? 'infante' : 'infantes'}`);
  if (!parts.length && sc.numberOfPeople) {
    const n = Number(sc.numberOfPeople);
    return `${n} ${n === 1 ? 'persona' : 'personas'}`;
  }
  return parts.join(', ');
};

// Lines starting with "-" render as a bullet list; everything else stays plain text.
const escapeHtml = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const renderNotes = (text) => {
  const lines = String(text).split('\n');
  if (!lines.some((l) => l.trim().startsWith('-'))) return escapeHtml(text);
  let html = ''; let inList = false;
  for (const raw of lines) {
    const line = raw.trim();
    if (line.startsWith('-')) {
      if (!inList) { html += '<ul class="itin-notes-list">'; inList = true; }
      html += `<li>${escapeHtml(line.replace(/^-\s*/, ''))}</li>`;
    } else {
      if (inList) { html += '</ul>'; inList = false; }
      if (line) html += `<div>${escapeHtml(line)}</div>`;
    }
  }
  if (inList) html += '</ul>';
  return html;
};

const dayLabel = (day) => {
  const d = toDate(day.date);
  if (!d) return day.title || day.dayTitle || `Día ${day.dayNumber}`;
  return `${DOW[d.getDay()]}. ${MONTHS[d.getMonth()].slice(0, 3)} ${d.getDate()}`;
};

// `address` se quitó junto con el bloque por servicio que la repetía: ya no se usa en ningún lado.
const COMPANY = {
  name: 'Amexing Experience',
  url: 'https://www.amexingexperience.com/en',
};

const LOGO_URL = q.logoUrl || '/images/logos/light_white_amexing.png';
const HEADER_BG = q.headerBg || '/images/header_bg_pdf.png';
const ICON_BASE = '/images/icons';

// Arpona embedded inline (base64) by the controller so the cover renders correctly even
// when a proxy/WAF blocks the .otf network requests (HTTP 426) — no network fetch needed.
const ARPONA_EMBED_CSS = typeof arponaEmbedCss === 'string' ? arponaEmbedCss : '';
const MYRIAD_EMBED_CSS = typeof myriadEmbedCss === 'string' ? myriadEmbedCss : '';
// "Incluye / no incluye" de tours y experiencias. Las inyecta injectServiceIncludes desde el
// catálogo (el subconcepto guardado no las trae), así que aquí solo se normaliza: pueden faltar,
// venir vacías o traer entradas en blanco.
const includeLists = (sc) => ({
  includes: Array.isArray(sc.includes) ? sc.includes.filter(Boolean) : [],
  notIncludes: Array.isArray(sc.notIncludes) ? sc.notIncludes.filter(Boolean) : [],
});

const iconKey = (sc) => {
  if (sc.type === 'traslado' || sc.type === 'transport') {
    if (sc.transportType === 'aeropuerto') return sc.directionType === 'departure' ? 'departure' : 'arrival';
    return 'transfer';
  }
  // «A disposición» es un vehículo con chofer por horas, así que lleva el ícono de traslado igual que
  // el resto del transporte. Antes caía al default y salía con el de experiencias, que no le
  // corresponde. Mismo criterio que getServiceIconKey en el detalle de reservación.
  if (sc.type === 'a-disposicion') return 'transfer';
  if (sc.type === 'tour') return 'city';
  if (sc.type === 'experiencia') return 'experience';
  return 'experience';
};

// ---------------------------------------------------------------------------
// Asignaciones por servicio
//
// Chofer y vehículo van EMPAREJADOS, no en renglones sueltos: el pasajero los lee como una
// sola cosa («me recoge Juan en la Hiace blanca, placas ABC-12-34»). Ponerlos en filas
// separadas dejaría la relación a la simple adyacencia, y con dos vehículos deja de leerse.
// El nombre + color de segmento (Green Class / Premium) es lo que le dice CUÁL camioneta es
// la suya cuando hay más de una esperando.
//
// Plazas incompletas: si el servicio pide 2 vehículos y solo 1 está asignado, la plaza que falta
// SÍ se dibuja, en gris y con borde punteado. El cliente ve que el lugar existe y está por
// confirmarse, en vez de creer que su traslado va con un solo vehículo. La redacción evita la
// jerga del operador («Conductor pendiente»): aquí es «por confirmar» + «te avisamos».
// ---------------------------------------------------------------------------

// Cuántos vehículos NECESITA el servicio. Mismo criterio que el detalle interno: en
// «a disposición» el conteo vive en vehicleCount; en el resto, en quantity.
const vehicleSlotCount = (sc) => {
  const isTransport = sc.type === 'transport' || sc.type === 'traslado';
  const isAtDisposal = sc.type === 'a-disposicion';
  const isTour = sc.type === 'tour';
  const hasVehicleData = !!(sc.vehicleType || sc.vehicleTypeName || sc.additionalVehicleId
    || (Array.isArray(sc.extraAdditionalVehicles) && sc.extraAdditionalVehicles.length > 0));
  const needsVehicle = isTransport || isAtDisposal || (isTour && !sc.isWalkingTour && hasVehicleData);
  if (!needsVehicle) return 0;
  if (isAtDisposal) return Number(sc.vehicleCount) || 1;
  return Number(sc.quantity) || 1;
};

// Tipo y segmento ESPERADOS de cada plaza: plaza 0 = vehículo principal, plaza 1 = adicional
// cuando venía marcado, 2+ = extras en orden (mismo mapeo que el modal de asignación del detalle).
// Así una plaza vacía anuncia QUÉ vehículo va a ser —«Suburban»— en vez del genérico «Vehículo».
// `vehicleType` guarda normalmente el objectId del catálogo, pero en algunos registros trae el
// NOMBRE ("SEDAN") ahí. Aprovecharlo recupera el tipo sin tocar la base; el guardia evita que un
// objectId real se imprima en el PDF del cliente como si fuera un modelo de camioneta. Los objectId
// de Parse son 10 alfanuméricos con mayúsculas y minúsculas mezcladas, forma que ningún nombre del
// catálogo tiene (SEDAN, SUBURBAN, JAC Sunray, Van Turística…).
const vehicleTypeAsName = (value) => {
  const v = String(value == null ? '' : value).trim();
  if (!v) return '';
  const looksLikeObjectId = /^[A-Za-z0-9]{10}$/.test(v) && /[a-z]/.test(v) && /[A-Z]/.test(v);
  return looksLikeObjectId ? '' : v;
};

const vehicleSlotSpecs = (sc) => {
  const specs = [{
    type: sc.vehicleTypeName || vehicleTypeAsName(sc.vehicleType) || '',
    segment: sc.categoryName || '',
    color: sc.categoryColor || '',
  }];
  if (sc.additionalVehicleTypeName) {
    specs.push({
      type: sc.additionalVehicleTypeName,
      segment: sc.additionalVehicleSegmentName || '',
      color: sc.additionalVehicleSegmentColor || '',
    });
  }
  // Las plazas 3+ se leen de `extraAdditionalVehicles` —la lista COTIZADA— y no de los extras ya
  // asignados: la cotizada siempre trae vehicleTypeName, segmentName y segmentColor, así que una
  // plaza extra vacía anuncia su tipo igual que la principal en vez de quedar como «Vehículo».
  const expected = Array.isArray(sc.extraAdditionalVehicles) ? sc.extraAdditionalVehicles : [];
  const assigned = (sc.assignments && sc.assignments.extras) || [];
  for (let i = 0; i < Math.max(expected.length, assigned.length); i += 1) {
    const exp = expected[i] || {};
    const asg = assigned[i] || {};
    specs.push({
      type: exp.vehicleTypeName || asg.vehicleName || '',
      segment: exp.segmentName || asg.segmentName || '',
      color: exp.segmentColor || asg.segmentColor || '',
    });
  }
  return specs;
};

const assignmentPairs = (sc) => {
  const a = sc.assignments || {};
  const slots = vehicleSlotCount(sc);
  // ¿La plaza ofrece chofer? Mismo criterio que el detalle interno: el checkbox de la cotización se
  // llama "Guía + Chofer" y lo que contrata es el CHOFER.
  //   traslado      → siempre: sin chofer no hay traslado.
  //   tour          → solo con "Guía + Chofer": el tour ya trae guía propio y el chofer es el extra.
  //   a disposición → nunca en la plaza: ahí el chofer se captura en el campo de guía.
  const isAtDisposal = sc.type === 'a-disposicion';
  const isTransport = sc.type === 'transport' || sc.type === 'traslado';
  const offersDriver = isAtDisposal ? false : (isTransport ? true : !!sc.includeGuide);
  const pairs = [];
  const push = (driver, vehicle, segmentName, segmentColor) => {
    const hasDriver = !!(driver && driver.fullName);
    const hasVehicle = !!(vehicle && vehicle.name);
    if (!hasDriver && !hasVehicle) return;
    pairs.push({
      driver: hasDriver ? driver : null,
      vehicle: hasVehicle ? vehicle : null,
      offersDriver,
      needsDriver: hasVehicle && !hasDriver && offersDriver,
      needsVehicle: hasDriver && !hasVehicle && slots > 0,
      segmentName: segmentName || '',
      segmentColor: segmentColor || '',
    });
  };
  push(a.driver, a.vehicle, sc.categoryName, sc.categoryColor);
  (a.extras || []).forEach((e) => push(e.driver, e.vehicle, e.segmentName, e.segmentColor));

  // Se rellena hasta las plazas que pide el servicio. Math.max porque si ya hay más parejas
  // asignadas que el `quantity` capturado, manda lo asignado: nunca se oculta a nadie real.
  const specs = vehicleSlotSpecs(sc);
  // El piso por specs solo cuando el servicio lleva vehículo: specs siempre tiene la plaza
  // principal, y sin este guardia un tour caminando acabaría pidiendo camioneta.
  const total = slots > 0 ? Math.max(slots, pairs.length, specs.length) : pairs.length;
  for (let i = pairs.length; i < total; i += 1) {
    const spec = specs[i] || {};
    // El tipo va en la línea en negrita y «Por confirmar» debajo, igual que en un renglón
    // asignado: arriba qué es, abajo el detalle y el estado.
    // El segmento se hereda del servicio cuando la plaza no trae uno propio: los campos por plaza
    // existen para poder DIFERIR del servicio y casi nunca están capturados, así que sin la herencia
    // un traslado Premium de dos vehículos anunciaba "Premium" solo en la primera plaza.
    pairs.push({
      driver: null,
      vehicle: null,
      pending: true,
      offersDriver,
      label: spec.type || 'Vehículo',
      segmentName: spec.segment || sc.categoryName || '',
      segmentColor: spec.color || sc.categoryColor || '',
    });
  }
  return pairs;
};

// Roles que no van amarrados a un vehículo. En «a disposición» el chofer se captura en el
// campo de guía — mismo criterio que el detalle interno (ver buildPersonCard en booking-detail).
// includeGuide / includeGreeter dicen si el servicio los lleva, así que un rol contratado y sin
// asignar también se muestra por confirmar. `serviceCustomer` no tiene bandera: solo si existe.
const assignmentRoles = (sc) => {
  const a = sc.assignments || {};
  const isAtDisposal = sc.type === 'a-disposicion';
  const isTour = sc.type === 'tour';
  const guideRole = isAtDisposal ? 'Chofer' : 'Guía';
  const rows = [
    // Un tour SIEMPRE trae guía propio y un «a disposición» siempre trae chofer: no dependen del
    // checkbox. En traslados y experiencias sí, porque ahí el guía es el extra que se contrata.
    { person: a.guide, role: guideRole, expected: !!sc.includeGuide, always: isTour || isAtDisposal },
    { person: a.greeter, role: 'Greeter', expected: !!sc.includeGreeter },
    { person: a.serviceCustomer, role: 'Customer Support', expected: false },
  ];
  return rows
    .filter((r) => r.always || (r.person && r.person.fullName) || r.expected)
    .map((r) => (r.person && r.person.fullName
      ? { role: r.role, person: r.person }
      : { role: r.role, person: null, pending: true }));
};

// escapeHtml NO escapa comillas, así que no sirve dentro de un atributo: una URL con `"` se
// saldría del src e inyectaría markup en esta página, que es pública y sin auth.
const escapeAttr = (s) => escapeHtml(s).replace(/"/g, '&quot;').replace(/'/g, '&#39;');

// El color del segmento se pinta en un style inline, así que se valida en vez de escaparse:
// solo hex o un nombre de color simple; cualquier otra cosa se descarta.
const safeColor = (s) => (/^(#[0-9a-fA-F]{3,8}|[a-zA-Z]{3,20})$/.test(String(s || '').trim())
  ? String(s).trim() : '');

// Iniciales: es el respaldo REAL cuando profilePhotoUrl viene vacío (pasa seguido), no un adorno.
const initialsOf = (name) => String(name || '').trim().split(/\s+/).slice(0, 2)
  .map((w) => w.charAt(0).toUpperCase()).join('') || '·';

// La foto va ENCIMA de las iniciales, así que si la URL falla en el PDF quedan las iniciales
// visibles en vez de un círculo vacío.
const personAvatar = (person) => {
  const ini = escapeHtml(initialsOf(person && person.fullName));
  const url = person && person.profilePhotoUrl;
  return `<div class="itin-av">${ini}${url ? `<img src="${escapeAttr(url)}" alt="" onerror="this.remove()">` : ''}</div>`;
};

const vehicleAvatar = (vehicle) => {
  const url = vehicle && vehicle.imageUrl;
  return `<div class="itin-av itin-av-veh"><i class="ti ti-car"></i>${url ? `<img src="${escapeAttr(url)}" alt="" onerror="this.remove()">` : ''}</div>`;
};

// Plaza vacía: mismo círculo, punteado y sin relleno, para que se lea como «hay lugar aquí».
const pendingAvatar = (icon) => `<div class="itin-av itin-av-pend"><i class="ti ti-${icon}"></i></div>`;

// Segunda línea de la pareja: segmento (con su punto de color), placas y teléfono, en ese orden
// —lo que sirve para identificar la unidad primero, y para localizar al chofer después. Cuando
// falta una mitad, esa mitad ocupa el primer lugar de la línea.
const segmentBit = (p) => {
  if (!p.segmentName) return '';
  const color = safeColor(p.segmentColor);
  const dot = color ? `<span class="itin-seg-dot" style="background:${color};"></span>` : '';
  return `${dot}${escapeHtml(p.segmentName)}`;
};

// Una línea por DUEÑO. Antes iba todo en una sola cadena —segmento, placa y teléfono separados por
// el mismo `·`— y no se distinguía de quién era qué: la placa es del vehículo y el teléfono de la
// persona. Ahora cada dato va pegado a quien le corresponde, y el segmento queda solo al final
// porque no es de ninguno de los dos: es de la plaza.
const pairLines = (p) => {
  const out = [];
  if (p.driver) {
    const tel = p.driver.phone ? ` · ${escapeHtml(p.driver.phone)}` : '';
    out.push(`<div class="n">${escapeHtml(p.driver.fullName)}${tel}</div>`);
  } else if (p.needsDriver) {
    out.push('<div class="itin-pend-txt">Chofer por confirmar</div>');
  }
  if (p.vehicle) {
    // La placa va en cápsula monoespaciada en vez de con la palabra "Placas": la forma dice que es
    // un identificador y aguanta placas que no parecen placa.
    const plate = p.vehicle.plate ? ` <span class="itin-plate">${escapeHtml(p.vehicle.plate)}</span>` : '';
    out.push(`<div><span class="itin-veh-name">${escapeHtml(p.vehicle.name)}</span>${plate}</div>`);
  } else if (p.needsVehicle) {
    out.push('<div class="itin-pend-txt">Vehículo por confirmar</div>');
  }
  const seg = segmentBit(p);
  if (seg) out.push(`<div>${seg}</div>`);
  return out.join('');
};
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= pageTitle || 'Itinerario' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/dashboard/css/icons/tabler-icons/tabler-icons.css">
  <link rel="stylesheet" href="/css/fonts.css">
  <% if (ARPONA_EMBED_CSS) { %><style id="arpona-embedded">
    <%- ARPONA_EMBED_CSS %>
    /* Cover headings use the embedded TTF family directly so Chrome embeds it in the PDF. */
    .itin-guest, .itin-dates { font-family: 'ArponaPDF', var(--font-arpona, 'Helvetica Neue', Arial, sans-serif) !important; }
  </style><% } %>
  <% if (MYRIAD_EMBED_CSS) { %><style id="myriad-embedded">
    <%- MYRIAD_EMBED_CSS %>
    /* @font-face only; body / .itin-resnum reference 'MyriadPDF' in the main stylesheet
       below so Chrome embeds the TTF in the PDF (the .otf faces from fonts.css are dropped). */
  </style><% } %>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'MyriadPDF', var(--font-myriad, 'Segoe UI', Tahoma, sans-serif);
      color: #2b2b2b;
      margin: 0;
      background: #fff;
      font-size: 13px;
    }
    .itin { max-width: none; width: 100%; margin: 0; }

    /* Header */
    .itin-header { color: #fff; }
    .itin-logo-img { max-width: 230px; height: auto; }
    .itin-icon img { width: 50px; height: 50px; object-fit: contain; }

    /* Solid sage top bar: left logo (vertically centered) + travel specialist on the right */
    .itin-topbar {
      display: flex; justify-content: space-between; align-items: center;
      background: #8a8c6e; padding: 22px 28px;
    }

    /* Photo hero with white fade: guest name + dates + reservation number */
    .itin-hero {
      position: relative; text-align: center; color: #2b2b2b;
      background: #6f7459 url('<%= HEADER_BG %>') center/cover no-repeat;
      padding: 24px 28px 8px;
    }
    /* No CSS white overlay — header_bg_pdf.png already has the white wash/fade baked in. */
    .itin-hero > * { position: relative; z-index: 1; }
    .itin-specialist { text-align: right; font-size: 1rem; line-height: 1.55; opacity: 0.95; }
    .itin-specialist .name { font-size: 1.35rem; font-weight: 400; }
    .itin-specialist .name strong { font-weight: 700; }

    /* Cover headings use Arpona (matches the approved VF), not the body Myriad. */
    .itin-guest {
      font-family: var(--font-arpona, 'Helvetica Neue', Arial, sans-serif);
      margin: 8px auto 0;
      text-align: center;
      font-size: 3.2rem;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 1px;
      color: #2b2b2b;
    }
    .itin-dates { font-family: var(--font-arpona, 'Helvetica Neue', Arial, sans-serif); text-align: center; line-height: 0.9; color: #555555; max-width: 360px; margin: 4px auto 0; padding: 8px 0; border-top: 1px solid #b8b8a8; border-bottom: 1px solid #b8b8a8; }
    .itin-dates .month { font-size: 2.1rem; font-weight: 400; letter-spacing: 8px; text-transform: capitalize; }
    .itin-dates .range { font-size: 3.6rem; font-weight: 300; letter-spacing: 6px; margin: -2px 0; }
    .itin-dates .year { font-size: 1.3rem; font-weight: 400; letter-spacing: 6px; opacity: 0.85; }
    .itin-resnum { font-family: 'MyriadPDF', var(--font-myriad, 'Segoe UI', Tahoma, sans-serif); font-weight: 300; text-align: center; margin-top: 12px; font-size: 0.85rem; letter-spacing: 1px; }
    .itin-resnum strong { font-weight: 700; }

    /* Day bar */
    .itin-day-bar {
      background: #888888; color: #fff;
      font-family: 'ArponaPDF', var(--font-arpona, 'Helvetica Neue', Arial, sans-serif);
      font-weight: 500; font-size: 0.8rem;
      letter-spacing: 1px; padding: 0 28px; margin-top: 18px;
      break-after: avoid; page-break-after: avoid;
    }
    .itin-day-bar + .itin-entry { padding-top: 16px; }

    /* Timeline entry */
    .itin-entry { display: flex; gap: 16px; padding: 0 28px; break-inside: avoid; page-break-inside: avoid; }
    .itin-rail { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
    .itin-icon {
      width: 56px; height: 56px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center; color: #6f7459; font-size: 1.3rem;
      background: #fff;
    }
    /* box-decoration-break:clone re-applies padding-top + the gradient line on each page
       fragment, so pages 2+ get top breathing room while the line runs through the break. */
    .itin-timeline {
      background: linear-gradient(#d8dac9, #d8dac9) no-repeat 56px 0 / 1.5px 100%;
      padding-top: 12mm;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
    /* First day sits flush against the hero photo (cancels the timeline's top padding
       on page 1 only; pages 2+ keep their 12mm breathing room). */
    .itin-day-bar:first-child { margin-top: -12mm; }
    .itin-body { flex: 1; min-width: 0; padding-bottom: 18px; }

    .itin-time { font-size: 0.95rem; font-weight: 700; color: #1b1b1b; }
    .itin-time .tz { font-weight: 400; color: #8a8a8a; }
    .itin-svc-title { font-size: 1.05rem; font-weight: 700; color: #1b1b1b; margin-top: 1px; }
    .itin-sub { color: #6c757d; margin-top: 2px; }

    /* Flight detail table */
    .itin-flight { display: grid; grid-template-columns: repeat(5, auto); gap: 2px 28px; margin-top: 8px; }
    .itin-flight .h { font-size: 0.7rem; color: #8a8a8a; }
    .itin-flight .v { font-size: 0.9rem; color: #1b1b1b; font-weight: 600; }

    .itin-desc { margin-top: 8px; color: #555; line-height: 1.55; white-space: pre-line; text-align: justify; }

    /* Incluye / no incluye. Los marcadores son glifos de TEXTO (✓ / ×) y no íconos de fuente: en el
       PDF de puppeteer un ::before con font-family de iconos depende del codepoint y se rompe callado,
       mientras que estos renderizan con cualquier tipografía. */
    .itin-inc { display: flex; flex-wrap: wrap; gap: 10px 34px; margin-top: 12px; }
    .itin-inc-col { min-width: 180px; }
    .itin-inc-lbl {
      font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.09em;
      font-weight: 700; color: #8a8f78; margin-bottom: 3px;
    }
    .itin-inc-list { margin: 0; padding: 0; list-style: none; }
    .itin-inc-list li { position: relative; padding-left: 15px; line-height: 1.5; color: #555; }
    .itin-inc-list li::before { position: absolute; left: 0; font-weight: 700; }
    .itin-inc-list.is-yes li::before { content: '\2713'; color: #6f7459; }
    .itin-inc-list.is-no li::before { content: '\00D7'; color: #a09c8d; }

    /* Per-service assignments: driver + vehicle paired, unattached roles below */
    .itin-assign { margin-top: 14px; display: flex; flex-direction: column; gap: 10px; }
    .itin-assign-row { display: flex; align-items: center; gap: 12px; }
    .itin-av {
      position: relative; width: 54px; height: 54px; border-radius: 50%; flex-shrink: 0;
      overflow: hidden; display: flex; align-items: center; justify-content: center;
      background: #eef0e8; color: #6f7459; font-weight: 700; font-size: 0.9rem;
    }
    .itin-av img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
    .itin-av-veh { background: #f3f1ea; color: #a89a7a; font-size: 1.35rem; }
    /* Plaza vacía: punteada y sin relleno, se lee como «aquí falta alguien» sin gritar. */
    .itin-av-pend { background: #fff; border: 1.5px dashed #d4d0c2; color: #b9b5a6; font-size: 1.25rem; }
    /* Los dos avatares se solapan para que la pareja se lea como una sola unidad. El aro blanco que
       los separa va en box-shadow, NO en border: con border, este selector (más específico) le ganaba
       a .itin-av-pend y le borraba el punteado al segundo círculo de una plaza vacía. */
    .itin-duo { display: flex; flex-shrink: 0; }
    .itin-duo .itin-av + .itin-av { margin-left: -14px; box-shadow: 0 0 0 2px #fff; }
    .itin-assign-meta { font-size: 0.86rem; line-height: 1.45; color: #555; min-width: 0; }
    .itin-assign-meta .n { font-size: 0.95rem; font-weight: 700; color: #1b1b1b; }
    /* Va después de `.n` y con la clase encadenada: si no, `.itin-assign-meta .n` le gana el
       peso y el color, y el renglón pendiente se vería igual que uno asignado. */
    .itin-assign-meta .itin-pend-txt,
    .itin-assign-meta .n.itin-pend-txt { font-style: italic; font-weight: 400; color: #a09c8d; }
    /* El tipo esperado de una plaza vacía conserva la negrita —ES el sujeto del renglón— pero
       apagado, y sin itálica: es un dato, no un estado. Encadenada por lo mismo que la de arriba. */
    .itin-assign-meta .n.itin-pend-name { color: #8a8f78; }
    /* El vehículo es un sujeto igual que la persona, pero una cosa: mismo cuerpo, menos peso que el
       nombre, para que la jerarquía diga "a quién" antes que "en qué". */
    .itin-veh-name { font-weight: 600; color: #1b1b1b; }
    /* Placa en cápsula monoespaciada, en vez de la palabra "Placas": la forma dice que es un
       identificador y aguanta placas que no parecen placa ("A", "AUDICALSEA"). */
    .itin-plate {
      display: inline-block;
      margin-left: 4px;
      padding: 0 5px;
      border: 1px solid #dcdccf;
      border-radius: 4px;
      background: #fbfaf6;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.76rem;
      letter-spacing: 0.04em;
      color: #4a4a44;
      white-space: nowrap;
    }
    .itin-assign-role { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.09em; font-weight: 700; color: #8a8f78; }
    .itin-seg-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 5px; vertical-align: 1px; }

    /* Botón flotante de descarga. Vive DENTRO del documento porque esta vista es una ruta PÚBLICA:
       quien recibe el link no entra al detalle de la reservación, así que sin esto su única forma de
       obtener el PDF sería imprimir desde el navegador. Fijo y no pegado al encabezado: el itinerario
       son varias páginas y la decisión de descargarlo suele tomarse después de leerlo, no antes.
       Con etiqueta y no un ícono pelón: un glifo de descarga solo, sobre un documento de viaje, se
       puede leer como cualquier cosa. */
    .itin-fab {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 50;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 18px;
      border-radius: 999px;
      background: #6f7459;
      color: #fff;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1;
      box-shadow: 0 6px 20px rgba(43, 43, 43, 0.22);
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .itin-fab:hover { background: #566040; color: #fff; transform: translateY(-1px); }
    .itin-fab:focus-visible { outline: 3px solid #b7c39a; outline-offset: 2px; }
    .itin-fab.is-busy { pointer-events: none; background: #8a8f78; }
    .itin-fab i { font-size: 1.1rem; }
    /* Girito propio, sin depender de que Bootstrap haya cargado.
       `display: inline-block` es obligatorio: es un <span>, y width/height NO aplican a un elemento
       inline —colapsaba a la altura de la línea y se veía como una tirita vertical—. `flex: none`
       para que el contenedor flex tampoco lo comprima. */
    .itin-fab-spin {
      display: inline-block;
      flex: none;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, 0.45);
      border-top-color: #fff;
      animation: itin-spin 0.7s linear infinite;
    }
    /* El contenedor del ícono también es un <span> inline: en flex se comporta bien, pero se declara
       para que el spinner quede centrado igual que el ícono al que sustituye. */
    #itinPdfFabIco { display: inline-flex; align-items: center; }
    @keyframes itin-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      .itin-fab { transition: none; }
      .itin-fab:hover { transform: none; }
    }
    /* En pantallas angostas se queda solo el ícono, para no tapar el documento. */
    @media (max-width: 560px) {
      .itin-fab-txt { display: none; }
      .itin-fab { padding: 14px; right: 14px; bottom: 14px; }
    }
    /* NUNCA en el PDF: esta misma plantilla es la que imprime puppeteer. */
    @media print { .itin-fab { display: none !important; } }

    @media print { body { font-size: 12px; } }
    .itin-notes-list { margin: 6px 0 0; padding-left: 1.2em; }
    .itin-notes-list li { list-style: disc; margin: 2px 0; }
    .itin-specialist .itin-contact { margin-top: 12px; font-weight: 600; font-size: 0.95rem; }
    .itin-closing { text-align: center; padding: 26px 28px 30px; color: #8a8c6e; margin: 28px 28px 0; border-top: 1px solid #e2e2d8; }
    .itin-thanks { letter-spacing: 4px; font-size: 0.95rem; }
    .itin-closing a { color: #8a8c6e; text-decoration: none; font-size: 0.85rem; }
  </style>
</head>
<body>
  <div class="itin" id="summaryContent">

    <header class="itin-header">
      <div class="itin-topbar">
        <img class="itin-logo-img" src="<%= LOGO_URL %>" alt="<%= COMPANY.name %>" onerror="this.style.display='none'">
        <% if (specialist) { %>
        <div class="itin-specialist">
          <div class="name">I'm <strong><%= specialist.firstName || specialist.fullName || '' %></strong> <%= specialist.lastName || '' %></div>
          <div>Travel Specialist</div>
          <% if (specialist.email) { %><div><%= specialist.email %></div><% } %>
          <div class="itin-contact"><%= specialist.phone ? specialist.phone + ' | ' : '' %>amexingexperience.com</div>
        </div>
        <% } %>
      </div>

      <div class="itin-hero">
        <div class="itin-guest"><%= guestName %></div>

        <% if (headerMonth) { %>
        <div class="itin-dates">
          <div class="month"><%= headerMonth %></div>
          <div class="range"><%= headerRange %></div>
          <div class="year">- <%= headerYear %> -</div>
        </div>
        <% } %>

        <div class="itin-resnum">N° de reservación: <strong><%= q.folio || '' %></strong></div>
      </div>
    </header>

    <div class="itin-timeline">
    <% days.forEach((day) => { %>
      <div class="itin-day-bar"><%= dayLabel(day) %></div>

      <% (day.subconcepts || []).forEach((sc) => { %>
        <div class="itin-entry">
          <div class="itin-rail">
            <div class="itin-icon"><img src="<%= ICON_BASE %>/<%= iconKey(sc) %>.png" alt="" onerror="this.style.display='none'"></div>
          </div>
          <div class="itin-body">

            <% const _dur = durationLabel(sc); const _start = serviceStartTime(sc); %>
            <% if (_start || _dur) { %>
              <div class="itin-time">
                <% if (_start) { %><%= _start %><% } %><% if (_start && _dur) { %> - <% } %><%= _dur %>
              </div>
            <% } %>

            <div class="itin-svc-title"><%= titleFor(sc) %></div>

            <%# En los TRASLADOS el "Desde/Hacia" por nombre se quitó: el título ya trae la ruta —sea el
                concepto ("Aeropuerto: (BJX) … - …") o el propio "origen → destino" de titleFor—, así que
                lo decía dos veces. En su lugar van las DIRECCIONES de pick-up/drop-off (locationLines),
                que no aparecían en ningún lado y son las que el pasajero necesita. %>
            <% const locLines = locationLines(sc); %>
            <% if (locLines.length) { %>
              <div class="itin-sub">
                <%- locLines.map((l) => `${l.label}: <strong>${escapeHtml(l.value)}</strong>`).join('<br>') %>
              </div>
            <% } %>

            <% if (sc.airline || sc.flightNumber) { %>
              <%# La HORA del vuelo faltaba. Es un dato distinto al de la línea de arriba: ahí va la
                  hora del SERVICIO —que en una salida a aeropuerto es la del pick-up—, y aquí la del
                  avión. Se extrae con la misma regla que el detalle. %>
              <% const _fh = String(sc.time || sc.selectedSchedule || '').match(/^(\d{1,2}:\d{2})/); %>
              <div class="itin-flight">
                <div class="h">Airline</div><div class="h">Flight Number</div><div class="h">Hora</div><div class="h">Terminal</div><div class="h">Gate</div>
                <div class="v"><%= sc.airline || '—' %></div>
                <div class="v"><%= sc.flightNumber || '—' %></div>
                <div class="v"><%= _fh ? _fh[1] : '—' %></div>
                <div class="v">—</div>
                <div class="v">—</div>
              </div>
            <% } %>

            <% if (peopleLabel(sc)) { %><div class="itin-sub" style="margin-top:6px;"><strong><%= peopleLabel(sc) %></strong></div><% } %>
            <%# Quiénes son, no solo cuántos. %>
            <% const attLine = attendeesLine(sc); %>
            <% if (attLine) { %><div class="itin-sub"><%- attLine %></div><% } %>

            <%# La descripción del CATÁLOGO va primero: describe qué es el tour o la experiencia, y las
                notas de abajo son lo particular de esta reservación. Se verificó que no se duplican:
                de 76 servicios con descripción, ninguna coincide con la nota que ya se mostraba. %>
            <% if (sc.catalogDescription) { %>
              <div class="itin-desc"><%- renderNotes(sc.catalogDescription) %></div>
            <% } %>
            <% const desc = sc.clientNotes || sc.notes || ''; if (desc) { %>
              <div class="itin-desc"><%- renderNotes(desc) %></div>
            <% } %>
            <% const agencyD = (sc.agencyNotes || '').trim(); if (agencyD) { %>
              <div class="itin-desc"><%- renderNotes(agencyD) %></div>
            <% } %>

            <%# Incluye / no incluye, en dos columnas: al pasajero le sirve leerlas una al lado de la
                otra —qué sí y qué no por su cuenta—, y apiladas duplicarían el alto en un PDF donde
                cada entrada lleva break-inside: avoid. %>
            <% const _inc = includeLists(sc); %>
            <% if (_inc.includes.length || _inc.notIncludes.length) { %>
              <div class="itin-inc">
                <% if (_inc.includes.length) { %>
                  <div class="itin-inc-col">
                    <div class="itin-inc-lbl">Incluye</div>
                    <ul class="itin-inc-list is-yes">
                      <% _inc.includes.forEach((item) => { %><li><%= item %></li><% }) %>
                    </ul>
                  </div>
                <% } %>
                <% if (_inc.notIncludes.length) { %>
                  <div class="itin-inc-col">
                    <div class="itin-inc-lbl">No incluye</div>
                    <ul class="itin-inc-list is-no">
                      <% _inc.notIncludes.forEach((item) => { %><li><%= item %></li><% }) %>
                    </ul>
                  </div>
                <% } %>
              </div>
            <% } %>

            <%# Quién opera el servicio. Sustituye al bloque con la dirección de Amexing, que se
                repetía idéntico en cada servicio y ya está en la portada junto al especialista.
                Si el servicio no tiene a nadie asignado el bloque no se dibuja. %>
            <% const asgPairs = assignmentPairs(sc); const asgRoles = assignmentRoles(sc); %>
            <% if (asgPairs.length || asgRoles.length) { %>
              <div class="itin-assign">
                <% asgPairs.forEach((p) => { %>
                  <div class="itin-assign-row">
                    <div class="itin-duo">
                      <% if (p.driver) { %><%- personAvatar(p.driver) %>
                      <% } else if ((p.pending || p.needsDriver) && p.offersDriver !== false) { %><%- pendingAvatar('steering-wheel') %><% } %>
                      <% if (p.vehicle) { %><%- vehicleAvatar(p.vehicle) %>
                      <% } else if (p.pending || p.needsVehicle) { %><%- pendingAvatar('car') %><% } %>
                    </div>
                    <div class="itin-assign-meta">
                      <% if (p.pending) { %>
                        <div class="n itin-pend-name"><%= p.label %></div>
                        <div>
                          <% const _seg = segmentBit(p); if (_seg) { %><%- _seg %> · <% } %>
                          <span class="itin-pend-txt">Por confirmar</span>
                        </div>
                      <% } else { %>
                        <%- pairLines(p) %>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
                <% asgRoles.forEach((r) => { %>
                  <div class="itin-assign-row">
                    <%- r.person ? personAvatar(r.person) : pendingAvatar('user') %>
                    <div class="itin-assign-meta">
                      <div class="itin-assign-role"><%= r.role %></div>
                      <% if (r.person) { %>
                        <div class="n"><%= r.person.fullName %><% if (r.person.phone) { %> · <%= r.person.phone %><% } %></div>
                      <% } else { %>
                        <div class="n itin-pend-txt">Por confirmar</div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

          </div>
        </div>
      <% }) %>
    <% }) %>
    </div>

    <div class="itin-closing">
      <div class="itin-thanks">THANK YOU FOR YOUR PREFERENCE!</div>
      <a href="<%= COMPANY.url %>">amexingexperience.com</a>
    </div>

  </div>
  <script>
    // Explicitly load the Arpona weights used on the cover so the (embedded base64) font is
    // rasterized before the PDF snapshot. font-display:block + fonts.ready alone can resolve
    // before the face is actually applied; PdfRenderService waits for window.__fontsReady.
    (function () {
      var faces = ["300 1em ArponaPDF", "400 1em ArponaPDF", "500 1em ArponaPDF", "700 1em ArponaPDF",
        "300 1em MyriadPDF", "400 1em MyriadPDF", "600 1em MyriadPDF", "700 1em MyriadPDF"];
      var done = function () { window.__fontsReady = true; };
      if (document.fonts && document.fonts.load) {
        Promise.all(faces.map(function (f) { return document.fonts.load(f).catch(function () {}); }))
          .then(function () { return document.fonts.ready; })
          .then(done, done);
      } else {
        done();
      }
    })();
  </script>

  <% if (q.folio) { %>
  <a class="itin-fab" id="itinPdfFab" href="/reservations/<%= encodeURIComponent(q.folio) %>/pdf"
     aria-label="Descargar el itinerario en PDF">
    <span id="itinPdfFabIco" aria-hidden="true"><i class="ti ti-download"></i></span>
    <span class="itin-fab-txt" id="itinPdfFabTxt">Descargar PDF</span>
  </a>
  <script>
    // La descarga se hace por fetch y no dejando navegar el <a>: armar el PDF toma ~10 segundos y una
    // descarga por navegación no avisa cuándo empieza ni cuándo termina, así que el botón parecería
    // muerto todo ese rato. El href se conserva para que "abrir en pestaña nueva" siga funcionando.
    (function () {
      var fab = document.getElementById('itinPdfFab');
      if (!fab) return;
      var ico = document.getElementById('itinPdfFabIco');
      var txt = document.getElementById('itinPdfFabTxt');
      var folio = <%- JSON.stringify(String(q.folio)) %>;
      fab.addEventListener('click', function (ev) {
        if (fab.classList.contains('is-busy')) return;
        ev.preventDefault();
        var icoHtml = ico.innerHTML;
        var txtHtml = txt.innerHTML;
        fab.classList.add('is-busy');
        ico.innerHTML = '<span class="itin-fab-spin"></span>';
        txt.textContent = 'Generando…';
        var blobUrl = '';
        var restore = function () {
          fab.classList.remove('is-busy');
          ico.innerHTML = icoHtml;
          txt.innerHTML = txtHtml;
          // Revocar de inmediato cancela la descarga en navegadores que leen el blob tras el click.
          if (blobUrl) setTimeout(function () { URL.revokeObjectURL(blobUrl); }, 60000);
        };
        fetch(fab.href)
          .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.blob(); })
          .then(function (blob) {
            blobUrl = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = blobUrl;
            a.download = folio + '.pdf';
            document.body.appendChild(a);
            a.click();
            a.remove();
          })
          .catch(function (err) {
            console.error('PDF download failed:', err);
            alert('No se pudo generar el PDF. Intenta de nuevo.');
          })
          .then(restore, restore);
      });
    })();
  </script>
  <% } %>
</body>
</html>
