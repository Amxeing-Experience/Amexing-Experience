<%
/**
 * Mobile Admin Experiences Management Page
 * Mobile-optimized version of the experiences dashboard
 * Simplified navigation and mobile-first design
 *
 * Layout Structure:
 * - Mobile tab navigation (horizontal scrollable)
 * - Simplified content sections
 * - Touch-optimized interactions
 * 
 * Created by Denisse Maldonado
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const activeSection = typeof section !== 'undefined' ? section : 'experiences';

// Mobile menu items configuration
const menuItems = [
    { 
        label: 'Experiencias', 
        icon: 'star', 
        section: 'experiences', 
        href: '/dashboard/admin/experiences',
        description: 'Gestionar experiencias'
    },
    { 
        label: 'Proveedores', 
        icon: 'building-store', 
        section: 'providers', 
        href: '/dashboard/admin/experiences?section=providers',
        description: 'Gestionar proveedores'
    },
    { 
        label: 'Establecimientos', 
        icon: 'building', 
        section: 'establishments', 
        href: '/dashboard/admin/experiences?section=establishments',
        description: 'Gestionar ubicaciones'
    }
];
%>

<!-- Mobile Header -->
<div class="mobile-header">
    <div class="mobile-header-content">
        <div class="mobile-header-main">
            <button class="mobile-back-btn" onclick="history.back()">
                <i class="ti ti-arrow-left"></i>
            </button>
            <div class="mobile-header-title">
                <h1>Experiencias</h1>
                <span class="mobile-header-subtitle">Gestión de experiencias</span>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Tab Navigation -->
<div class="mobile-tab-navigation">
    <div class="mobile-tab-container">
        <% menuItems.forEach(function(item, index) { %>
            <a href="<%= item.href %>" class="mobile-tab <%= item.section === activeSection ? 'active' : '' %>">
                <div class="mobile-tab-icon">
                    <i class="ti ti-<%= item.icon %>"></i>
                </div>
                <div class="mobile-tab-content">
                    <span class="mobile-tab-label"><%= item.label %></span>
                    <span class="mobile-tab-desc"><%= item.description %></span>
                </div>
            </a>
        <% }); %>
    </div>
</div>

<!-- Mobile Content -->
<div class="mobile-content">
    <% if (activeSection === 'experiences') { %>
        <!-- Mobile Experiences Section -->
        <div class="mobile-section" id="experiences-section">
            <div class="mobile-section-header">
                <h2><i class="ti ti-star me-2"></i>Experiencias</h2>
                <p>Gestiona el catálogo de experiencias disponibles</p>
            </div>
            
            <%- include('../../organisms/datatable/experiences-table-mobile', {
                tableId: 'experiences-table-mobile',
                apiEndpoint: '/api/experiences',
                userRole: currentUserRole,
                showActions: true
            }) %>
        </div>

    <% } else if (activeSection === 'providers') { %>
        <!-- Mobile Providers Section -->
        <div class="mobile-section" id="providers-section">
            <div class="mobile-section-header">
                <h2><i class="ti ti-building-store me-2"></i>Proveedores</h2>
                <p>Administra los proveedores de experiencias</p>
            </div>
            
            <%- include('../../organisms/datatable/experience-providers-table-mobile', {
                tableId: 'experience-providers-table-mobile',
                apiEndpoint: '/api/experiences',
                userRole: currentUserRole,
                showActions: true
            }) %>
        </div>

    <% } else if (activeSection === 'establishments') { %>
        <!-- Mobile Establishments Section -->
        <div class="mobile-section" id="establishments-section">
            <div class="mobile-section-header">
                <h2><i class="ti ti-building me-2"></i>Establecimientos</h2>
                <p>Gestiona ubicaciones y establecimientos</p>
            </div>
            
            <%- include('../../organisms/datatable/experience-establishments-table-mobile', {
                tableId: 'experience-establishments-table-mobile',
                apiEndpoint: '/api/experiences',
                userRole: currentUserRole,
                showActions: true
            }) %>
        </div>

    <% } %>
</div>

<!-- Mobile Floating Action Button -->
<% if (['superadmin', 'admin'].includes(currentUserRole)) { %>
<div class="mobile-fab">
    <button class="fab-button" id="mobile-add-btn">
        <i class="ti ti-plus"></i>
    </button>
</div>
<% } %>

<!-- Mobile Experiences Styles -->
<link rel="stylesheet" href="/dashboard/css/experiences-mobile.css" />

<!-- Mobile Experiences JavaScript -->
<script src="/dashboard/js/experiences-mobile.js" defer></script>

<!-- Basic Mobile Styles (inline for immediate loading) -->
<style>
/* Critical mobile styles for immediate rendering */
.mobile-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    color: white;
    padding: 1rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.mobile-header-content {
    max-width: 100%;
}

.mobile-header-main {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.mobile-back-btn {
    background: rgba(255,255,255,0.2);
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.25rem;
}

.mobile-header-title h1 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
}

.mobile-header-subtitle {
    font-size: 0.875rem;
    opacity: 0.9;
}

.mobile-tab-navigation {
    background: white;
    border-bottom: 1px solid #e5e7eb;
    padding: 1rem 0 0;
    position: sticky;
    top: 76px;
    z-index: 99;
}

.mobile-tab-container {
    display: flex;
    overflow-x: auto;
    padding: 0 1rem;
    gap: 0.5rem;
    -webkit-overflow-scrolling: touch;
}

.mobile-tab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 12px 12px 0 0;
    text-decoration: none;
    color: #6b7280;
    background: #f9fafb;
    transition: all 0.2s;
    min-width: max-content;
    border-bottom: 3px solid transparent;
}

.mobile-tab.active {
    background: white;
    color: #f59e0b;
    border-bottom-color: #f59e0b;
    font-weight: 600;
}

.mobile-tab-icon i {
    font-size: 1.25rem;
}

.mobile-tab-label {
    font-size: 0.875rem;
    font-weight: 600;
}

.mobile-tab-desc {
    font-size: 0.75rem;
    opacity: 0.7;
    display: block;
}

.mobile-content {
    padding: 1.5rem 1rem;
    min-height: calc(100vh - 200px);
}

.mobile-section-header h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: #374151;
}

.mobile-section-header p {
    color: #6b7280;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
}

.mobile-fab {
    position: fixed;
    bottom: 2rem;
    right: 1rem;
    z-index: 1000;
}

.fab-button {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    color: white;
    border: none;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    transition: all 0.3s ease;
}

.fab-button:active {
    transform: scale(0.95);
}

/* Hide on desktop */
@media (min-width: 992px) {
    .mobile-header,
    .mobile-tab-navigation,
    .mobile-content,
    .mobile-fab {
        display: none;
    }
}
</style>