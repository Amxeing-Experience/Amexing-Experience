    // Calculate discount percentage based on hours
    function calculateDiscount(hours) {
        if (hours >= 16) return 10;
        if (hours >= 12) return 7.5;
        if (hours >= 10) return 5;
        if (hours >= 8) return 2.5;
        return 0;
    }

    // Highlight the active volume-discount chip
    function updateDiscountChips(hours) {
        const active = calculateDiscount(hours);
        document.querySelectorAll('#disposicion-discount-chips span').forEach(chip => {
            const min = parseFloat(chip.dataset.min);
            chip.classList.toggle('on', active > 0 && hours >= min && calculateDiscount(min) === active);
        });
    }

    // Update price calculation
    async function updateDisposicionPrice() {
        const vehicleCount = parseInt($('#disposicion-vehicle-count').val()) || 0;
        const hours = parseFloat($('#disposicion-hours').val()) || 0;
        const selectedVehicle = $('#disposicion-vehicle-type').val();
        const selectedRate = $('#disposicion-rate').val();
        const selectedCurrency = $('#disposicion-currency').val() || 'MXN';
        const selectedPayment = $('#disposicion-payment').val() || 'tarjeta';

        let currentHourlyRate = defaultHourlyRate;

        updateDiscountChips(hours);

        // Check if we have valid inputs
        if (vehicleCount === 0 || hours === 0 || !selectedVehicle || !selectedRate) {
            // Reset display when inputs are invalid
            $('#disposicion-base-cost').text(`$0 ${selectedCurrency}`);
            $('#disposicion-discount-row').hide();
            $('#disposicion-total-cost').text(`$0 ${selectedCurrency}`);
            const wrapper = document.getElementById('disposicion-add-to-quote-wrapper');
            if (wrapper) wrapper.style.display = 'none';
            showSummaryLoader(false);
            return;
        }

        // Resolve the hourly price for this vehicle+rate combination.
        // The price only depends on vehicleType+rate, so we fetch it ONCE per combo and
        // cache it — changing hours/vehicles/currency/payment reuses the cached value
        // instead of hitting the API on every keystroke (prevents 429 rate limiting).
        const comboKey = `${selectedVehicle}_${selectedRate}`;
        if (Object.prototype.hasOwnProperty.call(priceCache, comboKey)) {
            currentHourlyRate = priceCache[comboKey];
        } else {
            showSummaryLoader(true);
            try {
                const apiUrl = `/api/disposable-prices/price?vehicleTypeId=${selectedVehicle}&rateId=${selectedRate}`;
                const priceResponse = await fetch(apiUrl, {
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('authToken')}`,
                        'Content-Type': 'application/json'
                    }
                });

                if (priceResponse.ok) {
                    const priceData = await priceResponse.json();
                    currentHourlyRate = (priceData.success && priceData.data && !priceData.data.isDefault)
                        ? priceData.data.hourlyPrice
                        : defaultHourlyRate;
                    // Cache the definitive answer (real or default) so we don't refetch this combo
                    priceCache[comboKey] = currentHourlyRate;
                } else {
                    // Transient error (e.g. 429): use default but do NOT cache, so it can retry later
                    console.error('❌ Failed to fetch price:', priceResponse.status);
                    currentHourlyRate = defaultHourlyRate;
                }
            } catch (error) {
                console.error('❌ Error fetching specific price:', error);
                currentHourlyRate = defaultHourlyRate;
            }
        }

        // Load exchange rate if USD is selected and not already loaded
        if (selectedCurrency === 'USD' && currentExchangeRate <= 0) {
            await loadCurrentExchangeRate();
        }

        // Load transfer rate if transferencia payment is selected and not already loaded
        if (selectedPayment === 'transferencia' && currentTransferRate <= 0) {
            await loadCurrentTransferRate();
        }

        // Load agency rate if tarjeta payment is selected and not already loaded
        if (selectedPayment === 'tarjeta' && currentAgencyRate <= 0) {
            await loadCurrentAgencyRate();
        }

        // Calculate base price in MXN first
        let adjustedHourlyRate = currentHourlyRate;

        // Apply payment method modifier
        if (selectedPayment === 'transferencia') {
            // Use transfer rate as percentage (e.g., 3.0 = +3%)
            adjustedHourlyRate = adjustedHourlyRate * (1 + currentTransferRate / 100);
        } else if (selectedPayment === 'tarjeta') {
            // Use agency rate as percentage (typically higher than transfer rate)
            adjustedHourlyRate = adjustedHourlyRate * (1 + currentAgencyRate / 100);
        }

        // Convert to USD if needed
        if (selectedCurrency === 'USD') {
            adjustedHourlyRate = adjustedHourlyRate / currentExchangeRate;
        }

        // Calculate base cost: hourly rate × hours × number of vehicles
        let originalBaseCost = adjustedHourlyRate * hours * vehicleCount;
        let baseCost = originalBaseCost;
        let cashRoundingAppliedToBase = false;

        // Apply cash rounding to base cost for efectivo payments (MXN only) - customer sees rounded price from start
        if (selectedPayment === 'efectivo' && selectedCurrency === 'MXN' && typeof PricingUtils !== 'undefined' &&
            PricingUtils.applyCashRounding && PricingUtils.isCashRoundingEnabledSync()) {
            const roundedBaseCost = PricingUtils.applyCashRounding(originalBaseCost);
            if (roundedBaseCost !== originalBaseCost) {
                cashRoundingAppliedToBase = true;
                baseCost = roundedBaseCost;
            }
        }

        // Apply USD rounding rules to base cost for consistency
        if (selectedCurrency === 'USD') {
            baseCost = PricingUtils.applyUSDRoundingRules(baseCost);
        }

        // Calculate discount based on hours (volume discount)
        const discountPercent = calculateDiscount(hours);
        const discountAmount = baseCost * (discountPercent / 100);
        let totalCost = baseCost - discountAmount;

        // Apply USD rounding rules to final total if discount was applied
        if (selectedCurrency === 'USD' && discountPercent > 0) {
            totalCost = PricingUtils.applyUSDRoundingRules(totalCost);
        }

        // Cash rounding is now applied to base cost, so total cost doesn't need additional rounding

        // Format currency based on selection
        function formatPrice(amount, currency) {
            if (currency === 'USD') {
                return `$${amount.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0})} USD`;
            } else {
                return `$${amount.toLocaleString('es-MX', {minimumFractionDigits: 2, maximumFractionDigits: 2})} MXN`;
            }
        }

        // Update UI with formatted numbers
        $('#disposicion-base-cost').text(formatPrice(baseCost, selectedCurrency));

        if (discountPercent > 0) {
            $('#disposicion-discount-row').show();
            $('#disposicion-discount').text(`-${discountPercent}% (${formatPrice(discountAmount, selectedCurrency)})`);
        } else {
            $('#disposicion-discount-row').hide();
        }

        $('#disposicion-total-cost').text(formatPrice(totalCost, selectedCurrency));

        // Show/hide admin breakdown for cash rounding
        <% if (isAdminRole) { %>
        if (cashRoundingAppliedToBase) {
            const difference = baseCost - originalBaseCost;
            const roundingInfo = `${formatPrice(originalBaseCost, selectedCurrency)} → ${formatPrice(baseCost, selectedCurrency)}`;
            $('#disposicion-cash-rounding-info').text(roundingInfo);
            $('#disposicion-cash-rounding-row').show();
        } else {
            $('#disposicion-cash-rounding-row').hide();
        }
        <% } else { %>
        // Hide admin breakdown for non-admin users
        $('#disposicion-cash-rounding-row').hide();
        <% } %>

        // Log calculation for debugging
        console.log('🧮 Price calculation details:', {
            selectedVehicle: selectedVehicle,
            selectedRate: selectedRate,
            selectedPayment: selectedPayment,
            selectedCurrency: selectedCurrency,
            hourlyRate: currentHourlyRate,
            hours: hours,
            vehicleCount: vehicleCount,
            originalBaseCost: originalBaseCost,
            baseCost: baseCost,
            cashRoundingAppliedToBase: cashRoundingAppliedToBase,
            discountPercent: discountPercent,
            discountAmount: discountAmount,
            totalCost: totalCost,
            apiCallMade: selectedVehicle && selectedRate ? 'Yes' : 'No'
        });

        // Show/hide add-to-quote button and store calculation data
        const addToQuoteWrapper = document.getElementById('disposicion-add-to-quote-wrapper');
        if (addToQuoteWrapper) {
            if (vehicleCount > 0 && hours > 0 && selectedVehicle && selectedRate && totalCost > 0) {
                addToQuoteWrapper.style.display = 'block';
                const selectedVehicleName = $('.vehicle-button.btn-success .fw-bold').text().trim() || '';
                const selectedRateName = $('.rate-button.btn-primary .fw-bold').text().trim() || '';
                const selectedVehicleCapacity = parseInt($('.vehicle-button.btn-success').data('capacity')) || 4;
                const selectedTrunkCapacity = parseInt($('.vehicle-button.btn-success').data('trunk-capacity')) || 2;
                window._currentDisposicionCalc = {
                    vehicleName: selectedVehicleName,
                    vehicleTypeId: selectedVehicle,
                    vehicleCapacity: selectedVehicleCapacity,
                    trunkCapacity: selectedTrunkCapacity,
                    rateName: selectedRateName,
                    rateId: selectedRate,
                    hours: hours,
                    vehicleCount: vehicleCount,
                    hourlyRate: currentHourlyRate,
                    totalCost: totalCost,
                    currency: selectedCurrency,
                    paymentMethod: selectedPayment,
                    discountPercent: discountPercent
                };
            } else {
                addToQuoteWrapper.style.display = 'none';
            }
        }

        showSummaryLoader(false);
    }

    // Event handlers
    function initializeEventHandlers() {
        // Handle input changes
        $('#disposicion-vehicle-count, #disposicion-hours').on('input change', function() {
            updateDisposicionPrice();
        });

        // Cart steppers (+/- buttons) adjust their target input respecting min/max
        $('.cart-step-btn').on('click', function() {
            const $input = $('#' + $(this).data('target'));
            if (!$input.length) return;
            const step = parseFloat($(this).data('step')) || 1;
            const dir = parseInt($(this).data('dir'), 10);
            const minAttr = $input.attr('min');
            const maxAttr = $input.attr('max');
            const min = minAttr !== undefined ? parseFloat(minAttr) : -Infinity;
            const max = maxAttr !== undefined ? parseFloat(maxAttr) : Infinity;
            let val = (parseFloat($input.val()) || 0) + dir * step;
            val = Math.min(max, Math.max(min, val));
            $input.val(val).trigger('change');
        });

        // Add currency and payment method change listeners
        $('#disposicion-currency').on('change', function() {
            updateDisposicionPrice();
        });

        $('#disposicion-payment').on('change', function() {
            updateDisposicionPrice();
        });

        // Hero zoom / hero click → open fullscreen gallery
        $('#adispo-hero-zoom').on('click', function() {
            openDispGallery(document.getElementById('adispo-hero-img').dataset.currentIndex);
        });
        $('#adispo-hero-img').on('click', function() {
            if (currentVehicleImages.length) openDispGallery(this.dataset.currentIndex);
        });

        // Horizontal slider arrows (mirror the experiences-detail behavior)
        const galStrip = document.getElementById('adispo-thumbs');
        const galPrev = document.getElementById('adispo-gprev');
        const galNext = document.getElementById('adispo-gnext');
        if (galStrip && galPrev && galNext) {
            const galStep = () => Math.max(galStrip.clientWidth * 0.75, 160);
            window._adispoUpdateNav = () => {
                const maxScroll = galStrip.scrollWidth - galStrip.clientWidth - 2;
                galPrev.classList.toggle('is-hidden', galStrip.scrollLeft <= 0);
                galNext.classList.toggle('is-hidden', maxScroll <= 0 || galStrip.scrollLeft >= maxScroll);
            };
            galPrev.addEventListener('click', () => galStrip.scrollBy({ left: -galStep(), behavior: 'smooth' }));
            galNext.addEventListener('click', () => galStrip.scrollBy({ left: galStep(), behavior: 'smooth' }));
            galStrip.addEventListener('scroll', window._adispoUpdateNav);
            galStrip.addEventListener('wheel', (e) => {
                if (galStrip.scrollWidth <= galStrip.clientWidth) return;
                if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) { galStrip.scrollLeft += e.deltaY; e.preventDefault(); }
            }, { passive: false });
            window._adispoUpdateNav();
        }

        // Fullscreen gallery navigation
        $('#dispGalleryPrev').on('click', function() {
            if (dispGalleryIndex > 0) { dispGalleryIndex--; updateDispGallery(); }
        });
        $('#dispGalleryNext').on('click', function() {
            if (dispGalleryIndex < currentVehicleImages.length - 1) { dispGalleryIndex++; updateDispGallery(); }
        });
        document.addEventListener('keydown', function(e) {
            const modalEl = document.getElementById('dispGalleryModal');
            if (!modalEl || !modalEl.classList.contains('show')) return;
            if (e.key === 'ArrowLeft' && dispGalleryIndex > 0) { dispGalleryIndex--; updateDispGallery(); }
            else if (e.key === 'ArrowRight' && dispGalleryIndex < currentVehicleImages.length - 1) { dispGalleryIndex++; updateDispGallery(); }
        });
    }

    // Initialize calculator
    function initializeCalculator() {
        if (typeof jQuery === 'undefined') {
            setTimeout(initializeCalculator, 100);
            return;
        }

        showHeroLoader(true);
        loadRatesAndInitialize();
        initializeEventHandlers();
        updateDisposicionPrice();
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeCalculator);
    } else {
        initializeCalculator();
    }
})();

// Price Management Functions (Admin Only)
<% if (isAdminRole) { %>
(function() {
    'use strict';

    let originalPrices = {};
    let modifiedPrices = {};

    // Get access token from cookies or localStorage
    function getAccessToken() {
        // First try localStorage (used by other parts of the app)
        const tokenFromStorage = localStorage.getItem('accessToken');
        if (tokenFromStorage) {
            return tokenFromStorage;
        }

        // Fallback to cookies
        const cookies = document.cookie.split(';');
        for (let cookie of cookies) {
            const [name, value] = cookie.trim().split('=');
            if (name === 'accessToken') {
                return value;
            }
        }

        // Also try authToken in localStorage as backup
        return localStorage.getItem('authToken');
    }

    // Load disposable prices for management
    async function loadPricesForManagement() {
        try {
            console.log('🔄 Loading prices for management...');

            const response = await fetch('/dashboard/data/disposable-prices', {
                method: 'GET',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            console.log('📡 API response status:', response.status);

            if (!response.ok) {
                const errorText = await response.text();
                console.error('❌ API Error:', errorText);
                throw new Error(`Failed to load prices: ${response.status}`);
            }

            const result = await response.json();
            console.log('✅ API result:', result);

            if (result.success && result.data) {
                displayPricesTable(result.data);
            } else {
                showAlert('warning', 'No se encontraron precios para mostrar.');
            }
        } catch (error) {
            console.error('Error loading prices for management:', error);
            showAlert('danger', 'Error al cargar los precios. Por favor, intente nuevamente. ' + error.message);

            // Show a message in the table for debugging
            const tbody = document.getElementById('disposable-prices-tbody');
            if (tbody) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            <i class="ti ti-alert-circle me-2"></i>
                            Error al cargar los precios: ${error.message}<br>
                            <small>Por favor, asegúrese de estar autenticado correctamente.</small>
                        </td>
                    </tr>
                `;
            }
        }
    }

    // Display prices in the management table
    function displayPricesTable(pricesArray) {
        console.log('🏗️ Displaying prices table, data:', pricesArray);
        const tbody = document.getElementById('disposable-prices-tbody');
        if (!tbody) {
            console.error('❌ Table body not found');
