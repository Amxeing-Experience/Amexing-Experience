.adispo-cta { margin-top: 16px; width: 100%; border: none; background: var(--olive); color: #fff; font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; padding: 16px; border-radius: 3px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; transition: .15s; }
.adispo-cta:hover { background: var(--olive-d); }

/* Admin: administrar precios por hora */
.adispo-admin-sec { margin-top: 34px; border: 1px solid var(--border); background: rgba(255,255,255,.25); border-radius: 6px; overflow: hidden; }
.adispo-admin-sec__head { padding: 18px 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
