                row.innerHTML = `
                    <td>
                        <strong>${priceData.vehicleType.name}</strong>
                        <small class="text-muted d-block">${priceData.vehicleType.capacity || 4} pasajeros</small>
                    </td>
                    <td>
                        <span class="badge" style="background-color: ${priceData.rate.color || '#6c757d'};">
                            ${priceData.rate.name}
                        </span>
                    </td>
                    <td>
                        <div class="input-group" style="max-width: 350px;">
                            <span class="input-group-text">$</span>
                            <input type="number"
                                   class="form-control price-input"
                                   id="price-${priceId}"
                                   data-price-id="${priceId}"
                                   value="${priceData.hourlyPrice}"
                                   min="0"
                                   step="50"
                                   style="min-width: 120px;">
                            <span class="input-group-text">MXN</span>
                        </div>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary edit-price-btn"
                                data-price-id="${priceId}"
                                style="display: none;">
                            <i class="ti ti-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger reset-price-btn"
                                data-price-id="${priceId}"
                                style="display: none;">
                            <i class="ti ti-rotate-clockwise"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(row);
            }
        });

        // Add event listeners
        attachPriceEventListeners();
    }

    // Attach event listeners to price inputs
    function attachPriceEventListeners() {
        // Price input change handlers
        document.querySelectorAll('.price-input').forEach(input => {
            input.addEventListener('input', function() {
                const priceId = this.dataset.priceId;
                const newValue = parseFloat(this.value) || 0;
                const originalValue = originalPrices[priceId];

                if (newValue !== originalValue) {
                    modifiedPrices[priceId] = newValue;
                    this.closest('tr').classList.add('table-warning');
                    document.querySelector(`.reset-price-btn[data-price-id="${priceId}"]`).style.display = 'inline-block';
                } else {
                    delete modifiedPrices[priceId];
                    this.closest('tr').classList.remove('table-warning');
                    document.querySelector(`.reset-price-btn[data-price-id="${priceId}"]`).style.display = 'none';
                }

                // Enable/disable save button
                const saveBtn = document.getElementById('save-all-prices');
                if (saveBtn) {
                    saveBtn.disabled = Object.keys(modifiedPrices).length === 0;
                }
            });
        });

        // Reset button handlers
        document.querySelectorAll('.reset-price-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const priceId = this.dataset.priceId;
                const input = document.getElementById(`price-${priceId}`);
                if (input) {
                    input.value = originalPrices[priceId];
                    input.dispatchEvent(new Event('input'));
                }
            });
        });
    }

    // Save all modified prices
    async function saveAllPrices() {
        const saveBtn = document.getElementById('save-all-prices');
        if (!saveBtn || Object.keys(modifiedPrices).length === 0) return;

        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="ti ti-loader me-2"></i>Guardando...';

        try {
            const updates = Object.entries(modifiedPrices).map(([priceId, hourlyPrice]) => ({
                id: priceId,
                hourlyPrice: hourlyPrice
            }));

            // Get CSRF token from meta tag or page
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content ||
                             document.querySelector('input[name="_csrf"]')?.value ||
                             '';

            console.log('CSRF Token:', csrfToken ? 'Found: ' + csrfToken.substring(0,10) + '...' : 'Not found'); // Debug log

            const response = await fetch('/dashboard/data/disposable-prices/batch-update', {
                method: 'PUT',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'x-csrf-token': csrfToken
                },
                body: JSON.stringify({ updates })
            });

            if (!response.ok) {
                throw new Error('Failed to update prices');
            }

            const result = await response.json();

            // Update original prices
            Object.entries(modifiedPrices).forEach(([priceId, hourlyPrice]) => {
                originalPrices[priceId] = hourlyPrice;
            });

            // Clear modified prices
            modifiedPrices = {};

            // Reset UI
            document.querySelectorAll('tr.table-warning').forEach(row => {
                row.classList.remove('table-warning');
            });
            document.querySelectorAll('.reset-price-btn').forEach(btn => {
                btn.style.display = 'none';
            });

            showAlert('success', `✅ ${updates.length} precios actualizados correctamente.`);

            // Reload the rates for the calculator
            if (typeof loadRatesAndInitialize === 'function') {
                loadRatesAndInitialize();
            }
        } catch (error) {
            console.error('Error saving prices:', error);
            showAlert('danger', 'Error al guardar los precios. Por favor, intente nuevamente.');
        } finally {
            saveBtn.disabled = Object.keys(modifiedPrices).length === 0;
            saveBtn.innerHTML = '<i class="ti ti-device-floppy me-2"></i>Guardar todos los cambios';
        }
    }

    // Show alert message
    function showAlert(type, message) {
        const alertDiv = document.getElementById('price-management-alert');
        if (!alertDiv) return;

        alertDiv.className = `alert alert-${type}`;
        alertDiv.innerHTML = message;
        alertDiv.classList.remove('d-none');

        // Auto-hide after 5 seconds
        setTimeout(() => {
            alertDiv.classList.add('d-none');
        }, 5000);
    }

    // Initialize price management
    function initializePriceManagement() {
        loadPricesForManagement();

        // Add save button handler
        const saveBtn = document.getElementById('save-all-prices');
        if (saveBtn) {
            saveBtn.addEventListener('click', saveAllPrices);
        }
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializePriceManagement);
    } else {
        initializePriceManagement();
    }
})();
<% } %>
</script>

<!-- Add to Quote — módulo genérico compartido + payload de A Disposición (oculto para admin) -->
<% if (!isAdminRole) { %>
<script src="/dashboard/js/utils/add-to-quote.js"></script>
<script>
(function() {
    // Payload específico de A Disposición (lo único propio de esta superficie)
    function buildDispSubconcept(d) {
        const capacity = d.vehicleCapacity || 4;
        const trunkCapacity = d.trunkCapacity || 2;
        const vehicleTypeName = d.vehicleName + ' - ' + capacity + ' pax, ' + trunkCapacity + ' maletas';
        // Base EFECTIVO (MXN, sin recargo por método de pago): el módulo genérico deriva
        // pricesByType (efectivo/transferencia/tarjeta) para que la cotización cambie el precio
        // según SU método de pago. hourlyRate es la tarifa base (sin recargo).
        const disc = (Number(d.discountPercent) || 0) / 100;
        const baseEfectivo = Math.round((Number(d.hourlyRate) || 0) * (Number(d.hours) || 0) * (Number(d.vehicleCount) || 1) * (1 - disc) * 100) / 100;
        return {
            type: 'a-disposicion', concept: 'A Disposición', time: '', endTime: '',
            vehicleType: d.vehicleTypeId, vehicleTypeName: vehicleTypeName, rateId: d.rateId,
            unitPrice: baseEfectivo, quantity: 1, hours: d.hours, vehicleCount: d.vehicleCount,
            hourlyPrice: d.hourlyRate, discountPercent: d.discountPercent, total: baseEfectivo,
            persons: 0, transportAdults: 0, transportChildren: 0, transportInfants: 0,
            selectedSchedule: '', includeInTotal: true, notes: ''
        };
    }

    document.getElementById('addDisposicionToQuoteBtn')?.addEventListener('click', function() {
        const calc = window._currentDisposicionCalc;
        if (!calc || !calc.totalCost || calc.totalCost <= 0) return;
        const currSymbol = calc.currency === 'USD' ? 'USD' : 'MXN';
        const priceFormatted = calc.totalCost.toLocaleString(calc.currency === 'USD' ? 'en-US' : 'es-MX', {
            minimumFractionDigits: calc.currency === 'USD' ? 2 : 0,
            maximumFractionDigits: calc.currency === 'USD' ? 2 : 0
        });
        AddToQuote.open({
            userRole: '<%= currentUserRole %>',
            serviceLabel: 'Servicio a disposición',
            itemLabel: '<strong>A Disposición: ' + calc.vehicleName + ' - ' + calc.rateName + '</strong><br>' +
                '<span class="small">' + calc.hours + 'h · ' + calc.vehicleCount + ' vehículo(s) · $' + priceFormatted + ' ' + currSymbol + '</span>',
            buildSubconcept: function() { return buildDispSubconcept(calc); }
        });
    });
})();
</script>
<% } %>

