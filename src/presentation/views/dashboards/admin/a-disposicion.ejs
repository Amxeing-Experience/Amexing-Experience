.adispo-admin-note { margin-top: 16px; border: 1px solid rgba(184,137,74,.4); background: rgba(184,137,74,.07); border-radius: 3px; padding: 14px 16px; }
.adispo-admin-note .an-head { font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); font-weight: 700; margin-bottom: 8px; }
.adispo-admin-note .an-row { display: flex; justify-content: space-between; gap: 12px; font-size: .8rem; color: var(--dark); }
