        }

        tbody.innerHTML = '';
        originalPrices = {};

        console.log('💰 Number of price records:', pricesArray.length);

        // Iterate through each price record in the flat array
        pricesArray.forEach(priceData => {
            if (priceData.isCurrentlyEffective) {
                const priceId = priceData.id;
                originalPrices[priceId] = priceData.hourlyPrice;

                const row = document.createElement('tr');
