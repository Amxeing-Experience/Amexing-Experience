.adispo-summary .srow { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--border); }
.adispo-summary .srow .k { font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: var(--olive); font-weight: 600; flex: 0 0 auto; }
