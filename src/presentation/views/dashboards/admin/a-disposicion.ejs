<%
/**
 * A Disposición Calculator Page (shared markup for admin / client / department_manager)
 * Hourly vehicle rental pricing calculator with volume discounts.
 *
 * Luxury 3-column layout (aligned with Experiencias / Tours):
 * - Top: currency + payment method
 * - Left: Tarifa + Vehículo (option cards)
 * - Center: hero image + thumbnails of the selected vehicle
 * - Right: cart summary (selected item + steppers + totals + volume-discount reference) + CTA
 * - Below (admin only): "Administrar precios por hora"
 *
 * All element IDs and the pricing / quote / price-management JS are preserved
 * verbatim so no functionality is lost.
 *
 * Created by Denisse Maldonado.
 */

// Page configuration
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const isAdminRole = (currentUserRole === 'admin' || currentUserRole === 'superadmin');
%>

<!-- CSRF Token Meta Tag -->
<% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
<meta name="csrf-token" content="<%= csrfToken %>">
<% } %>

<!-- Serif accent (falls back to brand Arpona / Playfair) -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

<div class="adispo">

    <!-- Page Header with Breadcrumb -->
    <div class="adispo-head">
        <div>
            <h2 class="mb-1 fw-bold">Servicio a Disposición</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/dashboard/<%= currentUserRole %>" class="text-decoration-none">
                            <i class="ti ti-home me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <i class="ti ti-calculator me-1"></i>A Disposición
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Moneda / Método de pago -->
    <div class="adispo-top">
        <div class="field">
            <label class="field-lb" for="disposicion-currency">Moneda</label>
            <select class="field-select" id="disposicion-currency">
                <option value="MXN" selected>MXN — Peso Mexicano</option>
                <option value="USD">USD — Dólar Estadounidense</option>
            </select>
        </div>
        <div class="field">
            <label class="field-lb" for="disposicion-payment">Método de pago</label>
            <select class="field-select" id="disposicion-payment">
                <option value="efectivo">Efectivo</option>
                <option value="transferencia">Transferencia</option>
                <option value="tarjeta" selected>Tarjeta de Débito/Crédito</option>
            </select>
        </div>
    </div>

    <div class="adispo-grid">

        <!-- IZQUIERDA: Tarifa + Vehículo -->
        <div class="adispo-left">
            <div class="blk">
                <div class="step">
                    <span class="step-name">Tarifa</span>
                </div>
                <div id="rate-buttons-group" role="group" aria-label="Tarifas disponibles">
                    <!-- Rate buttons injected by JS -->
                </div>
                <input type="hidden" id="disposicion-rate" value="">
            </div>

            <div class="blk">
                <div class="step">
                    <span class="step-name">Vehículo</span>
                </div>
                <div id="vehicle-placeholder-message" class="adispo-hint">
                    <i class="ti ti-arrow-up me-1"></i>Selecciona una tarifa primero
                </div>
                <div id="vehicle-selection-container" style="display: none;">
                    <div id="vehicle-buttons-group">
                        <!-- Vehicle buttons injected by JS -->
                    </div>
                    <input type="hidden" id="disposicion-vehicle-type" value="">
                </div>
            </div>
        </div>

        <!-- CENTRO: hero + miniaturas -->
        <div class="adispo-mid">
            <div class="adispo-hero" id="adispo-hero">
                <div class="adispo-hero-loader" id="adispo-hero-loader"><span class="adispo-spinner"></span></div>
                <div class="adispo-hero-empty" id="photos-placeholder">
                    <i class="ti ti-photo"></i>
                    <span>Selecciona un vehículo para ver sus fotos</span>
                </div>
                <img id="adispo-hero-img" alt="Vehículo seleccionado" style="display: none;">
                <button type="button" class="adispo-zoom" id="adispo-hero-zoom" style="display: none;" aria-label="Ampliar imagen">
                    <i class="ti ti-maximize"></i>
                </button>
                <div class="adispo-hero-cap" id="adispo-hero-cap" style="display: none;">
                    <div class="ck" id="adispo-hero-cat"></div>
                    <div class="cn" id="adispo-hero-name"></div>
                </div>
            </div>

            <!-- Slider horizontal de miniaturas (mismo patrón que el detalle de experiencias) -->
            <div class="adispo-gallery" id="adispo-gallery" style="display: none;">
                <button type="button" class="adispo-gnav adispo-gnav--prev is-hidden" id="adispo-gprev" aria-label="Anterior">
                    <i class="ti ti-chevron-left"></i>
                </button>
                <div class="adispo-strip" id="adispo-thumbs"></div>
                <button type="button" class="adispo-gnav adispo-gnav--next" id="adispo-gnext" aria-label="Siguiente">
                    <i class="ti ti-chevron-right"></i>
                </button>
            </div>
        </div>

        <!-- DERECHA: carrito (resumen) + CTA -->
        <div class="adispo-right">
            <!-- Estado vacío del carrito -->
            <div id="input-placeholder-message" class="adispo-hint">
                <i class="ti ti-shopping-cart me-1"></i>Selecciona una tarifa y un vehículo para armar tu servicio
            </div>

            <!-- Resumen / carrito (se muestra al seleccionar vehículo) -->
            <div id="price-display-section" class="adispo-summary" style="display: none;">
                <div class="adispo-summary-loader" id="adispo-summary-loader"><span class="adispo-spinner adispo-spinner--sm"></span></div>
                <h4>Resumen</h4>

                <!-- Ítem seleccionado -->
                <div class="cart-item">
                    <div class="cart-item__rate" id="disposicion-sel-rate"></div>
                    <div class="cart-item__name" id="disposicion-sel-vehicle"></div>
                </div>

                <!-- Cantidad y horas integradas al carrito, con botones +/- -->
                <div id="input-fields-container" class="adispo-cart-fields">
                    <div class="cart-stepper">
                        <span class="cart-stepper__lb"><i class="ti ti-car me-1"></i>Vehículos</span>
                        <div class="cart-stepper__ctrl">
                            <button type="button" class="cart-step-btn" data-target="disposicion-vehicle-count" data-dir="-1" data-step="1" aria-label="Disminuir vehículos">−</button>
                            <input type="number" id="disposicion-vehicle-count" min="1" max="10" value="1">
                            <button type="button" class="cart-step-btn" data-target="disposicion-vehicle-count" data-dir="1" data-step="1" aria-label="Aumentar vehículos">+</button>
                        </div>
                    </div>
                    <div class="cart-stepper">
                        <span class="cart-stepper__lb"><i class="ti ti-clock me-1"></i>Horas</span>
                        <div class="cart-stepper__ctrl">
                            <button type="button" class="cart-step-btn" data-target="disposicion-hours" data-dir="-1" data-step="0.5" aria-label="Disminuir horas">−</button>
                            <input type="number" id="disposicion-hours" min="1" max="24" value="4" step="0.5">
                            <button type="button" class="cart-step-btn" data-target="disposicion-hours" data-dir="1" data-step="0.5" aria-label="Aumentar horas">+</button>
                        </div>
                    </div>

                    <% if (isAdminRole) { %>
                    <div class="disc-ref">
                        <span class="disc-ref-lb">Descuentos por volumen</span>
                        <div class="disc" id="disposicion-discount-chips">
                            <span data-min="8">8 h · −2.5%</span>
                            <span data-min="10">10 h · −5%</span>
                            <span data-min="12">12 h · −7.5%</span>
                            <span data-min="16">16 h · −10%</span>
                        </div>
                    </div>
                    <% } %>
                </div>

                <div class="srow">
                    <span class="k">Precio base</span>
                    <span class="v" id="disposicion-base-cost">$0 MXN</span>
                </div>

                <div class="srow disc-row" id="disposicion-discount-row" style="display: none;">
                    <span class="k"><i class="ti ti-discount me-1"></i>Descuento</span>
                    <span class="v" id="disposicion-discount">-0%</span>
                </div>

                <div class="total">
                    <span class="tl">Total estimado</span>
                    <div class="total-amt">
                        <div class="tv" id="disposicion-total-cost">$0 MXN</div>
                    </div>
                </div>

                <!-- Admin-only detailed breakdown -->
                <% if (isAdminRole) { %>
                <div id="disposicion-cash-rounding-row" class="adispo-admin-note" style="display: none;">
                    <div class="an-head">
                        <i class="ti ti-info-circle me-1"></i>Desglose administrativo (efectivo)
                    </div>
                    <div class="an-row">
                        <span>Cálculo original → Redondeado:</span>
                        <span id="disposicion-cash-rounding-info" class="an-val"></span>
                    </div>
                    <div class="an-foot">
                        <i class="ti ti-coin me-1"></i>Redondeado a múltiplos de $5 MXN para facilitar el pago en efectivo
                    </div>
                </div>
                <% } %>

                <!-- Add to Quote — oculto para admin por coherencia (solo department_manager/client). Rehabilitar quitando el gate. -->
                <% if (!isAdminRole) { %>
                <div id="disposicion-add-to-quote-wrapper" style="display: none;">
                    <button type="button" class="adispo-cta" id="addDisposicionToQuoteBtn">
                        Agregar a cotización <i class="ti ti-arrow-right ms-1"></i>
                    </button>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <% if (isAdminRole) { %>
    <!-- SOLO ADMIN: Administrar precios por hora -->
    <div class="adispo-admin-sec">
        <div class="adispo-admin-sec__head">
            <span class="t"><i class="ti ti-settings me-2"></i>Administrar precios por hora</span>
            <span class="bdg">Solo admin</span>
        </div>
        <div class="adispo-admin-sec__body">
            <p class="adispo-admin-note-txt">
                Los precios editados aquí <strong>únicamente afectan al Servicio a Disposición</strong>.
                Los de otros servicios (Tours, Traslados, Experiencias) se administran por separado.
            </p>

            <div id="price-management-alert" class="alert d-none" role="alert"></div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 45%;">Tipo de Vehículo</th>
                            <th style="width: 20%;">Tarifa</th>
                            <th style="width: 35%;">Precio por Hora (MXN)</th>
                        </tr>
                    </thead>
                    <tbody id="disposable-prices-tbody">
                        <!-- Prices loaded dynamically -->
                    </tbody>
                </table>
            </div>

            <div class="mt-3 text-end">
                <button id="save-all-prices" class="adispo-psave" disabled>
                    <i class="ti ti-device-floppy me-2"></i>Guardar todos los cambios
                </button>
            </div>
        </div>
    </div>
    <% } %>

</div>

<!-- Add to Quote — modal genérico compartido (oculto para admin) -->
<% if (!isAdminRole) { %>
<%- include('../../organisms/quotes/add-to-quote-modal') %>
<% } %>

<!-- ═══════════ Fullscreen Vehicle Gallery Modal ═══════════ -->
<div class="modal fade" id="dispGalleryModal" tabindex="-1" aria-labelledby="dispGalleryLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content disp-gallery-modal">
            <div class="modal-header border-0 position-absolute top-0 start-0 w-100" style="z-index: 1060;">
                <div class="d-flex justify-content-between align-items-center w-100 p-3">
                    <h5 class="modal-title text-white" id="dispGalleryLabel">Galería del vehículo</h5>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-white disp-gallery-counter" id="dispGalleryCounter">1 / 1</span>
                        <button type="button" class="disp-gallery-close" data-bs-dismiss="modal" aria-label="Cerrar galería" title="Cerrar galería">
                            <i class="ti ti-x"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-body p-0 d-flex align-items-center justify-content-center position-relative">
                <div class="disp-gallery-main">
                    <img id="dispGalleryMainImage" src="" alt="" class="disp-gallery-image">
                </div>
                <button class="disp-gallery-nav disp-gallery-nav--prev" id="dispGalleryPrev" aria-label="Anterior">
                    <i class="ti ti-chevron-left"></i>
                </button>
                <button class="disp-gallery-nav disp-gallery-nav--next" id="dispGalleryNext" aria-label="Siguiente">
                    <i class="ti ti-chevron-right"></i>
                </button>
            </div>
            <div class="disp-gallery-thumbs position-absolute bottom-0 start-0 w-100">
                <div class="disp-gallery-thumbs-inner" id="dispGalleryThumbs"></div>
            </div>
        </div>
    </div>
</div>

<!-- Centralized Pricing Utilities -->
<script src="/dashboard/js/utils/pricing-utils.js"></script>

<!-- JavaScript for Calculator -->
<script>
(function() {
    'use strict';

    let vehicleTypes = [];
    let disposablePrices = {};
    let availableRates = [];
    let defaultHourlyRate = 500; // Fallback hourly rate
    let vehicleImages = {}; // Store images grouped by vehicleType + rate
    let priceCache = {}; // Hourly price per `${vehicleTypeId}_${rateId}` (fetched once)
    let vehiclesForRateCache = {}; // Vehicles list per rateId (fetched once)
    let currentVehicleImages = []; // Images of the currently selected vehicle+rate
    let dispGalleryIndex = 0; // Active index in the fullscreen gallery
    let currentExchangeRate = 0;
    let currentTransferRate = 0;
    let currentAgencyRate = 0;

    // Load rates and initialize calculator
    async function loadRatesAndInitialize() {
        try {
            // Load all available rates first
            const ratesResponse = await fetch('/api/rates/active', {
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('authToken')}`,
                    'Content-Type': 'application/json'
                }
            });

            if (ratesResponse.ok) {
                const ratesData = await ratesResponse.json();
                // Filter out "Económico" rate
                availableRates = (ratesData.data || []).filter(rate =>
                    rate.label !== 'Económico' && !rate.label.toLowerCase().includes('economico')
                );
                populateRateButtons();
            }

            // Load disposable prices grouped by vehicle type
            const pricesResponse = await fetch('/api/disposable-prices/by-vehicle-type', {
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('authToken')}`,
                    'Content-Type': 'application/json'
                }
            });

            if (pricesResponse.ok) {
                const pricesResult = await pricesResponse.json();
                disposablePrices = pricesResult.data || {};

                // Extract vehicle types from disposable prices data
                vehicleTypes = Object.values(disposablePrices).map(data => {
                    const vehicleType = data.vehicleType;
                    const currentPrice = data.prices.find(p => p.isCurrentlyEffective) || data.prices[0];

                    return {
                        id: vehicleType.id,
                        value: vehicleType.code || vehicleType.name,
                        label: vehicleType.name,
                        capacity: vehicleType.capacity || 4,
                        hourlyPrice: currentPrice ? currentPrice.hourlyPrice : defaultHourlyRate,
                        currency: currentPrice ? currentPrice.currency : 'MXN'
                    };
                });

                populateVehicleTypeSelect();

                // Load vehicle images for all combinations
                await loadAllVehicleImages();

                // Preselect first rate + first vehicle so the user sees content right away
                await autoSelectDefaults();
            } else {
                console.warn('Failed to load disposable prices, using fallback data');
                loadFallbackData();
            }
        } catch (error) {
            console.error('Error loading vehicle types and prices:', error);
            loadFallbackData();
        }
    }

    // Load all vehicle images for available combinations
    async function loadAllVehicleImages() {
        try {
            console.log('🖼️ Loading vehicle images for all combinations...');

            // Get all vehicles that have images based on vehicleType and rate combinations
            const imagesResponse = await fetch('/api/vehicles/images/by-disposable-combinations', {
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('authToken')}`,
                    'Content-Type': 'application/json'
                }
            });

            if (imagesResponse.ok) {
                const imagesData = await imagesResponse.json();
                vehicleImages = imagesData.data || {};
                console.log('✅ Loaded vehicle images:', Object.keys(vehicleImages).length, 'combinations');
            } else {
                console.warn('⚠️ Failed to load vehicle images, will use placeholders');
                vehicleImages = {};
            }
        } catch (error) {
            console.error('❌ Error loading vehicle images:', error);
            vehicleImages = {};
        }
    }

    // Fallback data if API fails
    function loadFallbackData() {
        vehicleTypes = [
            { id: 'fallback-sedan', value: 'SEDAN', label: 'Sedan', capacity: 4, hourlyPrice: 450, currency: 'MXN' },
            { id: 'fallback-van', value: 'VAN', label: 'Van', capacity: 8, hourlyPrice: 650, currency: 'MXN' },
            { id: 'fallback-suburban', value: 'SUBURBAN', label: 'SUV', capacity: 6, hourlyPrice: 850, currency: 'MXN' },
            { id: 'fallback-sprinter', value: 'SPRINTER', label: 'Sprinter', capacity: 15, hourlyPrice: 1200, currency: 'MXN' },
            { id: 'fallback-model3', value: 'MODEL 3', label: 'Tesla Model 3', capacity: 4, hourlyPrice: 750, currency: 'MXN' },
            { id: 'fallback-modely', value: 'MODEL Y', label: 'Tesla Model Y', capacity: 5, hourlyPrice: 950, currency: 'MXN' }
        ];
        populateVehicleTypeSelect();
        showHeroLoader(false);
    }

    // Populate rate buttons (shows all rates initially)
    function populateRateButtons() {
        const buttonsContainer = $('#rate-buttons-group');
        buttonsContainer.empty();

        if (availableRates.length === 0) {
            buttonsContainer.append(`
                <div class="adispo-warn">
                    <i class="ti ti-exclamation-circle me-2"></i>No hay tarifas disponibles
                </div>
            `);
            return;
        }

        // Create option cards for all available rates (none selected by default)
        availableRates.forEach((rate, index) => {
            const button = $(`
                <button type="button" class="opt-card rate-button btn-outline-primary"
                        data-rate-id="${rate.value}"
                        data-percentage="${rate.percentage || 0}">
                    <i class="ti ti-check ac-check"></i>
                    <div class="fw-bold ac-name">${rate.label}</div>
                    ${rate.percentage ? `<div class="ac-desc small">Tarifa ${rate.percentage}%</div>` : ''}
                </button>
            `);

            buttonsContainer.append(button);
        });

        // Don't auto-select any rate - let user choose

        // Add click handlers for rate buttons
        $('.rate-button').on('click', async function() {
            // Remove active state from all buttons
            $('.rate-button').each(function() {
                $(this).removeClass('btn-primary').addClass('btn-outline-primary');
                $(this).find('.small').removeClass('text-light').addClass('text-muted');
            });

            // Add active state to clicked button
            $(this).removeClass('btn-outline-primary').addClass('btn-primary');
            $(this).find('.small').removeClass('text-muted').addClass('text-light');

            // Update hidden input value
            const rateId = $(this).data('rate-id');
            $('#disposicion-rate').val(rateId);

            // Show vehicle selection and load vehicles for this rate
            showHeroLoader(true);
            await loadVehiclesForRate(rateId);

            // Preselect the first vehicle for the newly chosen rate
            const firstVehicle = $('.vehicle-button').first();
            if (firstVehicle.length) {
                firstVehicle.trigger('click');
            } else {
                showHeroLoader(false);
                updateDisposicionPrice();
            }
        });
    }

    // Load vehicles available for selected rate
    async function loadVehiclesForRate(rateId) {
        try {
            // Use cached vehicles for this rate when available (avoids repeat requests)
            let availableVehicles = vehiclesForRateCache[rateId];
            if (!availableVehicles) {
                const vehiclesResponse = await fetch(`/api/disposable-prices/vehicles-for-rate?rateId=${rateId}`, {
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('authToken')}`,
                        'Content-Type': 'application/json'
                    }
                });
                if (!vehiclesResponse.ok) {
                    showHeroLoader(false);
                    return;
                }
                const vehiclesData = await vehiclesResponse.json();
                availableVehicles = vehiclesData.data || [];
                vehiclesForRateCache[rateId] = availableVehicles;
            }

            {
                // Hide placeholder message and show vehicle selection container
                $('#vehicle-placeholder-message').hide();
                $('#vehicle-selection-container').show();

                // Clear and populate vehicle buttons
                const buttonsContainer = $('#vehicle-buttons-group');
                buttonsContainer.empty();

                if (availableVehicles.length === 0) {
                    buttonsContainer.append(`
                        <div class="adispo-warn">
                            <i class="ti ti-exclamation-circle me-2"></i>No hay vehículos disponibles para esta tarifa
                        </div>
                    `);
                    return;
                }

                availableVehicles.forEach((vehicle, index) => {
                    const button = $(`
                        <button type="button" class="opt-card vehicle-button btn-outline-success"
                                data-vehicle-id="${vehicle.value}"
                                data-capacity="${vehicle.capacity}"
                                data-trunk-capacity="${vehicle.trunkCapacity || 2}">
                            <i class="ti ti-check ac-check"></i>
                            <div class="fw-bold ac-name">${vehicle.label}</div>
                            <div class="ac-spec small">
                                <span><i class="ti ti-users"></i>${vehicle.capacity} pax</span>
                                <span><i class="ti ti-briefcase"></i>${vehicle.trunkCapacity || 2} carry on</span>
                            </div>
                        </button>
                    `);

                    buttonsContainer.append(button);
                });

                // Don't auto-select any vehicle - wait for user selection
                $('#disposicion-vehicle-type').val('');

                // Add click handlers for vehicle buttons
                $('.vehicle-button').on('click', function() {
                    // Remove active state from all vehicle buttons
                    $('.vehicle-button').each(function() {
                        $(this).removeClass('btn-success').addClass('btn-outline-success');
                        $(this).find('.small').removeClass('text-white text-light').addClass('text-muted');
                    });

                    // Add active state to clicked button
                    $(this).removeClass('btn-outline-success').addClass('btn-success');
                    $(this).find('.small').removeClass('text-muted').addClass('text-white');

                    // Update hidden input value
                    const selectedVehicleId = $(this).data('vehicle-id');
                    const selectedVehicleName = $(this).find('.fw-bold').text();
                    $('#disposicion-vehicle-type').val(selectedVehicleId);

                    // Reveal the cart summary when a vehicle is selected
                    $('#input-placeholder-message').hide();
                    $('#price-display-section').show();

                    // Load and show vehicle hero + thumbnails (loader hides on image load)
                    showHeroLoader(true);
                    loadVehicleCarousel(selectedVehicleId, selectedVehicleName);

                    // Recalculate price
                    updateDisposicionPrice();
                });
            }
        } catch (error) {
            console.error('Error loading vehicles for rate:', error);
        }
    }

    // Preselect a rate + vehicle so the calculator shows content on load.
    // Prefer a combination that actually has photos, so the hero isn't empty by default.
    async function autoSelectDefaults() {
        if (!availableRates || !availableRates.length) { showHeroLoader(false); return; }

        const rateHasImages = (rateId) => Object.keys(vehicleImages)
            .some(k => k.endsWith('_' + rateId) && (vehicleImages[k] || []).length > 0);

        // Pick the first rate whose vehicles have images, else the first rate
        const chosenRate = availableRates.find(r => rateHasImages(r.value)) || availableRates[0];

        const rateBtn = $(`.rate-button[data-rate-id="${chosenRate.value}"]`);
        if (!rateBtn.length) { showHeroLoader(false); return; }

        $('.rate-button').removeClass('btn-primary').addClass('btn-outline-primary');
        rateBtn.removeClass('btn-outline-primary').addClass('btn-primary');
        $('#disposicion-rate').val(chosenRate.value);

        // Load vehicles for that rate, then prefer a vehicle that has images
        await loadVehiclesForRate(chosenRate.value);

        const vehicleBtns = $('.vehicle-button');
        let chosenVehicle = null;
        vehicleBtns.each(function() {
            if (chosenVehicle) return;
            const key = $(this).data('vehicle-id') + '_' + chosenRate.value;
            if ((vehicleImages[key] || []).length > 0) chosenVehicle = this;
        });
        if (!chosenVehicle && vehicleBtns.length) chosenVehicle = vehicleBtns[0];

        if (chosenVehicle) {
            $(chosenVehicle).trigger('click');
