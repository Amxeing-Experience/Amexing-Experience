<%#
Tours (subpágina de Servicios).
Usa el organismo compartido `categories-section` (mismo diseño que Experiencias);
los datos que cargue por categoría serán distintos (se conectarán al backend).

Created by Denisse Maldonado
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="icon" type="image/png" href="/images/heart_black.png">

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background: #eff0ec;
            color: #333;
            padding-top: 80px; /* navbar fijo */
        }
    </style>
</head>
<body>
    <%# Navigation %>
    <%- include('../organisms/landing/landing-navigation', {
        user: typeof user !== 'undefined' ? user : null,
        currentPage: typeof currentPage !== 'undefined' ? currentPage : 'services',
        transparent: false,
        companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null,
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Sección interactiva (mismo diseño que Experiencias, datos propios de Tours):
        muestra los DESTINOS tipo Tours activos con su imagen. Si aún no hay destinos,
        cae a las categorías por defecto para no dejar el strip vacío. %>
    <%
        const _tourPlaceholder = '/images/placeholder-heart.png';
        const _destinos = (typeof tourDestinos !== 'undefined' && Array.isArray(tourDestinos)) ? tourDestinos : [];
        const _tourCategories = _destinos.length > 0
            ? _destinos.map(function(d) { return { label: d.name, img: d.imageUrl || _tourPlaceholder, value: d.id }; })
            : [
                { label: t('pages:categories.catas'), img: '/images/7.png' },
                { label: t('pages:categories.arte'), img: '/images/4.png' },
                { label: t('pages:categories.historiaArquitectura'), img: '/images/3.png' },
                { label: t('pages:categories.gastronomicas'), img: '/images/6.png' },
                { label: t('pages:categories.aventura'), img: '/images/5.png' },
                { label: t('pages:categories.naturaleza'), img: '/images/2.png' },
                { label: t('pages:categories.deTemporada'), img: '/images/1.png' }
            ];
    %>
    <%- include('../organisms/servicios/tours-categories-section', {
        t: typeof t !== 'undefined' ? t : ((key) => key),
        pageTitle: t('pages:tours.title'),
        intro: t('pages:tours.intro'),
        categories: _tourCategories,
        toursByDestino: typeof toursByDestino !== 'undefined' ? toursByDestino : {}
    }) %>

    <%# CTA Contacto (reutilizable) %>
    <%- include('../organisms/landing/cta-contacto-section', {
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Footer %>
    <%- include('../organisms/landing/landing-footer', {
        companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null
    }) %>
</body>
</html>
