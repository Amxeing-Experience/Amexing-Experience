<%#
Bodas y Eventos (subpágina de Servicios).
Header: banner full-width con bodas_header.png.

Created by Denisse Maldonado
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <%# Fuente script para el título del hero (Bodas y Eventos / Weddings & Events) %>
    <link href="https://fonts.googleapis.com/css2?family=Imperial+Script&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="icon" type="image/png" href="/images/heart_black.png">

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background: #eff0ec;
            color: #333;
            padding-top: 80px; /* navbar fijo */
        }

        /* ---- Header: banner con imagen ---- */
        .bodas-hero {
            position: relative;
            width: 100%;
            line-height: 0;
        }

        .bodas-hero__img {
            display: block;
            width: 100%;
            height: auto;
        }

        .bodas-hero__title {
            position: absolute;
            top: clamp(1.2rem, 4vw, 3rem);
            left: 50%;
            transform: translateX(-50%);
            margin: 0;
            font-family: 'Imperial Script', cursive;
            font-weight: 400;
            color: #ffffff;
            font-size: clamp(2.8rem, 8vw, 6rem);
            line-height: 1.05;
            letter-spacing: 0.02em;
            white-space: nowrap;
            text-align: center;
            text-shadow: 0 2px 14px rgba(0, 0, 0, 0.35);
            pointer-events: none;
        }

        /* línea decorativa debajo del título */
        .bodas-hero__title::after {
            content: '';
            display: block;
            width: min(620px, 72vw);
            height: 1px;
            margin: clamp(0.3rem, 1.2vw, 0.8rem) auto 0;
            background: rgba(255, 255, 255, 0.85);
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
        }

        /* ---- Logística día del evento ---- */
        .bodas-logistica {
            background: #2e2e2d;
            padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(3rem, 6vw, 5rem);
        }

        /* banner de imágenes a todo lo ancho */
        .bodas-logistica__images {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0;
            width: 100%;
        }

        .bodas-logistica__img {
            aspect-ratio: 3 / 2;
            background: linear-gradient(135deg, #4c4c48 0%, #3a3a37 100%);
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255, 255, 255, 0.35);
            font-size: 1.8rem;
        }

        .bodas-logistica__body {
            max-width: 720px;
            margin: clamp(2.5rem, 5vw, 4rem) auto 0;
            padding: 0 1.5rem;
            box-sizing: border-box;
            text-align: center;
        }

        .bodas-logistica__title {
            font-family: var(--font-newsreader), serif;
            font-variant: small-caps;
            font-feature-settings: "smcp";
            font-size: clamp(1.3rem, 2.5vw, 2rem);
            font-weight: 400;
            letter-spacing: 0.12em;
            color: #ffffff;
            line-height: 1.35;
            margin: 0;
        }

        .bodas-logistica__rule {
            display: block;
            height: 2px;
            background: rgba(255, 255, 255, 0.4);
            margin: clamp(1.6rem, 3.5vw, 2.8rem) 0;
        }

        .bodas-logistica__text {
            padding: 0 clamp(1rem, 4vw, 3rem);
        }

        .bodas-logistica__text p {
            font-family: var(--font-myriad), 'Montserrat', sans-serif;
            font-weight: 300;
            font-size: clamp(0.95rem, 1.3vw, 1.1rem);
            line-height: 1.75;
            color: #e2e2dc;
            margin: 0 0 1.2rem;
        }

        .bodas-logistica__text p:last-child {
            margin-bottom: 0;
        }

        @media (max-width: 720px) {
            .bodas-logistica__images {
                grid-template-columns: 1fr;
            }
        }

        /* ---- Conoce nuestros servicios exclusivos para Novios ---- */
        .bodas-novios {
            background: #eef0e8 url('/images/back_planeacion.png') center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: clamp(2.5rem, 5vw, 3.5rem);
            padding: clamp(3.5rem, 9vw, 7rem) 1.5rem;
        }

        .bodas-novios__box {
            position: relative;
            background: #8b9176;
            width: clamp(290px, 34vw, 400px);
            box-sizing: border-box;
            padding: clamp(2.2rem, 4vw, 3.2rem) clamp(1.5rem, 3vw, 2.5rem);
            text-align: center;
        }

        /* marco exterior delgado: borde negro + hueco alrededor del cuadro verde */
        .bodas-novios__box::before {
            content: '';
            position: absolute;
            inset: clamp(-26px, -3vw, -18px);
            border: 1px solid #585757;
            pointer-events: none;
        }

        .bodas-novios__title {
            font-family: var(--font-newsreader), serif;
            font-variant: small-caps;
            font-feature-settings: "smcp";
            font-weight: 400;
            color: #ffffff;
            letter-spacing: 0.06em;
            line-height: 1.2;
            margin: 0;
        }

        .bodas-novios__title span {
            display: block;
        }

        .bodas-novios__lg {
            font-size: clamp(1.7rem, 3vw, 2.4rem);
        }

        .bodas-novios__sm {
            font-size: clamp(1.25rem, 2.2vw, 1.7rem);
        }

        /* conjunción "y": chica, en línea con "anfitriones" */
        .bodas-novios__conj {
            display: inline;
            font-size: 0.62em;
        }

        /* botón Contáctanos (mismo estilo que el CTA "¿No encuentras lo que buscas?") */
        .bodas-novios__btn {
            display: inline-block;
            padding: 0.85rem 2.6rem;
            border: 1px solid #585757;
            background: #ffffff;
            color: #2e2e2d;
            font-family: var(--font-myriad);
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            text-decoration: none;
            transition: background 0.3s ease, color 0.3s ease;
        }

        .bodas-novios__btn:hover {
            background: #585757;
            color: #ffffff;
        }

        /* ---- Servicios disponibles (asistentes al evento) ---- */
        .bodas-servicios {
            background: #d8d9d4 url('/images/bodas_servicios.png') center / cover no-repeat;
            padding: clamp(3.5rem, 8vw, 6rem) 1.5rem;
        }

        .bodas-servicios__inner {
            max-width: 1200px;
            margin: 0 auto;
            text-align: center;
        }

        /* título dentro de caja con borde delgado */
        .bodas-servicios__title {
            font-family: var(--font-newsreader), serif;
            font-variant: small-caps;
            font-feature-settings: "smcp";
            font-weight: 400;
            color: #2e2e2d;
            font-size: clamp(1.6rem, 3.4vw, 2.6rem);
            letter-spacing: 0.06em;
            line-height: 1.2;
            display: inline-block;
            width: min(760px, 100%);
            box-sizing: border-box;
            margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
            padding: clamp(0.8rem, 1.8vw, 1.4rem) clamp(1.5rem, 4vw, 3rem);
            border: 1px solid #ffffff;
        }

        .bodas-servicios__grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
            margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
        }

        .bodas-servicios__card {
            margin: 0;
        }

        .bodas-servicios__img {
            aspect-ratio: 5 / 4;
            background: #c9cabf center / cover no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8a8a80;
            font-size: clamp(1.6rem, 3vw, 2.4rem);
        }

        .bodas-servicios__label {
            font-family: var(--font-newsreader), serif;
            font-variant: small-caps;
            font-feature-settings: "smcp";
            font-weight: 600;
            font-size: clamp(1rem, 1.8vw, 1.4rem);
            letter-spacing: 0.08em;
            color: #3c3c3a;
            margin-top: clamp(0.8rem, 1.6vw, 1.2rem);
        }

        .bodas-servicios__btn {
            display: inline-block;
            background: #8b9176;
            color: #ffffff;
            font-family: var(--font-myriad);
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            text-decoration: none;
            padding: 1rem 3.2rem;
            transition: background 0.3s ease;
        }

        .bodas-servicios__btn:hover {
            background: #767c63;
        }

        @media (max-width: 720px) {
            .bodas-servicios__grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 0;
            }
        }
    </style>
</head>
<body>
    <%# Navigation %>
    <%- include('../organisms/landing/landing-navigation', {
        user: typeof user !== 'undefined' ? user : null,
        currentPage: typeof currentPage !== 'undefined' ? currentPage : 'services',
        transparent: false,
        companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null,
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Header: banner con la imagen de bodas %>
    <section class="bodas-hero">
        <img src="/images/bodas_header.jpg" alt="<%= t('pages:bodas.heroAlt') %>" class="bodas-hero__img">
        <h1 class="bodas-hero__title"><%= t('pages:bodas.heroTitle') %></h1>
    </section>

    <%# Logística día del evento %>
    <%
        const logisticaImages = ['/images/boda1.jpg', '/images/boda2.jpg', '/images/boda3.jpg'];
    %>
    <section class="bodas-logistica">
        <div class="bodas-logistica__images">
            <% logisticaImages.forEach(function(img, i) { %>
                <div class="bodas-logistica__img"
                     <% if (img) { %>style="background-image: url('<%= img %>')"<% } %>
                     role="img" aria-label="<%= t('pages:bodas.imageAlt', { n: i + 1 }) %><%= img ? '' : ' (placeholder)' %>">
                    <% if (!img) { %><i class="fa-regular fa-image" aria-hidden="true"></i><% } %>
                </div>
            <% }); %>
        </div>

        <div class="bodas-logistica__body">
            <h2 class="bodas-logistica__title"><%= t('pages:bodas.logistica.title') %></h2>
            <span class="bodas-logistica__rule" aria-hidden="true"></span>
            <div class="bodas-logistica__text">
                <p>Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.</p>
                <p>Duis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim.</p>
            </div>
            <span class="bodas-logistica__rule" aria-hidden="true"></span>
        </div>
    </section>

    <%# Conoce nuestros servicios exclusivos para Novios %>
    <section class="bodas-novios">
        <div class="bodas-novios__box">
            <p class="bodas-novios__title">
                <span class="bodas-novios__lg"><%= t('pages:bodas.novios.w1') %></span>
                <span class="bodas-novios__sm"><%= t('pages:bodas.novios.w2') %></span>
                <span class="bodas-novios__sm"><%= t('pages:bodas.novios.w3') %></span>
                <span class="bodas-novios__sm"><%= t('pages:bodas.novios.w4') %></span>
                <span class="bodas-novios__sm"><%= t('pages:bodas.novios.w5') %></span>
                <span class="bodas-novios__lg"><%= t('pages:bodas.novios.w6') %></span>
                <span class="bodas-novios__lg"><span class="bodas-novios__conj"><%= t('pages:bodas.novios.conj') %></span> <%= t('pages:bodas.novios.w7') %></span>
            </p>
        </div>
        <a href="/contacto" class="bodas-novios__btn"><%= t('pages:bodas.novios.cta') %></a>
    </section>

    <%# Servicios disponibles (asistentes al evento) %>
    <%
        const bodasServicios = [
            { label: t('pages:bodas.servicios.transporte'),  img: '/images/boda_s1.png' },
            { label: t('pages:bodas.servicios.hospedaje'),   img: '/images/boda_s2.png' },
            { label: t('pages:bodas.servicios.vuelos'),      img: '/images/boda_s3.png' },
            { label: t('pages:bodas.servicios.actividades'), img: '/images/boda_s4.png' }
        ];
    %>
    <section class="bodas-servicios">
        <div class="bodas-servicios__inner">
            <h2 class="bodas-servicios__title"><%= t('pages:bodas.servicios.title') %></h2>
            <div class="bodas-servicios__grid">
                <% bodasServicios.forEach(function(s) { %>
                    <figure class="bodas-servicios__card">
                        <div class="bodas-servicios__img"
                             <% if (s.img) { %>style="background-image: url('<%= s.img %>')"<% } %>
                             role="img" aria-label="<%= s.label %><%= s.img ? '' : ' (placeholder)' %>">
                            <% if (!s.img) { %><i class="fa-regular fa-image" aria-hidden="true"></i><% } %>
                        </div>
                        <figcaption class="bodas-servicios__label"><%= s.label %></figcaption>
                    </figure>
                <% }); %>
            </div>
            <a href="/contacto" class="bodas-servicios__btn"><%= t('pages:bodas.servicios.cta') %></a>
        </div>
    </section>

    <%# CTA Contacto (reutilizable) %>
    <%- include('../organisms/landing/cta-contacto-section', {
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Footer %>
    <%- include('../organisms/landing/landing-footer', {
        companyInfo: typeof company !== 'undefined' ? company : null
    }) %>
</body>
</html>
