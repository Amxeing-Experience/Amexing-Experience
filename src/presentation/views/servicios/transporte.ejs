<%#
Transporte (subpágina de Servicios).
Header: banner con imagen de la flota.

Created by Denisse Maldonado
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="icon" type="image/png" href="/images/heart_black.png">

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background: #eff0ec;
            color: #333;
            padding-top: 80px; /* navbar fijo */
        }

        /* ---- Header: banner con imagen ---- */
        .transporte-hero {
            width: 100%;
            line-height: 0;
        }

        .transporte-hero__img {
            display: block;
            width: 100%;
            height: auto;
        }

        /* ---- Mapa: transfers al aeropuerto ---- */
        .transfers-map {
            width: 100%;
            line-height: 0;
        }

        .transfers-map__img {
            display: block;
            width: 100%;
            height: auto;
        }

        /* Stage con hotspots interactivos sobre el mapa: corazón ROJO en hover.
           El corazón usa heart_black.png como máscara rellena de rojo, así escala
           a cada recuadro calibrado sin depender de una imagen roja. */
        /* container-type para dimensionar el corazón como % del ancho del mapa (cqw),
           así queda constante entre ciudades sin importar el tamaño del recuadro. */
        .transfers-map__stage { position: relative; line-height: 0; container-type: inline-size; }

        .transfers-hotspot { position: absolute; cursor: pointer; }

        /* El corazón es una capa INDEPENDIENTE (no vive dentro del hotspot): se
           posiciona por su cuenta (hx/hy) para caer justo sobre el corazón del mapa
           —que suele estar arriba de la pastilla y no siempre centrado—. Se enciende
           en rojo al hacer hover en su hotspot. --heart-size ajusta el tamaño. */
        .transfers-heart {
            position: absolute;
            transform: translate(-50%, -50%);
            width: var(--heart-size, 2.6cqw);
            aspect-ratio: 1 / 1;
            background-color: #e11d1d;
            -webkit-mask: url('/images/heart_black.png') center / contain no-repeat;
            mask: url('/images/heart_black.png') center / contain no-repeat;
            opacity: 0;
            transition: opacity .18s ease;
            pointer-events: auto; /* el propio corazón también es zona de hover */
            z-index: 4;
        }
        .transfers-heart.is-on { opacity: 1; }

        /* Modo calibración (?calibrar): cuadros de hover (azul) + corazones (rojo),
           ambos arrastrables; los cuadros además se redimensionan. */
        .transfers-map__stage.is-calibrating .transfers-hotspot {
            cursor: move;
            outline: 2px dashed rgba(60, 120, 255, 0.9);
            background: rgba(60, 120, 255, 0.12);
            touch-action: none;
        }
        .transfers-map__stage.is-calibrating .transfers-hotspot.is-active-calib {
            outline-color: #ffd000;
            background: rgba(255, 208, 0, 0.18);
            z-index: 9;
        }
        .transfers-map__stage.is-calibrating .transfers-hotspot::after {
            content: attr(data-index);
            position: absolute; top: 2px; left: 4px;
            font: 700 12px/1 monospace; color: #fff;
            background: rgba(60, 120, 255, 0.9);
            padding: 1px 4px; border-radius: 3px;
        }
        .transfers-map__stage.is-calibrating .transfers-heart {
            opacity: 0.6;
            pointer-events: auto;
            cursor: move;
            outline: 2px dashed rgba(255, 60, 60, 0.95);
            touch-action: none;
        }
        .transfers-map__stage.is-calibrating .transfers-heart.is-active-calib { outline-color: #ffd000; }
        .transfers-handle {
            position: absolute; width: 12px; height: 12px;
            background: #ffd000; border: 1px solid #7a5b00; border-radius: 2px; z-index: 3;
        }
        .transfers-handle--n  { top: -6px; left: 50%; transform: translateX(-50%); cursor: ns-resize; }
        .transfers-handle--s  { bottom: -6px; left: 50%; transform: translateX(-50%); cursor: ns-resize; }
        .transfers-handle--e  { right: -6px; top: 50%; transform: translateY(-50%); cursor: ew-resize; }
        .transfers-handle--w  { left: -6px; top: 50%; transform: translateY(-50%); cursor: ew-resize; }
        .transfers-handle--ne { top: -6px; right: -6px; cursor: nesw-resize; }
        .transfers-handle--nw { top: -6px; left: -6px; cursor: nwse-resize; }
        .transfers-handle--se { bottom: -6px; right: -6px; cursor: nwse-resize; }
        .transfers-handle--sw { bottom: -6px; left: -6px; cursor: nesw-resize; }
        .transfers-calib {
            position: fixed; top: 90px; left: 12px; z-index: 9999;
            background: rgba(20, 20, 20, 0.92); color: #eaeaea; font: 12px/1.5 monospace;
            padding: 10px 12px; border-radius: 8px; max-width: 360px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        }
        .transfers-calib h4 { margin: 0 0 6px; font-size: 12px; color: #ffd000; }
        .transfers-calib-live { color: #8fe08f; margin-bottom: 6px; }
        .transfers-calib-list { white-space: pre; max-height: 230px; overflow: auto; }
        .transfers-calib button {
            margin-top: 8px; font: 11px monospace; cursor: pointer;
            background: #333; color: #fff; border: 1px solid #555; border-radius: 4px; padding: 4px 10px;
        }

        /* ---- Traslados punto a punto ---- */
        .book-vehicles {
            position: relative;
            width: 100%;
            line-height: 0;
        }

        .book-vehicles__img {
            display: block;
            width: 100%;
            height: auto;
        }

        /* zona clickeable transparente sobre el "BOOK NOW" de la imagen */
        .book-vehicles__cta {
            position: absolute;
            left: 71%;
            top: 80%;
            width: 13%;
            height: 11%;
        }

        /* ---- Espacio en blanco de separación ---- */
        .section-gap {
            height: clamp(0.6rem, 1.4vw, 1.1rem);
            background: #ffffff;
        }

        /* ---- Traslados locales ---- */
        .local-transfers {
            background: #8b9074; /* full-width */
            padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 8vw, 7rem);
        }

        .local-transfers__inner {
            max-width: 870px;
            margin: 0 auto;
            border-top: 2px solid rgba(255, 255, 255, 0.6);
            border-bottom: 2px solid rgba(255, 255, 255, 0.6);
            padding: clamp(0.9rem, 2vw, 1.5rem) clamp(1.5rem, 5vw, 4.5rem);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: clamp(1.5rem, 4vw, 3.5rem);
            flex-wrap: wrap;
        }

        .local-transfers__left {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: clamp(1rem, 2.5vw, 1.8rem);
            flex: 0 0 auto;
        }

        .local-transfers__title {
            font-family: var(--font-arpona), serif;
            font-variant: small-caps;
            font-feature-settings: "smcp";
            font-size: clamp(1.6rem, 3vw, 2.4rem);
            font-weight: 400;
            letter-spacing: 0.05em;
            color: #ffffff;
            text-align: center;
            margin: 0;
            line-height: 1.1;
        }

        .local-transfers__book {
            display: inline-block;
            background: #e8eade;
            color: #353530;
            border: none;
            padding: 0.7rem 1.9rem;
            font-family: var(--font-myriad), 'Montserrat', sans-serif;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            text-decoration: none;
            transition: filter 0.3s ease;
        }

        .local-transfers__book:hover {
            filter: brightness(0.95);
        }

        .local-transfers__icons {
            display: flex;
            align-items: center;
            gap: clamp(0.8rem, 2.5vw, 2rem);
            flex-wrap: wrap;
        }

        /* las imágenes ya traen el círculo */
        .local-transfers__icon {
            width: clamp(72px, 9.5vw, 124px);
            height: auto;
            display: block;
        }

        @media (max-width: 720px) {
            .local-transfers__inner {
                justify-content: center;
                text-align: center;
            }
            .local-transfers__left {
                align-items: center;
            }
        }

        /* ---- Opciones de vehículos ---- */
        .veh {
            background: #eff0ec;
            padding: clamp(4.5rem, 9vw, 8rem) clamp(1rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
        }

        .veh__frame {
            max-width: 1080px;
            margin: 0 auto;
            position: relative;
            border: 0.5px solid #000000;
            padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem);
        }

        /* doble borde (igual que la sección de Transporte en /servicios) */
        .veh__frame::before {
            content: '';
            position: absolute;
            top: -0.5rem;
            left: 0.5rem;
            right: 0.5rem;
            bottom: -0.5rem;
            border: 0.5px solid #2e2e2e;
            pointer-events: none;
        }

        .veh__title-wrap {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            transform: translateY(-50%);
            text-align: center;
            z-index: 2;
        }

        .veh__title {
            display: inline-block;
            background: #eff0ec; /* corta el doble borde por detrás */
            padding: 0 clamp(1.2rem, 3vw, 2.5rem);
            font-family: var(--font-newsreader), serif;
            font-variant: small-caps;
            font-feature-settings: "smcp";
            font-size: clamp(2.8rem, 5vw, 3.8rem); /* +1em */
            font-weight: 400;
            letter-spacing: 0.04em;
            color: #585757;
            text-align: center;
            margin: 0;
            line-height: 1.15;
        }

        .veh__intro {
            font-family: var(--font-myriad), 'Montserrat', sans-serif;
            font-weight: 300;
            font-size: clamp(0.95rem, 1.4vw, 1.1rem);
            line-height: 1.65;
            color: #4a4a44;
            text-align: center;
            max-width: 640px;
            margin: clamp(0.2rem, 0.8vw, 0.5rem) auto clamp(2rem, 5vw, 3.5rem);
        }

        /* ---- Filas de vehículo (imagen + card traslapados) ---- */
        .veh-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: center;
            margin: -0.1rem 0;
        }

        .veh-row__image {
            grid-area: 1 / 1 / 2 / 2;
            z-index: 2;
            height: clamp(230px, 27vw, 330px);
            background-size: cover;
            background-position: center;
        }

        /* la imagen se alarga sobre el card: sliver exterior + franja del card antes del texto */
        .veh-row--left .veh-row__image {
            grid-area: 1 / 1 / 2 / 3;
            margin-left: clamp(2rem, 5vw, 4rem);
            margin-right: 40%;
        }

        .veh-row--right .veh-row__image {
            grid-area: 1 / 1 / 2 / 3;
            margin-right: clamp(2rem, 5vw, 4rem);
            margin-left: 40%;
        }

        .veh-row__card {
            grid-area: 1 / 1 / 2 / 3;
            z-index: 1;
            height: clamp(180px, 21vw, 265px);
            display: flex;
            align-items: center;
        }

        .veh-row--dark .veh-row__card { background: #3a3a38; }
        .veh-row--green .veh-row__card { background: #969b81; }
        .veh-row--olive .veh-row__card { background: #565649; }

        .veh-row__content {
            width: 33%;
            text-align: center;
            padding: 1rem clamp(1rem, 2.5vw, 2rem);
            box-sizing: border-box;
            color: #ffffff;
        }

        /* texto centrado en la franja negra visible (al lado de la imagen) */
        .veh-row--left .veh-row__content { margin-left: auto; margin-right: 3.5%; }
        .veh-row--right .veh-row__content { margin-right: auto; margin-left: 3.5%; }

        .veh-row__name {
            font-family: var(--font-arpona), serif;
            font-variant: small-caps;
            font-feature-settings: "smcp";
            font-size: clamp(1.2rem, 2vw, 1.6rem);
            font-weight: 400;
            letter-spacing: 0.06em;
            margin: 0 0 0.7rem;
            line-height: 1;
        }

        .veh-row__for {
            font-family: var(--font-myriad), 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: clamp(0.85rem, 1.1vw, 0.95rem);
            margin: 0 0 0.4rem;
        }

        .veh-row__para {
            list-style: none;
            margin: 0 0 clamp(0.9rem, 2vw, 1.4rem);
            padding: 0;
            font-family: var(--font-newsreader), serif;
            font-variant: small-caps;
            font-feature-settings: "smcp";
            font-size: clamp(0.85rem, 1.1vw, 1rem);
            letter-spacing: 0.05em;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.92);
        }

        .veh-row__book {
            display: inline-block;
            background: transparent;
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.6);
            padding: 0.6rem 1.8rem;
            font-family: var(--font-myriad), 'Montserrat', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            text-decoration: none;
            transition: background 0.3s ease, color 0.3s ease;
        }

        /* Sedan (oscuro) y Van (olivo): botón verde, sin borde, texto negro */
        .veh-row--dark .veh-row__book,
        .veh-row--olive .veh-row__book {
            background: #969b81;
            color: #000000;
            border: none;
        }

        /* SUV (card verde): botón negro, sin borde, texto blanco */
        .veh-row--green .veh-row__book {
            background: #2e2e2d;
            color: #ffffff;
            border: none;
        }

        .veh-row__book:hover { filter: brightness(1.1); }

        @media (max-width: 720px) {
            .veh-row,
            .veh-row--right {
                grid-template-columns: 1fr;
            }
            .veh-row__image,
            .veh-row--right .veh-row__image {
                grid-area: 1 / 1 / 2 / 2;
                height: clamp(180px, 50vw, 260px);
            }
            .veh-row__card {
                grid-area: 2 / 1 / 3 / 2;
                height: auto;
            }
            .veh-row__content {
                width: 100%;
                margin: 0;
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <%# Navigation %>
    <%- include('../organisms/landing/landing-navigation', {
        user: typeof user !== 'undefined' ? user : null,
        currentPage: typeof currentPage !== 'undefined' ? currentPage : 'services',
        transparent: false,
        companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null,
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Header: banner con la imagen de la flota %>
    <section class="transporte-hero">
        <video class="transporte-hero__img" autoplay muted loop playsinline preload="metadata"
               poster="/images/video_tesla_poster.jpg" aria-label="<%= t('pages:transporte.heroAlt') %>">
            <source src="/images/video_tesla.mp4" type="video/mp4">
        </video>
    </section>

    <%# Opciones de vehículos %>
    <%
        const vehiculos = [
            { name: t('pages:transporte.vehicles.sedan'), img: '/images/DSC_3383.jpg', side: 'left', color: 'dark',
              para: [t('pages:transporte.audiences.couples'), t('pages:transporte.audiences.individual'), t('pages:transporte.audiences.business')] },
            { name: t('pages:transporte.vehicles.suv'), img: '/images/DSC_2981.jpg', side: 'right', color: 'green',
              para: [t('pages:transporte.audiences.couples'), t('pages:transporte.audiences.individual'), t('pages:transporte.audiences.business'), t('pages:transporte.audiences.smallFamilies')] },
            { name: t('pages:transporte.vehicles.van'), img: '/images/DSC_2228.jpg', side: 'left', color: 'olive',
              para: [t('pages:transporte.audiences.business'), t('pages:transporte.audiences.largeFamilies'), t('pages:transporte.audiences.largeGroups')] }
        ];
    %>
    <section class="veh">
        <div class="veh__frame">
            <div class="veh__title-wrap">
                <h2 class="veh__title"><%= t('pages:transporte.options.title1') %><br><%= t('pages:transporte.options.title2') %></h2>
            </div>
            <p class="veh__intro">
                Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud.
            </p>

            <div class="veh__list">
                <% vehiculos.forEach(function(v) { %>
                    <div class="veh-row veh-row--<%= v.side %> veh-row--<%= v.color %>">
                        <div class="veh-row__card">
                            <div class="veh-row__content">
                                <h3 class="veh-row__name"><%= v.name %></h3>
                                <p class="veh-row__for"><%= t('pages:transporte.perfectFor') %></p>
                                <ul class="veh-row__para">
                                    <% v.para.forEach(function(p) { %><li><%= p %></li><% }); %>
                                </ul>
                                <a href="/contacto#book" class="veh-row__book"><%= t('pages:transporte.bookNow') %></a>
                            </div>
                        </div>
                        <div class="veh-row__image" style="background-image: url('<%= v.img %>')" role="img" aria-label="<%= v.name %>"></div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <%# Mapa: transfers al aeropuerto — 8 ciudades con corazón rojo en hover.
        Posiciones x/y/w/h en %; calibrar abriendo la página con ?calibrar. %>
    <%
        // x/y/w/h = cuadro de HOVER (sobre la pastilla); hx/hy = CENTRO del corazón.
        const transferSpots = [
            { city: 'Ciudad 1', x: 52.0, y: 24.4, w: 28.1, h: 3.6, hx: 65.9, hy: 22.3 },
            { city: 'Ciudad 2', x: 18.8, y: 36.0, w: 28.0, h: 3.6, hx: 32.8, hy: 34.1 },
            { city: 'Ciudad 3', x: 37.1, y: 41.8, w: 19.9, h: 3.8, hx: 47.8, hy: 40.0 },
            { city: 'Ciudad 4', x: 15.1, y: 47.4, w: 27.5, h: 3.8, hx: 28.8, hy: 45.5 },
            { city: 'Ciudad 5', x: 45.6, y: 55.2, w: 27.9, h: 3.9, hx: 59.6, hy: 53.4 },
            { city: 'Ciudad 6', x: 49.1, y: 65.4, w: 28.5, h: 3.6, hx: 63.2, hy: 63.4 },
            { city: 'Ciudad 7', x: 30.4, y: 70.3, w: 28.1, h: 3.7, hx: 44.1, hy: 68.4 },
            { city: 'Ciudad 8', x: 53.0, y: 75.2, w: 27.9, h: 3.8, hx: 66.8, hy: 73.2 }
        ];
    %>
    <section class="transfers-map">
        <div class="transfers-map__stage" id="transfersStage">
            <img src="/images/map_transfers.jpg" alt="<%= t('pages:transporte.mapAlt') %>" class="transfers-map__img">
            <% transferSpots.forEach(function (spot, idx) { %>
                <div class="transfers-hotspot"
                     style="left: <%= spot.x %>%; top: <%= spot.y %>%; width: <%= spot.w %>%; height: <%= spot.h %>%;"
                     data-index="<%= idx + 1 %>" data-city="<%= spot.city %>"
                     role="button" tabindex="0" aria-label="<%= spot.city %>"></div>
            <% }); %>
            <% transferSpots.forEach(function (spot, idx) { %>
                <span class="transfers-heart"
                      style="left: <%= spot.hx %>%; top: <%= spot.hy %>%;"
                      data-index="<%= idx + 1 %>" aria-hidden="true"></span>
            <% }); %>
        </div>
    </section>

    <script>
    (function () {
        var stage = document.getElementById('transfersStage');
        if (!stage) return;
        var img = stage.querySelector('.transfers-map__img');
        var hotspots = Array.prototype.slice.call(stage.querySelectorAll('.transfers-hotspot'));
        var hearts = Array.prototype.slice.call(stage.querySelectorAll('.transfers-heart'));
        var calibrar = /[?&]calibrar/i.test(location.search);

        // ===== MODO NORMAL: hover del cuadro O del corazón enciende el corazón =====
        if (!calibrar) {
            hotspots.forEach(function (h, i) {
                var heart = hearts[i];
                if (!heart) return;
                // Contador para no apagar al cruzar el cursor entre cuadro y corazón.
                var count = 0;
                var on = function () { count++; heart.classList.add('is-on'); };
                var off = function () { count = Math.max(0, count - 1); if (!count) heart.classList.remove('is-on'); };
                h.addEventListener('mouseenter', on);
                h.addEventListener('mouseleave', off);
                h.addEventListener('focus', on);
                h.addEventListener('blur', off);
                heart.addEventListener('mouseenter', on);
                heart.addEventListener('mouseleave', off);
            });
            return;
        }

        // ===== MODO CALIBRACIÓN: cuadros (mover+resize) + corazones (mover) =====
        stage.classList.add('is-calibrating');
        var MIN = 2;

        var panel = document.createElement('div');
        panel.className = 'transfers-calib';
        panel.innerHTML =
            '<h4>Calibración — arrastra los CUADROS (azul) sobre la pastilla y los CORAZONES (rojo) sobre el corazón del mapa. Bordes/esquinas del cuadro = redimensionar.</h4>' +
            '<div class="transfers-calib-live">listo</div>' +
            '<div class="transfers-calib-list"></div>' +
            '<button type="button" data-act="copy">Copiar coordenadas</button>';
        document.body.appendChild(panel);
        var live = panel.querySelector('.transfers-calib-live');
        var list = panel.querySelector('.transfers-calib-list');

        var DIRS = ['n', 's', 'e', 'w', 'ne', 'nw', 'se', 'sw'];
        var action = null;

        function pct(e) {
            var t = e.touches && e.touches[0] ? e.touches[0] : e;
            var r = img.getBoundingClientRect();
            return { x: ((t.clientX - r.left) / r.width) * 100, y: ((t.clientY - r.top) / r.height) * 100 };
        }
        function rectOf(el, isHeart) {
            return {
                x: parseFloat(el.style.left) || 0,
                y: parseFloat(el.style.top) || 0,
                w: isHeart ? 0 : (parseFloat(el.style.width) || 0),
                h: isHeart ? 0 : (parseFloat(el.style.height) || 0)
            };
        }
        function lineFor(i) {
            var b = rectOf(hotspots[i], false), c = rectOf(hearts[i], true);
            return "{ city: '" + hotspots[i].dataset.city + "', x: " + b.x.toFixed(1) + ", y: " + b.y.toFixed(1) +
                ", w: " + b.w.toFixed(1) + ", h: " + b.h.toFixed(1) +
                ", hx: " + c.x.toFixed(1) + ", hy: " + c.y.toFixed(1) + " },";
        }
        function renderList() {
            var out = [];
            for (var i = 0; i < hotspots.length; i++) out.push((i + 1) + ": " + lineFor(i));
            list.textContent = out.join('\n');
        }

        function start(type, el, dir, isHeart, e) {
            e.preventDefault();
            var p = pct(e);
            action = { type: type, el: el, dir: dir, isHeart: isHeart, startX: p.x, startY: p.y, box: rectOf(el, isHeart) };
            hotspots.concat(hearts).forEach(function (x) { x.classList.remove('is-active-calib'); });
            el.classList.add('is-active-calib');
        }
        function move(e) {
            if (!action) return;
            e.preventDefault();
            var p = pct(e);
            var dx = p.x - action.startX, dy = p.y - action.startY;
            var b = action.box, nb = { x: b.x, y: b.y, w: b.w, h: b.h };
            if (action.type === 'move') {
                if (action.isHeart) {
                    nb.x = Math.max(0, Math.min(100, b.x + dx));
                    nb.y = Math.max(0, Math.min(100, b.y + dy));
                } else {
                    nb.x = Math.max(0, Math.min(100 - b.w, b.x + dx));
                    nb.y = Math.max(0, Math.min(100 - b.h, b.y + dy));
                }
            } else {
                var dir = action.dir;
                if (dir.indexOf('e') > -1) nb.w = Math.max(MIN, Math.min(100 - b.x, b.w + dx));
                if (dir.indexOf('s') > -1) nb.h = Math.max(MIN, Math.min(100 - b.y, b.h + dy));
                if (dir.indexOf('w') > -1) { var right = b.x + b.w; nb.x = Math.max(0, Math.min(right - MIN, b.x + dx)); nb.w = right - nb.x; }
                if (dir.indexOf('n') > -1) { var bottom = b.y + b.h; nb.y = Math.max(0, Math.min(bottom - MIN, b.y + dy)); nb.h = bottom - nb.y; }
            }
            action.el.style.left = nb.x + '%';
            action.el.style.top = nb.y + '%';
            if (!action.isHeart) { action.el.style.width = nb.w + '%'; action.el.style.height = nb.h + '%'; }
            live.textContent = action.isHeart
                ? ('corazón #' + (hearts.indexOf(action.el) + 1) + '  hx:' + nb.x.toFixed(1) + ' hy:' + nb.y.toFixed(1))
                : ('cuadro #' + (hotspots.indexOf(action.el) + 1) + '  x:' + nb.x.toFixed(1) + ' y:' + nb.y.toFixed(1) + ' w:' + nb.w.toFixed(1) + ' h:' + nb.h.toFixed(1));
            renderList();
        }
        function end() { action = null; }

        hotspots.forEach(function (h) {
            DIRS.forEach(function (dir) {
                var handle = document.createElement('span');
                handle.className = 'transfers-handle transfers-handle--' + dir;
                handle.addEventListener('mousedown', function (e) { e.stopPropagation(); start('resize', h, dir, false, e); });
                handle.addEventListener('touchstart', function (e) { e.stopPropagation(); start('resize', h, dir, false, e); }, { passive: false });
                h.appendChild(handle);
            });
            h.addEventListener('mousedown', function (e) { start('move', h, null, false, e); });
            h.addEventListener('touchstart', function (e) { start('move', h, null, false, e); }, { passive: false });
        });
        hearts.forEach(function (heart) {
            heart.addEventListener('mousedown', function (e) { e.stopPropagation(); start('move', heart, null, true, e); });
            heart.addEventListener('touchstart', function (e) { e.stopPropagation(); start('move', heart, null, true, e); }, { passive: false });
        });

        document.addEventListener('mousemove', move);
        document.addEventListener('touchmove', move, { passive: false });
        document.addEventListener('mouseup', end);
        document.addEventListener('touchend', end);

        panel.querySelector('[data-act="copy"]').addEventListener('click', function () {
            var out = [];
            for (var i = 0; i < hotspots.length; i++) out.push(lineFor(i));
            if (navigator.clipboard) {
                navigator.clipboard.writeText(out.join('\n')).then(function () {
                    live.textContent = '¡Copiado! Pégamelo en el chat ✓';
                }, function () { live.textContent = 'No se pudo copiar; copia manual del recuadro'; });
            }
        });

        renderList();
    })();
    </script>

