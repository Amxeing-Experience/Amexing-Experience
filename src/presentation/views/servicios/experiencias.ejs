<%#
Experiencias (subpágina de Servicios).
Usa el organismo compartido `categories-section` (mismo diseño que Tours).

Created by Denisse Maldonado
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="icon" type="image/png" href="/images/heart_black.png">

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background: #eff0ec;
            color: #333;
            padding-top: 80px; /* navbar fijo */
        }
    </style>
</head>
<body>
    <%# Navigation %>
    <%- include('../organisms/landing/landing-navigation', {
        user: typeof user !== 'undefined' ? user : null,
        currentPage: typeof currentPage !== 'undefined' ? currentPage : 'services',
        transparent: false,
        companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null,
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Sección interactiva específica de Experiencias — cards reales por categoría %>
    <%- include('../organisms/servicios/experiences-categories-section', {
        t: typeof t !== 'undefined' ? t : ((key) => key),
        pageTitle: t('pages:experiencias.title'),
        intro: t('pages:experiencias.intro'),
        categories: [
            { label: t('pages:categories.catas'), img: '/images/7.png', value: 'catas' },
            { label: t('pages:categories.arte'), img: '/images/4.png', value: 'arte' },
            { label: t('pages:categories.historiaArquitectura'), img: '/images/3.png', value: 'historia_arquitectura' },
            { label: t('pages:categories.gastronomicas'), img: '/images/6.png', value: 'gastronomicas' },
            { label: t('pages:categories.aventura'), img: '/images/5.png', value: 'aventura' },
            { label: t('pages:categories.naturaleza'), img: '/images/2.png', value: 'naturaleza' },
            { label: t('pages:categories.deTemporada'), img: '/images/1.png', value: 'de_temporada' }
        ],
        experiencesByCategory: typeof experiencesByCategory !== 'undefined' ? experiencesByCategory : {}
    }) %>

    <%# CTA Contacto (reutilizable) %>
    <%- include('../organisms/landing/cta-contacto-section', {
        t: typeof t !== 'undefined' ? t : ((key) => key)
    }) %>

    <%# Footer %>
    <%- include('../organisms/landing/landing-footer', {
        companyInfo: typeof company !== 'undefined' ? company : null,
        req: typeof req !== 'undefined' ? req : null
    }) %>
</body>
</html>
