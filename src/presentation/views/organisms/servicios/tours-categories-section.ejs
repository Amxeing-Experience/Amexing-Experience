<%#
Sección interactiva de TOURS (copia adaptada de experiences-categories-section.ejs).
Mismo diseño; los detail cards muestran los TOURS reales agrupados por su DESTINO (POI).
Al hacer clic en un chip de destino, se re-renderizan los cards de ese destino desde la
data embebida (JSON).

NO modificar categories-section.ejs ni experiences-categories-section.ejs; esta es
exclusiva de Tours.

Parámetros:
  @param {string} pageTitle       - Texto del banner verde (ej. "Tours")
  @param {string} intro           - Párrafo introductorio
  @param {array}  categories      - [{ label, img, value }] para el acordeón horizontal
  @param {object} toursByDestino  - { <poiId>: [ { title, img, bookHref, items: [{label, value, block}] }, ... ] }

Created by Denisse Maldonado
%>
<%
    // Defaults defensivos (las páginas pasan su propia data)
    var _t = (typeof t === 'function') ? t : function (k) { return k; };
    var _pageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'Tours';
    var _intro = (typeof intro !== 'undefined' && intro) ? intro
        : 'Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud.';
    var _categories = (typeof categories !== 'undefined' && Array.isArray(categories) && categories.length) ? categories : [
        { label: 'Catas', img: '/images/7.png', value: '' },
        { label: 'Arte', img: '/images/4.png', value: '' },
        { label: 'Historia y Arquitectura', img: '/images/3.png', value: '' },
        { label: 'Gastronómicas', img: '/images/6.png', value: '' },
        { label: 'Aventura', img: '/images/5.png', value: '' },
        { label: 'Naturaleza', img: '/images/2.png', value: '' },
        { label: 'De Temporada', img: '/images/1.png', value: '' }
    ];
    // Data real agrupada por destino; la vista cae a estado vacío si no hay cards.
    var _byCat = (typeof toursByDestino !== 'undefined' && toursByDestino) ? toursByDestino : {};
    var _activeValue = (_categories[0] && _categories[0].value) || '';
    var _activeCards = _byCat[_activeValue] || [];
    var _emptyText = 'No hay tours en este destino todavía.';
%>

<style>
    /* ---- Header (banner verde + corazones y líneas a los lados) ---- */
    .exp-hero {
        background: #eff0ec;
        text-align: center;
        padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2.5rem, 6vw, 4.5rem);
    }

    .exp-hero__header {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .exp-hero__line {
        flex: 1 1 auto;
        height: 1px;
        background: #9a9b8c;
    }

    .exp-hero__heart {
        flex: 0 0 auto;
        width: clamp(46px, 5vw, 70px);
        height: auto;
        display: block;
    }

    .exp-hero__banner {
        flex: 0 0 auto;
        background: #969b81;
        padding: clamp(0.4rem, 1.3vw, 0.9rem) clamp(4.5rem, 13vw, 11rem);
        margin: 0 clamp(1.8rem, 4vw, 3.5rem);
    }

    .exp-hero__title {
        font-family: var(--font-newsreader), serif;
        font-variant: small-caps;
        font-feature-settings: "smcp";
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 400;
        letter-spacing: 0.05em;
        color: #ffffff;
        margin: 0;
        line-height: 1;
        white-space: nowrap;
    }

    .exp-hero__intro {
        font-family: var(--font-myriad), 'Montserrat', sans-serif;
        font-weight: 300;
        font-size: clamp(1rem, 1.6vw, 1.25rem);
        line-height: 1.7;
        color: #4a4a44;
        max-width: 660px;
        margin: clamp(1.8rem, 4vw, 2.8rem) auto 0;
        padding: 0 clamp(0.75rem, 1.5vw, 1.25rem);
        box-sizing: border-box;
    }

    @media (max-width: 640px) {
        .exp-hero__banner {
            padding: 0.8rem 1.6rem;
            margin: 0 0.8rem;
        }
        .exp-hero__heart {
            width: 38px;
        }
    }

    /* ---- Categorías interactivas (acordeón horizontal) ---- */
    .exp-cats {
        --rail: clamp(1.6rem, 3vw, 2.6rem); /* espacio arriba donde la línea sobresale */
        display: flex;
        height: clamp(360px, 42vw, 470px);
        background: #eff0ec;
        padding: 0 clamp(2rem, 9vw, 7rem);
        box-sizing: border-box;
    }

    .exp-cat {
        flex: 1;
        position: relative;
        cursor: pointer;
        border-right: 2px solid #c4c4bb;
        outline: none;
    }

    .exp-cat:first-child {
        border-left: 2px solid #c4c4bb;
    }

    .exp-cat__image {
        position: absolute;
        top: var(--rail);
        left: 0;
        right: 0;
        height: 42%;
        background-size: cover;
        background-position: center;
        transition: height 0.45s ease;
    }

    .exp-cat__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom,
            rgba(0, 0, 0, 0) 20%,
            rgba(0, 0, 0, 0.9) 58%,
            rgba(0, 0, 0, 0.9) 72%,
            rgba(239, 240, 236, 1) 100%);
        opacity: 0;
        transition: opacity 0.45s ease;
    }

    .exp-cat__label {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(var(--rail) + 42%);
        bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.4rem 0.5rem;
        transition: opacity 0.3s ease;
    }

    .exp-cat__label span {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        max-height: 100%;
        font-family: var(--font-newsreader), serif;
        font-variant: small-caps;
        font-feature-settings: "smcp";
        font-size: clamp(1.1rem, 1.6vw, 1.5rem);
        letter-spacing: 0.18em;
        color: #6e6e64;
        text-align: center;
        line-height: 1.35;
    }

    /* estado activo: la imagen llena el panel (desde el riel) + degradado oscuro, sin label */
    .exp-cat.is-active .exp-cat__image {
        height: calc(100% - var(--rail));
    }

    .exp-cat.is-active .exp-cat__overlay {
        opacity: 1;
    }

    .exp-cat.is-active .exp-cat__label {
        opacity: 0;
    }

    /* ---- Nombre de la categoría seleccionada ---- */
    .exp-selected {
        background: #eff0ec;
        padding: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 15vw, 12rem) clamp(2.5rem, 6vw, 4.5rem);
        text-align: center;
    }

    .exp-selected__rule {
        display: block;
        height: 5px; /* separación entre las dos líneas */
        border-top: 1px solid #9a9b8c;
        border-bottom: 1px solid #9a9b8c;
    }

    .exp-selected__name {
        font-family: var(--font-newsreader), serif;
        font-variant: small-caps;
        font-feature-settings: "smcp";
        font-size: clamp(1.5rem, 3.2vw, 2.5rem);
        font-weight: 400;
        letter-spacing: 0.1em;
        color: #3a3a38;
        margin: clamp(1rem, 2.4vw, 1.7rem) 0;
        line-height: 1;
    }

    /* ---- Celda de detalle ---- */
    .exp-detail {
        background: #eff0ec;
        padding: 0 clamp(3rem, 15vw, 12rem) clamp(6rem, 14vw, 12rem);
    }

    .exp-detail__card {
        background: #2e2e2d;
        padding: clamp(1.0rem, 3.5vw, 1.2rem);
    }

    .exp-detail__card:not(:last-child) {
        margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    }

    .exp-detail__title {
        font-family: var(--font-arpona), serif;
        font-variant: small-caps;
        font-feature-settings: "smcp";
        font-size: clamp(1.5rem, 3.5vw, 2.8rem);
        font-weight: 400;
        color: #ffffff;
        text-align: center;
        letter-spacing: 0.06em;
        margin: 0 0 clamp(0.7rem, 1.6vw, 1.2rem);
    }

    .exp-detail__grid {
        display: grid;
        grid-template-columns: 1.9fr 1fr;
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: stretch;
    }

    .exp-detail__image {
        width: 100%;
        min-height: clamp(230px, 28vw, 400px);
        background-size: cover;
        background-position: center;
    }

    .exp-detail__info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-right: 1em;
    }

    .exp-detail__item {
        font-family: var(--font-myriad), 'Montserrat', sans-serif;
        font-size: clamp(0.95rem, 1.2vw, 1.1rem);
        color: #d8d8d2;
        line-height: 1.2;
        padding: clamp(0.85rem, 1.7vw, 1.25rem) 0;
        border-bottom: 2px solid rgba(255, 255, 255, 0.28);
    }

    .exp-detail__item:first-child {
        padding-top: 0;
    }

    .exp-detail__item strong {
        color: #ffffff;
        font-weight: 700;
    }

    .exp-detail__empty {
        font-family: var(--font-myriad), 'Montserrat', sans-serif;
        font-size: clamp(1rem, 1.4vw, 1.2rem);
        color: #ffffff;
        text-align: center;
        margin: 0;
    }

    .exp-detail__book {
        display: inline-block;
        align-self: center;
        margin-top: clamp(1.5rem, 3vw, 2.5rem);
        text-align: center;
        background: #ffffff;
        color: #969b81;
        border: 1px solid rgba(255, 255, 255, 0.6);
        padding: 0.85rem 2.5rem;
        font-family: var(--font-myriad), 'Montserrat', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.3s ease, color 0.3s ease;
    }

    .exp-detail__book:hover {
        background: transparent;
        color: #ffffff;
    }

    @media (max-width: 768px) {
        .exp-detail__grid {
            grid-template-columns: 1fr;
        }
        .exp-detail__book {
            margin-top: 1.5rem;
        }
        .exp-cats {
            height: clamp(280px, 60vw, 380px);
        }
        .exp-cat__label span {
            font-size: 0.8rem;
            letter-spacing: 0.1em;
        }
    }
</style>

<%# Header: banner verde con corazones y líneas a los lados %>
<section class="exp-hero">
    <div class="exp-hero__header">
        <span class="exp-hero__line"></span>
        <img src="/images/heart_black.png" alt="" class="exp-hero__heart" aria-hidden="true">
        <div class="exp-hero__banner">
            <h1 class="exp-hero__title"><%= _pageTitle %></h1>
        </div>
        <img src="/images/heart_black.png" alt="" class="exp-hero__heart" aria-hidden="true">
        <span class="exp-hero__line"></span>
    </div>

    <p class="exp-hero__intro"><%= _intro %></p>
</section>

<%# Categorías interactivas (acordeón horizontal) %>
<section class="exp-cats" id="expCats">
    <% _categories.forEach(function(cat, i) { %>
        <div class="exp-cat <%= i === 0 ? 'is-active' : '' %>" data-index="<%= i %>" data-destino="<%= cat.value || '' %>" role="button" tabindex="0" aria-label="<%= cat.label %>">
            <div class="exp-cat__image" style="background-image: url('<%= cat.img %>')">
                <span class="exp-cat__overlay" aria-hidden="true"></span>
            </div>
            <div class="exp-cat__label"><span><%= cat.label %></span></div>
        </div>
    <% }); %>
</section>

<%# Nombre del destino seleccionado (se actualiza al elegir/hover) %>
<div class="exp-selected">
    <span class="exp-selected__rule" aria-hidden="true"></span>
    <h3 class="exp-selected__name" id="expSelectedName"><%= _categories[0].label %></h3>
    <span class="exp-selected__rule" aria-hidden="true"></span>
</div>

<%# Celda de detalle: cards reales del destino ACTIVO (el primero) %>
<section class="exp-detail">
    <% if (_activeCards.length) { %>
        <% _activeCards.forEach(function(card) { %>
            <div class="exp-detail__card">
                <h2 class="exp-detail__title"><%= card.title %></h2>
                <div class="exp-detail__grid">
                    <div class="exp-detail__image" style="background-image: url('<%= card.img %>')" role="img" aria-label="<%= card.title %>"></div>
                    <div class="exp-detail__info">
                        <% (card.items || []).forEach(function(it) { %>
                            <div class="exp-detail__item"><strong><%= it.label %></strong><% if (it.block) { %><br><%= it.value %><% } else { %> <%= it.value %><% } %></div>
                        <% }); %>
                        <a href="<%= card.bookHref || '/contacto#book' %>" class="exp-detail__book"><%= _t('pages:categoryDetail.bookNow') %></a>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="exp-detail__card">
            <p class="exp-detail__empty"><%= _emptyText %></p>
        </div>
    <% } %>
</section>

<%# Data completa agrupada por destino para el switch en cliente %>
<script type="application/json" id="tours-by-destino"><%- JSON.stringify(_byCat) %></script>

<script>
(function () {
    var section = document.getElementById('expCats');
    if (!section) return;
    var cats = section.querySelectorAll('.exp-cat');
    var selectedName = document.getElementById('expSelectedName');
    var detail = document.querySelector('.exp-detail');
    var selected = cats[0]; // destino seleccionado (cambia solo con clic)

    // Etiqueta "Book now" reusable: la tomamos del primer card server-rendered, o fallback.
    var firstBook = detail ? detail.querySelector('.exp-detail__book') : null;
    var bookLabel = (firstBook && firstBook.textContent) ? firstBook.textContent : 'Book now';
    var emptyText = 'No hay tours en este destino todavía.';

    // Data agrupada por destino (embebida como JSON).
    var byCat = {};
    try {
        var dataEl = document.getElementById('tours-by-destino');
        if (dataEl) byCat = JSON.parse(dataEl.textContent || '{}') || {};
    } catch (e) { byCat = {}; }

    function esc(str) {
        var div = document.createElement('div');
        div.textContent = (str == null) ? '' : String(str);
        return div.innerHTML;
    }

    // Construye el markup de un card (espejo del render EJS) usando textContent seguro.
    function buildCard(card) {
        var itemsHtml = (card.items || []).map(function (it) {
            var label = '<strong>' + esc(it.label) + '</strong>';
            var value = it.block ? ('<br>' + esc(it.value)) : (' ' + esc(it.value));
            return '<div class="exp-detail__item">' + label + value + '</div>';
        }).join('');
        var href = card.bookHref || '/contacto#book';
        var img = card.img || '';
        return '' +
            '<div class="exp-detail__card">' +
                '<h2 class="exp-detail__title">' + esc(card.title) + '</h2>' +
                '<div class="exp-detail__grid">' +
                    '<div class="exp-detail__image" style="background-image: url(\'' + esc(img) + '\')" role="img" aria-label="' + esc(card.title) + '"></div>' +
                    '<div class="exp-detail__info">' +
                        itemsHtml +
                        '<a href="' + esc(href) + '" class="exp-detail__book">' + esc(bookLabel) + '</a>' +
                    '</div>' +
                '</div>' +
            '</div>';
    }

    // Re-renderiza la sección de detalle con los cards del destino dado.
    function renderCategory(value) {
        if (!detail) return;
        var cards = (byCat && byCat[value]) ? byCat[value] : [];
        if (!cards.length) {
            detail.innerHTML = '<div class="exp-detail__card"><p class="exp-detail__empty">' + esc(emptyText) + '</p></div>';
            return;
        }
        detail.innerHTML = cards.map(buildCard).join('');
    }

    // Expansión visual del panel (hover): NO cambia el nombre ni los cards
    function setActive(el) {
        cats.forEach(function (c) { c.classList.remove('is-active'); });
        el.classList.add('is-active');
    }

    // Clic: selecciona el destino, actualiza el nombre y re-renderiza los cards
    function select(el) {
        selected = el;
        setActive(el);
        if (selectedName) selectedName.textContent = el.getAttribute('aria-label');
        renderCategory(el.getAttribute('data-destino'));
    }

    cats.forEach(function (cat) {
        cat.addEventListener('mouseenter', function () { setActive(cat); });
        cat.addEventListener('focus', function () { setActive(cat); });
        cat.addEventListener('click', function () { select(cat); });
    });

    // Al salir de la sección, regresa al destino seleccionado (no al hover)
    section.addEventListener('mouseleave', function () { setActive(selected); });
})();
</script>
