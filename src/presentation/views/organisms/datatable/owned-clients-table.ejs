<%
/**
 * Owned Clients DataTable Organism
 * Advanced DataTable component for hierarchical client management
 * Allows department_manager and client roles to manage their own clients
 * Created by Denisse Maldonado
 *
 * Atomic Design Level: Organism
 * Category: Dashboard Data Tables
 *
 * @param {string} tableId - Unique table identifier (default: 'owned-clients-table')
 * @param {string} apiEndpoint - API endpoint for data loading (default: '/api/owned-clients')
 * @param {string} userRole - Current user role for permission-based features
 * @param {boolean} showActions - Whether to show action buttons (default: true)
 */

// Component Configuration
const dtTableId = typeof tableId !== 'undefined' ? tableId : 'owned-clients-table';
const dtApiEndpoint = typeof apiEndpoint !== 'undefined' ? apiEndpoint : '/api/owned-clients';
const dtShowActions = typeof showActions !== 'undefined' ? showActions : true;
const dtUserRole = typeof userRole !== 'undefined' ? userRole : 'client';

// All users with this view can manage their own clients
const canEdit = true;
const canDelete = true;
const canCreate = true;
%>

<style>
/* Rediseño limpio (sin card blanca), consistente con traslados. Solo UI: se conservan
   los ids/hooks del DataTable y las acciones. */
.exp-catalog {
    --exp-border: #d6d1c4; --exp-olive: #6E7A50; --exp-muted: #8a8f78; --exp-dark: #2b2b2b;
}
.clients-table-wrap .table { margin-bottom: 0; }
.clients-table-wrap .table > thead.table-light th {
    background: rgba(228, 223, 207, 0.35);
    border-bottom: 1px solid var(--exp-border);
    color: var(--exp-muted);
    font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600;
}
/* Botón "Nuevo Cliente" (va en el header de página, fuera del scope .exp-catalog → hex) */
.clientes-new-btn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #6E7A50; background: #6E7A50; color: #fff; border-radius: 8px; font-size: 0.82rem; font-weight: 600; padding: 9px 16px; cursor: pointer; transition: all 0.15s; white-space: nowrap; }
.clientes-new-btn:hover { background: #7C8A5A; border-color: #7C8A5A; color: #fff; }
</style>

<div class="exp-catalog clients-table-wrap">
    <!-- Tabla de clientes (sin card blanca) -->
    <div class="table-responsive">
        <table id="<%= dtTableId %>" class="table table-hover data-table" style="width:100%">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Contacto</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Registro</th>
                    <% if (dtShowActions) { %>
                        <th>Acciones</th>
                    <% } %>
                </tr>
            </thead>
            <tbody>
                <!-- Data will be loaded via JavaScript -->
            </tbody>
        </table>
    </div>
</div>

<!-- DataTable Configuration and Initialization Script -->
<script>
/**
 * Owned Clients DataTable JavaScript Module
 */

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', function() {
    initializeOwnedClientsDataTable();
    
    // Add event delegation for dynamically created buttons to avoid CSP violations
    const tableContainer = document.getElementById('<%= dtTableId %>');
    if (tableContainer) {
        // Delegate click events for edit buttons
        tableContainer.addEventListener('click', function(e) {
            const deleteBtn = e.target.closest('.btn-delete-client');
            if (deleteBtn) {
                const clientId = deleteBtn.getAttribute('data-client-id');
                const clientName = deleteBtn.getAttribute('data-client-name');
                if (typeof deleteClient === 'function') {
                    deleteClient(clientId, clientName);
                }
            }
        });
    }
});

/**
 * Initialize DataTable for owned clients
 */
function initializeOwnedClientsDataTable() {
    // Destroy existing table if it exists
    if (window.ownedClientsTable) {
        window.ownedClientsTable.destroy();
    }

    // Initialize DataTable with server-side processing
    window.ownedClientsTable = $('#<%= dtTableId %>').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: '<%= dtApiEndpoint %>',
            type: 'GET',
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            },
            data: function(d) {
                // Map DataTables parameters to API parameters
                return {
                    page: Math.floor(d.start / d.length) + 1,
                    limit: d.length,
                    search: d.search.value,
                    sortField: d.columns[d.order[0]?.column]?.data,
                    sortDirection: d.order[0]?.dir
                };
            },
            dataSrc: function(json) {
                // Update total count display
                if (json.pagination && document.getElementById('total-clients-count')) {
                    document.getElementById('total-clients-count').textContent = json.pagination.total;
                }
                
                // Map response to DataTables format
                json.recordsTotal = json.pagination?.total || 0;
                json.recordsFiltered = json.pagination?.total || 0;
                
                return json.data || [];
            },
            error: function(xhr, error, thrown) {
                console.error('DataTable AJAX error:', error, thrown);
                showErrorAlert('Error al cargar los clientes: ' + (xhr.responseJSON?.error || error));
            }
        },
        columns: [
            { 
                data: 'name',
                render: function(data, type, row) {
                    return `<strong>${data || 'Sin nombre'}</strong>`;
                }
            },
            { 
                data: 'email',
                render: function(data) {
                    return data || '<span class="text-muted">Sin email</span>';
                }
            },
            { 
                data: 'phone',
                render: function(data) {
                    return data || '<span class="text-muted">-</span>';
                }
            },
            { 
                data: 'contactPerson',
                render: function(data) {
                    return data || '<span class="text-muted">-</span>';
                }
            },
            { 
                data: 'companyType',
                render: function(data) {
                    const types = {
                        'individual': '<span class="badge bg-info">Persona Física</span>',
                        'corporate': '<span class="badge bg-primary">Persona Moral</span>',
                        'travel_agency': '<span class="badge bg-success">Agencia de Viajes</span>',
                        'tour_operator': '<span class="badge bg-warning">Tour Operador</span>',
                        'other': '<span class="badge bg-secondary">Otro</span>'
                    };
                    return types[data] || '<span class="badge bg-secondary">-</span>';
                }
            },
            { 
                data: 'active',
                render: function(data) {
                    return data ? 
                        '<span class="badge bg-success">Activo</span>' : 
                        '<span class="badge bg-danger">Inactivo</span>';
                }
            },
            {
                data: 'createdAt',
                render: function(data) {
                    if (!data) return '-';
                    const date = new Date(data);
                    return date.toLocaleDateString('es-MX', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                }
            },
            <% if (dtShowActions) { %>
            {
                data: null,
                orderable: false,
                render: function(data, type, row) {
                    let actions = '<div class="btn-group btn-group-sm" role="group">';

                    actions += `
                        <a href="/dashboard/<%= dtUserRole %>/clients/${row.id}" class="btn btn-outline-info"
                           title="Ver / Editar">
                            <i class="ti ti-edit"></i>
                        </a>`;
                    
                    actions += `
                        <button type="button" class="btn btn-outline-danger btn-delete-client" 
                                data-client-id="${row.id}"
                                data-client-name="${(row.name || '').replace(/"/g, '&quot;')}"
                                title="Eliminar">
                            <i class="ti ti-trash"></i>
                        </button>`;
                    
                    actions += '</div>';
                    return actions;
                }
            }
            <% } %>
        ],
        order: [[6, 'desc']], // Order by creation date descending
        language: {
            processing: "Procesando...",
            search: "Buscar:",
            lengthMenu: "Mostrar _MENU_ registros",
            info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
            infoEmpty: "Mostrando 0 a 0 de 0 registros",
            infoFiltered: "(filtrado de _MAX_ registros totales)",
            loadingRecords: "Cargando...",
            zeroRecords: "No se encontraron resultados",
            emptyTable: "No hay datos disponibles",
            paginate: {
                first: "Primero",
                last: "Último",
                next: "Siguiente",
                previous: "Anterior"
            }
        },
        responsive: true,
        autoWidth: false,
        pageLength: 25,
        lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
        dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip'
    });
}

/**
 * Show error alert
 * @param {string} message - Error message to display
 */
function showErrorAlert(message) {
    const alertHtml = `
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="ti ti-alert-circle me-2"></i>
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    `;
    
    // Insert alert at the top of the contenedor (rediseño limpio: .exp-catalog)
    const cardBody = document.querySelector('#<%= dtTableId %>').closest('.exp-catalog');
    if (cardBody) {
        cardBody.insertAdjacentHTML('afterbegin', alertHtml);
    }
}
</script>