<%
/**
 * Reservations table (organism) — shared across admin / client / department_manager.
 * Contains the filters, DataTable and scripts. The page header lives in each role view.
 *
 * Params (locals):
 *   - basePath {string} REQUIRED — role segment for links: 'admin' | 'client' | 'department_manager'.
 *   - showAgencyClientFilter {boolean} — show the agency/client filter (admin only; /api/clients/mixed is admin-only).
 *   - canManageReservations {boolean} — true → "Editar reservación" (quote w/ ?context); false → "Ver cotización".
 *
 * @author Denisse Maldonado
 * @version 1.0.0
 */
const basePath = (locals && locals.basePath) ? locals.basePath : 'admin';
const showAgencyClientFilter = !!(locals && locals.showAgencyClientFilter);
const canManageReservations = !!(locals && locals.canManageReservations);
%>

<style>
    /* Loader overlay for the reservations datatable while filters reload data */
    .reservations-loading-overlay {
        position: absolute;
        inset: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(1px);
        border-radius: 0.5rem;
    }
    /* Contador del pill "Pendientes de completar": badge ámbar INLINE (junto al texto) */
    .pending-completion-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        margin-left: 6px;
        background: #b8894a;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        border-radius: 10px;
        vertical-align: middle;
    }
    /* ===== Rediseño limpio (sin card blanca), consistente con traslados/clientes ===== */
    .exp-catalog { --exp-border: #d6d1c4; --exp-olive: #6E7A50; --exp-olive-light: #7C8A5A; --exp-muted: #8a8f78; --exp-dark: #2b2b2b; }
    /* Filtro de fecha (btn-check radios) al look segmentado */
    .exp-catalog .btn-group > .btn-check + .btn.btn-outline-primary {
        border: 1px solid var(--exp-border);
        color: var(--exp-dark);
        background: rgba(255, 255, 255, 0.4);
        font-size: 0.85rem; letter-spacing: 0.02em; font-weight: 600;
        padding: 9px 15px;
    }
    .exp-catalog .btn-group > .btn-check + .btn.btn-outline-primary:hover { background: rgba(110, 122, 80, 0.08); color: var(--exp-dark); }
    .exp-catalog .btn-group > .btn-check:checked + .btn.btn-outline-primary { background: var(--exp-olive); border-color: var(--exp-olive); color: #fff; }
    /* Selects Año/Mes/Día estilo catálogo */
    .exp-catalog .form-select-sm { border: 1px solid var(--exp-border); background: rgba(255, 255, 255, 0.45); color: var(--exp-dark); border-radius: 6px; }
    .exp-catalog .form-select-sm:focus { border-color: var(--exp-olive); background: #fff; box-shadow: none; }
    /* thead sobrio (crema/versalita) */
    .exp-catalog .table > thead.table-light th { background: rgba(228, 223, 207, 0.35); border-bottom: 1px solid var(--exp-border); color: var(--exp-muted); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; vertical-align: middle; }
    /* Barra de filtros: fecha (izq) · Año/Mes/Día (der) */
    /* Toda la barra en UNA sola fila: pills (izq) + Año/Mes/Día (der). No envuelve;
       si en una ventana muy angosta no cabe, hace scroll horizontal en vez de bajar. */
    .reservations-filters { display: flex; justify-content: space-between; align-items: center; gap: 12px 16px; flex-wrap: nowrap; overflow-x: auto; margin-bottom: 18px; }
    /* Los pills de fecha se mantienen en una sola fila (no se parten con el badge). */
    .reservations-filters .btn-group { flex-wrap: nowrap; flex-shrink: 0; }
    .reservations-filters .btn-group > .btn { white-space: nowrap; }
    .reservations-filters .date-selects { display: flex; align-items: center; gap: 14px; flex-wrap: nowrap; flex-shrink: 0; }
    .reservations-filters .date-sel { display: inline-flex; align-items: center; gap: 8px; }
    .reservations-filters .date-sel .seglabel { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--exp-muted); font-weight: 600; }
    .reservations-filters .date-sel .form-select-sm { min-width: 84px; font-size: 0.85rem; }
    .reservations-filters .info-icon { color: var(--exp-olive); cursor: pointer; font-size: 1.1rem; }
</style>

<!-- Page Content -->
<div class="page-content">
    <div class="row">
        <div class="col-12">
            <div class="exp-catalog reservations-wrap">
                <div class="reservations-body">
                    <!-- Date Filter Pills and Date Selectors -->
                    <!-- Barra de filtros: fecha (izquierda) · Año/Mes/Día (derecha) -->
                    <div class="reservations-filters">
                        <div class="btn-group" role="group" aria-label="Filtro por fecha de reservaciones">
                            <input type="radio" class="btn-check" name="dateFilter" id="filterPendingCompletion" value="pending_completion">
                            <label class="btn btn-outline-primary position-relative" for="filterPendingCompletion">
                                <i class="ti ti-alert-triangle me-1"></i>Pendientes de completar
                                <span id="pendingCompletionCounter" class="pending-completion-badge d-none">0</span>
                            </label>
                            <input type="radio" class="btn-check" name="dateFilter" id="filterUpcoming" value="upcoming" checked>
                            <label class="btn btn-outline-primary" for="filterUpcoming">
                                <i class="ti ti-calendar-plus me-1"></i>Próximas
                            </label>
                            <input type="radio" class="btn-check" name="dateFilter" id="filterOngoing" value="ongoing">
                            <label class="btn btn-outline-primary" for="filterOngoing">
                                <i class="ti ti-calendar-event me-1"></i>En curso
                            </label>
                            <input type="radio" class="btn-check" name="dateFilter" id="filterPast" value="past">
                            <label class="btn btn-outline-primary" for="filterPast">
                                <i class="ti ti-calendar-time me-1"></i>Pasadas
                            </label>
                            <input type="radio" class="btn-check" name="dateFilter" id="filterCancelled" value="cancelled">
                            <label class="btn btn-outline-primary" for="filterCancelled">
                                <i class="ti ti-calendar-off me-1"></i>Canceladas
                            </label>
                        </div>

                        <div class="date-selects">
                            <span class="date-sel">
                                <span class="seglabel">Año</span>
                                <select class="form-select form-select-sm" id="yearFilter" aria-label="Año"></select>
                            </span>
                            <span class="date-sel">
                                <span class="seglabel">Mes</span>
                                <select class="form-select form-select-sm" id="monthFilter" aria-label="Mes">
                                    <option value="">Todos</option>
                                    <option value="1">Enero</option>
                                    <option value="2">Febrero</option>
                                    <option value="3">Marzo</option>
                                    <option value="4">Abril</option>
                                    <option value="5">Mayo</option>
                                    <option value="6">Junio</option>
                                    <option value="7">Julio</option>
                                    <option value="8">Agosto</option>
                                    <option value="9">Septiembre</option>
                                    <option value="10">Octubre</option>
                                    <option value="11">Noviembre</option>
                                    <option value="12">Diciembre</option>
                                </select>
                            </span>
                            <span class="date-sel">
                                <span class="seglabel">Día</span>
                                <select class="form-select form-select-sm" id="dayFilter" aria-label="Día">
                                    <option value="">Todos</option>
                                </select>
                            </span>
                                    <i class="ti ti-info-circle info-icon"
                                       role="button"
                                       tabindex="0"
                                       aria-label="Cómo funcionan los filtros de fecha"
                                       data-bs-toggle="popover"
                                       data-bs-html="true"
                                       data-bs-trigger="hover focus"
                                       data-bs-placement="bottom"
                                       data-bs-title="¿Cómo funcionan los filtros?"
                                       data-bs-content="<strong>Pendientes de completar:</strong> reservaciones con la cotización bloqueada (faltan datos). No usan fecha.<br><br>Los demás filtros usan el rango de fechas de los servicios (inicio y fin):<br><strong>Próximas:</strong> aún no inicia.<br><strong>En curso:</strong> ya inició y no ha terminado.<br><strong>Pasadas:</strong> ya terminó.<br><br>El Año/Mes/Día acota a ese periodo: se muestra si la reservación tiene un servicio en la fecha seleccionada."></i>
                        </div>
                    </div>

                    <% if (showAgencyClientFilter) { %>
                    <!-- Filtro genérico por Agencia / Cliente (solo admin) -->
                    <div class="mb-3">
                        <%- include('../../molecules/filters/client-agency-filter', { idPrefix: 'reservations' }) %>
                    </div>
                    <% } %>

                    <div class="position-relative">
                        <!-- Loader overlay shown while filters reload the table -->
                        <div id="reservations-loading" class="reservations-loading-overlay d-none">
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                                <div class="mt-2 text-primary fw-semibold">Cargando...</div>
                            </div>
                        </div>
                        <div class="table-responsive">
                        <table id="reservations-table" class="table table-hover" style="width:100%">
                            <thead class="table-light">
                                <tr>
                                    <th>Folio</th>
                                    <th>Cliente</th>
                                    <th>Propietario</th>
                                    <th>Motivo de Viaje</th>
                                    <th>Cliente Final</th>
                                    <th>Persona de Contacto</th>
                                    <th class="text-center">Fecha Inicio</th>
                                    <th class="text-center">Personas</th>
                                    <th class="text-center">Servicios</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Última Modificación</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sophisticated cancel modal will be dynamically created by shared JavaScript utilities -->

<!-- Generate Receipt Modal (opera sobre la cotización agendada de la reservación) -->
<div class="modal fade" id="generateReceiptModal" tabindex="-1" aria-labelledby="generateReceiptModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title text-white" id="generateReceiptModalLabel">
                    <i class="ti ti-receipt me-2"></i>Generar Recibo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Desea generar el recibo para la reservación <strong id="receiptQuoteFolio"></strong>?</p>
                <!-- "Método de Pago a Incluir" oculto por ahora: el recibo actual no imprime
                     datos de pago. (El JS que lo cargaba hace no-op si el select no existe.) -->
                <!-- Perfil de Facturación (datos fiscales de la agencia) — para los 3 roles -->
                <div class="mb-3">
                    <label for="billingProfileSelect" class="form-label">
                        <strong>Perfil de Facturación</strong>
                        <span id="billingProfileSpinner" class="spinner-border spinner-border-sm text-secondary ms-2 d-none" role="status" aria-hidden="true"></span>
                    </label>
                    <select class="form-select" id="billingProfileSelect">
                        <option value="">Sin datos de facturación</option>
                    </select>
                    <div class="form-text">Datos fiscales (RFC, razón social…) que se imprimen en el recibo</div>
                </div>
                <div class="alert alert-info d-flex align-items-start" id="receiptInfoAlert" role="alert">
                    <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                    <div>
                        <strong>Información:</strong>
                        <ul class="mb-0 mt-1 ps-3">
                            <li>Se generará un recibo oficial</li>
                            <li>El recibo se descargará en PDF</li>
                        </ul>
                    </div>
                </div>
                <!-- Aviso: reservación no saldada. Se muestra al recibir 409 RESERVATION_NOT_SETTLED. -->
                <div class="alert alert-warning d-none" id="receiptNotSettledAlert" role="alert">
                    <div class="d-flex align-items-start">
                        <i class="ti ti-alert-triangle me-2 fs-5 mt-1"></i>
                        <div>
                            <strong>La reservación no está saldada.</strong>
                            <div class="mt-1" id="receiptNotSettledDetail">Registra el pago total antes de generar el recibo.</div>
                        </div>
                    </div>
                    <% if (basePath === 'admin') { %>
                    <div class="mt-2 text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger" id="forceGenerateReceiptBtn">
                            <i class="ti ti-alert-triangle me-1"></i>Generar de todos modos
                        </button>
                    </div>
                    <% } %>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-success" id="confirmGenerateReceiptBtn">
                    <i class="ti ti-receipt me-1"></i>Generar Recibo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Request Invoice Modal -->
<div class="modal fade" id="requestInvoiceModal" tabindex="-1" aria-labelledby="requestInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="requestInvoiceModalLabel">
                    <i class="ti ti-file-certificate me-2"></i>Solicitar Factura
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Desea solicitar la factura para la reservación <strong id="invoiceQuoteFolio"></strong>?</p>
                <div class="alert alert-info d-flex align-items-start" role="alert">
                    <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                    <div>
                        <strong>Información:</strong>
                        <ul class="mb-0 mt-1 ps-3">
                            <li>Se enviará una solicitud al departamento de facturación</li>
                            <li>Recibirá confirmación por correo electrónico</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-warning" id="confirmRequestInvoiceBtn">
                    <i class="ti ti-file-certificate me-1"></i>Solicitar Factura
                </button>
            </div>
        </div>
    </div>
</div>

<% if (basePath === 'admin') { %>
<!-- Regresar a cotización (solo admin) — deshace una conversión hecha por error -->
<div class="modal fade" id="revertToQuoteModal" tabindex="-1" aria-labelledby="revertToQuoteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title text-white" id="revertToQuoteModalLabel">
                    <i class="ti ti-arrow-back-up me-2"></i>Regresar a cotización
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Regresar la reservación <strong id="revertReservationFolio"></strong> a cotización?</p>
                <div class="alert alert-warning mb-0">
                    <ul class="mb-0">
                        <li>La cotización volverá a estado <strong>COTIZADO</strong>.</li>
                        <li>Si la reservación tiene pagos registrados, no se podrá regresar.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmRevertToQuoteBtn"><i class="ti ti-arrow-back-up me-1"></i>Regresar a cotización</button>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- Shared cancel utilities -->
<script src="/js/reservation-cancel-utils.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const token = localStorage.getItem('token') || sessionStorage.getItem('token');
    let pendingCancelId = null;
    
    // Populate year dropdown
    function populateYearDropdown() {
        const yearSelect = document.getElementById('yearFilter');
        const currentYear = new Date().getFullYear();
        
        // Add years from current year -2 to current year +2
        for (let year = currentYear - 2; year <= currentYear + 2; year++) {
            const option = document.createElement('option');
            option.value = year;
            option.textContent = year;
            if (year === currentYear) {
                option.selected = true;
            }
            yearSelect.appendChild(option);
        }
    }
    
    // Populate day dropdown
    function populateDayDropdown() {
        const daySelect = document.getElementById('dayFilter');
        
        for (let day = 1; day <= 31; day++) {
            const option = document.createElement('option');
            option.value = day;
            option.textContent = day;
            daySelect.appendChild(option);
        }
    }
    
    // Initialize dropdowns
    populateYearDropdown();
    populateDayDropdown();

    function getQuoteStatusBadge(status) {
        if (!status) return '';
        const map = {
            scheduled: { label: 'Agendada', cls: 'bg-success text-white' },
            hold: { label: 'Bloqueada', cls: 'bg-warning text-dark' },
            requested: { label: 'Solicitada', cls: 'bg-info text-white' },
            quoted: { label: 'Cotizada', cls: 'bg-primary text-white' },
            rejected: { label: 'Rechazada', cls: 'bg-danger text-white' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado de cotización origen">${s.label}</span>`;
    }
    
    function getReservationStatusBadge(status) {
        const map = {
            pending: { label: 'Asignaciones pendientes', cls: 'bg-warning text-dark' },
            assigned: { label: 'Asignada', cls: 'bg-info text-white' },
            in_progress: { label: 'En Progreso', cls: 'bg-primary text-white' },
            completed: { label: 'Completada', cls: 'bg-success text-white' },
            cancelled: { label: 'Cancelada', cls: 'bg-danger text-white' },
            confirmed: { label: 'Confirmada', cls: 'bg-success text-white' },
            hold: { label: 'En Espera', cls: 'bg-warning text-dark' },
        };
        const s = map[status] || { label: status, cls: 'bg-secondary text-white' };
        return `<span class="badge ${s.cls}" title="Estado operacional de reservación">${s.label}</span>`;
    }

    // Estado UNIFICADO de alto nivel para el agente (DM/client): un solo badge que
    // progresa Bloqueado → Agendado → Confirmado (assigned/confirmed/in_progress/
    // completed), + Cancelada. La progresión temporal (En curso / Pasada) la indica
    // el filtro de fechas, no el badge. Sin la granularidad operativa interna.
    function getAgentUnifiedStatusBadge(quoteStatus, resStatus) {
        let s;
        if (quoteStatus === 'hold') {
            s = { label: 'Bloqueado', cls: 'bg-warning text-dark' };
        } else if (resStatus === 'cancelled') {
            s = { label: 'Cancelada', cls: 'bg-danger text-white' };
        } else if (['assigned', 'confirmed', 'in_progress', 'completed'].includes(resStatus)) {
            s = { label: 'Confirmado', cls: 'bg-primary text-white' };
        } else {
            s = { label: 'Agendado', cls: 'bg-info text-white' };
        }
        return `<span class="badge ${s.cls}" title="Estado de la reservación">${s.label}</span>`;
    }

    // Una cancelación <24h crea una solicitud pendiente de aprobación; la reserva
    // sigue en su estatus real, así que se muestra un badge extra para señalarlo.
    function getPendingCancellationBadge() {
        return `<span class="badge bg-warning text-dark border border-danger-subtle" title="Tiene una solicitud de cancelación pendiente de aprobación"><i class="ti ti-clock me-1"></i>Pendiente de cancelación</span>`;
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        const d = new Date(dateStr);
        return d.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function formatCurrency(amount, currency) {
        const sym = currency === 'USD' ? 'USD $' : '$';
        return `${sym}${(amount || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    // Muestra la fecha de fin en texto pequeño bajo la fecha de inicio, en TODOS
    // los entornos. Ayuda a entender por qué una reservación cae en cierto filtro
    // (los filtros usan el rango inicio–fin de la reservación).
    function renderEndDate(row) {
        const fEnd = row.endDate ? formatDate(row.endDate) : '—';
        return `<div class="small text-muted">Fin: ${fEnd}</div>`;
    }

    // --- Debug de filtros (solo en local: dev y production-local) ---
    // Producción real corre en quotes.amexingexperience.com; localhost cubre
    // `npm run dev` y `npm run production-local`.
    const DEBUG_FILTERS = ['localhost', '127.0.0.1'].includes(window.location.hostname);

    // Explica por qué una reservación aparece en el filtro activo, mostrando la
    // fecha que dispara la clasificación. La lógica refleja exactamente las
    // queries del backend en ReservationController.getReservations():
    //   upcoming: startDate > hoy
    //   ongoing : startDate <= hoy <= endDate
    //   past    : endDate < hoy
    function renderFilterReason(row) {
        if (!DEBUG_FILTERS) return '';

        const activeFilter = document.querySelector('input[name="dateFilter"]:checked');
        const filter = activeFilter ? activeFilter.value : 'upcoming';

        const today = new Date(); today.setHours(0, 0, 0, 0);
        const start = row.startDate ? new Date(row.startDate) : null;
        const end = row.endDate ? new Date(row.endDate) : null;
        const fStart = start ? formatDate(row.startDate) : '— (sin fecha)';
        const fEnd = end ? formatDate(row.endDate) : '— (sin fecha)';
        const fToday = formatDate(today);

        let reason = '';
        let cls = 'bg-secondary';
        if (filter === 'upcoming') {
            cls = 'bg-primary';
            reason = `Inicio ${fStart} &gt; hoy ${fToday}`;
        } else if (filter === 'ongoing') {
            cls = 'bg-info';
            reason = `Inicio ${fStart} ≤ hoy ${fToday} ≤ Fin ${fEnd}`;
        } else if (filter === 'past') {
            cls = 'bg-dark';
            reason = `Fin ${fEnd} &lt; hoy ${fToday}`;
        }

        // Marca anomalías: sin endDate, o fin anterior al inicio.
        let warn = '';
        if (!end) {
            warn = '<div class="text-danger fw-semibold mt-1" style="font-size:.7rem;">⚠ Sin Fecha Fin (endDate)</div>';
        } else if (start && end < start) {
            warn = '<div class="text-danger fw-semibold mt-1" style="font-size:.7rem;">⚠ Fin anterior al Inicio</div>';
        }

        // Inicio/Fin ya se muestran en la celda (Fin vía renderEndDate en todos los
        // entornos), así que aquí solo va el badge de razón + advertencias de dev.
        return `
            <div class="mt-1 text-start" style="font-size:.7rem; line-height:1.3;">
                <span class="badge ${cls} mt-1" style="white-space:normal;" title="Razón por la que aparece en este filtro">${reason}</span>
                ${warn}
            </div>`;
    }

    // Pre-selecciona el filtro de fecha desde ?dateFilter= (p.ej. el link del dashboard
    // "Agendado" → pending_completion). Se hace antes de inicializar la tabla para que el
    // primer fetch ya use ese filtro.
    (function() {
        const urlFilter = new URLSearchParams(window.location.search).get('dateFilter');
        const valid = ['pending_completion', 'upcoming', 'ongoing', 'past', 'cancelled'];
        if (urlFilter && valid.indexOf(urlFilter) !== -1) {
            const radio = document.querySelector('input[name="dateFilter"][value="' + urlFilter + '"]');
            if (radio) { radio.checked = true; }
        }
    })();

    const table = $('#reservations-table').DataTable({
        // Built-in indicator off — we show our own overlay (#reservations-loading)
        // via preXhr.dt/xhr.dt to avoid a double "Cargando..." on filter reloads.
        processing: false,
        serverSide: true,
        ajax: {
            url: '/api/reservations',
            type: 'GET',
            headers: { 'Authorization': `Bearer ${token}` },
            data: function(d) {
                // Add date filter
                const activeFilter = document.querySelector('input[name="dateFilter"]:checked');
                if (activeFilter) {
                    d.dateFilter = activeFilter.value;
                }

                // Optional status filter (present in client/department_manager headers).
                const statusVal = $('#statusFilter').val();
                if (statusVal) d.statusFilter = statusVal;

                // Add year, month, day filters
                const yearFilter = document.getElementById('yearFilter').value;
                const monthFilter = document.getElementById('monthFilter').value;
                const dayFilter = document.getElementById('dayFilter').value;
                
                if (yearFilter) d.yearFilter = yearFilter;
                if (monthFilter) d.monthFilter = monthFilter;
                if (dayFilter) d.dayFilter = dayFilter;

                // Filtro genérico por agencia/cliente (molecule client-agency-filter)
                const acFilter = window.getClientAgencyFilter
                    ? window.getClientAgencyFilter('reservations') : null;
                if (acFilter && acFilter.type !== 'all') {
                    d.clientTypeFilter = acFilter.type; // 'agency' | 'client' (filtra por tipo)
                    if (acFilter.id) d.clientIdFilter = acFilter.id; // y por entidad si hay
                }

                return d;
            },
            error: function(xhr) {
                console.error('Error loading reservations:', xhr);
            }
        },
        columns: [
            {
                data: 'folio',
                render: function(data, type, row) {
                    return `<a href="/dashboard/<%= basePath %>/bookings/${row.id}" class="fw-semibold text-decoration-none">${data}</a>`;
                }
            },
            {
                data: 'clientName',
                render: function(data, type, row) {
                    const name = data || 'N/A';
                    if (type !== 'display') return name;
                    if (row.clientType === 'agency') {
                        return `${name} <span class="badge bg-light text-primary border ms-1">Agencia</span>`;
                    }
                    if (row.clientType === 'client') {
                        return `${name} <span class="badge bg-light text-success border ms-1">Cliente</span>`;
                    }
                    return name;
                }
            },
            {
                data: 'owner',
                render: function(data, type, row) {
                    const name = data || 'N/A';
                    // Si no hay propietario en la cotización, se muestra el creador.
                    if (row.ownerIsCreator) {
                        return `${name} <span class="badge bg-light text-muted ms-1" title="Sin propietario asignado; se muestra el creador de la reservación">creador</span>`;
                    }
                    return name;
                }
            },
            { data: 'eventType', defaultContent: '—' },
            {
                data: 'contactPerson',
                render: function(data, type, row) {
                    const name = (data && data.trim())
                        || `${row.leadGuestFirstName || ''} ${row.leadGuestLastName || ''}`.trim();
                    if (!name) return '<em class="text-muted">—</em>';
                    return `<span>${name}</span>`;
                }
            },
            {
                // Persona de Contacto: nombre + teléfono. Si no hay contacto propio capturado,
                // se usa al propietario (mismo nombre repetido) con su teléfono.
                data: null,
                orderable: false,
                render: function(data, type, row) {
                    const contactName = (row.contactPerson && row.contactPerson.trim())
                        || `${row.leadGuestFirstName || ''} ${row.leadGuestLastName || ''}`.trim();
                    const name = contactName || row.owner || '';
                    const phone = row.contactPhone || row.ownerPhone || '';
                    if (type !== 'display') return `${name} ${phone}`.trim();
                    if (!name && !phone) return '<em class="text-muted">—</em>';
                    const nameHtml = name ? `<span>${name}</span>` : '';
                    const phoneHtml = phone
                        ? `<small class="text-muted d-block"><i class="ti ti-phone me-1"></i>${phone}</small>`
                        : '';
                    return `${nameHtml}${phoneHtml}` || '<em class="text-muted">—</em>';
                }
            },
            {
                data: 'startDate',
                className: 'text-center',
                render: function(data, type, row) {
                    return `<div>${formatDate(data)}</div>${renderEndDate(row)}${renderFilterReason(row)}`;
                }
            },
            { data: 'numberOfPeople', className: 'text-center' },
            {
                data: null,
                className: 'text-center',
                render: function(data, type, row) {
                    return `<span class="badge bg-light text-dark">${row.assignedServices}/${row.totalServices}</span>`;
                }
            },
            {
                data: null,
                className: 'text-center',
                responsivePriority: 1,  // High priority - always show
                render: function(data, type, row) {
                    const isAdminView = <%= (typeof basePath !== 'undefined' && basePath === 'admin') ? 'true' : 'false' %>;
                    const pendingCancelBadge = row.hasPendingCancellation ? ' ' + getPendingCancellationBadge() : '';
                    // Agentes (DM/client): un solo badge de alto nivel (Bloqueado →
                    // Agendado → Confirmado), sin el detalle operativo.
                    if (!isAdminView) {
                        return getAgentUnifiedStatusBadge(row.quoteStatus, row.status) + pendingCancelBadge;
                    }
                    // Admin: estado de cotización + estado operativo de la reserva.
                    // Si la reserva ya está cancelada, se omite el badge de la cotización
                    // (siempre sería "cancelled") para no duplicar con "Cancelada".
                    const quoteBadge = row.status === 'cancelled' ? '' : getQuoteStatusBadge(row.quoteStatus);
                    const reservationBadge = getReservationStatusBadge(row.status);
                    return `${quoteBadge} ${reservationBadge}${pendingCancelBadge}`.trim();
                }
            },
            {
                data: 'updatedAt',
                className: 'text-center',
                responsivePriority: 2,  // High priority
                render: function(data) { return formatDate(data); }
            },
            {
                data: null,
                className: 'text-center',
                orderable: false,
                responsivePriority: 1,  // High priority for actions
                render: function(data, type, row) {
                    let actions = `<a href="/dashboard/<%= basePath %>/bookings/${row.id}" class="btn btn-sm btn-outline-primary me-1" title="Ver detalle"><i class="ti ti-list-details"></i></a>`;
                    if (row.quoteFolio) {
                        <% if (canManageReservations) { %>
                        actions += `<a href="/dashboard/<%= basePath %>/quotes/${row.quoteId}?context=reservation" class="btn btn-sm btn-outline-secondary me-1" title="Editar reservación"><i class="ti ti-edit"></i></a>`;
                        <% } else { %>
                        actions += `<a href="/dashboard/<%= basePath %>/quotes/${row.quoteId}" class="btn btn-sm btn-outline-secondary me-1" title="Ver cotización"><i class="ti ti-file-text"></i></a>`;
                        <% } %>
                    }
                    // Recibo / Factura: operan sobre la cotización agendada (row.quoteId).
                    // Solo cuando la cotización sigue 'scheduled' y la reservación no está
                    // cancelada (el backend exige status 'scheduled' para ambas acciones).
                    // Gate por rol acorde a los permisos de ruta: Recibo = los 3 roles
                    // (generate-receipt permite nivel 4+; client=5 también); Factura =
                    // admin/department_manager.
                    if (row.quoteId && row.quoteStatus === 'scheduled' && row.status !== 'cancelled') {
                        actions += `<button class="btn btn-sm btn-outline-success generate-receipt-btn me-1" data-quote-id="${row.quoteId}" data-folio="${row.quoteFolio || row.folio}" title="Generar Recibo"><i class="ti ti-receipt"></i></button>`;
                        <% if (basePath === 'admin' || basePath === 'department_manager') { %>
                        if (!row.hasPendingInvoiceRequest) {
                            actions += `<button class="btn btn-sm btn-outline-warning request-invoice-btn me-1" data-quote-id="${row.quoteId}" data-folio="${row.quoteFolio || row.folio}" title="Solicitar Factura"><i class="ti ti-file-certificate"></i></button>`;
                        } else {
                            // Ya solicitada: NO deshabilitado (así el tooltip nativo sí se ve) y clic
                            // muestra el estado. Ícono con check para diferenciarlo del pendiente.
                            actions += `<button class="btn btn-sm btn-outline-secondary invoice-requested-btn me-1" data-folio="${row.quoteFolio || row.folio}" title="Factura ya solicitada — pendiente de procesar"><i class="ti ti-file-certificate"></i></button>`;
                        }
                        <% } %>
                    }
                    // No mostrar "Cancelar" si ya hay una solicitud de cancelación
                    // pendiente (evita solicitudes duplicadas), ni si ya está
                    // cancelada/completada.
                    if (row.status !== 'cancelled' && row.status !== 'completed' && !row.hasPendingCancellation) {
                        actions += `<button class="btn btn-sm btn-outline-danger cancel-res-btn" data-id="${row.id}" title="Cancelar"><i class="ti ti-x"></i></button>`;
                    }
                    <% if (basePath === 'admin') { %>
                    // Menú ⋯ (solo admin): acciones destructivas poco comunes. "Regresar a
                    // cotización" deshace una conversión hecha por error. No aplica si ya está
                    // cancelada (no hay reservación viva que regresar).
                    if (row.status !== 'cancelled') {
                        actions += `
                        <div class="dropdown d-inline-block ms-1">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" title="Más acciones">
                                <i class="ti ti-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button class="dropdown-item text-danger revert-to-quote-btn" type="button" data-id="${row.id}" data-folio="${row.folio || ''}" data-quote-folio="${row.quoteFolio || ''}">
                                        <i class="ti ti-arrow-back-up me-1"></i>Regresar a cotización
                                    </button>
                                </li>
                            </ul>
                        </div>`;
                    }
                    <% } %>
                    return actions;
                }
            }
        ],
        columnDefs: [
            // Solo "Fecha Inicio" (col 6) es ordenable; el resto se deshabilita.
            // Cliente, Propietario y Servicios no tienen un campo de orden fiable en
            // Parse, y se optó por dejar el ordenamiento únicamente por fecha de inicio.
            { orderable: false, targets: [0, 1, 2, 3, 4, 5, 7, 8, 9, 10, 11] },
        ],
        // Orden por defecto: Fecha Inicio asc (pill inicial = Próximas).
        // En cada cambio de pill se reajusta con applyDefaultOrder().
        order: [[6, 'asc']],
        language: {
            processing: 'Cargando...',
            search: 'Buscar:',
            lengthMenu: 'Mostrar _MENU_ registros',
            info: 'Mostrando _START_ a _END_ de _TOTAL_ reservaciones',
            infoEmpty: 'No hay reservaciones',
            infoFiltered: '(filtrado de _MAX_ total)',
            zeroRecords: 'No se encontraron reservaciones',
            emptyTable: 'No hay reservaciones registradas',
            paginate: { first: 'Primera', previous: 'Anterior', next: 'Siguiente', last: 'Última' },
        },
        // Responsive collapse deshabilitado: confundía al usuario al ocultar
        // columnas (p.ej. Fecha Inicio). La tabla usa scroll horizontal
        // (wrapper .table-responsive) cuando no caben todas las columnas.
        responsive: false,
        pageLength: 10,
    });

    // Show/hide the loader overlay on every AJAX reload triggered by filters
    const loadingOverlay = document.getElementById('reservations-loading');
    $('#reservations-table')
        .on('preXhr.dt', function() {
            if (loadingOverlay) loadingOverlay.classList.remove('d-none');
        })
        .on('xhr.dt', function(e, settings, json) {
            if (loadingOverlay) loadingOverlay.classList.add('d-none');
            // Actualiza el badge del pill "Pendientes de completar" con el conteo del backend.
            const counter = document.getElementById('pendingCompletionCounter');
            if (counter && json && typeof json.pendingCompletionCount === 'number') {
                counter.textContent = json.pendingCompletionCount;
                counter.classList.toggle('d-none', json.pendingCompletionCount === 0);
            }
        });

    // Calcula el periodo [inicio, fin) elegido en los selectores Año/Mes/Día,
    // reflejando exactamente la lógica del backend
    // (ReservationController.applyDateConstraints). El año siempre está presente.
    function getSelectedPeriod() {
        const yearVal = parseInt(document.getElementById('yearFilter').value, 10);
        const monthRaw = document.getElementById('monthFilter').value;
        const dayRaw = document.getElementById('dayFilter').value;
        const monthVal = monthRaw ? parseInt(monthRaw, 10) : null;
        const dayVal = dayRaw ? parseInt(dayRaw, 10) : null;
        if (Number.isNaN(yearVal)) return null;
        if (monthVal !== null && dayVal !== null) {
            return { start: new Date(yearVal, monthVal - 1, dayVal), end: new Date(yearVal, monthVal - 1, dayVal + 1) };
        }
        if (monthVal !== null) {
            return { start: new Date(yearVal, monthVal - 1, 1), end: new Date(yearVal, monthVal, 1) };
        }
        return { start: new Date(yearVal, 0, 1), end: new Date(yearVal + 1, 0, 1) };
    }

    // Ajusta el pill de estado según el periodo elegido:
    //  - periodo ENTERO en el pasado            → Pasadas
    //  - periodo ENTERO en el futuro            → Próximas
    //  - periodo es EXACTAMENTE hoy (un día)    → En curso (hoy es el ancla de "en curso")
    //  - periodo amplio que cruza hoy (mes/año actual) → respeta el pill actual
    // El cambio del radio es programático: NO dispara 'change', así que no provoca
    // una recarga doble — quien llama recarga la tabla una sola vez después.
    function autoAdjustStatusFromDate() {
        // En "Pendientes de completar" (filtro por estado, no por fecha) los selectores
        // de fecha no aplican: no cambiamos el pill.
        const activePill = document.querySelector('input[name="dateFilter"]:checked');
        // 'pending_completion' y 'cancelled' son filtros por estado (no por fecha):
        // no se auto-cambian al tocar los selectores de Año/Mes/Día.
        if (activePill && (activePill.value === 'pending_completion' || activePill.value === 'cancelled')) return false;
        const period = getSelectedPeriod();
        if (!period) return;
        const today = new Date(); today.setHours(0, 0, 0, 0);
        const tomorrow = new Date(today); tomorrow.setDate(tomorrow.getDate() + 1);
        let target = null;
        if (period.end <= today) {
            target = 'filterPast';        // el periodo ya terminó
        } else if (period.start > today) {
            target = 'filterUpcoming';    // el periodo aún no empieza
        } else if (period.start.getTime() === today.getTime()
                && period.end.getTime() === tomorrow.getTime()) {
            target = 'filterOngoing';     // el periodo es exactamente HOY → en curso
        }
        // else: periodo amplio que contiene hoy (mes/año actual) → respeta el pill
        if (!target) return false;
        const radio = document.getElementById(target);
        if (radio && !radio.checked) {
            radio.checked = true;
            return true; // el pill cambió
        }
        return false;
    }

    // Índice de la columna "Fecha Inicio" en la tabla (Folio=0 ... Persona de Contacto=5, Fecha Inicio=6).
    const STARTDATE_COL = 6;

    // Dirección de orden por defecto de "Fecha Inicio" según el pill activo:
    //   Próximas / En curso → asc (lo más próximo primero)
    //   Pasadas             → desc (lo más reciente primero)
    function orderDirForActivePill() {
        const active = document.querySelector('input[name="dateFilter"]:checked');
        const val = active ? active.value : 'upcoming';
        return val === 'past' ? 'desc' : 'asc';
    }

    // Fija el orden por defecto (Fecha Inicio, dirección según pill) SIN redibujar;
    // el draw lo dispara la recarga posterior, así que no hay petición doble.
    function applyDefaultOrder() {
        table.order([STARTDATE_COL, orderDirForActivePill()]);
    }

    // Caso inverso al auto-ajuste: al cambiar el pill de estado, reestablece los
    // selectores de fecha a su valor por defecto (año actual, Mes/Día = Todos).
    // Si no, una fecha previa (p.ej. abril) sigue combinándose con el nuevo estado
    // (p.ej. En curso) y devuelve 0 filas. Es programático: no dispara 'change',
    // así que no provoca recarga doble ni re-ajusta el pill.
    function resetDateSelectors() {
        const currentYear = new Date().getFullYear();
        document.getElementById('yearFilter').value = String(currentYear);
        document.getElementById('monthFilter').value = '';
        document.getElementById('dayFilter').value = '';
    }

    // Optional status filter (client/department_manager). No-op if the select
    // isn't present (admin has no status filter).
    $('#statusFilter').on('change', function() {
        table.ajax.reload();
    });

    // Date filter change
    document.querySelectorAll('input[name="dateFilter"]').forEach(button => {
        button.addEventListener('change', function() {
            if (this.checked) {
                // Reestablece la fecha para que no contradiga el nuevo estado.
                resetDateSelectors();
                // Orden por defecto del nuevo estado (Fecha Inicio asc/desc).
                applyDefaultOrder();
                // Force DataTable to recalculate columns and reload
                table.ajax.reload(function() {
                    // Callback after reload to ensure columns are properly rendered
                    table.columns.adjust();
                    // Force responsive to recalculate
                    if (table.responsive) {
                        table.responsive.recalc();
                    }
                    table.draw();
                }, false);
            }
        });
    });
    
    // Year, Month, Day filter change
    ['yearFilter', 'monthFilter', 'dayFilter'].forEach(filterId => {
        document.getElementById(filterId).addEventListener('change', function() {
            // Ajusta el pill de estado según la fecha antes de recargar (una sola vez).
            // Si el estado cambió, reaplica el orden por defecto de ese estado;
            // si no (periodo amplio), respeta el orden actual del usuario.
            if (autoAdjustStatusFromDate()) applyDefaultOrder();
            table.ajax.reload(null, false);
        });
    });

    // Filtro genérico Agencia/Cliente: recarga la tabla cuando cambia la selección.
    document.addEventListener('clientAgencyFilter:change', function(e) {
        if (e.detail && e.detail.prefix === 'reservations') {
            table.ajax.reload(null, false);
        }
    });

    // Cancel reservation - using shared utilities
    $(document).on('click', '.cancel-res-btn', function() {
        const reservationId = $(this).data('id');
        // Use shared utility with table reload callback
        openReservationCancelModal(reservationId, () => {
            table.ajax.reload();
        });
    });

    // ===== Generar Recibo / Solicitar Factura =====
    // Movido desde la tabla de cotizaciones. Ambas acciones operan sobre la COTIZACIÓN
    // agendada ligada a la reservación (data-quote-id), no sobre la reservación en sí.
    let receiptQuoteId = null;
    let invoiceQuoteId = null;
    const rtNotifyOk = (m) => (window.showSuccessAlert ? window.showSuccessAlert(m) : alert(m));
    const rtNotifyErr = (m) => (window.showErrorAlert ? window.showErrorAlert(m) : alert(m));

    <% if (basePath === 'admin') { %>
    // ===== Regresar a cotización (solo admin) — deshace una conversión hecha por error =====
    let revertReservationId = null;
    $(document).on('click', '.revert-to-quote-btn', function() {
        revertReservationId = $(this).data('id');
        const folio = $(this).data('folio') || $(this).data('quote-folio') || '';
        $('#revertReservationFolio').text(folio);
        new bootstrap.Modal(document.getElementById('revertToQuoteModal')).show();
    });

    $('#confirmRevertToQuoteBtn').on('click', function() {
        if (!revertReservationId) return;
        const btn = $(this);
        const original = btn.html();
        btn.prop('disabled', true).html('<i class="ti ti-loader ti-spin me-1"></i>Regresando...');
        const hide = () => bootstrap.Modal.getInstance(document.getElementById('revertToQuoteModal'))?.hide();
        fetch(`/api/reservations/${revertReservationId}/revert-to-quote`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ targetStatus: 'quoted' })
        })
        .then(async (resp) => {
            const data = await resp.json().catch(() => ({}));
            if (resp.ok && data.success) {
                hide();
                rtNotifyOk(`Reservación regresada a cotización (${data.data?.quoteFolio || ''} — COTIZADO).`);
                table.ajax.reload(null, false);
                revertReservationId = null;
            } else if (resp.status === 409 && data.code === 'REVERT_HAS_PAYMENTS') {
                rtNotifyErr(data.error || 'La reservación tiene pagos registrados; no se puede regresar.');
            } else {
                rtNotifyErr(data.error || 'Error al regresar la reservación a cotización.');
            }
        })
        .catch(() => { rtNotifyErr('Error al regresar la reservación a cotización.'); })
        .finally(() => { btn.prop('disabled', false).html(original); });
    });
    <% } %>

    // Cargar métodos de pago (solo admin) en el modal de recibo.
    async function loadReceiptPaymentInfoOptions() {
        <% if (basePath === 'admin') { %>
        const select = document.getElementById('paymentInfoSelect');
        if (!select) return;
        try {
            const response = await fetch('/api/payment-info', {
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
            });
            const result = await response.json();
            select.innerHTML = '<option value="">Sin información de pago</option>';
            if (result.success && Array.isArray(result.data) && result.data.length > 0) {
                result.data.forEach((paymentInfo) => {
                    const option = document.createElement('option');
                    option.value = paymentInfo.id;
                    option.textContent = paymentInfo.name;
                    if (paymentInfo.isDefault) option.selected = true;
                    select.appendChild(option);
                });
            } else {
                const option = document.createElement('option');
                option.value = '';
                option.textContent = 'No hay métodos de pago configurados';
                option.disabled = true;
                select.appendChild(option);
            }
        } catch (error) {
            console.error('Error loading payment info options:', error);
            select.innerHTML = '<option value="">Error al cargar métodos de pago</option>';
        }
        <% } %>
    }

    // Cargar los perfiles de facturación de la AGENCIA de la cotización (los 3 roles).
    // Preselecciona el guardado en la reservación o el principal.
    async function loadBillingProfileOptions(quoteId) {
        const select = document.getElementById('billingProfileSelect');
        const spinner = document.getElementById('billingProfileSpinner');
        if (!select || !quoteId) return;
        // Estado de carga: spinner visible + select deshabilitado mostrando "Cargando…".
        if (spinner) spinner.classList.remove('d-none');
        select.disabled = true;
        select.innerHTML = '<option value="" selected>Cargando perfiles…</option>';
        try {
            const response = await fetch(`/api/quotes/${quoteId}/billing-profiles`, {
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
            });
            const result = await response.json();
            const profiles = (result.success && result.data && result.data.profiles) || [];
            const selectedId = (result.success && result.data && result.data.selectedProfileId) || '';
            select.innerHTML = '<option value="">Sin datos de facturación</option>';
            if (profiles.length > 0) {
                profiles.forEach((p) => {
                    const option = document.createElement('option');
                    option.value = p.id;
                    const rfc = p.rfc ? ` — ${p.rfc}` : '';
                    option.textContent = `${p.label}${rfc}${p.isPrimary ? ' (principal)' : ''}`;
                    if (p.id === selectedId) option.selected = true;
                    select.appendChild(option);
                });
            } else {
                const option = document.createElement('option');
                option.value = '';
                option.textContent = 'La agencia no tiene perfiles de facturación';
                option.disabled = true;
                select.appendChild(option);
            }
        } catch (error) {
            console.error('Error loading billing profiles:', error);
            select.innerHTML = '<option value="">Error al cargar perfiles</option>';
        } finally {
            // Fin de carga: ocultar spinner y reactivar el select.
            if (spinner) spinner.classList.add('d-none');
            select.disabled = false;
        }
    }

    // Abrir modal de recibo
    $('#reservations-table').on('click', '.generate-receipt-btn', function() {
        receiptQuoteId = $(this).data('quote-id');
        $('#receiptQuoteFolio').text($(this).data('folio') || '');
        // Reset del aviso de "no saldada" por si quedó de una apertura anterior.
        document.getElementById('receiptNotSettledAlert')?.classList.add('d-none');
        document.getElementById('receiptInfoAlert')?.classList.remove('d-none');
        loadReceiptPaymentInfoOptions();
        loadBillingProfileOptions(receiptQuoteId);
        new bootstrap.Modal(document.getElementById('generateReceiptModal')).show();
    });

    // Abrir modal de factura
    $('#reservations-table').on('click', '.request-invoice-btn', function() {
        invoiceQuoteId = $(this).data('quote-id');
        $('#invoiceQuoteFolio').text($(this).data('folio') || '');
        new bootstrap.Modal(document.getElementById('requestInvoiceModal')).show();
    });

    // Factura ya solicitada: informa el estado (pendiente de procesar por facturación).
    $('#reservations-table').on('click', '.invoice-requested-btn', function() {
        const folio = $(this).data('folio') || '';
        rtNotifyOk(`La factura de ${folio} ya fue solicitada y está pendiente de procesar por el departamento de facturación.`);
    });

    // Genera el recibo. force=true solo lo usa el botón admin "Generar de todos modos"
    // para saltarse el bloqueo de "reservación no saldada" (el server revalida el permiso).
    function doGenerateReceipt(force) {
        if (!receiptQuoteId) return;
        const quoteId = receiptQuoteId;
        const confirmButton = $('#confirmGenerateReceiptBtn');
        const forceButton = $('#forceGenerateReceiptBtn');
        const originalText = confirmButton.html();
        confirmButton.prop('disabled', true).html('<i class="ti ti-loader ti-spin me-1"></i>Generando...');
        forceButton.prop('disabled', true);

        let includePaymentInfo = true;
        let selectedPaymentInfoId = null;
        <% if (basePath === 'admin') { %>
        const select = document.getElementById('paymentInfoSelect');
        if (select && select.value) { selectedPaymentInfoId = select.value; includePaymentInfo = true; } else { includePaymentInfo = false; }
        <% } %>

        const hideReceiptModal = () => bootstrap.Modal.getInstance(document.getElementById('generateReceiptModal'))?.hide();

        // Perfil de facturación elegido (los 3 roles).
        const billingSel = document.getElementById('billingProfileSelect');
        const billingProfileId = (billingSel && billingSel.value) ? billingSel.value : null;

        fetch(`/api/quotes/${quoteId}/generate-receipt`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ includePaymentInfo, paymentInfoId: selectedPaymentInfoId, billingProfileId, force: force === true })
        })
        .then((response) => {
            // Reservación no saldada: mantener el modal abierto y mostrar el saldo pendiente.
            if (response.status === 409) {
                return response.json().then((data) => {
                    if (data && data.code === 'RESERVATION_NOT_SETTLED') {
                        const p = data.data || {};
                        const detail = document.getElementById('receiptNotSettledDetail');
                        if (detail) {
                            const bal = (typeof p.balance === 'number')
                                ? p.balance.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' })
                                : null;
                            detail.textContent = bal
                                ? `Saldo pendiente: ${bal}. Registra el pago total antes de generar el recibo.`
                                : (data.error || 'Registra el pago total antes de generar el recibo.');
                        }
                        document.getElementById('receiptInfoAlert')?.classList.add('d-none');
                        document.getElementById('receiptNotSettledAlert')?.classList.remove('d-none');
                        return; // no lanzar: el modal queda abierto con el aviso
                    }
                    throw new Error(data.error || 'La reservación no está saldada.');
                });
            }
            if (!response.ok) {
                return response.json().then((errorData) => {
                    throw new Error(`${response.status}: ${errorData.error || errorData.message || 'Error del servidor'}`);
                }).catch(() => { throw new Error(`HTTP error! status: ${response.status}`); });
            }
            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('application/pdf')) {
                return response.blob().then((blob) => {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Receipt-${quoteId}.pdf`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                    hideReceiptModal();
                    // Sin alerta de éxito: la descarga del PDF ya es señal suficiente.
                    table.ajax.reload(null, false);
                    receiptQuoteId = null;
                });
            }
            return response.json().then((data) => {
                if (data.success) {
                    hideReceiptModal();
                    table.ajax.reload(null, false);
                    receiptQuoteId = null;
                } else {
                    throw new Error(data.error || 'Error al generar el recibo');
                }
            });
        })
        .catch((error) => {
            hideReceiptModal();
            let errorMessage = 'Error al generar el recibo';
            if (error.message) {
                if (error.message.includes('401')) errorMessage = 'Error de autenticación. Por favor, inicia sesión de nuevo.';
                else if (error.message.includes('403')) errorMessage = 'No tienes permisos para generar recibos.';
                else if (error.message.includes('404')) errorMessage = 'La cotización no fue encontrada.';
                else if (error.message.includes('500')) errorMessage = 'Error del servidor. Intenta de nuevo más tarde.';
                else errorMessage = `Error: ${error.message}`;
            }
            rtNotifyErr(errorMessage);
        })
        .finally(() => {
            confirmButton.prop('disabled', false).html(originalText);
            forceButton.prop('disabled', false);
        });
    }

    // Confirmar recibo → descarga el PDF (respeta el bloqueo de "no saldada").
    $('#confirmGenerateReceiptBtn').on('click', function() { doGenerateReceipt(false); });
    // Admin: forzar la generación aunque no esté saldada.
    $(document).on('click', '#forceGenerateReceiptBtn', function() { doGenerateReceipt(true); });

    // Confirmar solicitud de factura
    $('#confirmRequestInvoiceBtn').on('click', function() {
        if (!invoiceQuoteId) return;
        const quoteId = invoiceQuoteId;
        const hideInvoiceModal = () => bootstrap.Modal.getInstance(document.getElementById('requestInvoiceModal'))?.hide();
        $.ajax({
            url: `/api/quotes/${quoteId}/request-invoice`,
            type: 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': `Bearer ${token}` },
            data: JSON.stringify({}),
            success: function(response) {
                hideInvoiceModal();
                if (response.success) {
                    rtNotifyOk(response.message || 'Solicitud de factura enviada exitosamente');
                    table.ajax.reload(null, false);
                    invoiceQuoteId = null;
                } else {
                    rtNotifyErr(response.error || 'Error al solicitar la factura');
                }
            },
            error: function(xhr) {
                hideInvoiceModal();
                rtNotifyErr(xhr.responseJSON?.error || 'Error al solicitar la factura');
            }
        });
    });
});
</script>
