    // POI Loading and Management Functions
    async function loadPOIOptions() {
        try {
            console.log('🌍 Loading POI options for Destino selectbox...');
            
            const response = await fetch('/api/pois/active', {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('authToken')}`
                }
            });
            
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }
            
            const responseData = await response.json();
            console.log('📍 POI API Response:', responseData);
            
            // Extract POI array from response
            const poisArray = responseData.success ? responseData.data : responseData;
            
            if (!Array.isArray(poisArray)) {
                console.error('❌ POI API did not return an array:', poisArray);
                return [];
            }
            
            console.log(`📍 Loaded ${poisArray.length} POIs from API`);
            
            // Deduplicate by name - show unique names only
            const uniquePOIs = poisArray.filter((poi, index, self) => 
                index === self.findIndex(p => p.label === poi.label)
            );
            
            console.log(`✨ Deduplicated to ${uniquePOIs.length} unique POIs`);
            return uniquePOIs;
            
        } catch (error) {
            console.error('❌ Error loading POI options:', error);
            showEstablishmentError('Error al cargar destinos. Inténtelo de nuevo.');
            return [];
        }
    }
    
    // Destino del establecimiento en edición ({ id, name } o null). Fuente de verdad
    // para mantener el seleccionado a prueba de timing (las opciones cargan async y el
    // catálogo activo puede no incluir el POI guardado).
    let pendingEstablishmentDestino = null;

    // Aplica el destino pendiente al select: reinyecta su opción si no existe (POI no
    // listado / opciones aún no cargadas) y lo selecciona. Se llama tras cada repoblado.
    function applyEstablishmentDestino() {
        const $sel = $('#establishmentDestino');
        if ($sel.length === 0) return;
        if (!pendingEstablishmentDestino || !pendingEstablishmentDestino.id) return;
        const { id, name } = pendingEstablishmentDestino;
        if ($sel.find(`option[value="${id}"]`).length === 0) {
            $sel.append($('<option>').val(id).text(name || id));
        }
        $sel.val(id);
    }

    // Populate Destino selectbox with POI options
    function populateDestinoSelect(selectId, pois) {
        const select = document.getElementById(selectId);
        if (!select) {
            console.warn('⚠️ Destino select element not found:', selectId);
            return;
        }
        
        // Preserva la selección actual: el catálogo de POIs carga async y se puede
        // repoblar DESPUÉS de que el editar ya seteó el destino — sin esto, se borraría.
        const prevValue = select.value;

        // Clear existing options except the first one
        select.innerHTML = '<option value="">Seleccione un destino...</option>';

        // Add POI options
        pois.forEach(poi => {
            const option = document.createElement('option');
            option.value = poi.value;
            option.textContent = poi.label;
            option.setAttribute('data-service-type', poi.serviceType?.name || '');
            select.appendChild(option);
        });

        // Restaura la selección previa si el POI sigue disponible en la lista.
        if (prevValue) {
            select.value = prevValue;
        }

        // Reaplica el destino del establecimiento en edición (reinyecta su opción si el
        // POI no vino en la lista) → seleccionado a prueba de timing.
        if (selectId === 'establishmentDestino') {
            applyEstablishmentDestino();
        }

        console.log(`✅ Populated ${selectId} with ${pois.length} POI options`);
    }
    
    // Load and populate POI options for establishment modal
    async function loadEstablishmentDestinoOptions() {
        const pois = await loadPOIOptions();
        if (pois.length > 0) {
            populateDestinoSelect('establishmentDestino', pois);
        }
    }

    // Helper function to try to get presigned URL from S3 key
    async function tryGetPresignedUrl(s3Key) {
        try {
            // Try to use a presigned URL API endpoint if available
            const response = await fetch('/api/s3/presigned-url', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${localStorage.getItem('authToken')}`
                },
                body: JSON.stringify({ s3Key: s3Key })
            });
            
            if (response.ok) {
                const data = await response.json();
                return data.url;
            } else {
                console.warn('Presigned URL API not available, trying alternative approach');
                // Alternative: try to construct a basic S3 URL (will likely fail due to permissions)
                if (s3Key && s3Key.includes('experiences/')) {
                    const bucketName = 'amexing-bucket'; // This should come from config
                    const region = 'us-east-1'; // This should come from config  
                    return `https://${bucketName}.s3.${region}.amazonaws.com/${s3Key}`;
                }
            }
        } catch (error) {
            console.error('Error getting presigned URL:', error);
        }
        return null;
    }

        // Establishment Creation/Edit Modal Functions
        function openEstablishmentModal(isEdit = false, establishmentId = null) {
