                            <button type="button" class="btn btn-outline-warning btn-sm day-btn" data-day="5" data-day-name="Viernes">Vi</button>
                            <button type="button" class="btn btn-outline-warning btn-sm day-btn" data-day="6" data-day-name="Sábado">Sa</button>
                            <button type="button" class="btn btn-outline-warning btn-sm day-btn" data-day="0" data-day-name="Domingo">Do</button>
