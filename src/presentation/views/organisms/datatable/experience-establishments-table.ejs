                    console.log('🗑️ Removed experience card:', card.getAttribute('data-id'));
                });
                
                // Force clear container as additional safety
                experienciasList.innerHTML = '';
                
                updateEstablishmentNoExperienciasMessage();
                
                console.log('✅ Modal experiences cleared completely');
            }
            
            // Update modal title and button text
            const modalTitle = document.getElementById('establishmentModalTitle');
