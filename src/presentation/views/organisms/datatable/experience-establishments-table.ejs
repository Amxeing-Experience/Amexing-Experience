        // Establishment Experience Management Functions
        // ========== SUBEXPERIENCIA ACCORDION (Establecimientos) ==========
        // Cada subexperiencia se renderiza colapsada (solo cabecera con nombre/
        // precio/tipo); al hacer click se expande. Las fotos usan loading="lazy"
        // dentro de un cuerpo display:none, así su descarga se difiere.
        function syncEstablishmentHeader(cardEl, exp) {
            const el = cardEl && cardEl.jquery ? cardEl[0] : cardEl;
            if (!el) return;
            const nameVal = exp ? (exp.name || '') : (el.querySelector('.experiencia-name-input')?.value || '');
            const priceRaw = exp ? exp.price : el.querySelector('.experiencia-price-input')?.value;
            const tipoVal = exp ? (exp.tipo || exp.providerType || '') : (el.querySelector('.experiencia-tipo-input')?.value || '');

            const titleEl = el.querySelector('.experiencia-acc-title');
            if (titleEl) titleEl.textContent = (nameVal && nameVal.trim()) ? nameVal.trim() : 'Nueva experiencia';

            const priceEl = el.querySelector('.experiencia-acc-price');
            if (priceEl) {
                const n = parseFloat(priceRaw);
                priceEl.textContent = (!isNaN(n) && n > 0) ? ('$' + n.toLocaleString('es-MX')) : '';
            }

            const tipoEl = el.querySelector('.experiencia-acc-tipo');
            if (tipoEl) {
                if (tipoVal) { tipoEl.textContent = tipoVal; tipoEl.classList.remove('d-none'); }
                else { tipoEl.textContent = ''; tipoEl.classList.add('d-none'); }
            }
        }
        function expandEstablishmentCard(cardEl) {
            const el = cardEl && cardEl.jquery ? cardEl[0] : cardEl;
            if (!el) return;
            const body = el.querySelector('.experiencia-acc-body');
            const chevron = el.querySelector('.experiencia-acc-chevron');
            if (body && getComputedStyle(body).display === 'none') {
                $(body).slideDown(150);
                if (chevron) chevron.style.transform = 'rotate(90deg)';
                el.classList.add('experiencia-expanded');
            }
        }
        function collapseEstablishmentCard(cardEl) {
            const el = cardEl && cardEl.jquery ? cardEl[0] : cardEl;
            if (!el) return;
            const body = el.querySelector('.experiencia-acc-body');
            const chevron = el.querySelector('.experiencia-acc-chevron');
            if (body && getComputedStyle(body).display !== 'none') {
                $(body).slideUp(150);
                if (chevron) chevron.style.transform = 'rotate(0deg)';
                el.classList.remove('experiencia-expanded');
            }
        }
        // Toggle al click en la cabecera (ignora el botón borrar / inputs)
        $(document).on('click.accEst', '#establishmentExperienciasList .experiencia-acc-header', function(e) {
            if ($(e.target).closest('button, a, input, select, textarea').length) return;
            const el = this.closest('.experiencia-editable');
            if (!el) return;
            const body = el.querySelector('.experiencia-acc-body');
            if (body && getComputedStyle(body).display === 'none') expandEstablishmentCard(el);
            else collapseEstablishmentCard(el);
        });
        // Mantener el resumen de la cabecera en sync mientras se escribe
        $(document).on('input.accEst change.accEst',
            '#establishmentExperienciasList .experiencia-name-input, #establishmentExperienciasList .experiencia-price-input, #establishmentExperienciasList .experiencia-tipo-input',
            function() {
                const el = this.closest('.experiencia-editable');
                if (el) syncEstablishmentHeader(el);
            });

