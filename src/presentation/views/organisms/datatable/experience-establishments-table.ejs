                    </div>
                    
                    <!-- Notas del proveedor -->
                    <div class="mb-2">
                        <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">
                            <i class="ti ti-building me-1"></i>Notas del establecimiento <span class="text-muted">(Del establecimiento)</span>
                        </label>
                        <textarea class="form-control experiencia-provider-notes-input" 
                                  rows="3"
                                  placeholder="Notas e instrucciones proporcionadas por el establecimiento..."
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                        <div class="form-text">
                            <small><i class="ti ti-info-circle me-1"></i>Información del establecimiento</small>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <!-- Notas de reserva del cliente -->
                    <div class="mb-2">
                        <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">
                            <i class="ti ti-user me-1"></i>Notas reserva cliente <span class="text-muted">(Visible cliente)</span>
                        </label>
                        <textarea class="form-control experiencia-client-booking-notes-input" 
                                  rows="3"
                                  placeholder="Instrucciones y notas visibles para el cliente al reservar..."
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                        <div class="form-text">
                            <small><i class="ti ti-eye me-1"></i>Mostrado al cliente durante la reserva</small>
                        </div>
                    </div>
                    
                    <!-- Notas del equipo -->
                    <div class="mb-2">
                        <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">
                            <i class="ti ti-users me-1"></i>Notas del equipo <span class="text-muted">(Operaciones)</span>
                        </label>
                        <textarea class="form-control experiencia-team-notes-input" 
                                  rows="3"
                                  placeholder="Notas para coordinación y operación del equipo..."
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                        <div class="form-text">
                            <small><i class="ti ti-clipboard me-1"></i>Para coordinación operativa</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div><!-- /.experiencia-acc-body -->
    </div>
</template>

<script>
(function() {
    function initEstablishmentsDataTable() {
        // Check if jQuery and DataTables are available
        if (typeof $ === 'undefined') {
            console.log('⏳ jQuery not yet available, retrying...');
            setTimeout(initEstablishmentsDataTable, 100);
            return;
        }
        
        if (typeof $.fn.DataTable === 'undefined') {
            console.log('⏳ DataTables not yet available, retrying...');
            setTimeout(initEstablishmentsDataTable, 100);
            return;
        }
        
        console.log('🏢 Initializing Establishments DataTable...');

        // CRITICAL: Track pending requests to prevent race conditions
        let pendingEstablishmentRequests = {
            establishment: null,
            experiences: null
        };
        
        // Modal state tracking to prevent cross-contamination
        let currentModalState = {
            mode: null, // 'edit' or 'create'
            establishmentId: null,
            isOpen: false,
            sessionId: null // Unique session ID for each modal opening
        };
        
        // Track deleted experience IDs to remove from database
        let deletedExperienceIds = [];

        // Initialize variables (following providers table pattern)
        const tableId = '<%= dtTableId %>';
        const apiEndpoint = '<%= dtApiEndpoint %>';
        const showActions = <%= dtShowActions %>;
        const canEdit = <%= canEdit %>;
        const canDelete = <%= canDelete %>;

        // Function to get access token from various sources
        function getAccessToken() {
            // Try localStorage first (common keys)
            const tokenFromStorage = localStorage.getItem('accessToken') || 
                                   localStorage.getItem('token') || 
                                   localStorage.getItem('authToken');
            if (tokenFromStorage) {
                return tokenFromStorage;
            }
            
            // Try cookies as fallback
            const cookies = document.cookie.split(';');
            for (let cookie of cookies) {
                const [name, value] = cookie.trim().split('=');
                if (name === 'clientAccessToken' || name === 'accessToken') {
                    return value;
                }
            }
            
            return null;
        }

        // DataTable initialization with type=Establishment filter
        // Master-detail: reubica el form + botón fuera del holder (modal oculto)
        // hacia el panel de detalle inline; los nodos conservan sus handlers.
        (function relocateEstablishmentForm() {
            const $scroll = $('#establishmentDetailScroll');
            const $footer = $('#establishmentDetailFooter');
            if ($scroll.length && $('#establishmentForm').length) {
                $scroll.append($('#establishmentModalAlerts'));
                $scroll.append($('#establishmentForm'));
                $footer.append($('#saveEstablishmentBtn'));
                $('#establishmentModal').remove();
            }
        })();

        const dataTable = $(`#${tableId}`).DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: apiEndpoint + '?type=Establishment&includeInactive=true', // Show all establishments in admin
                type: 'GET',
                dataSrc: function(json) {
                    return json.data || [];
                },
                error: function(xhr, error, thrown) {
                    console.error('Error loading establishments:', error);
                    showErrorAlert('Error al cargar los establecimientos. Por favor, intente nuevamente.');
                }
            },
        columns: [
            // Bandeja: una sola columna por establecimiento (nombre + nº experiencias
            // + estado + menú de acciones). El renglón completo es clicable.
            {
                data: null,
                orderable: false,
                render: function(data, type, row) {
                    const id = row.id;
                    const count = row.experienciasCount || 0;
                    const countLabel = count > 0
                        ? `${count} experiencia${count !== 1 ? 's' : ''}`
                        : 'Sin experiencias';
                    const status = row.active
                        ? '<span class="badge bg-success">Activo</span>'
                        : '<span class="badge bg-warning">Inactivo</span>';

                    let menuItems = '';
                    if (canEdit) {
                        const toggleTitle = row.active ? 'Desactivar' : 'Activar';
                        const toggleIcon = row.active ? 'ti-archive' : 'ti-archive-off';
                        menuItems += `
                            <li><button type="button" class="dropdown-item quick-add-establishment-experience-btn" data-id="${id}" data-name="${row.name}"><i class="ti ti-plus me-2"></i>Agregar experiencia rápida</button></li>
                            <li><button type="button" class="dropdown-item toggle-establishment-status-btn" data-id="${id}" data-current-status="${row.active}" data-name="${row.name}"><i class="ti ${toggleIcon} me-2"></i>${toggleTitle}</button></li>
                            <li><button type="button" class="dropdown-item convert-to-provider-btn" data-id="${id}" data-name="${row.name}"><i class="ti ti-building-store me-2"></i>Convertir a proveedor</button></li>`;
                    }
                    if (canDelete) {
                        menuItems += `
                            <li><hr class="dropdown-divider"></li>
                            <li><button type="button" class="dropdown-item text-danger delete-establishment-btn" data-id="${id}" data-name="${row.name}"><i class="ti ti-trash me-2"></i>Eliminar</button></li>`;
                    }
                    const menu = (showActions && menuItems) ? `
                        <div class="dropdown flex-shrink-0">
                            <button class="btn btn-sm btn-link text-muted p-0 px-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Acciones">
                                <i class="ti ti-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">${menuItems}</ul>
                        </div>` : '';

                    return `
                        <div class="d-flex justify-content-between align-items-start gap-2 py-1">
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="fw-semibold text-truncate">${row.name || '-'}</div>
                                <div class="small text-muted">${countLabel}</div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                ${status}
                                ${menu}
                            </div>
                        </div>`;
                }
            }
        ],
        order: [],
        ordering: false,
        pageLength: 10,
        language: {
            url: '/assets/vendor/datatables/es-ES.json'
        },
        // Lista angosta: sin colapso responsive; búsqueda arriba, tabla, info+paginación
        responsive: false,
        dom: '<"mb-2"f>rt<"d-flex flex-wrap justify-content-between align-items-center mt-2 gap-2"ip>',
        drawCallback: function() {
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
            console.log('✅ Establishments DataTable drawn successfully');
        }
        });

        // Edit establishment
        $(`#${tableId}`).on('click', '.edit-establishment-btn', function() {
            const establishmentId = $(this).data('id');
            console.log('📝 Edit establishment:', establishmentId);
            loadEstablishmentData(establishmentId);
        });

        // Bandeja: click en una fila abre su detalle a la derecha
        $(`#${tableId} tbody`).on('click', 'tr', function(e) {
            if ($(e.target).closest('button, a, .btn-group, .dtr-control').length) return;
            const rowData = dataTable.row(this).data();
            if (!rowData) return;
            const id = rowData.id || rowData.objectId;
            if (!id) return;
            $(`#${tableId} tbody tr`).removeClass('table-active');
            $(this).addClass('table-active');
            loadEstablishmentData(id);
        });

        // Cerrar el panel de detalle -> volver al estado vacío
        $('#closeEstablishmentDetailBtn').on('click', function() { closeEstablishmentDetail(); });

        function closeEstablishmentDetail() {
            $('#establishmentDetailBody').hide();
            $('#establishmentDetailEmpty').removeClass('d-none').addClass('d-flex');
            $(`#${tableId} tbody tr`).removeClass('table-active');
        }

        // Toggle establishment status
        $(`#${tableId}`).on('click', '.toggle-establishment-status-btn', function() {
            const establishmentId = $(this).data('id');
            const establishmentName = $(this).data('name');
            const currentStatus = $(this).data('current-status');
            const newStatus = !currentStatus;
            const actionText = newStatus ? 'activar' : 'desactivar';
            
            console.log(`🔄 Toggle establishment ${establishmentId}: ${actionText}`);
            
            // Show confirmation
            if (confirm(`¿Está seguro de que desea ${actionText} este establecimiento?`)) {
                $.ajax({
                    url: `${apiEndpoint}/${establishmentId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ active: newStatus }),
                    success: function(response) {
                        if (response.success) {
                            dataTable.ajax.reload(null, false);
                            showSuccessAlert(`Establecimiento ${actionText}do exitosamente`);
                        }
                    },
                    error: function(xhr) {
                        const error = xhr.responseJSON?.error || 'Error al cambiar el estado del establecimiento';
                        showErrorAlert(error);
                    }
                });
            }
        });

        // Quick add establishment experience
        $(`#${tableId}`).on('click', '.quick-add-establishment-experience-btn', function() {
            const establishmentId = $(this).data('id');
            const establishmentName = $(this).data('name');
            console.log('➕ Quick add experience for establishment:', establishmentId, establishmentName);
            openQuickAddEstablishmentExperienceModal(establishmentId, establishmentName);
        });

        // Manage establishment images
        $(`#${tableId}`).on('click', '.manage-establishment-images-btn', function() {
            const establishmentId = $(this).data('id');
            const establishmentName = $(this).data('name');
            console.log('📸 Manage images for establishment:', establishmentId, establishmentName);
            
            // Open the experience images modal (same as providers)
            if (typeof window.openExperienceImagesModal === 'function') {
                window.openExperienceImagesModal(establishmentId, establishmentName);
            } else {
                console.error('❌ openExperienceImagesModal function not found');
                showErrorAlert('Error: Función de gestión de imágenes no disponible');
            }
        });

        // Delete establishment
        $(`#${tableId}`).on('click', '.delete-establishment-btn', function() {
            const establishmentId = $(this).data('id');
            const establishmentName = $(this).data('name');
            console.log('🗑️ Delete establishment:', establishmentId, establishmentName);
            
            if (confirm(`¿Está seguro que desea eliminar el establecimiento "${establishmentName}"? Esta acción no se puede deshacer.`)) {
                // Disable the button to prevent double-clicks
                const btn = $(this);
                const originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="ti ti-loader"></i>');
                
                $.ajax({
                    url: `/api/experiences/${establishmentId}`,
                    method: 'DELETE',
                    success: function(response) {
                        console.log('✅ Establishment deleted successfully:', response);
                        dataTable.ajax.reload(null, false);
                        showSuccessAlert(`Establecimiento "${establishmentName}" eliminado exitosamente`);
                    },
                    error: function(xhr) {
                        console.error('❌ Error deleting establishment:', xhr);
                        const error = xhr.responseJSON?.error || 'Error al eliminar el establecimiento';
                        showErrorAlert(error);
                    },
                    complete: function() {
                        // Re-enable button
                        btn.prop('disabled', false).html(originalHtml);
                    }
                });
            }
        });

        // Create new establishment
        $('#createEstablishmentBtn').on('click', function() {
            console.log('➕ Create new establishment');
            openEstablishmentModal();
        });

        // Add new establishment experience
        $('#addEstablishmentExperienciaBtn').on('click', function() {
            console.log('➕ Adding new establishment experience');
            addEstablishmentExperiencia();
        });

        // CRITICAL: Modal close event listeners to reset state and cancel requests
        $('#establishmentModal').on('hidden.bs.modal', function() {
            console.log('🚫 Modal closed - resetting state and cancelling requests');
            
            // Cancel any pending requests
            if (pendingEstablishmentRequests.establishment) {
                console.log('🚨 Cancelling pending establishment request on modal close');
                pendingEstablishmentRequests.establishment.abort();
                pendingEstablishmentRequests.establishment = null;
            }
            if (pendingEstablishmentRequests.experiences) {
                console.log('🚨 Cancelling pending experiences request on modal close');
                pendingEstablishmentRequests.experiences.abort();
                pendingEstablishmentRequests.experiences = null;
            }
            
            // Reset modal state
            currentModalState = {
                mode: null,
                establishmentId: null,
                isOpen: false,
                sessionId: null
            };
            
            // Clear deleted experiences tracking
            deletedExperienceIds = [];
            
            console.log('✅ Modal state reset:', currentModalState);
            console.log('✅ Deleted experiences queue cleared');
        });

        // Event delegation for experience management
        $(document).on('click', '.delete-experiencia-btn', function() {
            const experienciaCard = $(this).closest('.experiencia-editable');
            const index = experienciaCard.data('index');
            const experienceId = experienciaCard.data('id');
            
            console.log('🗑️ Deleting establishment experience:', {
                index: index,
                experienceId: experienceId,
                hasId: !!experienceId
            });
            
            // Track deleted experience ID if it's an existing experience
            if (experienceId && experienceId !== '') {
                deletedExperienceIds.push(experienceId);
                console.log('📝 Added to deletion queue:', experienceId);
                console.log('📋 Current deletion queue:', deletedExperienceIds);
            }
            
            experienciaCard.fadeOut(300, function() {
                $(this).remove();
                updateEstablishmentNoExperienciasMessage();
            });
        });

        // Toggle availability configuration
        $(document).on('click', '.toggle-availability-btn', function(e) {
            e.preventDefault();
            const availabilitySection = $(this).closest('.availability-section');
            const summaryView = availabilitySection.find('.availability-summary');
            const contentView = availabilitySection.find('.availability-content');
            
            summaryView.toggle();
            contentView.toggle();
        });

        // Day selection for availability
        $(document).on('click', '.day-btn', function(e) {
            e.preventDefault();
            const button = $(this);
            const isSelected = button.hasClass('btn-warning');
            
            if (isSelected) {
                button.removeClass('btn-warning').addClass('btn-outline-warning');
            } else {
                button.removeClass('btn-outline-warning').addClass('btn-warning');
            }
            
            updateEstablishmentSelectedDays(button.closest('.availability-section'));
        });

        // Add time slot
        $(document).on('click', '.add-slot-btn', function(e) {
            e.preventDefault();
            const container = $(this).siblings('.time-slots-container');
            const newSlot = `
                <div class="time-slot d-flex gap-2 mb-1">
                    <input type="time" class="form-control form-control-sm start-time" value="09:00">
                    <span class="align-self-center">a</span>
                    <input type="time" class="form-control form-control-sm end-time" value="18:00">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-slot-btn">
                        <i class="ti ti-minus"></i>
                    </button>
                </div>
            `;
            container.append(newSlot);
        });

        // Remove time slot
        $(document).on('click', '.remove-slot-btn', function(e) {
            e.preventDefault();
            const timeSlot = $(this).closest('.time-slot');
            const container = timeSlot.closest('.time-slots-container');
            
            if (container.find('.time-slot').length > 1) {
                timeSlot.remove();
            } else {
                showErrorAlert('Debe mantener al menos un horario por día');
            }
        });

        // Remove day schedule
        $(document).on('click', '.remove-day-btn', function(e) {
            e.preventDefault();
            const dayNumber = $(this).data('day');
            const daySchedule = $(this).closest('.day-schedule');
            const availabilitySection = daySchedule.closest('.availability-section');
            
            // Remove the day schedule
            daySchedule.remove();
            
            // Unselect the day button
            availabilitySection.find(`.day-btn[data-day="${dayNumber}"]`)
                .removeClass('btn-warning').addClass('btn-outline-warning');
            
            // Update display
            updateEstablishmentSelectedDays(availabilitySection);
        });

        // Photo upload event handlers
        $(document).on('click', '.add-photo-btn', function(e) {
            e.preventDefault();
            $(this).closest('.experience-photos-container').find('.experience-photo-input').click();
        });

        $(document).on('change', '.experience-photo-input', function() {
            const card = $(this).closest('.experiencia-editable');
            const files = this.files;
            const previewContainer = card.find('.photos-preview-container');
            
            // Process each selected file
            Array.from(files).forEach(file => {
                // Validate file type
                if (!file.type.match(/^image\/(jpeg|jpg|png|webp)$/)) {
                    showErrorAlert(`La imagen "${file.name}" no tiene un formato válido.`);
                    return;
                }

                // Create preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    addEstablishmentPhotoPreview(previewContainer, file, e.target.result);
                };
                reader.readAsDataURL(file);
            });
            
            // Clear the input so same file can be selected again
            $(this).val('');
        });

        // Remove photo handler
        $(document).on('click', '.remove-photo-btn', function(e) {
            e.preventDefault();
            $(this).closest('.photo-preview').fadeOut(300, function() {
                $(this).remove();
            });
        });

        // Save establishment experience handler
        $('#quickAddEstablishmentExperienceSaveBtn').on('click', function() {
        console.log('💾 Saving establishment experience...');
        
        const establishmentId = $('#quickAddEstablishmentId').val();
        const formData = {
            name: $('#quickEstablishmentExperienciaName').val().trim(),
            description: $('#quickEstablishmentExperienciaDescription').val().trim(),
            price: parseFloat($('#quickEstablishmentExperienciaPrice').val()) || 0,
