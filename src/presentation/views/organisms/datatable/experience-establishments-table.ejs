            // Crear: info del establecimiento abierta (hay que llenarla). Editar: colapsada.
            setEstablishmentInfo(!isEdit);
            
            // Load POI options for Destino selectbox
            loadEstablishmentDestinoOptions();

            // Bandeja: mostrar el panel de detalle inline (sin overlay modal).
            // El estado vacío usa .d-flex (display:flex !important): se alterna
            // .d-flex/.d-none para ocultarlo/mostrarlo de forma confiable.
            $('#establishmentDetailEmpty').removeClass('d-flex').addClass('d-none');
            $('#establishmentDetailBody').show();
            $('#establishmentDetailScroll').scrollTop(0);
            const detailCard = document.getElementById('establishmentDetailCard');
            if (detailCard && window.innerWidth < 992) {
