        function addEstablishmentPhotoPreview(container, file, dataUrl, photoDataOrMetadata) {
            const photoId = Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            
            
            // Handle both old format (just metadata) and new format (full photo object)
            let optimizationMetadata = null;
            let fullPhotoData = null;
            
            if (photoDataOrMetadata) {
                // If it's an object with any of the expected photo properties, it's the full photo object
                if (typeof photoDataOrMetadata === 'object' && 
                    (photoDataOrMetadata.s3Key || 
                     photoDataOrMetadata.optimizationMetadata !== undefined ||
                     photoDataOrMetadata.optimizedVariants ||
                     photoDataOrMetadata.fileName)) {
                    fullPhotoData = photoDataOrMetadata;
                    optimizationMetadata = photoDataOrMetadata.optimizationMetadata;
                } else {
                    // Otherwise it's just the metadata (for backwards compatibility)
                    optimizationMetadata = photoDataOrMetadata;
                }
            }
            
            // Check optimization metadata for format count - ALWAYS show badge
            let formatBadge = '';
            let formatInfo = '';
            let badgeClass = '';
            let iconClass = '';
            let tooltipText = '';
            
            // Check if it's a new upload (base64 image)
            if (dataUrl && dataUrl.startsWith('data:')) {
                formatInfo = 'Nuevo - No guardado';
                badgeClass = 'bg-warning';
                iconClass = 'ti-upload';
                tooltipText = 'Se optimizará al guardar';
            } 
            // Check optimization metadata
            else if (optimizationMetadata && (optimizationMetadata.availableFormats || optimizationMetadata.formats || fullPhotoData?.optimizedVariants)) {
                // Handle different format data structures (matching experience-images-modal.js)
                let formatCount = 0;
                
                if (fullPhotoData?.optimizedVariants) {
                    // Count non-null variants from optimizedVariants object
                    formatCount = Object.keys(fullPhotoData.optimizedVariants).filter(key => 
                        fullPhotoData.optimizedVariants[key] && key !== 'original'
                    ).length;
                } else if (optimizationMetadata.formats && typeof optimizationMetadata.formats === 'object' && !Array.isArray(optimizationMetadata.formats)) {
                    // Count formats in metadata (object with avif, webp, jpeg keys)
                    formatCount = Object.keys(optimizationMetadata.formats).filter(key => 
                        optimizationMetadata.formats[key] && key !== 'original'
                    ).length;
                } else if (optimizationMetadata.availableFormats && Array.isArray(optimizationMetadata.availableFormats)) {
                    // Legacy array format
                    formatCount = optimizationMetadata.availableFormats.filter(f => f !== 'original').length;
                }
                
                if (formatCount > 0) {
                    formatInfo = `${formatCount} formatos`;
                    badgeClass = 'bg-success';
                    iconClass = 'ti-photo';
                    
                    // Generate tooltip with available formats
                    let availableFormatsList = [];
                    if (fullPhotoData?.optimizedVariants) {
                        availableFormatsList = Object.keys(fullPhotoData.optimizedVariants).filter(key => 
                            fullPhotoData.optimizedVariants[key] && key !== 'original'
                        );
                    } else if (optimizationMetadata.formats && typeof optimizationMetadata.formats === 'object' && !Array.isArray(optimizationMetadata.formats)) {
                        availableFormatsList = Object.keys(optimizationMetadata.formats).filter(key => 
                            optimizationMetadata.formats[key] && key !== 'original'
                        );
                    } else if (optimizationMetadata.availableFormats && Array.isArray(optimizationMetadata.availableFormats)) {
                        availableFormatsList = optimizationMetadata.availableFormats.filter(f => f !== 'original');
                    }
                    
                    tooltipText = `Optimizado: ${availableFormatsList.join(', ').toUpperCase()}`;
                } else {
                    // Has metadata but 0 formats (optimization may have failed or not completed)
                    formatInfo = '0 formatos';
                    badgeClass = 'bg-danger';
                    iconClass = 'ti-x';
                    tooltipText = 'No hay formatos optimizados disponibles';
                }
            } 
            // No metadata and not base64 (old image without optimization)
            else {
                // Check if it's an S3 URL (legacy upload before optimization)
                if (dataUrl && (dataUrl.includes('amazonaws.com') || dataUrl.includes('http'))) {
                    formatInfo = 'Heredado - Sin optimización';
                    badgeClass = 'bg-secondary';
                    iconClass = 'ti-photo-off';
                    tooltipText = 'Subido antes de la implementación de optimización. Vuelva a subir para optimizar.';
                } else {
                    formatInfo = 'Desconocido';
                    badgeClass = 'bg-dark';
                    iconClass = 'ti-question-mark';
                    tooltipText = 'Formato de imagen desconocido';
                }
            }
            
            // Always create a badge
            formatBadge = `
                <span class="position-absolute top-0 start-0 m-1 badge ${badgeClass}" 
                      style="font-size: 0.65rem; z-index: 10;"
                      data-bs-toggle="tooltip" 
                      data-bs-placement="bottom" 
                      title="${tooltipText}">
                    <i class="ti ${iconClass} me-1" style="font-size: 0.7rem;"></i>${formatInfo}
                </span>
            `;
            
            const fileName = file?.name || fullPhotoData?.fileName || 'imagen';
            
            // HTML escape the dataUrl to prevent parameter corruption
            const escapedDataUrl = dataUrl
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#x27;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
            
            const photoHtml = `
                <div class="col-6 col-md-4 col-lg-3 photo-preview" 
                     data-photo-id="${photoId}"
                     ${fullPhotoData ? `data-photo-full='${JSON.stringify(fullPhotoData).replace(/'/g, '&#39;')}'` : ''}>
                    <div class="card position-relative">
                        ${formatBadge}
                        <img src="${escapedDataUrl}" loading="lazy" class="card-img-top" style="height: 120px; object-fit: cover;" alt="${fileName}">
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted text-truncate me-2" title="${fileName}">${fileName}</small>
                                <button type="button" class="btn btn-sm btn-outline-danger remove-photo-btn" title="Eliminar foto">
                                    <i class="ti ti-x"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            container.append(photoHtml);
            
            
            // Initialize the new tooltip
            const newElement = container.find(`[data-photo-id="${photoId}"]`).last();
            newElement.find('[data-bs-toggle="tooltip"]').tooltip();
            
            // Store file data for later upload
            if (file) {
                newElement.data('file', file);
                newElement.data('dataUrl', dataUrl);
            }
        }

        function collectEstablishmentExperienciasData() {
            // CRITICAL: Validate modal state before collecting data
            if (!currentModalState.isOpen) {
                console.warn('🚨 Modal not open - refusing to collect experience data');
                return [];
            }
            
            // CRITICAL: Mode-aware validation - create mode allows null establishmentId, edit mode requires it
            if (!currentModalState.mode) {
                console.warn('🚨 No modal mode - refusing to collect experience data', currentModalState);
                return [];
            }
            
            if (currentModalState.mode === 'edit' && !currentModalState.establishmentId) {
                console.warn('🚨 Edit mode but no establishmentId - refusing to collect experience data', currentModalState);
                return [];
            }
            
            console.log('✅ Experience collection validation passed for mode:', currentModalState.mode);
            
            const experiencias = [];
            const experienciaCards = document.querySelectorAll('#establishmentExperienciasList .experiencia-editable');
            
            experienciaCards.forEach((card, index) => {
                const getName = (selector) => card.querySelector(selector)?.value?.trim() || '';
                const getNumber = (selector) => {
                    const value = card.querySelector(selector)?.value;
                    return value ? parseFloat(value) : null;
                };
                const getInt = (selector) => {
                    const value = card.querySelector(selector)?.value;
                    return value ? parseInt(value) : null;
                };
                
                // Get the experience ID from data-id attribute (empty for new experiences)
                const experienceId = card.getAttribute('data-id') || '';
                
                // CRITICAL: Get original provider ID for existing experiences
                const originalProviderId = card.getAttribute('data-original-provider-id') || '';
                
                // CRITICAL: Defensive validation - check for cross-establishment contamination
                if (experienceId && originalProviderId && originalProviderId !== currentModalState.establishmentId) {
                    console.error('🚨 CRITICAL: Cross-establishment contamination detected in data collection!', {
                        experienceId: experienceId,
                        originalProviderId: originalProviderId,
                        currentEstablishmentId: currentModalState.establishmentId,
                        modalState: currentModalState
                    });
                    // Skip this experience to prevent data corruption
                    console.warn('⚠️ Skipping contaminated experience to protect data integrity');
                    return; // Skip this iteration
                }
                
                const experiencia = {
                    id: experienceId,
                    originalProviderId: originalProviderId, // Track which establishment this experience originally belongs to
                    name: getName('.experiencia-name-input'),
                    description: getName('.experiencia-description-input'),
                    tipo: getName('.experiencia-tipo-input'),
                    price: getNumber('.experiencia-price-input') || 0,
                    price_no_alcohol: getNumber('.experiencia-price-no-alcohol-input'),
                    price_child: getNumber('.experiencia-price-child-input'),
                    duration: getNumber('.experiencia-duration-input'),
                    travel_duration: getInt('.experiencia-travel-duration-input'),
                    advance_booking_time: getInt('.experiencia-advance-minutes-input'),
                    min_people: getInt('.experiencia-min-people-input'),
                    max_people: getInt('.experiencia-max-people-input'),
                    fixed_schedule: card.querySelector('.experiencia-fixed-schedule-input') ? card.querySelector('.experiencia-fixed-schedule-input').checked : false,

                    // Convert strings to arrays (like provider table)
                    includes: getName('.experiencia-includes-input') ? 
                        getName('.experiencia-includes-input').split('\n').map(item => item.trim()).filter(item => item.length > 0) : [],
                    notincludes: getName('.experiencia-notincludes-input') ? 
                        getName('.experiencia-notincludes-input').split('\n').map(item => item.trim()).filter(item => item.length > 0) : [],
                    languages: getName('.experiencia-languages-input') ? 
                        getName('.experiencia-languages-input').split('\n').map(item => item.trim()).filter(item => item.length > 0) : [],
                    
                    internal_notes: getName('.experiencia-internal-notes-input'),
                    client_booking_notes: getName('.experiencia-client-booking-notes-input'),
                    provider_notes: getName('.experiencia-provider-notes-input'),
                    team_notes: getName('.experiencia-team-notes-input')
                };

                // Collect photos with optimization metadata preservation
                const photoElements = card.querySelectorAll('.photos-preview-container .photo-preview');
                if (photoElements.length > 0) {
                    experiencia.photos = [];
                    photoElements.forEach(photoEl => {
                        const img = $(photoEl).find('img');
                        if (img.length > 0) {
                            const photoElement = $(photoEl);
                            const photoFullData = photoElement.attr('data-photo-full');
                            
                            // If we have full photo data stored, use it (preserves optimization metadata)
                            if (photoFullData) {
                                try {
                                    const fullData = JSON.parse(photoFullData.replace(/&#39;/g, "'"));
                                    // Update the dataUrl in case the image was refreshed with a new presigned URL
                                    fullData.dataUrl = img.attr('src');
                                    experiencia.photos.push(fullData);
                                } catch (e) {
                                    console.warn('Failed to parse photo full data, falling back to basic data:', e);
                                    // Fallback to basic data
                                    const photoData = photoElement.data('file');
                                    const dataUrl = photoElement.data('dataUrl') || img.attr('src');
                                    
                                    experiencia.photos.push({
                                        dataUrl: dataUrl,
                                        fileName: photoData ? photoData.name : 'image.jpg',
                                        isNew: !!(photoData && dataUrl && dataUrl.startsWith('data:'))
                                    });
                                }
                            } else {
                                // No full data, use basic data
                                const photoData = photoElement.data('file');
                                const dataUrl = photoElement.data('dataUrl') || img.attr('src');
                                
                                experiencia.photos.push({
                                    dataUrl: dataUrl,
                                    fileName: photoData ? photoData.name : 'image.jpg',
                                    isNew: !!(photoData && dataUrl && dataUrl.startsWith('data:'))
                                });
                            }
                        }
                    });
                }
                
                // Collect availability data
                const availabilitySection = card.querySelector('.availability-section');
                if (availabilitySection) {
                    const selectedDays = availabilitySection.querySelectorAll('.day-schedule');
                    if (selectedDays.length > 0) {
                        experiencia.availability = [];
                        selectedDays.forEach(daySchedule => {
                            const day = daySchedule.getAttribute('data-day');
                            const timeSlots = daySchedule.querySelectorAll('.time-slot');
                            timeSlots.forEach(slot => {
                                const startTime = slot.querySelector('.start-time').value;
                                const endTime = slot.querySelector('.end-time').value;
                                if (startTime && endTime) {
                                    experiencia.availability.push({
                                        day: parseInt(day),
                                        start_time: startTime,
                                        end_time: endTime
                                    });
                                }
                            });
                        });
                    }
                }
                
                experiencias.push(experiencia);
            });
            
            return experiencias;
        }

