            if (pendingEstablishmentRequests.establishment) {
                console.log('🚨 Cancelling pending establishment request');
                pendingEstablishmentRequests.establishment.abort();
                pendingEstablishmentRequests.establishment = null;
            }
            if (pendingEstablishmentRequests.experiences) {
                console.log('🚨 Cancelling pending experiences request');
                pendingEstablishmentRequests.experiences.abort();
                pendingEstablishmentRequests.experiences = null;
            }
            
            // Set modal state with unique session ID
            const sessionId = Date.now() + '_' + Math.random().toString(36).substr(2, 9);
