                    </div>
                    
                    <div class="experiencia-selected-schedule-days mb-2"></div>
                    
                    <div class="experiencia-no-days-selected text-center text-muted py-2 border rounded bg-light" style="font-size: 1rem;">
                        <i class="ti ti-calendar-off me-1"></i>
                        <small>Selecciona días para configurar horarios</small>
                    </div>
                </div>
            </div>
            
            <!-- Fotos de la experiencia -->
            <div class="mb-2">
                <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">
                    Fotos <span class="text-muted">(Opcional)</span>
                </label>
                <div class="experience-photos-container">
                    <!-- Photo upload section -->
                    <div class="row g-2 mb-2 photos-preview-container">
                        <!-- Uploaded photos will be displayed here -->
                    </div>
                    
                    <!-- Add photo button -->
                    <div class="d-grid">
                        <button type="button" class="btn btn-outline-warning btn-sm add-photo-btn">
                            <i class="ti ti-camera-plus me-1"></i>
                            Agregar Foto
                        </button>
                    </div>
                    
                    <!-- Hidden file input -->
                    <input type="file" 
                           class="d-none experience-photo-input" 
                           accept=".jpg,.jpeg,.png,.webp" 
                           multiple>
                </div>
                <div class="form-text">
                    <small><i class="ti ti-info-circle me-1"></i>Formatos: JPG, PNG, WebP</small>
                </div>
            </div>

            <!-- Notas (4 campos) -->
            <div class="row">
                <div class="col-md-6">
                    <!-- Notas internas -->
                    <div class="mb-2">
                        <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">
                            <i class="ti ti-notes me-1"></i>Notas internas <span class="text-muted">(Uso interno)</span>
                        </label>
                        <textarea class="form-control experiencia-internal-notes-input" 
                                  rows="3"
                                  placeholder="Notas para uso exclusivo interno del equipo..."
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                        <div class="form-text">
                            <small><i class="ti ti-eye-off me-1"></i>Solo visible para el equipo interno</small>
