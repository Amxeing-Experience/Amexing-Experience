        // Make functions globally accessible for button clicks
        window.openQuickAddEstablishmentExperienceModal = openQuickAddEstablishmentExperienceModal;
        window.openEstablishmentModal = openEstablishmentModal;

        // Load establishment data for editing
        function loadEstablishmentData(establishmentId) {
            console.log('📂 Loading establishment data:', establishmentId);
            
            // CRITICAL: Cancel any pending requests to prevent race conditions
            if (pendingEstablishmentRequests.establishment) {
                console.log('🚨 Cancelling pending establishment request');
                pendingEstablishmentRequests.establishment.abort();
                pendingEstablishmentRequests.establishment = null;
            }
            if (pendingEstablishmentRequests.experiences) {
                console.log('🚨 Cancelling pending experiences request');
                pendingEstablishmentRequests.experiences.abort();
                pendingEstablishmentRequests.experiences = null;
            }
            
            openEstablishmentModal(true, establishmentId);

            // Carga las experiencias EN PARALELO al fetch del establecimiento, para
            // mostrar el spinner de inmediato (en vez de la lista vacía mientras
            // llega el primer request). openEstablishmentModal ya dejó el estado en
            // 'edit' con este id, así que la validación interna pasa.
            loadEstablishmentExperiencias(establishmentId);

            // Show loading state in modal
            $('#establishmentModalAlerts').html(`
                <div class="alert alert-info">
                    <i class="spinner-border spinner-border-sm me-2"></i>Cargando datos del establecimiento...
                </div>
            `);

            // Track the establishment request
            pendingEstablishmentRequests.establishment = $.ajax({
                url: `${apiEndpoint}/${establishmentId}`,
                type: 'GET',
                success: function(response) {
                    // Clear the request reference
                    pendingEstablishmentRequests.establishment = null;
                    if (response.success && response.data) {
                        const establishment = response.data;
                        
                        // Populate form fields
                        $('#establishmentId').val(establishment.id);
                        $('#establishmentName').val(establishment.name);
                        $('#establishmentDescription').val(establishment.description || '');
                        
                        // Populate destinationPOI field — guarda el destino como "pendiente"
                        // y lo aplica. Se re-aplica solo tras cada repoblado del catálogo
                        // (a prueba de timing y de POIs que no estén en la lista activa).
                        if (establishment.destinationPOI && establishment.destinationPOI.id) {
                            pendingEstablishmentDestino = {
                                id: establishment.destinationPOI.id,
                                name: establishment.destinationPOI.name || establishment.destinationPOI.id,
                            };
                            console.log('📍 Loaded destinationPOI:', pendingEstablishmentDestino.name);
                        } else {
                            pendingEstablishmentDestino = null;
                            $('#establishmentDestino').val('');
                        }
                        applyEstablishmentDestino();
                        
                        // Clear loading message
                        $('#establishmentModalAlerts').html('');
                        // (Las experiencias ya se cargan en paralelo desde loadEstablishmentData)
                    } else {
                        showEstablishmentError('Formato de respuesta inválido');
                    }
                },
                error: function(xhr) {
                    // Clear the request reference
                    pendingEstablishmentRequests.establishment = null;
                    
                    // Only show error if request wasn't aborted (to prevent race condition errors)
                    if (xhr.statusText !== 'abort') {
                        showEstablishmentError(xhr.responseJSON?.error || 'Error al cargar el establecimiento');
                    }
                }
            });
        }

        // Load establishment experiences
        function loadEstablishmentExperiencias(establishmentId, onRendered) {
            if (!establishmentId) return;
            
            console.log('📦 Loading establishment experiences:', establishmentId);
            
            // CRITICAL: Validate modal state before loading experiences
            if (currentModalState.mode !== 'edit' || currentModalState.establishmentId !== establishmentId) {
                console.warn('🚨 Modal state mismatch - skipping experience load', {
                    requestedEstablishmentId: establishmentId,
                    currentModalState: currentModalState
                });
                return;
            }
            
            // Show loader inside the modal while experiencias (and their photo
            // URLs) load, so it never looks frozen/broken.
            $('#noEstablishmentExperienciasMessage').hide();
            $('#establishmentExperienciasList .experiencia-editable').remove();
            if (!$('#establishmentExperienciasLoader').length) {
                $('#establishmentExperienciasList').append(`
                    <div id="establishmentExperienciasLoader" class="text-center text-muted py-4">
                        <div class="spinner-border text-primary mb-2" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mb-0">Cargando experiencias...</p>
                    </div>
                `);
            }

            // Track the experiences request
            pendingEstablishmentRequests.experiences = $.ajax({
                url: `/api/providers/${establishmentId}/experiencias`,
                type: 'GET',
                headers: {
                    'Accept': 'image/avif;q=1.0,image/webp;q=0.9,image/jpeg;q=0.8,image/*;q=0.5,application/json'
                },
                success: function(response) {
                    // Clear the request reference
                    pendingEstablishmentRequests.experiences = null;
                    
                    // CRITICAL: Validate modal state hasn't changed during request
                    if (currentModalState.mode !== 'edit' || currentModalState.establishmentId !== establishmentId) {
                        console.warn('🚨 Modal state changed during experience load - ignoring response', {
                            requestedEstablishmentId: establishmentId,
                            currentModalState: currentModalState
                        });
                        return;
                    }
                    
                    if (response.success && response.data && response.data.length > 0) {
                        console.log(`✅ Loaded ${response.data.length} experiences`);
                        
                        // Clear the no experiences message
                        const container = document.getElementById('establishmentExperienciasList');
                        container.innerHTML = '';
                        
                        // Render each experience
                        response.data.forEach((exp, index) => {
                            renderEstablishmentExperienciaCard(exp, index);
                        });

                        updateEstablishmentNoExperienciasMessage();
                    } else {
                        console.log('ℹ️ No experiences found for establishment');
                    }
                },
                error: function(xhr, status, error) {
                    // Clear the request reference
                    pendingEstablishmentRequests.experiences = null;
                    
                    // Don't log aborted requests as errors (they're intentional cancellations)
                    if (status === 'abort') {
                        console.log('🚫 Experience load request aborted (intentional cancellation)');
                        return;
                    }
                    
                    console.error('❌ Error loading establishment experiences:', { xhr, status, error });
                    // Not critical - establishment can exist without experiences
                },
                complete: function() {
                    // Runs on success, error and abort: always clear the spinner.
                    $('#establishmentExperienciasLoader').remove();
                    updateEstablishmentNoExperienciasMessage();
                    // onRendered SIEMPRE corre al terminar (con o sin datos), para que
                    // quien recarga (p.ej. el guardado) sepa que el reload ya acabó.
                    if (typeof onRendered === 'function') {
                        try { onRendered(); } catch (e) { console.error('onRendered callback error:', e); }
                    }
                }
            });
        }

        // Render experience card from loaded data
        function renderEstablishmentExperienciaCard(experiencia, index) {
            const template = document.getElementById('establishmentExperienciaEditableTemplate');
            const clone = template.content.cloneNode(true);
            const card = clone.querySelector('.experiencia-editable');
            
            card.setAttribute('data-index', index);
            card.setAttribute('data-id', experiencia.id || '');

            // Poblar el resumen de la cabecera del acordeón (nombre / precio / tipo)
            syncEstablishmentHeader(card, experiencia);

            // CRITICAL: Store original provider ID to prevent cross-establishment updates
            if (experiencia.provider && experiencia.provider.id) {
                card.setAttribute('data-original-provider-id', experiencia.provider.id);
                console.log('🔍 DEBUGGING: Setting original provider ID', {
                    experienceId: experiencia.id,
                    experienceName: experiencia.name,
                    originalProviderId: experiencia.provider.id
                });
            }
            
            // Populate form fields
            card.querySelector('.experiencia-name-input').value = experiencia.name || '';
            card.querySelector('.experiencia-description-input').value = experiencia.description || '';
            card.querySelector('.experiencia-tipo-input').value = experiencia.tipo || experiencia.providerType || '';
            card.querySelector('.experiencia-price-input').value = experiencia.price || '';
            card.querySelector('.experiencia-price-no-alcohol-input').value = experiencia.price_no_alcohol || '';
            card.querySelector('.experiencia-price-child-input').value = experiencia.price_child || '';
            
            // Handle duration
            if (experiencia.duration) {
                const duration = parseFloat(experiencia.duration);
                card.querySelector('.experiencia-duration-input').value = duration > 24 ? (duration / 60).toFixed(1) : duration;
            }
            
            card.querySelector('.experiencia-travel-duration-input').value = experiencia.travel_duration || '';
            card.querySelector('.experiencia-advance-minutes-input').value = experiencia.advance_booking_time || '';
            card.querySelector('.experiencia-min-people-input').value = experiencia.min_people || '';
            card.querySelector('.experiencia-max-people-input').value = experiencia.max_people || '';
            const establishmentFixedScheduleInput = card.querySelector('.experiencia-fixed-schedule-input');
            if (establishmentFixedScheduleInput) establishmentFixedScheduleInput.checked = !!experiencia.fixed_schedule;
            card.querySelector('.experiencia-includes-input').value = Array.isArray(experiencia.includes) 
                ? experiencia.includes.join('\n') 
                : (experiencia.includes || '');
            card.querySelector('.experiencia-notincludes-input').value = Array.isArray(experiencia.notincludes) 
                ? experiencia.notincludes.join('\n') 
                : (experiencia.notincludes || '');
            card.querySelector('.experiencia-languages-input').value = Array.isArray(experiencia.languages) 
                ? experiencia.languages.join('\n') 
                : (experiencia.languages || '');
            card.querySelector('.experiencia-internal-notes-input').value = experiencia.internal_notes || '';
            card.querySelector('.experiencia-client-booking-notes-input').value = experiencia.client_booking_notes || '';
            card.querySelector('.experiencia-provider-notes-input').value = experiencia.provider_notes || '';
            card.querySelector('.experiencia-team-notes-input').value = experiencia.team_notes || '';
            
            // Handle photos with optimization metadata
            if (experiencia.photos && experiencia.photos.length > 0) {
                const photosContainer = card.querySelector('.photos-preview-container');
                experiencia.photos.forEach((photo, photoIndex) => {
                    
                    // Backend provides presigned URLs in dataUrl field
                    const photoUrl = photo.dataUrl || photo.url;
                    const fileName = photo.fileName || photo.name || 'image';
                    
                    // Check if photoUrl is a raw S3 key instead of a full URL
                    if (photoUrl && !photoUrl.includes('http') && !photoUrl.startsWith('data:')) {
                        console.warn(`⚠️ [ESTABLISHMENTS] Photo ${photoIndex} has raw S3 key instead of URL:`, photoUrl);
                        console.log('📊 [ESTABLISHMENTS] Full photo object:', photo);
                        
                        // Fallback: Try to generate presigned URL from S3 key
                        if (photo.s3Key || photoUrl) {
                            const s3Key = photo.s3Key || photoUrl;
                            console.log('🔧 [ESTABLISHMENTS] Attempting to generate presigned URL for S3 key:', s3Key);
                            
                            // Try to get presigned URL via API
                            tryGetPresignedUrl(s3Key).then(presignedUrl => {
                                if (presignedUrl) {
                                    console.log('✅ [ESTABLISHMENTS] Generated presigned URL:', presignedUrl);
                                    // Update the photo object
                                    photo.dataUrl = presignedUrl;
                                    photo.url = presignedUrl;
                                    // Re-add the photo preview with correct URL
                                    addEstablishmentPhotoPreview($(photosContainer), { name: fileName }, presignedUrl, photo);
                                }
                            }).catch(error => {
                                console.error('❌ [ESTABLISHMENTS] Failed to generate presigned URL:', error);
                                // Still add the preview but it might not load
                                addEstablishmentPhotoPreview($(photosContainer), { name: fileName }, photoUrl, photo);
                            });
                        } else {
                            // No S3 key available, add with original URL (will likely fail)
                            addEstablishmentPhotoPreview($(photosContainer), { name: fileName }, photoUrl, photo);
                        }
                    } else if (photoUrl) {
                        // URL looks good, proceed normally
                        addEstablishmentPhotoPreview($(photosContainer), { name: fileName }, photoUrl, photo);
                    }
                });
            }
            
            // Handle availability
            if (experiencia.availability && experiencia.availability.length > 0) {
                const availabilitySection = card.querySelector('.availability-section');
                populateEstablishmentAvailability($(availabilitySection), experiencia.availability);
            }
            
            // Add to container
            document.getElementById('establishmentExperienciasList').appendChild(card);
            updateEstablishmentNoExperienciasMessage();
        }

        // Populate availability interface from data
        function populateEstablishmentAvailability(availabilitySection, availability) {
            if (!availability || availability.length === 0) return;
            
            // Group schedules by day
            const schedulesByDay = {};
            availability.forEach(schedule => {
                if (!schedulesByDay[schedule.day]) {
                    schedulesByDay[schedule.day] = [];
                }
                schedulesByDay[schedule.day].push({
                    start: schedule.start_time,
                    end: schedule.end_time
                });
            });
            
            // Select day buttons and update UI
            Object.keys(schedulesByDay).forEach(day => {
                const dayButton = availabilitySection.find(`.day-btn[data-day="${day}"]`);
                if (dayButton.length > 0) {
                    dayButton.removeClass('btn-outline-warning').addClass('btn-warning');
                }
            });
            
            // Trigger update to show schedules
            updateEstablishmentSelectedDays(availabilitySection);
            
            // Populate time slots for each day
            Object.keys(schedulesByDay).forEach(day => {
                const daySchedule = availabilitySection.find(`.day-schedule[data-day="${day}"]`);
                if (daySchedule.length > 0) {
                    const slotsContainer = daySchedule.find('.time-slots-container');
                    slotsContainer.empty();
                    
                    schedulesByDay[day].forEach(slot => {
                        const slotHtml = `
                            <div class="time-slot d-flex gap-2 mb-1">
                                <input type="time" class="form-control form-control-sm start-time" value="${slot.start}">
                                <span class="align-self-center">a</span>
                                <input type="time" class="form-control form-control-sm end-time" value="${slot.end}">
                                <button type="button" class="btn btn-sm btn-outline-danger remove-slot-btn">
                                    <i class="ti ti-minus"></i>
                                </button>
                            </div>
                        `;
                        slotsContainer.append(slotHtml);
                    });
                }
            });
        }

        // Conversion handlers
        let conversionItemId = null;
        let conversionItemName = null;
        
        // Function to open conversion modal
        function openConversionModal(id, name) {
            conversionItemId = id;
            conversionItemName = name;
            $('#conversionItemName').text(name);
            $('#conversionModal').modal('show');
        }
        
        // Handle conversion button click
        $(document).on('click', '.convert-to-provider-btn', function() {
            const id = $(this).data('id');
            const name = $(this).data('name');
            openConversionModal(id, name);
        });
        
        // Handle conversion confirmation
        $('#confirmConversionBtn').on('click', async function() {
            if (!conversionItemId) return;
            
            const $btn = $(this);
            const originalHtml = $btn.html();
            
            try {
                // Show loading state
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Convirtiendo...');
                
                // Make API call to update type
                const response = await $.ajax({
                    url: `/api/experiences/${conversionItemId}`,
                    method: 'PUT',
                    headers: {
                        'Authorization': `Bearer ${getAccessToken()}`,
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify({
                        type: 'Provider'
                    })
                });
                
                if (response.success) {
                    // Close modal
                    $('#conversionModal').modal('hide');
                    
                    // Show success message
                    showSuccessAlert(`"${conversionItemName}" ha sido convertido a Proveedor exitosamente.`);
                    
                    // Reload DataTable
                    dataTable.ajax.reload(null, false);
                } else {
                    throw new Error(response.error || 'Error al convertir el establecimiento');
                }
            } catch (error) {
                console.error('Conversion error:', error);
                showErrorAlert(error.responseJSON?.error || error.message || 'Error al convertir el establecimiento');
            } finally {
                // Restore button state
                $btn.prop('disabled', false).html(originalHtml);
                
                // Reset conversion data
                conversionItemId = null;
                conversionItemName = null;
            }
        });

        console.log('✅ Establishments DataTable initialized successfully');
    }

    // Initialize when DOM is ready or immediately if already loaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initEstablishmentsDataTable);
    } else {
        initEstablishmentsDataTable();
    }
})();

// Global alert functions
function showSuccessAlert(message) {
    const alertHtml = `
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="ti ti-check me-2"></i>${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    $('#establishments-content').prepend(alertHtml);
    setTimeout(() => $('.alert').fadeOut(), 5000);
}

function showErrorAlert(message) {
    const alertHtml = `
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="ti ti-x me-2"></i>${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    $('#establishments-content').prepend(alertHtml);
    setTimeout(() => $('.alert').fadeOut(), 8000);
}

</script>

