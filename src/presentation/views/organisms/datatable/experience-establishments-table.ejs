                    $('#establishmentExperienciasList .experiencia-editable').each(function(i) {
                        if (this.classList.contains('experiencia-expanded')) expandedIdx.push(i);
                    });
                    const $estScroll = $('#establishmentDetailScroll');
                    const estScrollTop = $estScroll.scrollTop();

                    if (finalEstablishmentId) {
                        $('#establishmentId').val(finalEstablishmentId);
                        $('#establishmentModalTitle').text('Editar Establecimiento');
                        currentModalState = { mode: 'edit', establishmentId: finalEstablishmentId, isOpen: true, sessionId: currentModalState.sessionId };
                        establishmentReloadPending = true;
                        loadEstablishmentExperiencias(finalEstablishmentId, function() {
                            const cards = document.querySelectorAll('#establishmentExperienciasList .experiencia-editable');
                            expandedIdx.forEach(i => { if (cards[i]) expandEstablishmentCard(cards[i]); });
                            $estScroll.scrollTop(estScrollTop);
                            // Restaurar el botón SOLO cuando el reload realmente terminó
                            restoreSaveBtn();
                        });
                    }
                    showSuccessAlert('Cambios guardados');
                },
                error: function(xhr) {
                    console.error('❌ Error saving establishment:', xhr);
                    const error = xhr.responseJSON?.error || 'Error al guardar el establecimiento';
                    showEstablishmentError(error);
                },
                complete: function() {
                    // Si vamos a recargar subexperiencias (guardar sin cerrar), el botón
                    // se restaura al terminar ese reload, no aquí, para que no parezca
                    // que ya acabó mientras las tarjetas siguen cargando.
                    if (!establishmentReloadPending && totalImagesToOptimize === 0) {
                        saveBtn.prop('disabled', false).html(originalText);
                    }
                    // If there are images being optimized, button will be re-enabled
                    // after optimization completes in the success callback
                }
            });
        });

