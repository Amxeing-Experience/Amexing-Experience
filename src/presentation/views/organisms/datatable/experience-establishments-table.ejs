                mode: isEdit ? 'edit' : 'create',
                establishmentId: establishmentId,
                isOpen: true,
                sessionId: sessionId
            };
            
            // Clear deleted experiences tracking when opening modal
            deletedExperienceIds = [];
            
            console.log('🔍 DEBUGGING: Opening modal with state', currentModalState);
            console.log('✅ Deleted experiences queue cleared for new modal session');
            
            // Clear any previous modal alerts
            const alertsContainer = document.getElementById('establishmentModalAlerts');
            if (alertsContainer) {
                alertsContainer.innerHTML = '';
            }
            
            // Reset form
            document.getElementById('establishmentForm').reset();
            // Limpia el destino pendiente al abrir; el editar lo vuelve a setear tras el GET.
            pendingEstablishmentDestino = null;
            
            // CRITICAL: Enhanced form reset - explicitly clear fields for create mode
            if (!isEdit) {
                $('#establishmentId').val(''); // Ensure no residual ID from previous sessions
                $('#establishmentDestino').val(''); // Ensure no residual destino from previous sessions
                console.log('🧹 Cleared establishmentId and destino fields for create mode');
            }
            
            // Clear experiences list - ENHANCED CLEARING
            const experienciasList = document.getElementById('establishmentExperienciasList');
            if (experienciasList) {
                const experienciaCards = experienciasList.querySelectorAll('.experiencia-editable');
                
                // Enhanced logging for debugging modal state
                if (experienciaCards.length > 0) {
                    console.log('🧹 DEBUGGING: Clearing modal experiences', {
                        isEdit: isEdit,
                        experienceCount: experienciaCards.length,
                        experienceDetails: Array.from(experienciaCards).map(card => ({
                            id: card.getAttribute('data-id'),
                            originalProviderId: card.getAttribute('data-original-provider-id'),
