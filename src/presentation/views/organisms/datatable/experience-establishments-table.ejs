<%
/**
 * Experience Establishments DataTable Organism
 * DataTable component for establishments management
 *
 * Atomic Design Level: Organism
 * Category: Dashboard Data Tables
 *
 * @param {string} tableId - Unique table identifier
 * @param {string} apiEndpoint - API endpoint for data loading
 * @param {string} userRole - Current user role
 * @param {boolean} showActions - Whether to show action buttons
 */

const dtTableId = typeof tableId !== 'undefined' ? tableId : 'experience-establishments-table';
const dtApiEndpoint = typeof apiEndpoint !== 'undefined' ? apiEndpoint : '/api/experiences';
const dtShowActions = typeof showActions !== 'undefined' ? showActions : true;
const dtUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';

const canEdit = ['superadmin', 'admin'].includes(dtUserRole);
const canDelete = ['superadmin', 'admin'].includes(dtUserRole);
const canCreate = ['superadmin', 'admin'].includes(dtUserRole);
%>

<!-- Bandeja master-detail: lista de establecimientos (izquierda) + detalle inline (derecha) -->
<div class="row g-3 establishment-inbox">
    <!-- Columna lista (master) -->
    <div class="col-lg-5 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body" id="establishments-content">
                <table id="<%= dtTableId %>" class="table table-hover establishment-inbox-table mb-0" style="width:100%">
                    <thead class="visually-hidden">
                        <tr>
                            <th>Establecimiento</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Columna detalle (detail) -->
    <div class="col-lg-7 col-xl-8">
        <div class="card border-0 shadow-sm h-100" id="establishmentDetailCard">
            <!-- Estado vacío: ningún establecimiento seleccionado -->
            <div id="establishmentDetailEmpty" class="card-body d-flex flex-column align-items-center justify-content-center text-center text-muted" style="min-height: 420px;">
                <i class="ti ti-hand-click mb-3" style="font-size: 2.5rem; opacity: .4;"></i>
                <h6 class="mb-1">Selecciona un establecimiento</h6>
                <p class="mb-0 small">Elige uno de la lista o crea uno nuevo para ver y editar sus experiencias aquí.</p>
            </div>

            <!-- Detalle del establecimiento (el formulario se reubica aquí en runtime) -->
            <div id="establishmentDetailBody" style="display: none;">
                <div class="card-header d-flex justify-content-between align-items-center" style="background: var(--brand-gradient);">
                    <h5 class="mb-0 text-white">
                        <i class="ti ti-building me-2"></i><span id="establishmentModalTitle">Crear Nuevo Establecimiento</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" id="closeEstablishmentDetailBtn" title="Cerrar" aria-label="Cerrar"></button>
                </div>
                <div class="card-body" id="establishmentDetailScroll" style="max-height: calc(100vh - 230px); overflow-y: auto;">
                    <!-- #establishmentModalAlerts y #establishmentForm se mueven aquí al iniciar -->
                </div>
                <div class="card-footer d-flex justify-content-end gap-2" id="establishmentDetailFooter">
                    <!-- El botón Guardar se mueve aquí al iniciar -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Add Experience Modal for Establishments -->
<div class="modal fade" id="quickAddEstablishmentExperienceModal" tabindex="-1" aria-labelledby="quickAddEstablishmentExperienceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background: var(--brand-gradient);">
                <h5 class="modal-title text-white" id="quickAddEstablishmentExperienceModalLabel">
                    <i class="ti ti-plus me-2"></i>Agregar Experiencia Rápida
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Establishment info -->
                <div class="alert alert-info" role="alert">
                    <i class="ti ti-info-circle me-2"></i>
                    <strong>Establecimiento:</strong> <span id="quickAddEstablishmentName"></span>
                </div>

                <!-- Alert container for modal-specific errors -->
                <div id="quickAddEstablishmentModalAlerts"></div>

                <form id="quickAddEstablishmentExperienceForm">
                    <input type="hidden" id="quickAddEstablishmentId">
                    
                    <!-- Nombre y Tipo -->
                    <div class="row mb-3">
                        <div class="col-md-7">
                            <label for="quickEstablishmentExperienciaName" class="form-label form-label-sm fw-medium text-success">
                                Nombre <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="quickEstablishmentExperienciaName" required maxlength="200" 
                                   placeholder="Ej: Cena Romántica VIP">
                        </div>
                        <div class="col-md-4">
                            <label for="quickEstablishmentExperienciaTipo" class="form-label form-label-sm fw-medium text-success">Tipo</label>
                            <select class="form-select" id="quickEstablishmentExperienciaTipo">
                                <option value="">Seleccionar</option>
                                <option value="Exclusivo">Exclusivo</option>
                                <option value="Compartido">Compartido</option>
                                <option value="Privado">Privado</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Description -->
                    <div class="mb-3">
                        <label for="quickEstablishmentExperienciaDescription" class="form-label form-label-sm fw-medium text-success">
                            Descripción <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="quickEstablishmentExperienciaDescription" rows="2" required
                                  placeholder="Descripción detallada de lo que incluye esta experiencia..."></textarea>
                    </div>

                    <!-- Todos los precios en una fila -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">
                                Precio Adulto <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="quickEstablishmentExperienciaPrice" required min="0" step="0.01" 
                                       placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Precio Adulto Sin Alcohol</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="quickEstablishmentExperienciaPriceNoAlcohol" min="0" step="0.01" 
                                       placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Precio Niño</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="quickEstablishmentExperienciaPriceChild" min="0" step="0.01" 
                                       placeholder="0.00">
                            </div>
                        </div>
                    </div>

                    <!-- Campos de tiempo -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Duración (hrs)</label>
                            <input type="number" class="form-control" id="quickEstablishmentExperienciaDuration" min="0" step="0.5" 
                                   placeholder="2.5">
                            <div class="form-text">
                                <small>Tiempo total experiencia</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Duración Trayecto (min)</label>
                            <input type="number" class="form-control" id="quickEstablishmentExperienciaTravelDuration" min="0" step="1" 
                                   placeholder="60">
                            <div class="form-text">
                                <small>Tiempo traslado</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Tiempo Anticipación (min)</label>
                            <input type="number" class="form-control" id="quickEstablishmentExperienciaAdvanceTime" min="0" step="1" 
                                   placeholder="1440">
                            <div class="form-text">
                                <small>Ej: 1440 = 24hrs</small>
                            </div>
                        </div>
                    </div>

                    <!-- Campos de personas -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="quickEstablishmentExperienciaMinPeople" class="form-label form-label-sm fw-medium text-success">Mín. Personas</label>
                            <input type="number" class="form-control" id="quickEstablishmentExperienciaMinPeople" min="1" step="1" 
                                   placeholder="1">
                        </div>
                        <div class="col-md-6">
                            <label for="quickEstablishmentExperienciaMaxPeople" class="form-label form-label-sm fw-medium text-success">Máx. Personas</label>
                            <input type="number" class="form-control" id="quickEstablishmentExperienciaMaxPeople" min="1" step="1"
                                   placeholder="10">
                        </div>
                    </div>

                    <!-- Horario fijo -->
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="quickEstablishmentExperienciaFixedSchedule">
                        <label class="form-check-label form-label-sm fw-medium text-success" for="quickEstablishmentExperienciaFixedSchedule">
                            Horario fijo
                            <small class="d-block text-muted fw-normal">Si se activa, en el detalle muestra "Horarios" en lugar de "Horarios sugeridos" (ej. viñedos).</small>
                        </label>
                    </div>

                    <!-- Incluye y No Incluye en 2 columnas -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <!-- Incluye -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    Incluye <span class="text-muted">(uno por línea)</span>
                                </label>
                                <textarea class="form-control" id="quickEstablishmentExperienciaIncludes" 
                                          rows="4"
                                          placeholder="Mesa reservada&#10;Menú degustación&#10;Vino de cortesía&#10;Atención personalizada&#10;Ambiente exclusivo"
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-info-circle me-1"></i>Cada elemento en una línea nueva</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- No Incluye -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    No incluye <span class="text-muted">(uno por línea)</span>
                                </label>
                                <textarea class="form-control" id="quickEstablishmentExperienciaNotIncludes" 
                                          rows="4"
                                          placeholder="Transporte&#10;Propinas&#10;Bebidas adicionales&#10;Extras no mencionados"
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-info-circle me-1"></i>Cada elemento en una línea nueva</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Idiomas disponibles -->
                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-medium text-success">
                            Idiomas disponibles <span class="text-muted">(uno por línea)</span>
                        </label>
                        <textarea class="form-control" id="quickEstablishmentExperienciaLanguages" 
                                  rows="3"
                                  placeholder="Español&#10;Inglés&#10;Francés&#10;Alemán"
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                        <div class="form-text">
                            <small><i class="ti ti-world me-1"></i>Escriba cada idioma en una línea nueva • Se mostrarán como lista</small>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="quickAddEstablishmentExperienceSaveBtn">
                    <i class="ti ti-check me-1"></i>Guardar Experiencia
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Establishment Creation/Edit Modal -->
<!-- Holder oculto: sus nodos (alerts, form, botón) se reubican en el panel de detalle al iniciar (ver relocateEstablishmentForm) -->
<div id="establishmentModal" class="d-none">
                <!-- Alert container for detail-panel errors -->
                <div id="establishmentModalAlerts"></div>

                <form id="establishmentForm">
                    <input type="hidden" id="establishmentId">
                    <input type="hidden" id="establishmentType" value="Establishment">
                    <!-- Hidden fields for compatibility -->
                    <input type="hidden" id="establishmentProviderType" name="providerType" value="">
                    <input type="hidden" id="establishmentDuration" name="duration" value="">
                    <input type="hidden" id="establishmentMinPeople" name="min_people" value="">
                    <input type="hidden" id="establishmentCost" name="cost" value="0">

                    <!-- Sección: Experiencias del Establecimiento (lo que más se edita: va primero) -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-success border-bottom pb-2 mb-3">
                            <i class="ti ti-sparkles me-1"></i>
                            Experiencias del Establecimiento
                        </h6>

                        <!-- Lista de experiencias editables inline -->
                        <div id="establishmentExperienciasList" class="mb-3">
                            <div id="noEstablishmentExperienciasMessage" class="text-center text-muted py-3 border rounded bg-light">
                                <i class="ti ti-package-off fs-4 d-block mb-2"></i>
                                <p class="mb-0">No hay experiencias agregadas</p>
                                <small class="text-muted">Use el botón de abajo para agregar la primera experiencia</small>
                            </div>
                        </div>

                        <!-- Botón para agregar nueva experiencia -->
                        <button type="button" class="btn btn-sm btn-success" id="addEstablishmentExperienciaBtn">
                            <i class="ti ti-plus me-1"></i>Agregar Nueva Experiencia
                        </button>
                    </div>

                    <!-- Información del establecimiento (se da de alta una vez: colapsable) -->
                    <div class="border-top pt-3">
                        <button type="button" class="btn btn-link text-decoration-none p-0 fw-bold text-success d-flex align-items-center gap-2" id="toggleEstablishmentInfoBtn">
                            <i class="ti ti-chevron-right" id="establishmentInfoChevron" style="transition: transform .15s ease;"></i>
                            <i class="ti ti-building"></i>
                            Información del establecimiento
                        </button>

                        <div id="establishmentInfoSection" class="mt-3" style="display: none;">
                            <!-- Nombre -->
                            <div class="mb-3">
                                <label for="establishmentName" class="form-label">
                                    Nombre del Establecimiento <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" id="establishmentName" name="name" required maxlength="280" placeholder="Ej: Restaurante Casa de María">
                                <div class="form-text">Nombre comercial del establecimiento (máximo 200 caracteres)</div>
                            </div>

                            <!-- Descripción -->
                            <div class="mb-3">
                                <label for="establishmentDescription" class="form-label">
                                    Descripción <span class="text-danger">*</span>
                                </label>
                                <textarea class="form-control" id="establishmentDescription" name="description" rows="4" required placeholder="Descripción detallada del establecimiento y sus servicios..."></textarea>
                                <div class="form-text">Descripción completa del establecimiento</div>
                            </div>

                            <!-- Destino (Optional) -->
                            <div class="mb-3">
                                <label for="establishmentDestino" class="form-label">
                                    Destino <small class="text-muted">(Opcional)</small>
                                </label>
                                <select class="form-control" id="establishmentDestino" name="destinationPOI">
                                    <option value="">Seleccione un destino...</option>
                                    <!-- Dynamically populated with POI data -->
                                </select>
                                <div class="form-text">Punto de interés o destino principal asociado con este establecimiento</div>
                            </div>
                        </div>
                    </div>
                </form>
                <button type="button" class="btn text-white" style="background: var(--brand-gradient);" id="saveEstablishmentBtn">
                    <i class="ti ti-device-floppy me-1"></i>Guardar
                </button>
</div>

<!-- Template para experiencia de establecimiento editable inline -->
<template id="establishmentExperienciaEditableTemplate">
    <div class="experiencia-editable card mb-2 border-success border-opacity-25" data-index="" data-id="">
        <!-- Cabecera colapsable: resumen siempre visible (click para expandir) -->
        <div class="card-header experiencia-acc-header d-flex justify-content-between align-items-center gap-2 py-2 px-3" role="button" style="cursor: pointer; background: #f0fdf4;">
            <span class="d-flex align-items-center gap-2 text-truncate">
                <i class="ti ti-chevron-right experiencia-acc-chevron text-success" style="transition: transform .15s ease;"></i>
                <span class="fw-semibold text-success experiencia-acc-title text-truncate">Nueva experiencia</span>
                <span class="badge bg-light text-success border experiencia-acc-tipo d-none"></span>
            </span>
            <span class="d-flex align-items-center gap-2 flex-shrink-0">
                <span class="fw-semibold text-success small experiencia-acc-price"></span>
                <button type="button" class="btn btn-sm btn-outline-danger delete-experiencia-btn experiencia-acc-delete" title="Eliminar experiencia">
                    <i class="ti ti-trash"></i>
                </button>
            </span>
        </div>
        <!-- Cuerpo editable: colapsado por defecto (difiere la descarga de fotos) -->
        <div class="experiencia-acc-body" style="display: none;">
        <div class="card-body p-3">
            <!-- Fila principal: Nombre y Tipo -->
            <div class="row mb-2">
                <div class="col-md-8">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Nombre <span class="text-danger">*</span></label>
                    <input type="text" class="form-control experiencia-name-input" required maxlength="200"
                           placeholder="Ej: Cena Romántica VIP">
                </div>
                <div class="col-md-4">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Tipo</label>
                    <select class="form-select form-select experiencia-tipo-input">
                        <option value="">Seleccionar</option>
                        <option value="Exclusivo">Exclusivo</option>
                        <option value="Compartido">Compartido</option>
                        <option value="Privado">Privado</option>
                    </select>
                </div>
            </div>
            
            <!-- Descripción -->
            <div class="mb-2">
                <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Descripción <span class="text-danger">*</span></label>
                <textarea class="form-control experiencia-description-input" rows="2" required
                          placeholder="Descripción detallada de lo que incluye esta experiencia..."></textarea>
            </div>
            
            <!-- Todos los precios en una fila -->
            <div class="row mb-2">
                <div class="col-md-4">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Precio Adulto <span class="text-danger">*</span></label>
                    <div class="input-group input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control experiencia-price-input" required min="0" step="0.01" 
                               placeholder="0.00">
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Precio Adulto Sin Alcohol</label>
                    <div class="input-group input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control experiencia-price-no-alcohol-input" min="0" step="0.01" 
                               placeholder="0.00">
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Precio Niño</label>
                    <div class="input-group input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control experiencia-price-child-input" min="0" step="0.01" 
                               placeholder="0.00">
                    </div>
                </div>
            </div>

            <!-- Campos de tiempo en una fila -->
            <div class="row mb-2">
                <div class="col-md-4">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Duración (hrs)</label>
                    <input type="number" class="form-control experiencia-duration-input" min="0" step="0.5" 
                           placeholder="2.5">
                    <div class="form-text">
                        <small>Tiempo total experiencia</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Duración Trayecto (min)</label>
                    <input type="number" class="form-control experiencia-travel-duration-input" min="0" step="1" 
                           placeholder="60">
                    <div class="form-text">
                        <small>Tiempo traslado</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Tiempo Anticipación (min)</label>
                    <input type="number" class="form-control experiencia-advance-minutes-input" 
                           min="0" step="1" placeholder="1440">
                    <div class="form-text">
                        <small>Ej: 1440 = 24hrs</small>
                    </div>
                </div>
            </div>
            
            <!-- Campos de personas -->
            <div class="row mb-2">
                <div class="col-md-6">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Mín. Personas</label>
                    <input type="number" class="form-control experiencia-min-people-input" min="1" step="1" 
                           placeholder="1">
                </div>
                <div class="col-md-6">
                    <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">Máx. Personas</label>
                    <input type="number" class="form-control experiencia-max-people-input" min="1" step="1" 
                           placeholder="10">
                </div>
            </div>
            
            <!-- Incluye y No Incluye en 2 columnas -->
            <div class="row">
                <div class="col-md-6">
                    <!-- Incluye -->
                    <div class="mb-2">
                        <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">
                            Incluye <span class="text-muted">(uno por línea)</span>
                        </label>
                        <textarea class="form-control experiencia-includes-input" 
                                  rows="4"
                                  placeholder="Cena de 3 tiempos&#10;Bebidas incluidas&#10;Mesa preferencial&#10;Música en vivo&#10;Postres especiales"
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                        <div class="form-text">
                            <small><i class="ti ti-info-circle me-1"></i>Cada elemento en una línea nueva</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <!-- No Incluye -->
                    <div class="mb-2">
                        <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">
                            No incluye <span class="text-muted">(uno por línea)</span>
                        </label>
                        <textarea class="form-control experiencia-notincludes-input" 
                                  rows="4"
                                  placeholder="Propinas&#10;Transporte al lugar&#10;Bebidas premium&#10;Entretenimiento adicional"
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                        <div class="form-text">
                            <small><i class="ti ti-alert-circle me-1"></i>Cada exclusión en una línea nueva</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Idiomas disponibles -->
            <div class="mb-2">
                <label class="form-label form-label-sm fw-medium" style="color: var(--brand-success, #2bb673);">
                    <i class="ti ti-language me-1"></i>Idiomas disponibles <span class="text-muted">(uno por línea)</span>
                </label>
                <textarea class="form-control experiencia-languages-input" 
                          rows="3"
                          placeholder="Español&#10;Inglés&#10;Francés"
