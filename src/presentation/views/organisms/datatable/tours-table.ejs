<%
/**
 * Tours DataTable Organism
 * DataTable component for tours management with expandable pricing
 *
 * Atomic Design Level: Organism
 * Category: Dashboard Data Tables
 *
 * @param {string} tableId - Unique table identifier
 * @param {string} apiEndpoint - API endpoint for data loading
 * @param {string} userRole - Current user role
 * @param {boolean} showActions - Whether to show action buttons
 */

const dtTableId = typeof tableId !== 'undefined' ? tableId : 'tours-table';
const dtApiEndpoint = typeof apiEndpoint !== 'undefined' ? apiEndpoint : '/api/tours';
const dtShowActions = typeof showActions !== 'undefined' ? showActions : true;
const dtUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const dtShowClientPricing = typeof showClientPricing !== 'undefined' ? showClientPricing : false;
const dtClientId = typeof clientId !== 'undefined' ? clientId : null;

const canEdit = ['superadmin', 'admin'].includes(dtUserRole);
const canDelete = ['superadmin', 'admin'].includes(dtUserRole);
const canCreate = ['superadmin', 'admin'].includes(dtUserRole);
const isDepartmentManager = dtUserRole === 'department_manager';
const isClient = dtUserRole === 'client';
%>

<style>
/* Global font size increase for all datatable elements */
#<%= dtTableId %>,
#<%= dtTableId %>_wrapper {
    font-size: 0.95rem !important; /* Increased from default ~0.875rem */
}

#<%= dtTableId %> thead th,
#<%= dtTableId %> tbody td {
    font-size: 0.95rem !important; /* Increased for table headers and cells */
}

#<%= dtTableId %> .small {
    font-size: 0.9rem !important; /* Increased from ~0.75rem */
}

#<%= dtTableId %> .badge {
    font-size: 0.85rem !important; /* Increased badge font size */
}

/* DataTable controls (pagination, search, etc.) */
#<%= dtTableId %>_wrapper .dataTables_length,
#<%= dtTableId %>_wrapper .dataTables_filter,
#<%= dtTableId %>_wrapper .dataTables_info,
#<%= dtTableId %>_wrapper .dataTables_paginate {
    font-size: 0.95rem !important;
}

/* Hide default DataTables sorting icons */
.dt-control::before,
.dt-control::after {
    display: none !important;
}

/* Custom styling for price column */
.price-expand-container {
    text-align: left;
}

/* Hide any default sorting indicators and disable all header clicks */
table.dataTable thead .sorting::before,
table.dataTable thead .sorting::after,
table.dataTable thead .sorting_asc::before,
table.dataTable thead .sorting_asc::after,
table.dataTable thead .sorting_desc::before,
table.dataTable thead .sorting_desc::after {
    display: none !important;
}

/* Disable cursor and make all headers non-clickable */
#<%= dtTableId %> thead th {
    cursor: default !important;
    pointer-events: none; /* Disable all mouse events on headers */
}

/* Re-enable events on dropdown in header (if any) */
#<%= dtTableId %> thead th select {
    pointer-events: all !important;
}

/* Ensure only our button shows */
td.dt-control {
    position: relative;
}

/* Prevent sorting on price column header */
table.dataTable thead th:nth-child(3) {
    cursor: default !important;
    position: relative;
}

table.dataTable thead th:nth-child(3)::before,
table.dataTable thead th:nth-child(3)::after {
    display: none !important;
}

/* Remove sorting class from price column header */
table.dataTable thead th:nth-child(3).sorting {
    cursor: default !important;
    background-image: none !important;
}

/* Make dropdown clickable in header */
[id^="headerRateFilter-"] {
    pointer-events: all !important;
    z-index: 1000;
    position: relative;
    width: 100% !important;
}

/* Prevent DataTables from interfering with dropdown container */
table.dataTable thead th:nth-child(3) div {
    pointer-events: none;
}

table.dataTable thead th:nth-child(3) select {
    pointer-events: all !important;
}

/* Additional CSS for no-sort class */
table.dataTable thead th.no-sort,
table.dataTable thead th.no-sort.sorting,
table.dataTable thead th.no-sort.sorting_asc,
table.dataTable thead th.no-sort.sorting_desc {
    cursor: default !important;
    background-image: none !important;
    padding-right: 8px !important;
}

table.dataTable thead th.no-sort::before,
table.dataTable thead th.no-sort::after {
    display: none !important;
}

/* Remove DataTables default row hover effect */
table.dataTable tbody tr:hover,
table.dataTable tbody tr.hover {
    background-color: transparent !important;
}

/* Add hover effect specifically to expand button */
.expand-btn:hover {
    background-color: rgba(0, 123, 255, 0.1) !important;
    border-radius: 4px !important;
    transform: scale(1.05);
    transition: all 0.2s ease;
}

.expand-btn:hover i,
.expand-btn:hover small {
    color: #0d6efd !important;
}

/* Smooth transition for expand button */
.expand-btn {
    transition: all 0.2s ease;
}

/* Custom styling for nav pills with borders */
.nav-pills .nav-link {
    border: 1px solid #dee2e6;
    color: #6c757d;
    background-color: transparent;
    margin-right: 0.25rem;
    transition: all 0.2s ease;
}

.nav-pills .nav-link:hover {
    border-color: #10b981;
    color: #10b981;
    background-color: rgba(16, 185, 129, 0.1);
}

.nav-pills .nav-link.active {
    border-color: #10b981;
    background-color: #10b981;
    color: white;
}

/* Price column styling */
.price-container {
    text-align: left;
}

.price-container .badge {
    font-size: 0.7rem;
    padding: 0.25rem 0.4rem;
}

.price-container .small {
    margin-bottom: 0.2rem;
}
</style>

<div class="card border-0 shadow-sm">
    <div class="card-header text-white" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="card-title mb-0 text-white">
                    Tours
                </h5>
            </div>
            <div class="col-auto">
                <% if (canCreate) { %>
                    <button type="button" class="btn btn-light btn-sm" id="createTourBtn">
                        <i class="ti ti-plus me-1"></i>Nuevo Tour
                    </button>
                <% } %>
            </div>
        </div>
    </div>

    <div class="card-body" id="tours-content">
        <!-- Filter Controls -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <!-- Leading Pills (Segmented Control) -->
            <ul class="nav nav-pills" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active filter-pill" data-filter="all" type="button" role="tab">
                        Solo Guía
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link filter-pill" data-filter="with-driver" type="button" role="tab">
                        Guía + Chofer
                    </button>
                </li>
            </ul>

            <!-- Trailing Dropdowns -->
            <div class="d-flex gap-2 align-items-center">
                <!-- Currency Dropdown -->
                <div class="d-flex align-items-center gap-1">
                    <label for="currencyFilter-<%= dtTableId %>" class="form-label mb-0 text-muted">Moneda:</label>
                    <select class="form-select" id="currencyFilter-<%= dtTableId %>" style="min-width: 100px;">
                        <option value="MXN" selected>MXN</option>
                        <option value="USD">USD</option>
                    </select>
                </div>

                <!-- Payment Type Dropdown -->
                <div class="d-flex align-items-center gap-1">
                    <label for="paymentTypeFilter-<%= dtTableId %>" class="form-label mb-0 text-muted">Pago:</label>
                    <select class="form-select" id="paymentTypeFilter-<%= dtTableId %>" style="min-width: 140px;">
                        <% if (isDepartmentManager || isClient) { %>
                            <option value="efectivo">Efectivo</option>
                            <option value="transferencia" selected>Transferencia</option>
                        <% } else { %>
                            <option value="efectivo" selected>Efectivo</option>
                            <option value="transferencia">Transferencia</option>
                        <% } %>
                        <option value="tarjeta">Tarjeta Débito/Crédito</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table id="<%= dtTableId %>" class="table table-hover" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th style="width: 30%;">Tour (Destino)</th>
                        <th style="width: 15%;">Mínimo de horas</th>
                        <th style="width: 20%;">
                            <div class="text-center mb-1" style="font-size: 0.875rem; font-weight: 500;">
                                Seleccionar categoría...
                            </div>
                            <select class="form-select" id="headerRateFilter-<%= dtTableId %>" style="min-width: 120px; width: 100%;">
                            </select>
                        </th>
                        <% if (!isDepartmentManager && !isClient) { %>
                        <th style="width: 20%;">Estado</th>
                        <% } %>
                        <% if (dtShowClientPricing) { %>
                            <th class="text-center" style="width: 15%;">Precio Cliente</th>
                        <% } %>
                        <% if (dtShowActions) { %>
                            <th class="text-center" style="width: 15%;">Acciones</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Price History Modal -->
<div class="modal fade" id="tourPriceHistoryModal" tabindex="-1" aria-labelledby="tourPriceHistoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title text-white" id="tourPriceHistoryModalLabel">
                    <i class="ti ti-chart-line me-2"></i>Historial de Precios
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <h6 id="tourPriceHistoryTourName" class="fw-semibold text-muted"></h6>
                </div>
                
                <!-- Loading State -->
                <div id="tourPriceHistoryLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando historial de precios...</span>
                    </div>
                    <p class="mt-2 text-muted">Cargando historial de precios...</p>
                </div>
                
                <!-- Error State -->
                <div id="tourPriceHistoryError" class="alert alert-danger d-none" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <span id="tourPriceHistoryErrorMessage">Error al cargar el historial de precios</span>
                </div>
                
                <!-- No Data State -->
                <div id="tourPriceHistoryNoData" class="text-center py-4 d-none">
                    <i class="ti ti-inbox display-4 text-muted"></i>
                    <p class="mt-2 text-muted">No hay historial de precios disponible para este tour</p>
                </div>
                
                <!-- History Table -->
                <div id="tourPriceHistoryContent" class="d-none">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Fecha de Vigencia</th>
                                    <th>Precio</th>
                                    <th>Tipo de Vehículo</th>
                                    <th>Tarifa</th>
                                    <th>Válido Hasta</th>
                                    <th>Duración</th>
                                    <% if (!isDepartmentManager && !isClient) { %>
                                    <th>Estado</th>
                                    <% } %>
                                </tr>
                            </thead>
                            <tbody id="tourPriceHistoryTableBody">
                                <!-- Price history data will be populated here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Tour Modal -->
<div class="modal fade" id="tourModal" tabindex="-1" aria-labelledby="tourModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
                <h5 class="modal-title text-white" id="tourModalLabel">
                    <i class="ti ti-map me-2"></i><span id="modalTitle">Crear Nuevo Tour</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Alert container for modal-specific errors -->
                <div id="tourModalAlerts"></div>

                <form id="tourForm">
                    <input type="hidden" id="tourId">

                    <!-- Destino y Tipo -->
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label class="form-label form-label-sm fw-medium text-success">
                                Destino <span class="text-danger">*</span>
                            </label>
                            <%- include('../../atoms/common/tom-select', {
                                id: 'destinationPOI',
                                name: 'destinationPOI',
                                multiple: false,
                                placeholder: 'Seleccionar destino del tour',
                                label: false,
                                required: true,
                                helpText: false,
                                options: [],
                                selected: []
                            }) %>
                        </div>
                        <div class="col-md-4">
                            <label for="tourType" class="form-label form-label-sm fw-medium text-success">Tipo</label>
                            <select class="form-select" id="tourType">
                                <option value="">Seleccionar</option>
                                <option value="Exclusivo">Exclusivo</option>
                                <option value="Compartido">Compartido</option>
                                <option value="Privado">Privado</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Descripción -->
                    <div class="mb-3">
                        <label for="tourDescription" class="form-label form-label-sm fw-medium text-success">
                            Descripción
                        </label>
                        <textarea class="form-control" id="tourDescription" rows="2"
                                  placeholder="Descripción detallada del recorrido del tour..."></textarea>
                    </div>

                    <!-- Todos los precios en una fila -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">
                                Precio Adulto
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="tourPrice" min="0" step="0.01" 
                                       placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Precio Adulto Sin Alcohol</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="tourPriceNoAlcohol" min="0" step="0.01" 
                                       placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Precio Niño</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="tourPriceChild" min="0" step="0.01" 
                                       placeholder="0.00">
                            </div>
                        </div>
                    </div>

                    <!-- Campos de tiempo -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Duración (hrs)</label>
                            <input type="number" class="form-control" id="tourDuration" min="0" step="0.5" 
                                   placeholder="2.5">
                            <div class="form-text">
                                <small>Tiempo total del tour</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Duración Trayecto (min)</label>
                            <input type="number" class="form-control" id="tourTravelDuration" min="0" step="1" 
                                   placeholder="60">
                            <div class="form-text">
                                <small>Tiempo traslado</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Tiempo Anticipación (min)</label>
                            <input type="number" class="form-control" id="tourAdvanceTime" min="0" step="1" 
                                   placeholder="1440">
                            <div class="form-text">
                                <small>Ej: 1440 = 24hrs</small>
                            </div>
                        </div>
                    </div>

                    <!-- Campos de personas -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="tourMinPeople" class="form-label form-label-sm fw-medium text-success">Mín. Personas</label>
                            <input type="number" class="form-control" id="tourMinPeople" min="1" step="1" 
                                   placeholder="1">
                        </div>
                        <div class="col-md-6">
                            <label for="tourMaxPeople" class="form-label form-label-sm fw-medium text-success">Máx. Personas</label>
                            <input type="number" class="form-control" id="tourMaxPeople" min="1" step="1" 
                                   placeholder="10">
                        </div>
                    </div>

                    <!-- Incluye y No Incluye en 2 columnas -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <!-- Incluye -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    Incluye <span class="text-muted">(uno por línea)</span>
                                </label>
                                <textarea class="form-control" id="tourIncludes" 
                                          rows="4"
                                          placeholder="Transporte ida y vuelta&#10;Guía bilingüe certificado&#10;Entrada al sitio&#10;Degustación de platillos&#10;Agua embotellada"
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-info-circle me-1"></i>Cada elemento en una línea nueva</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- No Incluye -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    No incluye <span class="text-muted">(uno por línea)</span>
                                </label>
                                <textarea class="form-control" id="tourNotIncludes" 
                                          rows="4"
                                          placeholder="Propinas&#10;Comidas adicionales&#10;Transporte desde aeropuerto&#10;Gastos personales"
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-alert-circle me-1"></i>Cada exclusión en una línea nueva</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Idiomas disponibles -->
                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-medium text-success">
                            <i class="ti ti-language me-1"></i>Idiomas disponibles <span class="text-muted">(uno por línea)</span>
                        </label>
                        <textarea class="form-control" id="tourLanguages" 
                                  rows="3"
                                  placeholder="Español&#10;Inglés&#10;Francés&#10;Alemán"
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                        <div class="form-text">
                            <small><i class="ti ti-world me-1"></i>Escriba cada idioma en una línea nueva • Se mostrarán como lista</small>
                        </div>
                    </div>

                    <!-- Disponibilidad compacta -->
                    <div class="availability-section mb-3">
                        <!-- Availability Summary View (default) -->
                        <div class="availability-summary-tour">
                            <label class="form-label form-label-sm fw-medium text-success d-flex justify-content-between align-items-center">
                                <span>Disponibilidad <span class="text-muted">(Opcional)</span></span>
                                <button type="button" class="btn btn-sm btn-link p-0 toggle-tour-availability-btn" title="Configurar horarios">
                                    <i class="ti ti-settings"></i>
                                </button>
                            </label>
                            <div class="availability-display bg-light border rounded p-2" style="min-height: 35px;">
                                <small class="text-success">
                                    <i class="ti ti-check-circle me-1"></i>
                                    <span class="availability-status-tour">Disponible todos los días</span>
                                </small>
                            </div>
                        </div>
                        
                        <!-- Availability Configuration View (hidden by default) -->
                        <div class="availability-content-tour" style="display: none;">
                            <label class="form-label form-label-sm fw-medium text-success d-flex justify-content-between align-items-center">
                                <span>Configurar Disponibilidad</span>
                                <button type="button" class="btn btn-sm btn-link p-0 toggle-tour-availability-btn" title="Cerrar configuración">
                                    <i class="ti ti-x"></i>
                                </button>
                            </label>
                            <div class="mb-2">
                                <div class="d-flex gap-1 flex-wrap" id="availableDaysContainer">
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="1" data-day-name="Lunes">Lu</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="2" data-day-name="Martes">Ma</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="3" data-day-name="Miércoles">Mi</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="4" data-day-name="Jueves">Ju</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="5" data-day-name="Viernes">Vi</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="6" data-day-name="Sábado">Sa</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="0" data-day-name="Domingo">Do</button>
                                </div>
                            </div>
                            
                            <div id="daySchedulesContainer" class="mb-2"></div>
                            
                            <div id="noDaysSelected" class="text-center text-muted py-2 border rounded bg-light" style="font-size: 1rem;">
                                <i class="ti ti-calendar-off me-1"></i>
                                <small>Selecciona días para configurar horarios</small>
                            </div>
                        </div>
                    </div>

                    <!-- Fotos del tour -->
                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-medium text-success">
                            Fotos <span class="text-muted">(Opcional)</span>
                        </label>
                        <div class="tour-photos-container">
                            <!-- Photo upload section -->
                            <div class="row g-2 mb-2 photos-preview-container">
                                <!-- Uploaded photos will be displayed here -->
                            </div>
                            
                            <!-- Add photo button -->
                            <div class="d-grid">
                                <button type="button" class="btn btn-outline-primary btn-sm add-photo-btn">
                                    <i class="ti ti-camera-plus me-1"></i>
                                    Agregar Foto
                                </button>
                            </div>
                            
                            <!-- Hidden file input -->
                            <input type="file" 
                                   class="d-none tour-photo-input" 
                                   accept=".jpg,.jpeg,.png,.webp" 
                                   multiple>
                        </div>
                        <div class="form-text">
                            <small><i class="ti ti-info-circle me-1"></i>Formatos: JPG, PNG, WebP</small>
                        </div>
                    </div>

                    <!-- Notas (4 campos) -->
                    <div class="row">
                        <div class="col-md-6">
                            <!-- Notas internas -->
                            <div class="mb-3">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    <i class="ti ti-notes me-1"></i>Notas internas <span class="text-muted">(Uso interno)</span>
                                </label>
                                <textarea class="form-control" id="tourInternalNotes" 
                                          rows="3"
                                          placeholder="Notas para uso exclusivo interno del equipo..."
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-lock me-1"></i>Solo visible para el equipo interno</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- Notas cliente (reservar) -->
                            <div class="mb-3">
