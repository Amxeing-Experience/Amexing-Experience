/**
 * Global function to synchronize currency dropdowns across all tables
 */
window.syncCurrencyDropdowns = function(selectedCurrency, sourceDropdown = null) {

    // Find all currency dropdowns on the page
    const allCurrencyDropdowns = document.querySelectorAll('[id^="currencyFilter-"]');
    
    allCurrencyDropdowns.forEach(dropdown => {
        if (dropdown.value !== selectedCurrency && dropdown !== sourceDropdown) {

            dropdown.value = selectedCurrency;
            
            // Don't trigger change events to avoid infinite loops
            // The price updates will happen through the global exchange rate variables
        }
    });
};

/**
 * Global currency change listener that works for all tables
 */
function initGlobalCurrencySync() {
    document.addEventListener('change', function(event) {
        // Check if the changed element is a currency dropdown
        if (event.target.id && event.target.id.startsWith('currencyFilter-')) {

            window.syncCurrencyDropdowns(event.target.value, event.target);
        }
    });

}

// Initialize global sync when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlobalCurrencySync);
} else {
    initGlobalCurrencySync();
}

