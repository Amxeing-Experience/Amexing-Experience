        // Tour photo preview function with optimization support - moved here to be available before usage
        function addTourPhotoPreview(container, file, dataUrl, photoDataOrMetadata) {
            const photoId = Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            
            // Handle both old format (just metadata) and new format (full photo object)
            let optimizationMetadata = null;
            let fullPhotoData = null;
            
            if (photoDataOrMetadata) {
                // If it's an object with any of the expected photo properties, it's the full photo object
                if (typeof photoDataOrMetadata === 'object' && 
                    (photoDataOrMetadata.s3Key || 
                     photoDataOrMetadata.optimizationMetadata !== undefined ||
                     photoDataOrMetadata.optimizedVariants ||
                     photoDataOrMetadata.fileName)) {
                    fullPhotoData = photoDataOrMetadata;
                    optimizationMetadata = photoDataOrMetadata.optimizationMetadata;
                } else {
                    // Otherwise it's just the metadata (for backwards compatibility)
                    optimizationMetadata = photoDataOrMetadata;
                }
            }
            
            // Check optimization metadata for format count - ALWAYS show badge
            let formatBadge = '';
            let formatInfo = '';
            let badgeClass = '';
            let iconClass = '';
            let tooltipText = '';
            
            // Check if it's a new upload (base64 image)
            if (dataUrl && dataUrl.startsWith('data:')) {
                formatInfo = 'New - Not saved';
                badgeClass = 'bg-warning';
                iconClass = 'ti-alert-circle';
                tooltipText = 'Will be optimized when saved';
            } 
            // Check optimization metadata
            else if (optimizationMetadata && (optimizationMetadata.availableFormats || optimizationMetadata.formats)) {
                let availableFormats = optimizationMetadata.availableFormats || 
                                     optimizationMetadata.formats || 
                                     [];
                
                // Handle case where formats is an object instead of array
                if (typeof availableFormats === 'object' && !Array.isArray(availableFormats)) {
                    availableFormats = Object.keys(availableFormats);
                }
                
                // Ensure it's an array
                if (!Array.isArray(availableFormats)) {
                    availableFormats = [];
                }
                
                // Count non-original formats (AVIF, WebP, JPEG)
                const optimizedFormats = availableFormats.filter(f => f !== 'original');
                const formatCount = optimizedFormats.length;
                
                if (formatCount > 0) {
                    formatInfo = `${formatCount} formats`;
                    badgeClass = 'bg-success';
                    iconClass = 'ti-photo';
                    tooltipText = `Optimized: ${optimizedFormats.join(', ')}`;
                } else {
                    // Has metadata but 0 formats (optimization may have failed or not completed)
                    formatInfo = '0 formats';
                    badgeClass = 'bg-danger';
                    iconClass = 'ti-x';
                    tooltipText = 'No optimized formats available';
                }
            } 
            // No metadata and not base64 (old image without optimization)
            else {
                // Check if it's an S3 URL (legacy upload before optimization)
                if (dataUrl && (dataUrl.includes('amazonaws.com') || dataUrl.includes('http'))) {
                    formatInfo = 'Legacy - No optimization';
                    badgeClass = 'bg-secondary';
                    iconClass = 'ti-photo-off';
                    tooltipText = 'Uploaded before optimization was implemented. Re-upload to optimize.';
                } else {
                    formatInfo = 'Unknown';
                    badgeClass = 'bg-dark';
                    iconClass = 'ti-question-mark';
                    tooltipText = 'Unknown image format';
                }
            }
            
            // Always create a badge
            formatBadge = `
                <span class="badge ${badgeClass} position-absolute" 
                      style="top: 2px; left: 2px; font-size: 9px; padding: 2px 4px;"
                      title="${tooltipText}">
                    <i class="ti ${iconClass}" style="font-size: 9px;"></i> ${formatInfo}
                </span>
            `;
            
            // Store full photo data as data attribute to preserve all fields
            const photoDataJson = fullPhotoData ? JSON.stringify(fullPhotoData) : '';
            
            const photoHtml = `
                <div class="col-4 photo-preview" data-photo-id="${photoId}" data-photo-full='${photoDataJson.replace(/'/g, '&#39;')}'>
                    <div class="position-relative">
                        <img src="${dataUrl}" 
                             class="img-fluid rounded border" 
                             style="height: 80px; width: 100%; object-fit: cover;">
                        ${formatBadge}
                        <button type="button" 
                                class="btn btn-danger btn-sm position-absolute top-0 end-0 remove-photo-btn" 
                                style="padding: 2px 6px; margin: 2px;">
                            <i class="ti ti-x" style="font-size: 12px;"></i>
                        </button>
                        <div class="text-center mt-1">
                            <small class="text-muted text-truncate d-block" style="font-size: 10px;" title="${file.name}">
                                ${file.name.length > 15 ? file.name.substring(0, 15) + '...' : file.name}
                            </small>
                        </div>
                    </div>
                </div>
            `;
            
            // Ensure container is a valid jQuery object
            if (!container || typeof container.append !== 'function') {
                console.error('❌ Invalid container for photo preview:', container);
                return;
            }
            
            try {
                container.append(photoHtml);

            } catch (error) {
                console.error('❌ Error appending photo HTML to container:', error);
            }
        }

