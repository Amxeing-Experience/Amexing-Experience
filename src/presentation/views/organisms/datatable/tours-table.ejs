<!-- Load centralized pricing utilities -->
<script src="/dashboard/js/utils/pricing-utils.js"></script>

<script>
// Global variables for walking tour functionality
const globalApiEndpoint = '<%= dtApiEndpoint %>';

// Global token getters - accessible from both IIFE and standalone functions
function getAccessTokenSync() {
    const tokenFromStorage = localStorage.getItem('accessToken');
    if (tokenFromStorage) return tokenFromStorage;
    if (window.__SERVER_ACCESS_TOKEN__) return window.__SERVER_ACCESS_TOKEN__;
    const cookies = document.cookie.split(';');
    for (let cookie of cookies) {
        const [name, value] = cookie.trim().split('=');
        if (name === 'accessToken') return value;
    }
    return null;
}

async function getAccessToken() {
    const tokenFromStorage = localStorage.getItem('accessToken');
    if (tokenFromStorage) return tokenFromStorage;
    if (window.__SERVER_ACCESS_TOKEN__) return window.__SERVER_ACCESS_TOKEN__;
    if (window.accessTokenPromise) {
        const tokenFromPromise = await window.accessTokenPromise;
        if (tokenFromPromise) return tokenFromPromise;
        const tokenAfterWait = localStorage.getItem('accessToken');
        if (tokenAfterWait) return tokenAfterWait;
    }
    return getAccessTokenSync();
}

(function() {
    // Wait for DOM and all dependencies to be ready
    function initWhenReady() {
        // Check if jQuery and DataTables are loaded
        if (typeof jQuery === 'undefined') {
            console.warn('jQuery not loaded yet, waiting...');
            setTimeout(initWhenReady, 100);
            return;
        }

        if (!jQuery.fn.dataTable) {
            console.warn('DataTables not loaded yet, waiting...');
            setTimeout(initWhenReady, 100);
            return;
        }

        initToursTable();
    }

    function initToursTable() {
        const tableId = '<%= dtTableId %>';
        const apiEndpoint = '<%= dtApiEndpoint %>';
        const showActions = <%= dtShowActions %>;
        const showClientPricing = <%= dtShowClientPricing %>;
        const canEdit = <%= canEdit %>;
        const canDelete = <%= canDelete %>;
        const userRole = '<%= dtUserRole %>';
        const clientId = '<%= dtClientId || "" %>';
        
        // Debug: Log the clientId to verify it's being passed correctly

        // Debug: Log the number of columns in HTML table
        const htmlColumnCount = $(`#${tableId} thead tr th`).length;

        // getAccessToken() and getAccessTokenSync() are defined in global scope above the IIFE

        // Setup global AJAX configuration to include JWT token
        $.ajaxSetup({
            beforeSend: function(xhr) {
                const token = getAccessTokenSync();
                if (token) {
                    xhr.setRequestHeader('Authorization', `Bearer ${token}`);
                }
            }
        });

        // Load dropdown data
        let poisData = [];
        let ratesData = [];

        // Color contrast functions for rate badges
        function getLuminance(hex) {
            // WCAG 2.0 luminance calculation
            const rgb = parseInt(hex.slice(1), 16);
            const r = (rgb >> 16) & 0xff;
            const g = (rgb >> 8) & 0xff;
            const b = (rgb >> 0) & 0xff;

            const [rsRGB, gsRGB, bsRGB] = [r/255, g/255, b/255].map(val => {
                return val <= 0.03928 ? val / 12.92 : Math.pow((val + 0.055) / 1.055, 2.4);
            });

            return 0.2126 * rsRGB + 0.7152 * gsRGB + 0.0722 * bsRGB;
        }

        function getContrastTextColor(backgroundColor) {
            const luminance = getLuminance(backgroundColor);
            return luminance > 0.5 ? '#1F2937' : '#FFFFFF';
        }

        // Load all data once
        let allToursData = [];
        let filteredData = [];

        // Load data from API
        // Detect client context for loading client-specific prices with priority logic
        function getClientIdFromContext() {
            // Priority 1: URL params (for admin viewing specific client)
            const urlParams = new URLSearchParams(window.location.search);
            const urlClientId = urlParams.get('clientId');
            
            // Priority 2: Path segments (for admin viewing client details)
            let pathClientId = null;
            const pathSegments = window.location.pathname.split('/');
            if (pathSegments.includes('clients') && pathSegments.length > pathSegments.indexOf('clients') + 1) {
                pathClientId = pathSegments[pathSegments.indexOf('clients') + 1];
            }
            
            // Priority 3: Data attributes
            let dataClientId = null;
            const clientElement = document.querySelector('[data-client-id]');
            if (clientElement) {
                dataClientId = clientElement.dataset.clientId;
            }
            
            // Priority 4: Template clientId (for Department Manager using their own ID)
            const templateClientId = clientId || null;
            
            // Use the first available clientId in priority order
            const finalClientId = urlClientId || pathClientId || dataClientId || templateClientId;

            return finalClientId;
        }

        function loadAllTours() {
            return new Promise((resolve, reject) => {
                const finalClientId = getClientIdFromContext();
                const url = new URL(apiEndpoint, window.location.origin);
                
                
                // Add clientId parameter if we're in client context
                if (finalClientId) {
                    url.searchParams.append('clientId', finalClientId);

                }
                
                // Note: No API filtering needed - we'll filter client-side by isWalkingTour
                
                
                $.ajax({
                    url: url.toString(),
                    type: 'GET',
                    success: function(response) {
                        if (response.success && response.data) {
                            // Preserve existing priceData if available
                            const newToursData = response.data;
                            
                            if (allToursData && allToursData.length > 0) {
                                // Merge existing priceData with new tour data
                                newToursData.forEach(newTour => {
                                    const existingTour = allToursData.find(t => t.id === newTour.id);
                                    if (existingTour && existingTour.priceData) {
                                        newTour.priceData = existingTour.priceData;
                                    }
                                });
                            }
                            
                            // Tours are already filtered by the API with tourType=vehicle
                            // Add additional client-side filter to ensure walking tours are excluded

                            const vehicleOnlyTours = newToursData.filter(tour => {
                                // Simple and explicit filter: only show tours that are NOT walking tours
                                // If isWalkingTour is explicitly false or undefined/null, keep the tour
                                // If isWalkingTour is explicitly true, filter it out
                                const shouldKeepTour = tour.isWalkingTour !== true;
                                
                                // DEBUG: Enhanced logging for each tour

                                if (!shouldKeepTour) {

                                }
                                
                                return shouldKeepTour;
                            });

                            // Sort data alphabetically by destination name
                            vehicleOnlyTours.sort((a, b) => {
                                const nameA = (a.destinationPOI?.name || 'Tour').trim();
                                const nameB = (b.destinationPOI?.name || 'Tour').trim();
                                return nameA.localeCompare(nameB, 'es', { numeric: true, sensitivity: 'base' });
                            });
                            
                            allToursData = vehicleOnlyTours;
                            filteredData = allToursData; // Show filtered vehicle tours by default
                            
                            
                            resolve(allToursData);
                        } else {
                            reject('Invalid response format');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading tours:', error);
                        reject('Error loading tours');
                    }
                });
            });
        }

        // DataTable Configuration (Client-side)
        const dataTable = $(`#${tableId}`).DataTable({
            processing: true,
            serverSide: false, // Changed to client-side
            data: [], // Will be populated after data loads
            deferRender: true, // Only render visible rows
                columns: [
                // 1. Tour (Destination)
                {
                    data: null,
                    defaultContent: '',
                    orderable: false, // Disable interactive sorting
                    render: function(data, type, row) {
                        // Handle empty/undefined row data gracefully
                        if (!row || typeof row !== 'object') {
                            return 'Cargando...';
                        }
                        
                        const destination = row.destinationPOI?.name || 'Tour';
                        
                        // For sorting (initial order), return destination name
                        if (type === 'sort') {
                            return destination;
                        }
                        
                        if (type === 'filter') {
                            return destination;
                        }
                        
                        return `
                            <div class="d-flex flex-column">
                                <div class="fw-semibold" style="font-size: 1.05rem;">
                                    ${destination}
                                </div>
                            </div>
                        `;
                    }
                },
                // 2. Tiempo
                {
                    data: 'time',
                    defaultContent: '-',
                    orderable: false,
                    render: function(data, type, row) {
                        if (!data) return '-';
                        const hours = Math.floor(data / 60);
                        const minutes = data % 60;
                        
                        if (type === 'filter' || type === 'sort') {
                            return data; // Return numeric for sorting
                        }
                        
                        if (hours > 0 && minutes > 0) {
                            return `${hours}h ${minutes}min`;
                        } else if (hours > 0) {
                            return `${hours}h`;
                        } else {
                            return `${minutes}min`;
                        }
                    }
                },
                // 3. Precios & Vehículos (based on selected rate from header dropdown)
                {
                    data: null,
                    defaultContent: '',
                    orderable: false,
                    render: function(data, type, row) {
                        // Handle empty/undefined row data gracefully
                        if (!row || typeof row !== 'object' || Object.keys(row).length === 0) {
                            return '<div class="text-muted small">Cargando...</div>';
                        }
                        
                        const selectedRate = $(`#headerRateFilter-${tableId}`).val();
                        const selectedRateText = $(`#headerRateFilter-${tableId} option:selected`).text();
                        
                        
                        // Generate expand button (always present)
                        const expandButton = `
                            <button class="btn btn-link btn-sm p-0 mt-1 expand-prices-btn" 
                                    data-row-id="${row.id || row.objectId}"
                                    style="font-size: 0.75rem; text-decoration: none;">
                                <i class="ti ti-chevron-down me-1"></i>
                                Ver todos
                            </button>`;
                        
                        // Check if we have price data for the selected rate OR client prices available
                        if ((row.priceData && row.priceData.length > 0) || (selectedRate && row.hasClientPrices && row.clientPrices) || (selectedRate && row.clientPrices)) {
                            // Priority 1: Use priceData if available (from rate-specific API call)
                            if (row.priceData && row.priceData.length > 0) {
                            // Show vehicle types for selected rate (sorted by price low to high)
                            const sortedPrices = [...row.priceData].sort((a, b) => (a.price || 0) - (b.price || 0));
                            let pricesHtml = sortedPrices.map(p => {
                                // Get capacity info from price data
                                const defaultCapacity = p.vehicleType?.defaultCapacity || 4;
                                const vehicleName = p.vehicleType?.name || 'Vehículo';
                                const price = p.formattedPrice;
                                
                                return `
                                    <div class="price-item-card p-2 mb-2 border rounded bg-white" style="border-left: 3px solid #6c757d;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="flex-grow-1">
                                                <div class="fw-semibold small text-dark">${vehicleName}</div>
                                                <div class="text-muted d-flex align-items-center gap-2" style="font-size: 0.7rem;">
                                                    <span>${defaultCapacity} <i class="ti ti-user"></i></span>
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold text-primary small" data-original-price="${price}">${price}</div>
                                                <div class="text-muted" style="font-size: 0.65rem;">por hora</div>
                                            </div>
                                        </div>
                                    </div>
                                `;
                            }).join('');
                            
                            // Add expand button for all rates
                            const expandButton = `
                                <button class="btn btn-link btn-sm p-0 mt-1 expand-prices-btn" 
                                        data-row-id="${row.id || row.objectId}"
                                        style="font-size: 0.75rem; text-decoration: none;">
                                    <i class="ti ti-chevron-down me-1"></i>
                                    Ver todos
                                </button>`;
                            
                            return `<div class="price-container" data-row-id="${row.id || row.objectId}">
                                        <div class="small text-primary fw-semibold mb-2">${selectedRateText}</div>
                                        ${pricesHtml}
                                        ${expandButton}
                                    </div>`;
                            } else if (selectedRate && row.hasClientPrices && row.clientPrices) {
                                // Priority 2: Use client prices when no rate-specific priceData available
                                const clientPricesForRate = {};
                                Object.keys(row.clientPrices).forEach(key => {
                                    if (key.startsWith(selectedRate + '_')) {
                                        clientPricesForRate[key] = row.clientPrices[key];
                                    }
                                });
                                
                                if (Object.keys(clientPricesForRate).length > 0) {
                                    const clientPricesList = Object.entries(clientPricesForRate).map(([key, priceInfo]) => ({
                                        vehicleId: key.split('_')[1],
                                        price: priceInfo.price,
                                        formattedPrice: priceInfo.formattedPrice || `$${Math.round(priceInfo.price).toLocaleString()} MXN`,
                                        isClientPrice: true
                                    }));
                                    
                                    // Sort by price
                                    const sortedClientPrices = clientPricesList.sort((a, b) => a.price - b.price);
                                    
                                    let clientPricesHtml = sortedClientPrices.map(p => {
                                        return `
                                            <div class="price-item-card p-2 mb-2 border rounded bg-white" style="border-left: 3px solid #10b981;">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="flex-grow-1">
                                                        <div class="fw-semibold small text-dark">Sedan</div>
                                                        <div class="text-muted d-flex align-items-center gap-2" style="font-size: 0.7rem;">
                                                            <span class="badge bg-success">Cliente</span>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <div class="fw-bold text-success small" data-original-price="${p.formattedPrice}">${p.formattedPrice}</div>
                                                        <div class="text-muted" style="font-size: 0.65rem;">por hora</div>
                                                    </div>
                                                </div>
                                            </div>
                                        `;
                                    }).join('');
                                    
                                    const expandButton = `
                                        <button class="btn btn-link btn-sm p-0 mt-1 expand-prices-btn" 
                                                data-row-id="${row.id || row.objectId}"
                                                style="font-size: 0.75rem; text-decoration: none;">
                                            <i class="ti ti-chevron-down me-1"></i>
                                            Ver todos
                                        </button>`;
                                    
                                    return `<div class="price-container" data-row-id="${row.id || row.objectId}">
                                                <div class="small text-success fw-semibold mb-2">${selectedRateText} (Cliente)</div>
                                                ${clientPricesHtml}
                                                ${expandButton}
                                            </div>`;
                                }
                            }
                            
                            // Fallback: if no client prices found for the selected rate, show placeholder
                            return `<div class="price-container" data-row-id="${row.id || row.objectId}">
                                        <div class="text-muted small">Selecciona una categoría</div>
                                        ${expandButton}
                                    </div>`;
                        } else {
                            // Show placeholder when no rate selected or no data available
                            const expandButton = `
                                <button class="btn btn-link btn-sm p-0 mt-1 expand-prices-btn" 
                                        data-row-id="${row.id || row.objectId}"
                                        style="font-size: 0.75rem; text-decoration: none;">
                                    <i class="ti ti-chevron-down me-1"></i>
                                    Ver todos
                                </button>`;
                            
                            return `<div class="price-container" data-row-id="${row.id || row.objectId}">
                                        <div class="text-muted small">Selecciona una categoría</div>
                                        ${expandButton}
                                    </div>`;
                        }
                    },
                    className: 'price-column',
                    orderable: false
                },
                // 4. Estado (only for admin and superadmin)
                <% if (!isDepartmentManager && !isClient) { %>
                {
                    data: 'active',
                    defaultContent: '<span class="badge bg-secondary">-</span>',
                    orderable: false,
                    render: function(data) {
                        return data
                            ? '<span class="badge bg-success">Activo</span>'
                            : '<span class="badge bg-secondary">Inactivo</span>';
                    }
                },
                <% } %>
                ...(showClientPricing ? [{
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center',
                    render: function(data) {
                        const tourId = data.objectId || data.id;
                        const hasClientPrices = data.hasClientPrices || false;
                        const clientPrices = data.clientPrices || {};
                        
                        // Debug logging for tour IkHiggPBAF
                        if (tourId === 'IkHiggPBAF') {
                        }
                        
                        if (hasClientPrices && Object.keys(clientPrices).length > 0) {
                            const formatMXN = (amount) => new Intl.NumberFormat('es-MX', {
                                style: 'currency',
                                currency: 'MXN'
                            }).format(amount);
                            
                            // Get the first client price to show as example
                            const firstPriceKey = Object.keys(clientPrices)[0];
                            const firstPrice = clientPrices[firstPriceKey];
                            const priceCount = Object.keys(clientPrices).length;
                            
                            return `
                                <div class="text-center">
                                    <button class="btn btn-sm btn-outline-success configure-client-price-btn" data-tour-id="${tourId}">
                                        <i class="ti ti-settings"></i> Configurar
                                    </button>
                                </div>
                            `;
                        } else {
                            return `
                                <div class="text-center">
                                    <button class="btn btn-sm btn-primary configure-client-price-btn" data-tour-id="${tourId}">
                                        <i class="ti ti-plus"></i> Configurar
                                    </button>
                                </div>
                            `;
                        }
                    }
                }] : []),
                ...(showActions ? [{
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center',
                    render: function(data) {
                        let actions = '<div class="btn-group btn-group-sm" role="group">';

                        if (canEdit) {
                            // Edit button
                            actions += `<button type="button"
                                            class="btn btn-primary edit-tour-btn"
                                            data-id="${data.objectId || data.id}"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Editar Tour">
                                            <i class="ti ti-edit"></i>
                                        </button>`;
                            
                            // Price history button (admin/superadmin can view price history)
                            actions += `<button type="button"
                                            class="btn btn-secondary view-price-history-btn"
                                            data-id="${data.objectId || data.id}"
                                            data-name="${data.destinationPOI?.name || 'Tour'}"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Ver Historial de Precios">
                                            <i class="ti ti-chart-line"></i>
                                        </button>`;

                            // Toggle status button
                            const statusIcon = data.active ? 'ti-archive' : 'ti-archive-off';
                            const statusTitle = data.active ? 'Desactivar Tour' : 'Activar Tour';
                            const statusClass = data.active ? 'btn-warning' : 'btn-success';

                            actions += `<button type="button"
                                            class="btn ${statusClass} toggle-status-btn"
                                            data-id="${data.objectId || data.id}"
                                            data-current-status="${data.active}"
                                            data-destination="${data.destinationPOI?.name}"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="${statusTitle}">
                                            <i class="ti ${statusIcon}"></i>
                                        </button>`;
                        }

                        if (canDelete) {
                            // Delete button
                            actions += `<button type="button"
                                            class="btn btn-danger delete-tour-btn"
                                            data-id="${data.objectId || data.id}"
                                            data-destination="${data.destinationPOI?.name}"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Eliminar Tour">
                                            <i class="ti ti-trash"></i>
                                        </button>`;
                        }

                        actions += '</div>';
                        return actions;
                    }
                }] : [])
            ],
            language: {
                url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-MX.json',
                processing: '<i class="fas fa-spinner fa-spin fa-2x"></i><br>Cargando tours...'
            },
            order: [], // No initial DataTable ordering - we handle sorting in JavaScript
            ordering: false, // Disable all interactive column sorting
            pageLength: 10,
            searchDelay: 300,
