                if (pathSegments.includes('clients') && pathSegments.length > pathSegments.indexOf('clients') + 1) {
                    priceModalClientId = pathSegments[pathSegments.indexOf('clients') + 1];
                }
                
                if (!priceModalClientId) {
                    const clientElement = document.querySelector('[data-client-id]');
                    if (clientElement) {
                        priceModalClientId = clientElement.dataset.clientId;
                    }
                }
                
                // Load rate prices with client-specific prices if available
                const endpoint = priceModalClientId 
                    ? `/api/tours/${tourId}/all-rate-prices-with-client-prices?clientId=${priceModalClientId}`
                    : `/api/tours/${tourId}/all-prices`;
                    
                console.log('Loading tour prices from endpoint:', endpoint);
                
                const response = await fetch(endpoint, {
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('accessToken')}`,
                        'Content-Type': 'application/json'
                    }
                });
                
                if (!response.ok) {
                    throw new Error('Error al cargar las tarifas y precios');
                }
                
                const data = await response.json();
                const tourPrices = data.success ? data.data : [];
                
                // Build the rates and prices HTML
                let ratesHtml = '';
                
                // Group tour prices by rate
                const rateGroups = {};
                tourPrices.forEach(tourPrice => {
                    const rate = tourPrice.rate;
                    if (!rate) return;
                    
                    const rateId = rate.id;
                    if (!rateGroups[rateId]) {
                        rateGroups[rateId] = {
                            rate: rate,
                            vehicles: []
                        };
                    }
                    rateGroups[rateId].vehicles.push(tourPrice);
                });
                
                // Generate HTML for each rate group
                Object.keys(rateGroups).forEach(rateId => {
                    const rateGroup = rateGroups[rateId];
                    const rate = rateGroup.rate;
                    
                    ratesHtml += `
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <span class="badge" style="background-color: ${rate.color || '#6c757d'}">${rate.name}</span>
                                </h5>
                                <small class="text-muted">Configurar precios por tipo de vehículo</small>
                            </div>
                            <div class="card-body">
                    `;
                    
                    // Generate HTML for each vehicle type in this rate
                    rateGroup.vehicles.forEach(tourPrice => {
                        const vehicleType = tourPrice.vehicleType;
                        const currentPrice = tourPrice.price || 0;
                        const basePrice = tourPrice.basePrice || currentPrice;
                        const isClientPrice = tourPrice.isClientPrice || false;
                        
                        // Determine labels and styling based on whether this is a client price
                        const basePriceLabel = 'Precio Base:';
                        const clientPriceLabel = isClientPrice ? 'Precio Cliente (Actual):' : 'Precio Cliente:';
                        const priceDisplayClass = isClientPrice ? 'text-success fw-bold' : 'text-muted';
                        const clientPriceInputClass = isClientPrice ? 'border-success' : '';
                        
                        ratesHtml += `
                            <div class="row mb-3 pb-3 border-bottom ${isClientPrice ? 'bg-light' : ''}">
                                <div class="col-md-3">
                                    <div class="d-flex align-items-center">
                                        <i class="ti ti-car me-2 text-primary"></i>
                                        <div>
                                            <strong>${vehicleType?.name || 'Vehículo'}</strong>
                                            ${isClientPrice ? '<span class="badge bg-success ms-2">Personalizado</span>' : ''}
                                            <br>
                                            <small class="text-muted">${vehicleType?.code || ''} - Capacidad: ${vehicleType?.defaultCapacity || 'N/A'} pax</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label mb-1">${basePriceLabel}</label>
                                    <div class="fw-bold text-muted">
                                        ${basePrice > 0 ? new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(basePrice) : 'Sin precio'}
                                    </div>
                                    ${isClientPrice ? `
                                        <label class="form-label mb-1 mt-2">Precio Actual:</label>
                                        <div class="${priceDisplayClass}">
                                            ${new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(currentPrice)}
                                        </div>
                                    ` : ''}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="tourClientPrice_${rateId}_${vehicleType?.id}">${clientPriceLabel}</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" 
                                               class="form-control tour-client-price-input ${clientPriceInputClass}" 
                                               id="tourClientPrice_${rateId}_${vehicleType?.id}"
                                               data-rate-id="${rateId}"
                                               data-vehicle-type-id="${vehicleType?.id}"
                                               data-rate-name="${rate.name}"
                                               data-vehicle-name="${vehicleType?.name}"
                                               data-base-price="${basePrice}"
                                               step="0.01" 
                                               min="0" 
                                               placeholder="0.00"
                                               value="${currentPrice > 0 ? currentPrice.toFixed(2) : ''}"
                                               data-original-value="${currentPrice > 0 ? currentPrice.toFixed(2) : ''}">
                                        <span class="input-group-text">MXN</span>
                                    </div>
                                    ${isClientPrice ? '<small class="text-success">✓ Precio personalizado activo</small>' : '<small class="text-muted">Deja en blanco para usar precio base</small>'}
                                </div>
                            </div>
                        `;
                        
                        // Store original price for change tracking
                        const key = `${rateId}_${vehicleType?.id}`;
                        originalTourPrices[key] = currentPrice > 0 ? currentPrice.toFixed(2) : '';
                    });
                    
                    ratesHtml += `
                            </div>
                        </div>
                    `;
                });
                
                if (tourPrices.length === 0) {
                    ratesHtml = `
                        <div class="text-center py-4">
                            <i class="ti ti-info-circle" style="font-size: 2rem; color: #6c757d;"></i>
                            <h6 class="mt-2 text-muted">No hay tarifas activas</h6>
                            <p class="text-muted mb-0">No se encontraron tarifas activas para configurar.</p>
                        </div>
                    `;
                }
                
                container.innerHTML = ratesHtml;
                
            } catch (error) {
                console.error('Error loading tour rates and prices:', error);
                container.innerHTML = `
                    <div class="text-center py-4">
                        <i class="ti ti-alert-circle" style="font-size: 2rem; color: #dc3545;"></i>
                        <h6 class="mt-2 text-danger">Error al cargar</h6>
                        <p class="text-muted mb-0">No se pudieron cargar las tarifas. Intenta de nuevo.</p>
                        <small class="text-muted">${error.message}</small>
                    </div>
                `;
            }
        }
        
        // Function to save all tour client prices
        async function saveAllTourClientPrices() {
            const tourId = document.getElementById('modalTourId').value;
            const clientPrices = [];
            
            // Get client ID from URL
            let saveClientId = null;
            const pathSegments = window.location.pathname.split('/');
            if (pathSegments.includes('clients') && pathSegments.length > pathSegments.indexOf('clients') + 1) {
                saveClientId = pathSegments[pathSegments.indexOf('clients') + 1];
            }
            
            if (!saveClientId) {
                const clientElement = document.querySelector('[data-client-id]');
                if (clientElement) {
                    saveClientId = clientElement.dataset.clientId;
                }
            }
            
            if (!saveClientId) {
                console.error('Error: No se pudo identificar el cliente.');
                if (window.showNotification) {
                    window.showNotification('error', 'Error: No se pudo identificar el cliente. Por favor, recarga la página.');
                }
                return;
            }
            
            // Collect only modified client prices from the form
            document.querySelectorAll('.tour-client-price-input').forEach(input => {
                const rateId = input.dataset.rateId;
                const vehicleTypeId = input.dataset.vehicleTypeId;
                const rateName = input.dataset.rateName;
                const vehicleName = input.dataset.vehicleName;
                const currentValue = input.value.trim();
                const originalValue = input.dataset.originalValue || '';
                const price = parseFloat(currentValue) || 0;
                
                // Get base price from data attribute
                const basePrice = parseFloat(input.dataset.basePrice) || 0;
                
                // Only save if the price was actually changed by the user
                const hasChanged = currentValue !== originalValue;
                const isValidPrice = price > 0;
                const isDifferentFromBase = price !== basePrice;
                
                if (hasChanged && isValidPrice && isDifferentFromBase) {
                    clientPrices.push({
                        ratePtr: rateId,
                        vehiclePtr: vehicleTypeId,
                        precio: price,
                        basePrice: basePrice,
                        rateName: rateName,
                        vehicleName: vehicleName,
                        originalValue: originalValue,
                        newValue: currentValue
                    });
                    console.log(`💡 Price changed for ${vehicleName} (${rateName}): ${originalValue} → ${currentValue}`);
                } else if (hasChanged) {
                    console.log(`⚠️ Price changed but not valid for ${vehicleName} (${rateName}): ${originalValue} → ${currentValue} (valid: ${isValidPrice}, different from base: ${isDifferentFromBase})`);
                }
            });
            
            if (clientPrices.length === 0) {
                console.warn('No se detectaron cambios en los precios. Modifica los precios para guardar.');
                
                if (window.showNotification) {
                    window.showNotification('warning', 'No se detectaron cambios en los precios. Solo se guardan los precios que hayas modificado.');
                }
                
                return;
            }
            
            console.log(`💾 Saving ${clientPrices.length} modified tour client prices:`, {
                clientId: saveClientId,
                tourId: tourId,
                modifiedPrices: clientPrices,
                itemType: 'TOUR'
            });
            
            // Show loading state
            const saveButton = document.querySelector('#tourClientPricingModal .btn-primary');
            const originalText = saveButton.innerHTML;
            saveButton.disabled = true;
            saveButton.innerHTML = '<i class="ti ti-loader-2 me-1 spinner-border spinner-border-sm"></i>Guardando...';
            
            try {
                // Save client prices using the new tour-specific API endpoint
                const response = await fetch('/api/tours/client-prices', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('accessToken') || ''}`
                    },
                    body: JSON.stringify({
                        clientId: saveClientId,
                        tourId: tourId,
                        prices: clientPrices
                    })
                });
                
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || 'Error al guardar los precios');
                }
                
                const result = await response.json();
                
                // Show success message
                const totalPrices = clientPrices.length;
                const itemType = result.itemType || 'TOUR';
                
                if (window.showNotification) {
                    window.showNotification('success', result.message || `Se guardaron ${totalPrices} precio(s) personalizados para este tour (itemType: ${itemType}).`);
                }
                
                console.log('✅ Tour client prices saved:', {
                    message: result.message || 'Precios guardados exitosamente',
                    itemType: itemType
                });
                
                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('tourClientPricingModal'));
                if (modal) {
                    modal.hide();
                }
                
                // Refresh the table to show updated prices by triggering rate filter
                try {
                    // Find the correct table ID
                    let currentTableId = 'client-tours-table'; // Default for client detail page
                    
                    // Check if we have a tours table element visible
                    if (document.getElementById('client-tours-table')) {
                        currentTableId = 'client-tours-table';
                    } else if (document.getElementById('tours-table')) {
                        currentTableId = 'tours-table';
                    }
                    
                    // Get the current rate selection and trigger refresh
                    const headerRateFilter = $(`#headerRateFilter-${currentTableId}`);
                    const currentSelectedRate = headerRateFilter.val();
                    
                    if (currentSelectedRate && currentSelectedRate !== '') {
                        console.log(`🔄 Refreshing tours table by triggering rate filter for: ${currentSelectedRate}`);
                        // Trigger the rate filter change to reload data with client prices
                        headerRateFilter.trigger('change');
                        console.log(`✅ Tours table refresh triggered for table: ${currentTableId}`);
                    } else {
                        console.log('⚠️ No rate selected in filter. Table data may not refresh automatically.');
                        // If no rate is selected, try to show a message to user
                        if (window.showNotification) {
                            window.showNotification('info', 'Selecciona una categoría de tarifa para ver los precios actualizados.');
                        }
                    }
                } catch (refreshError) {
                    console.warn('⚠️ Error refreshing table:', refreshError.message, '- Prices saved successfully.');
                    // Reload page as fallback
                    setTimeout(() => {
                        if (window.location.pathname.includes('/clients/')) {
                            window.location.reload();
                        }
                    }, 1500);
                }
                
            } catch (error) {
                console.error('Error saving tour client prices:', error);
                
                if (window.showNotification) {
                    window.showNotification('error', 'Error al guardar los precios: ' + error.message);
                }
                
                console.error('❌ Error saving tour prices:', error.message);
            } finally {
                // Restore button state
                saveButton.disabled = false;
                saveButton.innerHTML = originalText;
            }
        }
        
        // Store function in window scope for modal access
        window._saveAllTourClientPrices = saveAllTourClientPrices;
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWhenReady);
    } else {
        initWhenReady();
    }
    
    // Attach event listener for save button after DOM is ready
    function attachSaveButtonListener() {
        const saveBtn = document.getElementById('saveTourClientPricesBtn');
        if (saveBtn && window._saveAllTourClientPrices) {
            saveBtn.removeEventListener('click', window._saveAllTourClientPrices); // Remove any existing listener
            saveBtn.addEventListener('click', window._saveAllTourClientPrices);
            console.log('✅ Tour client prices save button listener attached');
        } else {
            console.warn('⚠️ Tour save button or function not found, retrying...');
            setTimeout(attachSaveButtonListener, 500);
        }
    }
    
    // Attach listener when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(attachSaveButtonListener, 100);
        });
    } else {
        setTimeout(attachSaveButtonListener, 100);
    }
})();

// ========== TOUR PRICE HISTORY MODAL MANAGEMENT ==========

/**
 * Open tour price history modal and load price history data
 * @param {string} tourId - ID of the tour
 * @param {string} tourName - Name of the tour
 */
function openTourPriceHistoryModal(tourId, tourName) {
    // Set tour name in modal
    document.getElementById('tourPriceHistoryTourName').textContent = `Tour: ${tourName}`;
    
    // Reset modal states
    resetTourPriceHistoryModalStates();
    
    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('tourPriceHistoryModal'));
    modal.show();
    
    // Load price history data
    loadTourPriceHistoryData(tourId);
}

/**
 * Reset all modal states to initial
 */
function resetTourPriceHistoryModalStates() {
    document.getElementById('tourPriceHistoryLoading').classList.remove('d-none');
    document.getElementById('tourPriceHistoryError').classList.add('d-none');
    document.getElementById('tourPriceHistoryNoData').classList.add('d-none');
    document.getElementById('tourPriceHistoryContent').classList.add('d-none');
    document.getElementById('tourPriceHistoryTableBody').innerHTML = '';
}

/**
 * Load tour price history data from API
 * @param {string} tourId - ID of the tour
 */
function loadTourPriceHistoryData(tourId) {
    fetch(`/api/tours/${tourId}/price-history`)
        .then(response => response.json())
        .then(data => {
            document.getElementById('tourPriceHistoryLoading').classList.add('d-none');
            
            if (data.success) {
                if (data.data && data.data.length > 0) {
                    populateTourPriceHistoryTable(data.data);
                    document.getElementById('tourPriceHistoryContent').classList.remove('d-none');
                } else {
                    document.getElementById('tourPriceHistoryNoData').classList.remove('d-none');
                }
            } else {
                showTourPriceHistoryError(data.error || 'Error al cargar el historial de precios');
            }
        })
        .catch(error => {
            console.error('Error loading tour price history:', error);
            document.getElementById('tourPriceHistoryLoading').classList.add('d-none');
            showTourPriceHistoryError('Error de conexión al cargar el historial de precios');
        });
}

/**
 * Populate the tour price history table with data
 * @param {Array} historyData - Array of price history records
 */
function populateTourPriceHistoryTable(historyData) {
    const tbody = document.getElementById('tourPriceHistoryTableBody');
    tbody.innerHTML = '';

    historyData.forEach(record => {
        const row = document.createElement('tr');
        
        // Format dates
        const validFrom = new Date(record.validFrom).toLocaleDateString('es-MX', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
        });
        
        const validUntil = record.validUntil 
            ? new Date(record.validUntil).toLocaleDateString('es-MX', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
              })
            : 'Vigente';

        // Format price
        const formattedPrice = parseFloat(record.price).toLocaleString('es-MX', {
            style: 'currency',
            currency: 'MXN'
        });

        // Duration text
        const durationText = record.duration ? `${record.duration} días` : 'N/A';

        // Status badge
        const statusBadge = record.status === 'active' 
            ? '<span class="badge bg-success">Activo</span>'
            : '<span class="badge bg-secondary">Histórico</span>';

        row.innerHTML = `
            <td>${validFrom}</td>
            <td class="fw-semibold text-primary">${formattedPrice}</td>
            <td>${record.vehicleTypeName || 'N/A'}</td>
            <td>${record.rateName || 'N/A'}</td>
            <td>${validUntil}</td>
            <td>${durationText}</td>
            <td>${statusBadge}</td>
        `;

        tbody.appendChild(row);
    });
}

/**
 * Show error message in tour price history modal
 * @param {string} message - Error message to display
 */
function showTourPriceHistoryError(message) {
    document.getElementById('tourPriceHistoryErrorMessage').textContent = message;
    document.getElementById('tourPriceHistoryError').classList.remove('d-none');
}

// ========== END TOUR PRICE HISTORY MODAL MANAGEMENT ==========
</script>

