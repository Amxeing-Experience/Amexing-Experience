/**
 * Apply driver rate to price
 * @param {number} basePrice - Base price to add driver rate to
 * @returns {number} Price with driver rate added
 */
function applyDriverRate(basePrice) {
    return basePrice + currentDriverRate;
}

/**
 * Vanilla JavaScript version of price update functionality
 * @param {string} paymentType - Payment type
 * @param {string} currency - Currency
 * @param {boolean} includeDriver - Include driver rate
 */
function updatePricesVanilla(paymentType = 'efectivo', currency = 'MXN', includeDriver = false) {

    // Find all price containers using vanilla JavaScript
    const priceContainers = document.querySelectorAll('.price-container');

    priceContainers.forEach(container => {
        const priceElements = container.querySelectorAll('.fw-bold');
        
        priceElements.forEach(priceElement => {
            // Get or store original price
            let originalPrice = priceElement.dataset.originalPrice;
            if (!originalPrice) {
                originalPrice = priceElement.textContent.trim();
                priceElement.dataset.originalPrice = originalPrice;
            }
            
            // Parse the original price to get numeric value
            const numericPrice = parseFloat(originalPrice.replace(/[^\d.-]/g, '')) || 0;
            let finalPrice = numericPrice;
            
            // Step 1: Apply driver rate if needed (Guía + Chofer)
            if (includeDriver && TourPricingState.getDriverRate() > 0) {
                finalPrice += TourPricingState.getDriverRate();
            }
            
            // Step 2: Apply payment type rates
            const transferRate = TourPricingState.getTransferRate();
            const agencyRate = TourPricingState.getAgencyRate();
            
            if (paymentType === 'transferencia' && transferRate > 0) {
                finalPrice *= (1 + transferRate / 100);
            } else if (paymentType === 'tarjeta' && agencyRate > 0) {
                finalPrice *= (1 + agencyRate / 100);
            }
            
            // Step 3: Apply currency conversion if needed
            const exchangeRate = TourPricingState.getExchangeRate();
            if (currency === 'USD' && exchangeRate > 0) {
                finalPrice /= exchangeRate;
            }
            
            // Format the final price - USD without decimals, MXN with decimals
            let formattedPrice;
            if (currency === 'USD') {
                formattedPrice = new Intl.NumberFormat('en-US', {
                    style: 'currency',
                    currency: 'USD',
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                }).format(finalPrice);
            } else {
                formattedPrice = new Intl.NumberFormat('es-MX', {
                    style: 'currency',
                    currency: 'MXN',
                    minimumFractionDigits: 2
                }).format(finalPrice);
            }
            
            priceElement.textContent = formattedPrice;
        });
    });
}

/**
 * Update vehicle capacity displays based on driver mode
 * @param {boolean} includeDriver - Whether driver is included (reduces capacity by 1)
 */
function updateCapacityDisplays(includeDriver) {
    // Update capacity displays in the table
    document.querySelectorAll('span').forEach(span => {
        if (span.innerHTML && span.innerHTML.includes('ti-user') && span.textContent.match(/^\d+/)) {
            // Store original capacity if not already stored
            if (!span.dataset.originalCapacity) {
                const match = span.textContent.match(/^(\d+)/);
                if (match) {
                    span.dataset.originalCapacity = match[1];
                }
            }
            
            const originalCapacity = parseInt(span.dataset.originalCapacity) || 4;
            const displayCapacity = includeDriver ? Math.max(1, originalCapacity - 1) : originalCapacity;
            span.innerHTML = `${displayCapacity} <i class="ti ti-user"></i>`;
        }
    });
    
    // Update capacity in detailed views (like expanded rows)
    document.querySelectorAll('.text-muted').forEach(element => {
        if (element.textContent && element.textContent.includes('Capacidad:')) {
            if (!element.dataset.originalCapacity) {
                const match = element.textContent.match(/Capacidad:\s*(\d+)/);
                if (match) {
                    element.dataset.originalCapacity = match[1];
                }
            }
            
            const originalCapacity = parseInt(element.dataset.originalCapacity) || 4;
            const displayCapacity = includeDriver ? Math.max(1, originalCapacity - 1) : originalCapacity;
            element.innerHTML = element.innerHTML.replace(
                /Capacidad:\s*\d+/,
                `Capacidad: ${displayCapacity}`
            );
        }
    });
}

/**
 * Unified update function for both prices and capacity
 * @param {string} paymentType - Payment type
 * @param {string} currency - Currency  
 * @param {boolean} includeDriver - Whether to include driver
 */
function updateToursDisplay(paymentType = 'efectivo', currency = 'MXN', includeDriver = false) {

    
    updateCapacityDisplays(includeDriver);
    updatePricesVanilla(paymentType, currency, includeDriver);

}

/**
