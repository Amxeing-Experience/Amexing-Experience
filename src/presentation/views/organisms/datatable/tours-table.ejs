// Centralized state management for all rates and pricing
const TourPricingState = {
    rates: {
        driver: { value: 0, loaded: false },
        transfer: { value: 0, loaded: false },
        agency: { value: 0, loaded: false },
        exchange: { value: 0, loaded: false }
    },
    
    // Getters for rate values
    getDriverRate() { return this.rates.driver.value; },
    getTransferRate() { return window.currentTransferRate || this.rates.transfer.value; },
    getAgencyRate() { return window.currentAgencyRate || this.rates.agency.value; },
    getExchangeRate() { return window.currentExchangeRate || this.rates.exchange.value; },
    
    // Setters for rate values (sync with window properties for backward compatibility)
    setDriverRate(value) { 
        this.rates.driver.value = value; 
        this.rates.driver.loaded = true;
    },
    setTransferRate(value) { 
        this.rates.transfer.value = window.currentTransferRate = value; 
        this.rates.transfer.loaded = true;
    },
    setAgencyRate(value) { 
        this.rates.agency.value = window.currentAgencyRate = value; 
        this.rates.agency.loaded = true;
    },
    setExchangeRate(value) { 
        this.rates.exchange.value = window.currentExchangeRate = value; 
        this.rates.exchange.loaded = true;
    }
};

// Legacy support - maintain backward compatibility
let currentDriverRate = 0;
let driverRateLoaded = false;
let globalTransferRate = 0;
let globalAgencyRate = 0;
let transferRateLoaded = false;
let agencyRateLoaded = false;

/**
 * Fetch current driver tour rate from API
 * @returns {Promise<number>} Current driver rate value
 */
async function fetchCurrentDriverRate() {
    try {
        const token = await getAccessToken();
        if (!token) {
            console.warn('No access token found, skipping driver rate fetch');
            return 0;
        }
        const response = await fetch('/api/driver-tour-rate/current', {
            method: 'GET',
            headers: {
                'Authorization': token ? `Bearer ${token}` : '',
                'Content-Type': 'application/json'
            }
        });

        if (response.ok) {
            const data = await response.json();
            if (data.success && data.data) {
                const rate = data.data.value || 0;
                TourPricingState.setDriverRate(rate);
                currentDriverRate = rate; // Legacy support

                return rate;
            }
        } else if (response.status === 404) {

            return await createDefaultDriverRate();
        }
        
        throw new Error('Failed to fetch driver rate');
    } catch (error) {
        console.error('❌ Error fetching driver rate:', error);
        return await createDefaultDriverRate();
    }
}

/**
 * Create default driver tour rate if none exists
 * @returns {Promise<number>} Created driver rate value
 */
async function createDefaultDriverRate() {
    try {
        const token = await getAccessToken();
        const response = await fetch('/api/driver-tour-rate', {
            method: 'POST',
            headers: {
                'Authorization': token ? `Bearer ${token}` : '',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                value: 635,
                active: true,
                exists: true
            })
        });

        if (response.ok) {
            const data = await response.json();
            if (data.success && data.data) {
                const rate = data.data.value || 635;
                TourPricingState.setDriverRate(rate);
                currentDriverRate = rate; // Legacy support

                return rate;
            }
        }
        
        // Fallback to default value if creation fails
        console.warn('⚠️ Failed to create driver rate, using default value');
        const defaultRate = 635;
        TourPricingState.setDriverRate(defaultRate);
        currentDriverRate = defaultRate; // Legacy support
        return defaultRate;
    } catch (error) {
        console.error('❌ Error creating default driver rate:', error);
        const defaultRate = 635;
        TourPricingState.setDriverRate(defaultRate);
        currentDriverRate = defaultRate; // Legacy support
        return defaultRate;
    }
}

