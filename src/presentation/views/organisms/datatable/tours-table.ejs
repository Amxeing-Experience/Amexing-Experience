        async function saveBasePricing(tourId) {
            const basePrices = [];
            
            // Collect all base price inputs
            $('.base-price-input').each(function() {
                const input = $(this);
                const price = parseFloat(input.val()) || 0;
                const priceId = input.data('price-id');
                const rateId = input.data('rate-id');
                const vehicleId = input.data('vehicle-id');
                
                if (price > 0 && priceId) {
                    basePrices.push({
                        id: priceId,
                        rateId: rateId,
                        vehicleId: vehicleId,
                        price: price
                    });
                }
            });
            
            if (basePrices.length === 0) {
                return; // No prices to save
            }
            
            try {
                const token = getAccessToken();
                const response = await fetch(`${apiEndpoint}/${tourId}/update-base-prices`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        prices: basePrices
                    })
                });
                
