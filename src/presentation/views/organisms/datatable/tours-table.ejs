 */
function updateExpandedRowPrices(paymentType = 'efectivo', currency = 'MXN', includeDriver = false) {

    // Find all price elements in expanded rows directly by looking for the expanded content structure
    // DataTables child rows contain our custom HTML with data-original-price attributes
    const priceElements = document.querySelectorAll('.p-4.bg-light.border-top .fw-bold[data-original-price]');
    
    if (priceElements.length === 0) {

        // Try alternative selectors for debugging
        const expandedContainers = document.querySelectorAll('.p-4.bg-light.border-top');

        if (expandedContainers.length > 0) {
            expandedContainers.forEach((container, i) => {
                const prices = container.querySelectorAll('.fw-bold');

                prices.forEach(p => {
                });
            });
        }
        
        return;
    }

    // Process each price element found
    priceElements.forEach((priceElement, index) => {
            const originalPriceAttr = priceElement.getAttribute('data-original-price');
            if (!originalPriceAttr) {

                return;
            }
            
            // Extract numeric value from original price
            const numericValue = parseFloat(originalPriceAttr.replace(/[^0-9.]/g, ''));
            if (isNaN(numericValue)) {

                return;
            }

            let finalPrice = numericValue;
            
            // Step 1: Add driver rate if active
            if (includeDriver) {
                const driverRate = TourPricingState.getDriverRate();
                if (driverRate > 0) {
                    finalPrice += driverRate;

                }
            }
            
            // Step 2: Apply payment rate
            if (paymentType === 'transferencia') {
                const transferRate = TourPricingState.getTransferRate();
                if (transferRate > 0) {
                    finalPrice = finalPrice * (1 + transferRate / 100);

                }
            } else if (paymentType === 'tarjeta') {
                const agencyRate = TourPricingState.getAgencyRate();
                if (agencyRate > 0) {
                    finalPrice = finalPrice * (1 + agencyRate / 100);

                }
            }
            
            // Step 3: Apply currency conversion
            if (currency === 'USD') {
                const exchangeRate = TourPricingState.getExchangeRate();
                if (exchangeRate > 0) {
                    finalPrice = finalPrice / exchangeRate;

                }
            }
            
            // Format and display the final price - USD without decimals, MXN with decimals
            const formattedPrice = currency === 'USD' 
                ? new Intl.NumberFormat('en-US', {
                    style: 'currency',
                    currency: 'USD',
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                }).format(finalPrice)
                : new Intl.NumberFormat('es-MX', {
                    style: 'currency',
                    currency: 'MXN',
                    minimumFractionDigits: 2
                }).format(finalPrice);

            priceElement.textContent = formattedPrice;
    });
    
    // Also update capacity in expanded rows
    const capacityElements = document.querySelectorAll('.p-4.bg-light.border-top .text-muted');
    capacityElements.forEach(element => {
        if (element.textContent && element.textContent.includes('Capacidad:')) {
            if (!element.dataset.originalCapacity) {
                const match = element.textContent.match(/Capacidad:\s*(\d+)/);
                if (match) {
                    element.dataset.originalCapacity = match[1];
                }
            }
            
            const originalCapacity = parseInt(element.dataset.originalCapacity) || 4;
            const displayCapacity = includeDriver ? Math.max(1, originalCapacity - 1) : originalCapacity;
            element.innerHTML = element.innerHTML.replace(
                /Capacidad:\s*\d+/,
                `Capacidad: ${displayCapacity}`
            );
        }
    });

}

