 */
function initPaymentDropdownHandler() {

    function setupPaymentDropdown() {
        // Find payment dropdown specifically for tours tables (not services)
        const allPaymentDropdowns = document.querySelectorAll('[id^="paymentTypeFilter-"]');
        let paymentDropdown = null;
        
        for (let dropdown of allPaymentDropdowns) {
            if (dropdown.id.includes('tours')) {
                paymentDropdown = dropdown;
                break;
            }
        }

        if (paymentDropdown) {

            paymentDropdown.addEventListener('change', async function() {
                try {

                    const selectedPaymentType = this.value;
                    const allCurrencyDropdowns = document.querySelectorAll('[id^="currencyFilter-"]');
                    let currencyDropdown = null;
                    for (let dropdown of allCurrencyDropdowns) {
                        if (dropdown.id.includes('tours')) {
                            currencyDropdown = dropdown;
                            break;
                        }
                    }
                    const selectedCurrency = currencyDropdown ? currencyDropdown.value : 'MXN';
                    const includeDriver = isDriverModeActive();
                    
                    // Ensure driver rate is loaded if needed
                    if (includeDriver) {
                        await ensureDriverRateLoaded();
                    }
                    
                    // Ensure rates are loaded for payment types
                    if (selectedPaymentType === 'transferencia' && typeof loadCurrentTransferRate === 'function' && TourPricingState.getTransferRate() <= 0) {
                        try { await loadCurrentTransferRate(); } catch (e) {}
                    } else if (selectedPaymentType === 'tarjeta' && typeof loadCurrentAgencyRate === 'function' && TourPricingState.getAgencyRate() <= 0) {
                        try { await loadCurrentAgencyRate(); } catch (e) {}
                    }
                    
                    // Update both capacity and prices
                    updateToursDisplay(selectedPaymentType, selectedCurrency, includeDriver);
                    
                    // Also update any currently expanded rows with a small delay
                    setTimeout(() => {
                        updateExpandedRowPrices(selectedPaymentType, selectedCurrency, includeDriver);
                    }, 100);
                } catch (error) {
                    console.error('❌ Error in payment dropdown handler:', error);
                }
            });
            return true; // Successfully set up
        } else {
            console.warn('⚠️ Payment dropdown not found - event listener not attached');
            return false; // Failed to set up
        }
