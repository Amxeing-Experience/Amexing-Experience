        function renderBasePricing(priceData) {
            const container = $('#basePricesContainer');
            container.empty();
            
            // Group prices by rate
            const pricesByRate = {};
            priceData.forEach(item => {
                const rateName = item.rate?.name || 'Sin tarifa';
                const rateId = item.rate?.id || 'unknown';
                if (!pricesByRate[rateId]) {
                    pricesByRate[rateId] = {
                        rateName,
                        vehicleTypes: []
                    };
                }
                pricesByRate[rateId].vehicleTypes.push(item);
            });
            
            // Create pricing interface for each rate (sorted alphabetically by rate name)
            Object.keys(pricesByRate).sort((a, b) => {
                const nameA = pricesByRate[a].rateName;
                const nameB = pricesByRate[b].rateName;
                return nameA.localeCompare(nameB);
            }).forEach(rateId => {
                const rateData = pricesByRate[rateId];
                
                // Get rate color from the first vehicle (they all have the same rate)
                const rateColor = rateData.vehicleTypes[0]?.rate?.color || '#059669';
                const textColor = getContrastTextColor(rateColor);
                
                const rateCard = $(`
                    <div class="card mb-2 border-0 shadow-sm">
                        <div class="card-header" style="background-color: ${rateColor};">
                            <h6 class="mb-0 fw-medium" style="color: ${textColor};">${rateData.rateName}</h6>
                        </div>
                        <div class="card-body p-2">
                            <div class="row" id="rate-${rateId}-prices">
                                <!-- Vehicle type prices will be added here -->
                            </div>
                        </div>
                    </div>
                `);
                
                container.append(rateCard);
                
                // Add vehicle type price inputs
                const vehiclesContainer = $(`#rate-${rateId}-prices`);
                rateData.vehicleTypes.forEach(vehicle => {
                    const vehicleInput = $(`
                        <div class="col-md-4 mb-2">
                            <label class="form-label form-label-sm">${vehicle.vehicleType?.name || 'Vehículo'}</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">$</span>
                                <input type="number" 
                                       class="form-control base-price-input" 
                                       data-rate-id="${rateId}"
                                       data-vehicle-id="${vehicle.vehicleType?.id}"
                                       data-price-id="${vehicle.id}"
                                       value="${vehicle.price || 0}"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00">
                                <span class="input-group-text">MXN</span>
                            </div>
                        </div>
