        // Function to update a specific tour row with fresh price data
        async function updateTourRow(tourId) {
            try {
                console.log('🔄 Updating tour row with prices for ID:', tourId);
                
                // Find the row in the DataTable first to check if it's expanded
                const table = dataTable; // Use global dataTable instance
                let targetRowIndex = -1;
                let wasExpanded = false;
                
                // Find the row index by comparing tour IDs
                table.rows().every(function(index) {
                    const rowData = this.data();
                    if (rowData && (rowData.id === tourId || rowData.objectId === tourId)) {
                        targetRowIndex = index;
                        
                        // Check if row was expanded
                        const dtRow = table.row(index);
                        wasExpanded = dtRow.child.isShown();
                        
                        // If row was expanded, collapse it first for better UX
                        if (wasExpanded) {
                            dtRow.child.hide();
                            // Also update the expand button state
                            const expandBtn = $(dtRow.node()).find('.expand-prices-btn');
                            expandBtn.html('<i class="ti ti-chevron-down me-1"></i>Ver todos').removeClass('expanded');
                            console.log('🔽 Collapsed expanded row before update');
                        }
                        return false; // Break the loop
                    }
                    return true; // Continue
                });

                // Get the current rate filter to ensure we fetch pricing data
                const selectedRate = $(`#headerRateFilter-${tableId}`).val();
                const token = getAccessToken();
                
                // Use the main tours endpoint with filtering to get full price data
                let apiUrl = apiEndpoint; // Use main tours endpoint
                let params = [];
                
                if (selectedRate) {
                    params.push(`rateId=${encodeURIComponent(selectedRate)}`);
                }
                
                // Add clientId if available
                const filterClientId = getClientIdFromContext();
                if (filterClientId) {
                    params.push(`clientId=${encodeURIComponent(filterClientId)}`);
                }
                
                // Add cache-busting parameters
                params.push(`_t=${Date.now()}`);
                params.push(`_r=${Math.random()}`);
                params.push(`_cb=${new Date().getTime()}`);
                
                if (params.length > 0) {
                    apiUrl += `?${params.join('&')}`;
                }
                
                console.log('📡 Fetching updated tours data from main endpoint:', apiUrl);
                
                const response = await fetch(apiUrl, {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Cache-Control': 'no-cache, no-store, must-revalidate',
                        'Pragma': 'no-cache',
                        'Expires': '0',
                        'If-Modified-Since': 'Thu, 01 Jan 1970 00:00:00 GMT'
                    }
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();
                if (!result.success || !result.data) {
                    throw new Error('Failed to get updated tours data');
                }

                // Find the specific tour in the response
                const updatedTour = result.data.find(tour => 
                    tour.id === tourId || tour.objectId === tourId
                );
                
                if (!updatedTour) {
                    throw new Error(`Tour with ID ${tourId} not found in response`);
                }
                
                console.log('📊 Found updated tour data with prices:', {
                    id: updatedTour.id,
                    hasPriceData: !!updatedTour.priceData,
                    priceCount: updatedTour.priceData?.length || 0,
                    priceData: updatedTour.priceData,
                    fetchedAt: new Date().toISOString()
                });
                if (targetRowIndex !== -1) {
                    console.log('🎯 Found target row at index:', targetRowIndex);
                    
                    // Update the row data with fresh tour data including prices
                    table.row(targetRowIndex).data(updatedTour).draw(false);
                    
                    // Update the tours data arrays to keep them in sync
                    const tourIndex = allToursData.findIndex(t => t.id === tourId || t.objectId === tourId);
                    if (tourIndex !== -1) {
                        allToursData[tourIndex] = updatedTour;
                    }
                    
                    const filteredIndex = filteredData.findIndex(t => t.id === tourId || t.objectId === tourId);
                    if (filteredIndex !== -1) {
                        filteredData[filteredIndex] = updatedTour;
                    }
                    
                    // Force redraw of the specific row to ensure price updates are visible
                    setTimeout(() => {
                        console.log('🎨 Forcing row redraw...');
                        table.row(targetRowIndex).invalidate().draw(false);
                    }, 100);
                    
                    console.log('✅ Tour row updated successfully with fresh price data');
                    return true;
                } else {
                    console.log('⚠️ Tour row not found in DataTable');
                    return false;
                }
            } catch (error) {
                console.error('Error updating tour row:', error);
                return false;
            }
        }

