        async function saveTour() {
            const form = $('#tourForm');
            if (!form[0].checkValidity()) {
                form[0].reportValidity();
                return;
            }

            const tourId = $('#tourId').val();
            const isEdit = !!tourId;

            try {
                // Wait for Tom Select instances
                const destTS = await waitForTomSelect('destinationPOI');

                // Get values from Tom Select
                const destinationPOI = destTS ? destTS.getValue() : ($('#destinationPOI').val() || '');

                // Process includes field
                const includesText = $('#tourIncludes').val().trim();
                const includesList = includesText ? 
                    includesText.split('\n')
                        .map(item => item.trim())
                        .filter(item => item.length > 0)
                    : [];
                    
                // Process not includes field
                const notIncludesText = $('#tourNotIncludes').val().trim();
                const notIncludesList = notIncludesText ? 
                    notIncludesText.split('\n')
                        .map(item => item.trim())
                        .filter(item => item.length > 0)
                    : [];
                    
                // Process languages field  
                const languagesText = $('#tourLanguages').val().trim();
                const languagesList = languagesText ? 
                    languagesText.split('\n')
                        .map(item => item.trim())
                        .filter(item => item.length > 0)
                    : [];
                    
                // Collect photos data with optimization metadata preservation (same as experience modal)
                const photosList = [];
                const photoElements = $('#tourModal .photos-preview-container .photo-preview');
                photoElements.each(function() {
                    const img = $(this).find('img');
                    if (img.length > 0) {
                        const photoElement = $(this);
                        const photoFullData = photoElement.attr('data-photo-full');
                        
                        // If we have full photo data stored, use it (preserves optimization metadata)
                        if (photoFullData) {
                            try {
                                const fullData = JSON.parse(photoFullData.replace(/&#39;/g, "'"));
                                // Update the dataUrl in case the image was refreshed with a new presigned URL
                                fullData.dataUrl = img.attr('src');
                                photosList.push(fullData);
                            } catch (e) {
                                console.warn('Tour - Failed to parse photo full data, falling back to basic data:', e);
                                // Fallback to basic data
                                photosList.push({
                                    dataUrl: img.attr('src'),
                                    fileName: photoElement.find('small').attr('title') || 'image.jpg'
                                });
                            }
                        } else {
                            // No full data available (new upload)
                            photosList.push({
                                dataUrl: img.attr('src'),
                                fileName: photoElement.find('small').attr('title') || 'image.jpg'
                            });
                        }
                    }
                });

                // Get duration in hours
                const duration = $('#tourDuration').val() ? parseFloat($('#tourDuration').val()) : null;

                const tourData = {
                    destinationPOI: destinationPOI,
                    type: $('#tourType').val() || null,
                    description: $('#tourDescription').val().trim() || null,
                    price: $('#tourPrice').val() ? parseFloat($('#tourPrice').val()) : null,
                    price_no_alcohol: $('#tourPriceNoAlcohol').val() ? parseFloat($('#tourPriceNoAlcohol').val()) : null,
                    price_child: $('#tourPriceChild').val() ? parseFloat($('#tourPriceChild').val()) : null,
                    time: duration ? Math.round(duration * 60) : null, // Convert hours to minutes for backend
                    travel_duration: $('#tourTravelDuration').val() ? parseInt($('#tourTravelDuration').val()) : null,
                    advance_booking_time: $('#tourAdvanceTime').val() ? parseInt($('#tourAdvanceTime').val()) : null,
                    min_people: $('#tourMinPeople').val() ? parseInt($('#tourMinPeople').val()) : null,
                    max_people: $('#tourMaxPeople').val() ? parseInt($('#tourMaxPeople').val()) : null,
                    includes: includesList,
                    notincludes: notIncludesList,
                    languages: languagesList,
                    photos: photosList,
                    // Notes fields
                    internal_notes: $('#tourInternalNotes').val().trim() || null,
                    client_booking_notes: $('#tourClientBookingNotes').val().trim() || null,
                    provider_notes: $('#tourProviderNotes').val().trim() || null,
                    team_notes: $('#tourTeamNotes').val().trim() || null
                };

                // Add optional availability fields (NEW FORMAT: array of day schedules)
                if (Object.keys(daySchedules).length > 0) {
                    const availability = [];
                    const timeRegex = /^([0-1][0-9]|2[0-3]):[0-5][0-9]$/;

                    // Collect and validate each day schedule
                    for (const dayCode in daySchedules) {
                        const scheduleRow = $(daySchedules[dayCode].element);
                        const startTime = scheduleRow.find('.day-start-time').val();
                        const endTime = scheduleRow.find('.day-end-time').val();
                        const dayName = daySchedules[dayCode].dayName;

                        // Validate both times are provided
                        if (!startTime || !endTime) {
                            showModalError(`Debe especificar hora de inicio y fin para ${dayName}`);
                            return;
                        }

                        // Validate time format
                        if (!timeRegex.test(startTime)) {
                            showModalError(`Formato de hora de inicio inválido para ${dayName}. Use HH:MM (00:00 a 23:59)`);
                            return;
                        }
                        if (!timeRegex.test(endTime)) {
                            showModalError(`Formato de hora de fin inválido para ${dayName}. Use HH:MM (00:00 a 23:59)`);
                            return;
                        }

                        // Validate endTime > startTime
                        if (startTime >= endTime) {
                            showModalError(`La hora de fin debe ser posterior a la hora de inicio para ${dayName}`);
                            return;
                        }

                        // Add to availability array
                        availability.push({
                            day: parseInt(dayCode),
                            startTime: startTime,
                            endTime: endTime
                        });
                    }

                    // Add availability array to data (sorted by day code happens on backend)
                    tourData.availability = availability;
                }

                // Validate required fields
                if (!tourData.destinationPOI || !tourData.time) {
                    showModalError('Por favor completa todos los campos requeridos');
                    return;
                }

                if (tourData.time <= 0) {
                    showModalError('La duración debe ser mayor a 0 minutos');
                    return;
                }

                const url = isEdit ? `${apiEndpoint}/${tourId}` : apiEndpoint;
                const method = isEdit ? 'PUT' : 'POST';

                // Check if there are images to optimize
                const hasImagesToOptimize = photosList.some(p => p.dataUrl && p.dataUrl.startsWith('data:'));
                const totalImages = photosList.filter(p => p.dataUrl && p.dataUrl.startsWith('data:')).length;
                
                // Show loading state
                const $saveBtn = $('#saveTourBtn');
                const originalText = $('#saveButtonText').text();
                $saveBtn.prop('disabled', true);
                
                const initialButtonText = hasImagesToOptimize ? 
                    `<i class="spinner-border spinner-border-sm me-1"></i>Optimizando ${totalImages} imagen${totalImages > 1 ? 'es' : ''}...` : 
                    '<i class="spinner-border spinner-border-sm me-1"></i>Guardando...';
                
                $('#saveButtonText').html(initialButtonText);
                
                // Show optimization progress if needed
                if (hasImagesToOptimize) {
                    const progressHtml = `
                        <div id="tourOptimizationProgress" class="alert alert-info mb-3" role="alert">
                            <div class="d-flex align-items-center">
                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">Optimizando...</span>
                                </div>
                                <div>
                                    <strong>Optimización de imágenes en progreso</strong><br>
                                    <small>Las imágenes están siendo convertidas a formatos AVIF, WebP y JPEG para mejor rendimiento.</small>
                                </div>
                            </div>
                        </div>
                    `;
                    
                    // Add progress indicator if not exists
                    if (!$('#tourOptimizationProgress').length) {
                        $('#tourModalAlerts').prepend(progressHtml);
                    }
                }

                // Function to restore button state
                function restoreButtonState() {
                    $saveBtn.prop('disabled', false);
                    $('#saveButtonText').html(`<i class="ti ti-check me-1"></i>${originalText}`);
                }

                $.ajax({
                    url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(tourData),
                    success: async function(response) {

                        if (response.success) {

                            // Save base pricing for both new and edited tours
                            const savedTourId = isEdit ? tourId : response.data?.tour?.id;
                            
                            if (savedTourId && $('#basePricingSection').is(':visible')) {
                                try {

                                    await saveBasePricing(savedTourId, !isEdit);

                                } catch (error) {
                                    console.error('❌ Error saving base pricing:', error);
                                    restoreButtonState();
                                    showModalError('Tour guardado, pero error al actualizar precios base: ' + error.message);
                                    return;
                                }
                            } else {
                                if (!savedTourId) {
                                    console.warn('⚠️  No savedTourId found, skipping pricing');
                                }
                                if (!$('#basePricingSection').is(':visible')) {

                                }
                            }
                            
                            // Handle image optimization completion feedback
                            if (hasImagesToOptimize) {
                                $('#saveButtonText').html('<i class="spinner-border spinner-border-sm me-1"></i>Finalizando optimización...');
                                
                                // Update progress indicator
                                $('#tourOptimizationProgress').removeClass('alert-info').addClass('alert-success');
                                $('#tourOptimizationProgress').html(`
                                    <div class="d-flex align-items-center">
                                        <i class="ti ti-check-circle me-2" style="font-size: 1.2rem;"></i>
                                        <div>
                                            <strong>Optimización completada</strong><br>
                                            <small>${totalImages} imagen${totalImages > 1 ? 'es optimizadas' : ' optimizada'} exitosamente.</small>
                                        </div>
                                    </div>
                                `);
                                
                                // Wait a bit for image processing to complete
                                await new Promise(resolve => setTimeout(resolve, 2000));
                                
                                // Remove progress indicator
                                $('#tourOptimizationProgress').fadeOut(300, function() { 
                                    $(this).remove(); 
                                });
                            }
                            
                            $('#tourModal').modal('hide');
                            
                            // Function to show loading indicator
                            function showLoadingIndicator(message) {
                                const container = document.getElementById('tours-content');
                                if (container) {
                                    container.querySelectorAll('.alert').forEach(el => el.remove());
                                    const alertHtml = `
                                        <div class="alert alert-info alert-dismissible fade show loading-alert" role="alert">
                                            <i class="ti ti-loader-2 spinner-border spinner-border-sm me-2"></i>
                                            ${message}
                                        </div>
