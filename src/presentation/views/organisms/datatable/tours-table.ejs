// Function to save walking tour
async function saveWalkingTour() {
    // Check if jQuery is available
    if (typeof $ === 'undefined') {
        console.error('jQuery not loaded');
        return;
    }
    
    // Disable save button to prevent double submission
    $('#saveWalkingTourBtn').prop('disabled', true);
    
    try {
        // Get form data using vanilla JS where possible
        const walkingDestElement = document.getElementById('walkingDestinationPOI');
        const destinationPOI = walkingDestElement && walkingDestElement.tomselect ? 
                              walkingDestElement.tomselect.getValue() : '';
        
        // Helper function to safely get value
        const getFieldValue = (id) => {
            const element = document.getElementById(id);
            return element ? element.value : '';
        };
        
        const formData = {
            destinationPOI: destinationPOI,
            description: getFieldValue('walkingTourDescription'),
            time: parseFloat(getFieldValue('walkingDuration') || '0') * 60, // Convert hours to minutes
            anticipation: parseInt(getFieldValue('walkingAdvanceTime') || '1440'),
            advance_booking_time: parseInt(getFieldValue('walkingAdvanceTime') || '1440'), // Alternative field name
            walkingPriceSmall: parseFloat(getFieldValue('walkingPriceSmall') || '0'),
            walkingPriceMedium: parseFloat(getFieldValue('walkingPriceMedium') || '0'),
            walkingPriceLarge: parseFloat(getFieldValue('walkingPriceLarge') || '0'),
            walkingPriceCurrency: 'MXN',
            walkingRangeSmall: '1-5 pax',
            walkingRangeMedium: '6-10 pax',
            walkingRangeLarge: '11-15 pax',
            includes: getFieldValue('walkingIncludes') ? getFieldValue('walkingIncludes').split('\n').filter(item => item.trim()) : [],
            notincludes: getFieldValue('walkingNotIncludes') ? getFieldValue('walkingNotIncludes').split('\n').filter(item => item.trim()) : [],
            languages: getFieldValue('walkingLanguages') ? getFieldValue('walkingLanguages').split('\n').filter(item => item.trim()) : [],
            isWalkingTour: true,
            active: true,
            exists: true
        };
        
        // Validate required fields
        if (!destinationPOI) {
            showWalkingTourAlert('Por favor seleccione un destino para el tour.', 'danger');
            $('#saveWalkingTourBtn').prop('disabled', false);
            return;
        }
        
        if (!formData.walkingPriceSmall || !formData.walkingPriceMedium || !formData.walkingPriceLarge) {
            showWalkingTourAlert('Por favor complete todos los precios por grupo.', 'danger');
            $('#saveWalkingTourBtn').prop('disabled', false);
            return;
        }
        
        // Determine if this is create or edit operation
        const tourId = getFieldValue('walkingTourId');
        const isEdit = tourId && tourId.trim() !== '';
        
        // Get access token
        const token = await getAccessToken();
        if (!token) {
            showWalkingTourAlert('Error de autenticación. Por favor vuelva a iniciar sesión.', 'danger');
            $('#saveWalkingTourBtn').prop('disabled', false);
            return;
        }
        
        // Prepare API call
        const apiUrl = isEdit ? `${globalApiEndpoint}/${tourId}` : globalApiEndpoint;
        const method = isEdit ? 'PUT' : 'POST';
        
        
        // Send to API
        const response = await fetch(apiUrl, {
            method: method,
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(formData)
        });
        
        const result = await response.json();
        
        if (response.ok && result.success) {
            const successMsg = isEdit ? 'Tour a pie actualizado exitosamente.' : 'Tour a pie creado exitosamente.';
            showWalkingTourAlert(successMsg, 'success');
            
            // Close modal after short delay
            setTimeout(() => {
                $('#walkingTourModal').modal('hide');
                // Refresh the table if it exists
                if (typeof table !== 'undefined' && table.ajax) {
                    table.ajax.reload(null, false);
                }
                // Refresh walking tours section if it exists
                if (typeof loadWalkingTours === 'function') {
                    loadWalkingTours();
                }
            }, 1500);
        } else {
            const defaultErrorMsg = isEdit ? 'Error al actualizar el tour a pie' : 'Error al crear el tour a pie';
            const errorMsg = result.error || result.message || defaultErrorMsg;
            showWalkingTourAlert(errorMsg, 'danger');
            $('#saveWalkingTourBtn').prop('disabled', false);
        }
        
    } catch (error) {
        console.error('Error saving walking tour:', error);
        showWalkingTourAlert('Error al conectar con el servidor.', 'danger');
        $('#saveWalkingTourBtn').prop('disabled', false);
    }
}

// Make saveWalkingTour globally accessible
window.saveWalkingTour = saveWalkingTour;

// Function to show walking tour modal alerts
function showWalkingTourAlert(message, type) {
    const alertsContainer = document.getElementById('walkingTourModalAlerts');
    if (!alertsContainer) return;
    
    // Remove existing alerts
    alertsContainer.querySelectorAll('.alert').forEach(el => el.remove());
    
    // Create new alert
    const alert = document.createElement('div');
    alert.className = `alert alert-${type} alert-dismissible fade show`;
    alert.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    `;
    alertsContainer.appendChild(alert);
    
    // Auto-hide success alerts
    if (type === 'success') {
        setTimeout(() => {
            alert.remove();
        }, 3000);
    }
}

