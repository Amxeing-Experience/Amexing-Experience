/* Processing indicator: DataTables positions it absolutely inside the table by
   default, so on taller result sets (Todos/Agencias) it lands off-screen and
   only shows for short ones (Clientes). Pin it fixed-centered so the "Procesando..."
   loader is consistently visible — keep the default DataTables look, only reposition. */
#<%= dtTableId %>_wrapper .dataTables_processing {
    position: fixed;
    top: 50%;
    left: 50%;
    /* Cancel DataTables' default negative margins (margin-left/-top) which would
       stack with the transform and push the loader up-left ("chueco"). */
    margin: 0;
    transform: translate(-50%, -50%);
    z-index: 1060;
}

</style>
