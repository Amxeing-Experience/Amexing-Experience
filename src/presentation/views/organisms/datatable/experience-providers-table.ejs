<%
/**
 * Experience Providers DataTable Organism
 * DataTable component for experience provider management with simplified structure
 *
 * Atomic Design Level: Organism
 * Category: Dashboard Data Tables
 *
 * @param {string} tableId - Unique table identifier
 * @param {string} apiEndpoint - API endpoint for data loading
 * @param {string} userRole - Current user role
 * @param {boolean} showActions - Whether to show action buttons
 */

const dtTableId = typeof tableId !== 'undefined' ? tableId : 'experience-providers-table';
const dtApiEndpoint = typeof apiEndpoint !== 'undefined' ? apiEndpoint : '/api/experiences';
const dtShowActions = typeof showActions !== 'undefined' ? showActions : true;
const dtUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';

const canEdit = ['superadmin', 'admin'].includes(dtUserRole);
const canDelete = ['superadmin', 'admin'].includes(dtUserRole);
const canCreate = ['superadmin', 'admin'].includes(dtUserRole);
%>

<!-- El botón "Nuevo Proveedor" vive en la fila de pills del contenedor (experiences.ejs) -->

<!-- Bandeja master-detail: lista de proveedores (izquierda) + detalle inline (derecha) -->
<div class="row g-3 provider-inbox">
    <!-- Columna lista (master) -->
    <div class="col-lg-5 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body" id="providers-content">
                <table id="<%= dtTableId %>" class="table table-hover provider-inbox-table mb-0" style="width:100%">
                    <thead class="visually-hidden">
                        <tr>
                            <th>Proveedor</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Columna detalle (detail) -->
    <div class="col-lg-7 col-xl-8">
        <div class="card border-0 shadow-sm h-100" id="providerDetailCard">
            <!-- Estado vacío: ningún proveedor seleccionado -->
            <div id="providerDetailEmpty" class="card-body d-flex flex-column align-items-center justify-content-center text-center text-muted" style="min-height: 420px;">
                <i class="ti ti-hand-click mb-3" style="font-size: 2.5rem; opacity: .4;"></i>
                <h6 class="mb-1">Selecciona un proveedor</h6>
                <p class="mb-0 small">Elige uno de la lista o crea uno nuevo para ver y editar sus experiencias aquí.</p>
            </div>

            <!-- Detalle del proveedor (el formulario se reubica aquí en runtime) -->
            <div id="providerDetailBody" style="display: none;">
                <div class="card-header d-flex justify-content-between align-items-center" style="background: var(--brand-gradient);">
                    <h5 class="mb-0 text-white">
                        <i class="ti ti-building-store me-2"></i><span id="modalTitle">Crear Nuevo Proveedor</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" id="closeProviderDetailBtn" title="Cerrar" aria-label="Cerrar"></button>
                </div>
                <div class="card-body" id="providerDetailScroll" style="max-height: calc(100vh - 230px); overflow-y: auto;">
                    <!-- #providerModalAlerts y #providerForm se mueven aquí al iniciar -->
                </div>
                <div class="card-footer d-flex justify-content-end gap-2" id="providerDetailFooter">
                    <!-- Los botones Guardar / Guardar y cerrar se mueven aquí al iniciar -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Add Experience Modal -->
<div class="modal fade" id="quickAddExperienceModal" tabindex="-1" aria-labelledby="quickAddExperienceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);">
                <h5 class="modal-title text-white" id="quickAddExperienceModalLabel">
                    <i class="ti ti-plus me-2"></i>Agregar Experiencia Rápida
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Provider info -->
                <div class="alert alert-info" role="alert">
                    <i class="ti ti-info-circle me-2"></i>
                    <strong>Proveedor:</strong> <span id="quickAddProviderName"></span>
                </div>

                <!-- Alert container for modal-specific errors -->
                <div id="quickAddModalAlerts"></div>

                <form id="quickAddExperienceForm">
                    <input type="hidden" id="quickAddProviderId">
                    
                    <!-- Nombre y Tipo -->
                    <div class="row mb-3">
                        <div class="col-md-7">
                            <label for="quickExperienciaName" class="form-label form-label-sm fw-medium text-success">
                                Nombre <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="quickExperienciaName" required maxlength="200" 
                                   placeholder="Ej: Tour Centro Histórico">
                        </div>
                        <div class="col-md-4">
                            <label for="quickExperienciaTipo" class="form-label form-label-sm fw-medium text-success">Tipo</label>
                            <select class="form-select" id="quickExperienciaTipo">
                                <option value="">Seleccionar</option>
                                <option value="Exclusivo">Exclusivo</option>
                                <option value="Compartido">Compartido</option>
                                <option value="Privado">Privado</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Description -->
                    <div class="mb-3">
                        <label for="quickExperienciaDescription" class="form-label form-label-sm fw-medium text-success">
                            Descripción <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="quickExperienciaDescription" rows="2" required
                                  placeholder="Descripción detallada de lo que incluye esta experiencia..."></textarea>
                    </div>

                    <!-- Todos los precios en una fila -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">
                                Precio Adulto <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="quickExperienciaPrice" required min="0" step="0.01" 
                                       placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Precio Adulto Sin Alcohol</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="quickExperienciaPriceNoAlcohol" min="0" step="0.01" 
                                       placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Precio Niño</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="quickExperienciaPriceChild" min="0" step="0.01" 
                                       placeholder="0.00">
                            </div>
                        </div>
                    </div>

                    <!-- Campos de tiempo -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Duración (hrs)</label>
                            <input type="number" class="form-control" id="quickExperienciaDuration" min="0" step="0.5" 
                                   placeholder="2.5">
                            <div class="form-text">
                                <small>Tiempo total experiencia</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Duración Trayecto (min)</label>
                            <input type="number" class="form-control" id="quickExperienciaTravelDuration" min="0" step="1" 
                                   placeholder="60">
                            <div class="form-text">
                                <small>Tiempo traslado</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm fw-medium text-success">Tiempo Anticipación (min)</label>
                            <input type="number" class="form-control" id="quickExperienciaAdvanceTime" min="0" step="1" 
                                   placeholder="1440">
                            <div class="form-text">
                                <small>Ej: 1440 = 24hrs</small>
                            </div>
                        </div>
                    </div>

                    <!-- Campos de personas -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="quickExperienciaMinPeople" class="form-label form-label-sm fw-medium text-success">Mín. Personas</label>
                            <input type="number" class="form-control" id="quickExperienciaMinPeople" min="1" step="1" 
                                   placeholder="1">
                        </div>
                        <div class="col-md-6">
                            <label for="quickExperienciaMaxPeople" class="form-label form-label-sm fw-medium text-success">Máx. Personas</label>
                            <input type="number" class="form-control" id="quickExperienciaMaxPeople" min="1" step="1"
                                   placeholder="10">
                        </div>
                    </div>

                    <!-- Mínimo para privado + Buy-out -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label form-label-sm fw-medium text-success">Mínimo para privado</label>
                            <div class="input-group">
                                <select class="form-select" id="quickExperienciaPrivateMinType" style="max-width: 150px;">
                                    <option value="">N/A</option>
                                    <option value="personas">Por personas</option>
                                    <option value="monto">Monto fijo ($)</option>
                                </select>
                                <input type="number" class="form-control" id="quickExperienciaPrivateMinValue" min="0" step="0.01"
                                       placeholder="N° personas o monto">
                            </div>
                            <div class="form-text"><small>Personas mínimas o monto fijo para hacerlo privado</small></div>
                        </div>
                        <div class="col-md-6">
                            <label for="quickExperienciaBuyout" class="form-label form-label-sm fw-medium text-success">Buy-out</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="quickExperienciaBuyout" min="0" step="0.01"
                                       placeholder="0.00">
                            </div>
                            <div class="form-text"><small>Monto para reservar la experiencia completa (buy-out)</small></div>
                        </div>
                    </div>

                    <!-- Políticas de cancelación -->
                    <div class="mb-3">
                        <label for="quickExperienciaCancellationPolicy" class="form-label form-label-sm fw-medium text-success">Políticas de cancelación</label>
                        <textarea class="form-control" id="quickExperienciaCancellationPolicy" rows="3"
                                  placeholder="Ej. Cancelación gratuita hasta 48h antes; después se cobra el 50%..."
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                    </div>

                    <!-- Incluye y No Incluye en 2 columnas -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <!-- Incluye -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    Incluye <span class="text-muted">(uno por línea)</span>
                                </label>
                                <textarea class="form-control" id="quickExperienciaIncludes" 
                                          rows="4"
                                          placeholder="Transporte ida y vuelta&#10;Guía bilingüe certificado&#10;Entrada al sitio&#10;Degustación de platillos&#10;Agua embotellada"
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-info-circle me-1"></i>Cada elemento en una línea nueva</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- No Incluye -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    No incluye <span class="text-muted">(uno por línea)</span>
                                </label>
                                <textarea class="form-control" id="quickExperienciaNotIncludes" 
                                          rows="4"
                                          placeholder="Propinas&#10;Comidas adicionales&#10;Transporte desde aeropuerto&#10;Gastos personales"
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-alert-circle me-1"></i>Cada exclusión en una línea nueva</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Idiomas disponibles -->
                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-medium text-success">
                            <i class="ti ti-language me-1"></i>Idiomas disponibles <span class="text-muted">(uno por línea)</span>
                        </label>
                        <textarea class="form-control" id="quickExperienciaLanguages" 
                                  rows="3"
                                  placeholder="Español&#10;Inglés&#10;Francés&#10;Alemán"
                                  style="font-size: 1rem; line-height: 1.5;"></textarea>
                        <div class="form-text">
                            <small><i class="ti ti-world me-1"></i>Escriba cada idioma en una línea nueva • Se mostrarán como lista</small>
                        </div>
                    </div>

                    <!-- Disponibilidad compacta -->
                    <div class="availability-section mb-3">
                        <!-- Availability Summary View (default) -->
                        <div class="availability-summary-quickadd">
                            <div class="form-label form-label-sm fw-medium text-success d-flex justify-content-between align-items-center mb-1">
                                <span class="d-flex align-items-center gap-2 flex-wrap">
                                    <span>Disponibilidad <span class="text-muted">(Opcional)</span></span>
                                    <span class="form-check form-switch mb-0" title='Si se activa, en el detalle muestra "Horarios" en lugar de "Horarios sugeridos" (ej. viñedos).'>
                                        <input class="form-check-input" type="checkbox" id="quickExperienciaFixedSchedule">
                                        <label class="form-check-label small fw-medium" for="quickExperienciaFixedSchedule">Horario fijo</label>
                                    </span>
                                </span>
                                <button type="button" class="btn btn-sm btn-link p-0 toggle-quickadd-availability-btn" title="Configurar horarios">
                                    <i class="ti ti-settings"></i>
                                </button>
                            </div>
                            <div class="availability-display bg-light border rounded p-2" style="min-height: 35px;">
                                <small class="text-success">
                                    <i class="ti ti-check-circle me-1"></i>
                                    <span class="availability-status-quickadd">Disponible todos los días</span>
                                </small>
                            </div>
                        </div>
                        
                        <!-- Availability Configuration View (hidden by default) -->
                        <div class="availability-content-quickadd" style="display: none;">
                            <label class="form-label form-label-sm fw-medium text-success d-flex justify-content-between align-items-center">
                                <span>Configurar Disponibilidad</span>
                                <button type="button" class="btn btn-sm btn-link p-0 toggle-quickadd-availability-btn" title="Cerrar configuración">
                                    <i class="ti ti-x"></i>
                                </button>
                            </label>
                            <div class="mb-2">
                                <div class="d-flex gap-1 flex-wrap" id="quickAddAvailableDaysContainer">
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="1" data-day-name="Lunes">Lu</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="2" data-day-name="Martes">Ma</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="3" data-day-name="Miércoles">Mi</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="4" data-day-name="Jueves">Ju</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="5" data-day-name="Viernes">Vi</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="6" data-day-name="Sábado">Sa</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm day-btn" data-day="0" data-day-name="Domingo">Do</button>
                                </div>
                            </div>
                            
                            <div id="quickAddSelectedScheduleDays" class="mb-2"></div>
                            
                            <div id="quickAddNoDaysSelected" class="text-center text-muted py-2 border rounded bg-light" style="font-size: 1rem;">
                                <i class="ti ti-calendar-off me-1"></i>
                                <small>Selecciona días para configurar horarios</small>
                            </div>
                        </div>
                    </div>

                    <!-- Fotos de la experiencia -->
                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-medium text-success">
                            Fotos <span class="text-muted">(Opcional)</span>
                        </label>
                        <div class="experience-photos-container">
                            <!-- Photo upload section -->
                            <div class="row g-2 mb-2 photos-preview-container">
                                <!-- Uploaded photos will be displayed here -->
                            </div>
                            
                            <!-- Add photo button -->
                            <div class="d-grid">
                                <button type="button" class="btn btn-outline-primary btn-sm add-photo-btn">
                                    <i class="ti ti-camera-plus me-1"></i>
                                    Agregar Foto
                                </button>
                            </div>
                            
                            <!-- Hidden file input -->
                            <input type="file" 
                                   class="d-none experience-photo-input" 
                                   accept=".jpg,.jpeg,.png,.webp" 
                                   multiple>
                        </div>
                        <div class="form-text">
                            <small><i class="ti ti-info-circle me-1"></i>Formatos: JPG, PNG, WebP</small>
                        </div>
                    </div>

                    <!-- Notas (4 campos) -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <!-- Notas internas -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    <i class="ti ti-notes me-1"></i>Notas internas <span class="text-muted">(Uso interno)</span>
                                </label>
                                <textarea class="form-control" id="quickExperienciaInternalNotes" 
                                          rows="3"
                                          placeholder="Notas para uso exclusivo interno del equipo..."
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-lock me-1"></i>Solo visible para el equipo interno</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- Notas cliente (reservar) -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    <i class="ti ti-user-check me-1"></i>Notas cliente (reservar) <span class="text-muted">(Cliente)</span>
                                </label>
                                <textarea class="form-control" id="quickExperienciaClientBookingNotes" 
                                          rows="3"
                                          placeholder="Notas que verá el cliente al reservar esta experiencia..."
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-eye me-1"></i>Visible para el cliente durante reserva</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <!-- Notas proveedor -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    <i class="ti ti-building-store me-1"></i>Notas proveedor <span class="text-muted">(Proveedor)</span>
                                </label>
                                <textarea class="form-control" id="quickExperienciaProviderNotes" 
                                          rows="3"
                                          placeholder="Notas e instrucciones para el proveedor de la experiencia..."
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-truck me-1"></i>Instrucciones para el proveedor</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- Notas colaboradores Amexing -->
                            <div class="mb-2">
                                <label class="form-label form-label-sm fw-medium text-success">
                                    <i class="ti ti-users me-1"></i>Notas colaboradores Amexing <span class="text-muted">(Equipo)</span>
                                </label>
                                <textarea class="form-control" id="quickExperienciaTeamNotes" 
                                          rows="3"
                                          placeholder="Notas para colaboradores y equipo de Amexing..."
                                          style="font-size: 1rem; line-height: 1.5;"></textarea>
                                <div class="form-text">
                                    <small><i class="ti ti-heart me-1"></i>Información para el equipo Amexing</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-success" role="alert">
                        <i class="ti ti-check-circle me-2"></i>
                        <small>Esta experiencia se agregará inmediatamente al proveedor. Puedes editarla más tarde desde "Editar Proveedor".</small>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%); color: white;" id="saveQuickExperienceBtn">
                    <i class="ti ti-check me-1"></i>Agregar Experiencia
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('../modal/experience-images-modal.ejs') %>

<!-- Provider Modal -->
<!-- Holder oculto: sus nodos (alerts, form, botones) se reubican en el panel de detalle al iniciar (ver relocateProviderForm) -->
<div id="providerModal" class="d-none">
                <!-- Alert container for detail-panel errors -->
                <div id="providerModalAlerts"></div>

                <form id="providerForm">
                    <input type="hidden" id="providerId">
                    <input type="hidden" id="type" value="Provider">
                    <!-- Hidden fields for compatibility -->
                    <input type="hidden" id="providerType" name="providerType" value="">
                    <input type="hidden" id="duration" name="duration" value="">
                    <input type="hidden" id="min_people" name="min_people" value="">
                    <input type="hidden" id="cost" name="cost" value="0">

                    <!-- Sección: Experiencias del Proveedor (lo que más se edita: va primero) -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-success border-bottom pb-2 mb-3">
                            <i class="ti ti-sparkles me-1"></i>
                            Experiencias del Proveedor
                        </h6>

                        <!-- Lista de experiencias editables inline -->
                        <div id="providerExperienciasList" class="mb-3">
                            <div id="noExperienciasMessage" class="text-center text-muted py-3 border rounded bg-light">
                                <i class="ti ti-package-off fs-4 d-block mb-2"></i>
                                <p class="mb-0">No hay experiencias agregadas</p>
                                <small class="text-muted">Use el botón de abajo para agregar la primera experiencia</small>
                            </div>
                        </div>

                        <!-- Botón para agregar nueva experiencia -->
                        <button type="button" class="btn btn-sm btn-success" id="addExperienciaBtn">
                            <i class="ti ti-plus me-1"></i>Agregar Nueva Experiencia
                        </button>
                    </div>

                    <!-- Información del proveedor (se da de alta una vez: colapsable) -->
                    <div class="border-top pt-3">
                        <button type="button" class="btn btn-link text-decoration-none p-0 fw-bold text-success d-flex align-items-center gap-2" id="toggleProviderInfoBtn">
                            <i class="ti ti-chevron-right" id="providerInfoChevron" style="transition: transform .15s ease;"></i>
                            <i class="ti ti-building-store"></i>
                            Información del proveedor
                        </button>

                        <div id="providerInfoSection" class="mt-3" style="display: none;">
                            <!-- Nombre -->
                            <div class="mb-3">
                                <label for="name" class="form-label">
                                    Nombre del Proveedor <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" id="name" name="name" required maxlength="280" placeholder="Ej: Tours y Experiencias México">
                                <div class="form-text">Nombre comercial del proveedor (máximo 200 caracteres)</div>
                            </div>

                            <!-- Descripción -->
                            <div class="mb-3">
                                <label for="description" class="form-label">
                                    Descripción <span class="text-danger">*</span>
                                </label>
                                <textarea class="form-control" id="description" name="description" rows="4" required placeholder="Descripción detallada del proveedor y sus servicios..."></textarea>
                                <div class="form-text">Descripción completa del proveedor</div>
                            </div>

                            <!-- Destino (Optional) -->
