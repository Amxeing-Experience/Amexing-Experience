                                <i class="ti ti-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `);

            $('#quickAddSelectedScheduleDays').append(dayScheduleRow);
            
            // Store in availability object
            quickAddAvailability[dayCode] = {
                day: dayCode,
                times: [{ start: startTime, end: endTime }]
