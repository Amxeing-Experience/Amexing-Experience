        // POI Loading and Management Functions
        async function loadPOIOptions() {
            try {
                console.log('🌍 Loading POI options for Destino selectbox...');
                
                const response = await fetch('/api/pois/active', {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('authToken')}`
                    }
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const responseData = await response.json();
                console.log('📍 POI API Response:', responseData);
                
                // Extract POI array from response
                const poisArray = responseData.success ? responseData.data : responseData;
                
                if (!Array.isArray(poisArray)) {
                    console.error('❌ POI API did not return an array:', poisArray);
                    return [];
                }
                
                console.log(`📍 Loaded ${poisArray.length} POIs from API`);
                
                // Deduplicate by name - show unique names only
                const uniquePOIs = poisArray.filter((poi, index, self) => 
                    index === self.findIndex(p => p.label === poi.label)
                );
                
                console.log(`✨ Deduplicated to ${uniquePOIs.length} unique POIs`);
                return uniquePOIs;
                
            } catch (error) {
                console.error('❌ Error loading POI options:', error);
                showModalError('Error al cargar destinos. Inténtelo de nuevo.');
                return [];
            }
        }
        
        // Destino del proveedor en edición ({ id, name } o null). Fuente de verdad para
        // mantener el seleccionado a prueba de timing (las opciones cargan async y el
        // catálogo activo puede no incluir el POI guardado).
        let pendingProviderDestino = null;

        // Aplica el destino pendiente: reinyecta su opción si no existe y lo selecciona.
        function applyProviderDestino() {
            const $sel = $('#providerDestino');
            if ($sel.length === 0) return;
            if (!pendingProviderDestino || !pendingProviderDestino.id) return;
            const { id, name } = pendingProviderDestino;
            if ($sel.find(`option[value="${id}"]`).length === 0) {
                $sel.append($('<option>').val(id).text(name || id));
            }
            $sel.val(id);
        }

        // Populate Destino selectbox with POI options
        function populateDestinoSelect(selectId, pois) {
            const select = document.getElementById(selectId);
            if (!select) {
                console.warn('⚠️ Destino select element not found:', selectId);
                return;
            }

            // Preserva la selección actual (las opciones se pueden repoblar async después).
            const prevValue = select.value;

            // Clear existing options except the first one
            select.innerHTML = '<option value="">Seleccione un destino...</option>';

            // Add POI options
            pois.forEach(poi => {
                const option = document.createElement('option');
                option.value = poi.value;
                option.textContent = poi.label;
                option.setAttribute('data-service-type', poi.serviceType?.name || '');
                select.appendChild(option);
            });

            if (prevValue) {
                select.value = prevValue;
            }

            // Reaplica el destino del proveedor en edición (reinyecta su opción si el POI
            // no vino en la lista) → seleccionado a prueba de timing.
            if (selectId === 'providerDestino') {
                applyProviderDestino();
            }

            console.log(`✅ Populated ${selectId} with ${pois.length} POI options`);
        }
        
        // Load and populate POI options for provider modal
        async function loadProviderDestinoOptions() {
            const pois = await loadPOIOptions();
            if (pois.length > 0) {
                populateDestinoSelect('providerDestino', pois);
            }
        }

        function openProviderModal(isEdit = false) {
            // Clear any previous modal alerts
            const alertsContainer = document.getElementById('providerModalAlerts');
            if (alertsContainer) {
                alertsContainer.querySelectorAll('.alert').forEach(el => el.remove());
            }

            // Bandeja: mostrar el panel de detalle inline (sin overlay modal).
            // El estado vacío usa .d-flex (display:flex !important). jQuery .hide()
            // pondría un inline display:none que pierde contra el !important, y solo
            // añadir .d-none tampoco basta (en Bootstrap .d-flex va después en el CSS
            // y gana al tener igual especificidad). Por eso alternamos ambas clases.
            $('#providerDetailEmpty').removeClass('d-flex').addClass('d-none');
            $('#providerDetailBody').show();
            $('#providerDetailScroll').scrollTop(0);
            // En pantallas donde el panel queda apilado debajo de la lista,
            // hace scroll para que el detalle quede a la vista al seleccionar.
            const detailCard = document.getElementById('providerDetailCard');
            if (detailCard && window.innerWidth < 992) {
                detailCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            $('#providerForm')[0].reset();
            // Limpia el destino pendiente al abrir; el editar lo vuelve a setear tras el GET.
            pendingProviderDestino = null;
            $('#providerId').val('');
            $('#type').val('Provider');
            $('#providerType').val(''); // No default value - optional field
            $('#duration').val(''); // No default value - optional field
            $('#min_people').val(''); // No default value - optional field
            
            // CRITICAL: Enhanced form reset - explicitly clear destino for create mode
            if (!isEdit) {
                $('#providerDestino').val(''); // Ensure no residual destino from previous sessions
                console.log('🧹 Cleared destino field for create mode');
            }
            $('#modalTitle').text(isEdit ? 'Editar Proveedor' : 'Crear Nuevo Proveedor');
            // Crear: info del proveedor abierta (hay que llenarla). Editar: colapsada.
            setProviderInfo(!isEdit);
            initializeDaySelection();
            
            // Reset experiencias
            providerExperiencias = [];
            $('.experiencia-editable').remove();
            updateNoExperienciasMessage();
            
            // Load POI options for Destino selectbox
            loadProviderDestinoOptions();
        }

        function loadProviderData(providerId) {
            openProviderModal(true);

            // Carga las experiencias EN PARALELO al fetch del proveedor y muestra el
            // spinner de inmediato, para que el usuario vea feedback al instante (en
            // vez de la lista vacía mientras llega el primer request). Antes esto se
            // disparaba solo tras completar el GET del proveedor (doble espera).
            if (providerId) loadProviderExperiencias(providerId);

            $.ajax({
                url: `${apiEndpoint}/${providerId}`,
                type: 'GET',
                success: function(response) {
                    if (response.success && response.data) {
                        const provider = response.data;
                        $('#providerId').val(provider.id);
                        $('#name').val(provider.name);
                        $('#description').val(provider.description || '');
                        
                        // Populate destinationPOI field — guarda como pendiente y aplica; se
                        // re-aplica tras cada repoblado (a prueba de timing / POIs no listados).
                        if (provider.destinationPOI && provider.destinationPOI.id) {
                            pendingProviderDestino = {
                                id: provider.destinationPOI.id,
                                name: provider.destinationPOI.name || provider.destinationPOI.id,
                            };
                            console.log('📍 Loaded destinationPOI:', pendingProviderDestino.name);
                        } else {
                            pendingProviderDestino = null;
                            $('#providerDestino').val('');
                        }
                        applyProviderDestino();
                        
                        // Don't set providerType, duration, min_people, or cost for providers
                        // (Las experiencias ya se cargan en paralelo desde loadProviderData)

                        // Provider availability has been moved to individual experiencias
                        updateNoDaysMessage();
                    } else {
                        showErrorAlert('Formato de respuesta inválido');
                    }
                },
                error: function(xhr) {
                    showModalError(xhr.responseJSON?.error || 'Error al cargar el proveedor');
                }
            });
        }

        function saveProvider(keepOpen = false) {
            const form = $('#providerForm');
            if (!form[0].checkValidity()) {
                // Nombre/Descripción (requeridos) viven en la sección colapsable:
                // ábrela para que el navegador pueda enfocar y mostrar el error.
                setProviderInfo(true);
                form[0].reportValidity();
                return;
            }

            const providerId = $('#providerId').val();
            const isEdit = !!providerId;
            // "Guardar" (keepOpen) vs "Guardar y cerrar": the progress spinner is
            // shown on whichever button was clicked; both are locked during save.
            const $saveBtn = $('#saveProviderBtn');
            const saveLabel = '<i class="ti ti-device-floppy me-1"></i>Guardar';
            const restoreButtons = () => {
                $('#saveProviderBtn').prop('disabled', false).html(saveLabel);
            };

            const providerData = {
                name: $('#name').val().trim(),
                description: $('#description').val().trim(),
                type: 'Provider',
                cost: 0  // Always 0 for providers, costs are in experiencias
            };
            
            // Add destinationPOI if selected
            // Siempre enviar destinationPOI para poder SETEAR o LIMPIAR el destino
            // (vacío => el backend hace unset en update; en create lo ignora).
            const destinationPOIId = $('#providerDestino').val();
            providerData.destinationPOI = (destinationPOIId && destinationPOIId.trim() !== '') ? destinationPOIId.trim() : '';
            console.log('📍 destinationPOI in provider data:', providerData.destinationPOI || '(none)');

            // Don't include providerType anymore - it's now part of individual experiencias

            // Don't include duration or min_people for providers anymore

            // Provider availability has been moved to individual experiencias

            const url = isEdit ? `${apiEndpoint}/${providerId}` : apiEndpoint;
            const method = isEdit ? 'PUT' : 'POST';
            
            // Collect all experiencia data from the inline cards
            const experienciasToSave = collectExperienciasFromCards();

            // Check if there are images to optimize
            const experienciasToCheck = collectExperienciasFromCards();
            let hasImagesToOptimize = false;
            experienciasToCheck.forEach(exp => {
                if (exp.photos && exp.photos.some(p => p.dataUrl && p.dataUrl.startsWith('data:'))) {
                    hasImagesToOptimize = true;
                }
            });
            
            const initialButtonText = hasImagesToOptimize ? 
                '<i class="spinner-border spinner-border-sm me-1"></i>Preparando optimización...' : 
                '<i class="spinner-border spinner-border-sm me-1"></i>Guardando...';
            
            $('#saveProviderBtn').prop('disabled', true);
            $saveBtn.html(initialButtonText);

            $.ajax({
                url,
                type: method,
                contentType: 'application/json',
                data: JSON.stringify(providerData),
                success: async function(response) {
                    if (response.success) {
                        const actualProviderId = response.data?.id || response.data?.objectId || providerId;
                        
                        // Save experiencias for the provider
                        if (actualProviderId && experienciasToSave.length > 0) {
                            try {
                                // Count total images that need optimization
                                let totalImages = 0;
                                let hasNewImages = false;
                                experienciasToSave.forEach(exp => {
                                    if (exp.photos && exp.photos.length > 0) {
                                        exp.photos.forEach(photo => {
                                            if (photo.dataUrl && photo.dataUrl.startsWith('data:')) {
                                                totalImages++;
                                                hasNewImages = true;
                                            }
                                        });
                                    }
                                });
                                
                                // Update button text for experiencias processing
                                if (hasNewImages) {
                                    $saveBtn.html(`<i class="spinner-border spinner-border-sm me-1"></i>Optimizando ${totalImages} imagen${totalImages > 1 ? 'es' : ''}...`);
                                } else {
                                    $saveBtn.html('<i class="spinner-border spinner-border-sm me-1"></i>Guardando experiencias...');
                                }
                                
                                // Show a progress alert if we have images to optimize
                                if (hasNewImages) {
                                    // Show a progress alert in the modal
                                    const progressHtml = `
                                        <div id="optimizationProgress" class="alert alert-info mb-3" role="alert">
                                            <div class="d-flex align-items-center">
                                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                                    <span class="visually-hidden">Optimizando...</span>
                                                </div>
                                                <div>
                                                    <strong>Optimización de imágenes en progreso</strong><br>
                                                    <small>Las imágenes están siendo convertidas a formatos AVIF, WebP y JPEG para mejor rendimiento.</small>
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                    
                                    // Add progress indicator if not exists
                                    if (!$('#optimizationProgress').length) {
                                        $('#modalAlerts').prepend(progressHtml);
                                    }
                                }
                                
                                // First, get existing experiencias if editing
                                let existingExperiencias = [];
                                if (isEdit) {
                                    const expResponse = await $.ajax({
                                        url: `/api/providers/${actualProviderId}/experiencias`,
                                        type: 'GET'
                                    });
                                    if (expResponse.success && expResponse.data) {
                                        existingExperiencias = expResponse.data;
                                    }
                                }
                                
                                // Delete removed experiencias
                                const currentIds = experienciasToSave.filter(e => e.id).map(e => e.id);
                                for (const existing of existingExperiencias) {
                                    if (!currentIds.includes(existing.id)) {
                                        await $.ajax({
                                            url: `/api/providers/${actualProviderId}/experiencias/${existing.id}`,
                                            type: 'DELETE'
                                        });
                                    }
                                }
                                
                                // Update button to show progress
                                let processedCount = 0;
                                const totalOperations = experienciasToSave.length;
                                
                                // Update or create experiencias with progress tracking
                                for (let i = 0; i < experienciasToSave.length; i++) {
                                    const exp = experienciasToSave[i];
                                    exp.displayOrder = i;
                                    
                                    // Update progress text
                                    const hasImages = exp.photos && exp.photos.some(p => p.dataUrl && p.dataUrl.startsWith('data:'));
                                    if (hasImages) {
                                        $saveBtn.html(`<i class="spinner-border spinner-border-sm me-1"></i>Procesando experiencia ${i + 1}/${totalOperations}...`);
                                    }
                                    
                                    if (exp.id) {
                                        // Update existing
                                        await $.ajax({
                                            url: `/api/providers/${actualProviderId}/experiencias/${exp.id}`,
                                            type: 'PUT',
                                            contentType: 'application/json',
                                            data: JSON.stringify(exp)
                                        });
                                    } else {
                                        // Create new
                                        await $.ajax({
                                            url: `/api/providers/${actualProviderId}/experiencias`,
                                            type: 'POST',
                                            contentType: 'application/json',
                                            data: JSON.stringify(exp)
                                        });
                                    }
                                    
                                    processedCount++;
                                }
                                
                                // Final status update
                                $saveBtn.html('<i class="spinner-border spinner-border-sm me-1"></i>Finalizando...');
                                
                                // Add a delay to ensure backend processing completes
                                if (hasNewImages) {
                                    // Update progress indicator
                                    $('#optimizationProgress').removeClass('alert-info').addClass('alert-success');
                                    $('#optimizationProgress').html(`
                                        <div class="d-flex align-items-center">
                                            <i class="ti ti-check-circle me-2" style="font-size: 1.2rem;"></i>
                                            <div>
                                                <strong>Optimización completada</strong><br>
                                                <small>${totalImages} imagen${totalImages > 1 ? 'es optimizadas' : ' optimizada'} exitosamente.</small>
                                            </div>
                                        </div>
                                    `);
                                    
                                    // Wait a bit longer for image processing to complete
                                    await new Promise(resolve => setTimeout(resolve, 2000));
                                    
                                    // Remove progress indicator
                                    $('#optimizationProgress').fadeOut(300, function() { 
                                        $(this).remove(); 
                                    });
                                } else {
                                    // Small delay for regular saves
                                    await new Promise(resolve => setTimeout(resolve, 500));
                                }
                            } catch (error) {
                                console.error('Error saving experiencias:', error);
                                showErrorAlert('Proveedor guardado pero hubo un error al guardar las experiencias');
                            }
                        }
                        
                        // Refresh the list in the background (keep paging/scroll)
                        dataTable.ajax.reload(null, false);

                        if (keepOpen) {
                            // Save WITHOUT closing: switch to edit mode and reload the
                            // cards so newly-created subexperiencias pick up their server
                            // IDs (otherwise the next save would duplicate them). The
                            // user's expanded cards and scroll position are preserved.
                            const expandedIdx = [];
                            $('#providerExperienciasList .experiencia-editable').each(function(i) {
                                if (this.classList.contains('experiencia-expanded')) expandedIdx.push(i);
                            });
                            const $scroll = $('#providerDetailScroll');
                            const scrollTop = $scroll.scrollTop();

                            $('#providerId').val(actualProviderId);
                            $('#modalTitle').text('Editar Proveedor');

                            if (actualProviderId) {
                                loadProviderExperiencias(actualProviderId, function() {
                                    const cards = document.querySelectorAll('#providerExperienciasList .experiencia-editable');
                                    expandedIdx.forEach(i => { if (cards[i]) expandExperienciaCard(cards[i]); });
                                    $scroll.scrollTop(scrollTop);
                                    // Restaurar el botón SOLO cuando el reload realmente terminó,
                                    // para que no parezca que acabó mientras siguen cargando.
                                    showSuccessAlert('Cambios guardados');
                                    restoreButtons();
                                });
                            } else {
                                showSuccessAlert('Cambios guardados');
                                restoreButtons();
                            }
                        } else {
                            closeProviderDetail();
                            showSuccessAlert(isEdit ? 'Proveedor actualizado exitosamente' : 'Proveedor creado exitosamente');
                            restoreButtons();
                        }
                    } else {
                        showModalError('Error al guardar el proveedor');
                        restoreButtons();
                    }
                },
                error: function(xhr) {
                    const errorMessage = xhr.responseJSON?.error || 'Error al guardar el proveedor';
                    showModalError(errorMessage);
                    restoreButtons();
                }
            });
        }

        function manageImages(providerId, providerName) {
            window.openExperienceImagesModal(providerId, providerName);
        }

        function toggleProviderStatus(providerId, currentStatus, providerName) {
            const newStatus = !currentStatus;
            const action = newStatus ? 'activar' : 'desactivar';
            const actionTitle = newStatus ? 'Activar' : 'Desactivar';
            const btnClass = newStatus ? 'btn-success' : 'btn-warning';

            // If deactivating, check for dependencies first
            if (!newStatus) {
                $.ajax({
                    url: `${apiEndpoint}/${providerId}/dependencies`,
                    type: 'GET',
                    success: function(depResponse) {
                        if (depResponse.success && !depResponse.canModify) {
                            // Has dependencies, show error modal
                            showDependenciesModal(providerName, depResponse.dependencies, 'desactivar');
                        } else {
                            // No dependencies, show confirmation modal
                            showToggleConfirmationModal(providerId, newStatus, action, actionTitle, btnClass, providerName);
                        }
                    },
                    error: function(xhr) {
                        showErrorAlert('Error al verificar dependencias');
                    }
                });
            } else {
                // Activating, no validation needed
                showToggleConfirmationModal(providerId, newStatus, action, actionTitle, btnClass, providerName);
            }
        }

        function showToggleConfirmationModal(providerId, newStatus, action, actionTitle, btnClass, providerName) {
            const modalHtml = `
                <div class="modal fade" id="confirmToggleProviderModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">${actionTitle} Proveedor</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p>¿Estás seguro de que deseas ${action} el proveedor <strong>"${providerName}"</strong>?</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn ${btnClass}" id="confirmToggleProviderBtn">${actionTitle}</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            $('#confirmToggleProviderModal').remove();
            $('body').append(modalHtml);
            const modal = new bootstrap.Modal(document.getElementById('confirmToggleProviderModal'));
            modal.show();

            $('#confirmToggleProviderBtn').on('click', function() {
                $.ajax({
                    url: `${apiEndpoint}/${providerId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ active: newStatus }),
                    success: function(response) {
                        if (response.success) {
                            modal.hide();
                            dataTable.ajax.reload(null, false);
                            showSuccessAlert(`Proveedor ${newStatus ? 'activado' : 'desactivado'} exitosamente`);
                        }
                    },
                    error: function(xhr) {
                        modal.hide();
                        const error = xhr.responseJSON?.error || 'Error al cambiar el estado del proveedor';
                        showErrorAlert(error);
                    }
                });
            });
        }

        function deleteProvider(providerId, providerName) {
            // Check for dependencies first
            $.ajax({
                url: `${apiEndpoint}/${providerId}/dependencies`,
                type: 'GET',
                success: function(depResponse) {
                    if (depResponse.success && !depResponse.canModify) {
                        // Has dependencies, show error modal
                        showDependenciesModal(providerName, depResponse.dependencies, 'eliminar');
                    } else {
                        // No dependencies, show confirmation modal
                        showDeleteConfirmationModal(providerId, providerName);
                    }
                },
                error: function(xhr) {
                    showErrorAlert('Error al verificar dependencias');
                }
            });
        }

        function showDeleteConfirmationModal(providerId, providerName) {
            const modalHtml = `
                <div class="modal fade" id="confirmDeleteProviderModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title text-white">Eliminar Proveedor</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p>¿Estás seguro de que deseas eliminar el proveedor <strong>"${providerName}"</strong>?</p>
                                <p class="text-muted mb-0">Esta acción no se puede deshacer.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-danger" id="confirmDeleteProviderBtn">Eliminar</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            $('#confirmDeleteProviderModal').remove();
            $('body').append(modalHtml);
            const modal = new bootstrap.Modal(document.getElementById('confirmDeleteProviderModal'));
            modal.show();

            $('#confirmDeleteProviderBtn').on('click', function() {
                $.ajax({
                    url: `${apiEndpoint}/${providerId}`,
                    type: 'DELETE',
                    success: function(response) {
                        if (response.success) {
                            modal.hide();
                            dataTable.ajax.reload(null, false);
                            showSuccessAlert('Proveedor eliminado exitosamente');
                        }
                    },
                    error: function(xhr) {
                        modal.hide();
                        const error = xhr.responseJSON?.error || 'Error al eliminar el proveedor';
                        showErrorAlert(error);
                    }
                });
            });
        }

        function showDependenciesModal(itemName, dependencies, actionText) {
            const dependenciesList = dependencies.map(dep =>
                `<li class="list-group-item d-flex justify-content-between align-items-center">
                    ${dep.name}
                    <span class="badge bg-primary">${dep.type === 'Experience' ? 'Experiencia' : 'Proveedor'}</span>
                </li>`
            ).join('');

            const modalHtml = `
                <div class="modal fade" id="dependenciesModal" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-warning">
                                <h5 class="modal-title">
                                    <i class="ti ti-alert-triangle me-2"></i>No se puede ${actionText}
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-warning" role="alert">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    No se puede ${actionText} <strong>"${itemName}"</strong>
                                </div>
                                <p>Este proveedor está incluido en <strong>${dependencies.length}</strong> experiencia(s):</p>
                                <ul class="list-group mb-3">
                                    ${dependenciesList}
                                </ul>
                                <p class="text-muted mb-0">
                                    <i class="ti ti-info-circle me-1"></i>
                                    Para continuar, primero actualiza estas experiencias y remueve la dependencia.
                                </p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="ti ti-x me-1"></i>Entendido
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            $('#dependenciesModal').remove();
            $('body').append(modalHtml);
            const modal = new bootstrap.Modal(document.getElementById('dependenciesModal'));
            modal.show();
        }

        function showModalError(message) {
            const alertHtml = `
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="ti ti-alert-circle me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;

            const container = document.getElementById('providerModalAlerts');
            if (container) {
                container.querySelectorAll('.alert').forEach(el => el.remove());
                container.insertAdjacentHTML('afterbegin', alertHtml);

                setTimeout(() => {
                    container.querySelectorAll('.alert').forEach(el => {
                        el.classList.remove('show');
                        setTimeout(() => el.remove(), 150);
                    });
                }, 8000);
            }
        }

        function showSuccessAlert(message) {
            const alertHtml = `
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="ti ti-check-circle me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;

            const container = document.getElementById('providers-content');
            if (container) {
                container.querySelectorAll('.alert').forEach(el => el.remove());
                container.insertAdjacentHTML('afterbegin', alertHtml);
                setTimeout(() => {
                    container.querySelectorAll('.alert').forEach(el => {
                        el.classList.remove('show');
                        setTimeout(() => el.remove(), 150);
                    });
                }, 5000);
            }
        }

        function showErrorAlert(message) {
            const alertHtml = `
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="ti ti-alert-circle me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;

            const container = document.getElementById('providers-content');
            if (container) {
                container.querySelectorAll('.alert').forEach(el => el.remove());
                container.insertAdjacentHTML('afterbegin', alertHtml);
            }
        }

        // Photo upload functionality for experiences
        function initPhotoUpload() {
            // Handle add photo button clicks
            $(document).on('click', '.add-photo-btn', function() {
                const card = $(this).closest('.experiencia-editable');
                const fileInput = card.find('.experience-photo-input');
                fileInput.click();
            });

            // Handle file selection
            $(document).on('change', '.experience-photo-input', function() {
                const card = $(this).closest('.experiencia-editable');
                const files = this.files;
                const previewContainer = card.find('.photos-preview-container');
                
                // No photo limit - removed restriction
                const currentPhotos = previewContainer.find('.photo-preview').length;

                // Process each selected file
                Array.from(files).forEach(file => {
                    // Removed file size limit - allow any size

                    // Validate file type
                    if (!file.type.match(/^image\/(jpeg|jpg|png|webp)$/)) {
                        showErrorAlert(`La imagen "${file.name}" no tiene un formato válido.`);
                        return;
                    }

                    // Create preview
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        addPhotoPreview(previewContainer, file, e.target.result);
                    };
                    reader.readAsDataURL(file);
                });

                // Clear input
                this.value = '';
            });

            // Handle photo removal
            $(document).on('click', '.remove-photo-btn', function() {
                $(this).closest('.photo-preview').remove();
            });
        }

        function addPhotoPreview(container, file, dataUrl, photoDataOrMetadata) {
            const photoId = Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            
            // Handle both old format (just metadata) and new format (full photo object)
            let optimizationMetadata = null;
            let fullPhotoData = null;
            
            if (photoDataOrMetadata) {
                // If it's an object with any of the expected photo properties, it's the full photo object
                if (typeof photoDataOrMetadata === 'object' && 
                    (photoDataOrMetadata.s3Key || 
                     photoDataOrMetadata.optimizationMetadata !== undefined ||
                     photoDataOrMetadata.optimizedVariants ||
                     photoDataOrMetadata.fileName)) {
                    fullPhotoData = photoDataOrMetadata;
                    optimizationMetadata = photoDataOrMetadata.optimizationMetadata;
                    
                } else {
                    // Otherwise it's just the metadata (for backwards compatibility)
                    optimizationMetadata = photoDataOrMetadata;
                }
            }
            
            // Check optimization metadata for format count - ALWAYS show badge
            let formatBadge = '';
            let formatInfo = '';
            let badgeClass = '';
            let iconClass = '';
            let tooltipText = '';
            
            // Check if it's a new upload (base64 image)
            if (dataUrl && dataUrl.startsWith('data:')) {
                formatInfo = 'New - Not saved';
                badgeClass = 'bg-warning';
                iconClass = 'ti-alert-circle';
                tooltipText = 'Will be optimized when saved';
            } 
            // Check optimization metadata
            else if (optimizationMetadata && (optimizationMetadata.availableFormats || optimizationMetadata.formats)) {
                const rawFormats = optimizationMetadata.availableFormats ||
                                        optimizationMetadata.formats ||
                                        [];
                // `formats` may be an array of names (['avif','webp',...]) OR an
                // object keyed by format ({ avif: {...}, webp: {...} }). Normalize
                // to an array of format names so .filter never blows up.
                const availableFormats = Array.isArray(rawFormats)
                    ? rawFormats
                    : Object.keys(rawFormats || {});
                // Count non-original formats (AVIF, WebP, JPEG)
                const optimizedFormats = availableFormats.filter(f => f !== 'original');
                const formatCount = optimizedFormats.length;
                
                if (formatCount > 0) {
                    formatInfo = `${formatCount} formats`;
                    badgeClass = 'bg-success';
                    iconClass = 'ti-photo';
                    tooltipText = `Optimized: ${optimizedFormats.join(', ')}`;
                } else {
                    // Has metadata but 0 formats (optimization may have failed or not completed)
                    formatInfo = '0 formats';
                    badgeClass = 'bg-danger';
                    iconClass = 'ti-x';
                    tooltipText = 'No optimized formats available';
                }
            } 
            // No metadata and not base64 (old image without optimization)
            else {
                // Check if it's an S3 URL (legacy upload before optimization)
                if (dataUrl && (dataUrl.includes('amazonaws.com') || dataUrl.includes('http'))) {
                    formatInfo = 'Legacy - No optimization';
                    badgeClass = 'bg-secondary';
                    iconClass = 'ti-photo-off';
                    tooltipText = 'Uploaded before optimization was implemented. Re-upload to optimize.';
                } else {
                    formatInfo = 'Unknown';
                    badgeClass = 'bg-dark';
                    iconClass = 'ti-question-mark';
                    tooltipText = 'Unknown image format';
                }
            }
            
            // Always create a badge
            formatBadge = `
                <span class="badge ${badgeClass} position-absolute" 
                      style="top: 2px; left: 2px; font-size: 9px; padding: 2px 4px;"
                      title="${tooltipText}">
                    <i class="ti ${iconClass}" style="font-size: 9px;"></i> ${formatInfo}
                </span>
            `;
            
            // Store full photo data as data attribute to preserve all fields
            const photoDataJson = fullPhotoData ? JSON.stringify(fullPhotoData) : '';
            
            
            const photoHtml = `
                <div class="col-4 photo-preview" data-photo-id="${photoId}" data-photo-full='${photoDataJson.replace(/'/g, '&#39;')}'>
                    <div class="position-relative">
                        <img src="${dataUrl}" loading="lazy"
                             class="img-fluid rounded border"
                             style="height: 80px; width: 100%; object-fit: cover;">
                        ${formatBadge}
                        <button type="button" 
                                class="btn btn-danger btn-sm position-absolute top-0 end-0 remove-photo-btn" 
                                style="padding: 2px 6px; margin: 2px;">
                            <i class="ti ti-x" style="font-size: 12px;"></i>
                        </button>
                        <div class="text-center mt-1">
                            <small class="text-muted text-truncate d-block" style="font-size: 10px;" title="${file.name}">
                                ${file.name.length > 15 ? file.name.substring(0, 15) + '...' : file.name}
                            </small>
                        </div>
                    </div>
                </div>
            `;
            container.append(photoHtml);
        }

        // Initialize photo upload functionality
        initPhotoUpload();
        
        // Conversion Modal Functions
        function openConversionModal(id, name, fromType, toType) {
            const fromTypeText = fromType === 'Provider' ? 'Proveedor' : 'Establecimiento';
            const toTypeText = toType === 'Establishment' ? 'Establecimiento' : 'Proveedor';
            
            const message = `
                <p>¿Está seguro de convertir <strong>"${name}"</strong> de ${fromTypeText} a ${toTypeText}?</p>
                <div class="alert alert-warning">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <strong>Importante:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Este cambio moverá el elemento a la sección de ${toTypeText === 'Establecimiento' ? 'Establecimientos' : 'Proveedores'}</li>
                        <li>Se mantendrán todos los datos y configuraciones existentes</li>
                        <li>Este cambio puede ser revertido posteriormente si es necesario</li>
                    </ul>
                </div>
            `;
            
            $('#convertTypeMessage').html(message);
            $('#convertTypeModal').data('id', id);
            $('#convertTypeModal').data('newType', toType);
            $('#convertTypeModal').modal('show');
        }
        
        // Handle conversion confirmation
        $('#confirmConversionBtn').on('click', function() {
            const id = $('#convertTypeModal').data('id');
            const newType = $('#convertTypeModal').data('newType');
            const $btn = $(this);
            const originalText = $btn.html();
            
            // Show loading state
            $btn.html('<span class="spinner-border spinner-border-sm me-2"></span>Convirtiendo...').prop('disabled', true);
            
            const accessToken = getAccessToken();
            $.ajax({
                url: `${apiEndpoint}/${id}`,
                type: 'PUT',
                headers: {
                    'Authorization': `Bearer ${accessToken}`,
                    'Content-Type': 'application/json'
                },
                data: JSON.stringify({ type: newType }),
                success: function(response) {
                    $('#convertTypeModal').modal('hide');
                    showSuccessAlert(`Conversión exitosa. El elemento ha sido movido a ${newType === 'Establishment' ? 'Establecimientos' : 'Proveedores'}.`);
                    dataTable.ajax.reload();
                },
                error: function(xhr) {
                    console.error('Error converting type:', xhr);
                    let errorMessage = 'Error al convertir el tipo';
                    if (xhr.responseJSON && xhr.responseJSON.error) {
                        errorMessage = xhr.responseJSON.error;
                    }
                    showErrorAlert(errorMessage);
                },
                complete: function() {
                    $btn.html(originalText).prop('disabled', false);
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWhenReady);
    } else {
        initWhenReady();
    }
})();
</script>

<style>
/* Experience Photo Upload Styles */
.experience-photos-container {
