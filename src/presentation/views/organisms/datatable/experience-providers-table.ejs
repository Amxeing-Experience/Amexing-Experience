        function saveQuickExperience() {
            const form = $('#quickAddExperienceForm');
            if (!form[0].checkValidity()) {
                form[0].reportValidity();
                return;
            }
            
            const providerId = $('#quickAddProviderId').val();
            // Process includes field
            const includesText = $('#quickExperienciaIncludes').val().trim();
            const includesList = includesText ? 
                includesText.split('\n')
                    .map(item => item.trim())
                    .filter(item => item.length > 0)
                : [];
                
            // Process languages field  
            const languagesText = $('#quickExperienciaLanguages').val().trim();
            const languagesList = languagesText ? 
                languagesText.split('\n')
                    .map(item => item.trim())
                    .filter(item => item.length > 0)
                : [];
                
            // Process not includes field
            const notIncludesText = $('#quickExperienciaNotIncludes').val().trim();
            const notIncludesList = notIncludesText ? 
                notIncludesText.split('\n')
                    .map(item => item.trim())
                    .filter(item => item.length > 0)
                : [];
                
            // Collect photos data with optimization metadata preservation (same as main modal)
            const photosList = [];
            const photoElements = $('#quickAddExperienceModal .photos-preview-container .photo-preview');
            photoElements.each(function() {
                const img = $(this).find('img');
                if (img.length > 0) {
                    const photoElement = $(this);
                    const photoFullData = photoElement.attr('data-photo-full');
                    
                    
                    // If we have full photo data stored, use it (preserves optimization metadata)
                    if (photoFullData) {
                        try {
                            const fullData = JSON.parse(photoFullData.replace(/&#39;/g, "'"));
                            // Update the dataUrl in case the image was refreshed with a new presigned URL
                            fullData.dataUrl = img.attr('src');
                            photosList.push(fullData);
                        } catch (e) {
                            console.warn('Quick Add - Failed to parse photo full data, falling back to basic data:', e);
                            // Fallback to basic data
                            photosList.push({
                                dataUrl: img.attr('src'),
                                fileName: photoElement.find('small').attr('title') || 'image.jpg'
                            });
                        }
                    } else {
                        // No full data available (new upload)
                        photosList.push({
                            dataUrl: img.attr('src'),
                            fileName: photoElement.find('small').attr('title') || 'image.jpg'
                        });
                    }
                }
            });

            const experienciaData = {
                name: $('#quickExperienciaName').val().trim(),
                description: $('#quickExperienciaDescription').val().trim(),
                price: parseFloat($('#quickExperienciaPrice').val()) || 0,
                price_no_alcohol: $('#quickExperienciaPriceNoAlcohol').val() ? parseFloat($('#quickExperienciaPriceNoAlcohol').val()) : null,
                price_child: $('#quickExperienciaPriceChild').val() ? parseFloat($('#quickExperienciaPriceChild').val()) : null,
                tipo: $('#quickExperienciaTipo').val() || null,
                duration: $('#quickExperienciaDuration').val() ? parseFloat($('#quickExperienciaDuration').val()) : null,
                travel_duration: $('#quickExperienciaTravelDuration').val() ? parseInt($('#quickExperienciaTravelDuration').val()) : null,
                advance_booking_time: $('#quickExperienciaAdvanceTime').val() ? parseInt($('#quickExperienciaAdvanceTime').val()) : null,
                min_people: $('#quickExperienciaMinPeople').val() ? parseInt($('#quickExperienciaMinPeople').val()) : null,
                max_people: $('#quickExperienciaMaxPeople').val() ? parseInt($('#quickExperienciaMaxPeople').val()) : null,
                cancellation_policy: $('#quickExperienciaCancellationPolicy').val().trim() || null,
                buyout: $('#quickExperienciaBuyout').val() ? parseFloat($('#quickExperienciaBuyout').val()) : null,
                private_min_type: $('#quickExperienciaPrivateMinType').val() || null,
                private_min_value: $('#quickExperienciaPrivateMinValue').val() ? parseFloat($('#quickExperienciaPrivateMinValue').val()) : null,
                fixed_schedule: $('#quickExperienciaFixedSchedule').is(':checked'),
                includes: includesList,
                languages: languagesList,
                notincludes: notIncludesList,
                photos: photosList,
                availability: collectQuickAddAvailability(),
                // Notes fields
                internal_notes: $('#quickExperienciaInternalNotes').val().trim() || null,
                client_booking_notes: $('#quickExperienciaClientBookingNotes').val().trim() || null,
                provider_notes: $('#quickExperienciaProviderNotes').val().trim() || null,
                team_notes: $('#quickExperienciaTeamNotes').val().trim() || null
            };
            
            // Check if there are images to optimize
            const hasImagesToOptimize = photosList.some(p => p.dataUrl && p.dataUrl.startsWith('data:'));
            const totalImages = photosList.filter(p => p.dataUrl && p.dataUrl.startsWith('data:')).length;
            
            const initialButtonText = hasImagesToOptimize ? 
                `<i class="spinner-border spinner-border-sm me-1"></i>Optimizando ${totalImages} imagen${totalImages > 1 ? 'es' : ''}...` : 
                '<i class="spinner-border spinner-border-sm me-1"></i>Guardando...';
            
            $('#saveQuickExperienceBtn').prop('disabled', true).html(initialButtonText);
            
            // Show optimization progress if needed
            if (hasImagesToOptimize) {
                const progressHtml = `
                    <div id="quickOptimizationProgress" class="alert alert-info mb-3" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm me-2" role="status">
                                <span class="visually-hidden">Optimizando...</span>
                            </div>
                            <div>
                                <strong>Optimización de imágenes en progreso</strong><br>
                                <small>Las imágenes están siendo convertidas a formatos AVIF, WebP y JPEG para mejor rendimiento.</small>
                            </div>
                        </div>
                    </div>
                `;
                
                // Add progress indicator if not exists
                if (!$('#quickOptimizationProgress').length) {
                    $('#quickAddModalAlerts').prepend(progressHtml);
                }
            }
            
            $.ajax({
                url: `/api/providers/${providerId}/experiencias`,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(experienciaData),
                success: async function(response) {
                    if (response.success) {
                        // Add delay for image processing if needed
                        if (hasImagesToOptimize) {
                            $('#saveQuickExperienceBtn').html('<i class="spinner-border spinner-border-sm me-1"></i>Finalizando optimización...');
                            
                            // Update progress indicator
                            $('#quickOptimizationProgress').removeClass('alert-info').addClass('alert-success');
                            $('#quickOptimizationProgress').html(`
                                <div class="d-flex align-items-center">
                                    <i class="ti ti-check-circle me-2" style="font-size: 1.2rem;"></i>
                                    <div>
                                        <strong>Optimización completada</strong><br>
                                        <small>${totalImages} imagen${totalImages > 1 ? 'es optimizadas' : ' optimizada'} exitosamente.</small>
                                    </div>
                                </div>
                            `);
                            
                            // Wait a bit for image processing to complete
                            await new Promise(resolve => setTimeout(resolve, 2000));
                            
                            // Remove progress indicator
                            $('#quickOptimizationProgress').fadeOut(300, function() { 
                                $(this).remove(); 
                            });
                        }
                        
                        $('#quickAddExperienceModal').modal('hide');
                        dataTable.ajax.reload(null, false);
                        showSuccessAlert('Experiencia agregada exitosamente');
                        
                        // Reset button
                        $('#saveQuickExperienceBtn').prop('disabled', false).html('<i class="ti ti-check me-1"></i>Agregar Experiencia');
                    } else {
                        showQuickAddModalError('Error al agregar la experiencia');
                        $('#saveQuickExperienceBtn').prop('disabled', false).html('<i class="ti ti-check me-1"></i>Agregar Experiencia');
                    }
                },
                error: function(xhr) {
                    const errorMessage = xhr.responseJSON?.error || 'Error al agregar la experiencia';
                    showQuickAddModalError(errorMessage);
                    $('#saveQuickExperienceBtn').prop('disabled', false).html('<i class="ti ti-check me-1"></i>Agregar Experiencia');
                }
            });
        }
        
        function showQuickAddModalError(message) {
