<script>
(function() {
    function initWhenReady() {
        if (typeof jQuery === 'undefined') {
            setTimeout(initWhenReady, 100);
            return;
        }
        if (!jQuery.fn.dataTable) {
            setTimeout(initWhenReady, 100);
            return;
        }
        initProvidersTable();
    }

    function initProvidersTable() {
        const tableId = '<%= dtTableId %>';
        const apiEndpoint = '<%= dtApiEndpoint %>';
        const showActions = <%= dtShowActions %>;
        const canEdit = <%= canEdit %>;
        const canDelete = <%= canDelete %>;

        // Function to get access token from various sources
        function getAccessToken() {
            // Try localStorage first (common keys)
            const tokenFromStorage = localStorage.getItem('accessToken') || 
                                   localStorage.getItem('token') || 
                                   localStorage.getItem('authToken');
            if (tokenFromStorage) {
                return tokenFromStorage;
            }
            
            // Try cookies as fallback
            const cookies = document.cookie.split(';');
            for (let cookie of cookies) {
                const [name, value] = cookie.trim().split('=');
                if (name === 'clientAccessToken' || name === 'accessToken') {
                    return value;
                }
            }
            
            return null;
        }

        // Master-detail: relocate the provider form + action buttons out of the
        // legacy (now hidden) modal holder into the inline detail panel, then drop
        // the empty holder. Nodes keep their bound handlers when moved by jQuery.
        (function relocateProviderForm() {
            const $scroll = $('#providerDetailScroll');
            const $footer = $('#providerDetailFooter');
            if ($scroll.length && $('#providerForm').length) {
                $scroll.append($('#providerModalAlerts'));
                $scroll.append($('#providerForm'));
                $footer.append($('#saveProviderBtn'));
                $('#providerModal').remove();
            }
        })();

        // DataTable initialization with type=Provider filter
        const dataTable = $(`#${tableId}`).DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: apiEndpoint + '?type=Provider&includeInactive=true', // Show all providers in admin
                type: 'GET',
                dataSrc: function(json) {
                    return json.data || [];
                },
                error: function(xhr, error, thrown) {
                    console.error('Error loading providers:', error);
                    showErrorAlert('Error al cargar los proveedores. Por favor, intente nuevamente.');
                }
            },
            columns: [
                // Bandeja: una sola columna por proveedor (nombre + nº experiencias
                // + estado + menú de acciones). El renglón completo es clicable.
                {
                    data: null,
                    orderable: false,
                    render: function(data, type, row) {
                        const id = row.objectId || row.id;
                        const count = row.experienciasCount || 0;
                        const countLabel = count > 0
                            ? `${count} experiencia${count !== 1 ? 's' : ''}`
                            : 'Sin experiencias';
                        const status = row.active
                            ? '<span class="badge bg-success">Activo</span>'
                            : '<span class="badge bg-warning">Inactivo</span>';

                        let menuItems = '';
                        if (canEdit) {
                            const toggleTitle = row.active ? 'Desactivar' : 'Activar';
                            const toggleIcon = row.active ? 'ti-archive' : 'ti-archive-off';
                            menuItems += `
                                <li><button type="button" class="dropdown-item quick-add-experience-btn" data-id="${id}" data-name="${row.name}"><i class="ti ti-plus me-2"></i>Agregar experiencia rápida</button></li>
                                <li><button type="button" class="dropdown-item toggle-provider-status-btn" data-id="${id}" data-current-status="${row.active}" data-name="${row.name}"><i class="ti ${toggleIcon} me-2"></i>${toggleTitle}</button></li>
                                <li><button type="button" class="dropdown-item convert-to-establishment-btn" data-id="${id}" data-name="${row.name}"><i class="ti ti-building me-2"></i>Convertir a establecimiento</button></li>`;
                        }
                        if (canDelete) {
                            menuItems += `
                                <li><hr class="dropdown-divider"></li>
                                <li><button type="button" class="dropdown-item text-danger delete-provider-btn" data-id="${id}" data-name="${row.name}"><i class="ti ti-trash me-2"></i>Eliminar</button></li>`;
                        }
                        const menu = (showActions && menuItems) ? `
                            <div class="dropdown flex-shrink-0">
                                <button class="btn btn-sm btn-link text-muted p-0 px-1 provider-actions-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Acciones">
                                    <i class="ti ti-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">${menuItems}</ul>
                            </div>` : '';

                        return `
