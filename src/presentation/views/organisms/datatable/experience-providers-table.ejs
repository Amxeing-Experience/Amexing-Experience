            const chevron = el.querySelector('.experiencia-acc-chevron');
            if (body && getComputedStyle(body).display === 'none') {
                $(body).slideDown(150);
                if (chevron) chevron.style.transform = 'rotate(90deg)';
                el.classList.add('experiencia-expanded');
