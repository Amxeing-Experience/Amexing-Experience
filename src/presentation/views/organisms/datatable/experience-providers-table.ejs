        function addNewExperienciaCard() {
            const index = providerExperiencias.length;
            const experiencia = {
                name: '',
                description: '',
                tipo: null,
                price: 0,
                duration: null,
                min_people: null,
                max_people: null,
                cancellation_policy: null,
                buyout: null,
                private_min_type: null,
                private_min_value: null,
                fixed_schedule: false,
                includes: [],
                notincludes: [],
                photos: [],
                availability: null
            };
            
            providerExperiencias.push(experiencia);
            renderExperienciaCard(experiencia, index);

            // A brand-new experiencia starts expanded so the user can fill it in
            const newCard = document.querySelector(`.experiencia-editable[data-index="${index}"]`);
            if (newCard) expandExperienciaCard(newCard);

            // Focus on the name input of the new card
            setTimeout(() => {
                $(`.experiencia-editable[data-index="${index}"] .experiencia-name-input`).focus();
            }, 100);
        }
        
        function renderExperienciaCard(experiencia, index) {
            const template = document.getElementById('experienciaEditableTemplate');
            const clone = template.content.cloneNode(true);
            const card = clone.querySelector('.experiencia-editable');
            
            card.setAttribute('data-index', index);
            card.setAttribute('data-id', experiencia.id || '');

            // Populate the collapsed accordion header summary (name / price / tipo)
            syncExperienciaHeader(card, experiencia);

            // Populate form fields
            card.querySelector('.experiencia-name-input').value = experiencia.name || '';
            card.querySelector('.experiencia-description-input').value = experiencia.description || '';
            card.querySelector('.experiencia-tipo-input').value = experiencia.tipo || '';
            card.querySelector('.experiencia-price-input').value = experiencia.price || '';
            card.querySelector('.experiencia-price-no-alcohol-input').value = experiencia.price_no_alcohol || '';
            card.querySelector('.experiencia-price-child-input').value = experiencia.price_child || '';
            // Handle duration - keep as hours, convert from minutes if needed
            if (experiencia.duration) {
                const duration = parseFloat(experiencia.duration);
                if (duration > 24) {
                    // Likely stored in minutes, convert to hours
                    card.querySelector('.experiencia-duration-input').value = (duration / 60).toFixed(1);
                } else {
                    // Already in hours or reasonable hour value
                    card.querySelector('.experiencia-duration-input').value = duration;
                }
            }
            card.querySelector('.experiencia-travel-duration-input').value = experiencia.travel_duration || '';
            card.querySelector('.experiencia-min-people-input').value = experiencia.min_people || '';
            card.querySelector('.experiencia-max-people-input').value = experiencia.max_people || '';
            card.querySelector('.experiencia-cancellation-policy-input').value = experiencia.cancellation_policy || '';
            card.querySelector('.experiencia-buyout-input').value = (experiencia.buyout !== null && experiencia.buyout !== undefined) ? experiencia.buyout : '';
            card.querySelector('.experiencia-private-min-type-input').value = experiencia.private_min_type || '';
            card.querySelector('.experiencia-private-min-value-input').value = (experiencia.private_min_value !== null && experiencia.private_min_value !== undefined) ? experiencia.private_min_value : '';
            card.querySelector('.experiencia-fixed-schedule-input').checked = !!experiencia.fixed_schedule;

            // Populate includes field - convert array back to lines
            const includesText = experiencia.includes && experiencia.includes.length > 0 ? 
                experiencia.includes.join('\n') : '';
            card.querySelector('.experiencia-includes-input').value = includesText;
            
            // Populate languages field - convert array back to lines
            const languagesText = experiencia.languages && experiencia.languages.length > 0 ? 
                experiencia.languages.join('\n') : '';
            card.querySelector('.experiencia-languages-input').value = languagesText;
            
            // Populate notincludes field - convert array back to lines
            const notIncludesText = experiencia.notincludes && experiencia.notincludes.length > 0 ? 
                experiencia.notincludes.join('\n') : '';
            card.querySelector('.experiencia-notincludes-input').value = notIncludesText;
            
            // Populate advance booking time field (minutes only)
            if (experiencia.advance_booking_time) {
                // If it's the old format with hours/minutes, convert to total minutes
                if (typeof experiencia.advance_booking_time === 'object' && experiencia.advance_booking_time.total_minutes) {
                    card.querySelector('.experiencia-advance-minutes-input').value = experiencia.advance_booking_time.total_minutes;
                } else if (typeof experiencia.advance_booking_time === 'number') {
                    // If it's already just minutes
                    card.querySelector('.experiencia-advance-minutes-input').value = experiencia.advance_booking_time;
                }
            }
            
            // Populate notes fields
            card.querySelector('.experiencia-internal-notes-input').value = experiencia.internal_notes || '';
            card.querySelector('.experiencia-client-booking-notes-input').value = experiencia.client_booking_notes || '';
            card.querySelector('.experiencia-provider-notes-input').value = experiencia.provider_notes || '';
            card.querySelector('.experiencia-team-notes-input').value = experiencia.team_notes || '';
            
            // Photos and availability rendering must never prevent the card itself
            // from being shown: a single malformed photo or availability entry used
            // to throw here and silently drop the whole experiencia (the count said
            // "1" but nothing rendered). Guard each so the card always appends.
            try {
                // Populate photos if they exist
                const photosContainer = $(card).find('.photos-preview-container');
                if (experiencia.photos && experiencia.photos.length > 0) {
                    experiencia.photos.forEach((photo) => {
                        // Backend now provides presigned URLs in dataUrl field
                        const photoUrl = photo.dataUrl || photo.url;
                        const fileName = photo.fileName || photo.name || 'image';

                        if (photoUrl) {
                            // Pass the entire photo object to preserve all data
                            addPhotoPreview(photosContainer, { name: fileName }, photoUrl, photo);
                        }
                    });
                }
            } catch (photoErr) {
                console.error('Error rendering experiencia photos (card still shown):', photoErr);
            }

            try {
                // Update availability display and populate availability interface
                updateAvailabilityDisplay($(card), experiencia.availability);
                populateAvailabilityInterface($(card), experiencia.availability);
            } catch (availErr) {
                console.error('Error rendering experiencia availability (card still shown):', availErr);
            }

            // Add to container
            $('#providerExperienciasList').append(card);
            updateNoExperienciasMessage();
        }
        
        function updateExperienciaFromCard(card, index) {
            if (index >= providerExperiencias.length) return;
            
            const experiencia = providerExperiencias[index];
            experiencia.name = card.find('.experiencia-name-input').val().trim();
            experiencia.description = card.find('.experiencia-description-input').val().trim();
            experiencia.tipo = card.find('.experiencia-tipo-input').val().trim() || null;
            experiencia.price = parseFloat(card.find('.experiencia-price-input').val()) || 0;
            experiencia.price_no_alcohol = card.find('.experiencia-price-no-alcohol-input').val() ? parseFloat(card.find('.experiencia-price-no-alcohol-input').val()) : null;
            experiencia.price_child = card.find('.experiencia-price-child-input').val() ? parseFloat(card.find('.experiencia-price-child-input').val()) : null;
            experiencia.duration = card.find('.experiencia-duration-input').val() ? parseFloat(card.find('.experiencia-duration-input').val()) : null;
            experiencia.travel_duration = card.find('.experiencia-travel-duration-input').val() ? parseInt(card.find('.experiencia-travel-duration-input').val()) : null;
            experiencia.min_people = card.find('.experiencia-min-people-input').val() ? parseInt(card.find('.experiencia-min-people-input').val()) : null;
            experiencia.max_people = card.find('.experiencia-max-people-input').val() ? parseInt(card.find('.experiencia-max-people-input').val()) : null;
            experiencia.cancellation_policy = card.find('.experiencia-cancellation-policy-input').val().trim() || null;
            experiencia.buyout = card.find('.experiencia-buyout-input').val() ? parseFloat(card.find('.experiencia-buyout-input').val()) : null;
            experiencia.private_min_type = card.find('.experiencia-private-min-type-input').val() || null;
            experiencia.private_min_value = card.find('.experiencia-private-min-value-input').val() ? parseFloat(card.find('.experiencia-private-min-value-input').val()) : null;
            experiencia.fixed_schedule = card.find('.experiencia-fixed-schedule-input').is(':checked');

            // Process includes field - convert lines to array
            const includesText = card.find('.experiencia-includes-input').val().trim();
            experiencia.includes = includesText ? 
                includesText.split('\n')
                    .map(item => item.trim())
                    .filter(item => item.length > 0)
                : [];
            
            // Process languages field - convert lines to array
            const languagesText = card.find('.experiencia-languages-input').val().trim();
            experiencia.languages = languagesText ? 
                languagesText.split('\n')
                    .map(item => item.trim())
                    .filter(item => item.length > 0)
                : [];
            
            // Process notincludes field - convert lines to array
            const notIncludesText = card.find('.experiencia-notincludes-input').val().trim();
            experiencia.notincludes = notIncludesText ? 
                notIncludesText.split('\n')
                    .map(item => item.trim())
                    .filter(item => item.length > 0)
                : [];
            
            // Process advance booking time (minutes only)
            const totalMinutes = parseInt(card.find('.experiencia-advance-minutes-input').val()) || 0;
            experiencia.advance_booking_time = totalMinutes;
            
            // Collect photos data from card
            const photoElements = card.find('.photo-preview');
            experiencia.photos = [];
            photoElements.each(function(idx) {
                const img = $(this).find('img');
                if (img.length > 0) {
                    // Try to get full photo data first
                    const fullPhotoData = $(this).attr('data-photo-full');
                    let photoData = null;
                    
                    
                    if (fullPhotoData && fullPhotoData !== '') {
                        try {
                            // Parse the full photo data which includes all fields
                            photoData = JSON.parse(fullPhotoData);
                            // Update the URL in case it changed (e.g., new presigned URL)
                            photoData.dataUrl = img.attr('src');
                        } catch (e) {
                            console.error('Error parsing photo data:', e, 'Raw data:', fullPhotoData);
                        }
                    }
                    
                    // Fallback if no full data available (new uploads)
                    if (!photoData) {
                        photoData = {
                            dataUrl: img.attr('src'),
                            fileName: $(this).find('small').attr('title') || 'image.jpg'
                        };
                    }
                    
                    experiencia.photos.push(photoData);
                }
            });
            
            // Collect availability data from card
            experiencia.availability = collectAvailabilityFromCard(card);
            
            // Update availability display in summary view
            updateAvailabilityDisplay(card, experiencia.availability);
            
            // Validate and show feedback
            validateExperienciaCard(card, experiencia);
        }

        function updateAvailabilityDisplay(card, availability) {
            const availabilityStatusElement = card.find('.availability-status');
            
            if (availability && Array.isArray(availability) && availability.length > 0) {
                // Build a compact availability summary
                const dayNames = {
                    0: 'Do', 1: 'Lu', 2: 'Ma', 3: 'Mi', 4: 'Ju', 5: 'Vi', 6: 'Sa'
                };
                
                const availableDays = availability.map(daySchedule => {
                    const dayName = dayNames[daySchedule.day] || daySchedule.day;
                    if (daySchedule.times && daySchedule.times.length > 0) {
                        return dayName;
                    }
                    return dayName;
                }).join(', ');
                
                availabilityStatusElement.html(`
                    <i class="ti ti-calendar-check me-1"></i>
                    ${availableDays}
                `);
            } else {
                // No specific availability configured
                availabilityStatusElement.html(`
                    <i class="ti ti-check-circle me-1"></i>
                    Disponible todos los días
                `);
            }
        }

        function collectAvailabilityFromCard(card) {
            const availability = [];
            
            // Find all selected days with schedules
            card.find('.experiencia-selected-schedule-days .day-schedule-row').each(function() {
                const dayScheduleRow = $(this);
                const day = parseInt(dayScheduleRow.data('day'));
                
                const daySchedule = {
                    day: day,
                    times: []
                };
                
                // Collect time slots for this day
                dayScheduleRow.find('.time-slot-row').each(function() {
                    const timeRow = $(this);
                    const startTime = timeRow.find('.start-time').val();
                    const endTime = timeRow.find('.end-time').val();
                    
                    if (startTime && endTime) {
                        daySchedule.times.push({
                            start: startTime,
                            end: endTime
                        });
                    }
                });
                
                // Only add if there are times or if the day is selected without specific times
                if (daySchedule.times.length > 0) {
                    availability.push(daySchedule);
                }
            });
            
            return availability.length > 0 ? availability : null;
        }

        function populateAvailabilityInterface(card, availability) {
            if (!availability || !Array.isArray(availability)) {
                return;
            }

            availability.forEach(function(daySchedule) {
                const dayCode = daySchedule.day;
                const dayName = getDayName(dayCode);
                
                // Activate the day button
                const dayButton = card.find(`.experiencia-available-days-container .day-btn[data-day="${dayCode}"]`);
                if (dayButton.length > 0) {
                    dayButton.removeClass('btn-outline-primary').addClass('active btn-primary');
                    
                    // Create day schedule with existing times
                    if (daySchedule.times && daySchedule.times.length > 0) {
                        // Add day schedule with the first time slot
                        addProviderExperienciaDaySchedule(card, dayCode, dayName, daySchedule.times[0].start, daySchedule.times[0].end);
                        
                        // Add any additional time slots
                        for (let i = 1; i < daySchedule.times.length; i++) {
                            const timeSlot = daySchedule.times[i];
                            const dayScheduleRow = card.find(`.experiencia-selected-schedule-days .day-schedule-row[data-day="${dayCode}"]`);
                            const timeSlotsContainer = dayScheduleRow.find('.time-slots-container');
                            
                            const newTimeSlot = $(`
                                <div class="time-slot-row mb-1">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-auto">
                                            <small class="text-muted">De:</small>
                                        </div>
                                        <div class="col">
                                            <input type="time" class="form-control start-time" value="${timeSlot.start}">
                                        </div>
                                        <div class="col-auto">
                                            <small class="text-muted">A:</small>
                                        </div>
                                        <div class="col">
                                            <input type="time" class="form-control end-time" value="${timeSlot.end}">
                                        </div>
                                        <div class="col-auto">
                                            <button type="button" class="btn btn-sm btn-outline-success add-time-slot-btn" title="Agregar horario">
                                                <i class="ti ti-plus"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-time-slot-btn" title="Eliminar horario">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            `);
                            
                            timeSlotsContainer.append(newTimeSlot);
                        }
                    } else {
                        // Add day with default times
                        addProviderExperienciaDaySchedule(card, dayCode, dayName);
                    }
                }
            });
        }

        function getDayName(dayCode) {
            const dayNames = {
                0: 'Domingo',
                1: 'Lunes', 
                2: 'Martes',
                3: 'Miércoles',
                4: 'Jueves',
                5: 'Viernes',
                6: 'Sábado'
            };
            return dayNames[dayCode] || `Día ${dayCode}`;
        }

        function addProviderExperienciaDaySchedule(card, dayCode, dayName, startTime = '09:00', endTime = '18:00') {
            const selectedScheduleDays = card.find('.experiencia-selected-schedule-days');
