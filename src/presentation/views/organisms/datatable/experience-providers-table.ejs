        // ========== SUBEXPERIENCIA ACCORDION (collapse/expand) ==========
        // Each subexperiencia renders collapsed, showing only a summary header
        // (name / price / tipo). Clicking the header expands the full editable
        // body. Photos use loading="lazy" + a display:none body, so their
        // network fetch is deferred until the card is actually expanded.
        function syncExperienciaHeader(cardEl, exp) {
            const el = cardEl && cardEl.jquery ? cardEl[0] : cardEl;
            if (!el) return;
            const nameVal = exp ? (exp.name || '') : (el.querySelector('.experiencia-name-input')?.value || '');
            const priceRaw = exp ? exp.price : el.querySelector('.experiencia-price-input')?.value;
            const tipoVal = exp ? (exp.tipo || '') : (el.querySelector('.experiencia-tipo-input')?.value || '');

            const titleEl = el.querySelector('.experiencia-acc-title');
            if (titleEl) titleEl.textContent = (nameVal && nameVal.trim()) ? nameVal.trim() : 'Nueva experiencia';

            const priceEl = el.querySelector('.experiencia-acc-price');
            if (priceEl) {
                const n = parseFloat(priceRaw);
                priceEl.textContent = (!isNaN(n) && n > 0) ? ('$' + n.toLocaleString('es-MX')) : '';
            }

            const tipoEl = el.querySelector('.experiencia-acc-tipo');
            if (tipoEl) {
                if (tipoVal) { tipoEl.textContent = tipoVal; tipoEl.classList.remove('d-none'); }
                else { tipoEl.textContent = ''; tipoEl.classList.add('d-none'); }
            }
        }

        function expandExperienciaCard(cardEl) {
