        function loadProviderExperiencias(providerId, onRendered) {
            if (!providerId) return;

            showExperienciasLoader();

            $.ajax({
                url: `/api/providers/${providerId}/experiencias`,
                type: 'GET',
                headers: {
                    'Accept': 'image/avif;q=1.0,image/webp;q=0.9,image/jpeg;q=0.8,image/*;q=0.5,application/json'
                },
                success: function(response) {
                    if (response.success && response.data) {
                        providerExperiencias = response.data;
                        renderAllExperienciaCards();
                    } else {
                        console.error('Provider experiencias response without data:', response);
                    }
                },
                error: function(xhr) {
                    const msg = xhr.responseJSON?.error || `HTTP ${xhr.status}`;
                    console.error('Error loading provider experiencias:', msg);
                    if (typeof showErrorAlert === 'function') {
                        showErrorAlert('No se pudieron cargar las experiencias del proveedor: ' + msg);
                    }
                },
                complete: function() {
                    // Runs on both success and error: always clear the spinner.
                    hideExperienciasLoader();
                    updateNoExperienciasMessage();
                    // onRendered SIEMPRE corre al terminar (con o sin datos), para que
                    // quien recarga (p.ej. el guardado) sepa que el reload ya acabó.
                    if (typeof onRendered === 'function') {
                        try { onRendered(); } catch (e) { console.error('onRendered callback error:', e); }
                    }
                }
            });
        }

        function collectExperienciasFromCards() {
            const experiencias = [];
            
            $('.experiencia-editable').each(function(index) {
                const card = $(this);
                const id = card.data('id');
                
                // Process includes field - convert lines to array
                const includesText = card.find('.experiencia-includes-input').val().trim();
                const includesList = includesText ? 
                    includesText.split('\n')
                        .map(item => item.trim())
                        .filter(item => item.length > 0)
                    : [];
                
                // Process languages field - convert lines to array
                const languagesText = card.find('.experiencia-languages-input').val().trim();
                const languagesList = languagesText ? 
                    languagesText.split('\n')
                        .map(item => item.trim())
                        .filter(item => item.length > 0)
                    : [];
                
                // Process notincludes field - convert lines to array
                const notIncludesText = card.find('.experiencia-notincludes-input').val().trim();
                const notIncludesList = notIncludesText ? 
                    notIncludesText.split('\n')
                        .map(item => item.trim())
                        .filter(item => item.length > 0)
                    : [];
                
                // Process advance booking time (minutes only)
                const advanceBookingTime = parseInt(card.find('.experiencia-advance-minutes-input').val()) || 0;
                
                // Collect photos data from card - preserve full photo data including optimization metadata
                const photoElements = card.find('.photo-preview');
                const photosList = [];
                photoElements.each(function() {
                    const img = $(this).find('img');
                    if (img.length > 0) {
                        const photoElement = $(this);
                        const photoFullData = photoElement.attr('data-photo-full');
                        
                        
                        // If we have full photo data stored, use it (preserves optimization metadata)
                        if (photoFullData) {
                            try {
                                const fullData = JSON.parse(photoFullData.replace(/&#39;/g, "'"));
                                // Update the dataUrl in case the image was refreshed with a new presigned URL
                                fullData.dataUrl = img.attr('src');
                                photosList.push(fullData);
                            } catch (e) {
                                console.warn('Failed to parse photo full data, falling back to basic data:', e);
                                // Fallback to basic data
                                photosList.push({
                                    dataUrl: img.attr('src'),
                                    fileName: photoElement.find('small').attr('title') || 'image.jpg'
                                });
                            }
                        } else {
                            // No full data available (new upload or legacy)
                            photosList.push({
                                dataUrl: img.attr('src'),
                                fileName: photoElement.find('small').attr('title') || 'image.jpg'
                            });
                        }
                    }
                });
                
                const experiencia = {
                    name: card.find('.experiencia-name-input').val().trim(),
                    description: card.find('.experiencia-description-input').val().trim(),
                    tipo: card.find('.experiencia-tipo-input').val().trim() || null,
                    price: parseFloat(card.find('.experiencia-price-input').val()) || 0,
                    price_no_alcohol: card.find('.experiencia-price-no-alcohol-input').val() ? parseFloat(card.find('.experiencia-price-no-alcohol-input').val()) : null,
                    price_child: card.find('.experiencia-price-child-input').val() ? parseFloat(card.find('.experiencia-price-child-input').val()) : null,
                    duration: card.find('.experiencia-duration-input').val() ? parseFloat(card.find('.experiencia-duration-input').val()) : null,
                    travel_duration: card.find('.experiencia-travel-duration-input').val() ? parseInt(card.find('.experiencia-travel-duration-input').val()) : null,
                    min_people: card.find('.experiencia-min-people-input').val() ? parseInt(card.find('.experiencia-min-people-input').val()) : null,
                    max_people: card.find('.experiencia-max-people-input').val() ? parseInt(card.find('.experiencia-max-people-input').val()) : null,
                    cancellation_policy: card.find('.experiencia-cancellation-policy-input').val().trim() || null,
                    buyout: card.find('.experiencia-buyout-input').val() ? parseFloat(card.find('.experiencia-buyout-input').val()) : null,
                    private_min_type: card.find('.experiencia-private-min-type-input').val() || null,
                    private_min_value: card.find('.experiencia-private-min-value-input').val() ? parseFloat(card.find('.experiencia-private-min-value-input').val()) : null,
                    fixed_schedule: card.find('.experiencia-fixed-schedule-input').is(':checked'),
                    includes: includesList,
                    languages: languagesList,
                    notincludes: notIncludesList,
                    advance_booking_time: advanceBookingTime,
                    photos: photosList,
                    availability: collectAvailabilityFromCard(card),
                    displayOrder: index,
                    // Notes fields
                    internal_notes: card.find('.experiencia-internal-notes-input').val().trim() || null,
                    client_booking_notes: card.find('.experiencia-client-booking-notes-input').val().trim() || null,
                    provider_notes: card.find('.experiencia-provider-notes-input').val().trim() || null,
                    team_notes: card.find('.experiencia-team-notes-input').val().trim() || null
                };
                
                // Only include experiences with at least name and description
                if (experiencia.name && experiencia.description) {
                    if (id) {
                        experiencia.id = id;
                    }
                    experiencias.push(experiencia);
                }
            });
            
            return experiencias;
        }

