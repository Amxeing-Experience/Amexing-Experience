            if (!el) return;
            const body = el.querySelector('.experiencia-acc-body');
            const chevron = el.querySelector('.experiencia-acc-chevron');
            if (body && getComputedStyle(body).display !== 'none') {
                $(body).slideUp(150);
                if (chevron) chevron.style.transform = 'rotate(0deg)';
                el.classList.remove('experiencia-expanded');
            }
        }

