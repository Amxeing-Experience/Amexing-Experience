        // Helper function to wait for Select instance (Tom Select or Custom Select) to be initialized
        function waitForSelectInstance(elementId, maxAttempts = 50) {
            return new Promise((resolve, reject) => {
                let attempts = 0;
                const checkInterval = setInterval(() => {
                    const element = document.getElementById(elementId);
                    
                    // Check for both Tom Select and Custom Select instances
                    if (element && (element.tomselect || element.customSelect)) {
                        clearInterval(checkInterval);
                        const instance = element.tomselect || element.customSelect;
                        console.log(`✅ Select instance found for #${elementId}:`, element.tomselect ? 'TomSelect' : 'CustomSelect');
                        resolve(instance);
                    } else {
                        attempts++;
                        if (attempts >= maxAttempts) {
                            clearInterval(checkInterval);
                            reject(new Error(`Select instance (TomSelect or CustomSelect) not initialized on #${elementId}`));
                        }
                    }
                }, 100);
            });
        }

        function loadDropdownData(retryCount = 0) {
            console.log('🔧 POI Loading: Starting loadDropdownData for services, retry count:', retryCount);
            
            // Check if target elements exist
            const originElement = document.getElementById('originPOI');
            const destElement = document.getElementById('destinationPOI');
            console.log('🔧 POI Loading: originPOI element exists:', !!originElement);
            console.log('🔧 POI Loading: destinationPOI element exists:', !!destElement);
            
            if (!originElement || !destElement) {
                console.error('❌ POI Loading: Required elements not found');
                return;
            }
            
            // Check authentication
            const token = getAccessToken();
            console.log('🔧 POI Loading: Authentication token available:', !!token, token ? '(length: ' + token.length + ')' : '');
            
            const maxRetries = 3;

            // Load POIs
            $.ajax({
                url: '/api/pois/active',
                type: 'GET',
                beforeSend: function(xhr) {
                    console.log('🔧 POI Loading: Making API request to /api/pois/active');
                    if (token) {
                        xhr.setRequestHeader('Authorization', `Bearer ${token}`);
                        console.log('🔧 POI Loading: Added Authorization header');
                    } else {
                        console.warn('🔧 POI Loading: No authentication token available!');
                    }
                },
                success: async function(response) {
                    console.log('🔧 POI Loading: API response received:', response);
                    if (response.success && response.data) {
                        poisData = response.data;
                        console.log('🔧 POI Loading: POI data loaded, count:', response.data.length);

                        try {
                            // Wait for Select instances to be initialized
                            const originTS = await waitForSelectInstance('originPOI');
                            const destTS = await waitForSelectInstance('destinationPOI');
                            console.log('🔧 POI Loading: Select instances found');

                            // Clear existing options
                            originTS.clearOptions();
                            destTS.clearOptions();
                            console.log('🔧 POI Loading: Cleared existing options');

                            // Add options to both Tom Select instances.
                            // Both show the POI's serviceType in small parentheses.
                            response.data.forEach(poi => {
                                const type = poi.serviceType && poi.serviceType.name ? poi.serviceType.name : null;
                                originTS.addOption({ value: poi.value, text: poi.label, type });
                                destTS.addOption({ value: poi.value, text: poi.label, type });
                            });
                            console.log('🔧 POI Loading: Added', response.data.length, 'options to both dropdowns');

                            // Refresh to apply changes (API compatibility)
                            if (originTS.refreshOptions) {
                                originTS.refreshOptions(false);
                            }
                            if (destTS.refreshOptions) {
                                destTS.refreshOptions(false);
                            }
                            console.log('✅ POI Loading: Successfully loaded POI options');
                        } catch (error) {
                            console.error('❌ POI Loading: Error with Select instances:', error);
                        }
                    } else {
                        console.error('❌ POI Loading: Invalid response format:', response);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('❌ POI Loading Error:', {
                        status: xhr.status,
                        statusText: xhr.statusText,
                        error: error,
                        responseText: xhr.responseText,
                        retryCount: retryCount
                    });
                    if (xhr.status === 401 && retryCount < maxRetries) {
                        console.log('🔧 POI Loading: Retrying due to 401 error...');
                        setTimeout(function() { loadDropdownData(retryCount + 1); }, 1000);
                    } else if (retryCount >= maxRetries) {
                        console.error('❌ POI Loading: Max retries exceeded, giving up');
                    }
                }
            });

            // Load VehicleTypes
            $.ajax({
                url: '/api/vehicle-types/active',
                type: 'GET',
                success: function(response) {
                    if (response.success && response.data) {
                        vehicleTypesData = response.data;
                        const options = response.data.map(vt =>
                            `<option value="${vt.value}">${vt.label}</option>`
                        ).join('');
                        // Vehicle types loaded but not used in form anymore
                    }
                },
                error: function(xhr) {
                }
            });

            // Load Rates
            $.ajax({
                url: '/api/rates/active',
                type: 'GET',
                success: function(response) {
                    if (response.success && response.data) {
                        ratesData = response.data;
                        const options = response.data.map(rate =>
                            `<option value="${rate.value}">${rate.label}</option>`
                        ).join('');
                        // Rates loaded but not used in form anymore
                    }
                },
                error: function(xhr) {
                }
            });
        }

