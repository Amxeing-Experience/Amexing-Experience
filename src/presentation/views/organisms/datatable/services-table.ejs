        // Function to update a specific service row with fresh price data
        async function updateServiceRowWithPrices(serviceId) {
            try {
                
                // Get the current rate filter to ensure we fetch pricing data
                const selectedRate = $(`#headerRateFilter-${tableId}`).val();
                const token = getAccessToken();
                
                // Use the main services endpoint with filtering to get full price data
                // The single service endpoint doesn't include priceData array
                let apiUrl = apiEndpoint; // Use main services endpoint
                let params = [];
                
                if (selectedRate) {
                    params.push(`rateId=${encodeURIComponent(selectedRate)}`);
                }
                
                // Add cache-busting parameters
                params.push(`_t=${Date.now()}`);
                params.push(`_r=${Math.random()}`);
                params.push(`_cb=${new Date().getTime()}`);
                
                if (params.length > 0) {
                    // apiEndpoint may already carry a query string (e.g. ?includeInactive=true),
                    // so use '&' as the separator in that case to avoid a malformed double '?'.
                    apiUrl += `${apiUrl.includes('?') ? '&' : '?'}${params.join('&')}`;
                }
                
                
                const response = await fetch(apiUrl, {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Cache-Control': 'no-cache, no-store, must-revalidate',
                        'Pragma': 'no-cache',
                        'Expires': '0',
                        'If-Modified-Since': 'Thu, 01 Jan 1970 00:00:00 GMT'
                    }
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();
                if (!result.success || !result.data) {
                    throw new Error('Failed to get updated services data');
                }

                // Find the specific service in the response
                const updatedService = result.data.find(service => 
                    service.id === serviceId || service.objectId === serviceId
                );
                
                if (!updatedService) {
                    throw new Error(`Service with ID ${serviceId} not found in response`);
                }
                

                // Find the row in the DataTable
                const table = dataTable; // Use the global dataTable instance
                let targetRowIndex = -1;
                
                // Find the row index by comparing service IDs
                table.rows().every(function(index) {
                    const rowData = this.data();
                    if (rowData && (rowData.id === serviceId || rowData.objectId === serviceId)) {
                        targetRowIndex = index;
                        return false; // Break the loop
                    }
                    return true; // Continue
                });

                if (targetRowIndex !== -1) {
                    
                    // Update the row data with fresh service data including prices
                    table.row(targetRowIndex).data(updatedService).draw(false);
                    
                    // Update the services data arrays to keep them in sync
                    const serviceIndex = allServicesData.findIndex(s => s.id === serviceId || s.objectId === serviceId);
                    if (serviceIndex !== -1) {
                        allServicesData[serviceIndex] = updatedService;
                    }
                    
                    const filteredIndex = filteredData.findIndex(s => s.id === serviceId || s.objectId === serviceId);
                    if (filteredIndex !== -1) {
                        filteredData[filteredIndex] = updatedService;
                    }
                    
                    // Update service prices map if we have price data
                    if (updatedService.priceData && updatedService.priceData.length > 0) {
                        updatedService.priceData.forEach(priceItem => {
                            const key = `${serviceId}_${priceItem.vehicleCode || priceItem.vehicleType?.code}`;
                            servicePricesMap.set(key, {
                                service: updatedService,
                                vehicleType: priceItem.vehicleType || { name: priceItem.vehicleType, code: priceItem.vehicleCode },
                                price: priceItem.price,
                                formattedPrice: priceItem.formattedPrice
                            });
                        });
                    }
                    
                    // Force redraw of the specific row to ensure price updates are visible
                    setTimeout(() => {
                        table.row(targetRowIndex).invalidate().draw(false);
                    }, 100);
                    
                    return true;
                } else {
                    return false;
                }
            } catch (error) {
                return false;
            }
        }

