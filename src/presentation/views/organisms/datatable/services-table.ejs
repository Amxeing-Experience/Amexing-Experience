        // Function to update all displayed prices based on payment type, currency, guide and greeter options
        function updatePricesForFilters(paymentType, currency, includeGuide = false, includeGreeter = false) {
            
            // Update capacity displays in main table
            const capacitySelectors = [
                '.price-item-card .text-muted',
                '.price-container .text-muted',
                '.fw-bold ~ .text-muted',
                '.price-item-card .d-flex .text-muted'
            ];
            
            capacitySelectors.forEach((selector) => {
                const elements = $(selector);
                
                elements.each(function() {
                    const capacityElement = $(this);
                    const capacityText = capacityElement.html();
                    
                    // Look for user icon in the content
                    if (capacityText && capacityText.includes('ti-user')) {
                        // Extract capacity number and update it based on guide state
                        const capacityMatch = capacityText.match(/(\d+)\s*<i[^>]*class="[^"]*ti-user[^"]*"[^>]*><\/i>/);
                        if (capacityMatch) {
                            const currentDisplayCapacity = parseInt(capacityMatch[1]);
                            
                            // Get or store the original capacity
                            let originalCapacity = capacityElement.data('original-capacity');
                            if (!originalCapacity) {
                                // Calculate original capacity by adding back any current reductions
                                let capacityReduction = 0;
                                if (includeGuide) capacityReduction++;
                                if (includeGreeter) capacityReduction++;
                                originalCapacity = currentDisplayCapacity + capacityReduction;
                                capacityElement.data('original-capacity', originalCapacity);
                            }
                            
