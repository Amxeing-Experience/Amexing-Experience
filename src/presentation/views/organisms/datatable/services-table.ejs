    // ========== SERVICE PRICE HISTORY MODAL MANAGEMENT ==========
    /**
     * Open service price history modal and load price history data
     * @param {string} serviceId - ID of the service
     * @param {string} serviceName - Name of the service
     */
    window.openServicePriceHistoryModal = function(serviceId, serviceName) {
        // Set service name in modal
        document.getElementById('servicePriceHistoryServiceName').textContent = `Traslado: ${serviceName}`;
        
        // Reset modal states
        resetServicePriceHistoryModalStates();
        
        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('servicePriceHistoryModal'));
        modal.show();
        
        // Load price history data
        loadServicePriceHistoryData(serviceId);
    };

    /**
     * Reset all modal states to initial
     */
    function resetServicePriceHistoryModalStates() {
        document.getElementById('servicePriceHistoryLoading').classList.remove('d-none');
        document.getElementById('servicePriceHistoryError').classList.add('d-none');
        document.getElementById('servicePriceHistoryNoData').classList.add('d-none');
        document.getElementById('servicePriceHistoryContent').classList.add('d-none');
        document.getElementById('servicePriceHistoryTableBody').innerHTML = '';
    }

    /**
     * Load service price history data from API
     * @param {string} serviceId - ID of the service
     */
    function loadServicePriceHistoryData(serviceId) {
        // Use $.ajax to include JWT token from global setup
        $.ajax({
            url: `/api/services/${serviceId}/price-history`,
            method: 'GET',
            dataType: 'json'
        })
        .done(function(data) {
            document.getElementById('servicePriceHistoryLoading').classList.add('d-none');
            
            if (data.success) {
                if (data.data && data.data.length > 0) {
                    populateServicePriceHistoryTable(data.data);
                    document.getElementById('servicePriceHistoryContent').classList.remove('d-none');
                } else {
                    document.getElementById('servicePriceHistoryNoData').classList.remove('d-none');
                }
            } else {
                showServicePriceHistoryError(data.error || 'Error al cargar el historial de precios');
            }
        })
        .fail(function(xhr, status, error) {
            document.getElementById('servicePriceHistoryLoading').classList.add('d-none');
            
            if (xhr.status === 401) {
                showServicePriceHistoryError('No tienes permisos para ver el historial de precios');
            } else if (xhr.status === 404) {
                showServicePriceHistoryError('Servicio no encontrado');
            } else {
                showServicePriceHistoryError('Error de conexión al cargar el historial de precios');
            }
        });
    }

    /**
     * Populate the service price history table with data
     * @param {Array} historyData - Array of price history records
     */
    function populateServicePriceHistoryTable(historyData) {
        const tbody = document.getElementById('servicePriceHistoryTableBody');
        tbody.innerHTML = '';
        
        historyData.forEach(record => {
            const row = document.createElement('tr');
            
            // Format dates
            const validFrom = new Date(record.validFrom).toLocaleDateString('es-MX', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            });
            
            // Get the year from validFrom date for "Vigente" text
            const validFromYear = new Date(record.validFrom).getFullYear();
            
            const validUntil = record.validUntil 
                ? new Date(record.validUntil).toLocaleDateString('es-MX', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })
                : `Vigente al 31 de diciembre del ${validFromYear}`;
            
            // Format price
            const formattedPrice = parseFloat(record.price).toLocaleString('es-MX', {
                style: 'currency',
                currency: 'MXN'
            });
            
            // Duration text
            const durationText = record.duration ? `${record.duration} días` : 'N/A';
            
            // Status badge
            const statusBadge = record.status === 'active' 
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Histórico</span>';
            
            row.innerHTML = `
                <td>${validFrom}</td>
                <td class="fw-semibold text-primary">${formattedPrice}</td>
                <td>${record.vehicleTypeName || 'N/A'}</td>
                <td>${record.rateName || 'N/A'}</td>
                <td>${validUntil}</td>
                <td>${durationText}</td>
                <td>${statusBadge}</td>
            `;
            
            tbody.appendChild(row);
        });
    }

    /**
     * Show error message in service price history modal
     * @param {string} message - Error message to display
     */
    function showServicePriceHistoryError(message) {
        document.getElementById('servicePriceHistoryErrorMessage').textContent = message;
        document.getElementById('servicePriceHistoryError').classList.remove('d-none');
    }
    // ========== END SERVICE PRICE HISTORY MODAL MANAGEMENT ==========
})();
</script>

