        async function saveBasePricing(serviceId) {
            const basePrices = [];
            const newPrices = [];
            
            // Collect all edit price inputs (new grid format)
            $('.edit-price-input').each(function() {
                const input = $(this);
                const price = parseFloat(input.val()) || 0;
                const existingId = input.data('existing-id');
                const rateId = input.data('rate-id');
                const vehicleId = input.data('vehicle-id');
                
                if (existingId) {
                    // Always update existing prices (even if 0 - will deactivate via valid_until)
                    basePrices.push({
                        id: existingId,
                        rateId: rateId,
                        vehicleId: vehicleId,
                        price: price
                    });
                } else if (price > 0) {
                    // Only create new prices if > 0
                    newPrices.push({
                        rateId: rateId,
                        vehicleId: vehicleId,
                        price: price
                    });
                }
            });
            
            // Also collect legacy base price inputs (fallback for old format)
            $('.base-price-input').each(function() {
                const input = $(this);
                const price = parseFloat(input.val()) || 0;
                const priceId = input.data('price-id');
                const rateId = input.data('rate-id');
                const vehicleId = input.data('vehicle-id');
                
                if (price > 0 && priceId) {
                    basePrices.push({
                        id: priceId,
                        rateId: rateId,
                        vehicleId: vehicleId,
                        price: price
                    });
                }
            });
            
            if (basePrices.length === 0 && newPrices.length === 0) {
                return; // No prices to save
            }
            
            try {
                const token = getAccessToken();
                let updatedCount = 0;
                let createdCount = 0;
                
                // Update existing prices if any
                if (basePrices.length > 0) {
                    const updateResponse = await fetch(`/api/services/${serviceId}/update-base-prices`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${token}`
                        },
                        body: JSON.stringify({
                            prices: basePrices
                        })
                    });
                    
                    if (!updateResponse.ok) {
                        throw new Error('Failed to update existing prices');
                    }
                    
                    const updateResult = await updateResponse.json();
                    updatedCount = updateResult.updatedCount || 0;
                }
                
                // Create new prices if any (using the bulk create approach)
                if (newPrices.length > 0) {
                    const createResponse = await fetch(`/api/services/${serviceId}/add-rate-prices`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${token}`
                        },
                        body: JSON.stringify({
                            prices: newPrices
                        })
                    });
                    
                    if (!createResponse.ok) {
                        // If add-rate-prices doesn't exist, we need to create it or use another approach
                        console.warn('add-rate-prices endpoint not available, skipping new price creation');
                    } else {
                        const createResult = await createResponse.json();
                        createdCount = createResult.created || newPrices.length;
                    }
                }
                
                const totalChanges = updatedCount + createdCount;
                if (totalChanges === 0) {
                    throw new Error('No prices were updated or created');
                }
                
                // Success - return the counts for reporting
                return { updated: updatedCount, created: createdCount };
                
            } catch (error) {
                throw error;
            }
        }

        async function saveService() {
            const form = $('#serviceForm');
            if (!form[0].checkValidity()) {
                form[0].reportValidity();
                return;
            }

            const serviceId = $('#serviceId').val();
            const isEdit = !!serviceId;
            
            // Add loader to button
            const $saveBtn = $('#saveServiceBtn');
            const originalBtnHtml = $saveBtn.html();
            $saveBtn.prop('disabled', true).html(`
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                Guardando...
            `);

            try {
                // Wait for Select instances
                const originTS = await waitForSelectInstance('originPOI');
                const destTS = await waitForSelectInstance('destinationPOI');

                // Get values from Tom Select
                const originPOI = originTS.getValue();
                const destinationPOI = destTS.getValue();

                // Validate origin !== destination (only if both exist)
                if (originPOI && destinationPOI && originPOI === destinationPOI) {
                    showErrorAlert('El origen y el destino deben ser diferentes');
                    return;
                }

                // For new services, prepare bulk creation data
                let serviceData;
                let url;
                let method;
                
                if (!isEdit) {
                    // Get pricing data from the grid
                    const pricingData = [];
                    let hasValidPrices = false;
                    
                    $('.service-price-input').each(function() {
                        const $input = $(this);
                        const price = parseFloat($input.val()) || 0;
                        
                        if (price > 0) {
                            hasValidPrices = true;
                            pricingData.push({
                                rateId: $input.data('rate-id'),
                                vehicleId: $input.data('vehicle-id'),
                                price: price
                            });
                        }
                    });
                    
                    if (!hasValidPrices) {
                        showModalError('Debes configurar al menos un precio mayor a 0 para crear el traslado');
                        $saveBtn.prop('disabled', false).html(originalBtnHtml);
                        return;
                    }
                    
                    // Transform pricing data to API format
                    const rateIds = [...new Set(pricingData.map(item => item.rateId))];
                    const vehicleIds = [...new Set(pricingData.map(item => item.vehicleId))];
                    
                    // Calculate default price (average of all prices)
                    const totalPrice = pricingData.reduce((sum, item) => sum + item.price, 0);
                    const defaultPrice = Math.round(totalPrice / pricingData.length);
                    
                    // Prepare bulk creation data with both formats for compatibility
                    serviceData = {
                        originPOI: originPOI || null,
                        destinationPOI: destinationPOI,
                        note: $('#note').val().trim(),
                        routeDuration: $('#routeDuration').val() ? parseInt($('#routeDuration').val()) : null,
                        rates: rateIds,
                        vehicleTypes: vehicleIds,
                        defaultPrice: defaultPrice,
                        pricingData: pricingData  // Include individual pricing data
                    };
                    
                    // Strip any query string (e.g. ?includeInactive=true) before appending
                    // the path, otherwise the URL is malformed and Express routes it to
                    // POST /api/services (single create) instead of /bulk-create.
                    url = `${apiEndpoint.split('?')[0]}/bulk-create`;
                    method = 'POST';
                } else {
                    // For editing, use existing single service data
                    serviceData = {
                        originPOI: originPOI || null,
                        destinationPOI: destinationPOI,
                        note: $('#note').val().trim(),
                        routeDuration: $('#routeDuration').val() ? parseInt($('#routeDuration').val()) : null,
                    };
                    
                    url = `${apiEndpoint.split('?')[0]}/${serviceId}`;
                    method = 'PUT';
                }

                $.ajax({
                    url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(serviceData),
                    beforeSend: function(xhr) {
                        const token = getAccessToken();
                        
                        console.log('Service creation - Token check:', {
                            tokenExists: !!token,
                            tokenLength: token ? token.length : 0,
                            tokenStart: token ? token.substring(0, 20) + '...' : 'null'
                        });
                        
                        if (token) {
                            xhr.setRequestHeader('Authorization', `Bearer ${token}`);
                        } else {
                            console.error('No access token available for service creation');
                            showModalError('Error de autenticación: Token no disponible. Por favor, recarga la página.');
                            $saveBtn.prop('disabled', false).html(originalBtnHtml);
                            return false;
                        }
                    },
                    success: async function(response) {
                        if (response.success) {
                            // If editing and base pricing section is visible, save base pricing
                            if (isEdit && $('#basePricingSection').is(':visible')) {
                                try {
                                    await saveBasePricing(serviceId);
                                } catch (error) {
                                    showModalError('Servicio guardado, pero error al actualizar precios base: ' + error.message);
                                    return;
                                }
                            }
                            
                            $('#serviceModal').modal('hide');
                            
                            // Function to show loading indicator
                            function showLoadingIndicator(message) {
                                const container = document.getElementById('services-content');
                                if (container) {
                                    container.querySelectorAll('.alert').forEach(el => el.remove());
                                    const alertHtml = `
                                        <div class="alert alert-info alert-dismissible fade show loading-alert" role="alert">
                                            <i class="ti ti-loader-2 spinner-border spinner-border-sm me-2"></i>
                                            ${message}
                                        </div>
                                    `;
                                    container.insertAdjacentHTML('afterbegin', alertHtml);
                                }
                            }
                            
                            // Function to hide loading indicator
                            function hideLoadingIndicator() {
                                document.querySelectorAll('.loading-alert').forEach(el => el.remove());
                            }
                            
                            // For edits with price updates, try targeted row update first
                            if (isEdit && serviceId) {
                                showLoadingIndicator('Actualizando fila...');
                                
                                try {
                                    // If we saved pricing, wait a bit for the versioning to complete on the backend
                                    if ($('#basePricingSection').is(':visible')) {
                                        await new Promise(resolve => setTimeout(resolve, 1000)); // Wait 1 second
                                    }
                                    
                                    const rowUpdated = await updateServiceRowWithPrices(serviceId);
                                    
                                    hideLoadingIndicator();
                                    
                                    if (rowUpdated) {
                                        const successMessage = $('#basePricingSection').is(':visible') 
                                            ? 'Traslado y precios actualizados exitosamente' 
                                            : 'Traslado actualizado exitosamente';
                                        showSuccessAlert(successMessage);
                                    } else {
                                        showLoadingIndicator('Actualizando tabla...');
                                        await initializeTable();
                                        hideLoadingIndicator();
                                        showSuccessAlert('Traslado y precios actualizados exitosamente');
                                    }
                                } catch (error) {
                                    hideLoadingIndicator();
                                    showLoadingIndicator('Actualizando tabla...');
                                    try {
                                        await initializeTable();
                                        hideLoadingIndicator();
                                        showSuccessAlert('Traslado y precios actualizados exitosamente');
                                    } catch (fallbackError) {
                                        hideLoadingIndicator();
                                        showErrorAlert('Error al actualizar la tabla: ' + fallbackError.message);
                                    }
                                }
                            } else {
                                // For new services, reload the entire table
                                showLoadingIndicator('Actualizando tabla...');
                                
                                try {
                                    await initializeTable();
                                    hideLoadingIndicator();
                                    // Use the actual created count from response or from pricingData
                                    const actualCreated = response.data && response.data.created 
                                        ? response.data.created 
                                        : (serviceData.pricingData ? serviceData.pricingData.length : 1);
                                    const message = `1 traslado creado exitosamente con ${actualCreated} tarifas`;
                                    showSuccessAlert(message);
                                } catch (error) {
                                    hideLoadingIndicator();
                                    showErrorAlert('Error al actualizar la tabla: ' + error.message);
                                }
                            }
                        }
                    },
                    error: function(xhr) {
                        let errorMessage = 'Error al guardar el traslado';

                        console.error('Service creation error:', {
                            status: xhr.status,
                            statusText: xhr.statusText,
                            responseText: xhr.responseText,
                            responseJSON: xhr.responseJSON,
                            errorType: typeof xhr.responseJSON?.error,
                            errorValue: xhr.responseJSON?.error
                        });

                        if (xhr.status === 401) {
                            errorMessage = 'Error de autenticación: Token inválido o expirado. Por favor, recarga la página e intenta de nuevo.';
                        } else if (xhr.responseJSON?.error) {
                            const error = xhr.responseJSON.error;
                            const errorStr = String(error); // Convert to string to safely use .includes()
                            
                            if (errorStr.includes('Invalid or malformed token')) {
                                errorMessage = 'Token de autenticación inválido. Por favor, recarga la página e intenta de nuevo.';
                            } else if (errorStr.includes('already exists') || errorStr.includes('ya existe')) {
                                errorMessage = 'Ya existe un traslado con esta ruta, tipo de vehículo y tarifa.';
                            } else if (errorStr.includes('required')) {
                                errorMessage = 'Todos los campos requeridos deben ser completados.';
                            } else if (errorStr.includes('different') || errorStr.includes('diferentes')) {
                                errorMessage = 'El origen y destino deben ser diferentes.';
                            } else {
                                errorMessage = errorStr;
                            }
                        }

                        showModalError(errorMessage);
                        // Restore button state on error
                        $saveBtn.prop('disabled', false).html(originalBtnHtml);
                    },
                    complete: function() {
                        // Restore button state after success (modal will be hidden)
                        setTimeout(() => {
                            $saveBtn.prop('disabled', false).html(originalBtnHtml);
                        }, 500);
                    }
                });
            } catch (error) {
                showModalError('Error al obtener los valores del formulario');
                // Restore button state on error
                $saveBtn.prop('disabled', false).html(originalBtnHtml);
            }
        }

        function toggleServiceStatus(serviceId, currentStatus, origin, destination) {
            const newStatus = !currentStatus;
            const action = newStatus ? 'activar' : 'desactivar';
            const actionTitle = newStatus ? 'Activar' : 'Desactivar';
            const btnClass = newStatus ? 'btn-success' : 'btn-warning';

            // Create confirmation modal
            const modalHtml = `
                <div class="modal fade" id="confirmToggleServiceModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">${actionTitle} Traslado</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p>¿Estás seguro de que deseas ${action} el traslado <strong>"${origin} → ${destination}"</strong>?</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn ${btnClass}" id="confirmToggleServiceBtn">${actionTitle}</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            $('#confirmToggleServiceModal').remove();

            // Add modal to body
            $('body').append(modalHtml);

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('confirmToggleServiceModal'));
            modal.show();

            // Handle confirmation
            $('#confirmToggleServiceBtn').on('click', function() {
                $.ajax({
                    url: `${apiEndpoint.split('?')[0]}/${serviceId}/toggle-status`,
                    type: 'PATCH',
                    contentType: 'application/json',
                    data: JSON.stringify({ active: newStatus }),
                    success: function(response) {
                        if (response.success) {
                            modal.hide();
                            // Reload all data and refresh current filter
                            initializeTable();
                            showAlert('success', `Traslado ${newStatus ? 'activado' : 'desactivado'} exitosamente`);
                        } else {
                            modal.hide();
                            showAlert('danger', response.error || 'Error desconocido');
                        }
                    },
                    error: function(xhr) {
                        modal.hide();
                        const error = xhr.responseJSON?.error || 'Error al cambiar el estado del traslado';
                        showAlert('danger', error);
                    }
                });
            });
        }

        function toggleServicePopular(serviceId, currentPopular, routeName, btnEl) {
            // data-current-popular arrives as boolean or the string "true"/"false"
            const isPopular = currentPopular === true || currentPopular === 'true';
            const newPopular = !isPopular;

            // Loader: swap the heart for a spinner and lock the button while it saves.
            const $btn = btnEl ? $(btnEl) : null;
            let originalHtml = null;
            if ($btn && !$btn.prop('disabled')) {
                originalHtml = $btn.html();
                $btn.prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width:14px;height:14px;"></span>');
            }
            const restoreBtn = function() {
                if ($btn && originalHtml !== null) {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            };

            $.ajax({
                url: `${apiEndpoint.split('?')[0]}/${serviceId}/popular`,
                type: 'PATCH',
                contentType: 'application/json',
                data: JSON.stringify({ popular: newPopular }),
                success: function(response) {
                    if (response.success) {
                        // initializeTable redraws with fresh data (heart color updates).
                        initializeTable();
                        showAlert('success', newPopular
                            ? `"${routeName}" marcado como popular`
                            : `"${routeName}" removido de populares`);
                    } else {
                        restoreBtn();
                        showAlert('danger', response.error || 'Error al actualizar el estado popular');
                    }
                },
                error: function(xhr) {
                    restoreBtn();
                    const error = xhr.responseJSON?.error || 'Error al actualizar el estado popular';
                    showAlert('danger', error);
                }
            });
        }

