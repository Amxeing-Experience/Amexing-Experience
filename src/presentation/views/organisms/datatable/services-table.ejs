                            const includeGreeter = $(`#greeterToggle-${tableId}`).is(':checked');
                            const currentPaymentType = $(`#paymentTypeFilter-${tableId}`).val();
                            const currentCurrency = $(`#currencyFilter-${tableId}`).val();
                            
                            let routeDuration = 0;
                            
                            // Find duration from the parent row's 3rd column
                            const durationText = row.find('td:nth-child(3)').text();
                            
                            // Handle different duration formats: "1h 45min", "45 min", "105 min", etc.
                            const hoursMatch = durationText.match(/(\d+)\s*h/i);
                            const minutesMatch = durationText.match(/(\d+)\s*min/i);
                            
                            let totalMinutes = 0;
                            if (hoursMatch) {
                                totalMinutes += parseInt(hoursMatch[1]) * 60;
                            }
                            if (minutesMatch) {
                                totalMinutes += parseInt(minutesMatch[1]);
                            }
                            
                            // If no hours/minutes format found, try to get just a number (assuming minutes)
                            if (totalMinutes === 0) {
                                const simpleMatch = durationText.match(/(\d+(?:\.\d+)?)/);
                                if (simpleMatch) {
                                    totalMinutes = parseFloat(simpleMatch[1]);
                                }
                            }
                            
                            // Convert to hours
                            routeDuration = totalMinutes / 60;
                            
                            // Calculate guide cost if needed
                            let guideCost = 0;
                            if (includeGuide && currentGuideRate > 0 && routeDuration > 0) {
                                guideCost = routeDuration * 2 * currentGuideRate; // Fallback
                                
                                // Use formula evaluator if available
                                if (typeof GuideFormulaEvaluator !== 'undefined' && GuideFormulaEvaluator.formulaConfig) {
                                    const config = GuideFormulaEvaluator.formulaConfig;
                                    if (config.formulaComponents && config.formulaComponents.length > 0) {
                                        guideCost = GuideFormulaEvaluator.evaluateComponents(config.formulaComponents, routeDuration * 60, currentGuideRate);
                                        if (isDevelopment) {
                                            console.log(`📊 [Render] Custom formula: ${routeDuration}h @ $${currentGuideRate}/hr = $${guideCost}`);
                                        }
                                    } else if (config.roundTripMultiplier) {
                                        guideCost = routeDuration * config.roundTripMultiplier * currentGuideRate;
                                        if (isDevelopment) {
                                            console.log(`📊 [Render] Simple formula: ${routeDuration}h × ${config.roundTripMultiplier} × $${currentGuideRate} = $${guideCost}`);
                                        }
                                    }
                                }
                            }
                            
                            // Calculate greeter cost if needed
                            let greeterCost = 0;
                            if (includeGreeter && routeDuration > 0) {
                                // Calculate greeter cost using formula based on duration
                                greeterCost = calculateGreeterPrice(routeDuration);
                            }
                            
                            
                            // Generate card-based HTML for all rates
                            let allRatesHtml = '<div class="row g-3 mt-2">';
                            
                            Object.keys(pricesByRate).sort().forEach(rateName => {
                                const prices = pricesByRate[rateName];
                                
                                // Get rate color from the first price item (all items have same rate)
                                const rateColor = prices[0]?.rate?.color || '#6c757d';
                                
                                // Generate light background color from rate color
                                const bgColor = rateColor + '15'; // Add alpha transparency
                                
                                // Calculate base price (lowest price)
                                const basePrice = Math.min(...prices.map(p => p.price || 0));
                                
                                // Generate vehicle options (sorted by price low to high)
                                const sortedPrices = [...prices].sort((a, b) => (a.price || 0) - (b.price || 0));
                                const vehicleOptionsHtml = sortedPrices.map(p => {
                                    const vehicleCode = p.vehicleType?.code || 'N/A';
                                    const vehicleName = p.vehicleType?.name || 'Vehículo';
                                    
                                    // Start with base price (don't apply payment rates yet)
                                    const basePrice = p.price;
                                    
                                    // Calculate total with additional costs
                                    const additionalCosts = guideCost + greeterCost;
                                    let subtotal = basePrice + additionalCosts;
                                    
                                    // Apply special rounding if greeter is included
                                    if (includeGreeter && greeterCost > 0) {
                                        subtotal = applySpecialRounding(subtotal);
                                    }
                                    
                                    // Apply cash rounding for efectivo payments
                                    if (currentPaymentType === 'efectivo' && typeof window.PricingUtils !== 'undefined' && 
                                        window.PricingUtils.applyCashRounding && window.PricingUtils.isCashRoundingEnabledSync()) {
                                        subtotal = window.PricingUtils.applyCashRounding(subtotal);
                                    }
                                    
                                    // Format as price string
                                    let finalPrice = `$${subtotal.toLocaleString()} MXN`;
                                    
                                    // NOW apply payment type rates to the TOTAL
                                    let hasPaymentRate = false;
                                    if (currentPaymentType === 'transferencia') {
                                        finalPrice = applyTransferRate(finalPrice);
                                        hasPaymentRate = true;
                                    } else if (currentPaymentType === 'tarjeta') {
                                        finalPrice = applyAgencyRate(finalPrice);
                                        hasPaymentRate = true;
                                    }
                                    
                                    // Always apply currency conversion for consistent decimal display
                                    finalPrice = applyCurrencyConversion(finalPrice, currentCurrency);
                                    
                                    
                                    // Get capacity info from database
