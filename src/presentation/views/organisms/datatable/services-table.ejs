<% if (isDepartmentManager || isClient) { %>
<!-- Add to Quote — modal + módulo genérico compartido -->
<%- include('../quotes/add-to-quote-modal') %>
<script src="/dashboard/js/utils/add-to-quote.js"></script>
<script>
(function() {
    // Tarifas para MOSTRAR el precio con el recargo del método de pago del catálogo (solo display).
    // Lo GUARDADO sigue siendo base efectivo; pricesByType lo resuelve en la cotización.
    let _atqRates = { transferRate: 0, agencyRate: 0 };
    if (window.PricingUtils && typeof PricingUtils.loadCurrentRates === 'function') {
        PricingUtils.loadCurrentRates().then(function (r) { if (r) _atqRates = r; }).catch(function () {});
    }
    function catalogSurchargedMXN(baseTotal) {
        const pt = (document.getElementById('paymentTypeFilter-<%= dtTableId %>') || {}).value || 'efectivo';
        if (window.PricingUtils && typeof PricingUtils.applyPaymentRate === 'function') {
            return PricingUtils.applyPaymentRate(Number(baseTotal) || 0, pt, _atqRates.transferRate, _atqRates.agencyRate);
        }
        return Number(baseTotal) || 0;
    }

    // Payload específico de Traslados (lo único propio de esta superficie)
    function buildSvcSubconcept(s) {
        return {
            type: 'transport',
            transferId: s.serviceId,
            concept: (s.origin && s.destination) ? s.origin + ' → ' + s.destination : (s.destination || 'Traslado'),
            vehicleTypeId: s.vehicleId,
            vehicleType: s.vehicleName,
            vehicleCapacity: s.vehicleCapacity,
            vehiclePassengerCapacity: s.vehicleCapacity,
            vehicleTrunkCapacity: s.trunkCapacity,
            unitPrice: s.price,
            basePrice: s.price,
            total: s.price,
            time: '',
            hours: 0,
            numberOfPeople: 1,
            notes: ''
        };
    }

    // Add to Quote desde el botón de la tabla (celda de precio)
    document.addEventListener('click', function(e) {
        const btn = e.target.closest('.add-svc-to-quote-btn');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        const ds = btn.dataset;
        const svc = {
            serviceId: ds.serviceId,
            vehicleName: ds.vehicleName,
            vehicleId: ds.vehicleId,
            vehicleCapacity: parseInt(ds.vehicleCapacity) || 4,
            trunkCapacity: parseInt(ds.trunkCapacity) || 2,
            price: parseFloat(ds.price) || 0,
            origin: ds.origin || '',
            destination: ds.destination || '',
            rateName: ds.rateName || '',
            routeDuration: parseInt(ds.routeDuration) || 0
        };
        const routeLabel = (svc.origin && svc.destination) ? svc.origin + ' → ' + svc.destination : (svc.destination || 'Traslado');
        const priceFormatted = catalogSurchargedMXN(svc.price || 0).toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
        AddToQuote.open({
            userRole: '<%= userRole %>',
            serviceLabel: 'Traslado',
            itemLabel: '<strong>' + routeLabel + '</strong><br><span class="small">' + (svc.vehicleName || '') + ' · $' + priceFormatted + ' MXN</span>',
            buildSubconcept: function() { return buildSvcSubconcept(svc); }
        });
    });
})();
</script>
<% } %>
