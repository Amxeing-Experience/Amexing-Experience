        // Load all active greeter services from API
        function loadCurrentGreeterServices() {
            return $.ajax({
                url: '/api/greeter',
                type: 'GET',
                data: {
                    // Only get active services, no pagination (get all)
                    length: -1,
                    start: 0
                },
                beforeSend: function(xhr) {
                    const token = getAccessToken();
                    if (token) {
                        xhr.setRequestHeader('Authorization', `Bearer ${token}`);
                    }
                },
                success: function(response) {
                    if (response.success && response.data && Array.isArray(response.data)) {
                        // Filter only active services and store globally
                        currentGreeterServices = response.data.filter(greeter => greeter.active === true);
                    } else {
                        currentGreeterServices = [];
                    }
                },
                error: function(xhr, status, error) {
                    currentGreeterServices = [];
                }
            });
        }
        
        // Helper function to find greeter services by POI
        function findGreeterServicesByPOI(poiId) {
            if (!poiId || !currentGreeterServices || currentGreeterServices.length === 0) {
                return [];
            }
            
            return currentGreeterServices.filter(greeter => {
                return greeter.poi && greeter.poi.id === poiId;
            });
        }
        
        // Helper function to get greeter service by specific POI and optional criteria
        function getGreeterServiceForPOI(poiId, criteria = {}) {
            const services = findGreeterServicesByPOI(poiId);
            
            if (services.length === 0) {
                return null;
            }
            
            // If no criteria, return the first service
            if (Object.keys(criteria).length === 0) {
                return services[0];
            }
            
            // Apply criteria (e.g., minimum price, maximum price, etc.)
            let filteredServices = services;
            
            if (criteria.minPrice) {
                filteredServices = filteredServices.filter(s => s.price >= criteria.minPrice);
            }
            
            if (criteria.maxPrice) {
                filteredServices = filteredServices.filter(s => s.price <= criteria.maxPrice);
            }
            
            return filteredServices.length > 0 ? filteredServices[0] : null;
        }

