                    url += `${separator}rateId=${selectedRate}`;
                } else {
                }
                
                // Add clientId parameter if available and not already in URL
                let finalClientId = null;
                
                // Check if clientId is already in the apiEndpoint
                const urlObj = new URL(url, window.location.origin);
                const existingClientId = urlObj.searchParams.get('clientId');
                
                if (existingClientId) {
                    finalClientId = existingClientId;
                } else {
                    // Priority 1: URL params (for admin viewing specific client)
                    const pageUrlParams = new URLSearchParams(window.location.search);
                    const urlClientId = pageUrlParams.get('clientId');
                    
                    // Priority 2: Path segments (for admin viewing client details)
                    let pathClientId = null;
                    const pathSegments = window.location.pathname.split('/');
                    if (pathSegments.includes('clients') && pathSegments.length > pathSegments.indexOf('clients') + 1) {
                        pathClientId = pathSegments[pathSegments.indexOf('clients') + 1];
                    }
                    
                    // Priority 3: Template clientId (for Department Manager using their own ID)
                    const templateClientId = clientId;
                    
                    // Use the first available clientId in priority order
                    finalClientId = urlClientId || pathClientId || templateClientId;
                    
                    if (finalClientId) {
                        const separator = url.includes('?') ? '&' : '?';
                        url += `${separator}clientId=${finalClientId}`;
                    }
                }
                
                
                // Add aggressive cache-busting parameters to force fresh data
                const separator = url.includes('?') ? '&' : '?';
                const timestamp = Date.now();
                const random = Math.random().toString(36).substr(2, 9);
                url += `${separator}_t=${timestamp}&_r=${random}&_cb=${new Date().getTime()}`;
                
                
                $.ajax({
                    url: url,
                    type: 'GET',
                    cache: false, // Disable jQuery cache
