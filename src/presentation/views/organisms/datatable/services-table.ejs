<%
/**
 * Service DataTable Organism
 * DataTable component for transportation service management
 *
 * Atomic Design Level: Organism
 * Category: Dashboard Data Tables
 *
 * @param {string} tableId - Unique table identifier
 * @param {string} apiEndpoint - API endpoint for data loading
 * @param {string} userRole - Current user role
 * @param {boolean} showActions - Whether to show action buttons
 */

const dtTableId = typeof tableId !== 'undefined' ? tableId : 'services-table';
const dtApiEndpoint = typeof apiEndpoint !== 'undefined' ? apiEndpoint : '/api/services';
const dtShowActions = typeof showActions !== 'undefined' ? showActions : true;
const dtUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const dtShowClientPricing = typeof showClientPricing !== 'undefined' ? showClientPricing : false;
const dtClientId = typeof clientId !== 'undefined' ? clientId : null;
const dtIsDevelopment = typeof isDevelopment !== 'undefined' ? isDevelopment : false;

const canEdit = ['superadmin', 'admin'].includes(dtUserRole);
const canDelete = ['superadmin', 'admin'].includes(dtUserRole);
const canCreate = ['superadmin', 'admin'].includes(dtUserRole);
const isDepartmentManager = dtUserRole === 'department_manager';
const isClient = dtUserRole === 'client';
%>

<style>
/* Global font size increase for all datatable elements */
#<%= dtTableId %>,
#<%= dtTableId %>_wrapper {
    font-size: 0.95rem !important; /* Increased from default ~0.875rem */
}

#<%= dtTableId %> thead th,
#<%= dtTableId %> tbody td {
    font-size: 0.95rem !important; /* Increased for table headers and cells */
}

#<%= dtTableId %> .small {
    font-size: 0.9rem !important; /* Increased from ~0.75rem */
}

#<%= dtTableId %> .badge {
    font-size: 0.85rem !important; /* Increased badge font size */
}

/* DataTable controls (pagination, search, etc.) */
#<%= dtTableId %>_wrapper .dataTables_length,
#<%= dtTableId %>_wrapper .dataTables_filter,
#<%= dtTableId %>_wrapper .dataTables_info,
#<%= dtTableId %>_wrapper .dataTables_paginate {
    font-size: 0.95rem !important;
}

/* Hide default DataTables sorting icons */
.dt-control::before,
.dt-control::after {
    display: none !important;
}

/* Custom styling for price column */
.price-expand-container {
    text-align: left;
}

/* Hide any default sorting indicators and disable cursor */
table.dataTable thead .sorting::before,
table.dataTable thead .sorting::after,
table.dataTable thead .sorting_asc::before,
table.dataTable thead .sorting_asc::after,
table.dataTable thead .sorting_desc::before,
table.dataTable thead .sorting_desc::after {
    display: none !important;
}

/* Disable cursor and make headers non-clickable */
#<%= dtTableId %> thead th {
    cursor: default !important;
    pointer-events: none; /* Disable all mouse events on headers */
}

/* Re-enable events on dropdown in header */
#<%= dtTableId %> thead th select {
    pointer-events: all !important;
}

/* Guide Toggle Styling */
#driverToggle-<%= dtTableId %> {
    transform: scale(1.1);
}

#driverToggle-<%= dtTableId %>:checked {
    background-color: #10b981;
    border-color: #10b981;
}

#driverToggle-<%= dtTableId %>:focus {
    box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.25);
    border-color: #10b981;
}

#driverLabel-<%= dtTableId %> {
    font-weight: 500;
    transition: color 0.2s ease;
}

#driverToggle-<%= dtTableId %>:checked + #driverLabel-<%= dtTableId %> {
    color: #10b981 !important;
}

/* Greeter Toggle Styling */
#greeterToggle-<%= dtTableId %> {
    transform: scale(1.1);
}

#greeterToggle-<%= dtTableId %>:checked {
    background-color: #8b5cf6;
    border-color: #8b5cf6;
}

#greeterToggle-<%= dtTableId %>:focus {
    box-shadow: 0 0 0 0.25rem rgba(139, 92, 246, 0.25);
}

#greeterLabel-<%= dtTableId %> {
    font-weight: 500;
    transition: color 0.15s ease-in-out;
}

#greeterToggle-<%= dtTableId %>:checked + #greeterLabel-<%= dtTableId %> {
    color: #8b5cf6 !important;
}

/* Ensure only our button shows */
td.dt-control {
    position: relative;
}

/* Remove DataTables default row hover effect */
table.dataTable tbody tr:hover,
table.dataTable tbody tr.hover {
    background-color: transparent !important;
}

/* Add hover effect specifically to expand button */
.expand-btn:hover {
    background-color: rgba(0, 123, 255, 0.1) !important;
    border-radius: 4px !important;
    transform: scale(1.05);
    transition: all 0.2s ease;
}

.expand-btn:hover i,
.expand-btn:hover small {
    color: #0d6efd !important;
}

/* Smooth transition for expand button */
.expand-btn {
    transition: all 0.2s ease;
}

/* Custom styling for nav pills with borders */
.nav-pills .nav-link {
    border: 1px solid #dee2e6;
    color: #6c757d;
    background-color: transparent;
    margin-right: 0.25rem;
    transition: all 0.2s ease;
}

.nav-pills .nav-link:hover {
    border-color: #10b981;
    color: #10b981;
    background-color: rgba(16, 185, 129, 0.1);
}

.nav-pills .nav-link.active {
    border-color: #10b981;
    background-color: #10b981;
    color: white;
}

/* Price column styling */
.price-container {
    text-align: left;
}

.price-container .badge {
    font-size: 0.7rem;
    padding: 0.25rem 0.4rem;
}

.price-container .small {
    margin-bottom: 0.2rem;
}

/* Make dropdown clickable in header */
[id^="headerRateFilter-"] {
    pointer-events: all !important;
    z-index: 1000;
    position: relative;
    width: 100% !important;
}

/* Prevent DataTables from interfering with dropdown container */
table.dataTable thead th:nth-child(2) div {
    pointer-events: none;
}

table.dataTable thead th:nth-child(2) select {
    pointer-events: all !important;
}
</style>

<style>
/* Rediseño de header/filtros estilo catálogo (limpio, sin card blanca). Solo UI: se conservan
   todos los ids/clases/handlers (.filter-pill+data-filter, driverToggle/greeterToggle, selects). */
.exp-catalog {
    --exp-border: #d6d1c4; --exp-olive: #6E7A50; --exp-olive-light: #7C8A5A;
    --exp-muted: #8a8f78; --exp-dark: #2b2b2b;
}
.traslados-new-btn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--exp-olive); background: var(--exp-olive); color: #fff; border-radius: 8px; font-size: 0.82rem; font-weight: 600; padding: 9px 16px; cursor: pointer; transition: all 0.15s; }
.traslados-new-btn:hover { background: var(--exp-olive-light); border-color: var(--exp-olive-light); color: #fff; }
.exp-catalog .segbar { display: flex; justify-content: space-between; align-items: center; gap: 18px 28px; flex-wrap: wrap; margin-bottom: 18px; }
.exp-catalog .segbar__left { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; }
.exp-catalog .segbar__right { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
/* thead sobrio (crema/versalita), igual que la tabla de clientes */
.exp-catalog .table > thead.table-light th { background: rgba(228, 223, 207, 0.35); border-bottom: 1px solid var(--exp-border); color: var(--exp-muted); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; vertical-align: middle; }
.exp-catalog .table > thead.table-light th .form-select { text-transform: none; letter-spacing: normal; font-size: 0.9rem; color: var(--exp-dark); font-weight: 400; }
.exp-catalog .segwrap { display: flex; align-items: center; gap: 10px; }
.exp-catalog .seglabel { font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--exp-muted); font-weight: 600; }
.exp-catalog .seg { display: inline-flex; border: 1px solid var(--exp-border); border-radius: 6px; overflow: hidden; background: rgba(255,255,255,0.4); }
.exp-catalog .seg .filter-pill { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; border: none; background: transparent; color: var(--exp-dark); padding: 9px 16px; cursor: pointer; transition: all 0.15s; }
.exp-catalog .seg .filter-pill + .filter-pill { border-left: 1px solid var(--exp-border); }
.exp-catalog .seg .filter-pill:hover:not(.active) { background: rgba(110,122,80,0.08); }
.exp-catalog .seg .filter-pill.active { background: var(--exp-olive); color: #fff; }
.exp-catalog .segwrap .form-check { margin: 0; min-height: auto; }
.exp-catalog .segwrap .form-check-label { font-size: 0.78rem; color: var(--exp-dark); }
.exp-catalog .exp-field { position: relative; min-width: 150px; }
.exp-catalog .exp-field select { width: 100%; font-size: 0.9rem; color: var(--exp-dark); background: rgba(255,255,255,0.45); border: 1px solid var(--exp-border); border-radius: 6px; padding: 11px 38px 11px 14px; appearance: none; -webkit-appearance: none; outline: none; }
.exp-catalog .exp-field select:focus { border-color: var(--exp-olive); background: #fff; }
.exp-catalog .exp-field__caret { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--exp-muted); pointer-events: none; font-size: 0.9rem; }
.svc-popular-badge { display: inline-flex; align-items: center; gap: 4px; background: #e11d1d; color: #fff; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; }
.svc-popular-badge i { font-size: 0.72rem; }
</style>

<div class="exp-catalog">
    <!-- Barra de filtros: Tipo + Guía/Greeter (izquierda) · Moneda + Pago (derecha) -->
    <div class="segbar">
        <div class="segbar__left">
            <div class="segwrap">
                <span class="seglabel">Tipo</span>
                <div class="seg">
                    <button type="button" class="filter-pill active" data-filter="airport">Aeropuerto</button>
                    <button type="button" class="filter-pill" data-filter="p2p">Punto a Punto</button>
                    <button type="button" class="filter-pill" data-filter="local">Local</button>
                </div>
            </div>
            <div class="segwrap">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="driverToggle-<%= dtTableId %>">
                    <label class="form-check-label" for="driverToggle-<%= dtTableId %>" id="driverLabel-<%= dtTableId %>">Sin Guía</label>
                </div>
            </div>
            <div class="segwrap">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="greeterToggle-<%= dtTableId %>">
                    <label class="form-check-label" for="greeterToggle-<%= dtTableId %>" id="greeterLabel-<%= dtTableId %>">Sin Greeter</label>
                </div>
            </div>
            <% if (typeof endClientCaps === 'undefined' || !endClientCaps || endClientCaps.catalogScope !== 'popular') { %>
            <div class="segwrap">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="popularToggle-<%= dtTableId %>">
                    <label class="form-check-label" for="popularToggle-<%= dtTableId %>" id="popularLabel-<%= dtTableId %>">
                        <i class="ti ti-heart-filled" style="color:#e11d1d;"></i> Solo populares
                    </label>
                </div>
            </div>
            <% } %>
        </div>
        <div class="segbar__right">
            <div class="exp-field exp-field--select">
                <select id="currencyFilter-<%= dtTableId %>">
                    <option value="MXN" selected>MXN</option>
                    <option value="USD">USD</option>
                </select>
                <i class="ti ti-chevron-down exp-field__caret"></i>
            </div>
            <div class="exp-field exp-field--select">
                <select id="paymentTypeFilter-<%= dtTableId %>">
                    <% if (isDepartmentManager || isClient) { %>
                        <option value="efectivo">Efectivo</option>
                        <option value="transferencia" selected>Transferencia</option>
                    <% } else { %>
                        <option value="efectivo" selected>Efectivo</option>
                        <option value="transferencia">Transferencia</option>
                    <% } %>
                    <option value="tarjeta">Tarjeta Débito/Crédito</option>
                </select>
                <i class="ti ti-chevron-down exp-field__caret"></i>
            </div>
        </div>
    </div>

    <!-- Include Generic Guide Formula Evaluator -->
    <script src="/js/guide-formula-evaluator.js"></script>

    <div class="table-responsive" id="services-content">
        <table id="<%= dtTableId %>" class="table table-hover" style="width:100%">
            <thead class="table-light">
                <tr>
                    <th style="width: 25%;">Ruta (One-way trip)</th>
                    <th style="width: 30%; min-width: 250px;">
                        <div class="text-center mb-1" style="font-size: 0.875rem; font-weight: 500;">
                            Seleccionar categoría...
                        </div>
                        <select class="form-select" id="headerRateFilter-<%= dtTableId %>" style="min-width: 120px; width: 100%;">
                        </select>
                    </th>
                    <th style="width: 15%;">Duración de Trayecto</th>
                    <th style="width: 20%;">Notas</th>
                    <% if (!isDepartmentManager && !isClient) { %>
                    <th style="width: 15%;">Estado</th>
                    <% } %>
                    <% if (dtShowClientPricing) { %>
                        <th class="text-center" style="width: 15%;">Precio Cliente</th>
                    <% } %>
                    <% if (dtShowActions) { %>
                        <th class="text-center" style="width: 15%;">Acciones</th>
                    <% } %>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Service Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-labelledby="serviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="serviceModalLabel">
                    <i class="ti ti-briefcase me-2"></i><span id="modalTitle">Crear Nuevo Traslado</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Alert container for modal-specific errors -->
                <div id="serviceModalAlerts"></div>

                <form id="serviceForm">
                    <input type="hidden" id="serviceId">

                    <!-- Sección: Información de Ruta -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-route me-1"></i>
                            Información de Ruta
                        </h6>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <%- include('../../atoms/common/tom-select', {
                                    id: 'originPOI',
                                    name: 'originPOI',
                                    multiple: false,
                                    placeholder: 'Sin origen (traslado local)',
                                    label: 'Origen',
                                    required: false,
                                    helpText: 'Punto de inicio (opcional para traslados locales)',
                                    options: [],
                                    selected: []
                                }) %>
                            </div>

                            <div class="col-md-6 mb-3">
                                <%- include('../../atoms/common/tom-select', {
                                    id: 'destinationPOI',
                                    name: 'destinationPOI',
                                    multiple: false,
                                    placeholder: 'Seleccionar destino',
                                    label: 'Destino',
                                    required: true,
                                    helpText: 'Punto final del traslado',
                                    options: [],
                                    selected: []
                                }) %>
                            </div>
                        </div>
                        
                        <!-- Route Duration Field -->
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label for="routeDuration" class="form-label">
                                    <i class="ti ti-clock me-1"></i>Duración del Trayecto
                                </label>
                                <div class="input-group">
                                    <input type="number" 
                                           class="form-control" 
                                           id="routeDuration" 
                                           name="routeDuration" 
                                           min="0" 
                                           step="5"
                                           placeholder="Ejemplo: 90 para 1h 30min">
                                    <span class="input-group-text">minutos</span>
                                </div>
                                <div class="form-text">Tiempo estimado del trayecto en minutos (opcional)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Sección: Precios Base por Tarifa -->
                    <div class="mb-4" id="basePricingSection" style="display: none;">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-currency-dollar me-1"></i>
                            Precios Base por Tarifa
                        </h6>
                        
                        <div class="alert alert-warning d-flex align-items-start mb-3" role="alert">
                            <i class="ti ti-alert-triangle me-2 fs-5 mt-1"></i>
                            <div>
                                <strong>Importante:</strong>
                                <p class="mb-0 mt-1">Estos son los precios base del servicio. Los cambios afectarán a todos los clientes que no tengan precios personalizados.</p>
                            </div>
                        </div>

                        <div id="basePricesContainer">
                            <!-- Base prices will be dynamically loaded here -->
                        </div>
                    </div>
                    
                    <!-- Sección: Precios por Tarifa y Tipo de Vehículo para Nuevo Traslado -->
                    <div class="mb-4" id="newServiceRatesSection" style="display: none;">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-currency-dollar me-1"></i>
                            Precios por Tarifa y Tipo de Vehículo
                        </h6>
                        
                        <div class="alert alert-info d-flex align-items-start mb-3" role="alert">
                            <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                            <div>
                                <strong>Configure los precios específicos para cada combinación:</strong>
                                <p class="mb-0 mt-1">Configure los precios específicos para cada combinación de tarifa y vehículo. Dejar en 0 el vehículo que no aplica para la tarifa.</p>
                            </div>
                        </div>
                        
                        <div id="newServicePricesContainer">
                            <!-- Pricing grid will be dynamically loaded here -->
                        </div>

                    </div>

                    <!-- Sección: Notas Adicionales -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-notes me-1"></i>
                            Notas Adicionales
                        </h6>

                        <div class="mb-3">
                            <label for="note" class="form-label">Nota</label>
                            <textarea class="form-control" id="note" name="note" rows="3" placeholder="Notas adicionales sobre el traslado..."></textarea>
                            <div class="form-text">Máximo 500 caracteres (opcional)</div>
                        </div>
                    </div>

                    <!-- Alert informativo -->
                    <div class="alert alert-info d-flex align-items-start" role="alert">
                        <i class="ti ti-info-circle me-2 fs-5 mt-1"></i>
                        <div>
                            <strong>Traslado:</strong>
                            <p class="mb-0 mt-1">Define una ruta específica con origen, destino, tipo de vehículo y precio. Este traslado estará disponible para reservaciones una vez activado.</p>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="saveServiceBtn">
                    <i class="ti ti-check me-1"></i><span id="saveButtonText">Crear Traslado</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Service Price History Modal -->
<div class="modal fade" id="servicePriceHistoryModal" tabindex="-1" aria-labelledby="servicePriceHistoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title text-white" id="servicePriceHistoryModalLabel">
                    <i class="ti ti-chart-line me-2"></i>Historial de Precios
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <h6 id="servicePriceHistoryServiceName" class="fw-semibold text-muted"></h6>
                </div>
                
                <!-- Loading State -->
                <div id="servicePriceHistoryLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando historial de precios...</span>
                    </div>
                    <p class="mt-2 text-muted">Cargando historial de precios...</p>
                </div>
                
                <!-- Error State -->
                <div id="servicePriceHistoryError" class="alert alert-danger d-none" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <span id="servicePriceHistoryErrorMessage">Error al cargar el historial de precios</span>
                </div>
                
                <!-- No Data State -->
                <div id="servicePriceHistoryNoData" class="text-center py-4 d-none">
                    <i class="ti ti-inbox display-4 text-muted"></i>
                    <p class="mt-2 text-muted">No hay historial de precios disponible para este traslado</p>
                </div>
                
                <!-- History Table -->
                <div id="servicePriceHistoryContent" class="d-none">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Fecha de Vigencia</th>
                                    <th>Precio</th>
                                    <th>Tipo de Vehículo</th>
                                    <th>Tarifa</th>
                                    <th>Válido Hasta</th>
                                    <th>Duración</th>
                                    <% if (!isDepartmentManager && !isClient) { %>
                                    <th>Estado</th>
                                    <% } %>
                                </tr>
                            </thead>
                            <tbody id="servicePriceHistoryTableBody">
                                <!-- Price history data will be populated here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Load centralized pricing utilities -->
<script src="/dashboard/js/utils/pricing-utils.js"></script>

<script>
(function() {
    // Development mode flag for debugging
    const isDevelopment = <%= dtIsDevelopment ? 'true' : 'false' %>;
    
    // Wait for DOM and all dependencies to be ready
    async function initWhenReady() {
        // Check if jQuery and DataTables are loaded
        if (typeof jQuery === 'undefined') {
            setTimeout(initWhenReady, 100);
            return;
        }

        if (!jQuery.fn.dataTable) {
            setTimeout(initWhenReady, 100);
            return;
        }

        // Wait for GuideFormulaEvaluator to be ready
        if (typeof GuideFormulaEvaluator !== 'undefined') {
            console.log('⏳ Waiting for guide formula to load...');
            try {
                await GuideFormulaEvaluator.ready();
                console.log('✅ Guide formula loaded, initializing services table');
            } catch (error) {
                console.warn('⚠️ Could not load guide formula, using defaults:', error);
            }
        } else {
            console.warn('⚠️ GuideFormulaEvaluator not available');
        }

        initServicesTable();
    }

    function initServicesTable() {
        const tableId = '<%= dtTableId %>';
        const apiEndpoint = '<%= dtApiEndpoint %>';
        const showActions = <%= dtShowActions %>;
        const showClientPricing = <%= dtShowClientPricing %>;
        const canEditServices = <%= canEdit ? 'true' : 'false' %>;
        const canDeleteServices = <%= canDelete ? 'true' : 'false' %>;
        const userRole = '<%= dtUserRole %>';
        const accessToken = '<%= accessToken || "" %>';
        const clientId = '<%= dtClientId || "" %>';
        
        // Debug: Log token and other variables
        console.log('Services table initialization:', {
            hasAccessToken: !!accessToken,
            accessTokenLength: accessToken ? accessToken.length : 0,
            userRole,
            clientId
        });

        // Greeter rate cache variables
        let greeterRateCache = null;
        let greeterRateCacheTime = null;
        const greeterRateCacheDuration = 5 * 60 * 1000; // 5 minutes cache
        
        // Function to manually refresh greeter cache (for testing/debugging)
        window.refreshDataTableGreeterCache = function() {
            console.log('🔄 Manually clearing DataTable greeter cache...');
            greeterRateCache = null;
            greeterRateCacheTime = null;
            return loadGreeterRateConfiguration();
        };
        
        // Load current greeter rate configuration from API
        function loadGreeterRateConfiguration() {
            return new Promise((resolve) => {
                // Check cache validity
                const now = Date.now();
                if (greeterRateCache && greeterRateCacheTime && 
                    (now - greeterRateCacheTime) < greeterRateCacheDuration) {
                    console.log('🔒 DataTable: Greeter rate cache still valid');
                    resolve(greeterRateCache);
                    return;
                }

                console.log('📥 DataTable: Loading greeter rate configuration...');
                $.ajax({
                    url: '/api/greeter-rate/formula',
                    type: 'GET',
                    headers: {
                        'Authorization': `Bearer ${accessToken}`,
                        'Content-Type': 'application/json'
                    },
                    success: function(response) {
                        console.log('📦 DataTable: Greeter rate API response:', response);
                        
                        if (response.success && response.data) {
                            greeterRateCache = {
                                basePrice: response.data.basePrice || 760,
                                hourlyRate: response.data.hourlyRate || 640
                            };
                            greeterRateCacheTime = now;
                            console.log('✅ DataTable: Greeter rate configuration loaded from API:', greeterRateCache);
                            resolve(greeterRateCache);
                        } else {
                            console.warn('⚠️ DataTable: API response missing data field, using defaults');
                            greeterRateCache = { basePrice: 760, hourlyRate: 640 };
                            greeterRateCacheTime = now;
                            resolve(greeterRateCache);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('❌ DataTable: Error loading greeter rate configuration:', error);
                        // Fallback to defaults
                        greeterRateCache = { basePrice: 760, hourlyRate: 640 };
                        greeterRateCacheTime = now;
                        resolve(greeterRateCache);
                    }
                });
            });
        }

        // Calculate greeter price using configurable rates
        // Formula: basePrice + (hourlyRate * duration)
        // Note: Special rounding now applied to final service total, not individual greeter calculation
        function calculateGreeterPrice(durationInHours) {
            // Use cached values or fallback to defaults
            const basePrice = greeterRateCache?.basePrice || 760;
            const hourlyRate = greeterRateCache?.hourlyRate || 640;
            const isUsingCache = !!greeterRateCache;
            
            // Validate duration
            if (!durationInHours || durationInHours <= 0) {
                console.log('🔍 DataTable: No duration, returning base price:', basePrice);
                return basePrice;
            }

            // Calculate final price using configurable formula (no rounding here)
            const finalPrice = basePrice + (hourlyRate * durationInHours);
            
            console.log('💰 DataTable: Greeter price calculated (unrounded):', {
                durationInHours,
                basePrice,
                hourlyRate,
                finalPrice,
                formula: `${basePrice} + (${hourlyRate} × ${durationInHours}h) = ${finalPrice}`,
                source: isUsingCache ? '[API]' : '[Default]'
            });
            
            return finalPrice;
        }

        // Apply special rounding logic to final service totals
        // Same logic as used in greeter calculation: if last two digits < 50, round down to nearest 100; otherwise round up
        function applySpecialRounding(rawPrice) {
            const integerPart = Math.floor(rawPrice);
            const lastTwoDigits = integerPart % 100;
            
            if (lastTwoDigits === 0) {
                return integerPart;
            } else if (lastTwoDigits < 50) {
                return Math.floor(integerPart / 100) * 100;
            } else {
                return Math.ceil(integerPart / 100) * 100;
            }
        }

