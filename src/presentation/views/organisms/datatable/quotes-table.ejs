        // Event Handlers

        // Status dropdown change
        let pendingSchedule = null;
        $(`#${tableId}`).on('change', '.status-selector', function() {
            const $select = $(this);
            const quoteId = $select.data('id');
            const quoteFolio = $select.data('folio');
            const newStatus = $select.val();
            const oldStatus = $select.data('previous-status') || 'requested';

            if (newStatus === 'requested' && oldStatus === 'quoted') {
                // Show confirmation modal when changing from COTIZADO to SOLICITADO
                pendingSchedule = { quoteId, quoteFolio, newStatus, oldStatus, $select };
                const email = $select.data('email') || '';
                const emailNote = document.getElementById('scheduleListEmailNote');
                const emailAddr = document.getElementById('scheduleListEmailAddress');
                if (email && emailNote && emailAddr) {
                    emailAddr.textContent = email;
                    emailNote.style.display = '';
                } else if (emailNote) {
                    emailNote.style.display = 'none';
                }
                const modal = new bootstrap.Modal(document.getElementById('confirmScheduleListModal'));
                modal.show();
            } else {
                $select.data('previous-status', newStatus);
                updateQuoteStatus(quoteId, quoteFolio, newStatus, oldStatus);
            }
        });

        // Track previous status on focus
        $(`#${tableId}`).on('focus', '.status-selector', function() {
            $(this).data('previous-status', $(this).val());
        });

        // Confirm schedule from list modal
        $(document).on('click', '#confirmScheduleListBtn', function() {
            if (pendingSchedule) {
                const { quoteId, quoteFolio, newStatus, oldStatus } = pendingSchedule;
                // Show loader
                const overlay = document.getElementById('scheduleListLoadingOverlay');
                const btn = document.getElementById('confirmScheduleListBtn');
                if (overlay) overlay.style.display = 'block';
                if (btn) btn.disabled = true;
                updateQuoteStatus(quoteId, quoteFolio, newStatus, oldStatus, true);
                pendingSchedule = null;
            }
        });

        // Revert on modal cancel
        $(document).on('hidden.bs.modal', '#confirmScheduleListModal', function() {
            if (pendingSchedule) {
                pendingSchedule.$select.val(pendingSchedule.oldStatus);
                pendingSchedule = null;
            }
            // Reset loader state
            const overlay = document.getElementById('scheduleListLoadingOverlay');
            const btn = document.getElementById('confirmScheduleListBtn');
            if (overlay) overlay.style.display = 'none';
            if (btn) btn.disabled = false;
        });

