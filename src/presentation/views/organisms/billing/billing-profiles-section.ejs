<%
/**
 * Billing Profiles Section Organism
 * Displays and manages multiple billing profiles for invoicing.
 * Reusable across department manager profile and admin views.
 * Created by Denisse Maldonado
 *
 * @param {string} userRole - Current user role (for conditional display)
 */

const billingUserRole = typeof userRole !== 'undefined' ? userRole : 'department_manager';
const billingReadOnly = typeof readOnly !== 'undefined' ? readOnly : false;
const billingTargetUserId = typeof targetUserId !== 'undefined' ? targetUserId : '';
// showHeader=false cuando la página ya provee su propio título de sección (p.ej. perfil).
const billingShowHeader = typeof showHeader !== 'undefined' ? showHeader : true;
%>

<style>
.billing-profile-card {
    transition: box-shadow 0.2s ease;
}
.billing-profile-card:hover {
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.12) !important;
}
.billing-profile-card .card-badge-primary {
    font-size: 0.7rem;
}
.billing-profile-card .profile-country-flag {
    font-size: 1.5rem;
    line-height: 1;
}
.billing-profile-card .profile-actions .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.8rem;
}
.billing-profile-card .profile-detail-label {
    font-size: 0.75rem;
    color: #6c757d;
    margin-bottom: 0;
}
.billing-profile-card .profile-detail-value {
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
}
.billing-mx-fields,
.billing-intl-fields,
.billing-colonia-field,
.billing-intl-postal-field,
.billing-constancia-section {
    display: none;
}
.billing-profile-documents-badge {
    font-size: 0.75rem;
}
#billingProfilesSpinner {
    min-height: 120px;
}
.billing-constancia-info {
    font-size: 0.8rem;
    background: #f8f9fa;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
}
.billing-additional-doc-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.5rem;
    background: #f8f9fa;
    border-radius: 0.25rem;
    margin-bottom: 0.25rem;
    font-size: 0.8rem;
}

/* ===== Look editorial (acordeón de perfiles) ===== */
.bp-editorial { --bp-olive:#6E7A50; --bp-olive-d:#566040; --bp-line:#ded9cb; --bp-panel:#faf9f4; --bp-ink:#2b2b2b; --bp-muted:#8a8f78; }
.bp-editorial .bp-header-title { text-transform:uppercase; letter-spacing:.2em; font-weight:600; color:var(--bp-ink); font-size:1rem; }
.bp-editorial .bp-header-sub { color:var(--bp-muted); font-style:italic; font-size:.9rem; margin-top:2px; }
.bp-accordion { display:flex; flex-direction:column; gap:14px; }
.bp-item { border:1px solid var(--bp-line); border-radius:10px; background:#fff; overflow:hidden; }
.bp-head { width:100%; display:flex; align-items:center; gap:12px; background:#fff; border:0; padding:14px 18px; text-align:left; }
.bp-head:hover { background:#f6f5f0; }
.bp-type { text-transform:uppercase; letter-spacing:.08em; font-size:.62rem; font-weight:600; color:var(--bp-muted); border:1px solid var(--bp-line); border-radius:6px; padding:.18rem .5rem; background:#fff; }
.bp-label { text-transform:uppercase; letter-spacing:.14em; font-weight:600; font-size:1rem; color:var(--bp-ink); }
.bp-principal { text-transform:uppercase; letter-spacing:.08em; font-size:.6rem; font-weight:700; color:#fff; background:var(--bp-olive); border-radius:6px; padding:.2rem .5rem; }
.bp-chev { margin-left:auto; color:var(--bp-muted); transition:transform .2s ease; }
.bp-head[aria-expanded="true"] .bp-chev { transform:rotate(180deg); }
.bp-body { padding:20px 22px; }
.bp-field { margin-bottom:20px; }
.bp-field label { text-transform:uppercase; letter-spacing:.09em; font-size:.62rem; color:var(--bp-muted); font-weight:600; display:block; margin-bottom:4px; }
.bp-field .val { color:var(--bp-ink); font-size:.92rem; }
.bp-docs-label { text-transform:uppercase; letter-spacing:.09em; font-size:.62rem; color:var(--bp-muted); font-weight:600; margin-bottom:8px; }
.bp-doc-chip { display:inline-flex; align-items:center; gap:7px; border:1px solid var(--bp-line); border-radius:8px; padding:.5rem .9rem; color:var(--bp-olive-d); font-size:.88rem; text-decoration:none; margin:0 8px 8px 0; background:#fff; }
.bp-doc-chip:hover { border-color:var(--bp-olive); background:#eef0e6; color:var(--bp-olive-d); }
.bp-constancia-link { color:var(--bp-olive-d); text-decoration:none; font-weight:600; }
.bp-constancia-link:hover { text-decoration:underline; }
.bp-actions { display:flex; justify-content:space-between; align-items:center; gap:10px; border-top:1px solid var(--bp-line); margin-top:6px; padding-top:16px; flex-wrap:wrap; }
.bp-btn { display:inline-flex; align-items:center; gap:8px; border:1px solid var(--bp-line); background:#fff; border-radius:8px; padding:.55rem 1.1rem; font-size:.8rem; font-weight:600; text-transform:uppercase; letter-spacing:.08em; cursor:pointer; transition:background .15s ease, border-color .15s ease; }
.bp-btn.edit, .bp-btn.primary { color:var(--bp-olive-d); }
.bp-btn.edit:hover, .bp-btn.primary:hover { border-color:var(--bp-olive); background:#eef0e6; }
.bp-btn.del { color:#a15b5b; border-color:#e0cdcd; }
.bp-btn.del:hover { border-color:#b45c5c; background:#f7ecec; }
.bp-new-btn { width:100%; border:1px dashed var(--bp-line); background:transparent; color:var(--bp-muted); border-radius:10px; padding:16px; font-size:.85rem; font-weight:600; text-transform:uppercase; letter-spacing:.14em; cursor:pointer; transition:border-color .15s ease, color .15s ease; }
.bp-new-btn:hover { border-color:var(--bp-olive); color:var(--bp-olive-d); }
</style>

<!-- Billing Profiles Section -->
<div class="bp-editorial" id="billingProfilesSection">
    <% if (billingShowHeader) { %>
    <div class="mb-4">
        <div class="bp-header-title">Perfiles de Facturación</div>
        <div class="bp-header-sub">Administra tus perfiles de facturación para diferentes entidades fiscales</div>
    </div>
    <% } %>

    <!-- Loading spinner -->
    <div id="billingProfilesSpinner" class="justify-content-center align-items-center" style="display: flex; min-height: 120px;">
        <div class="spinner-border" role="status" style="color: #6E7A50;">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>

    <!-- Empty state -->
    <div id="billingProfilesEmpty" class="text-center py-5" style="display:none;">
        <i class="ti ti-file-invoice" style="font-size: 3rem; color: #ccc;"></i>
        <p class="text-muted mt-2 mb-0">No hay perfiles de facturación.</p>
        <p class="text-muted small">Crea tu primer perfil para comenzar a recibir facturas.</p>
    </div>

    <!-- Profiles list (acordeón) -->
    <div id="billingProfilesList" class="bp-accordion" style="display:none;"></div>

    <!-- Nuevo perfil (punteado) -->
    <% if (!billingReadOnly) { %>
    <button class="bp-new-btn mt-3" data-action="bp-new">
        <i class="ti ti-plus me-1"></i>Nuevo Perfil de Facturación
    </button>
    <% } %>
</div>

<!-- Create/Edit Billing Profile Modal -->
<div class="modal fade" id="billingProfileModal" tabindex="-1" aria-labelledby="billingProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #0891b2 0%, #0ea5e9 100%); border: none;">
                <h5 class="modal-title fw-bold text-white" id="billingProfileModalLabel">
                    <i class="ti ti-file-invoice me-2"></i>Nuevo Perfil de Facturacion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="billingProfileForm" novalidate>
                    <input type="hidden" id="bp_profileId" value="">

                    <!-- Informacion General -->
                    <div class="p-3 bg-light rounded mb-4">
                        <h6 class="fw-bold text-primary mb-3"><i class="ti ti-info-circle me-2"></i>Informacion General</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="bp_country" class="form-label fw-semibold">Pais <span class="text-danger">*</span></label>
                                <select class="form-select" id="bp_country">
                                    <option value="MX" selected>Mexico</option>
                                    <option value="US">Estados Unidos</option>
                                    <option value="CA">Canada</option>
                                    <option value="GB">Reino Unido</option>
                                    <option value="DE">Alemania</option>
                                    <option value="FR">Francia</option>
                                    <option value="ES">Espana</option>
                                    <option value="BR">Brasil</option>
                                    <option value="CO">Colombia</option>
                                    <option value="AR">Argentina</option>
                                    <option value="CL">Chile</option>
                                    <option value="PE">Peru</option>
                                    <option value="OTHER">Otro</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label for="bp_label" class="form-label fw-semibold">Nombre del Perfil <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="bp_label" placeholder="Ej: Perfil Principal, Oficina Central, Sucursal Norte">
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="bp_isPrimary">
                                    <label class="form-check-label fw-semibold" for="bp_isPrimary">Perfil principal</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Datos Fiscales Mexico -->
                    <div class="billing-mx-fields mb-4">
                        <div class="p-3 border rounded border-success" style="border-left: 4px solid #059669 !important;">
                            <h6 class="fw-bold text-success mb-3"><i class="ti ti-building me-2"></i>Datos Fiscales (Mexico)</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/rfc-input', {
                                        name: 'bp_rfc',
                                        id: 'bp_rfc',
                                        label: 'RFC',
                                        required: true,
                                        helpText: 'Personas físicas: 13 caracteres | Personas morales: 12 caracteres'
                                    }) %>
                                </div>
                                <div class="col-md-6">
                                    <label for="bp_razonSocial" class="form-label fw-semibold">Razon Social <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="bp_razonSocial" placeholder="Nombre de la empresa o persona fisica">
                                </div>
                                <div class="col-md-6">
                                    <label for="bp_regimenFiscal" class="form-label fw-semibold">Regimen Fiscal <span class="text-danger">*</span></label>
                                    <select class="form-select" id="bp_regimenFiscal">
                                        <option value="">Seleccionar regimen fiscal</option>
                                        <option value="601">601 - General de Ley Personas Morales</option>
                                        <option value="603">603 - Personas Morales con Fines no Lucrativos</option>
                                        <option value="605">605 - Sueldos y Salarios</option>
                                        <option value="606">606 - Arrendamiento</option>
                                        <option value="608">608 - Demas ingresos</option>
                                        <option value="610">610 - Residentes en el Extranjero</option>
                                        <option value="612">612 - Actividades Empresariales y Profesionales</option>
                                        <option value="616">616 - Sin obligaciones fiscales</option>
                                        <option value="621">621 - Incorporacion Fiscal</option>
                                        <option value="625">625 - Plataformas Tecnologicas</option>
                                        <option value="626">626 - Regimen Simplificado de Confianza</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="bp_usoCfdi" class="form-label fw-semibold">Uso de CFDI <span class="text-danger">*</span></label>
                                    <select class="form-select" id="bp_usoCfdi">
                                        <option value="">Seleccionar uso de CFDI</option>
                                        <option value="G01">G01 - Adquisicion de mercancias</option>
                                        <option value="G03">G03 - Gastos en general</option>
                                        <option value="I01">I01 - Construcciones</option>
                                        <option value="I02">I02 - Mobiliario y equipo de oficina</option>
                                        <option value="I03">I03 - Equipo de transporte</option>
                                        <option value="I04">I04 - Equipo de computo</option>
                                        <option value="D01">D01 - Honorarios medicos y dentales</option>
                                        <option value="D04">D04 - Donativos</option>
                                        <option value="S01">S01 - Sin efectos fiscales</option>
                                        <option value="CP01">CP01 - Pagos</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <%- include('../../atoms/common/postal-code-input', {
                                        name: 'bp_codigoPostal',
                                        id: 'bp_codigoPostal',
                                        label: 'Código Postal',
                                        required: true,
                                        helpText: '5 dígitos para México'
                                    }) %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Datos Fiscales Internacional -->
                    <div class="billing-intl-fields mb-4">
                        <div class="p-3 border rounded border-info" style="border-left: 4px solid #0891b2 !important;">
                            <h6 class="fw-bold text-info mb-3"><i class="ti ti-world me-2"></i>Datos Fiscales (Internacional)</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="bp_taxId" class="form-label fw-semibold">TAX ID <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="bp_taxId" placeholder="Numero de identificacion fiscal">
                                </div>
                                <div class="col-md-6">
                                    <label for="bp_commercialName" class="form-label fw-semibold">Nombre Comercial <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="bp_commercialName" placeholder="Nombre comercial de la empresa">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Direccion Fiscal -->
                    <div class="p-3 bg-light rounded mb-4">
                        <h6 class="fw-bold text-primary mb-3"><i class="ti ti-map-pin me-2"></i>Direccion Fiscal</h6>
                        <div class="row g-3">
                            <!-- Fila 1: Tipo de Vialidad + Nombre de la Calle + Números -->
                            <div class="col-md-3">
                                <%- include('../../atoms/common/street-type-select', {
                                    name: 'bp_streetType',
                                    id: 'bp_streetType',
                                    label: 'Tipo de Vialidad'
                                }) %>
                            </div>
                            <div class="col-md-5">
                                <%- include('../../atoms/common/street-name-input', {
                                    name: 'bp_streetName',
                                    id: 'bp_streetName',
                                    label: 'Nombre de la Calle'
                                }) %>
                            </div>
                            <div class="col-md-2">
                                <%- include('../../atoms/common/exterior-number-input', {
                                    name: 'bp_exteriorNumber',
                                    id: 'bp_exteriorNumber',
                                    label: 'No. Exterior'
                                }) %>
                            </div>
                            <div class="col-md-2">
                                <%- include('../../atoms/common/interior-number-input', {
                                    name: 'bp_interiorNumber',
                                    id: 'bp_interiorNumber',
                                    label: 'No. Interior'
                                }) %>
                            </div>
                            <!-- Fila 2: Colonia + Ciudad + Estado (México) -->
                            <div class="col-md-4 billing-colonia-field">
                                <%- include('../../atoms/common/colonia-input', {
                                    name: 'bp_colonia',
                                    id: 'bp_colonia',
                                    label: 'Colonia'
                                }) %>
                            </div>
                            <div class="col-md-4">
                                <%- include('../../atoms/common/city-input', {
                                    name: 'bp_city',
                                    id: 'bp_city',
                                    label: 'Ciudad / Municipio'
                                }) %>
                            </div>
                            <div class="col-md-4">
                                <%- include('../../atoms/common/state-select', {
                                    name: 'bp_state',
                                    id: 'bp_state',
                                    label: 'Estado / Provincia'
                                }) %>
                            </div>
                            <!-- Código Postal Internacional (no México) -->
                            <div class="col-md-4 billing-intl-postal-field">
                                <%- include('../../atoms/common/postal-code-input', {
                                    name: 'bp_postalCode',
                                    id: 'bp_postalCode',
                                    label: 'Codigo Postal / Zip Code',
                                    helpText: 'Código postal del país seleccionado'
                                }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Contacto de Facturacion -->
                    <div class="p-3 bg-light rounded mb-4">
                        <h6 class="fw-bold text-primary mb-3"><i class="ti ti-mail me-2"></i>Contacto de Facturacion</h6>
                        <div class="row g-3">
                            <!-- Fila 1: Nombre + Apellido -->
                            <div class="col-md-6">
                                <%- include('../../atoms/common/first-name-input', {
                                    name: 'bp_firstName',
                                    id: 'bp_firstName',
                                    label: 'Nombre',
                                    required: true,
                                    helpText: 'Nombre del contacto de facturación'
                                }) %>
                            </div>
                            <div class="col-md-6">
                                <%- include('../../atoms/common/last-name-input', {
                                    name: 'bp_lastName',
                                    id: 'bp_lastName',
                                    label: 'Apellido',
                                    required: true,
                                    helpText: 'Apellido del contacto de facturación'
                                }) %>
                            </div>
                            <!-- Fila 2: Teléfono + Email -->
                            <div class="col-md-4">
                                <%- include('../../atoms/common/phone-input', {
                                    name: 'bp_phone',
                                    id: 'bp_phone',
                                    label: 'Teléfono',
                                    required: false,
                                    helpText: 'Teléfono del contacto de facturación'
                                }) %>
                            </div>
                            <div class="col-md-8">
                                <%- include('../../atoms/common/email-input', {
                                    name: 'bp_billingEmail',
                                    id: 'bp_billingEmail',
                                    label: 'Email para envío de facturas',
                                    required: true,
                                    placeholder: 'facturacion@empresa.com',
                                    helpText: 'Si no se especifica, se usará el email principal de la cuenta'
                                }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Constancia de Situacion Fiscal (Mexico) -->
                    <div class="billing-constancia-section mb-4">
                        <div class="p-3 border rounded" style="border-left: 4px solid #f59e0b !important;">
                            <h6 class="fw-bold mb-3" style="color: #d97706;"><i class="ti ti-certificate me-2"></i>Constancia de Situacion Fiscal</h6>
                            <div id="bp_constanciaInfo" style="display:none;" class="billing-constancia-info mb-3"></div>
                            <div>
                                <label for="bp_constanciaFile" class="form-label small text-muted">Subir constancia (solo PDF)</label>
                                <input type="file" class="form-control form-control-sm" id="bp_constanciaFile" accept=".pdf">
                            </div>
                        </div>
                    </div>

                    <!-- Documentos Adicionales -->
                    <div class="p-3 bg-light rounded">
                        <h6 class="fw-bold text-primary mb-3"><i class="ti ti-paperclip me-2"></i>Documentos Adicionales</h6>
                        <div id="bp_additionalDocsList" class="mb-2"></div>
                        <div>
                            <label for="bp_additionalDocFile" class="form-label small text-muted">Subir documento adicional</label>
                            <input type="file" class="form-control form-control-sm" id="bp_additionalDocFile">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="bp_saveBtn" data-action="bp-save">
                    <i class="ti ti-check me-1"></i><span id="bp_saveBtnText">Guardar Perfil</span>
                    <span id="bp_saveBtnSpinner" class="spinner-border spinner-border-sm ms-1" role="status" style="display:none;">
                        <span class="visually-hidden">Guardando...</span>
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    // Config
    const billingServerAccessToken = '<%= typeof accessToken !== "undefined" ? accessToken : "" %>';
    const billingIsReadOnly = <%= billingReadOnly ? 'true' : 'false' %>;
    const billingTargetUserId = '<%= billingTargetUserId %>';

    function getBillingToken() {
        // First try server-injected token (most reliable from dashboard)
        if (billingServerAccessToken && billingServerAccessToken !== '') {
            return billingServerAccessToken;
        }
        // Then try client-side storage
        let token = localStorage.getItem('accessToken') ||
                    localStorage.getItem('authToken') ||
                    localStorage.getItem('token') ||
                    sessionStorage.getItem('accessToken') ||
                    sessionStorage.getItem('authToken');
        if (token && token !== 'undefined' && token !== 'null') return token;
        // Try cookie
        const match = document.cookie.match(/accessToken=([^;]+)/);
        if (match) return match[1];
        return '';
    }

    // Country flag helper
    function getCountryFlag(countryCode) {
        const flags = {
            'MX': '\uD83C\uDDF2\uD83C\uDDFD',
            'US': '\uD83C\uDDFA\uD83C\uDDF8',
            'CA': '\uD83C\uDDE8\uD83C\uDDE6',
            'GB': '\uD83C\uDDEC\uD83C\uDDE7',
            'DE': '\uD83C\uDDE9\uD83C\uDDEA',
            'FR': '\uD83C\uDDEB\uD83C\uDDF7',
            'ES': '\uD83C\uDDEA\uD83C\uDDF8',
            'BR': '\uD83C\uDDE7\uD83C\uDDF7',
            'CO': '\uD83C\uDDE8\uD83C\uDDF4',
            'AR': '\uD83C\uDDE6\uD83C\uDDF7',
            'CL': '\uD83C\uDDE8\uD83C\uDDF1',
            'PE': '\uD83C\uDDF5\uD83C\uDDEA'
        };
        return flags[countryCode] || '\uD83C\uDF0E';
    }

    // Store modal instance
    let billingModalInstance = null;

    function getBillingModal() {
        if (!billingModalInstance) {
            const modalEl = document.getElementById('billingProfileModal');
            if (modalEl) {
                billingModalInstance = new bootstrap.Modal(modalEl);
            }
        }
        return billingModalInstance;
    }

    // Load billing profiles from API
    async function loadBillingProfiles() {
        const spinner = document.getElementById('billingProfilesSpinner');
        const emptyState = document.getElementById('billingProfilesEmpty');
        const listContainer = document.getElementById('billingProfilesList');

        spinner.style.display = 'flex';
        emptyState.style.display = 'none';
        listContainer.style.display = 'none';

        try {
            const token = getBillingToken();
            const headers = { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
            if (token) headers['Authorization'] = 'Bearer ' + token;
            const apiUrl = billingTargetUserId ? '/api/billing-profiles/user/' + billingTargetUserId : '/api/billing-profiles';
            const response = await fetch(apiUrl, {
                method: 'GET',
                credentials: 'include',
                headers: headers
            });

            if (!response.ok) {
                throw new Error('Failed to load billing profiles');
            }

            const data = await response.json();
            const profilesData = data.data || {};
            const profiles = profilesData.profiles || profilesData.data || (Array.isArray(profilesData) ? profilesData : []);

            spinner.style.display = 'none';

            if (profiles.length === 0) {
                emptyState.style.display = 'block';
                listContainer.style.display = 'none';
            } else {
                emptyState.style.display = 'none';
                listContainer.style.display = 'flex';
                renderBillingProfileCards(profiles);
            }
        } catch (err) {
            console.error('Error loading billing profiles:', err);
            spinner.style.display = 'none';
            emptyState.style.display = 'block';
        }
    }

    // Render profile cards
    function renderBillingProfileCards(profiles) {
        const container = document.getElementById('billingProfilesList');
        container.innerHTML = '';
        const esc = function(s) { return String(s == null ? '' : s); };

        profiles.forEach(function(profile, idx) {
            const isMX = profile.country === 'MX';
            const typeLabel = isMX ? 'Local' : 'Extranjero';
            const bodyId = 'bpBody_' + (profile.objectId || idx);
            const expanded = idx === 0; // primer perfil abierto por defecto
            const principal = profile.isPrimary ? '<span class="bp-principal">Principal</span>' : '';

            // Campos fiscales (MX vs internacional)
            const fRfcLabel = isMX ? 'RFC' : 'TAX ID';
            const fRfc = isMX ? (profile.rfc || 'N/A') : (profile.taxId || 'N/A');
            const fRazonLabel = isMX ? 'Razón Social' : 'Nombre Comercial';
            const fRazon = isMX ? (profile.razonSocial || 'N/A') : (profile.commercialName || 'N/A');
            const fRegimen = isMX ? (profile.regimenFiscal || 'N/A') : '—';

            // Dirección (una línea)
            let addr = [];
            if (profile.streetType && profile.street) addr.push(profile.streetType + ' ' + profile.street);
            else if (profile.street) addr.push(profile.street);
            if (profile.exteriorNumber) addr.push('#' + profile.exteriorNumber);
            if (profile.interiorNumber) addr.push('Int. ' + profile.interiorNumber);
            if (isMX && profile.colonia) addr.push(profile.colonia);
            const addrStr = addr.join(', ') || 'N/A';
            const cp = (isMX ? (profile.codigoPostal || '') : (profile.postalCode || '')) || 'N/A';
            const contactName = ((profile.firstName || '') + ' ' + (profile.lastName || '')).trim() || 'N/A';

            // Constancia fiscal (MX)
            let constanciaHtml = 'N/A';
            if (isMX && profile.constancia && profile.constancia.url) {
                const cd = profile.constancia.uploadDate ? new Date(profile.constancia.uploadDate).toLocaleDateString('es-MX') : '';
                constanciaHtml = '<a href="#" class="bp-constancia-link" data-action="bp-download-doc" data-doc-url="' + esc(profile.constancia.url) + '" data-doc-name="constancia_fiscal.pdf"><i class="ti ti-file-text me-1"></i>Ver' + (cd ? ' — ' + cd : '') + '</a>';
            }

            // Documentos adicionales (chips)
            let docsHtml = '';
            if (profile.additionalDocuments && profile.additionalDocuments.length > 0) {
                docsHtml = '<div class="bp-docs-label">Documentos Adicionales</div><div>';
                profile.additionalDocuments.forEach(function(doc) {
                    docsHtml += '<a href="#" class="bp-doc-chip" data-action="bp-download-doc" data-doc-url="' + esc(doc.url) + '" data-doc-name="' + esc(doc.fileName || 'documento') + '"><i class="ti ti-file"></i>' + esc(doc.fileName || 'Documento') + '</a>';
                });
                docsHtml += '</div>';
            }

            // Acciones (ocultas en modo solo lectura)
            let actionsHtml = '';
            if (!billingIsReadOnly) {
                let left = '<button class="bp-btn edit" data-action="bp-edit" data-profile-id="' + esc(profile.objectId) + '"><i class="ti ti-pencil"></i>Editar</button>';
                if (!profile.isPrimary) {
                    left += '<button class="bp-btn primary" data-action="bp-set-primary" data-profile-id="' + esc(profile.objectId) + '"><i class="ti ti-star"></i>Hacer Principal</button>';
                }
                actionsHtml = '<div class="bp-actions">' +
                    '<div class="d-flex gap-2 flex-wrap">' + left + '</div>' +
                    '<button class="bp-btn del" data-action="bp-delete" data-profile-id="' + esc(profile.objectId) + '"><i class="ti ti-trash"></i>Eliminar</button>' +
                    '</div>';
            }

            const item = '' +
                '<div class="bp-item">' +
                '  <button class="bp-head" type="button" data-bs-toggle="collapse" data-bs-target="#' + bodyId + '" aria-expanded="' + (expanded ? 'true' : 'false') + '" aria-controls="' + bodyId + '">' +
                '    <span class="bp-type">' + typeLabel + '</span>' +
                '    <span class="bp-label">' + esc(profile.label || 'Perfil sin nombre') + '</span>' +
                principal +
                '    <i class="ti ti-chevron-down bp-chev"></i>' +
                '  </button>' +
                '  <div id="' + bodyId + '" class="collapse' + (expanded ? ' show' : '') + '">' +
                '    <div class="bp-body">' +
                '      <div class="row">' +
                '        <div class="col-md-4 bp-field"><label>' + fRfcLabel + '</label><div class="val">' + esc(fRfc) + '</div></div>' +
                '        <div class="col-md-4 bp-field"><label>' + fRazonLabel + '</label><div class="val">' + esc(fRazon) + '</div></div>' +
                '        <div class="col-md-4 bp-field"><label>Régimen Fiscal</label><div class="val">' + esc(fRegimen) + '</div></div>' +
                '        <div class="col-md-4 bp-field"><label>Dirección</label><div class="val">' + esc(addrStr) + '</div></div>' +
                '        <div class="col-md-4 bp-field"><label>C.P.</label><div class="val">' + esc(cp) + '</div></div>' +
                '        <div class="col-md-4 bp-field"><label>Contacto</label><div class="val">' + esc(contactName) + '</div></div>' +
                '        <div class="col-md-4 bp-field"><label>Teléfono</label><div class="val">' + esc(profile.phone || 'N/A') + '</div></div>' +
                '        <div class="col-md-4 bp-field"><label>Email de Facturación</label><div class="val">' + esc(profile.billingEmail || 'N/A') + '</div></div>' +
                '        <div class="col-md-4 bp-field"><label>Constancia Fiscal</label><div class="val">' + constanciaHtml + '</div></div>' +
                '      </div>' +
                (docsHtml ? '<div class="mb-3">' + docsHtml + '</div>' : '') +
                actionsHtml +
                '    </div>' +
                '  </div>' +
                '</div>';

            container.insertAdjacentHTML('beforeend', item);
        });
    }

