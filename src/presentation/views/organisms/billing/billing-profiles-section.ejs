    // Clear all validation states from form inputs
    function clearValidationStates() {
        const form = document.getElementById('billingProfileForm');
        if (!form) return;
        
        // Remove Bootstrap validation classes from all inputs, selects, and textareas
        const formElements = form.querySelectorAll('input, select, textarea');
        formElements.forEach(function(element) {
            element.classList.remove('is-valid', 'is-invalid');
        });
        
        // Hide any validation feedback messages
        const feedbackElements = form.querySelectorAll('.invalid-feedback, .valid-feedback');
        feedbackElements.forEach(function(element) {
            element.style.display = 'none';
        });
        
        console.log('Billing profile validation states cleared');
    }

    // Open modal for create or edit
    window.openBillingProfileModal = async function(profileId) {
        // Reset form
        document.getElementById('billingProfileForm').reset();
        document.getElementById('bp_profileId').value = '';
        document.getElementById('bp_constanciaInfo').style.display = 'none';
        document.getElementById('bp_constanciaInfo').innerHTML = '';
        document.getElementById('bp_additionalDocsList').innerHTML = '';
        document.getElementById('bp_country').value = 'MX';
        
        // Clear validation states to prevent persistence across modal opens
        clearValidationStates();
        
        toggleBillingCountryFields();

        if (profileId) {
            document.getElementById('billingProfileModalLabel').innerHTML = '<i class="ti ti-file-invoice me-2"></i>Editar Perfil de Facturacion';
            document.getElementById('bp_saveBtnText').textContent = 'Guardar Cambios';

            try {
                const token = getBillingToken();
                const headers = { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
                if (token) headers['Authorization'] = 'Bearer ' + token;
                const response = await fetch('/api/billing-profiles/' + profileId, {
                    method: 'GET',
                    credentials: 'include',
                    headers: headers
                });

                if (!response.ok) throw new Error('Error al cargar perfil');

                const data = await response.json();
                const profile = data.data?.profile || data.data || data;

                document.getElementById('bp_profileId').value = profile.objectId || profile.id || profileId;
                document.getElementById('bp_country').value = profile.country || 'MX';
                document.getElementById('bp_label').value = profile.label || '';
                document.getElementById('bp_isPrimary').checked = !!profile.isPrimary;
                // Contact information
                document.getElementById('bp_firstName').value = profile.firstName || '';
                document.getElementById('bp_lastName').value = profile.lastName || '';
                document.getElementById('bp_phone').value = profile.phone || '';
                document.getElementById('bp_billingEmail').value = profile.emailFacturacion || profile.billingEmail || '';

                // Address
                document.getElementById('bp_streetType').value = profile.streetType || 'Calle';
                document.getElementById('bp_streetName').value = profile.street || profile.streetName || '';
                document.getElementById('bp_exteriorNumber').value = profile.exteriorNumber || '';
                document.getElementById('bp_interiorNumber').value = profile.interiorNumber || '';
                document.getElementById('bp_colonia').value = profile.colonia || '';
                document.getElementById('bp_city').value = profile.city || '';
                document.getElementById('bp_state').value = profile.state || '';

                var isMX = profile.country === 'MX';
                if (isMX) {
                    document.getElementById('bp_rfc').value = profile.rfc || '';
                    document.getElementById('bp_razonSocial').value = profile.razonSocial || '';
                    document.getElementById('bp_regimenFiscal').value = profile.regimenFiscal || '';
                    document.getElementById('bp_usoCfdi').value = profile.usoCfdi || '';
                    document.getElementById('bp_codigoPostal').value = profile.codigoPostal || '';

                    if (profile.constancia && profile.constancia.url) {
                        var constDate = profile.constancia.uploadDate ? new Date(profile.constancia.uploadDate).toLocaleDateString('es-MX') : '';
                        document.getElementById('bp_constanciaInfo').innerHTML =
                            '<i class="ti ti-file-check text-success me-1"></i>' +
                            '<a href="#" data-action="bp-download-doc" data-doc-url="' + (profile.constancia.url || '') + '" data-doc-name="constancia_fiscal.pdf">' + (profile.constancia.fileName || 'Constancia') + '</a>' +
                            (constDate ? ' <span class="text-muted">- Subida el ' + constDate + '</span>' : '');
                        document.getElementById('bp_constanciaInfo').style.display = 'block';
                    }
                } else {
                    document.getElementById('bp_taxId').value = profile.taxId || '';
                    document.getElementById('bp_commercialName').value = profile.commercialName || '';
                    document.getElementById('bp_postalCode').value = profile.postalCode || '';
                }

                if (profile.additionalDocuments && profile.additionalDocuments.length > 0) {
                    var docsList = document.getElementById('bp_additionalDocsList');
                    profile.additionalDocuments.forEach(function(doc, idx) {
                        var docItem = document.createElement('div');
                        docItem.className = 'billing-additional-doc-item';
                        docItem.innerHTML =
                            '<a href="#" class="text-truncate me-2" data-action="bp-download-doc" data-doc-url="' + (doc.url || '') + '" data-doc-name="' + (doc.fileName || 'documento') + '">' +
