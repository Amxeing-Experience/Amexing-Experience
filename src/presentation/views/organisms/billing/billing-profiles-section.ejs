        }

        const modal = getBillingModal();
        if (modal) modal.show();
    };

    // Save (create or update) billing profile
    window.saveBillingProfile = async function() {
        const saveBtn = document.getElementById('bp_saveBtn');
        const saveBtnText = document.getElementById('bp_saveBtnText');
        const saveBtnSpinner = document.getElementById('bp_saveBtnSpinner');

        const profileId = document.getElementById('bp_profileId').value;
        const country = document.getElementById('bp_country').value;
        const isMX = country === 'MX';

        // Basic validation
        const label = document.getElementById('bp_label').value.trim();
        const billingEmail = document.getElementById('bp_billingEmail').value.trim();
        if (!label) { alert('Por favor ingresa un nombre para el perfil.'); return; }
        if (!billingEmail) { alert('Por favor ingresa un email de facturacion.'); return; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(billingEmail)) { alert('Por favor ingresa un email valido.'); return; }

        if (isMX) {
            if (!document.getElementById('bp_rfc').value.trim()) { alert('Por favor ingresa el RFC.'); return; }
            if (!document.getElementById('bp_razonSocial').value.trim()) { alert('Por favor ingresa la Razon Social.'); return; }
            if (!document.getElementById('bp_regimenFiscal').value) { alert('Por favor selecciona el Regimen Fiscal.'); return; }
            if (!document.getElementById('bp_usoCfdi').value) { alert('Por favor selecciona el Uso de CFDI.'); return; }
            if (!document.getElementById('bp_codigoPostal').value.trim()) { alert('Por favor ingresa el Codigo Postal.'); return; }
        } else {
            if (!document.getElementById('bp_taxId').value.trim()) { alert('Por favor ingresa el TAX ID.'); return; }
            if (!document.getElementById('bp_commercialName').value.trim()) { alert('Por favor ingresa el Nombre Comercial.'); return; }
        }

        // Build payload
        const payload = {
            country: country,
            label: label,
            isPrimary: document.getElementById('bp_isPrimary').checked,
            // Contact information
            firstName: document.getElementById('bp_firstName').value.trim(),
            lastName: document.getElementById('bp_lastName').value.trim(),
            phone: document.getElementById('bp_phone').value.trim(),
            emailFacturacion: billingEmail,
            // Address information
            streetType: document.getElementById('bp_streetType').value,
            street: document.getElementById('bp_streetName').value.trim(),
            exteriorNumber: document.getElementById('bp_exteriorNumber').value.trim(),
            interiorNumber: document.getElementById('bp_interiorNumber').value.trim(),
            city: document.getElementById('bp_city').value.trim(),
            state: document.getElementById('bp_state').value.trim()
        };

        if (isMX) {
            payload.rfc = document.getElementById('bp_rfc').value.trim().toUpperCase();
            payload.razonSocial = document.getElementById('bp_razonSocial').value.trim();
            payload.regimenFiscal = document.getElementById('bp_regimenFiscal').value;
            payload.usoCfdi = document.getElementById('bp_usoCfdi').value;
            payload.codigoPostal = document.getElementById('bp_codigoPostal').value.trim();
            payload.colonia = document.getElementById('bp_colonia').value.trim();
        } else {
            payload.taxId = document.getElementById('bp_taxId').value.trim();
            payload.commercialName = document.getElementById('bp_commercialName').value.trim();
            payload.postalCode = document.getElementById('bp_postalCode').value.trim();
        }

        // Show spinner
        saveBtn.disabled = true;
        saveBtnSpinner.style.display = 'inline-block';

        try {
            const token = getBillingToken();
            const isUpdate = !!profileId;
            const url = isUpdate ? '/api/billing-profiles/' + profileId : '/api/billing-profiles';
            const method = isUpdate ? 'PUT' : 'POST';

            var fetchHeaders = { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
            if (token) fetchHeaders['Authorization'] = 'Bearer ' + token;
            const response = await fetch(url, {
                method: method,
                credentials: 'include',
                headers: fetchHeaders,
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const errData = await response.json().catch(function() { return {}; });
                throw new Error(errData.error || 'Failed to save profile');
            }

            const result = await response.json();
            const savedProfileId = profileId || (result.data && (result.data.objectId || (result.data.profile && result.data.profile.objectId))) || '';

            // Upload constancia if a new file was selected (MX only)
            if (isMX && savedProfileId) {
                const constanciaInput = document.getElementById('bp_constanciaFile');
                if (constanciaInput.files && constanciaInput.files.length > 0) {
                    await uploadConstancia(savedProfileId);
                }
            }

            // Upload additional document if selected
            if (savedProfileId) {
                const additionalInput = document.getElementById('bp_additionalDocFile');
                if (additionalInput.files && additionalInput.files.length > 0) {
                    await uploadAdditionalDocument(savedProfileId);
                }
            }

            const modal = getBillingModal();
            if (modal) modal.hide();

            await loadBillingProfiles();
        } catch (err) {
            console.error('Error saving billing profile:', err);
            alert('Error saving profile: ' + err.message);
        } finally {
            saveBtn.disabled = false;
            saveBtnSpinner.style.display = 'none';
        }
    };

    // Delete billing profile
    window.deleteBillingProfile = async function(profileId) {
        if (!confirm('Are you sure you want to delete this billing profile? This action cannot be undone.')) {
            return;
        }

        try {
            const token = getBillingToken();
            const response = await fetch('/api/billing-profiles/' + profileId, {
                method: 'DELETE',
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': 'application/json'
                }
            });

            if (!response.ok) {
                throw new Error('Failed to delete profile');
            }

            await loadBillingProfiles();
        } catch (err) {
            console.error('Error deleting billing profile:', err);
            alert('Error deleting profile: ' + err.message);
        }
    };

