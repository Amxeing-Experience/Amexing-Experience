    // Upload constancia de situacion fiscal
    async function uploadConstancia(profileId) {
        const fileInput = document.getElementById('bp_constanciaFile');
        if (!fileInput.files || fileInput.files.length === 0) return;

        const file = fileInput.files[0];
        if (file.type !== 'application/pdf') {
            alert('Constancia must be a PDF file.');
            return;
        }

        return new Promise(function(resolve, reject) {
            const reader = new FileReader();
            reader.onload = async function() {
                try {
                    const token = getBillingToken();
                    var fetchHeaders = { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
                    if (token) fetchHeaders['Authorization'] = 'Bearer ' + token;
                    const response = await fetch('/api/billing-profiles/' + profileId + '/upload-constancia', {
                        method: 'POST',
                        credentials: 'include',
                        headers: fetchHeaders,
                        body: JSON.stringify({
                            fileName: file.name,
                            fileData: reader.result
                        })
                    });
                    if (!response.ok) throw new Error('Failed to upload constancia');
                    resolve();
                } catch (err) {
                    console.error('Error uploading constancia:', err);
                    reject(err);
                }
            };
            reader.onerror = function() { reject(new Error('Failed to read file')); };
            reader.readAsDataURL(file);
        });
    }

    // Upload additional document
    async function uploadAdditionalDocument(profileId) {
        const fileInput = document.getElementById('bp_additionalDocFile');
        if (!fileInput.files || fileInput.files.length === 0) return;

        const file = fileInput.files[0];

        return new Promise(function(resolve, reject) {
            const reader = new FileReader();
            reader.onload = async function() {
                try {
                    const token = getBillingToken();
                    var fetchHeaders = { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
                    if (token) fetchHeaders['Authorization'] = 'Bearer ' + token;
                    const response = await fetch('/api/billing-profiles/' + profileId + '/upload-document', {
                        method: 'POST',
                        credentials: 'include',
                        headers: fetchHeaders,
                        body: JSON.stringify({
                            fileName: file.name,
                            fileData: reader.result
                        })
                    });
                    if (!response.ok) throw new Error('Failed to upload document');
                    resolve();
                } catch (err) {
                    console.error('Error uploading document:', err);
                    reject(err);
                }
            };
            reader.onerror = function() { reject(new Error('Failed to read file')); };
            reader.readAsDataURL(file);
        });
    }

    // Remove additional document
    async function viewConstancia(profileId) {
        try {
            // Fetch profile to get presigned URL
            var token = getBillingToken();
            var headers = { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
            if (token) headers['Authorization'] = 'Bearer ' + token;
            var response = await fetch('/api/billing-profiles/' + profileId, {
                method: 'GET',
                credentials: 'include',
                headers: headers
            });
            if (!response.ok) throw new Error('Error al obtener perfil');
            var data = await response.json();
            var profile = data.data?.profile || data.data || data;
            var url = profile.constancia?.url || profile.constanciaFiscalUrl || '';
            if (!url) { alert('No hay constancia cargada'); return; }

            // Create a hidden link to trigger download
            var a = document.createElement('a');
            a.href = url;
            a.target = '_blank';
            a.download = 'constancia_fiscal.pdf';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        } catch (err) {
            console.error('Error viewing constancia:', err);
            alert('No se pudo abrir la constancia: ' + err.message);
        }
    }

    function downloadDocument(url, fileName) {
        if (!url) { alert('No hay URL del documento'); return; }
        var a = document.createElement('a');
        a.href = url;
        a.target = '_blank';
        a.download = fileName || 'documento';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    window.removeAdditionalDocument = async function(profileId, docId, buttonEl) {
        if (!confirm('Remove this document?')) return;

        try {
            const token = getBillingToken();
            const response = await fetch('/api/billing-profiles/' + profileId + '/documents/' + docId, {
                method: 'DELETE',
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': 'application/json'
                }
            });

            if (!response.ok) throw new Error('Failed to remove document');

            // Remove the DOM element
            if (buttonEl && buttonEl.parentElement) {
                buttonEl.parentElement.remove();
            }
        } catch (err) {
            console.error('Error removing document:', err);
            alert('Error removing document: ' + err.message);
        }
    };

    // Event delegation for all billing profile actions (CSP-safe, no inline onclick)
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-action]');
        if (!btn) return;
        var action = btn.dataset.action;
        var profileId = btn.dataset.profileId;

        switch (action) {
            case 'bp-new': openBillingProfileModal(); break;
            case 'bp-edit': openBillingProfileModal(profileId); break;
            case 'bp-set-primary': setPrimaryProfile(profileId); break;
            case 'bp-delete': deleteBillingProfile(profileId); break;
            case 'bp-save': saveBillingProfile(); break;
            case 'bp-remove-doc': removeAdditionalDocument(profileId, btn.dataset.docId, btn); break;
            case 'bp-view-constancia': e.preventDefault(); viewConstancia(profileId); break;
            case 'bp-download-doc': e.preventDefault(); downloadDocument(btn.dataset.docUrl, btn.dataset.docName); break;
        }
    });

    // Initialize on DOM ready
    document.addEventListener('DOMContentLoaded', function() {
