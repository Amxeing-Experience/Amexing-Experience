        document.querySelectorAll('.billing-intl-fields').forEach(function(el) { el.style.display = isMX ? 'none' : 'block'; });
        document.querySelectorAll('.billing-intl-postal-field').forEach(function(el) { el.style.display = isMX ? 'none' : 'block'; });
