                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
                
                priceSection = `
                    <div class="vehicle-pricing">
                        ${vehicleCards}
                    </div>
                `;
                
                vehicleInfo = ``;
                
                // Don't show type section - removed as requested
                typeSection = '';
