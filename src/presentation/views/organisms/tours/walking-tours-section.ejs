<%
/**
 * Walking Tours Section
 * Displays walking tours with group-based pricing tiers
 * Separate from vehicle-based tours due to different pricing model
 * Created by Denisse Maldonado
 */

// Default parameters
const sectionId = typeof walkingToursId !== 'undefined' ? walkingToursId : 'walking-tours-section';
const apiEndpoint = typeof walkingApiEndpoint !== 'undefined' ? walkingApiEndpoint : '/api/tours/walking';
%>

<!-- Walking Tours Section -->
<div class="card mb-4" id="<%= sectionId %>">
    <div class="card-header bg-light">
        <!-- First row: Title and Create button -->
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="card-title mb-0">
                <i class="ti ti-walk me-2 text-success"></i>Tours a Pie
            </h5>
            <% 
            // Check if user is admin or superadmin to show create button
            const currentUserRole = typeof userRole !== 'undefined' ? userRole : '';
            if (currentUserRole === 'admin' || currentUserRole === 'superadmin') { 
            %>
                <button type="button" class="btn btn-success btn-sm" id="createWalkingTourBtn">
                    <i class="ti ti-plus me-1"></i>Nuevo Tour a Pie
                </button>
            <% } %>
        </div>
        
        <!-- Second row: Subtitle and Filter Controls -->
        <div class="d-flex align-items-center justify-content-between">
            <p class="text-muted small mb-0">Precios por grupo de personas</p>
            
            <!-- Filter Controls -->
            <div class="d-flex gap-2 align-items-center">
                <!-- Currency Dropdown -->
                <div class="d-flex align-items-center gap-1">
                    <label for="walkingCurrencyFilter-<%= sectionId %>" class="form-label mb-0 text-muted small">Moneda:</label>
                    <select class="form-select form-select-sm" id="walkingCurrencyFilter-<%= sectionId %>" style="min-width: 80px;">
                        <option value="MXN" selected>MXN</option>
                        <option value="USD">USD</option>
                    </select>
                </div>
                
                <!-- Payment Type Dropdown -->
                <div class="d-flex align-items-center gap-1">
                    <label for="walkingPaymentFilter-<%= sectionId %>" class="form-label mb-0 text-muted small">Pago:</label>
                    <select class="form-select form-select-sm" id="walkingPaymentFilter-<%= sectionId %>" style="min-width: 180px;">
                        <option value="efectivo"<%= (typeof defaultPaymentType !== 'undefined' && defaultPaymentType === 'efectivo') ? ' selected' : '' %>>Efectivo</option>
                        <option value="transferencia"<%= (typeof defaultPaymentType === 'undefined' || defaultPaymentType === 'transferencia') ? ' selected' : '' %>>Transferencia</option>
                        <option value="tarjeta"<%= (typeof defaultPaymentType !== 'undefined' && defaultPaymentType === 'tarjeta') ? ' selected' : '' %>>Tarjeta de Crédito/Débito</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card-body">
        <!-- Loading state -->
        <div id="walking-tours-loading" class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando tours a pie...</span>
            </div>
            <p class="text-muted mt-2">Cargando tours a pie...</p>
        </div>
        
        <!-- Walking tours container -->
        <div id="walking-tours-container" class="d-none">
            <!-- Tours will be populated here via JavaScript -->
        </div>
        
        <!-- No walking tours message -->
        <div id="no-walking-tours" class="text-center py-4 d-none">
            <div class="text-muted">
                <i class="ti ti-walk" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-2 mb-0">No hay tours a pie disponibles</p>
            </div>
        </div>
    </div>
</div>

<!-- Load centralized pricing utilities -->
<script src="/dashboard/js/utils/pricing-utils.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    loadWalkingTours();
    
    // Add click handler for create walking tour button
    const createBtn = document.getElementById('createWalkingTourBtn');
    if (createBtn) {
        createBtn.addEventListener('click', function() {
            // Check if there's a walking tour modal in the parent page
            const walkingTourModal = document.getElementById('walkingTourModal');
            if (walkingTourModal) {
                // Open the walking tour modal
                const modal = new bootstrap.Modal(walkingTourModal);
                modal.show();
            } else {
                console.error('Walking tour modal not found. Make sure the walking tour modal component is included in the page.');
                alert('Para crear tours a pie, necesita incluir el componente de modal de tours a pie en la página.');
            }
        });
    }
});

async function loadWalkingTours() {
    try {
        // Get all tours and filter client-side by isWalkingTour = true
        const url = new URL('<%= apiEndpoint %>', window.location.origin);
        // Note: Removed tourType parameter - will filter by isWalkingTour instead
        
        // Add client ID if available to get client-specific prices
        const clientId = getClientId();
        if (clientId) {
            url.searchParams.append('clientId', clientId);
        }
        
        const response = await fetch(url, {
            credentials: 'include',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        
        const data = await response.json();
        
        if (!response.ok) {
            throw new Error(data.error || 'Error loading walking tours');
        }
        
        // Filter to show only walking tours (isWalkingTour === true)
        const allTours = data.data || [];
        const walkingTours = allTours.filter(tour => tour.isWalkingTour === true);
        
        
        displayWalkingTours(walkingTours);
        
    } catch (error) {
        console.error('Error loading walking tours:', error);
        showWalkingToursError();
    }
}

// Helper function to get client ID from the page context
function getClientId() {
    // Try to get from global variable, URL parameter, or element data attribute
    return window.clientId || 
           new URLSearchParams(window.location.search).get('clientId') ||
           document.querySelector('[data-client-id]')?.getAttribute('data-client-id') ||
           null;
}

// Helper function to extract pricing for walking tours
function getWalkingTourPricing(tour) {
    const defaultPricing = {
        small: '$1,050 MXN',      // 1-5 pax
        medium: '$2,100 MXN',     // 6-10 pax  
        large: '$3,150 MXN',      // 11-15 pax
        smallNumber: 1050,        // Numeric value for data attribute
        mediumNumber: 2100,       // Numeric value for data attribute
        largeNumber: 3150,        // Numeric value for data attribute
        hasTourPricing: false
    };
    
    // Use Tour's built-in walking pricing fields (from migration)
    if (tour.walkingPriceSmall && tour.walkingPriceMedium && tour.walkingPriceLarge) {
        const currency = tour.walkingPriceCurrency || 'MXN';
        const smallRange = tour.walkingRangeSmall || '1-5 pax';
        const mediumRange = tour.walkingRangeMedium || '6-10 pax';
        const largeRange = tour.walkingRangeLarge || '11-15 pax';
        
        return {
            small: `$${tour.walkingPriceSmall.toLocaleString()} ${currency}`,
            medium: `$${tour.walkingPriceMedium.toLocaleString()} ${currency}`,
            large: `$${tour.walkingPriceLarge.toLocaleString()} ${currency}`,
            smallNumber: tour.walkingPriceSmall,     // Numeric value for data attribute
            mediumNumber: tour.walkingPriceMedium,   // Numeric value for data attribute
            largeNumber: tour.walkingPriceLarge,     // Numeric value for data attribute
            smallRange: smallRange.replace(' pax', ' personas'),
            mediumRange: mediumRange.replace(' pax', ' personas'),
            largeRange: largeRange.replace(' pax', ' personas'),
            hasTourPricing: true
        };
    }
    
    // Fallback: Check if client has custom pricing (for backward compatibility)
    if (tour.hasClientPrices && tour.clientPrices) {
        const clientPrices = tour.clientPrices;
        const priceKeys = Object.keys(clientPrices);
        
        if (priceKeys.length > 0) {
            const firstPrice = clientPrices[priceKeys[0]];
            const basePrice = firstPrice.price || firstPrice.basePrice || 1050;
            
            return {
                small: `$${basePrice.toLocaleString()} MXN`,           // 1-5 pax
                medium: `$${(basePrice * 2).toLocaleString()} MXN`,    // 6-10 pax (double)
                large: `$${(basePrice * 3).toLocaleString()} MXN`,     // 11-15 pax (triple)
                smallNumber: basePrice,                                // Numeric value for data attribute
                mediumNumber: basePrice * 2,                          // Numeric value for data attribute
                largeNumber: basePrice * 3,                           // Numeric value for data attribute
                hasTourPricing: false // This is client pricing, not tour pricing
            };
        }
    }
    
    // Ultimate fallback to defaults
    return defaultPricing;
}

function displayWalkingTours(tours) {
    const loadingEl = document.getElementById('walking-tours-loading');
    const containerEl = document.getElementById('walking-tours-container');
    const noToursEl = document.getElementById('no-walking-tours');
    
    loadingEl.classList.add('d-none');
    
    if (!tours || tours.length === 0) {
        noToursEl.classList.remove('d-none');
        return;
    }
    
    // Tours are already filtered by the API with tourType=walking
    const toursHtml = tours.map(tour => {
        // Get pricing information for walking tours
        const pricing = getWalkingTourPricing(tour);
        
        return `
        <div class="walking-tour-item mb-3" data-tour-id="${tour.objectId || tour.id}">
            <div class="row align-items-center p-3 border rounded-3 bg-white">
                <div class="col-md-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="mb-0 fw-bold text-dark">${tour.destinationPOI?.name || 'Tour a pie'}</h6>
                        ${(() => {
                            // Check if user has edit permissions (admin or superadmin)
                            const currentUserRole = '<%= typeof userRole !== "undefined" ? userRole : "" %>';
                            if (currentUserRole === 'admin' || currentUserRole === 'superadmin') {
                                return `
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-sm edit-walking-tour-btn" 
                                            data-id="${tour.objectId || tour.id}" 
                                            title="Editar tour a pie">
                                        <i class="ti ti-edit"></i>
                                    </button>
                                </div>
                                `;
                            }
                            return '';
                        })()}
                    </div>
                    <div class="d-flex align-items-center text-muted small">
                        <i class="ti ti-clock me-1"></i>
                        <span>${Math.round((tour.time || 0) / 60 * 10) / 10} horas mínimo</span>
                    </div>
                </div>
                
                <div class="col-md-9">
                    <div class="row g-2">
                        <!-- Small group -->
                        <div class="col-md-4">
                            <div class="text-center p-3 bg-success-subtle rounded-2 border border-success-subtle">
                                <div class="fw-bold text-success">${pricing.smallRange || '1-5 personas'}</div>
                                <div class="h5 mb-0 text-success walking-tour-price-small" data-original-price="${pricing.smallNumber || 0}">
                                    <div class="price-loader d-flex align-items-center justify-content-center">
                                        <div class="spinner-border spinner-border-sm text-success me-2" role="status" aria-hidden="true"></div>
                                        <span class="small">Cargando...</span>
                                    </div>
                                </div>
                                <div class="small text-muted">por hora</div>
                            </div>
                        </div>
                        
                        <!-- Medium group -->
                        <div class="col-md-4">
                            <div class="text-center p-3 bg-warning-subtle rounded-2 border border-warning-subtle">
                                <div class="fw-bold text-warning-emphasis">${pricing.mediumRange || '6-10 personas'}</div>
                                <div class="h5 mb-0 text-warning-emphasis walking-tour-price-medium" data-original-price="${pricing.mediumNumber || 0}">
                                    <div class="price-loader d-flex align-items-center justify-content-center">
                                        <div class="spinner-border spinner-border-sm text-warning me-2" role="status" aria-hidden="true"></div>
                                        <span class="small">Cargando...</span>
                                    </div>
                                </div>
                                <div class="small text-muted">por hora</div>
                            </div>
                        </div>
                        
                        <!-- Large group -->
                        <div class="col-md-4">
                            <div class="text-center p-3 bg-info-subtle rounded-2 border border-info-subtle">
                                <div class="fw-bold text-info-emphasis">${pricing.largeRange || '11-15 personas'}</div>
                                <div class="h5 mb-0 text-info-emphasis walking-tour-price-large" data-original-price="${pricing.largeNumber || 0}">
                                    <div class="price-loader d-flex align-items-center justify-content-center">
                                        <div class="spinner-border spinner-border-sm text-info me-2" role="status" aria-hidden="true"></div>
                                        <span class="small">Cargando...</span>
                                    </div>
                                </div>
                                <div class="small text-muted">por hora</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        `;
    }).join('');
    
    containerEl.innerHTML = toursHtml;
    containerEl.classList.remove('d-none');
    
    // Add event handlers for edit buttons
    setTimeout(() => {
        addWalkingTourEventHandlers();
    }, 100);
    
    // Initialize filters after tours are displayed
    setTimeout(() => {
        initWalkingToursFilters();
        
        // Apply initial pricing based on current filter selections
        const sectionId = '<%= sectionId %>';
        const initialPayment = $(`#walkingPaymentFilter-${sectionId}`).val();
        const initialCurrency = $(`#walkingCurrencyFilter-${sectionId}`).val();
        
        // Force load transfer rate if needed and apply pricing
        const ensureCorrectPricing = () => {

            if (initialPayment === 'transferencia') {
                if (walkingCurrentTransferRate <= 0) {

                    loadWalkingTransferRate().then(() => {

                        updateWalkingToursPrices(initialPayment, initialCurrency);
                    });
                } else {

                    updateWalkingToursPrices(initialPayment, initialCurrency);
                }
            } else if (initialPayment === 'tarjeta') {
                if (walkingCurrentAgencyRate <= 0) {
                    loadWalkingAgencyRate().then(() => {
                        updateWalkingToursPrices(initialPayment, initialCurrency);
                    });
                } else {
                    updateWalkingToursPrices(initialPayment, initialCurrency);
                }
            } else {
                // Efectivo - no rates needed
                updateWalkingToursPrices(initialPayment, initialCurrency);
            }
        };
        
        // Start the process
        setTimeout(ensureCorrectPricing, 300);
    }, 500);
}

function showWalkingToursError() {
    const loadingEl = document.getElementById('walking-tours-loading');
    const containerEl = document.getElementById('walking-tours-container');
    
    loadingEl.classList.add('d-none');
    
    containerEl.innerHTML = `
        <div class="text-center py-4">
            <div class="text-danger">
                <i class="ti ti-alert-circle" style="font-size: 2rem;"></i>
                <p class="mt-2 mb-0">Error al cargar tours a pie</p>
                <button class="btn btn-outline-primary btn-sm mt-2" onclick="loadWalkingTours()">
                    <i class="ti ti-reload me-1"></i>Reintentar
                </button>
            </div>
        </div>
    `;
    containerEl.classList.remove('d-none');
}

// Global variables for walking tours pricing
let walkingCurrentTransferRate = 0;
let walkingCurrentExchangeRate = 0;
let walkingCurrentAgencyRate = 0;

// Initialize filter event handlers
function initWalkingToursFilters() {
    const sectionId = '<%= sectionId %>';

    // Remove any existing event handlers to prevent duplicates
    $(`#walkingCurrencyFilter-${sectionId}`).off('change.walkingtours');
    $(`#walkingPaymentFilter-${sectionId}`).off('change.walkingtours');
    
    // Currency filter change handler
    $(`#walkingCurrencyFilter-${sectionId}`).on('change.walkingtours', function() {
        const selectedCurrency = $(this).val();
        const selectedPaymentType = $(`#walkingPaymentFilter-${sectionId}`).val();

        if (selectedCurrency === 'USD' && walkingCurrentExchangeRate <= 0) {
            loadWalkingExchangeRate().then(() => {
                updateWalkingToursPrices(selectedPaymentType, selectedCurrency);
            });
        } else {
            updateWalkingToursPrices(selectedPaymentType, selectedCurrency);
        }
    });
    
    // Payment type filter change handler
    $(`#walkingPaymentFilter-${sectionId}`).on('change.walkingtours', function() {
        const selectedPaymentType = $(this).val();
        const selectedCurrency = $(`#walkingCurrencyFilter-${sectionId}`).val();

        // Handle payment type specific rates
        if (selectedPaymentType === 'transferencia' && walkingCurrentTransferRate <= 0) {
            loadWalkingTransferRate().then(() => {
                updateWalkingToursPrices(selectedPaymentType, selectedCurrency);
            });
        } else if (selectedPaymentType === 'tarjeta' && walkingCurrentAgencyRate <= 0) {
            loadWalkingAgencyRate().then(() => {
                updateWalkingToursPrices(selectedPaymentType, selectedCurrency);
            });
        } else {
            updateWalkingToursPrices(selectedPaymentType, selectedCurrency);
        }
    });
    
    // Test that selectors work
}

// Get JWT token from localStorage or cookies
function getAccessToken() {
    // First try localStorage (used by other parts of the app)
    const tokenFromStorage = localStorage.getItem('accessToken');
    if (tokenFromStorage) {
        return tokenFromStorage;
    }
    
    // Fallback to cookies (httpOnly cookies won't work, but try anyway)
    const cookies = document.cookie.split(';');
    for (let cookie of cookies) {
        const [name, value] = cookie.trim().split('=');
        if (name === 'accessToken') {
            return value;
        }
    }
    return null;
}

// Load current exchange rate for USD conversion
function loadWalkingExchangeRate() {
    return $.ajax({
        url: '/api/exchange-rate/current',
        type: 'GET',
        beforeSend: function(xhr) {
            const token = getAccessToken();
            if (token) {
                xhr.setRequestHeader('Authorization', 'Bearer ' + token);
            }
        },
        success: function(response) {
            if (response.success && response.data) {
                walkingCurrentExchangeRate = response.data.value || 0;

            } else {
                console.warn('⚠️ No active exchange rate found for walking tours');
                walkingCurrentExchangeRate = 0;
            }
        },
        error: function(xhr, status, error) {
            console.error('❌ Error loading exchange rate for walking tours:', error);
            walkingCurrentExchangeRate = 0;
        }
    });
}

// Load current transfer rate for payment calculations
function loadWalkingTransferRate() {
    return $.ajax({
        url: '/api/transfer-rate/current',
        type: 'GET',
        beforeSend: function(xhr) {
            const token = getAccessToken();
            if (token) {
                xhr.setRequestHeader('Authorization', 'Bearer ' + token);
            }
        },
        success: function(response) {
            if (response.success && response.data) {
                walkingCurrentTransferRate = response.data.value || 0;
            } else {
                walkingCurrentTransferRate = 0;
            }
        },
        error: function(xhr, status, error) {
            walkingCurrentTransferRate = 0;
        }
    });
}

// Load current agency rate for credit card payments
function loadWalkingAgencyRate() {
    return $.ajax({
        url: '/api/agency-rate/current',
        type: 'GET',
        beforeSend: function(xhr) {
            const token = getAccessToken();
            if (token) {
                xhr.setRequestHeader('Authorization', 'Bearer ' + token);
            }
        },
        success: function(response) {
            if (response.success && response.data) {
                walkingCurrentAgencyRate = response.data.value || 0;

            } else {
                console.warn('⚠️ No active agency rate found for walking tours');
                walkingCurrentAgencyRate = 0;
            }
        },
        error: function(xhr, status, error) {
            console.error('❌ Error loading agency rate for walking tours:', error);
            walkingCurrentAgencyRate = 0;
        }
    });
}

// Format price with currency symbol
function formatWalkingTourPrice(price, currency) {
    if (currency === 'USD') {
        return `$${parseFloat(price).toLocaleString('en-US', { 
            minimumFractionDigits: 0, 
            maximumFractionDigits: 2 
        })} USD`;
    } else {
        return `$${parseFloat(price).toLocaleString('es-MX')} MXN`;
    }
}

// USD rounding rules now handled by centralized PricingUtils.applyUSDRoundingRules()

// Convert and format price based on currency and payment type
function convertWalkingTourPrice(priceInput, currency, paymentType) {
    // Handle both numeric and string inputs
    let numericValue;
    if (typeof priceInput === 'number') {
        numericValue = priceInput;
    } else if (typeof priceInput === 'string') {
        numericValue = parseFloat(priceInput.replace(/[^0-9.]/g, ''));
    } else {
        console.error('Invalid price input:', priceInput);
        return '$0 MXN';
    }
    
    if (isNaN(numericValue)) {
        console.error('Could not parse price:', priceInput);
        return '$0 MXN';
    }
    
    // Apply payment type rate first
    let adjustedPrice = numericValue;
    if (paymentType === 'transferencia' && walkingCurrentTransferRate > 0) {
        adjustedPrice = numericValue * (1 + walkingCurrentTransferRate / 100);
    } else if (paymentType === 'tarjeta' && walkingCurrentAgencyRate > 0) {
        adjustedPrice = numericValue * (1 + walkingCurrentAgencyRate / 100);
    }
    
    // Then convert currency if needed
    if (currency === 'USD' && walkingCurrentExchangeRate > 0) {
        const convertedValue = adjustedPrice / walkingCurrentExchangeRate;
        const roundedValue = PricingUtils.applyUSDRoundingRules(convertedValue);
        return formatWalkingTourPrice(roundedValue, 'USD');
    } else {
        return formatWalkingTourPrice(adjustedPrice, 'MXN');
    }
}

// Update all walking tour prices based on selected filters
function updateWalkingToursPrices(paymentType, currency) {
    const tourItems = $('.walking-tour-item');
    
    tourItems.each(function() {
        const tourItem = $(this);
        
        // Update price displays in each pricing tier
        ['small', 'medium', 'large'].forEach(size => {
            const priceElement = tourItem.find(`.walking-tour-price-${size}`);
            
            if (priceElement.length > 0) {
                const originalPrice = priceElement.data('original-price');
                
                if (originalPrice !== undefined && originalPrice !== null) {
                    const updatedPrice = convertWalkingTourPrice(originalPrice, currency, paymentType);
                    // Replace loader with actual price
                    priceElement.html(updatedPrice);
                }
            }
        });
    });
}

// Add event handlers for walking tour actions
function addWalkingTourEventHandlers() {
    // Edit button click handler
    $(document).off('click', '.edit-walking-tour-btn').on('click', '.edit-walking-tour-btn', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const tourId = $(this).data('id');

        // Load walking tour data and open modal in edit mode
        loadWalkingTourForEdit(tourId);
    });
}

// Function to load walking tour data for editing
async function loadWalkingTourForEdit(tourId) {
    try {

        // Get access token
        const token = getAccessToken();
        if (!token) {
            alert('Error de autenticación. Por favor vuelva a iniciar sesión.');
            return;
        }
        
        // Fetch tour data
        const response = await fetch(`/api/tours/${tourId}`, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });
        
        const result = await response.json();

        if (!response.ok || !result.success) {
            console.error('❌ Error loading walking tour:', result.error);
            alert('Error al cargar el tour a pie: ' + (result.error || 'Error desconocido'));
            return;
        }
        
        const tour = result.data;

        
        // Check if there's a walking tour modal
        const walkingTourModal = document.getElementById('walkingTourModal');
        if (!walkingTourModal) {
            alert('Modal de tour a pie no encontrado. Asegúrese de que el componente modal esté incluido en la página.');
            return;
        }
        
        // Update modal for edit mode first
        $('#walkingTourModalLabel').html('<i class="ti ti-walk me-2"></i>Editar Tour a Pie');
        $('#saveWalkingButtonText').text('Guardar Cambios');
        $('#walkingTourId').val(tourId);
        
        // Open the modal
        const modal = new bootstrap.Modal(walkingTourModal);
        modal.show();
        
        // Wait for modal to be fully shown before populating data
        walkingTourModal.addEventListener('shown.bs.modal', function modalShownHandler() {

            // Remove this event listener to prevent multiple calls
            walkingTourModal.removeEventListener('shown.bs.modal', modalShownHandler);
            
            // Populate the form with tour data after modal is visible
            setTimeout(() => {
                populateWalkingTourForm(tour);
            }, 200);
        }, { once: true });
        
        // Fallback: Also try to populate after a longer delay in case the event doesn't fire
        setTimeout(() => {

            if ($('#walkingTourModal').hasClass('show')) {
                populateWalkingTourForm(tour);
            }
        }, 1500);
        
    } catch (error) {
        console.error('Error loading walking tour for edit:', error);
        alert('Error al conectar con el servidor.');
    }
}

// Function to populate walking tour form with data
function populateWalkingTourForm(tourData) {
    if (!tourData) {
        return;
    }
    
    // Fix: Extract the actual tour data (it's nested under tour.tour)
    const tour = tourData.tour || tourData;
    
    // Helper function to set field values
    const setFieldValue = (elementId, value) => {
        const element = document.getElementById(elementId);
        if (element && value !== undefined && value !== null) {
            element.value = value;
        }
        return element;
    };
    
    // Set basic fields
    setFieldValue('walkingTourDescription', tour.description || '');
    setFieldValue('walkingDuration', tour.time ? (tour.time / 60) : '');
    setFieldValue('walkingAdvanceTime', tour.anticipation || tour.advance_booking_time || '');
    
    // Walking tour pricing
    setFieldValue('walkingPriceSmall', tour.walkingPriceSmall || tour.walking_price_small || tour.priceSmall || tour.price_small || tour.smallPrice || '');
    setFieldValue('walkingPriceMedium', tour.walkingPriceMedium || tour.walking_price_medium || tour.priceMedium || tour.price_medium || tour.mediumPrice || '');
    setFieldValue('walkingPriceLarge', tour.walkingPriceLarge || tour.walking_price_large || tour.priceLarge || tour.price_large || tour.largePrice || '');
    
    // Additional fields
    const includesValue = tour.includes || tour.include || tour.whatIncludes || tour.included || '';
    const notIncludesValue = tour.notincludes || tour.not_includes || tour.notInclude || tour.excluded || tour.excludes || '';
    const languagesValue = tour.languages || tour.language || tour.supportedLanguages || '';
    
    setFieldValue('walkingIncludes', Array.isArray(includesValue) ? includesValue.join('\n') : includesValue);
    setFieldValue('walkingNotIncludes', Array.isArray(notIncludesValue) ? notIncludesValue.join('\n') : notIncludesValue);
    setFieldValue('walkingLanguages', Array.isArray(languagesValue) ? languagesValue.join('\n') : languagesValue);
    
    // Set destination POI
    setTimeout(() => {
        const walkingDestElement = document.getElementById('walkingDestinationPOI');
        
        if (walkingDestElement && walkingDestElement.tomselect) {
            // Try extensive POI reference formats
            const poiId = tour.destinationPOI?.objectId || 
                         tour.destinationPOI?.id || 
                         tour.destinationPOI || 
                         tour.destination_poi || 
                         tour.poi?.objectId ||
                         tour.poi?.id ||
                         tour.poi ||
                         tour.poiId ||
                         tour.destination?.objectId ||
                         tour.destination?.id ||
                         tour.destination ||
                         tour.destinationId;
            
            if (poiId) {
                try {
                    walkingDestElement.tomselect.setValue(poiId);
                } catch (error) {
                    console.error('Error setting POI:', error);
                }
            }
        }
    }, 1000); // Delay to ensure TomSelect is ready
}

// Initialize walking tours filters when document and jQuery are ready
function initWalkingToursWhenReady() {
    if (typeof $ === 'undefined') {
        // jQuery not loaded yet, wait and try again
        setTimeout(initWalkingToursWhenReady, 100);
        return;
    }
    
    // jQuery is available, proceed with initialization
    $(document).ready(function() {
        // Load rates for walking tours (these are global and can be loaded immediately)
        loadWalkingTransferRate();
        loadWalkingAgencyRate();
        loadWalkingExchangeRate();
        
        // Initialize walking tours functionality
        initWalkingToursFilters();
    });
}

// Start the initialization process
initWalkingToursWhenReady();
</script>