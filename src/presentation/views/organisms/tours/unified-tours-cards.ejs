            });
            
            // Sort vehicles within each rate by capacity
            Object.values(pricesByRate).forEach(rateGroup => {
                rateGroup.prices.sort((a, b) => {
                    const capacityA = a.vehicleType?.defaultCapacity || 0;
                    const capacityB = b.vehicleType?.defaultCapacity || 0;
                    return capacityA - capacityB; // Sort ascending by capacity
                });
            });
            
            // Sort rates to ensure consistent ordering
            const sortedRates = Object.entries(pricesByRate).sort((a, b) => {
                // Put "no-rate" at the end
                if (a[0] === 'no-rate') return 1;
                if (b[0] === 'no-rate') return -1;
