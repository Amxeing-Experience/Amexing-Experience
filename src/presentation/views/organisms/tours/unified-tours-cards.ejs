    // Function to show tour details modal
    async function showTourDetailsModal(tourId, tourName, tourType) {
        const modal = new bootstrap.Modal(document.getElementById('tourDetailsModal'));
        const heroTitle = document.getElementById('tourHeroTitle');
        const heroImage = document.getElementById('tourHeroImage');
        const modalLoading = document.getElementById('tourModalLoading');
        const tabContent = document.getElementById('tourTabContent');
        
        // Set initial data and show loading
        heroTitle.textContent = tourName;
        heroImage.src = '/img/amexing_logo_horizontal.avif'; // Default placeholder
        heroImage.style.objectFit = 'contain';
        heroImage.style.background = '#ffffff';
        heroImage.style.padding = '20px';
        modalLoading.style.display = 'block';
        tabContent.style.display = 'none';
        
        // Show modal
        modal.show();
        
        try {
            // Always fetch complete tour data from individual tour API endpoint
            // This ensures we get all tour fields including those missing from the tours list
            console.log('Fetching complete tour details from API for tourId:', tourId);
            const response = await fetch(`/api/tours/${tourId}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('authToken') || ''}`,
                    'Content-Type': 'application/json'
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al cargar los detalles del tour');
            }
            
            const tourData = await response.json();
            console.log('Complete tour data from API:', tourData);
            const tourDetail = tourData.data.tour || tourData.data;
            console.log('Final tour detail object:', tourDetail);

            // Store tour for Add to Quote button
            window._currentModalTour = {
                id: tourId,
                name: tourDetail.destinationPOI?.name || tourName,
                type: 'tour',
                price: tourDetail.price || 0
            };
            console.log('All tour data fields:', Object.keys(tourDetail));
            console.log('Tour data field categories:', {
                basic: Object.keys(tourDetail).filter(key => !key.includes('_') && !key.includes('price') && !key.includes('Price')),
                pricing: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('price') || key.toLowerCase().includes('cost')),
                capacity: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('capacity') || key.toLowerCase().includes('people') || key.toLowerCase().includes('pax')),
                schedule: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('time') || key.toLowerCase().includes('duration') || key.toLowerCase().includes('schedule')),
                location: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('location') || key.toLowerCase().includes('point') || key.toLowerCase().includes('destination')),
                content: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('include') || key.toLowerCase().includes('description') || key.toLowerCase().includes('note'))
            });
            await loadTourDetailsIntoModal(tourDetail, tourName);
            
        } catch (error) {
            console.error('Error loading tour details:', error);
            showModalError('No se pudieron cargar los detalles del tour');
        }
    }
    
    // Function to load tour data into modal
    async function loadTourDetailsIntoModal(tour, tourName) {
        const modalLoading = document.getElementById('tourModalLoading');
        const tabContent = document.getElementById('tourTabContent');
        const heroImage = document.getElementById('tourHeroImage');
        const photoCountBadge = document.getElementById('photoCountBadge');
        
        try {
            // Set optimized hero image with progressive loading
            const heroImageContainer = heroImage.parentElement;
            heroImageContainer.classList.add('loading');
            
            if (tour.photos && tour.photos.length > 0) {
                const firstPhoto = tour.photos[0];
                heroImage.src = getOptimizedImageUrl(firstPhoto);
                heroImage.style.objectFit = 'cover';
                heroImage.style.background = '';
                heroImage.style.padding = '';
                photoCountBadge.textContent = tour.photos.length;
            } else if (tour.primaryPhoto) {
                heroImage.src = getOptimizedImageUrl(tour.primaryPhoto);
                heroImage.style.objectFit = 'cover';
                heroImage.style.background = '';
                heroImage.style.padding = '';
                photoCountBadge.textContent = '1';
            } else {
                heroImage.src = '/img/amexing_logo_horizontal.avif';
                heroImage.style.objectFit = 'contain';
                heroImage.style.background = '#ffffff';
                heroImage.style.padding = '20px';
                photoCountBadge.textContent = '0';
            }
            
            // Add progressive loading event listeners for hero image
            heroImage.onload = () => {
                heroImageContainer.classList.remove('loading');
                heroImageContainer.classList.add('loaded');
            };
            
            heroImage.onerror = () => {
                heroImageContainer.classList.remove('loading');
                heroImageContainer.classList.add('error');
                heroImage.src = '/img/amexing_logo_horizontal.avif';
                heroImage.style.objectFit = 'contain';
                heroImage.style.background = '#ffffff';
                heroImage.style.padding = '20px';
            };
            
            // If image is already loaded (from cache), trigger load event
            if (heroImage.complete && heroImage.naturalHeight !== 0) {
                heroImage.dispatchEvent(new Event('load'));
            }
            
            // Load content into each tab
            loadInformationTab(tour, tourName);
            loadGalleryTab(tour, tourName);
            loadDetailsTab(tour);
            loadPricesTab(tour);
            
            // Hide loading and show content
            modalLoading.style.display = 'none';
            tabContent.style.display = 'block';
            
        } catch (error) {
            console.error('Error processing tour data:', error);
            showModalError('Error al procesar los datos del tour');
        }
    }
    
    // Function to show error in modal
    function showModalError(message) {
        const modalLoading = document.getElementById('tourModalLoading');
        const tabContent = document.getElementById('tourTabContent');
        
        modalLoading.innerHTML = `
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle me-2"></i>
                ${message}
            </div>
        `;
        tabContent.style.display = 'none';
    }
    
    // Helper function to format currency
    function formatCurrency(value) {
        if (!value || value === 0) return '$0.00';
        const numValue = parseFloat(value);
        return `$${numValue.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}`;
    }
    
    // Helper function to format duration
    function formatDuration(minutes) {
        if (!minutes) return 'No especificada';
        const hours = Math.floor(minutes / 60);
        const mins = minutes % 60;
        if (hours > 0 && mins > 0) {
            return `${hours}h ${mins}min`;
        } else if (hours > 0) {
            return `${hours}h`;
        } else {
            return `${mins}min`;
        }
    }
    
