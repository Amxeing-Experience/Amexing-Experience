                }).join('');

                priceSection = `
                    <div class="vehicle-pricing">
                        ${vehicleCards}
                    </div>
                `;

                vehicleInfo = ``;

                // Don't show type section - removed as requested
                typeSection = '';
            } else {
                // No pricing when no rate is selected or no vehicles available
                priceSection = '';
                vehicleInfo = '';
                typeSection = '';
            }
            
            // Build picture element with optimized formats
            let pictureElement = '';
