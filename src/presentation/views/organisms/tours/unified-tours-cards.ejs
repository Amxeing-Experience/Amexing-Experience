<script>
// Reserva anticipada (minutos) → días si >=24h; si no, horas y minutos (sin decimales).
// A nivel de script para que la use tanto el render del card (DOMContentLoaded) como el
// del detalle (IIFE aparte).
function formatAdvanceBooking(totalMinutes) {
    const mins = parseInt(totalMinutes);
    if (!mins || isNaN(mins) || mins <= 0) return 'Reserva inmediata';
    if (mins >= 1440) {
        const days = Math.floor(mins / 1440);
        const remHours = Math.floor((mins % 1440) / 60);
        let out = `${days} ${days === 1 ? 'día' : 'días'}`;
        if (remHours > 0) out += ` ${remHours} ${remHours === 1 ? 'hora' : 'horas'}`;
        return out;
    }
    const hours = Math.floor(mins / 60);
    const minutes = mins % 60;
    if (hours > 0 && minutes > 0) return `${hours}h ${minutes}min`;
    if (hours > 0) return `${hours} ${hours === 1 ? 'hora' : 'horas'}`;
    return `${minutes} min`;
}

document.addEventListener('DOMContentLoaded', function() {
    // Tour management functionality
    let allTours = [];
    let filteredTours = [];
    let availableRates = [];
    let currentExchangeRate = 20; // Default exchange rate MXN to USD
    let currentTransferRate = 0; // Transfer payment surcharge percentage
    let currentAgencyRate = 0; // Credit card payment surcharge percentage
    let currentDriverTourRate = 0; // Driver tour rate surcharge percentage
    let currentGuideFilter = 'guide-only'; // Filter for guide type - default to guide-only (Solo Guía)
    let selectedRateId = null; // Currently selected rate
    let currentTourTypeFilter = 'all'; // 'all', 'walking', 'vehicle'

    // DOM elements
    const toursLoading = document.getElementById('toursLoading');
    const toursGrid = document.getElementById('toursGrid');
    const noToursMessage = document.getElementById('noToursMessage');
    
    // Search inputs (desktop and mobile)
    const searchInputDesktop = document.getElementById('searchTour');
    const searchInputMobile = document.getElementById('searchTourMobile');
    
    // Filter elements (desktop and mobile)
    const currencyFilterDesktop = document.getElementById('currencyFilter-<%= dtTableId %>');
    const currencyFilterMobile = document.getElementById('currencyFilterMobile-<%= dtTableId %>');
    const paymentFilterDesktop = document.getElementById('paymentTypeFilter-<%= dtTableId %>');
    const paymentFilterMobile = document.getElementById('paymentTypeFilterMobile-<%= dtTableId %>');
    const rateFilterDesktop = document.getElementById('rateFilter-<%= dtTableId %>');
    const rateFilterMobile = document.getElementById('rateFilterMobile-<%= dtTableId %>');
    
    const filterPills = document.querySelectorAll('.filter-pill');
    
    // Load available rates from API
    async function loadAvailableRates() {
        try {
            console.log('Loading available segmentos from /api/rates/active...');
            const response = await fetch('/api/rates/active');
            console.log('Rate API response status:', response.status, response.statusText);
            
            if (response.ok) {
                const data = await response.json();
                console.log('Rate API response data:', data);
                
                if (data.success && data.data) {
                    // Filter out "Económico" rate
                    availableRates = data.data.filter(rate => {
                        const rateName = (rate.label || rate.name || '').toLowerCase();
                        return !rateName.includes('económico') && !rateName.includes('economico');
                    });
                    console.log('Available segmentos loaded:', availableRates.length, 'segmentos (excluding Económico):', availableRates);
                    populateRateDropdown();
                } else {
                    console.warn('Rate API returned success=false or no data:', data);
                }
            } else {
                console.warn('Rate API request failed:', response.status, response.statusText);
            }
        } catch (error) {
            console.warn('Could not load available rates:', error);
        }
    }
    
    // Populate rate dropdown with available rates
    function populateRateDropdown() {
        // Clear both desktop and mobile dropdowns
