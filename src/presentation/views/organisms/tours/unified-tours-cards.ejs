    async function openTourQuoteDialog(tour) {
        window._selectedTour = tour;
        document.getElementById('addTourToQuoteName').textContent = tour.name;
        document.getElementById('tourQuoteSearchInput').value = '';
        document.getElementById('tourQuotePickerLoading').style.display = 'block';
        document.getElementById('tourQuotePickerList').style.display = 'none';
        document.getElementById('tourQuoteActionLoading').style.display = 'none';

        const modal = new bootstrap.Modal(document.getElementById('addTourToQuoteModal'));
        modal.show();

        try {
            const token = getTourAccessToken();
            const response = await fetch('/api/quotes?start=0&length=50&order[0][column]=7&order[0][dir]=desc', {
                headers: { 'Authorization': 'Bearer ' + token }
            });
            if (!response.ok) throw new Error('Error al cargar cotizaciones');
            const result = await response.json();
            const quotes = (result.data || [])
                .filter(q => ['requested', 'hold'].includes(q.status))
                .sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt));
            renderTourQuoteList(quotes);
        } catch (error) {
            console.error('Error loading quotes:', error);
            document.getElementById('tourQuotePickerList').innerHTML =
                '<div class="quote-picker-empty"><i class="ti ti-alert-circle me-1"></i>Error al cargar cotizaciones</div>';
        } finally {
            document.getElementById('tourQuotePickerLoading').style.display = 'none';
            document.getElementById('tourQuotePickerList').style.display = 'block';
        }
    }

    function renderTourQuoteList(quotes) {
        const container = document.getElementById('tourQuotePickerList');
        if (quotes.length === 0) {
            container.innerHTML = '<div class="quote-picker-empty"><i class="ti ti-file-off me-2"></i>No hay cotizaciones editables</div>';
            return;
        }
        container.innerHTML = quotes.map(q => {
            const creatorName = q.createdBy ? q.createdBy.fullName : 'Sin asignar';
            const serviceCount = q.serviceCount || 0;
            const updated = tourTimeAgo(q.updatedAt);
            return '<div class="quote-list-item" data-quote-id="' + q.id + '">' +
                '<div class="flex-grow-1">' +
                    '<div class="quote-folio">' + q.folio + '</div>' +
                    '<div class="quote-meta">' + serviceCount + ' servicios · ' + creatorName +
                        (updated ? ' · ' + updated : '') + '</div>' +
                '</div>' +
                '<span class="quote-status status-' + q.status + '">' + q.status + '</span>' +
            '</div>';
        }).join('');
    }

    async function showTourDaySelector(quoteId) {
        const token = getTourAccessToken();
        document.getElementById('tourQuotePickerList').style.display = 'none';
        document.querySelector('#createNewQuoteBtnTour').style.display = 'none';
        document.querySelector('.tour-quote-search-input').style.display = 'none';
        document.getElementById('tourQuotePickerLoading').style.display = 'block';

        let daySelector = document.getElementById('tourDaySelector');
        if (!daySelector) {
            daySelector = document.createElement('div');
            daySelector.id = 'tourDaySelector';
            document.getElementById('tourQuotePickerList').parentNode.appendChild(daySelector);
        }
        daySelector.style.display = 'none';

        try {
            const quoteRes = await fetch('/api/quotes/' + quoteId, {
                headers: { 'Authorization': 'Bearer ' + token }
            });
            if (!quoteRes.ok) throw new Error('Error al obtener cotización');
            const quoteData = await quoteRes.json();
            const quote = quoteData.data || quoteData;
            window._selectedTourQuote = quote;
            const days = (quote.serviceItems && quote.serviceItems.days) || [];

            // 0 or 1 days → add directly
            if (days.length <= 1) {
                document.getElementById('tourQuotePickerLoading').style.display = 'none';
                if (days.length === 0) {
                    await addTourToNewDay(quoteId);
                } else {
                    await addTourToDay(quoteId, 0);
                }
                return;
            }

            // 2+ days → show picker
            let html = '<div class="day-selector-back mb-3"><i class="ti ti-arrow-left me-1"></i>Volver a cotizaciones</div>';
            html += '<div class="quote-folio mb-3">' + quote.folio + ' — Seleccionar día</div>';
            html += days.map((day, idx) => {
                const scCount = (day.subconcepts || []).length;
                return '<div class="day-list-item" data-quote-id="' + quoteId + '" data-day-index="' + idx + '">' +
                    '<div class="flex-grow-1">' +
                        '<div class="day-title">Día ' + day.dayNumber + (day.dayTitle ? ' — ' + day.dayTitle : '') + '</div>' +
                        '<div class="quote-meta">' + scCount + ' servicios</div>' +
                    '</div>' +
                '</div>';
            }).join('');
            html += '<div class="new-day-date-row mt-2" data-quote-id="' + quoteId + '">' +
                '<label class="form-label small text-muted mb-1">Agregar nuevo día:</label>' +
                '<input type="date" class="form-control form-control-sm tour-new-day-date-input" data-quote-id="' + quoteId + '">' +
            '</div>';

            daySelector.innerHTML = html;
            daySelector.style.display = 'block';
        } catch (error) {
            console.error('Error loading quote days:', error);
            showTourQuoteError(error.message);
            document.getElementById('tourQuotePickerList').style.display = 'block';
            document.querySelector('#createNewQuoteBtnTour').style.display = '';
            document.querySelector('.tour-quote-search-input').style.display = '';
        } finally {
            document.getElementById('tourQuotePickerLoading').style.display = 'none';
        }
    }

    async function addTourToDay(quoteId, dayIndex) {
        const tour = window._selectedTour;
        const quote = window._selectedTourQuote;
        const token = getTourAccessToken();

        const daySel = document.getElementById('tourDaySelector');
        if (daySel) daySel.style.display = 'none';
        document.getElementById('tourQuoteActionLoading').style.display = 'block';

        try {
            const serviceItems = quote.serviceItems || { days: [], subtotal: 0, iva: 0, total: 0 };
            serviceItems.days[dayIndex].subconcepts.push({
                type: 'tour',
                tourId: tour.id,
                title: tour.name,
                time: '',
                hours: 0,
                unitPrice: tour.price,
                total: tour.price,
                isPerPerson: true,
                numberOfPeople: 1
            });

            let subtotal = 0;
            serviceItems.days.forEach(day => {
                let dayTotal = 0;
                (day.subconcepts || []).forEach(sc => { dayTotal += (sc.total || 0); });
                day.dayTotal = Math.round(dayTotal * 100) / 100;
                subtotal += dayTotal;
            });
            serviceItems.subtotal = Math.round(subtotal * 100) / 100;
            serviceItems.iva = Math.round(subtotal * 0.16 * 100) / 100;
            serviceItems.total = Math.round((serviceItems.subtotal + serviceItems.iva) * 100) / 100;

            const updateRes = await fetch('/api/quotes/' + quoteId + '/service-items', {
                method: 'PUT',
                headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                body: JSON.stringify(serviceItems)
            });
            if (!updateRes.ok) {
                const errData = await updateRes.json();
                throw new Error(errData.error || 'Error al agregar tour');
            }

            bootstrap.Modal.getInstance(document.getElementById('addTourToQuoteModal'))?.hide();
            showTourQuoteSuccess(quote.folio || quoteId, quoteId);
        } catch (error) {
            console.error('Error adding tour to day:', error);
            showTourQuoteError(error.message);
            if (daySel) daySel.style.display = 'block';
            document.getElementById('tourQuoteActionLoading').style.display = 'none';
        }
    }

