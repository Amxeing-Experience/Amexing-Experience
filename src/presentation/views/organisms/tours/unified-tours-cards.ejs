                            ${vehicleInfo}
                            
                            <div class="tour-card-info">
                                <div class="tour-card-details">
                                    <div class="tour-info-row">
                                        <span class="tour-info-label">
                                            <i class="ti ti-clock me-1"></i>Mínimo de horas
                                        </span>
                                        <span class="tour-info-value tour-duration">${duration}</span>
