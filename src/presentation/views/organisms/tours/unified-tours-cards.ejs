                <div class="content-section">
                    <h5><i class="ti ti-activity me-2"></i>Actividades</h5>
                    <div class="activities-content">
                        ${Array.isArray(tour.activities) ? 
                            `<ul>${tour.activities.map(activity => `<li>${activity}</li>`).join('')}</ul>` : 
                            (tour.activities || tour.tour_activities)
                        }
                    </div>
                </div>
            ` : ''}
            
            ${tour.features || tour.tour_features ? `
                <div class="content-section">
                    <h5><i class="ti ti-star me-2"></i>Características Especiales</h5>
                    <div class="features-content">
                        ${Array.isArray(tour.features) ? 
                            `<ul>${tour.features.map(feature => `<li>${feature}</li>`).join('')}</ul>` : 
                            (tour.features || tour.tour_features)
                        }
                    </div>
                </div>
            ` : ''}
            
            ${tour.restrictions || tour.age_restrictions ? `
                <div class="content-section">
                    <h5><i class="ti ti-alert-circle me-2"></i>Restricciones</h5>
                    <div class="restrictions-content">
                        ${tour.restrictions || tour.age_restrictions}
                    </div>
                </div>
            ` : ''}
        `;
    }
    
    // Function to load Prices tab
    function loadPricesTab(tour) {
        const pricesContent = document.getElementById('pricesContent');
        if (!pricesContent) return;

        // Moneda y tipo de pago actuales (de los filtros de la página).
        const currencyFilter = document.getElementById('currencyFilter-<%= dtTableId %>') || document.getElementById('currencyFilterMobile-<%= dtTableId %>');
        const paymentFilter = document.getElementById('paymentTypeFilter-<%= dtTableId %>') || document.getElementById('paymentTypeFilterMobile-<%= dtTableId %>');
        const currency = currencyFilter ? currencyFilter.value : 'MXN';
        const paymentType = paymentFilter ? paymentFilter.value : 'efectivo';
        const unit = `${currency} / HORA`;
        const perUnit = `${currency} / PERSONA`;

        const isWalkingTour = tour.isWalkingTour || (tour.walkingPriceSmall || tour.walkingPriceMedium || tour.walkingPriceLarge);

        // Tarjeta de precio de lujo (misma estructura que experiencias).
        const priceCard = (name, sub, amountHtml, unitLabel) => `
            <div class="exp-lux__price-card">
                <div class="exp-lux__price-left">
                    <span class="exp-lux__price-name">${name}</span>
                    ${sub ? `<span class="exp-lux__price-sub">${sub}</span>` : ''}
                </div>
                <div class="exp-lux__price-right">
                    <span class="exp-lux__price-amount">${amountHtml}</span>
                    ${unitLabel ? `<span class="exp-lux__price-unit">${unitLabel}</span>` : ''}
                </div>
            </div>`;

        let html = '';

        // --- Tours con vehículo: TODAS las tarifas/segmentos ---
        if (tour.priceData && tour.priceData.length > 0) {
            const pricesByRate = {};
            tour.priceData.forEach((pd) => {
                const rateKey = pd.rate?.id || 'no-rate';
                if (!pricesByRate[rateKey]) {
                    pricesByRate[rateKey] = { name: pd.rate?.name || 'Tarifa general', color: pd.rate?.color || '#6E7A50', prices: [] };
                }
                pricesByRate[rateKey].prices.push(pd);
            });
            Object.values(pricesByRate).forEach((g) => g.prices.sort((a, b) => (a.vehicleType?.defaultCapacity || 0) - (b.vehicleType?.defaultCapacity || 0)));
            const sortedRates = Object.entries(pricesByRate).sort((a, b) => {
                if (a[0] === 'no-rate') return 1;
                if (b[0] === 'no-rate') return -1;
                return a[1].name.localeCompare(b[1].name);
            });

            html += sortedRates.map(([, g]) => {
                const cards = g.prices.map((pd) => {
                    const baseCapacity = pd.vehicleType?.defaultCapacity || 0;
                    const capacity = (currentGuideFilter === 'with-driver' && baseCapacity > 0) ? baseCapacity - 1 : baseCapacity;
                    const sub = capacity > 0 ? `Hasta ${capacity} personas` : '';
                    const card = priceCard(pd.vehicleType?.name || 'Vehículo', sub, convertTourPrice(pd.price, currency, paymentType, true), unit);
                    let addBtn = '';
                    <% if (currentUserRole === 'department_manager' || currentUserRole === 'client') { %>
                    addBtn = `<button type="button" class="exp-lux__price-add add-tour-vehicle-to-quote-btn"
                        data-tour-id="${tour.id || tour.objectId || (window._currentModalTour && window._currentModalTour.id) || ''}"
                        data-tour-name="${(tour.destinationPOI?.name || tour.name || (window._currentModalTour && window._currentModalTour.name) || 'Tour').replace(/"/g, '&quot;')}"
                        data-vehicle-id="${pd.vehicleType?.id || ''}"
                        data-vehicle-name="${(pd.vehicleType?.name || 'Vehículo').replace(/"/g, '&quot;')}"
                        data-vehicle-capacity="${capacity}"
                        data-base-price="${pd.price || 0}"
                        data-driver-rate="${currentDriverTourRate || 0}"
                        data-with-driver="${currentGuideFilter === 'with-driver' ? '1' : '0'}"
                        data-rate-id="${pd.rate?.id || ''}"
                        data-rate-name="${(pd.rate?.name || '').replace(/"/g, '&quot;')}"
                        data-min-hours="${tour.time ? (parseInt(tour.time) / 60) : 1}"
                        title="Agregar a Cotización"><i class="ti ti-plus me-1"></i>Agregar a cotización</button>`;
                    <% } %>
                    return addBtn ? `<div class="exp-lux__price-vehicle">${card}${addBtn}</div>` : card;
                }).join('');
                return `
                    <div class="tour-rate-group">
                        <span class="tour-rate-label" style="border-color:${g.color};">${g.name}</span>
                        ${cards}
                    </div>`;
            }).join('');

            // Precios por persona (opcional, además de los de vehículo)
            if (tour.price || tour.price_child || tour.price_no_alcohol) {
                let pp = '';
                if (tour.price) pp += priceCard('Adulto', 'Con alcohol', convertTourPrice(tour.price, currency, paymentType, true), perUnit);
                if (tour.price_child) pp += priceCard('Niño', 'Menor de edad', convertTourPrice(tour.price_child, currency, paymentType, true), perUnit);
                if (tour.price_no_alcohol) pp += priceCard('Sin alcohol', 'Sin bebidas alcohólicas', convertTourPrice(tour.price_no_alcohol, currency, paymentType, true), perUnit);
                if (pp) html += `<div class="tour-rate-group"><span class="tour-rate-label" style="border-color:var(--exp-olive);">Por persona</span>${pp}</div>`;
            }
        }
        // --- Tours a pie: tramos por tamaño de grupo ---
        else if (isWalkingTour && (tour.walkingPriceSmall || tour.walkingPriceMedium || tour.walkingPriceLarge)) {
            const ranges = getWalkingTourRanges(tour);
            if (tour.walkingPriceSmall) html += priceCard('Grupo pequeño', ranges.small, convertTourPrice(tour.walkingPriceSmall, currency, paymentType, false), unit);
            if (tour.walkingPriceMedium) html += priceCard('Grupo mediano', ranges.medium, convertTourPrice(tour.walkingPriceMedium, currency, paymentType, false), unit);
            if (tour.walkingPriceLarge) html += priceCard('Grupo grande', ranges.large, convertTourPrice(tour.walkingPriceLarge, currency, paymentType, false), unit);
        }
        // --- Precios generales (fallback) ---
        else if (tour.price || tour.price_child || tour.price_no_alcohol || tour.base_price) {
            if (tour.price || tour.base_price) html += priceCard('Adulto', tour.price ? 'Con alcohol' : 'Precio base', convertTourPrice(tour.price || tour.base_price, currency, paymentType, true), perUnit);
            if (tour.price_child) html += priceCard('Niño', 'Menor de edad', convertTourPrice(tour.price_child, currency, paymentType, true), perUnit);
            if (tour.price_no_alcohol) html += priceCard('Sin alcohol', 'Sin bebidas alcohólicas', convertTourPrice(tour.price_no_alcohol, currency, paymentType, true), perUnit);
        }

        if (!html) {
            html = `<p class="exp-lux__quote">Precios por confirmar</p>`;
        }

        // Pie: moneda / método de pago / servicio (solo vehículo). Se actualiza con los filtros.
        const payMap = { efectivo: 'Efectivo', transferencia: 'Transferencia bancaria', tarjeta: 'Tarjeta de crédito' };
        const currencyMap = { MXN: 'MXN — Peso Mexicano', USD: 'USD — US Dollar' };
        const metaRows = [['Moneda', currencyMap[currency] || currency]];
        if (payMap[paymentType]) metaRows.push(['Método de pago', payMap[paymentType]]);
        if (!isWalkingTour && tour.priceData && tour.priceData.length > 0) {
            metaRows.push(['Servicio', currentGuideFilter === 'with-driver' ? 'Guía + Chofer' : 'Solo Guía']);
        }
        html += `<div class="exp-lux__price-meta">${metaRows.map(([k, v]) => `<div class="exp-lux__price-meta-row"><span>${k}</span><span>${v}</span></div>`).join('')}</div>`;

        pricesContent.innerHTML = html;
    }
    
    // Helper function to format availability
    function formatAvailability(availability) {
        if (!availability) return 'No especificada';
        if (typeof availability === 'string') return availability;
        
        if (Array.isArray(availability)) {
            const days = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
            return availability.map(daySchedule => {
                if (typeof daySchedule === 'object' && daySchedule.day !== undefined) {
                    const dayName = days[daySchedule.day] || `Día ${daySchedule.day}`;
                    if (daySchedule.startTime && daySchedule.endTime) {
                        return `${dayName}: ${daySchedule.startTime} - ${daySchedule.endTime}`;
                    }
                    return dayName;
                }
                return daySchedule;
            }).join('<br>');
        }
        return 'Todos los días';
    }
    
    // Optimized image loading utility
    function getOptimizedImageUrl(photo, size = 'medium') {
        // If it's just a string URL, return it as-is
        if (typeof photo === 'string') {
            return photo;
        }
        
        // Check for optimized variants first (best quality formats first)
        if (photo.optimizedVariants) {
            // Prefer AVIF > WebP > JPEG for best compression
            if (photo.optimizedVariants.avif && photo.optimizedVariants.avif.url) {
                return photo.optimizedVariants.avif.url;
            }
            if (photo.optimizedVariants.webp && photo.optimizedVariants.webp.url) {
                return photo.optimizedVariants.webp.url;
            }
            if (photo.optimizedVariants.jpeg && photo.optimizedVariants.jpeg.url) {
                return photo.optimizedVariants.jpeg.url;
            }
        }
        
        // Check optimization metadata formats
        if (photo.optimizationMetadata && photo.optimizationMetadata.formats) {
            const formats = photo.optimizationMetadata.formats;
            // Prefer AVIF > WebP > JPEG
            if (formats.avif && formats.avif.url) {
                return formats.avif.url;
            }
            if (formats.webp && formats.webp.url) {
                return formats.webp.url;
            }
            if (formats.jpeg && formats.jpeg.url) {
                return formats.jpeg.url;
            }
        }
        
        // Fallback to direct properties
        if (photo.webp) return photo.webp;
        if (photo.avif) return photo.avif;
        if (photo.jpeg) return photo.jpeg;
        if (photo.url) return photo.url;
        
        // Final fallback
        return photo.s3Key ? `https://amexing-bucket.s3.us-east-2.amazonaws.com/${photo.s3Key}` : '/img/amexing_logo_horizontal.avif';
    }
    
    // Create optimized picture element with multiple source formats
    function createOptimizedPicture(photo, alt, className = '', sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw') {
        if (typeof photo === 'string') {
            return `<img src="${photo}" alt="${alt}" class="${className}" loading="lazy" sizes="${sizes}" onload="this.classList.add('loaded')" onerror="this.classList.add('error')">`;
        }
        
        let sources = [];
        
        // Add AVIF source (best compression)
        if (photo.optimizedVariants?.avif?.url || photo.optimizationMetadata?.formats?.avif?.url || photo.avif) {
            const avifUrl = photo.optimizedVariants?.avif?.url || 
                           photo.optimizationMetadata?.formats?.avif?.url || 
                           photo.avif;
            sources.push(`<source srcset="${avifUrl}" type="image/avif">`);
        }
        
        // Add WebP source (good compression)
        if (photo.optimizedVariants?.webp?.url || photo.optimizationMetadata?.formats?.webp?.url || photo.webp) {
            const webpUrl = photo.optimizedVariants?.webp?.url || 
                           photo.optimizationMetadata?.formats?.webp?.url || 
                           photo.webp;
            sources.push(`<source srcset="${webpUrl}" type="image/webp">`);
        }
        
        // Fallback image (JPEG or original)
        const fallbackUrl = getOptimizedImageUrl(photo);
        
        return `
            <picture>
                ${sources.join('\n                ')}
                <img src="${fallbackUrl}" alt="${alt}" class="${className}" loading="lazy" sizes="${sizes}" onload="this.classList.add('loaded')" onerror="this.classList.add('error')">
            </picture>
        `;
    }
    
    // Full-screen gallery functionality
    let currentGalleryPhotos = [];
    let currentPhotoIndex = 0;
    let galleryZoom = 1;
    let galleryPanX = 0;
    let galleryPanY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    
    // Store gallery photos when loading gallery tab
    function storeGalleryPhotos(photos, tourName) {
        currentGalleryPhotos = photos.map((photo, index) => {
            return {
                url: getOptimizedImageUrl(photo),
                alt: `${tourName} - Foto ${index + 1}`,
                photo: photo // Store original photo object for full optimization
            };
        });
    }
    
    // Open full-screen gallery at specific photo
    function openFullscreenGallery(photoIndex) {
        if (currentGalleryPhotos.length === 0) return;
        
        currentPhotoIndex = photoIndex;
        const modal = new bootstrap.Modal(document.getElementById('fullscreenGalleryModal'));
        
        updateGalleryDisplay();
        modal.show();
        
        // Initialize event listeners for gallery buttons
        setTimeout(() => {
            initializeGalleryEventListeners();
        }, 100);
        
        // Reset zoom and pan
        resetGalleryZoom();
    }
    
    // Update gallery display
    function updateGalleryDisplay() {
        const mainImage = document.getElementById('galleryMainImage');
        const counter = document.getElementById('galleryCounter');
        const prevBtn = document.getElementById('galleryPrevBtn');
        const nextBtn = document.getElementById('galleryNextBtn');
        const thumbnailsContainer = document.getElementById('galleryThumbnails');
        
        if (currentGalleryPhotos.length === 0) return;
        
        const currentPhoto = currentGalleryPhotos[currentPhotoIndex];
        mainImage.src = currentPhoto.url;
        mainImage.alt = currentPhoto.alt;
        
        // Update counter
        counter.textContent = `${currentPhotoIndex + 1} / ${currentGalleryPhotos.length}`;
        
        // Update navigation buttons
        prevBtn.style.display = currentGalleryPhotos.length > 1 ? 'flex' : 'none';
        nextBtn.style.display = currentGalleryPhotos.length > 1 ? 'flex' : 'none';
        
        // Update thumbnails
        if (currentGalleryPhotos.length > 1) {
            const thumbnailsHtml = currentGalleryPhotos.map((photo, index) => `
                <div class="thumbnail-item ${index === currentPhotoIndex ? 'active' : ''}" data-thumbnail-index="${index}">
                    <img src="${photo.url}" alt="${photo.alt}" loading="lazy">
                </div>
            `).join('');
            
            thumbnailsContainer.innerHTML = thumbnailsHtml;
            
            // Add event listeners to thumbnails
            thumbnailsContainer.querySelectorAll('.thumbnail-item').forEach((thumbnail, index) => {
                thumbnail.addEventListener('click', () => goToPhoto(index));
            });
        } else {
            thumbnailsContainer.innerHTML = '';
        }
    }
    
    // Navigation functions
    function goToPhoto(index) {
        if (index >= 0 && index < currentGalleryPhotos.length) {
            currentPhotoIndex = index;
            updateGalleryDisplay();
            resetGalleryZoom();
        }
    }
    
    function nextPhoto() {
        const nextIndex = currentPhotoIndex + 1;
        if (nextIndex < currentGalleryPhotos.length) {
            goToPhoto(nextIndex);
        } else {
            goToPhoto(0); // Loop to first photo
        }
    }
    
    function prevPhoto() {
        const prevIndex = currentPhotoIndex - 1;
        if (prevIndex >= 0) {
            goToPhoto(prevIndex);
        } else {
            goToPhoto(currentGalleryPhotos.length - 1); // Loop to last photo
        }
    }
    
    // Zoom and pan functions
    function zoomIn() {
        galleryZoom = Math.min(galleryZoom * 1.5, 5); // Max 5x zoom
        applyZoomAndPan();
    }
    
    function zoomOut() {
        galleryZoom = Math.max(galleryZoom / 1.5, 1); // Min 1x zoom
        if (galleryZoom === 1) {
            galleryPanX = 0;
            galleryPanY = 0;
        }
        applyZoomAndPan();
    }
    
    function resetGalleryZoom() {
        galleryZoom = 1;
        galleryPanX = 0;
        galleryPanY = 0;
        applyZoomAndPan();
    }
    
    function applyZoomAndPan() {
        const mainImage = document.getElementById('galleryMainImage');
        mainImage.style.transform = `scale(${galleryZoom}) translate(${galleryPanX}px, ${galleryPanY}px)`;
        
        if (galleryZoom > 1) {
            mainImage.classList.add('zoomed');
        } else {
            mainImage.classList.remove('zoomed');
        }
    }
    
    // Initialize gallery event listeners when DOM is ready
    function initializeGalleryEventListeners() {
        const prevBtn = document.getElementById('galleryPrevBtn');
        const nextBtn = document.getElementById('galleryNextBtn');
        const zoomInBtn = document.getElementById('zoomInBtn');
        const zoomOutBtn = document.getElementById('zoomOutBtn');
        const resetZoomBtn = document.getElementById('resetZoomBtn');
        
        if (prevBtn && !prevBtn.hasAttribute('data-listener-added')) {
            prevBtn.addEventListener('click', prevPhoto);
            prevBtn.setAttribute('data-listener-added', 'true');
        }
        
        if (nextBtn && !nextBtn.hasAttribute('data-listener-added')) {
            nextBtn.addEventListener('click', nextPhoto);
            nextBtn.setAttribute('data-listener-added', 'true');
        }
        
        if (zoomInBtn && !zoomInBtn.hasAttribute('data-listener-added')) {
            zoomInBtn.addEventListener('click', zoomIn);
            zoomInBtn.setAttribute('data-listener-added', 'true');
        }
        
        if (zoomOutBtn && !zoomOutBtn.hasAttribute('data-listener-added')) {
            zoomOutBtn.addEventListener('click', zoomOut);
            zoomOutBtn.setAttribute('data-listener-added', 'true');
        }
        
        if (resetZoomBtn && !resetZoomBtn.hasAttribute('data-listener-added')) {
            resetZoomBtn.addEventListener('click', resetGalleryZoom);
            resetZoomBtn.setAttribute('data-listener-added', 'true');
        }
    }
    
    // Event listeners for gallery
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize gallery event listeners
        initializeGalleryEventListeners();
        
        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            const modal = document.getElementById('fullscreenGalleryModal');
            if (modal.classList.contains('show')) {
                switch(e.key) {
                    case 'ArrowLeft':
                        e.preventDefault();
                        prevPhoto();
                        break;
                    case 'ArrowRight':
                        e.preventDefault();
                        nextPhoto();
                        break;
                    case 'Escape':
                        e.preventDefault();
                        bootstrap.Modal.getInstance(modal)?.hide();
                        break;
                    case '+':
                    case '=':
                        e.preventDefault();
                        zoomIn();
                        break;
                    case '-':
                        e.preventDefault();
                        zoomOut();
                        break;
                    case '0':
                        e.preventDefault();
                        resetGalleryZoom();
                        break;
                }
            }
        });
        
        // Mouse pan functionality for zoomed images
        const mainImage = document.getElementById('galleryMainImage');
        
        mainImage.addEventListener('mousedown', function(e) {
            if (galleryZoom > 1) {
                isDragging = true;
                dragStartX = e.clientX - galleryPanX;
                dragStartY = e.clientY - galleryPanY;
                e.preventDefault();
            }
        });
        
        document.addEventListener('mousemove', function(e) {
            if (isDragging && galleryZoom > 1) {
                galleryPanX = e.clientX - dragStartX;
                galleryPanY = e.clientY - dragStartY;
                
                // Limit panning to reasonable bounds
                const maxPan = 200 * galleryZoom;
                galleryPanX = Math.max(-maxPan, Math.min(maxPan, galleryPanX));
                galleryPanY = Math.max(-maxPan, Math.min(maxPan, galleryPanY));
                
                applyZoomAndPan();
                e.preventDefault();
            }
        });
        
        document.addEventListener('mouseup', function() {
            isDragging = false;
        });
        
        // Wheel zoom
        mainImage.addEventListener('wheel', function(e) {
            e.preventDefault();
            if (e.deltaY < 0) {
                zoomIn();
            } else {
                zoomOut();
            }
        });
    });
    
    // Make functions globally available
    window.openFullscreenGallery = openFullscreenGallery;
    window.goToPhoto = goToPhoto;
    
    // Authentication is handled via session cookies automatically
    
    // Initialize the component
    async function init() {
        await Promise.all([
            loadAvailableRates(),
            loadExchangeRate(),
            loadTransferRate(),
            loadAgencyRate(),
            loadDriverTourRate()
        ]);
        await loadTours();
    }
    
    // Start the application
    init();
});
</script>
