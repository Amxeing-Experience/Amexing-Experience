                            <div class="row g-3">
                                ${rateGroup.prices.map(priceData => {
                                    // Adjust capacity based on guide filter (driver takes a seat)
                                    const baseCapacity = priceData.vehicleType?.defaultCapacity || 0;
                                    const adjustedCapacity = currentGuideFilter === 'with-driver' && baseCapacity > 0 
                                        ? baseCapacity - 1 
                                        : baseCapacity;
                                    
                                    // Determine if this is a vehicle tour (has driver option)
                                    const hasDriver = true; // Vehicle tours can have drivers
                                    
                                    return `
                                    <div class="col-md-6">
                                        <div class="price-card" style="border-left: 3px solid ${rateGroup.color};">
                                            <div class="price-icon" style="background-color: ${rateGroup.color};">
