<%
/**
 * Unified Tours Card Layout Component
 * Displays both walking tours and vehicle tours in a single unified section
 * with a tour type filter for department managers
 *
 * @param {string} userRole - Current user role
 * @param {boolean} showActions - Whether to show action buttons
 * @param {boolean} showClientPricing - Whether to show client-specific pricing
 * @param {string} clientId - Client ID for pricing context
 * @param {string} tableId - Unique table identifier
 * @param {string} apiEndpoint - API endpoint for tours data
 *
 * Created by Denisse Maldonado
 */

// Setup component parameters
const currentUserRole = typeof userRole !== 'undefined' ? userRole : 'admin';
const isDepartmentManager = currentUserRole === 'department_manager';
const isClient = currentUserRole === 'client';
const dtTableId = typeof tableId !== 'undefined' ? tableId : 'tours-cards';
%>

<!-- Tours Cards Section -->
<div class="card border-0 shadow-sm">
    <div class="card-header text-white" style="background: var(--brand-gradient); border: none;">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="card-title mb-0 text-white">
                    <i class="ti ti-map me-2"></i>Tours
                </h5>
            </div>
        </div>
    </div>

    <!-- Filter Controls -->
    <div class="card-body border-bottom bg-light">
        <!-- Desktop Layout (lg and above) -->
        <div class="d-none d-lg-block">
            <!-- Row 1: Pills + Search -->
            <div class="d-flex align-items-end gap-3 mb-3">
                <!-- Tour Type Pills -->
                <div>
                    <label class="form-label fw-semibold mb-2">Tipo de Tour</label>
                    <ul class="nav nav-pills" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active tour-type-pill" data-tour-type="all" type="button" role="tab">
                                Todos
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link tour-type-pill" data-tour-type="walking" type="button" role="tab">
                                <i class="ti ti-walk me-1"></i>A Pie
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link tour-type-pill" data-tour-type="vehicle" type="button" role="tab">
                                <i class="ti ti-car me-1"></i>Con Vehiculos
                            </button>
                        </li>
                    </ul>
                </div>

                <!-- Service Type Pills (vehicle-only) -->
                <div id="vehicleFiltersDesktop">
                    <label class="form-label fw-semibold mb-2">Tipo de Servicio</label>
                    <ul class="nav nav-pills" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active filter-pill" data-filter="guide-only" type="button" role="tab">
                                Solo Guia
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link filter-pill" data-filter="with-driver" type="button" role="tab">
                                Guia + Chofer
                            </button>
                        </li>
                    </ul>
                </div>

                <!-- Search (fills remaining space) -->
                <div class="flex-grow-1">
                    <label for="searchTour" class="form-label fw-semibold mb-2">
                        <i class="ti ti-search me-1"></i>Buscar
                    </label>
                    <input type="text" class="form-control" id="searchTour" placeholder="Buscar...">
                </div>
            </div>

            <!-- Row 2: Segmento left, Moneda+Pago right -->
            <div class="d-flex align-items-center gap-2">
                <!-- Rate Selection (vehicle-only) - pushed left -->
                <div class="d-flex align-items-center gap-1" id="rateFilterDesktopContainer">
                    <label for="rateFilter-<%= dtTableId %>" class="form-label mb-0 text-muted">Segmento:</label>
                    <select class="form-select" id="rateFilter-<%= dtTableId %>" style="min-width: 150px;">
                        <option value="">Seleccionar segmento...</option>
                    </select>
                </div>

                <!-- Spacer pushes Moneda+Pago to the right -->
                <div class="flex-grow-1"></div>

                <!-- Currency -->
                <div class="d-flex align-items-center gap-1">
                    <label for="currencyFilter-<%= dtTableId %>" class="form-label mb-0 text-muted">Moneda:</label>
                    <select class="form-select" id="currencyFilter-<%= dtTableId %>" style="min-width: 100px;">
                        <option value="MXN" selected>MXN</option>
                        <option value="USD">USD</option>
                    </select>
                </div>

                <!-- Payment Type -->
                <div class="d-flex align-items-center gap-1">
                    <label for="paymentTypeFilter-<%= dtTableId %>" class="form-label mb-0 text-muted">Pago:</label>
                    <select class="form-select" id="paymentTypeFilter-<%= dtTableId %>" style="min-width: 140px;">
                        <% if (isDepartmentManager || isClient) { %>
                            <option value="efectivo">Efectivo</option>
                            <option value="transferencia" selected>Transferencia</option>
                        <% } else { %>
                            <option value="efectivo" selected>Efectivo</option>
                            <option value="transferencia">Transferencia</option>
                        <% } %>
                        <option value="tarjeta">Tarjeta Debito/Credito</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Tablet and Mobile Layout (md and below) -->
        <div class="d-lg-none">
            <!-- Tour Type Filter Row -->
            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label class="form-label fw-semibold mb-2">Tipo de Tour</label>
                    <ul class="nav nav-pills" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active tour-type-pill" data-tour-type="all" type="button" role="tab">
                                Todos
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link tour-type-pill" data-tour-type="walking" type="button" role="tab">
                                <i class="ti ti-walk me-1"></i>A Pie
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link tour-type-pill" data-tour-type="vehicle" type="button" role="tab">
                                <i class="ti ti-car me-1"></i>Con Vehiculos
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
            <!-- First Row: Search and Service Type Pills -->
            <div class="row g-3 mb-3">
                <!-- Search -->
                <div class="col-md-6 col-12">
                    <label for="searchTourMobile" class="form-label fw-semibold">
                        <i class="ti ti-search me-1"></i>Buscar Tour
                    </label>
                    <input type="text" class="form-control search-input" id="searchTourMobile" placeholder="Buscar...">
                </div>

                <!-- Service Type Pills (vehicle-only) -->
                <div class="col-md-6 col-12" id="vehicleFiltersMobile">
                    <label class="form-label fw-semibold mb-2">Tipo de Servicio</label>
                    <ul class="nav nav-pills" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active filter-pill" data-filter="guide-only" type="button" role="tab">
                                Solo Guia
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link filter-pill" data-filter="with-driver" type="button" role="tab">
                                Guia + Chofer
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Second Row: Filter Dropdowns -->
            <div class="row g-3">
                <!-- Rate Selection (vehicle-only) -->
                <div class="col-md-4 col-12" id="rateFilterMobileContainer">
                    <label for="rateFilterMobile-<%= dtTableId %>" class="form-label fw-semibold">
                        <i class="ti ti-tag me-1"></i>Segmento
                    </label>
                    <select class="form-select rate-filter" id="rateFilterMobile-<%= dtTableId %>">
                        <option value="">Seleccionar segmento...</option>
                    </select>
                </div>

                <!-- Currency -->
                <div class="col-md-4 col-6">
                    <label for="currencyFilterMobile-<%= dtTableId %>" class="form-label fw-semibold">
                        <i class="ti ti-currency-dollar me-1"></i>Moneda
                    </label>
                    <select class="form-select currency-filter" id="currencyFilterMobile-<%= dtTableId %>">
                        <option value="MXN" selected>MXN</option>
                        <option value="USD">USD</option>
                    </select>
                </div>

                <!-- Payment Type -->
                <div class="col-md-4 col-6">
                    <label for="paymentTypeFilterMobile-<%= dtTableId %>" class="form-label fw-semibold">
                        <i class="ti ti-credit-card me-1"></i>Pago
                    </label>
                    <select class="form-select payment-filter" id="paymentTypeFilterMobile-<%= dtTableId %>">
                        <% if (isDepartmentManager || isClient) { %>
                            <option value="efectivo">Efectivo</option>
                            <option value="transferencia" selected>Transferencia</option>
                        <% } else { %>
                            <option value="efectivo" selected>Efectivo</option>
                            <option value="transferencia">Transferencia</option>
                        <% } %>
                        <option value="tarjeta">Tarjeta Debito/Credito</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Area -->
    <div class="card-body">
        <!-- Loading state -->
        <div id="toursLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando tours...</span>
            </div>
            <p class="mt-2 text-muted">Cargando tours...</p>
        </div>

        <!-- Tours Grid -->
        <div id="toursGrid" class="d-flex flex-wrap gap-3" style="display: none;">
            <!-- Tour cards will be dynamically inserted here -->
        </div>

        <!-- No results message -->
        <div id="noToursMessage" class="text-center py-5" style="display: none;">
            <i class="ti ti-mood-sad" style="font-size: 3rem; color: #dee2e6;"></i>
            <p class="mt-3 text-muted">No se encontraron tours con los filtros seleccionados</p>
        </div>
    </div>
</div>

<!-- Tour Details Modal -->
<div class="modal fade" id="tourDetailsModal" tabindex="-1" aria-labelledby="tourDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content tour-modal">
            <!-- Hero Section with Image -->
            <div class="tour-hero-section">
                <div class="tour-hero-image-container">
                    <img id="tourHeroImage" src="" alt="" class="tour-hero-image">
                    <div class="tour-hero-overlay">
                        <h2 id="tourHeroTitle" class="tour-hero-title"></h2>
                    </div>
                </div>
                <button type="button" class="tour-modal-close" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar">
                    <i class="ti ti-x"></i>
                </button>
            </div>

            <!-- Tab Navigation -->
            <div class="tour-tabs-container">
                <ul class="nav nav-pills tour-nav-tabs" id="tourTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="info-tab" data-bs-toggle="pill" data-bs-target="#info" type="button" role="tab">
                            <i class="ti ti-info-circle me-1"></i>
                            Información
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="gallery-tab" data-bs-toggle="pill" data-bs-target="#gallery" type="button" role="tab">
                            <i class="ti ti-photo me-1"></i>
                            Galería
                            <span class="badge bg-primary ms-1" id="photoCountBadge">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="details-tab" data-bs-toggle="pill" data-bs-target="#details" type="button" role="tab">
                            <i class="ti ti-list-details me-1"></i>
                            Detalles
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="prices-tab" data-bs-toggle="pill" data-bs-target="#prices" type="button" role="tab">
                            <i class="ti ti-currency-dollar me-1"></i>
                            Precios
                        </button>
                    </li>
                </ul>
            </div>

            <!-- Modal Body with Tab Content -->
            <div class="modal-body tour-modal-body">
                <div class="tab-content" id="tourTabContent">
                    <!-- Information Tab -->
                    <div class="tab-pane fade show active" id="info" role="tabpanel">
                        <div id="infoContent">
                            <!-- Content will be loaded here -->
                        </div>
                    </div>

                    <!-- Gallery Tab -->
                    <div class="tab-pane fade" id="gallery" role="tabpanel">
                        <div id="galleryContent">
                            <!-- Content will be loaded here -->
                        </div>
                    </div>

                    <!-- Details Tab -->
                    <div class="tab-pane fade" id="details" role="tabpanel">
                        <div id="detailsContent">
                            <!-- Content will be loaded here -->
                        </div>
                    </div>

                    <!-- Prices Tab -->
                    <div class="tab-pane fade" id="prices" role="tabpanel">
                        <div id="pricesContent">
                            <!-- Content will be loaded here -->
                        </div>
                    </div>
                </div>

                <!-- Loading State -->
                <div id="tourModalLoading" class="text-center py-5" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando detalles del tour...</span>
                    </div>
                    <p class="mt-3 text-muted">Cargando información...</p>
                </div>
            </div>
                <% if (currentUserRole === 'department_manager' || currentUserRole === 'client') { %>
                <div class="modal-footer border-top" id="tourModalFooter">
                    <button type="button" class="btn btn-primary add-tour-to-quote-from-modal-btn">
                        <i class="ti ti-file-plus me-2"></i>Agregar a Cotización
                    </button>
                </div>
                <% } %>
        </div>
    </div>
</div>

<!-- Add to Quote Picker Modal for Tours -->
<% if (currentUserRole === 'department_manager' || currentUserRole === 'client') { %>
<div class="modal fade" id="addTourToQuoteModal" tabindex="-1" aria-labelledby="addTourToQuoteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTourToQuoteLabel">
                    <i class="ti ti-file-plus me-2"></i>Agregar a Cotización
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3" id="addTourToQuoteName"></p>

                <div class="create-new-quote-option mb-3" id="createNewQuoteBtnTour">
                    <i class="ti ti-plus me-2"></i>Crear nueva cotización
                </div>

                <div class="text-muted small mb-2">o seleccionar cotización existente:</div>

                <input type="text" class="form-control form-control-sm tour-quote-search-input mb-3"
                       id="tourQuoteSearchInput" placeholder="Buscar por folio o cliente...">

                <div id="tourQuotePickerLoading" class="text-center py-4" style="display: none;">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <div class="text-muted small mt-2">Cargando cotizaciones...</div>
                </div>

                <div id="tourQuotePickerList" class="quote-picker-list" style="display: none;"></div>

                <div id="tourQuoteActionLoading" class="text-center py-4" style="display: none;">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="text-muted small mt-2">Agregando tour...</div>
                </div>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- Full-Screen Gallery Modal -->
<div class="modal fade" id="fullscreenGalleryModal" tabindex="-1" aria-labelledby="fullscreenGalleryLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content fullscreen-gallery-modal">
            <div class="modal-header border-0 position-absolute top-0 start-0 w-100" style="z-index: 1060;">
                <div class="d-flex justify-content-between align-items-center w-100 p-3">
                    <h5 class="modal-title text-white" id="fullscreenGalleryLabel">Galería de Fotos</h5>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-white gallery-counter" id="galleryCounter">1 / 1</span>
                        <button type="button" class="gallery-close-btn" data-bs-dismiss="modal" aria-label="Cerrar galería" title="Cerrar galería">
                            <i class="ti ti-x"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-body p-0 d-flex align-items-center justify-content-center position-relative">
                <!-- Main Image Display -->
                <div class="gallery-main-container">
                    <img id="galleryMainImage" src="" alt="" class="gallery-main-image">
                </div>
                
                <!-- Navigation Arrows -->
                <button class="gallery-nav gallery-nav-prev" id="galleryPrevBtn">
                    <i class="ti ti-chevron-left"></i>
                </button>
                <button class="gallery-nav gallery-nav-next" id="galleryNextBtn">
                    <i class="ti ti-chevron-right"></i>
                </button>
                
                <!-- Zoom Controls -->
                <div class="gallery-controls position-absolute bottom-0 start-50 translate-middle-x mb-4">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-dark btn-sm" id="zoomOutBtn">
                            <i class="ti ti-minus"></i>
                        </button>
                        <button type="button" class="btn btn-dark btn-sm" id="resetZoomBtn">
                            <i class="ti ti-refresh"></i>
                        </button>
                        <button type="button" class="btn btn-dark btn-sm" id="zoomInBtn">
                            <i class="ti ti-plus"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Thumbnails Strip -->
            <div class="gallery-thumbnails position-absolute bottom-0 start-0 w-100">
                <div class="thumbnails-container p-3" id="galleryThumbnails">
                    <!-- Thumbnails will be populated here -->
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Tour Details Modal Styles */
.tour-modal {
    border: none;
    border-radius: 1rem;
    overflow: hidden;
}

.tour-hero-section {
    position: relative;
    height: 350px;
    overflow: hidden;
}

.tour-hero-image-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.tour-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
}

/* Progressive Loading for Hero Image */
.tour-hero-image-container.loading::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    animation: shimmer 1.5s infinite;
    z-index: 1;
}

.tour-hero-image-container.loading .tour-hero-image {
    opacity: 0.7;
}

.tour-hero-image-container.loaded .tour-hero-image {
    opacity: 1;
}

.tour-hero-image-container.error {
    background: #f8f9fa;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6c757d;
    font-size: 1.1rem;
}

.tour-hero-image-container.error::after {
    content: '📷 Imagen no disponible';
    z-index: 2;
}

.tour-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    padding: 2rem;
}

.tour-hero-title {
    color: white;
    margin: 0;
    font-size: 2rem;
    font-weight: 600;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
}

.tour-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.95);
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-size: 1.5rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    opacity: 1;
    z-index: 100;
}

.tour-modal-close:hover {
    background: rgba(255, 255, 255, 1);
    border-color: rgba(255, 255, 255, 1);
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
    color: #dc3545;
}

.tour-modal-close:focus {
    outline: 2px solid rgba(255, 255, 255, 0.8);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.3);
}

.tour-modal-close:active {
    transform: scale(1.05);
}

.tour-modal-close i {
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
}

.tour-tabs-container {
    background: #f8f9fa;
    padding: 0 1.5rem;
}

.tour-nav-tabs {
    border-bottom: none;
    gap: 0;
    padding-top: 1rem;
    width: 100%;
}

.tour-nav-tabs .nav-item {
    flex: 1;
}

.tour-nav-tabs .nav-link {
    border: none;
    background: transparent;
    color: #6c757d;
    font-weight: 500;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    width: 100%;
    text-align: center;
}

.tour-nav-tabs .nav-link:hover {
    background: rgba(13, 110, 253, 0.1);
    color: var(--brand-primary-active);
}

.tour-nav-tabs .nav-link.active {
    background: var(--brand-primary);
    color: white;
    border-color: var(--brand-primary-active);
}

.tour-modal-body {
    padding: 2rem;
    min-height: 300px;
}

/* Responsive Design */
@media (max-width: 768px) {
    .tour-hero-section {
        height: 250px;
    }
    
    .tour-hero-title {
        font-size: 1.5rem;
    }
    
    .tour-nav-tabs .nav-link {
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
    }
    
    .tour-nav-tabs .nav-link span:not(.badge) {
        display: none;
    }
    
    .tour-modal-body {
        padding: 1rem;
    }
}

/* Modal Content Styles */
.content-section {
    margin-bottom: 2rem;
}

.content-section h5 {
    color: #495057;
    font-weight: 600;
    margin-bottom: 1rem;
}

/* Respetar saltos de línea en los campos de texto libre del detalle */
.content-section p,
.info-card p,
.notes-content,
.requirements-content,
.recommendations-content,
.restrictions-content,
.activities-content,
.features-content {
    white-space: pre-line;
}

.info-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 0.5rem;
    height: 100%;
}

.info-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-primary);
    color: white;
    border-radius: 50%;
    font-size: 1.25rem;
    flex-shrink: 0;
}

.info-card h6 {
    margin: 0 0 0.25rem 0;
    font-weight: 600;
    color: #495057;
}

.photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
}

.gallery-item {
    border-radius: 0.5rem;
    overflow: hidden;
    aspect-ratio: 4/3;
}

.gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.gallery-item img:hover {
    transform: scale(1.05);
}

.includes-list, .excludes-list {
