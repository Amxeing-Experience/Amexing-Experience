    <% if (currentUserRole === 'department_manager' || currentUserRole === 'client') { %>
    // ========== Add Tour to Quote (módulo genérico compartido: /dashboard/js/utils/add-to-quote.js) ==========
    (function() {
        // ── Tours A PIE (walking): un solo botón por tour ──
        // El precio real depende del nº de personas (tramo chico/mediano/grande × horas),
        // y eso lo calcula la cotización. Aquí guardamos el subconcepto walking con
        // default de 1 persona (tramo chico) para que no quede en $0, y el builder
        // recalcula el tramo/precio al ajustar el nº de personas en la cotización.
        function buildWalkingTourSubconcept(t) {
            const minHours = parseFloat(t.minHours) || 1;
            let smallPrice = parseFloat(t.walkingPriceSmall) || 0;
            const origCurrency = (t.walkingCurrency || 'MXN').toUpperCase();
            // El builder guarda walkingTourPrice en MXN: convertir si el tour está en USD.
            if (origCurrency === 'USD' && currentExchangeRate) {
                smallPrice = Math.round(smallPrice * currentExchangeRate);
            }
            const total = Math.round(smallPrice * minHours * 100) / 100; // 1 persona → tramo chico
            return {
                type: 'tour',
                tourId: t.id,
                title: t.name,
                isWalkingTour: true,
                walkingPriceMode: 'calculated',
                walkingTourCurrency: origCurrency,
                walkingTourPeopleCount: 1,
                adultsQuantity: 1,
                childrenQuantity: 0,
                infantsQuantity: 0,
                persons: 1,
                duration: minHours,
                hours: minHours,
                walkingTourPrice: total,
                unitPrice: total,
                total: total,
                includeGuide: false,
                includeGreeter: false,
                time: '',
                selectedSchedule: '',
                notes: ''
            };
        }

        function openTourAddToQuote(tour) {
            if (!tour) return;
            const sub = buildWalkingTourSubconcept(tour);
            const totalFmt = (sub.total || 0).toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
            const minHours = parseFloat(tour.minHours) || 1;
            AddToQuote.open({
                userRole: '<%= currentUserRole %>',
                serviceLabel: 'Tour a pie',
                itemLabel: '<strong>' + (tour.name || 'Tour') + '</strong>' +
                    '<br><span class="small">$' + totalFmt + ' MXN · 1 persona · mín ' + minHours + 'h · ajusta el nº de personas en la cotización</span>',
                buildSubconcept: function() { return buildWalkingTourSubconcept(tour); }
            });
        }

        // Add to Quote desde la card (solo tours a pie)
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.add-tour-to-quote-btn');
            if (!btn) return;
            openTourAddToQuote({
                id: btn.dataset.tourId,
                name: btn.dataset.tourName,
                walkingPriceSmall: btn.dataset.walkingPriceSmall,
                walkingCurrency: btn.dataset.walkingCurrency,
                minHours: btn.dataset.minHours
            });
        });

        // Add to Quote desde el modal de detalle
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.add-tour-to-quote-from-modal-btn')) return;
            const cur = window._currentModalTour;
            if (!cur) return;
            const detailModal = bootstrap.Modal.getInstance(document.getElementById('tourDetailsModal'));
            if (detailModal) detailModal.hide();
            setTimeout(function() { openTourAddToQuote(cur); }, 300);
        });

        // ── Tours CON vehículo: se agrega POR vehículo (como traslados) ──
        // Precio guardado = base por hora + recargo de chofer (solo si "Guía + Chofer").
        // Sin % de método de pago ni conversión de moneda: eso lo aplica la cotización.
        function buildTourVehicleSubconcept(d) {
            const base = parseFloat(d.basePrice) || 0;        // base por hora del vehículo (sin chofer)
            const withDriver = d.withDriver === '1';           // "Guía + Chofer"
            const driverRate = parseFloat(d.driverRate) || 0;  // recargo de chofer (por hora, pesos)
            const hourly = base + (withDriver ? driverRate : 0);
            const hours = parseFloat(d.minHours) || 1;         // mínimo de horas del tour
            const total = Math.round(hourly * hours * 100) / 100;
            return {
                type: 'tour',
                tourId: d.tourId,
                title: d.tourName,
                isWalkingTour: false,
                requiresTransport: true,
                vehicleId: d.vehicleId || '',
                vehicleType: d.vehicleName || '',       // el builder guarda el nombre en vehicleType (compat)
                vehicleTypeName: d.vehicleName || '',
                vehicleCapacity: parseInt(d.vehicleCapacity) || 0,
                includeGuide: withDriver,                // en tours el guía siempre va; este flag agrega el CHOFER (Guía+Chofer)
                rateId: d.rateId || '',
                rateName: d.rateName || '',
                hourlyPrice: hourly,
                baseVehiclePrice: base,                  // base sin chofer, para recomputar bien al editar
                hours: hours,
                duration: hours,
                unitPrice: hourly,
                total: total,
                numberOfPeople: 1,
                time: '',
                selectedSchedule: '',
                notes: ''
            };
        }

        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.add-tour-vehicle-to-quote-btn');
            if (!btn) return;
            e.preventDefault();
            e.stopPropagation();
            const d = Object.assign({}, btn.dataset);
            const base = parseFloat(d.basePrice) || 0;
            const withDriver = d.withDriver === '1';
            const hourly = base + (withDriver ? (parseFloat(d.driverRate) || 0) : 0);
            const minHours = parseFloat(d.minHours) || 1;
            const totalToSave = Math.round(hourly * minHours * 100) / 100;
            const priceFmt = hourly.toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
            const totalFmt = totalToSave.toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
            // Cerrar el modal de detalle si el botón vino de ahí
            const detailModal = bootstrap.Modal.getInstance(document.getElementById('tourDetailsModal'));
            const openIt = function() {
                AddToQuote.open({
                    userRole: '<%= currentUserRole %>',
                    serviceLabel: 'Tour con vehículo',
                    itemLabel: '<strong>' + (d.tourName || 'Tour') + ' — ' + (d.vehicleName || '') + '</strong>' +
                        '<br><span class="small">$' + totalFmt + ' MXN · ' + priceFmt + '/h × mín ' + minHours + 'h · ' +
                        (d.vehicleCapacity || '') + ' pers. · ' + (withDriver ? 'Guía + Chofer' : 'Solo Guía') + '</span>',
                    buildSubconcept: function() { return buildTourVehicleSubconcept(d); }
                });
            };
            if (detailModal) { detailModal.hide(); setTimeout(openIt, 300); } else { openIt(); }
        });
    })();
    <% } %>

    // Function to show tour details modal
    async function showTourDetailsModal(tourId, tourName, tourType) {
        const modal = new bootstrap.Modal(document.getElementById('tourDetailsModal'));
        const heroTitle = document.getElementById('tourHeroTitle');
        const heroImage = document.getElementById('tourHeroImage');
        const modalLoading = document.getElementById('tourModalLoading');
        const detailBody = document.getElementById('tourDetailBody');

        // Set initial data and show loading
        heroTitle.textContent = tourName;
        heroImage.src = '/img/amexing_logo_horizontal.avif'; // Default placeholder
        heroImage.style.objectFit = 'contain';
        heroImage.style.background = '#ffffff';
        heroImage.style.padding = '20px';
        modalLoading.style.display = 'block';
        if (detailBody) detailBody.innerHTML = '';

        // Show modal
        modal.show();
        
        try {
            // Always fetch complete tour data from individual tour API endpoint
            // This ensures we get all tour fields including those missing from the tours list
            console.log('Fetching complete tour details from API for tourId:', tourId);
            const response = await fetch(`/api/tours/${tourId}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('authToken') || ''}`,
                    'Content-Type': 'application/json'
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al cargar los detalles del tour');
            }
            
            const tourData = await response.json();
            console.log('Complete tour data from API:', tourData);
            const tourDetail = tourData.data.tour || tourData.data;
            console.log('Final tour detail object:', tourDetail);

            // Store tour for Add to Quote button
            window._currentModalTour = {
                id: tourId,
                name: tourDetail.destinationPOI?.name || tourName,
                type: 'tour',
                price: tourDetail.price || 0,
                isWalkingTour: !!tourDetail.isWalkingTour,
                walkingPriceSmall: tourDetail.walkingPriceSmall || 0,
                walkingCurrency: tourDetail.walkingPriceCurrency || 'MXN',
                minHours: tourDetail.time ? (parseInt(tourDetail.time) / 60) : 1
            };
            // El footer "Agregar a cotización" (global, por persona) solo aplica a tours a pie;
            // los tours con vehículo se agregan por vehículo desde la pestaña de precios.
            const _quoteFooter = document.getElementById('tourDetailQuoteFooter');
            if (_quoteFooter) _quoteFooter.style.display = tourDetail.isWalkingTour ? '' : 'none';
            console.log('All tour data fields:', Object.keys(tourDetail));
            console.log('Tour data field categories:', {
                basic: Object.keys(tourDetail).filter(key => !key.includes('_') && !key.includes('price') && !key.includes('Price')),
                pricing: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('price') || key.toLowerCase().includes('cost')),
                capacity: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('capacity') || key.toLowerCase().includes('people') || key.toLowerCase().includes('pax')),
                schedule: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('time') || key.toLowerCase().includes('duration') || key.toLowerCase().includes('schedule')),
                location: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('location') || key.toLowerCase().includes('point') || key.toLowerCase().includes('destination')),
                content: Object.keys(tourDetail).filter(key => key.toLowerCase().includes('include') || key.toLowerCase().includes('description') || key.toLowerCase().includes('note'))
            });
            await loadTourDetailsIntoModal(tourDetail, tourName);
            
        } catch (error) {
            console.error('Error loading tour details:', error);
            showModalError('No se pudieron cargar los detalles del tour');
        }
    }
    
    // Carga los detalles del tour en el modal de lujo (diseño de dos columnas).
    // Réplica de loadExperienceDetailsIntoModal: hero + pills, galería, cuerpo y precios.
    async function loadTourDetailsIntoModal(tour, tourName) {
        const modalLoading = document.getElementById('tourModalLoading');
        const heroImage = document.getElementById('tourHeroImage');
        const heroTitle = document.getElementById('tourHeroTitle');
        const heroCategory = document.getElementById('tourHeroCategory');
        const heroType = document.getElementById('tourHeroType');
        const detailBody = document.getElementById('tourDetailBody');

        try {
            // Guardar el tour completo para recalcular precios al cambiar los filtros.
            window._currentModalTourData = tour;

            // ---- Imagen principal (hero) con carga progresiva ----
            const heroImageContainer = heroImage.parentElement;
            heroImageContainer.classList.remove('loading', 'loaded', 'error');
            heroImage.onload = null;
            heroImage.onerror = null;

            let imageUrl = '';
            if (tour.photos && tour.photos.length > 0) {
                imageUrl = getOptimizedImageUrl(tour.photos[0]);
            } else if (tour.primaryPhoto) {
                imageUrl = getOptimizedImageUrl(tour.primaryPhoto);
            }
            if (imageUrl) {
                heroImage.style.objectFit = 'cover';
                heroImage.style.background = '';
                heroImage.style.padding = '';
            } else {
                imageUrl = '/img/amexing_logo_horizontal.avif';
                heroImage.style.objectFit = 'contain';
                heroImage.style.background = '#ffffff';
                heroImage.style.padding = '20px';
            }

            if (imageUrl && !imageUrl.startsWith('data:')) {
                heroImageContainer.classList.add('loading');
                heroImage.onload = () => {
                    heroImageContainer.classList.remove('loading');
                    heroImageContainer.classList.add('loaded');
                };
                heroImage.onerror = () => {
                    heroImageContainer.classList.remove('loading');
                    heroImage.src = '/img/amexing_logo_horizontal.avif';
                    heroImage.style.objectFit = 'contain';
                    heroImage.style.background = '#ffffff';
                    heroImage.style.padding = '20px';
                };
            }
            heroImage.src = imageUrl;
            if (imageUrl && !imageUrl.startsWith('data:') && heroImage.complete && heroImage.naturalHeight !== 0) {
                heroImage.dispatchEvent(new Event('load'));
            }

            // ---- Título + pills de categoría/tipo del panel izquierdo ----
            if (heroTitle) heroTitle.textContent = tour.destinationPOI?.name || tourName || '';
            if (heroCategory) {
                const catVal = tour.type;
                if (catVal) {
                    heroCategory.textContent = String(catVal).toUpperCase();
                    heroCategory.style.display = '';
                } else {
                    heroCategory.style.display = 'none';
                }
            }
            if (heroType) {
                heroType.textContent = tour.isWalkingTour ? 'Tour a pie' : 'Con vehículo';
                heroType.style.display = '';
            }

            // ---- Guardar fotos para el visor a pantalla completa (mecanismo reutilizado) ----
            if (tour.photos && tour.photos.length > 0) {
                storeGalleryPhotos(tour.photos, tourName);
            } else {
                currentGalleryPhotos = [];
            }

            // ---- Render del cuerpo (todo excepto precios, que inyecta loadPricesTab) ----
            detailBody.innerHTML = renderTourDetailBody(tour);

            // Galería: clic en miniatura → cambia el hero; clic en hero → visor a pantalla completa.
            const thumbEls = detailBody.querySelectorAll('.exp-lux__thumb');
            thumbEls.forEach((el) => {
                el.addEventListener('click', () => {
                    const idx = parseInt(el.dataset.photoIndex, 10) || 0;
                    if (el.dataset.photoUrl) {
                        heroImage.src = el.dataset.photoUrl;
                        heroImage.style.objectFit = 'cover';
                        heroImage.style.background = '';
                        heroImage.style.padding = '';
                    }
                    heroImage.dataset.currentIndex = idx;
                    thumbEls.forEach((t) => t.classList.toggle('is-active', t === el));
                });
            });
            heroImage.dataset.currentIndex = 0;

            const mediaPane = heroImage.closest('.exp-lux__media');
            const expandBtn = document.getElementById('tourHeroExpand');
            const hasGallery = currentGalleryPhotos.length > 0;
            if (mediaPane) {
                mediaPane.style.cursor = hasGallery ? 'zoom-in' : '';
                mediaPane.onclick = () => {
                    if (hasGallery) openFullscreenGallery(parseInt(heroImage.dataset.currentIndex, 10) || 0);
                };
            }
            if (expandBtn) expandBtn.style.display = hasGallery ? '' : 'none';

            // Navegación de la tira: flechas ‹ › y rueda del mouse (vertical → horizontal).
            const galStrip = detailBody.querySelector('.exp-lux__gallery');
            const galPrev = detailBody.querySelector('.exp-lux__gallery-nav--prev');
            const galNext = detailBody.querySelector('.exp-lux__gallery-nav--next');
            if (galStrip && galPrev && galNext) {
                const galStep = () => Math.max(galStrip.clientWidth * 0.75, 200);
                const galUpdateNav = () => {
                    const maxScroll = galStrip.scrollWidth - galStrip.clientWidth - 2;
                    galPrev.classList.toggle('is-hidden', galStrip.scrollLeft <= 0);
                    galNext.classList.toggle('is-hidden', maxScroll <= 0 || galStrip.scrollLeft >= maxScroll);
                };
                galPrev.addEventListener('click', () => galStrip.scrollBy({ left: -galStep(), behavior: 'smooth' }));
                galNext.addEventListener('click', () => galStrip.scrollBy({ left: galStep(), behavior: 'smooth' }));
                galStrip.addEventListener('scroll', galUpdateNav);
                galStrip.addEventListener('wheel', (e) => {
                    if (galStrip.scrollWidth <= galStrip.clientWidth) return;
                    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                        galStrip.scrollLeft += e.deltaY;
                        e.preventDefault();
                    }
                }, { passive: false });
                galUpdateNav();
                setTimeout(galUpdateNav, 300);
            }

            // Render de la sección de precios (separada para refrescar al cambiar filtros).
            loadPricesTab(tour);

            // Ocultar el loading.
            modalLoading.style.display = 'none';

        } catch (error) {
            console.error('Error processing tour data:', error);
            showModalError('Error al procesar los datos del tour');
        }
    }

    // Construye el cuerpo de detalle de lujo (todas las secciones excepto precios,
    // que inyecta loadPricesTab en #pricesContent para poder re-renderizarlas al
    // cambiar moneda/pago/servicio). Réplica de renderExperienceDetailBody.
    function renderTourDetailBody(tour) {
        // Acepta arrays O strings delimitados por saltos de línea para campos de lista.
        const toArr = (v) => {
            if (!v) return [];
            if (Array.isArray(v)) return v.filter(x => x !== null && x !== undefined && String(x).trim() !== '');
            return String(v).split(/\r?\n/).map(s => s.trim()).filter(Boolean);
        };

        const sections = [];

        // 1. Descripción (serif, sin itálica).
        if (tour.description) {
            sections.push(`<div class="exp-lux__section"><p class="exp-lux__desc">${tour.description}</p></div>`);
        }

        // 2. Tiles: Duración, Tipo de recorrido y Capacidad.
        let durVal = '';
        if (tour.time) {
            const totalMinutes = parseInt(tour.time);
            const hours = Math.floor(totalMinutes / 60);
            const minutes = totalMinutes % 60;
            if (hours > 0 && minutes > 0) durVal = `${hours}h ${minutes}min`;
            else if (hours > 0) durVal = `${hours} ${hours === 1 ? 'hora' : 'horas'}`;
            else durVal = `${minutes} min`;
        }
        const tiles = [
            ['MÍNIMO DE HORAS', durVal || '—'],
        ];
        const minP = tour.min_people;
        const maxP = tour.max_people;
        let capVal = '';
        if (minP && maxP) capVal = `${minP}–${maxP} personas`;
        else if (maxP) capVal = `Máximo ${maxP} personas`;
        else if (minP) capVal = `Mínimo ${minP} personas`;
        if (capVal) tiles.push(['CAPACIDAD', capVal]);
        sections.push(`
            <div class="exp-lux__tiles">
                ${tiles.map(([label, val]) => `
                <div class="exp-lux__tile">
                    <span class="exp-lux__tile-label">${label}</span>
                    <span class="exp-lux__tile-value">${val}</span>
                </div>`).join('')}
            </div>
        `);

        // 3. Disponibilidad: desglose por día con horarios si existe; si no, fila DÍAS DISPONIBLES.
        const to12h = (hhmm) => {
            const m = String(hhmm || '').match(/^(\d{1,2}):(\d{2})/);
            if (!m) return '';
            let h = parseInt(m[1], 10);
            const min = m[2];
            const ampm = h >= 12 ? 'pm' : 'am';
            h = h % 12; if (h === 0) h = 12;
            return h + ':' + min + ' ' + ampm;
        };
        const schedDayAbbr = {
            '0': 'Do', '7': 'Do', 'sunday': 'Do', 'domingo': 'Do',
            '1': 'Lu', 'monday': 'Lu', 'lunes': 'Lu',
            '2': 'Ma', 'tuesday': 'Ma', 'martes': 'Ma',
            '3': 'Mi', 'wednesday': 'Mi', 'miércoles': 'Mi', 'miercoles': 'Mi',
            '4': 'Ju', 'thursday': 'Ju', 'jueves': 'Ju',
            '5': 'Vi', 'friday': 'Vi', 'viernes': 'Vi',
            '6': 'Sa', 'saturday': 'Sa', 'sábado': 'Sa', 'sabado': 'Sa'
        };
        const schedShort = { 'Lu': 'Lun', 'Ma': 'Mar', 'Mi': 'Mié', 'Ju': 'Jue', 'Vi': 'Vie', 'Sa': 'Sáb', 'Do': 'Dom' };
        const schedFull = { 'Lu': 'Lunes', 'Ma': 'Martes', 'Mi': 'Miércoles', 'Ju': 'Jueves', 'Vi': 'Viernes', 'Sa': 'Sábado', 'Do': 'Domingo' };
        const schedOrder = ['Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa', 'Do'];
        const kv = [];
        let scheduleRendered = false;
        if (Array.isArray(tour.availability) && tour.availability.length) {
            const perDay = {};
            tour.availability.forEach(entry => {
                if (!entry || typeof entry !== 'object') return;
                let dv = entry.day !== undefined ? entry.day : (entry.Day !== undefined ? entry.Day : (entry.name !== undefined ? entry.name : entry.value));
                if (dv === null || dv === undefined) return;
                const abbr = schedDayAbbr[String(dv).toLowerCase().trim()];
                if (!abbr) return;
                const times = [];
                if (Array.isArray(entry.times)) {
                    entry.times.forEach(t => {
                        if (!t) return;
                        const s = to12h(t.start || t.startTime || t.start_time);
                        const e = to12h(t.end || t.endTime || t.end_time);
                        if (s) times.push(e ? `${s} – ${e}` : s);
                    });
                } else if (entry.startTime || entry.start_time) {
                    const s = to12h(entry.startTime || entry.start_time);
                    const e = to12h(entry.endTime || entry.end_time);
                    if (s) times.push(e ? `${s} – ${e}` : s);
                }
                if (!perDay[abbr]) perDay[abbr] = [];
                times.forEach(t => { if (!perDay[abbr].includes(t)) perDay[abbr].push(t); });
            });
            const activeDays = Object.keys(perDay).sort((a, b) => schedOrder.indexOf(a) - schedOrder.indexOf(b));
            const anyTimes = activeDays.some(d => perDay[d].length);
            if (activeDays.length && anyTimes) {
                const groups = [];
                activeDays.forEach(d => {
                    const key = perDay[d].join('|');
                    const g = groups.find(gr => gr.key === key);
                    if (g) g.days.push(d); else groups.push({ key, days: [d], times: perDay[d] });
                });
                const rowsHtml = groups.map(g => {
                    let label;
                    if (g.days.length === 7) label = 'Todos los días';
                    else if (g.days.length === 1) label = schedFull[g.days[0]];
                    else label = g.days.map(d => schedShort[d]).join(', ');
                    const timesHtml = g.times.length
                        ? g.times.map(t => `<span class="exp-lux__sched-time">${t}</span>`).join('')
                        : '<span class="exp-lux__sched-time exp-lux__sched-time--muted">Horario por confirmar</span>';
                    return `<div class="exp-lux__sched-row"><span class="exp-lux__sched-days">${label}</span><span class="exp-lux__sched-times">${timesHtml}</span></div>`;
                }).join('');
                sections.push(`
                    <div class="exp-lux__section">
                        <h4 class="exp-lux__heading">${tour.fixed_schedule ? 'HORARIOS' : 'HORARIOS SUGERIDOS'}</h4>
                        <div class="exp-lux__sched">${rowsHtml}</div>
                    </div>
                `);
                scheduleRendered = true;
            }
        }
        // Fallback: días disponibles como texto (misma lógica que el card).
        if (!scheduleRendered) {
            kv.push(['DÍAS DISPONIBLES', getTourAvailabilityText(tour)]);
        }

        // 4. Incluye / No incluye en 2 columnas.
        const inc = toArr(tour.includes);
        const ninc = toArr(tour.notincludes);
        if (inc.length || ninc.length) {
            const incCol = inc.length ? `
                    <div class="exp-lux__inc-col">
                        <h4 class="exp-lux__heading">INCLUYE</h4>
                        <ul class="exp-lux__list">
                            ${inc.map(i => `<li><span class="exp-lux__check">✓</span><span>${i}</span></li>`).join('')}
                        </ul>
                    </div>` : '';
            const nincCol = ninc.length ? `
                    <div class="exp-lux__inc-col">
                        <h4 class="exp-lux__heading">NO INCLUYE</h4>
                        <ul class="exp-lux__list exp-lux__list--muted">
                            ${ninc.map(i => `<li><span class="exp-lux__cross">×</span><span>${i}</span></li>`).join('')}
                        </ul>
                    </div>` : '';
            sections.push(`
                <div class="exp-lux__section">
                    <div class="exp-lux__inc-grid">${incCol}${nincCol}</div>
                </div>
            `);
        }

        // 5. Galería: tira horizontal con TODAS las fotos.
        if (tour.photos && tour.photos.length > 0) {
            const thumbs = tour.photos.map((photo, index) => {
                const url = getOptimizedImageUrl(photo) || '/img/amexing_logo_horizontal.avif';
                return `<button type="button" class="exp-lux__thumb${index === 0 ? ' is-active' : ''}" data-photo-index="${index}" data-photo-url="${url}" style="background-image:url('${url}')" aria-label="Ver foto ${index + 1}"></button>`;
            }).join('');
            sections.push(`
                <div class="exp-lux__section">
                    <div class="exp-lux__gallery-head">
                        <h4 class="exp-lux__heading">GALERÍA</h4>
                        <div class="exp-lux__gallery-navs">
                            <button type="button" class="exp-lux__gallery-nav exp-lux__gallery-nav--prev is-hidden" aria-label="Anterior"><i class="ti ti-chevron-left"></i></button>
                            <button type="button" class="exp-lux__gallery-nav exp-lux__gallery-nav--next" aria-label="Siguiente"><i class="ti ti-chevron-right"></i></button>
                        </div>
                    </div>
                    <div class="exp-lux__gallery">${thumbs}</div>
                </div>
            `);
        }

        // 6. Reserva: anticipación + notas de reserva.
        const advMin = tour.advance_booking_time || tour.advanceBookingTime || tour.advanceBooking;
        const bookingNotes = tour.client_booking_notes || tour.notes;
        if (advMin || bookingNotes) {
            let reservaInner = '';
            if (advMin) {
                reservaInner += `<p class="exp-lux__resv-adv">Reservar con al menos <span class="exp-lux__resv-adv-value">${formatAdvanceBooking(advMin)}</span> de anticipación.</p>`;
            }
            if (bookingNotes) {
                reservaInner += `<p class="exp-lux__prewrap exp-lux__resv-notes">${bookingNotes}</p>`;
            }
            sections.push(`
                <div class="exp-lux__section">
                    <h4 class="exp-lux__heading">RESERVA</h4>
                    ${reservaInner}
                </div>
            `);
        }

        // 7. Key-value (días disponibles fallback, idioma, etc.). La ubicación no se
        //    incluye porque el destino ya es el título del hero.
        if (kv.length) {
            sections.push(`
                <div class="exp-lux__section">
                    <div class="exp-lux__kv">
                        ${kv.map(([k, v]) => `<div class="exp-lux__kv-row"><span class="exp-lux__kv-key">${k}</span><span class="exp-lux__kv-val">${v}</span></div>`).join('')}
                    </div>
                </div>
            `);
        }

        // Idioma como chips.
        const langs = Array.isArray(tour.languages) ? tour.languages : (tour.languages ? [tour.languages] : []);
        if (langs.length) {
            sections.push(`
                <div class="exp-lux__section">
                    <h4 class="exp-lux__heading">IDIOMA</h4>
                    <div class="exp-lux__chips">
                        ${langs.map(l => `<span class="exp-lux__chip">${l}</span>`).join('')}
                    </div>
                </div>
            `);
        }

        // 8. Placeholder de precios (lo llena loadPricesTab).
        sections.push(`
            <div class="exp-lux__section">
                <h4 class="exp-lux__heading">PRECIOS</h4>
                <div id="pricesContent" class="exp-lux__prices"></div>
            </div>
        `);

        return sections.join('');
    }

    // Texto de días disponibles para el detalle (misma lógica que el card).
    function getTourAvailabilityText(tour) {
        let availabilityText = 'Todos los días';
        let availableDays = null;
        const dayNameToShort = {
            'domingo': 'Do', 'lunes': 'Lu', 'martes': 'Ma',
            'miércoles': 'Mi', 'miercoles': 'Mi', 'jueves': 'Ju',
            'viernes': 'Vi', 'sábado': 'Sa', 'sabado': 'Sa'
        };
        if (tour.availability && Array.isArray(tour.availability) && tour.availability.length > 0) {
            if (typeof tour.availability[0] === 'object' && 'day' in tour.availability[0]) {
                availableDays = tour.availability.map(schedule => schedule.day);
            } else {
                availableDays = tour.availability;
            }
        } else if (tour.availableDays && Array.isArray(tour.availableDays) && tour.availableDays.length > 0) {
            if (typeof tour.availableDays[0] === 'string') {
                const shortDays = tour.availableDays.map(name => dayNameToShort[name.toLowerCase()]).filter(Boolean);
                if (shortDays.length > 0 && shortDays.length < 7) {
                    shortDays.sort((a, b) => {
                        const order = ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'];
                        return order.indexOf(a) - order.indexOf(b);
                    });
                    availabilityText = shortDays.join(', ');
                } else if (shortDays.length >= 7) {
                    availabilityText = 'Todos los días';
                }
                availableDays = null;
            } else {
                availableDays = tour.availableDays;
            }
        } else if (tour.availability && typeof tour.availability === 'object' && tour.availability.availableDays) {
            availableDays = tour.availability.availableDays;
        }
        if (availableDays && Array.isArray(availableDays) && availableDays.length > 0) {
            const dayNames = ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'];
            const validDays = availableDays.filter(day => Number.isInteger(day) && day >= 0 && day <= 6);
            if (validDays.length === 7) {
                availabilityText = 'Todos los días';
            } else if (validDays.length > 0) {
                const weekOrder = d => (d + 6) % 7;
                const days = validDays.sort((a, b) => weekOrder(a) - weekOrder(b)).map(day => dayNames[day]).filter(Boolean);
                availabilityText = days.join(', ');
            }
        }
        return availabilityText;
    }

    // Función para mostrar error en el modal
    function showModalError(message) {
        const modalLoading = document.getElementById('tourModalLoading');
        const detailBody = document.getElementById('tourDetailBody');

        modalLoading.style.display = 'block';
        modalLoading.innerHTML = `
            <div class="alert alert-danger">
