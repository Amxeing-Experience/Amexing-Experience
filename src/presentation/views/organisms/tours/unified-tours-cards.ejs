<!-- Load centralized pricing utilities -->
<script src="/dashboard/js/utils/pricing-utils.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tour management functionality
    let allTours = [];
    let filteredTours = [];
    let availableRates = [];
    let currentExchangeRate = 20; // Default exchange rate MXN to USD
    let currentTransferRate = 0; // Transfer payment surcharge percentage
    let currentAgencyRate = 0; // Credit card payment surcharge percentage
    let currentDriverTourRate = 0; // Driver tour rate surcharge percentage
    let currentGuideFilter = 'guide-only'; // Filter for guide type - default to guide-only (Solo Guía)
    let selectedRateId = null; // Currently selected rate
    let currentTourTypeFilter = 'all'; // 'all', 'walking', 'vehicle'

    // DOM elements
    const toursLoading = document.getElementById('toursLoading');
    const toursGrid = document.getElementById('toursGrid');
    const noToursMessage = document.getElementById('noToursMessage');
    
    // Search inputs (desktop and mobile)
    const searchInputDesktop = document.getElementById('searchTour');
    const searchInputMobile = document.getElementById('searchTourMobile');
    
    // Filter elements (desktop and mobile)
    const currencyFilterDesktop = document.getElementById('currencyFilter-<%= dtTableId %>');
    const currencyFilterMobile = document.getElementById('currencyFilterMobile-<%= dtTableId %>');
    const paymentFilterDesktop = document.getElementById('paymentTypeFilter-<%= dtTableId %>');
    const paymentFilterMobile = document.getElementById('paymentTypeFilterMobile-<%= dtTableId %>');
    const rateFilterDesktop = document.getElementById('rateFilter-<%= dtTableId %>');
    const rateFilterMobile = document.getElementById('rateFilterMobile-<%= dtTableId %>');
    
    const filterPills = document.querySelectorAll('.filter-pill');
    
    // Load available rates from API
    async function loadAvailableRates() {
        try {
            console.log('Loading available segmentos from /api/rates/active...');
            const response = await fetch('/api/rates/active');
            console.log('Rate API response status:', response.status, response.statusText);
            
            if (response.ok) {
                const data = await response.json();
                console.log('Rate API response data:', data);
                
                if (data.success && data.data) {
                    // Filter out "Económico" rate
                    availableRates = data.data.filter(rate => {
                        const rateName = (rate.label || rate.name || '').toLowerCase();
                        return !rateName.includes('económico') && !rateName.includes('economico');
                    });
                    console.log('Available segmentos loaded:', availableRates.length, 'segmentos (excluding Económico):', availableRates);
                    populateRateDropdown();
                } else {
                    console.warn('Rate API returned success=false or no data:', data);
                }
            } else {
                console.warn('Rate API request failed:', response.status, response.statusText);
            }
        } catch (error) {
            console.warn('Could not load available rates:', error);
        }
    }
    
    // Populate rate dropdown with available rates
    function populateRateDropdown() {
        // Clear both desktop and mobile dropdowns
        if (rateFilterDesktop) rateFilterDesktop.innerHTML = '';
        if (rateFilterMobile) rateFilterMobile.innerHTML = '';
        
        console.log('Populating rates:', availableRates);
        
        availableRates.forEach((rate, index) => {
            const optionDesktop = document.createElement('option');
            const optionMobile = document.createElement('option');
            
            const value = rate.value || rate.id;
            const text = rate.label || rate.name || `Tarifa ${rate.value || rate.id}`;
            const color = rate.color || '#000';
            
            // Configure desktop option
            if (rateFilterDesktop) {
                optionDesktop.value = value;
                optionDesktop.textContent = text;
                optionDesktop.style.color = color;
                if (index === 0) {
                    optionDesktop.selected = true;
                    selectedRateId = value;
                }
                rateFilterDesktop.appendChild(optionDesktop);
            }
            
            // Configure mobile option
            if (rateFilterMobile) {
                optionMobile.value = value;
                optionMobile.textContent = text;
                optionMobile.style.color = color;
                if (index === 0) {
                    optionMobile.selected = true;
                    selectedRateId = value;
                }
                rateFilterMobile.appendChild(optionMobile);
            }
            
            console.log('Added segmento:', text, 'ID:', value);
        });
        
        console.log('Segmento dropdown populated with', availableRates.length, 'segmentos');
        console.log('Auto-selected first segmento:', selectedRateId);
    }
    
    // Load rates functions
    async function loadExchangeRate() {
        try {
            const response = await fetch('/api/exchange-rate/current');
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.data && data.data.value !== undefined) {
                    currentExchangeRate = parseFloat(data.data.value);
                    console.log('Exchange rate loaded:', currentExchangeRate, 'MXN per USD');
                }
            }
        } catch (error) {
            console.warn('Could not load exchange rate, using default:', currentExchangeRate);
        }
    }
    
    async function loadTransferRate() {
        try {
            const response = await fetch('/api/transfer-rate/current');
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.data && data.data.value !== undefined) {
                    currentTransferRate = parseFloat(data.data.value);
                }
            }
        } catch (error) {
            console.warn('Could not load transfer rate, using default:', currentTransferRate);
        }
    }
    
    async function loadAgencyRate() {
        try {
            const response = await fetch('/api/agency-rate/current');
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.data && data.data.value !== undefined) {
                    currentAgencyRate = parseFloat(data.data.value);
                }
            }
        } catch (error) {
            console.warn('Could not load agency rate, using default:', currentAgencyRate);
        }
    }
    
    async function loadDriverTourRate() {
        try {
            const response = await fetch('/api/driver-tour-rate/current');
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.data && data.data.value !== undefined) {
                    currentDriverTourRate = parseFloat(data.data.value);
                    console.log('Driver tour rate loaded:', currentDriverTourRate, 'pesos');
                }
            }
        } catch (error) {
            console.warn('Could not load driver tour rate, using default:', currentDriverTourRate);
        }
    }
    
    // Convert and format price based on currency and payment type
    function convertTourPrice(priceInput, currency, paymentType, hasDriver = false) {
        const price = parseFloat(priceInput || 0);
        
        if (price <= 0) {
            return currency === 'USD' ? '$0.00 USD' : '$0.00';
        }
        
        // First apply driver surcharge if driver is included (fixed amount in pesos)
        let adjustedPrice = price;
        if (hasDriver && currentGuideFilter === 'with-driver' && currentDriverTourRate > 0) {
            adjustedPrice = price + currentDriverTourRate;
        }
        
        // Then apply payment surcharge if not cash
        if (paymentType === 'transferencia' && currentTransferRate > 0) {
            adjustedPrice = adjustedPrice * (1 + currentTransferRate / 100);
        } else if (paymentType === 'tarjeta' && currentAgencyRate > 0) {
            adjustedPrice = adjustedPrice * (1 + currentAgencyRate / 100);
        }
        
        // Then convert to requested currency
        if (currency === 'USD') {
            const usdPrice = adjustedPrice / currentExchangeRate;
            // Apply USD rounding rules and format without decimals
            const roundedPrice = PricingUtils ? PricingUtils.applyUSDRoundingRules(usdPrice) : Math.round(usdPrice);
            return `$${roundedPrice} USD`;
        } else {
            return `$${adjustedPrice.toFixed(2)}`;
        }
    }

    // Helper function to get walking tour group ranges consistently
    function getWalkingTourRanges(tour) {
        return {
            small: tour.walkingRangeSmall ? tour.walkingRangeSmall.replace(' pax', ' personas') : '1-5 personas',
            medium: tour.walkingRangeMedium ? tour.walkingRangeMedium.replace(' pax', ' personas') : '6-10 personas',
            large: tour.walkingRangeLarge ? tour.walkingRangeLarge.replace(' pax', ' personas') : '11-15 personas'
        };
    }

    // Helper function to extract pricing for walking tours
    function getWalkingTourPricing(tour) {
        const ranges = getWalkingTourRanges(tour);
        const defaultPricing = {
            small: '$1,050 MXN',
            medium: '$2,100 MXN',
            large: '$3,150 MXN',
            smallNumber: 1050,
            mediumNumber: 2100,
            largeNumber: 3150,
            smallRange: ranges.small,
            mediumRange: ranges.medium,
            largeRange: ranges.large,
            hasTourPricing: false
        };

        if (tour.walkingPriceSmall && tour.walkingPriceMedium && tour.walkingPriceLarge) {
            const currency = tour.walkingPriceCurrency || 'MXN';
            const ranges = getWalkingTourRanges(tour);

            return {
                small: '$' + tour.walkingPriceSmall.toLocaleString() + ' ' + currency,
                medium: '$' + tour.walkingPriceMedium.toLocaleString() + ' ' + currency,
                large: '$' + tour.walkingPriceLarge.toLocaleString() + ' ' + currency,
                smallNumber: tour.walkingPriceSmall,
                mediumNumber: tour.walkingPriceMedium,
                largeNumber: tour.walkingPriceLarge,
                smallRange: ranges.small,
                mediumRange: ranges.medium,
                largeRange: ranges.large,
                hasTourPricing: true
            };
        }

        if (tour.hasClientPrices && tour.clientPrices) {
            const clientPrices = tour.clientPrices;
            const priceKeys = Object.keys(clientPrices);

            if (priceKeys.length > 0) {
                const firstPrice = clientPrices[priceKeys[0]];
                const basePrice = firstPrice.price || firstPrice.basePrice || 1050;

                return {
                    small: '$' + basePrice.toLocaleString() + ' MXN',
                    medium: '$' + (basePrice * 2).toLocaleString() + ' MXN',
                    large: '$' + (basePrice * 3).toLocaleString() + ' MXN',
                    smallNumber: basePrice,
                    mediumNumber: basePrice * 2,
                    largeNumber: basePrice * 3,
                    smallRange: ranges.small,
                    mediumRange: ranges.medium,
                    largeRange: ranges.large,
                    hasTourPricing: false
                };
            }
        }

        return defaultPricing;
    }

    // Convert walking tour price with payment and currency adjustments
    function convertWalkingPrice(basePrice, currency, paymentType) {
        let adjustedPrice = basePrice;

        // Apply payment surcharge
        if (paymentType === 'transferencia' && currentTransferRate > 0) {
            adjustedPrice = adjustedPrice * (1 + currentTransferRate / 100);
        } else if (paymentType === 'tarjeta' && currentAgencyRate > 0) {
            adjustedPrice = adjustedPrice * (1 + currentAgencyRate / 100);
        }

        // Convert currency
        if (currency === 'USD') {
            const usdPrice = adjustedPrice / currentExchangeRate;
            const roundedPrice = PricingUtils ? PricingUtils.applyUSDRoundingRules(usdPrice) : Math.round(usdPrice);
            return '$' + roundedPrice + ' USD';
        } else {
            return '$' + adjustedPrice.toFixed(2);
        }
    }

    // Load tours from API
    async function loadTours() {
        try {
            showLoading();

            let apiUrl = '<%= apiEndpoint %>';
            let queryParams = new URLSearchParams();

            // If a rate is selected and we're not showing only walking tours, use the tours-with-rate-prices endpoint
            if (selectedRateId && currentTourTypeFilter !== 'walking') {
                apiUrl = '/api/tours/with-rate-prices';
                queryParams.append('rateId', selectedRateId);
                <% if (typeof clientId !== 'undefined' && clientId) { %>
                queryParams.append('clientId', '<%= clientId %>');
                <% } %>
            } else {
                <% if (typeof clientId !== 'undefined' && clientId) { %>
                queryParams.append('clientId', '<%= clientId %>');
                <% } %>
            }

            if (queryParams.toString()) {
                apiUrl += '?' + queryParams.toString();
            }

            console.log('Fetching tours from:', apiUrl);
            const response = await fetch(apiUrl);

            if (!response.ok) {
                throw new Error('HTTP ' + response.status + ': ' + response.statusText);
            }

            const data = await response.json();

            if (data.success && data.data) {
                allTours = data.data; // Include ALL tours (both walking and vehicle)

                allTours.sort((a, b) => {
                    const destA = (a.destinationPOI?.name || '').toLowerCase();
                    const destB = (b.destinationPOI?.name || '').toLowerCase();
                    return destA.localeCompare(destB, 'es', { numeric: true, sensitivity: 'base' });
                });

                applyFilters();
            } else {
                throw new Error(data.message || 'Failed to load tours');
            }
        } catch (error) {
            console.error('Error loading tours:', error);
            showError('Error al cargar los tours');
        }
    }
    
    // Apply filters and search
    function applyFilters() {
        const searchTerm = (searchInputDesktop?.value || searchInputMobile?.value || '').toLowerCase().trim();
        const currency = currencyFilterDesktop?.value || currencyFilterMobile?.value || 'MXN';
        const paymentType = paymentFilterDesktop?.value || paymentFilterMobile?.value || 'efectivo';

        filteredTours = allTours.filter(tour => {
            // Search filter
            const searchMatch = !searchTerm ||
                (tour.destinationPOI?.name && tour.destinationPOI.name.toLowerCase().includes(searchTerm)) ||
                (tour.description && tour.description.toLowerCase().includes(searchTerm));

            // Tour type filter
            let tourTypeMatch = true;
            if (currentTourTypeFilter === 'walking') {
                tourTypeMatch = tour.isWalkingTour === true;
            } else if (currentTourTypeFilter === 'vehicle') {
                tourTypeMatch = !tour.isWalkingTour;
            }

            return searchMatch && tourTypeMatch;
        });

        // Sort tours alphabetically by destination
        filteredTours.sort((a, b) => {
            const destA = (a.destinationPOI?.name || '').toLowerCase();
            const destB = (b.destinationPOI?.name || '').toLowerCase();
            return destA.localeCompare(destB, 'es', { numeric: true, sensitivity: 'base' });
        });

        displayTours();
    }
    
    // Display tours in card layout
    function displayTours() {
        hideLoading();
        
        if (filteredTours.length === 0) {
            showNoResults();
            return;
        }
        
        const currency = currencyFilterDesktop?.value || currencyFilterMobile?.value || 'MXN';
        const paymentType = paymentFilterDesktop?.value || paymentFilterMobile?.value || 'efectivo';
        
        const cardsHTML = filteredTours.map(tour => {
            // Map API data to display format first
            const destination = tour.destinationPOI?.name || 'Destino no especificado';
            
            // Convert minutes to hours and minutes format
            let duration = 'Consultar';
            if (tour.time) {
                const totalMinutes = parseInt(tour.time);
                const hours = Math.floor(totalMinutes / 60);
                const minutes = totalMinutes % 60;

                if (hours > 0 && minutes > 0) {
                    duration = `${hours}h ${minutes}min`;
                } else if (hours > 0) {
                    duration = `${hours}h`;
                } else {
                    duration = `${minutes}min`;
                }
            }
            
            const description = tour.description || 'Descripción no disponible';
            
            // Get availability and booking time
            const advanceBookingTime = tour.advance_booking_time || tour.advanceBookingTime || tour.advanceBooking;
            
            // Debug logging for advance booking time
            console.log('Tour advance booking time:', {
                tourName: tour.destinationPOI?.name,
                advance_booking_time: tour.advance_booking_time,
                advanceBookingTime: tour.advanceBookingTime,
                advanceBooking: tour.advanceBooking,
                allFields: Object.keys(tour).filter(key => key.toLowerCase().includes('advance') || key.toLowerCase().includes('booking'))
            });
            
            // Format availability days - handle different formats
            let availabilityText = 'Todos los días';
            let availableDays = null;

            // Map for converting Spanish day names to short format
            const dayNameToShort = {
                'domingo': 'Do', 'lunes': 'Lu', 'martes': 'Ma',
                'miércoles': 'Mi', 'miercoles': 'Mi', 'jueves': 'Ju',
                'viernes': 'Vi', 'sábado': 'Sa', 'sabado': 'Sa'
            };
            const dayNameOrder = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];

            // Check for availability field first (new format - array of day schedules)
            if (tour.availability && Array.isArray(tour.availability) && tour.availability.length > 0) {
                if (typeof tour.availability[0] === 'object' && 'day' in tour.availability[0]) {
                    availableDays = tour.availability.map(schedule => schedule.day);
                } else {
                    availableDays = tour.availability;
                }
            }
            // Fallback: Check for availableDays field (legacy format - string day names or numeric)
            else if (tour.availableDays && Array.isArray(tour.availableDays) && tour.availableDays.length > 0) {
                // Check if it's string day names (e.g., ["Martes", "Jueves"])
                if (typeof tour.availableDays[0] === 'string') {
                    const shortDays = tour.availableDays
                        .map(name => dayNameToShort[name.toLowerCase()])
                        .filter(Boolean);
                    if (shortDays.length > 0 && shortDays.length < 7) {
                        // Sort by day order
                        shortDays.sort((a, b) => {
                            const order = ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'];
                            return order.indexOf(a) - order.indexOf(b);
                        });
                        availabilityText = shortDays.join(', ');
                    } else if (shortDays.length >= 7) {
                        availabilityText = 'Todos los días';
                    }
                    availableDays = null; // Already handled
                } else {
                    availableDays = tour.availableDays;
                }
            }
            // Check availability as object
            else if (tour.availability && typeof tour.availability === 'object' && tour.availability.availableDays) {
                availableDays = tour.availability.availableDays;
            }

            // Format numeric day codes for display
            if (availableDays && Array.isArray(availableDays) && availableDays.length > 0) {
                const dayNames = ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'];
                const validDays = availableDays.filter(day => Number.isInteger(day) && day >= 0 && day <= 6);

                if (validDays.length === 7) {
                    availabilityText = 'Todos los días';
                } else if (validDays.length > 0) {
                    // Order Monday-first so Sunday (0) shows last (e.g. "Vi, Sa, Do")
                    // instead of first; matches the detail view and locale expectations.
                    const weekOrder = d => (d + 6) % 7;
                    const days = validDays.sort((a, b) => weekOrder(a) - weekOrder(b)).map(day => dayNames[day]).filter(Boolean);
                    availabilityText = days.join(', ');
                }
            }
            
            // Format advance booking time (value is in minutes)
            let bookingTimeText = 'Reserva inmediata';
            if (advanceBookingTime && advanceBookingTime > 0) {
                const totalMinutes = parseInt(advanceBookingTime);
                const hours = Math.floor(totalMinutes / 60);
                const minutes = totalMinutes % 60;
                
                // If 24 hours or more, show in days
                if (hours >= 24) {
                    const days = Math.floor(hours / 24);
                    bookingTimeText = days === 1 ? '1 día' : `${days} días`;
                }
                // If both hours and minutes
                else if (hours > 0 && minutes > 0) {
                    bookingTimeText = `${hours}h ${minutes}min`;
                }
                // If only hours
                else if (hours > 0) {
                    bookingTimeText = hours === 1 ? '1 hora' : `${hours} hrs`;
                }
                // If only minutes
                else {
                    bookingTimeText = minutes === 1 ? '1 minuto' : `${minutes} min`;
                }
            }
            
            // Get pricing information
            let priceSection = '';
            let vehicleInfo = '';
            let typeSection = '';

            if (tour.isWalkingTour) {
                // Walking tour pricing: group-based tiers
                const pricing = getWalkingTourPricing(tour);
                const smallPrice = convertWalkingPrice(pricing.smallNumber, currency, paymentType);
                const mediumPrice = convertWalkingPrice(pricing.mediumNumber, currency, paymentType);
                const largePrice = convertWalkingPrice(pricing.largeNumber, currency, paymentType);

                priceSection = `
                    <div class="vehicle-pricing">
                        <div class="vehicle-option mb-2 p-2 border rounded" style="background: #f0fdf4;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong style="color: #16a34a;"><i class="ti ti-users me-1"></i>${pricing.smallRange || '1-5 personas'}</strong>
                                    <div class="small text-muted">por hora</div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-success" style="font-size: 1.1rem;">${smallPrice}</div>
                                </div>
                            </div>
                        </div>
                        <div class="vehicle-option mb-2 p-2 border rounded" style="background: #fefce8;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong style="color: #ca8a04;"><i class="ti ti-users me-1"></i>${pricing.mediumRange || '6-10 personas'}</strong>
                                    <div class="small text-muted">por hora</div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-success" style="font-size: 1.1rem;">${mediumPrice}</div>
                                </div>
                            </div>
                        </div>
                        <div class="vehicle-option mb-2 p-2 border rounded" style="background: #eff6ff;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong style="color: #2563eb;"><i class="ti ti-users me-1"></i>${pricing.largeRange || '11-15 personas'}</strong>
                                    <div class="small text-muted">por hora</div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-success" style="font-size: 1.1rem;">${largePrice}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } else if (selectedRateId && tour.priceData && tour.priceData.length > 0) {
                // Show detailed vehicles and pricing when rate is selected
                const vehicleCards = tour.priceData.map(priceData => {
                    const vehicleName = priceData.vehicleType?.name || 'Vehículo';
                    const baseCapacity = priceData.vehicleType?.defaultCapacity || 0;
                    let finalPrice = priceData.price || 0;

                    // Adjust capacity based on guide filter
                    let adjustedCapacity = baseCapacity;
                    if (currentGuideFilter === 'with-driver' && baseCapacity > 0) {
                        adjustedCapacity = baseCapacity - 1; // Driver takes a seat
                    }

                    // Check if there's a client-specific price
                    const isClientSpecific = priceData.isClientPrice;

                    // Apply driver rate if "with-driver" is selected
                    const formattedPrice = convertTourPrice(finalPrice, currency, paymentType, true);
                    const clientBadge = isClientSpecific ?
                        '<span class="badge bg-primary text-white ms-1" style="font-size: 0.6rem;">Cliente</span>' : '';

                    return `
                        <div class="vehicle-option mb-2 p-2 border rounded" style="background: #f8f9fa;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong style="color: var(--brand-primary-active);">${vehicleName}</strong>${clientBadge}
                                    <div class="small text-muted">
                                        <i class="ti ti-users me-1"></i>${adjustedCapacity} personas
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-success" style="font-size: 1.1rem;">${formattedPrice}</div>
                                </div>
                            </div>
