                                <% if (currentUserRole === 'department_manager' || currentUserRole === 'client') { %>
                                <button type="button" class="tour-pline-add add-tour-vehicle-to-quote-btn"
                                    data-tour-id="${tour.id || tour.objectId}"
                                    data-tour-name="${(destination || '').replace(/"/g, '&quot;')}"
                                    data-vehicle-id="${priceData.vehicleType?.id || ''}"
                                    data-vehicle-name="${(vehicleName || '').replace(/"/g, '&quot;')}"
                                    data-vehicle-capacity="${adjustedCapacity}"
                                    data-base-price="${finalPrice}"
                                    data-driver-rate="${currentDriverTourRate || 0}"
                                    data-with-driver="${currentGuideFilter === 'with-driver' ? '1' : '0'}"
                                    data-rate-id="${priceData.rate?.id || selectedRateId || ''}"
                                    data-rate-name="${(priceData.rate?.name || rateName || '').replace(/"/g, '&quot;')}"
                                    data-min-hours="${tour.time ? (parseInt(tour.time) / 60) : 1}"
                                    title="Agregar a Cotización">＋</button>
                                <% } %>
                            </span>
