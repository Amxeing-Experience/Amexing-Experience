        // Check for vehicle pricing
        if (tour.priceData && tour.priceData.length > 0) {
            // Group prices by rate
            const pricesByRate = {};
            tour.priceData.forEach(priceData => {
                const rateKey = priceData.rate?.id || 'no-rate';
                const rateName = priceData.rate?.name || 'Tarifa General';
                const rateColor = priceData.rate?.color || '#6c757d';
                
                if (!pricesByRate[rateKey]) {
