<%
/**
 * Sidebar Menu Organism
 * Role-based navigation menu items
 *
 * @param {string} userRole - Current user role
 * @param {string} currentPath - Current page path for active states
 * @param {function} isActiveMenuItem - Helper function to check active state
 */

const rolesHierarchy = {
  superadmin: 7,
  admin: 6,
  department_manager: 5,
  client: 4,
  employee: 3,
  driver: 2,
  guest: 1
};

const allDashboards = [
  { name: "Dashboard Super Admin", icon: "settings", path: "/dashboard/superadmin", level: 7 },
  { name: "Dashboard Admin", icon: "shield-check", path: "/dashboard/admin", level: 6 },
  { name: "Dashboard Agente Admin", icon: "screen-share", path: "/dashboard/department_manager", level: 5 },
  { name: "Dashboard Agente", icon: "user", path: "/dashboard/client", level: 4 }
];
// Get the actual logged-in user's role
// Try to get from passed user object first, then from locals (res.locals is available in all EJS templates)
let actualUserRole = userRole; // Default to the dashboard being viewed
if (typeof user !== 'undefined' && user && user.role) {
    actualUserRole = user.role; // Use passed user object
} else if (typeof locals !== 'undefined' && locals.user && locals.user.role) {
    actualUserRole = locals.user.role; // Use res.locals.user from middleware
}

// For the dropdown, use the actual user's role to determine access
const dashboards = allDashboards.filter( dashboard => dashboard.level <= rolesHierarchy[actualUserRole] );

// Check if admin/superadmin is viewing another dashboard
// If currentPath is empty, determine from userRole parameter (which indicates the dashboard being viewed)
const isViewingDifferentDashboard = (viewedRole, actualRole) => {
    // If we're viewing a dashboard different from our actual role
    return viewedRole !== actualRole;
};

const isAdminViewingOtherDashboard = actualUserRole === 'admin' && 
  (userRole === 'client' || userRole === 'department_manager' || userRole === 'superadmin');
   
const isSuperAdminViewingOtherDashboard = actualUserRole === 'superadmin' && 
  (userRole === 'client' || userRole === 'department_manager' || userRole === 'admin');

// Cliente directo (end_client): el menú varía por tipo de cliente (capacidades). Preferimos
// endClientCaps (de renderDashboard); si no llega, lo derivamos de la categoría (de clientCategory
// o del objeto user, que sí llega a la vista). Debe reflejar endClientCapabilities.js.
const ecCat = (typeof clientCategory !== 'undefined' && clientCategory)
  ? clientCategory
  : ((typeof user !== 'undefined' && user && user.clientCategory) ? user.clientCategory : null);
const ecCaps = (typeof endClientCaps !== 'undefined' && endClientCaps)
  ? endClientCaps
  : {
      viewQuotes: ecCat !== 'home_owner',
      createQuotes: (ecCat === 'wedding_planner' || ecCat === 'concierge'),
      viewTarifario: ecCat === 'wedding_planner',
      dashboardQuotes: ecCat !== 'home_owner',
    };
const endClientActivityItems = [];
if (ecCaps.viewQuotes) {
  endClientActivityItems.push({ name: 'Cotizaciones', icon: 'file-invoice', path: '/dashboard/end_client/quotes', id: 'quotes' });
}
endClientActivityItems.push({ name: 'Reservaciones', icon: 'clipboard-list', path: '/dashboard/end_client/bookings', id: 'bookings' });

// Sección Tarifario (catálogo completo): solo para quien tiene viewTarifario (wedding planner).
const endClientTarifarioItems = ecCaps.viewTarifario ? [
  { name: 'Vehículos', icon: 'car', path: '/dashboard/end_client/vehicles', id: 'vehicles' },
  { name: 'Traslados', icon: 'briefcase', path: '/dashboard/end_client/services', id: 'services' },
  { name: 'A Disposición', icon: 'calculator', path: '/dashboard/end_client/a-disposicion', id: 'a-disposicion' },
  { name: 'Experiencias', icon: 'star', path: '/dashboard/end_client/experiences', id: 'experiences' },
  { name: 'Tours', icon: 'map', path: '/dashboard/end_client/tours', id: 'tours' },
  { name: 'Exportar Tarifario', icon: 'download', path: '/dashboard/end_client/tarifario-export', id: 'tarifario-export' },
] : [];

// Navigation items based on role
const navigationItems = {
    superadmin: [
        // System Management Section - Only Dashboard
        { section: 'System Management', icon: 'ti-settings', items: [
            { name: 'Dashboard Super Admin', icon: 'settings', path: '/dashboard/superadmin', id: 'dashboard',
              dropdown: dashboards
            }
        ]},
        // Users System Section - User Management and Role Management
        { section: 'Users System', icon: 'ti-users', items: [
            { name: 'User Management', icon: 'users', path: '/dashboard/superadmin/users', id: 'users' },
            { name: 'Role Management', icon: 'shield', path: '/dashboard/superadmin/roles', id: 'roles' },
            { name: 'Reportes', icon: 'report', path: '/dashboard/superadmin/reports', id: 'reports' },
            { name: 'Correos', icon: 'mail', path: '/dashboard/superadmin/emails', id: 'emails' }
        ]},
        // Tarifario Section
        { section: 'Tarifario', icon: 'ti-receipt-2', items: [
            { name: 'Gestión de Vehículos', icon: 'car', path: '/dashboard/superadmin/vehicles', id: 'vehicles' },
            { name: 'Gestión de Traslados', icon: 'briefcase', path: '/dashboard/superadmin/services', id: 'services' },
            { name: 'Gestión de Experiencias', icon: 'star', path: '/dashboard/superadmin/experiences', id: 'experiences' },
            { name: 'Gestión de Tours', icon: 'map', path: '/dashboard/superadmin/tours', id: 'tours' },
            { name: 'Greeter', icon: 'user-plus', path: '/dashboard/superadmin/greeter', id: 'greeter' },
            { name: 'Exportar Tarifario', icon: 'download', path: '/dashboard/superadmin/tarifario-export', id: 'tarifario-export' }
        ]},
        // Equipo y Recursos Section
        { section: 'Equipo y Recursos', icon: 'ti-users', items: [
            { name: 'Gestión de Empleados', icon: 'user-check', path: '/dashboard/superadmin/employees', id: 'employees' },
            { name: 'Gestión de Destinos', icon: 'map-pin', path: '/dashboard/superadmin/pois', id: 'pois' }
        ]}
    ],
    admin: [
        // System Management Section - Only Dashboard
        { section: 'System Management', icon: 'ti-settings', items: [
            { name: 'Dashboard Admin', icon: 'shield-check', path: '/dashboard/admin', id: 'dashboard',
              dropdown: dashboards
            }
        ]},
        { section: 'Operaciones Principales', icon: 'ti-dashboard', items: [
            // { name: 'Tablero', icon: 'dashboard', path: '/dashboard/admin', id: 'dashboard' },
            { name: 'Clientes', icon: 'users', path: '/dashboard/admin/clients', id: 'clients' },
            { name: 'Reservaciones', icon: 'clipboard-list', path: '/dashboard/admin/bookings', id: 'bookings' },
            { name: 'Cotizaciones', icon: 'file-invoice', path: '/dashboard/admin/quotes', id: 'quotes', badge: { text: 'Beta', color: 'info' } },
            { name: 'Ajustes de Precio', icon: 'settings', path: '/dashboard/admin/price-settings', id: 'price-settings' },
            { name: 'Redondeo Efectivo', icon: 'coin', path: '/dashboard/admin/cash-rounding', id: 'cash-rounding' }
        ]},
        { section: 'Tarifario', icon: 'ti-receipt-2', items: [
            { name: 'Vehículos', icon: 'car', path: '/dashboard/admin/vehicles', id: 'vehicles' },
            { name: 'Traslados', icon: 'briefcase', path: '/dashboard/admin/services', id: 'services' },
            { name: 'A Disposición', icon: 'calculator', path: '/dashboard/admin/a-disposicion', id: 'a-disposicion' },
            { name: 'Experiencias', icon: 'star', path: '/dashboard/admin/experiences', id: 'experiences' },
            { name: 'Tours', icon: 'map', path: '/dashboard/admin/tours', id: 'tours' },
            { name: 'Exportar Tarifario', icon: 'download', path: '/dashboard/admin/tarifario-export', id: 'tarifario-export' }
            // Hidden for practical purposes
            // { name: 'Greeter', icon: 'user-plus', path: '/dashboard/admin/greeter', id: 'greeter' }
        ]},
        { section: 'Gestión', icon: 'ti-users', items: [
            { name: 'Facturas', icon: 'receipt', path: '/dashboard/admin/invoices', id: 'invoices', badge: { text: '0', color: 'warning' } },
            { name: 'Solicitudes de Cancelación', icon: 'circle-x', path: '/dashboard/admin/cancellation-requests', id: 'cancellation-requests' },
            { name: 'Empleados', icon: 'user-check', path: '/dashboard/admin/employees', id: 'employees' },
            { name: 'Destinos', icon: 'map-pin', path: '/dashboard/admin/pois', id: 'pois' },
            { name: 'Métodos de Pago', icon: 'credit-card', path: '/dashboard/admin/payment-info', id: 'payment-info' }
            // Oculto por ahora — descomentar para reactivar Formularios:
            // , { name: 'Formularios', icon: 'file-text', path: '/dashboard/admin/forms', id: 'forms' }
        ]}
    ],
    client: [
        { section: 'Inicio', icon: 'ti-home', items: [
            { name: 'Dashboard', icon: 'home', path: '/dashboard/client', id: 'home' }
        ]},
        // Show System Management section if admin/superadmin is viewing this dashboard
        ...(isAdminViewingOtherDashboard ? [
            { section: 'System Management', icon: 'ti-settings', items: [
                { name: 'Dashboard Agente', icon: 'user', path: '/dashboard/client', id: 'dashboard',
                  dropdown: dashboards
                }
            ]}
        ] : []),
        ...(isSuperAdminViewingOtherDashboard ? [
            { section: 'System Management', icon: 'ti-settings', items: [
                { name: 'Dashboard Agente', icon: 'user', path: '/dashboard/client', id: 'dashboard',
                  dropdown: dashboards
                }
            ]}
        ] : []),
        { section: 'My Business', icon: 'ti-building', items: [
            { name: 'Clientes', icon: 'building', path: '/dashboard/client/clients', id: 'clients' },
            { name: 'My Team', icon: 'users', path: '/dashboard/client/team', id: 'team' },
            { name: 'Cotizaciones', icon: 'file-invoice', path: '/dashboard/client/quotes', id: 'quotes', badge: { text: 'Beta', color: 'info' } },
            { name: 'Reservaciones', icon: 'clipboard-list', path: '/dashboard/client/bookings', id: 'bookings' }
        ]},
        { section: 'Servicios', icon: 'ti-briefcase', items: [
            { name: 'Vehículos', icon: 'car', path: '/dashboard/client/vehicles', id: 'vehicles' },
            { name: 'Traslados', icon: 'briefcase', path: '/dashboard/client/services', id: 'services' },
            { name: 'A Disposición', icon: 'calculator', path: '/dashboard/client/a-disposicion', id: 'a-disposicion' },
            { name: 'Experiencias', icon: 'star', path: '/dashboard/client/experiences', id: 'experiences' },
            { name: 'Tours', icon: 'map', path: '/dashboard/client/tours', id: 'tours' },
            { name: 'Exportar Tarifario', icon: 'download', path: '/dashboard/client/tarifario-export', id: 'tarifario-export' }
            // Hidden for practical purposes
            // { name: 'Greeter', icon: 'user-plus', path: '/dashboard/client/greeter', id: 'greeter' }
        ]}
    ],
    // Cliente directo (end_client): menú acotado a lo suyo (sin gestión de agencia).
    end_client: [
        { section: 'Inicio', icon: 'ti-home', items: [
            { name: 'Dashboard', icon: 'home', path: '/dashboard/end_client', id: 'home' }
        ]},
        { section: 'Mi Actividad', icon: 'ti-briefcase', items: endClientActivityItems },
        ...(endClientTarifarioItems.length ? [
            { section: 'Tarifario', icon: 'ti-receipt-2', items: endClientTarifarioItems }
        ] : [])
    ],
    department_manager: [
        { section: 'Inicio', icon: 'ti-home', items: [
            { name: 'Dashboard', icon: 'home', path: '/dashboard/department_manager', id: 'home' }
        ]},
        // Show System Management section if admin/superadmin is viewing this dashboard
        ...(isAdminViewingOtherDashboard ? [
            { section: 'System Management', icon: 'ti-settings', items: [
                { name: 'Dashboard Agente Admin', icon: 'screen-share', path: '/dashboard/department_manager', id: 'dashboard',
                  dropdown: dashboards
                }
            ]}
        ] : []),
        ...(isSuperAdminViewingOtherDashboard ? [
            { section: 'System Management', icon: 'ti-settings', items: [
                { name: 'Dashboard Agente Admin', icon: 'screen-share', path: '/dashboard/department_manager', id: 'dashboard',
                  dropdown: dashboards
                }
            ]}
        ] : []),
        { section: 'Team Management', icon: 'ti-users', items: [
            { name: 'Clientes', icon: 'building', path: '/dashboard/department_manager/clients', id: 'clients' },
            { name: 'My Team', icon: 'users', path: '/dashboard/department_manager/team', id: 'team' },
            { name: 'Cotizaciones', icon: 'file-invoice', path: '/dashboard/department_manager/quotes', id: 'quotes', badge: { text: 'Beta', color: 'info' } },
            { name: 'Reservaciones', icon: 'clipboard-list', path: '/dashboard/department_manager/bookings', id: 'bookings' },
            { name: 'Facturas', icon: 'receipt', path: '/dashboard/department_manager/invoices', id: 'invoices' }
        ]},
        { section: 'Servicios', icon: 'ti-briefcase', items: [
            { name: 'Vehículos', icon: 'car', path: '/dashboard/department_manager/vehicles', id: 'vehicles' },
            { name: 'Traslados', icon: 'briefcase', path: '/dashboard/department_manager/services', id: 'services' },
            { name: 'A Disposición', icon: 'calculator', path: '/dashboard/department_manager/a-disposicion', id: 'a-disposicion' },
            { name: 'Experiencias', icon: 'star', path: '/dashboard/department_manager/experiences', id: 'experiences' },
            { name: 'Tours', icon: 'map', path: '/dashboard/department_manager/tours', id: 'tours' },
            { name: 'Exportar Tarifario', icon: 'download', path: '/dashboard/department_manager/tarifario-export', id: 'tarifario-export' }
            // Hidden for practical purposes
            // { name: 'Greeter', icon: 'user-plus', path: '/dashboard/department_manager/greeter', id: 'greeter' }
        ]}
    ],
    employee: [
        { section: 'Servicios', icon: 'ti-briefcase', items: [
            { name: 'Vehículos', icon: 'car', path: '/dashboard/employee/vehicles', id: 'vehicles' },
            { name: 'Traslados', icon: 'briefcase', path: '/dashboard/employee/services', id: 'services' },
            { name: 'Experiencias', icon: 'star', path: '/dashboard/employee/experiences', id: 'experiences', hidden: true },
            { name: 'Tours', icon: 'map', path: '/dashboard/employee/tours', id: 'tours' }
        ]}
    ],
    driver: [
        // System Management Section - Only Dashboard
        { section: 'System Management', icon: 'ti-settings', items: [
            { name: 'Dashboard Driver', icon: 'steering-wheel', path: '/dashboard/driver', id: 'dashboard',
              dropdown: dashboards
            }
        ]},
        { section: 'My Trips', icon: 'ti-car', items: [
            { name: 'Dashboard', icon: 'dashboard', path: '/dashboard/driver', id: 'dashboard' },
            { name: 'Active Trips', icon: 'route', path: '/dashboard/driver/trips', id: 'trips' },
            { name: 'My Schedule', icon: 'calendar', path: '/dashboard/driver/schedule', id: 'schedule' },
            { name: 'My Vehicle', icon: 'car', path: '/dashboard/driver/vehicle', id: 'vehicle' },
            { name: 'Trip History', icon: 'history', path: '/dashboard/driver/history', id: 'history' }
        ]}
    ],
    guest: [
        // System Management Section - Only Dashboard
        { section: 'System Management', icon: 'ti-settings', items: [
            { name: 'Dashboard Guest', icon: 'world', path: '/dashboard/guest', id: 'dashboard',
              dropdown: dashboards
            }
        ]},
        { section: 'Welcome', icon: 'ti-home', items: [
            { name: 'Home', icon: 'home', path: '/', id: 'home' }
        ]}
    ]
};

// Always show the menu based on the dashboard being viewed (userRole)
// The return button logic is now inside each role's navigation items
const menuSections = navigationItems[userRole] || navigationItems.guest;
%>

<ul id="sidebarnav" class="list-unstyled">
  <% menuSections.forEach(function(section, sectionIndex) { %>
  <!-- Section Header -->
  <li class="nav-small-cap">
    <i class="ti ti-dots nav-small-cap-icon fs-4"></i>
    <span class="hide-menu"><%= section.section %></span>
  </li>

  <!-- Section Items -->
  <% section.items.forEach(function(item, itemIndex) { %>
  <% if (!item.hidden) { %>
  <% const isActive = isActiveMenuItem(item.path, currentPath); %>

  <%- include('../../../molecules/dashboard/nav-item', {
                href: item.path,
                icon: item.icon,
                text: item.name,
                active: isActive,
                badge: item.badge,
                submenu: item.submenu,
                id: item.id,
                external: item.external,
                dropdown: item.dropdown ? item.dropdown : [],
            }) %>
  <% } %>
  <% }); %>
  <% }); %>

  <!-- User Section -->
  <%- include('./sidebar-footer', {
        userRole: userRole,
        currentPath: currentPath
    }) %>
</ul>

<style>
  /* Section Headers */
  .nav-small-cap {
    color: #6c757d;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 1px;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding: 0 20px;
    position: relative;
  }

  .nav-small-cap:first-child {
    margin-top: 1rem;
  }

  .nav-small-cap .nav-small-cap-icon {
    color: var(--brand-primary);
    margin-right: 8px;
    font-size: 0.75rem;
  }

  .nav-small-cap .hide-menu {
    position: relative;
  }

  /* Sidebar Menu Animations */
  #sidebarnav .sidebar-item {
    opacity: 0;
    transform: translateX(-10px);
    animation: slideInNav 0.3s ease forwards;
  }

  <% menuSections.forEach(function(section, sectionIndex) {
      %> <% section.items.forEach(function(item, itemIndex) {
          %> #sidebarnav .sidebar-item:nth-child(<%=sectionIndex * (section.items.length + 1) + itemIndex + 2 %>) {
            animation-delay: <%=(sectionIndex * section.items.length + itemIndex) * 0.05 %>s;
          }

          <%
        }

      ); %> <%
    }

  );

  %>@keyframes slideInNav {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Brand accent colors (salvia) — iguales para todos los roles */
  #sidebarnav .nav-small-cap-icon,
  #sidebarnav .sidebar-link:hover .nav-icon,
  #sidebarnav .sidebar-link.active .nav-icon {
    color: var(--brand-primary);
  }

  #sidebarnav .sidebar-link:hover,
  #sidebarnav .sidebar-link.active {
    background: linear-gradient(135deg, rgba(var(--brand-primary-rgb), 0.06), rgba(var(--brand-secondary-rgb), 0.06));
    color: var(--brand-primary);
  }

  /* Badge animations */
  .nav-badge {
    /* No animation */
  }

  /* Loading state for menu items */
  .sidebar-item.loading {
    pointer-events: none;
    opacity: 0.6;
  }

  .sidebar-item.loading::after {
    content: '';
    position: absolute;
    right: 20px;
    top: 50%;
    width: 12px;
    height: 12px;
    border: 1px solid transparent;
    border-top: 1px solid var(--brand-primary);
    border-radius: 50%;
    animation: nav-item-loading 1s linear infinite;
    transform: translateY(-50%);
  }

  @keyframes nav-item-loading {
    0% {
      transform: translateY(-50%) rotate(0deg);
    }

    100% {
      transform: translateY(-50%) rotate(360deg);
    }
  }

  /* Hover effects for better UX */
  .sidebar-link {
    position: relative;
    overflow: hidden;
  }

  .sidebar-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: 100%;
    background: var(--brand-primary);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .sidebar-link.active::before,
  .sidebar-link:hover::before {
    transform: translateX(0);
  }

  /* Responsive adjustments */
  @media (max-width: 991.98px) {
    .nav-small-cap {
      padding: 0 15px;
      font-size: 0.625rem;
    }

    #sidebarnav .sidebar-link {
      padding: 14px 15px;
    }
  }
</style>