<%
/**
 * Profile Image Upload Component
 * Reusable component for profile image upload with optimization
 * Created by Denisse Maldonado
 * 
 * Usage: include('../../organisms/profile/profile-image-upload', { profileData, initials })
 */
%>

<!-- Profile Picture -->
<div class="mb-3 position-relative">
  <div id="profileImageContainer" class="position-relative d-inline-block">
    <% if (profileData.profilePicture) { %>
      <img src="<%= profileData.profilePicture %>" 
           alt="<%= profileData.fullName %>" 
           id="profileImage"
           class="rounded-circle"
           width="150" 
           height="150"
           style="object-fit: cover; border: 4px solid #f0f0f0;"
           onerror="this.style.display='none'; document.getElementById('avatar-placeholder').style.display='flex';">
      <div id="avatar-placeholder" 
           class="rounded-circle d-none align-items-center justify-content-center text-white fw-bold mx-auto"
           style="width: 150px; height: 150px; background: #5D87FF; font-size: 2rem; border: 4px solid #f0f0f0;">
        <%= initials %>
      </div>
    <% } else { %>
      <div id="avatar-placeholder" 
           class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold mx-auto"
           style="width: 150px; height: 150px; background: #5D87FF; font-size: 2rem; border: 4px solid #f0f0f0;">
        <%= initials %>
      </div>
    <% } %>
    
    <!-- Upload overlay -->
    <div class="position-absolute bottom-0 end-0">
      <button type="button" 
              id="profileUploadButton"
              class="btn btn-primary btn-sm rounded-circle" 
              style="width: 40px; height: 40px; padding: 0;"
              title="Upload new profile picture">
        <i class="ti ti-camera"></i>
      </button>
    </div>
  </div>
  
  <!-- Hidden file input -->
  <input type="file" 
         id="profileImageInput" 
         class="d-none" 
         accept="image/jpeg,image/png,image/gif,image/webp,image/avif">
  
  <!-- Upload progress -->
  <div id="uploadProgress" class="mt-2 d-none">
    <div class="progress" style="height: 5px;">
      <div class="progress-bar progress-bar-striped progress-bar-animated" 
           role="progressbar" 
           style="width: 0%">
      </div>
    </div>
    <small class="text-muted">Uploading and optimizing...</small>
  </div>
</div>

<script>
// Profile image upload functionality
(function() {
  document.addEventListener('DOMContentLoaded', function() {
    const profileImageInput = document.getElementById('profileImageInput');
    const uploadProgress = document.getElementById('uploadProgress');
    const profileImageContainer = document.getElementById('profileImageContainer');
    const uploadButton = document.getElementById('profileUploadButton');
    
    // Add click event listener to upload button
    if (uploadButton) {
      uploadButton.addEventListener('click', function(e) {
        e.preventDefault();
        if (profileImageInput) {
          profileImageInput.click();
        }
      });
    }
    
    if (profileImageInput) {
      profileImageInput.addEventListener('change', async function(e) {
        const file = e.target.files[0];
        if (!file) return;
        
        // Validate file size (10MB max)
        if (file.size > 10 * 1024 * 1024) {
          showProfileAlert('error', 'File size must be less than 10MB');
          return;
        }
        
        // Validate file type
        const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'image/avif'];
        if (!allowedTypes.includes(file.type)) {
          showProfileAlert('error', 'Only JPEG, PNG, GIF, WebP, and AVIF images are allowed');
          return;
        }
        
        // Show upload progress
        uploadProgress.classList.remove('d-none');
        const progressBar = uploadProgress.querySelector('.progress-bar');
        progressBar.style.width = '0%';
        
        // Create FormData
        const formData = new FormData();
        formData.append('profileImage', file);
        
        try {
          // Simulate progress
          let progress = 0;
          const progressInterval = setInterval(() => {
            progress += 10;
            if (progress <= 90) {
              progressBar.style.width = progress + '%';
            }
          }, 200);
          
          // Upload image
          const response = await fetch('/api/profile/image', {
            method: 'POST',
            credentials: 'same-origin', // Include cookies for authentication
            body: formData
          });
          
          clearInterval(progressInterval);
          progressBar.style.width = '100%';
          
          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Upload failed');
          }
          
          const result = await response.json();
          
          if (result.success) {
            // Update profile image display
            const existingImg = profileImageContainer.querySelector('#profileImage');
            const placeholder = profileImageContainer.querySelector('#avatar-placeholder');
            
            if (existingImg) {
              existingImg.src = result.data.url;
              existingImg.style.display = 'block';
            } else {
              // Create new image element
              const newImg = document.createElement('img');
              newImg.id = 'profileImage';
              newImg.src = result.data.url;
              newImg.alt = 'Profile Picture';
              newImg.className = 'rounded-circle';
              newImg.width = 150;
              newImg.height = 150;
              newImg.style.objectFit = 'cover';
              newImg.style.border = '4px solid #f0f0f0';
              
              profileImageContainer.insertBefore(newImg, profileImageContainer.firstChild);
            }
            
            // Hide placeholder if visible
            if (placeholder) {
              placeholder.classList.add('d-none');
              placeholder.classList.remove('d-flex');
            }
            
            // Show success message with optimization info
            const formats = result.data.optimization?.availableFormats || [];
            const formatMessage = formats.length > 0 
              ? `Optimized in ${formats.length} formats for best performance!`
              : 'Image uploaded successfully!';
            
            showProfileAlert('success', `Profile picture updated! ${formatMessage}`);
            
            // Hide progress after delay
            setTimeout(() => {
              uploadProgress.classList.add('d-none');
              progressBar.style.width = '0%';
            }, 1000);
          }
        } catch (error) {
          console.error('Upload error:', error);
          showProfileAlert('error', error.message || 'Failed to upload profile picture');
          uploadProgress.classList.add('d-none');
        }
        
        // Reset input
        profileImageInput.value = '';
      });
    }
    
    // Alert helper function
    function showProfileAlert(type, message) {
      const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
      const icon = type === 'success' ? 'ti-check' : 'ti-alert-circle';
      
      const alertHtml = `
        <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
          <i class="ti ${icon} me-2"></i>
          ${message}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      `;
      
      // Find or create alert container
      let alertContainer = document.querySelector('.profile-alerts');
      if (!alertContainer) {
        alertContainer = document.createElement('div');
        alertContainer.className = 'profile-alerts';
        const pageContent = document.querySelector('.container-fluid');
        pageContent.insertBefore(alertContainer, pageContent.firstChild);
      }
      
      alertContainer.innerHTML = alertHtml;
      
      // Auto-dismiss after 5 seconds
      setTimeout(() => {
        const alert = alertContainer.querySelector('.alert');
        if (alert) {
          alert.classList.remove('show');
          setTimeout(() => alert.remove(), 150);
        }
      }, 5000);
    }
  });
})();
</script>