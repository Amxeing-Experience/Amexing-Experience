<%#
Landing Footer Organism
Comprehensive footer for the Amexing Experience landing page
Features company information, services, contact details, and social links

@param {object} companyInfo - Company information object
@param {array} services - List of services offered
@param {array} resources - List of resource links
@param {object} socialMedia - Social media links
@param {boolean} showNewsletter - Whether to show newsletter signup

@example
include('organisms/landing/landing-footer', {
    companyInfo: { name: 'Amexing Experience', ... },
    showNewsletter: true
}) %>

<%
const company = typeof companyInfo !== 'undefined' ? companyInfo : {
    name: 'AMEXING',
    tagline: 'Experience',
    fullName: 'Amexing Experience',
    description: 'Transporte premium y experiencias de lujo en San Miguel de Allende',
    phone: '+52 (415) 152-7890',
    email: 'info@amexing.com',
    whatsapp: '+52 415 152 7890',
    address: 'San Miguel de Allende, Guanajuato, México',
    founded: '1994',
    certifications: ['SECTUR', 'AMESTUR', 'EarthCheck']
};

const empresaLinks = [
    { name: 'Sobre nosotros', href: '/nosotros' },
    { name: 'Nuestro equipo', href: '/nosotros#equipo' },
    { name: 'Certificaciones', href: '/nosotros#certificaciones' }
];

const serviciosLinks = [
    { name: 'Transporte', href: '/servicios#transporte' },
    { name: 'Tours', href: '/servicios#tours' },
    { name: 'Experiencias', href: '/servicios#experiencias' },
    { name: 'Concierge', href: '/servicios#concierge' },
    { name: 'Bodas', href: '/servicios#bodas' }
];

const recursosLinks = [
    { name: 'FAQ', href: '/recursos/faq' },
    { name: 'Aviso de privacidad', href: '/docs/AMEXING_Aviso_Privacidad_2026_V1.pdf', external: true },
    { name: 'Términos y condiciones', href: '/docs/AMEXING_Condiciones_2026_V1.pdf', external: true },
    { name: 'Política de cancelación', href: '/legal/cancellation' }
];

const contactoLinks = [
    { name: 'Teléfono', href: `tel:${company.phone.replace(/[^+\d]/g, '')}` },
    { name: 'WhatsApp', href: `https://wa.me/524151527890` },
    { name: 'Email', href: `mailto:${company.email}` }
];

const socialLinks = typeof socialMedia !== 'undefined' ? socialMedia : {
    facebook: 'https://www.facebook.com/amexingexperience',
    instagram: 'https://www.instagram.com/amexingexperience/',
    tripadvisor: 'https://www.tripadvisor.com.mx/Attraction_Review-g151932-d19425238-Reviews-Amexing_Experience_by_Angelica_Tours-San_Miguel_de_Allende_Central_Mexico_and_Gu.html',
    google: 'https://g.page/amexing',
    whatsapp: 'https://wa.me/524151527890'
};
%>

<footer class="landing-footer" id="footer">
    <div class="landing-footer__container">
        <div class="landing-footer__main">
            <div class="landing-footer__grid">
                <%# Logo Section %>
                <div class="landing-footer__logo-section">
                    <div class="landing-footer__logo">
                        <img src="/images/footer_logo.png" alt="<%= company.name %>" class="landing-footer__logo-img">
                    </div>
                </div>

                <%# Empresa %>
                <div class="landing-footer__section">
                    <h3 class="landing-footer__title">Empresa</h3>
                    <ul class="landing-footer__list">
                        <% empresaLinks.forEach(function(link) { %>
                        <li class="landing-footer__list-item">
                            <a href="<%= link.href %>" class="landing-footer__link">
                                <%= link.name %>
                            </a>
                        </li>
                        <% }); %>
                    </ul>
                </div>

                <%# Servicios %>
                <div class="landing-footer__section">
                    <h3 class="landing-footer__title">Servicios</h3>
                    <ul class="landing-footer__list">
                        <% serviciosLinks.forEach(function(link) { %>
                        <li class="landing-footer__list-item">
                            <a href="<%= link.href %>" class="landing-footer__link">
                                <%= link.name %>
                            </a>
                        </li>
                        <% }); %>
                    </ul>
                </div>

                <%# Recursos %>
                <div class="landing-footer__section">
                    <h3 class="landing-footer__title">Recursos</h3>
                    <ul class="landing-footer__list">
                        <% recursosLinks.forEach(function(link) { %>
                        <li class="landing-footer__list-item">
                            <a href="<%= link.href %>" class="landing-footer__link"<% if (link.external) { %> target="_blank" rel="noopener noreferrer"<% } %>>
                                <%= link.name %>
                            </a>
                        </li>
                        <% }); %>
                    </ul>
                </div>

                <%# Contacto %>
                <div class="landing-footer__section">
                    <h3 class="landing-footer__title">Contacto</h3>
                    <ul class="landing-footer__list">
                        <% contactoLinks.forEach(function(link) { %>
                        <li class="landing-footer__list-item">
                            <a href="<%= link.href %>" class="landing-footer__link">
                                <%= link.name %>
                            </a>
                        </li>
                        <% }); %>
                    </ul>
                </div>
            </div>
        </div>

        <%# Social Media Section %>
        <div class="landing-footer__social-section">
            <div class="landing-footer__social-links">
                <a href="<%= socialLinks.facebook %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="landing-footer__social-link"
                   aria-label="Facebook">
                    <img src="/images/facebook.png" alt="Facebook" class="landing-footer__social-icon">
                </a>
                <a href="<%= socialLinks.instagram %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="landing-footer__social-link"
                   aria-label="Instagram">
                    <img src="/images/instagram.png" alt="Instagram" class="landing-footer__social-icon">
                </a>
                <a href="<%= socialLinks.tripadvisor %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="landing-footer__social-link landing-footer__social-link--tripadvisor"
                   aria-label="TripAdvisor">
                    <i aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <%# Copyright Section %>
        <div class="landing-footer__bottom">
            <div class="landing-footer__bottom-content">
                <p class="landing-footer__copyright">
                    ©<%= new Date().getFullYear() %> <%= company.fullName %>. Todos los derechos reservados.
                </p>
            </div>
        </div>
    </div>
</footer>

<style>
.landing-footer {
    background: #f5f5f5;
    color: #333;
    font-family: 'Montserrat', sans-serif;
    border-top: 1px solid #e0e0e0;
}

.landing-footer__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
}

.landing-footer__main {
    padding: 3rem 0 2rem 0;
}

.landing-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 2rem;
    align-items: start;
}

.landing-footer__logo-section {
    display: flex;
    align-items: flex-start;
}

.landing-footer__logo {
    display: flex;
    align-items: center;
}

.landing-footer__logo-img {
    height: 60px;
    width: auto;
}

.landing-footer__section {
    display: flex;
    flex-direction: column;
}

.landing-footer__title {
    font-family: var(--font-newsreader, 'Newsreader', Georgia, 'Times New Roman', serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: #333;
    margin-bottom: 1rem;
    text-transform: capitalize;
}

.landing-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.landing-footer__list-item {
    display: flex;
    align-items: center;
}

.landing-footer__link {
    color: #666;
    text-decoration: none;
    font-family: var(--font-myriad, 'Myriad Pro', 'Helvetica Neue', Arial, sans-serif);
    font-size: 0.95rem;
    font-weight: 300;
    transition: color 0.3s ease;
    line-height: 1.4;
}

.landing-footer__link:hover {
    color: #333;
}

.landing-footer__social-section {
    text-align: center;
    padding: 1.5rem 0;
}

.landing-footer__social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
}

/* TripAdvisor is not in Font Awesome 6 Free, so the FA4 icon font is self-hosted
   here (the footer renders on many pages) to draw the glyph. */
@font-face {
    font-family: "TripAdvisor Icon";
    src: url("/fonts/icons/fa4-tripadvisor.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

/* TripAdvisor: glyph + circle drawn to match the dark facebook.png ring
   (~0.8px, #2e2e2d) inside the 40px link, with the same hover invert. */
.landing-footer__social-link--tripadvisor i {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 0.8px #2e2e2d;
    color: #2e2e2d;
    font-size: 13px;
    line-height: 1;
}

.landing-footer__social-link--tripadvisor i::before {
    font-family: "TripAdvisor Icon";
    font-weight: normal;
    font-style: normal;
    content: "\f262";
}

.landing-footer__social-link--tripadvisor:hover i {
    color: #fff;
    box-shadow: inset 0 0 0 0.8px #fff;
}

.landing-footer__social-link {
    width: 40px;
    height: 40px;
    /* border: 1px solid #ccc; */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    text-decoration: none;
    transition: all 0.3s ease;
}

.landing-footer__social-link:hover {
    background: #333;
    color: white;
    border-color: #333;
}

.landing-footer__social-icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
    transition: all 0.3s ease;
}

.landing-footer__social-link:hover .landing-footer__social-icon {
    filter: brightness(0) invert(1);
}

.landing-footer__heart-section {
    text-align: center;
    padding: 2rem 0 1.5rem 0;
}

.landing-footer__heart {
    width: 50px;
    height: auto;
    opacity: 0.8;
}

.landing-footer__bottom {
    text-align: center;
    padding: 1.5rem 0;
    border-top: 1px solid #e0e0e0;
}

.landing-footer__bottom-content {
    display: flex;
    justify-content: center;
    align-items: center;
}

.landing-footer__copyright {
    font-family: var(--font-myriad, 'Myriad Pro', 'Helvetica Neue', Arial, sans-serif);
    font-size: 0.9rem;
    font-weight: 300;
    color: #666;
    margin: 0;
}

@media (max-width: 768px) {
    .landing-footer__grid {
        grid-template-columns: 1fr;
        gap: 2rem;
        text-align: center;
    }
    
    .landing-footer__logo-section {
        justify-content: center;
    }
    
    .landing-footer__container {
        padding: 0 1rem;
    }
    
    .landing-footer__main {
        padding: 2rem 0 1.5rem 0;
    }
}

@media (max-width: 480px) {
    .landing-footer__main {
        padding: 1.5rem 0 1rem 0;
    }
    
    .landing-footer__grid {
        gap: 1.5rem;
    }
    
    .landing-footer__social-section,
    .landing-footer__bottom {
        padding: 1rem 0;
    }
}

</style>

