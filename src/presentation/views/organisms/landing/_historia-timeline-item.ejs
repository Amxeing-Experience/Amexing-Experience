<%#
Partial: un item de la línea del tiempo (Nuestra Historia).
Recibe `item` con { year, title, title2?, subtitle?, side, image, open, text }.

Created by Denisse Maldonado
%>
<div class="historia-timeline__item historia-timeline__item--<%= item.side %> <%= item.open ? 'is-open' : '' %>" style="--order: <%= item.order %>">
    <div class="historia-timeline__inner">
        <% if (item.side === 'center') { %>
            <span class="historia-timeline__connector" aria-hidden="true"></span>
        <% } %>
        <% if (item.images && item.images.length) { %>
            <div class="historia-timeline__images" data-count="<%= item.images.length %>">
                <% item.images.forEach(function(src) { %>
                    <img src="<%= src %>" alt="" class="historia-timeline__photo" loading="lazy">
                <% }); %>
            </div>
        <% } else if (item.image) { %>
            <div class="historia-timeline__image" role="img" aria-label="Foto provisional">
                <i class="fa-solid fa-camera" aria-hidden="true"></i>
            </div>
        <% } %>
        <% if (item.side !== 'center') { %>
            <span class="historia-timeline__connector" aria-hidden="true"></span>
        <% } %>
        <button type="button" class="historia-timeline__head" aria-expanded="<%= item.open ? 'true' : 'false' %>">
            <span class="historia-timeline__year"><%= item.year %></span>
            <span class="historia-timeline__title"><%= item.title %></span>
            <% if (item.title2) { %>
                <span class="historia-timeline__title historia-timeline__title--second"><%= item.title2 %></span>
            <% } %>
            <% if (item.subtitle) { %>
                <span class="historia-timeline__subtitle"><%= item.subtitle %></span>
            <% } %>
        </button>
        <div class="historia-timeline__body">
            <p class="historia-timeline__text"><%= item.text %></p>
        </div>
    </div>
</div>
