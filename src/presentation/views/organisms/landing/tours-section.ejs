<%#
Tours Section Organism - Landing Page
Tours and experiences showcase with sophisticated masonry grid layout

Created by Denisse Maldonado
%>

<section class="tours-section">
    <div class="tours-section__container">
        <div class="tours-section__content">
            <!-- Left Sidebar -->
            <div class="tours-section__sidebar">
                <div class="tours-section__sidebar-content">
                    <hr>
                    <h2 class="tours-section__title">
                        <span class="large-letter">T</span>ours y<br><span class="large-letter">E</span>xperiencias
                    </h2>
                    
                    <div class="tours-section__description">
                        <p class="tours-section__paragraph">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud.
                        </p>
                        
                        <p class="tours-section__paragraph">
                            Sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat.
                        </p>
                    </div>
                    
                    <a href="/contacto" class="tours-section__book-btn">BOOK NOW</a>
                </div>
            </div>

            <!-- Experience Grid -->
            <div class="tours-section__grid">
                <!-- Catas -->
                <div class="tours-section__card tours-section__card--catas">
                    <div class="tours-section__card-image tours-section__card-image--catas"></div>
                    <div class="tours-section__card-content">
                        <h3 class="tours-section__card-title">CATAS</h3>
                    </div>
                </div>

                <!-- Arte -->
                <div class="tours-section__card tours-section__card--arte">
                    <div class="tours-section__card-image tours-section__card-image--arte"></div>
                    <div class="tours-section__card-content">
                        <h3 class="tours-section__card-title">ARTE</h3>
                    </div>
                </div>

                <!-- Historia y Arquitectura -->
                <div class="tours-section__card tours-section__card--historia">
                    <div class="tours-section__card-image tours-section__card-image--historia"></div>
                    <div class="tours-section__card-content">
                        <h3 class="tours-section__card-title">HISTORIA Y<br>ARQUITECTURA</h3>
                    </div>
                </div>

                <!-- Gastronómicas -->
                <div class="tours-section__card tours-section__card--gastronomicas">
                    <div class="tours-section__card-image tours-section__card-image--gastronomicas"></div>
                    <div class="tours-section__card-content">
                        <h3 class="tours-section__card-title">GASTRONÓMICAS</h3>
                    </div>
                </div>

                <!-- Aventura -->
                <div class="tours-section__card tours-section__card--aventura">
                    <div class="tours-section__card-image tours-section__card-image--aventura"></div>
                    <div class="tours-section__card-content">
                        <h3 class="tours-section__card-title">AVENTURA</h3>
                    </div>
                </div>

                <!-- Naturaleza -->
                <div class="tours-section__card tours-section__card--naturaleza">
                    <div class="tours-section__card-image tours-section__card-image--naturaleza"></div>
                    <div class="tours-section__card-content">
                        <h3 class="tours-section__card-title">NATURALEZA</h3>
                    </div>
                </div>

                <!-- De Temporada -->
                <div class="tours-section__card tours-section__card--temporada">
                    <div class="tours-section__card-image tours-section__card-image--temporada"></div>
                    <div class="tours-section__card-content">
                        <h3 class="tours-section__card-title">DE TEMPORADA</h3>
                    </div>
                </div>
            </div>
        </div>
        <hr>
    </div>
</section>

<style>
.tours-section {
    background: #2e2e2e;
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
}

.tours-section__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
}

.tours-section__content {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 4rem;
    align-items: start;
    min-height: 600px;
}

.tours-section__sidebar {
    padding: 2rem 0;
    height: fit-content;
    position: sticky;
    top: 2rem;
}

.tours-section__sidebar-content {
    color: #ffffff;
}

.tours-section__title {
    font-family: var(--font-arpona);
    font-size: 3rem;
    font-weight: 300;
    color: #ffffff;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    line-height: 1.2;
}

.tours-section__description {
    margin-bottom: 3rem;
}

.tours-section__paragraph {
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.7;
    color: #ffffff;
    margin-bottom: 1.5rem;
    text-align: justify;
}

.tours-section__paragraph:last-child {
    margin-bottom: 0;
}

.tours-section__book-btn {
    background: #969b81;
    color: #ffffff;
    padding: 1rem 3rem;
    border: none;
    border-radius: 0;
    font-family: var(--font-myriad);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    display: inline-block;
    box-shadow: 0 4px 16px rgba(150, 155, 129, 0.3);
}

.tours-section__book-btn:hover {
    background: #8a8f7a;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(150, 155, 129, 0.4);
}

.tours-section__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(4, 150px);
    gap: 0;
    height: 600px;
}

.tours-section__card {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
}

.tours-section__card-image {
    flex: 1;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 100px;
}

.tours-section__card:hover {
    transform: scale(1.02);
    z-index: 10;
}

.tours-section__card-content {
    background: #969b81;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 60px;
}

.tours-section__card-title {
    font-family: var(--font-arpona);
    font-size: 1.2rem;
    font-weight: 300;
    color: #ffffff;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0 0 2rem 0 ;
    line-height: 1;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

/* Card Grid Positioning */
.tours-section__card--catas {
    grid-column: 1 / 3;
    grid-row: 1 / 2;
}

.tours-section__card--arte {
    grid-column: 1 / 3;
    grid-row: 2 / 4;
}

.tours-section__card--historia {
    grid-column: 3 / 7;
    grid-row: 1 / 3;
}

.tours-section__card--gastronomicas {
    grid-column: 1 / 3;
    grid-row: 4 / 5;
}

.tours-section__card--aventura {
    grid-column: 3 / 5;
    grid-row: 3 / 5;
}

.tours-section__card--naturaleza {
    grid-column: 5 / 7;
    grid-row: 3 / 4;
}

.tours-section__card--temporada {
    grid-column: 5 / 7;
    grid-row: 4 / 5;
}

/* Card Images */
.tours-section__card-image--catas {
    background-image: url('/images/7.png');
}

.tours-section__card-image--arte {
    background-image: url('/images/4.png');
}

.tours-section__card-image--historia {
    background-image: url('/images/3.png');
}

.tours-section__card-image--gastronomicas {
    background-image: url('/images/6.png');
}

.tours-section__card-image--aventura {
    background-image: url('/images/5.png');
}

.tours-section__card-image--naturaleza {
    background-image: url('/images/2.png');
}

.tours-section__card-image--temporada {
    background-image: url('/images/1.png');
}

.large-letter {
    font-size: 4rem;
    font-weight: 400;
    line-height: 1;
    vertical-align: baseline;
}

@media (max-width: 1024px) {
    .tours-section__content {
        grid-template-columns: 1fr;
        gap: 3rem;
    }
    
    .tours-section__sidebar {
        position: static;
        text-align: center;
    }
    
    .tours-section__grid {
        height: 500px;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(4, 1fr);
    }
    
    .tours-section__card--catas {
        grid-column: 1 / 3;
        grid-row: 1 / 2;
    }
    
    .tours-section__card--arte {
        grid-column: 3 / 5;
        grid-row: 1 / 2;
    }
    
    .tours-section__card--historia {
        grid-column: 1 / 5;
        grid-row: 2 / 3;
    }
    
    .tours-section__card--gastronomicas {
        grid-column: 1 / 3;
        grid-row: 3 / 4;
    }
    
    .tours-section__card--aventura {
        grid-column: 3 / 5;
        grid-row: 3 / 4;
    }
    
    .tours-section__card--naturaleza {
        grid-column: 1 / 3;
        grid-row: 4 / 5;
    }
    
    .tours-section__card--temporada {
        grid-column: 3 / 5;
        grid-row: 4 / 5;
    }
}

@media (max-width: 768px) {
    .tours-section {
        padding: 4rem 0;
    }
    
    .tours-section__container {
        padding: 0 1.5rem;
    }
    
    .tours-section__title {
        font-size: 2.5rem;
        letter-spacing: 2px;
    }
    
    .tours-section__grid {
        height: 400px;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(4, 1fr);
        gap: 0.5rem;
    }
    
    .tours-section__card--catas {
        grid-column: 1 / 2;
        grid-row: 1 / 2;
    }
    
    .tours-section__card--arte {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
    }
    
    .tours-section__card--historia {
        grid-column: 1 / 3;
        grid-row: 2 / 3;
    }
    
    .tours-section__card--gastronomicas {
        grid-column: 1 / 2;
        grid-row: 3 / 4;
    }
    
    .tours-section__card--aventura {
        grid-column: 2 / 3;
        grid-row: 3 / 4;
    }
    
    .tours-section__card--naturaleza {
        grid-column: 1 / 2;
        grid-row: 4 / 5;
    }
    
    .tours-section__card--temporada {
        grid-column: 2 / 3;
        grid-row: 4 / 5;
    }
    
    .tours-section__card-title {
        font-size: 1rem;
    }
    
    .tours-section__book-btn {
        width: 100%;
        text-align: center;
    }
}
</style>