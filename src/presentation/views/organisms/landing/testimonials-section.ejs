<%#
Testimonials Section Organism - Landing Page
Customer testimonials carousel featuring client reviews and ratings
Showcases authentic experiences and social proof

@param {string} title - Section title (default: 'TESTIMONIOS')
@param {array} testimonials - Array of customer testimonials
@param {boolean} autoplay - Whether to auto-rotate testimonials
@param {number} autoplayInterval - Auto rotation interval in milliseconds

@example
include('organisms/landing/testimonials-section', {
    title: 'TESTIMONIOS',
    autoplay: true,
    autoplayInterval: 5000
}) %>

<%
const sectionTitle = typeof title !== 'undefined' ? title : 'TESTIMONIOS';
const autoplayEnabled = typeof autoplay !== 'undefined' ? autoplay : true;
const rotationInterval = typeof autoplayInterval !== 'undefined' ? autoplayInterval : 5000;

const testimonialsList = typeof testimonials !== 'undefined' ? testimonials : [
    {
        id: 'nicolebto',
        name: 'Nicole Bto',
        avatar: '/images/avatars/nicolebto.jpg',
        location: 'San Miguel de Allende',
        timeAgo: 'Hace 2 meses',
        rating: 5,
        text: 'Cena en compañía. Pasamos una velada increíble. La vista es hermosa y el ambiente es muy agradable. El chef estuvo presente en cada platillo. Definitivamente volveremos.',
        platform: 'TripAdvisor',
        verified: true,
        service: 'Cena Romántica'
    },
    {
        id: 'giuseppe71',
        name: 'Giuseppe71',
        avatar: '/images/avatars/giuseppe71.jpg',
        location: 'Ciudad de México',
        timeAgo: 'Hace 3 meses',
        rating: 5,
        text: 'Riacevuto sorprese. Non posso lasciare una recensione più entusiasmante e locale è semplice, pulito. Il personale è attentissimo ma discreto. La vista è magnifica e il servizio impeccabile.',
        platform: 'TripAdvisor',
        verified: true,
        service: 'Tour Histórico'
    },
    {
        id: 'glenda_l',
        name: 'Glenda L',
        avatar: '/images/avatars/glenda-l.jpg',
        location: 'Guadalajara',
        timeAgo: 'Hace 4 semanas',
        rating: 5,
        text: 'Bello e buono 😋. Siamo rimasti molto soddisfatti del nuovo ristorante che ci ha conquistato subito per la cortesia dello staff e per l\'ambiente curato nei minimi dettagli.',
        platform: 'TripAdvisor',
        verified: true,
        service: 'Experiencia Gastronómica'
    },
    {
        id: 'carlos_m',
        name: 'Carlos Mendoza',
        avatar: '/images/avatars/carlos-m.jpg',
        location: 'Querétaro',
        timeAgo: 'Hace 1 mes',
        rating: 5,
        text: 'Transporte excepcional con Tesla Model S. La experiencia fue impecable desde el primer momento. Conductor profesional, vehículo impecable y servicio de primera clase. Altamente recomendado.',
        platform: 'Google',
        verified: true,
        service: 'Transporte Ejecutivo'
    },
    {
        id: 'maria_fernandez',
        name: 'María Fernández',
        avatar: '/images/avatars/maria-f.jpg',
        location: 'León, Guanajuato',
        timeAgo: 'Hace 2 semanas',
        rating: 5,
        text: 'Una experiencia inolvidable en San Miguel de Allende. El tour personalizado superó todas nuestras expectativas. Atención al detalle excepcional y conocimiento profundo de la ciudad.',
        platform: 'Facebook',
        verified: true,
        service: 'Tour Personalizado'
    }
];
%>

<section class="testimonials-section" id="testimonials">
    <div class="testimonials-section__container">
        <div class="testimonials-section__header">
            <h2 class="testimonials-section__title"><%= sectionTitle %></h2>
            <p class="testimonials-section__subtitle">
                Lo que dicen nuestros clientes sobre su experiencia con Amexing
            </p>
        </div>

        <div class="testimonials-section__content">
            <div class="testimonials-section__carousel" id="testimonialsCarousel">
                <div class="testimonials-section__track" id="testimonialsTrack">
                    <% testimonialsList.forEach(function(testimonial, index) { %>
                    <div class="testimonials-section__slide <%= index === 0 ? 'testimonials-section__slide--active' : '' %>" 
                         data-index="<%= index %>">
                        <div class="testimonials-section__card">
                            <div class="testimonials-section__card-header">
                                <div class="testimonials-section__avatar">
                                    <img src="<%= testimonial.avatar %>" 
                                         alt="<%= testimonial.name %>" 
                                         onerror="this.src='data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><circle cx=\"50\" cy=\"35\" r=\"15\" fill=\"%23B8860B\"/><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"none\" stroke=\"%23B8860B\" stroke-width=\"2\"/><path d=\"M25 75 C25 65, 35 55, 50 55 S75 65, 75 75\" fill=\"%23B8860B\"/></svg>'">
                                    <% if (testimonial.verified) { %>
                                    <div class="testimonials-section__verified">
                                        <i class="fas fa-check-circle"></i>
                                    </div>
                                    <% } %>
                                </div>
                                
                                <div class="testimonials-section__user-info">
                                    <h3 class="testimonials-section__user-name"><%= testimonial.name %></h3>
                                    <div class="testimonials-section__user-details">
                                        <span class="testimonials-section__location">
                                            <i class="fas fa-map-marker-alt"></i>
                                            <%= testimonial.location %>
                                        </span>
                                        <span class="testimonials-section__time">
                                            <i class="far fa-clock"></i>
                                            <%= testimonial.timeAgo %>
                                        </span>
                                    </div>
                                    
                                    <div class="testimonials-section__rating">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="fas fa-star <%= i <= testimonial.rating ? 'testimonials-section__star--filled' : 'testimonials-section__star--empty' %>"></i>
                                        <% } %>
                                    </div>
                                </div>
                                
                                <div class="testimonials-section__platform">
                                    <% if (testimonial.platform === 'TripAdvisor') { %>
                                        <i class="fab fa-tripadvisor"></i>
                                    <% } else if (testimonial.platform === 'Google') { %>
                                        <i class="fab fa-google"></i>
                                    <% } else if (testimonial.platform === 'Facebook') { %>
                                        <i class="fab fa-facebook"></i>
                                    <% } else { %>
                                        <i class="fas fa-quote-left"></i>
                                    <% } %>
                                </div>
                            </div>
                            
                            <div class="testimonials-section__card-body">
                                <blockquote class="testimonials-section__quote">
                                    "<%= testimonial.text %>"
                                </blockquote>
                                
                                <div class="testimonials-section__service-tag">
                                    <span class="testimonials-section__service-label">Servicio:</span>
                                    <span class="testimonials-section__service-name"><%= testimonial.service %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>

            <div class="testimonials-section__controls">
                <button class="testimonials-section__nav testimonials-section__nav--prev" 
                        id="testimonialsPrev" 
                        aria-label="Testimonio anterior">
                    <i class="fas fa-chevron-left"></i>
                </button>
                
                <div class="testimonials-section__indicators">
                    <% testimonialsList.forEach(function(testimonial, index) { %>
                    <button class="testimonials-section__indicator <%= index === 0 ? 'testimonials-section__indicator--active' : '' %>" 
                            data-index="<%= index %>"
                            aria-label="Ir al testimonio <%= index + 1 %>">
                    </button>
                    <% }); %>
                </div>
                
                <button class="testimonials-section__nav testimonials-section__nav--next" 
                        id="testimonialsNext" 
                        aria-label="Siguiente testimonio">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>

        <div class="testimonials-section__footer">
            <div class="testimonials-section__cta">
                <%- include('../../atoms/common/premium-button', {
                    text: 'Compartir tu experiencia',
                    href: '#contacto',
                    type: 'outline',
                    size: 'medium',
                    class: 'testimonials-section__cta-btn'
                }) %>
            </div>
        </div>
    </div>
</section>

<style>
.testimonials-section {
    padding: 6rem 0;
    background: #f8f9fa;
    position: relative;
    overflow: hidden;
}

.testimonials-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="testimonials-pattern" patternUnits="userSpaceOnUse" width="100" height="100"><path d="M25 25 Q50 10, 75 25 Q90 50, 75 75 Q50 90, 25 75 Q10 50, 25 25" fill="none" stroke="%23B8860B" stroke-width="0.5" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23testimonials-pattern)"/></svg>') repeat;
    pointer-events: none;
}

.testimonials-section__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
}

.testimonials-section__header {
    text-align: center;
    margin-bottom: 4rem;
}

.testimonials-section__title {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #2c3e50;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    position: relative;
    display: inline-block;
}

.testimonials-section__title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 3px;
    background: linear-gradient(90deg, #B8860B, #DAA520);
    border-radius: 2px;
}

.testimonials-section__subtitle {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    font-weight: 300;
    line-height: 1.6;
    color: #5a6c7d;
    max-width: 600px;
    margin: 0 auto;
}

.testimonials-section__content {
    margin-bottom: 3rem;
}

.testimonials-section__carousel {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    max-width: 900px;
    margin: 0 auto;
}

.testimonials-section__track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.testimonials-section__slide {
    min-width: 100%;
    padding: 0 1rem;
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.6s ease;
}

.testimonials-section__slide--active {
    opacity: 1;
    transform: translateX(0);
}

.testimonials-section__card {
    background: white;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(184, 134, 11, 0.1);
    position: relative;
    overflow: hidden;
}

.testimonials-section__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #B8860B, #DAA520);
}

.testimonials-section__card-header {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
    position: relative;
}

.testimonials-section__avatar {
    position: relative;
    flex-shrink: 0;
}

.testimonials-section__avatar img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #B8860B;
    box-shadow: 0 4px 16px rgba(184, 134, 11, 0.2);
}

.testimonials-section__verified {
    position: absolute;
    bottom: -5px;
    right: -5px;
    background: #28a745;
    color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    border: 2px solid white;
}

.testimonials-section__user-info {
    flex: 1;
}

.testimonials-section__user-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 0.5rem;
}

.testimonials-section__user-details {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.75rem;
}

.testimonials-section__location,
.testimonials-section__time {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    color: #6c757d;
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.testimonials-section__location i,
.testimonials-section__time i {
    font-size: 0.7rem;
    opacity: 0.7;
}

.testimonials-section__rating {
    display: flex;
    gap: 0.25rem;
}

.testimonials-section__star--filled {
    color: #ffc107;
}

.testimonials-section__star--empty {
    color: #e9ecef;
}

.testimonials-section__platform {
    flex-shrink: 0;
    font-size: 1.5rem;
    color: #B8860B;
    opacity: 0.7;
}

.testimonials-section__platform .fab.fa-tripadvisor {
    color: #00AA6C;
}

.testimonials-section__platform .fab.fa-google {
    color: #4285f4;
}

.testimonials-section__platform .fab.fa-facebook {
    color: #1877f2;
}

.testimonials-section__card-body {
    position: relative;
}

.testimonials-section__quote {
    font-family: 'Montserrat', serif;
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    font-weight: 300;
    line-height: 1.8;
    color: #34495e;
    font-style: italic;
    margin: 0 0 1.5rem 0;
    position: relative;
}

.testimonials-section__quote::before {
    content: '"';
    font-size: 4rem;
    color: #B8860B;
    opacity: 0.3;
    position: absolute;
    top: -20px;
    left: -20px;
    line-height: 1;
    font-family: serif;
}

.testimonials-section__service-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(184, 134, 11, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
}

.testimonials-section__service-label {
    font-weight: 500;
    color: #6c757d;
}

.testimonials-section__service-name {
    font-weight: 600;
    color: #B8860B;
}

.testimonials-section__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin-top: 3rem;
}

.testimonials-section__nav {
    width: 50px;
    height: 50px;
    border: none;
    background: linear-gradient(135deg, #B8860B, #DAA520);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(184, 134, 11, 0.3);
}

.testimonials-section__nav:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(184, 134, 11, 0.4);
}

.testimonials-section__nav:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.testimonials-section__indicators {
    display: flex;
    gap: 0.5rem;
}

.testimonials-section__indicator {
    width: 12px;
    height: 12px;
    border: none;
    background: rgba(184, 134, 11, 0.3);
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
}

.testimonials-section__indicator--active,
.testimonials-section__indicator:hover {
    background: #B8860B;
    transform: scale(1.2);
}

.testimonials-section__footer {
    text-align: center;
    margin-top: 3rem;
}

.testimonials-section__cta-btn {
    color: #B8860B !important;
}

@media (max-width: 1024px) {
    .testimonials-section {
        padding: 4rem 0;
    }
    
    .testimonials-section__container {
        padding: 0 1.5rem;
    }
}

@media (max-width: 768px) {
    .testimonials-section {
        padding: 3rem 0;
    }
    
    .testimonials-section__container {
        padding: 0 1rem;
    }
    
    .testimonials-section__card {
        padding: 2rem;
    }
    
    .testimonials-section__card-header {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
    }
    
    .testimonials-section__controls {
        gap: 1rem;
    }
    
    .testimonials-section__nav {
        width: 40px;
        height: 40px;
    }
}

@media (max-width: 480px) {
    .testimonials-section__card {
        padding: 1.5rem;
    }
    
    .testimonials-section__slide {
        padding: 0 0.5rem;
    }
    
    .testimonials-section__user-details {
        flex-direction: column;
        gap: 0.5rem;
    }
}

@media (prefers-reduced-motion: reduce) {
    .testimonials-section__track,
    .testimonials-section__slide,
    .testimonials-section__nav,
    .testimonials-section__indicator {
        transition: none;
    }
}

@media print {
    .testimonials-section {
        background: white;
        padding: 2rem 0;
    }
    
    .testimonials-section::before {
        display: none;
    }
    
    .testimonials-section__controls {
        display: none;
    }
    
    .testimonials-section__card {
        box-shadow: none;
        border: 1px solid #ddd;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.getElementById('testimonialsCarousel');
    const track = document.getElementById('testimonialsTrack');
    const prevBtn = document.getElementById('testimonialsPrev');
    const nextBtn = document.getElementById('testimonialsNext');
    const indicators = document.querySelectorAll('.testimonials-section__indicator');
    const slides = document.querySelectorAll('.testimonials-section__slide');
    
    const autoplayEnabled = <%= autoplayEnabled %>;
    const autoplayInterval = <%= rotationInterval %>;
    
    let currentIndex = 0;
    let autoplayTimer = null;
    let isTransitioning = false;
    
    function updateCarousel() {
        if (isTransitioning) return;
        
        isTransitioning = true;
        
        // Update track position
        const translateX = -currentIndex * 100;
        track.style.transform = `translateX(${translateX}%)`;
        
        // Update slides
        slides.forEach((slide, index) => {
            slide.classList.toggle('testimonials-section__slide--active', index === currentIndex);
        });
        
        // Update indicators
        indicators.forEach((indicator, index) => {
            indicator.classList.toggle('testimonials-section__indicator--active', index === currentIndex);
        });
        
        // Update navigation buttons
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex === slides.length - 1;
        
        setTimeout(() => {
            isTransitioning = false;
        }, 600);
    }
    
    function goToSlide(index) {
        if (index >= 0 && index < slides.length && index !== currentIndex) {
            currentIndex = index;
            updateCarousel();
            resetAutoplay();
        }
    }
    
    function nextSlide() {
        if (currentIndex < slides.length - 1) {
            goToSlide(currentIndex + 1);
        } else if (autoplayEnabled) {
            goToSlide(0); // Loop back to first slide
        }
    }
    
    function prevSlide() {
        if (currentIndex > 0) {
            goToSlide(currentIndex - 1);
        }
    }
    
    function startAutoplay() {
        if (!autoplayEnabled) return;
        
        autoplayTimer = setInterval(() => {
            nextSlide();
        }, autoplayInterval);
    }
    
    function stopAutoplay() {
        if (autoplayTimer) {
            clearInterval(autoplayTimer);
            autoplayTimer = null;
        }
    }
    
    function resetAutoplay() {
        stopAutoplay();
        startAutoplay();
    }
    
    // Event listeners
    nextBtn.addEventListener('click', () => {
        nextSlide();
    });
    
    prevBtn.addEventListener('click', () => {
        prevSlide();
    });
    
    indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
            goToSlide(index);
        });
    });
    
    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (carousel.matches(':hover')) {
            if (e.key === 'ArrowLeft') {
                prevSlide();
            } else if (e.key === 'ArrowRight') {
                nextSlide();
            }
        }
    });
    
    // Pause autoplay on hover
    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);
    
    // Touch/swipe support
    let touchStartX = 0;
    let touchEndX = 0;
    
    carousel.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAutoplay();
    });
    
    carousel.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
        startAutoplay();
    });
    
    function handleSwipe() {
        const swipeThreshold = 50;
        const diff = touchStartX - touchEndX;
        
        if (Math.abs(diff) > swipeThreshold) {
            if (diff > 0) {
                nextSlide(); // Swipe left - next slide
            } else {
                prevSlide(); // Swipe right - previous slide
            }
        }
    }
    
    // Intersection Observer for lazy loading and animation
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('testimonials-section--visible');
                startAutoplay();
                observer.unobserve(entry.target);
            }
        });
    }, {
        threshold: 0.3
    });
    
    observer.observe(carousel);
    
    // Initialize
    updateCarousel();
    
    // Accessibility improvements
    carousel.setAttribute('role', 'region');
    carousel.setAttribute('aria-label', 'Testimonios de clientes');
    
    slides.forEach((slide, index) => {
        slide.setAttribute('role', 'tabpanel');
        slide.setAttribute('aria-label', `Testimonio ${index + 1} de ${slides.length}`);
    });
    
    indicators.forEach((indicator, index) => {
        indicator.setAttribute('role', 'tab');
        indicator.setAttribute('aria-label', `Ver testimonio ${index + 1}`);
    });
});
</script>