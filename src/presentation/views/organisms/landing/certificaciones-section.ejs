<style>
.certificaciones-section {
    padding: 0 2rem;
    background: #606060;
}

.certificaciones-section__container {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 3rem;
    background: #606060;
}

.certificaciones-section__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 2rem;
    align-items: start;
}

.certificaciones-section__title {
    font-family: var(--font-newsreader);
    font-size: 1.8rem;
    font-weight: 300;
    color: #000000;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 3rem 0;
    line-height: 1.2;
    text-align: center;
}

.large-letter {
    font-size: 2.4rem;
    font-weight: 400;
    line-height: 1;
    vertical-align: baseline;
}

.certificaciones-section__logo-column {
    text-align: center;
}

.certificaciones-section__logo {
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80px;
}

.certificaciones-section__image {
    max-width: 100%;
    max-height: 80px;
    width: auto;
    height: auto;
    object-fit: contain;
}

.certificaciones-section__description {
    font-family: var(--font-myriad);
    font-weight: 300;
    font-size: 0.85rem;
    line-height: 1.4;
    color: #000000;
    margin: 0;
    text-align: left;
}

@media (max-width: 768px) {
    .certificaciones-section {
        padding: 3rem 0;
    }
    
    .certificaciones-section__container {
        margin: 0 1rem;
        padding: 2rem;
    }
    
    .certificaciones-section__grid {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    
    .certificaciones-section__title-column {
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }
    
    .certificaciones-section__title {
        font-size: 1.6rem;
    }
    
    .large-letter {
    font-size: 4rem;
    font-weight: 400;
    line-height: 1;
    vertical-align: baseline;
}
    
    .certificaciones-section__logo {
        min-height: 60px;
    }
    
    .certificaciones-section__image {
        max-height: 60px;
    }
    
    .certificaciones-section__description {
        font-size: 0.8rem;
        text-align: left;
    }
}
</style>