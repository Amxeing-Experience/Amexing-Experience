    // Function to refresh images for a specific experience
    window.refreshExperienceImages = async function(experienceId) {
        console.log('🔄 Refreshing images for experience:', experienceId);
        
        // Find the experience in our data
        const experienceIndex = allExperiences.findIndex(exp => exp.id === experienceId);
        if (experienceIndex === -1) {
            console.log('❌ Experience not found:', experienceId);
            return;
        }
        
        try {
            // Reload images for this specific experience
            const images = await loadExperienceImages(experienceId);
            
            // Update the experience in our data
            allExperiences[experienceIndex].photos = images;
            allExperiences[experienceIndex].displayImage = getPrincipalImage(images) || allExperiences[experienceIndex].displayImage;
            
            // Update the filtered experiences too
            const filteredIndex = filteredExperiences.findIndex(exp => exp.id === experienceId);
            if (filteredIndex !== -1) {
