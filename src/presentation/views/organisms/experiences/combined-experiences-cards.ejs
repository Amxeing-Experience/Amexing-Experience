}

/* Progressive Loading Animation */
.gallery-item.loading::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    animation: shimmer 1.5s infinite;
    z-index: 1;
}

.gallery-item.loading img {
    opacity: 0.7;
}

