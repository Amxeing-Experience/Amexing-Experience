    async function createNewQuoteWithExperience() {
        const experience = window._selectedExperience;
        const token = getAccessToken();

        // Show action loading
        document.getElementById('quotePickerList').style.display = 'none';
        document.getElementById('quoteActionLoading').style.display = 'block';
        document.querySelector('#createNewQuoteBtn').style.display = 'none';
        document.querySelector('.quote-search-input').style.display = 'none';

        try {
            // 1. Create new quote
            const createRes = await fetch('/api/quotes', {
                method: 'POST',
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    notes: 'Experiencia: ' + experience.name
                })
            });

            if (!createRes.ok) throw new Error('Error al crear cotización');
            const newQuote = await createRes.json();
            const quoteId = newQuote.data.id;

            // 2. Add the experience
            const serviceItems = {
                days: [{
                    dayNumber: 1,
                    dayTitle: 'Día 1',
                    subconcepts: [{
                        type: 'experience',
                        experienceId: experience.id,
                        title: experience.name,
                        time: '',
                        hours: 0,
                        unitPrice: experience.price,
                        total: experience.price,
                        isPerPerson: true,
                        numberOfPeople: 1
                    }],
                    dayTotal: experience.price
                }],
                subtotal: Math.round(experience.price * 100) / 100,
                iva: Math.round(experience.price * 0.16 * 100) / 100,
                total: Math.round(experience.price * 1.16 * 100) / 100
            };

            const updateRes = await fetch('/api/quotes/' + quoteId + '/service-items', {
                method: 'PUT',
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(serviceItems)
            });

            if (!updateRes.ok) {
                const errData = await updateRes.json();
                throw new Error(errData.error || 'Error al agregar experiencia');
            }

            // 3. Close modal & redirect to quote
            bootstrap.Modal.getInstance(document.getElementById('addToQuoteModal'))?.hide();
            window.location.href = '/dashboard/department_manager/quotes/' + quoteId + '?section=services';

        } catch (error) {
            console.error('Error creating new quote:', error);
            showAddToQuoteError(error.message);
            document.getElementById('quotePickerList').style.display = 'block';
            document.getElementById('quoteActionLoading').style.display = 'none';
            document.querySelector('#createNewQuoteBtn').style.display = '';
            document.querySelector('.quote-search-input').style.display = '';
        }
