/* =====================================================================
   Experience Detail Modal — Luxury redesign (namespaced .exp-lux__*)
   ===================================================================== */
.exp-lux-modal {
    --exp-cream: #EAE7DF;
    --exp-tile: #E4DFCF;
    --exp-border: #d6d1c4;
    --exp-olive: #6E7A50;
    --exp-olive-light: #7C8A5A;
    --exp-muted: #8a8f78;
    --exp-gold: #b8894a;
    --exp-dark: #2b2b2b;
    --exp-serif: var(--font-arpona), 'Georgia', serif;
}
.exp-lux__dialog {
    max-width: 1160px;
    width: 96vw;
    margin: 1.75rem auto;
}
.exp-lux__content {
    border: none;
    border-radius: 6px;
    overflow: hidden;
    background: var(--exp-cream);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
}
.exp-lux__grid {
    display: grid;
    grid-template-columns: 42% 58%;
    height: min(88vh, 820px);
}

/* ---- LEFT: media pane ---- */
.exp-lux__media {
    position: relative;
    overflow: hidden;
    background: #1c1c1c;
}
.exp-lux__media-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.exp-lux__media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
}
.exp-lux__media-caption {
    position: absolute;
    left: 34px;
    right: 34px;
    bottom: 36px;
    z-index: 2;
    pointer-events: none;
}
.exp-lux__expand {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 3;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.28);
    color: #fff;
    cursor: pointer;
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    transition: background 0.2s, border-color 0.2s;
}
.exp-lux__expand:hover {
    background: rgba(0, 0, 0, 0.5);
    border-color: #fff;
}
.exp-lux__expand i {
    font-size: 1.15rem;
}
.exp-lux__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
}
.exp-lux__category {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(20, 20, 20, 0.55);
    backdrop-filter: blur(4px);
    color: #f3f0e8;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
}
.exp-lux__type-pill {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(243, 240, 232, 0.65);
    background: rgba(20, 20, 20, 0.28);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    color: #f3f0e8;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
}
.exp-lux__title {
    margin: 0;
    font-family: var(--exp-serif);
    font-weight: 500;
    font-size: 2.15rem;
    line-height: 1.12;
    color: #f7f4ec;
    letter-spacing: 0.01em;
}
.exp-lux__title-underline {
    display: block;
    width: 40px;
    height: 2px;
    margin-top: 16px;
    background: var(--exp-gold);
}

/* ---- RIGHT: content pane ---- */
.exp-lux__panel {
    display: flex;
    flex-direction: column;
    background: var(--exp-cream);
    min-height: 0;
}
.exp-lux__header {
    flex: 0 0 auto;
