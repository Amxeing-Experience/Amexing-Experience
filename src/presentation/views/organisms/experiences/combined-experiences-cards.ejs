    // Function to show experience details modal
    async function showExperienceDetailsModal(experienceId, experienceName, experienceType) {
        const modal = new bootstrap.Modal(document.getElementById('experienceDetailsModal'));
        const heroTitle = document.getElementById('experienceHeroTitle');
        const heroImage = document.getElementById('experienceHeroImage');
        const heroCategory = document.getElementById('experienceHeroCategory');
        const modalLoading = document.getElementById('experienceModalLoading');
        const detailBody = document.getElementById('experienceDetailBody');

        // Set initial data and show loading
        heroTitle.textContent = experienceName;
        if (heroCategory) { heroCategory.style.display = 'none'; heroCategory.textContent = ''; }
        heroImage.src = '/img/amexing_logo_horizontal.avif'; // Show placeholder while loading
        modalLoading.style.display = 'block';
        if (detailBody) detailBody.innerHTML = '';

        // Show modal
        modal.show();
        
        try {
            // Fetch complete experience data from API
            console.log('🌐 Fetching complete experience details from API for experienceId:', experienceId);
            console.log('🔍 Experience type passed to modal:', experienceType);
            
            let apiUrl = '';
            if (experienceType === 'provider') {
                apiUrl = `/api/provider-experiences/${experienceId}`;
                console.log('✅ Using provider experience endpoint:', apiUrl);
            } else {
                apiUrl = `/api/experiences/${experienceId}`;
                console.log('✅ Using regular experience endpoint:', apiUrl);
            }
            
            const response = await fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('authToken') || ''}`,
                    'Content-Type': 'application/json'
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al cargar los detalles de la experiencia');
            }
            
            const experienceData = await response.json();
            console.log('📋 Complete experience data from API:', experienceData);
            let experienceDetail = experienceData.data || experienceData;
            console.log('🔍 Final experience detail object:', experienceDetail);

            // Store experience for Add to Quote button
            window._currentModalExperience = {
                id: experienceId,
                name: experienceDetail.name || experienceName,
                type: experienceType,
                price: experienceDetail.cost || experienceDetail.price || 0,
                priceChild: experienceDetail.price_child || 0,
                priceNoAlcohol: experienceDetail.price_no_alcohol || 0
            };

            // Debug the photo structure from API
            console.log('📸 Raw photos from API:', {
                photos: experienceDetail.photos,
                images: experienceDetail.images,
                primaryPhoto: experienceDetail.primaryPhoto,
                photosLength: experienceDetail.photos ? experienceDetail.photos.length : 0,
                imagesLength: experienceDetail.images ? experienceDetail.images.length : 0
            });
            
            // Always load images from ExperienceImage table (S3 with presigned URLs)
            // The inline photos field may contain raw filenames without proper URLs
            try {
                const images = await loadExperienceImages(experienceId);
                if (images && images.length > 0) {
                    experienceDetail.photos = images;
                }
            } catch (imageError) {
                console.warn('Failed to load images from ExperienceImage:', imageError.message);
            }
            
            // Helper function to get the principal image (copy for modal scope)
            const getPrincipalImageForModal = (photos) => {
                if (!photos || !Array.isArray(photos) || photos.length === 0) {
                    return null;
                }
                
                // Look for principal image first
                const principalPhoto = photos.find(photo => 
                    photo.isPrincipal === true || 
                    photo.principal === true ||
                    photo.order === 0 ||
                    photo.position === 0
                );
                
                // Use the first photo if no principal is found
                const targetPhoto = principalPhoto || photos[0];
                
                // Extract image data using the same logic as cards
                const imageData = {
                    avif: null,
                    webp: null,
                    jpeg: null,
                    original: null
                };
                
                // Check for different formats in the photo object
                if (targetPhoto.formats) {
                    imageData.avif = targetPhoto.formats.avif;
                    imageData.webp = targetPhoto.formats.webp;
                    imageData.jpeg = targetPhoto.formats.jpeg;
                }
                
                if (targetPhoto.optimizedVariants) {
                    imageData.avif = imageData.avif || targetPhoto.optimizedVariants.avif?.url;
                    imageData.webp = imageData.webp || targetPhoto.optimizedVariants.webp?.url;
                    imageData.jpeg = imageData.jpeg || targetPhoto.optimizedVariants.jpeg?.url;
                }
                
                // Fallbacks
                imageData.original = targetPhoto.url || targetPhoto.dataUrl;
                if (targetPhoto.s3Key) {
                    imageData.original = imageData.original || `https://amexing-bucket.s3.us-east-2.amazonaws.com/${targetPhoto.s3Key}`;
                }
                
                // Return image data object for responsive picture element
                return {
                    avif: imageData.avif,
                    webp: imageData.webp,
                    jpeg: imageData.jpeg,
                    fallback: imageData.webp || imageData.jpeg || imageData.avif || imageData.original
                };
            };
            
            // Process the experience detail to add displayImage like the cards do
            const processedExperience = {
                ...experienceDetail,
                displayImage: getPrincipalImageForModal(experienceDetail.photos || experienceDetail.images)
            };
            
            console.log('🎯 Processed experience with displayImage:', {
                hasDisplayImage: !!processedExperience.displayImage,
                displayImage: processedExperience.displayImage
            });
            
            // Store the full processed experience so the currency/payment filter
            // handlers can re-render the prices section (loadPricesTab).
            window._selectedExperience = processedExperience;

            await loadExperienceDetailsIntoModal(processedExperience, experienceName);

        } catch (error) {
            console.error('Error loading experience details:', error);
            showModalError('No se pudieron cargar los detalles de la experiencia');
        }
    }
    
    // Function to load experience data into modal
    async function loadExperienceDetailsIntoModal(experience, experienceName) {
        const modalLoading = document.getElementById('experienceModalLoading');
        const heroImage = document.getElementById('experienceHeroImage');
        const heroTitle = document.getElementById('experienceHeroTitle');
        const heroCategory = document.getElementById('experienceHeroCategory');
        const detailBody = document.getElementById('experienceDetailBody');

        try {
            // Set optimized hero image with progressive loading
            const heroImageContainer = heroImage.parentElement;
            heroImageContainer.classList.remove('loading', 'loaded', 'error');
            
            // Clear previous event listeners to prevent multiple attachments
            heroImage.onload = null;
            heroImage.onerror = null;
            
            let imageUrl = '';
            
            // Debug logging for experience photos
            console.log('🖼️ Experience photo debug:', {
                hasPhotos: !!(experience.photos && experience.photos.length > 0),
                photosLength: experience.photos ? experience.photos.length : 0,
                hasPrimaryPhoto: !!experience.primaryPhoto,
                hasDisplayImage: !!experience.displayImage,
                displayImage: experience.displayImage,
                firstPhoto: experience.photos && experience.photos.length > 0 ? experience.photos[0] : null
            });
            
            // Priority 1: Use displayImage (processed like cards) - prefer optimized formats
            if (experience.displayImage) {
                imageUrl = experience.displayImage.webp || experience.displayImage.jpeg || experience.displayImage.avif || experience.displayImage.fallback;
            }
            // Priority 2: Use photos array
            else if (experience.photos && experience.photos.length > 0) {
                const firstPhoto = experience.photos[0];
                console.log('🔍 First photo structure:', firstPhoto);
                imageUrl = getOptimizedImageUrl(firstPhoto);
                console.log('🔗 Generated image URL from first photo:', imageUrl);
            } 
            // Priority 3: Use primaryPhoto
            else if (experience.primaryPhoto) {
                console.log('🔍 Primary photo structure:', experience.primaryPhoto);
                imageUrl = getOptimizedImageUrl(experience.primaryPhoto);
                console.log('🔗 Generated image URL from primary photo:', imageUrl);
            } 
            // Priority 4: Fallback placeholder
            else {
                imageUrl = '/img/amexing_logo_horizontal.avif';
            }
            
            // If imageUrl is null or empty, use placeholder
            if (!imageUrl) {
                imageUrl = '/img/amexing_logo_horizontal.avif';
            }
            
            // Only add loading state if we have a real image URL
            if (imageUrl && !imageUrl.startsWith('data:')) {
                heroImageContainer.classList.add('loading');
                
                // Add event listeners for real images only
                heroImage.onload = () => {
                    heroImageContainer.classList.remove('loading');
                    heroImageContainer.classList.add('loaded');
                };
                
                heroImage.onerror = () => {
                    heroImageContainer.classList.remove('loading');
                    heroImage.src = '/img/amexing_logo_horizontal.avif';
                };
            }
            
            // Set the image source
            heroImage.src = imageUrl;
            
            // If image is already loaded (from cache), trigger load event
            if (imageUrl && !imageUrl.startsWith('data:') && heroImage.complete && heroImage.naturalHeight !== 0) {
                heroImage.dispatchEvent(new Event('load'));
            }
            
            // ---- LEFT pane caption: title + category/type pills ----
            if (heroTitle) heroTitle.textContent = experience.name || experienceName || '';
            if (heroCategory) {
                const catLabel = categoryLabel(experience.experience_category);
                if (catLabel) {
                    heroCategory.textContent = catLabel.toUpperCase();
                    heroCategory.style.display = '';
                } else {
                    heroCategory.style.display = 'none';
                }
            }
            const heroType = document.getElementById('experienceHeroType');
            if (heroType) {
                const tipoVal = experience.tipo || experience.experienceType;
                if (tipoVal) {
                    heroType.textContent = String(tipoVal).charAt(0).toUpperCase() + String(tipoVal).slice(1);
                    heroType.style.display = '';
                } else {
                    heroType.style.display = 'none';
                }
            }

            // ---- Store photos for the fullscreen gallery (reused mechanism) ----
            if (experience.photos && experience.photos.length > 0) {
                storeGalleryPhotos = experience.photos.map((photo, index) => ({
                    ...photo,
                    alt: `${experienceName} - Foto ${index + 1}`
                }));
            } else {
                storeGalleryPhotos = [];
            }

            // ---- Render the single-scroll body ----
            detailBody.innerHTML = renderExperienceDetailBody(experience, experienceName);

            // Galería: clic en miniatura → cambia el hero (imagen principal);
            // clic en el hero → abre el visor a pantalla completa en la foto seleccionada.
            const thumbEls = detailBody.querySelectorAll('.exp-lux__thumb');
            thumbEls.forEach((el) => {
                el.addEventListener('click', () => {
                    const idx = parseInt(el.dataset.photoIndex, 10) || 0;
                    if (el.dataset.photoUrl) heroImage.src = el.dataset.photoUrl;
                    heroImage.dataset.currentIndex = idx;
                    thumbEls.forEach((t) => t.classList.toggle('is-active', t === el));
                });
            });
            heroImage.dataset.currentIndex = 0;
            const mediaPane = heroImage.closest('.exp-lux__media');
            const expandBtn = document.getElementById('experienceHeroExpand');
            const hasGallery = storeGalleryPhotos.length > 0;
            if (mediaPane) {
                mediaPane.style.cursor = hasGallery ? 'zoom-in' : '';
                mediaPane.onclick = () => {
                    if (hasGallery) openFullscreenGallery(parseInt(heroImage.dataset.currentIndex, 10) || 0);
                };
            }
            if (expandBtn) expandBtn.style.display = hasGallery ? '' : 'none';

            // Navegación de la tira: flechas ‹ › y rueda del mouse (vertical → horizontal).
            const galStrip = detailBody.querySelector('.exp-lux__gallery');
            const galPrev = detailBody.querySelector('.exp-lux__gallery-nav--prev');
            const galNext = detailBody.querySelector('.exp-lux__gallery-nav--next');
            if (galStrip && galPrev && galNext) {
                const galStep = () => Math.max(galStrip.clientWidth * 0.75, 200);
                const galUpdateNav = () => {
                    const maxScroll = galStrip.scrollWidth - galStrip.clientWidth - 2;
                    galPrev.classList.toggle('is-hidden', galStrip.scrollLeft <= 0);
                    galNext.classList.toggle('is-hidden', maxScroll <= 0 || galStrip.scrollLeft >= maxScroll);
                };
                galPrev.addEventListener('click', () => galStrip.scrollBy({ left: -galStep(), behavior: 'smooth' }));
                galNext.addEventListener('click', () => galStrip.scrollBy({ left: galStep(), behavior: 'smooth' }));
                galStrip.addEventListener('scroll', galUpdateNav);
                galStrip.addEventListener('wheel', (e) => {
                    if (galStrip.scrollWidth <= galStrip.clientWidth) return;
                    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                        galStrip.scrollLeft += e.deltaY;
                        e.preventDefault();
                    }
                }, { passive: false });
                // Recalcular al abrir (las imágenes pueden cambiar el ancho al cargar).
                galUpdateNav();
                setTimeout(galUpdateNav, 300);
            }

            // Render the prices section (kept separate for currency/payment refresh)
            loadPricesTab(experience);

            // Hide loading
            modalLoading.style.display = 'none';

        } catch (error) {
            console.error('Error loading experience details into modal:', error);
            showModalError('Error al cargar los detalles de la experiencia');
        }
    }

    // Build the full luxury detail body (all sections except prices, which are
    // injected by loadPricesTab so they can be re-rendered on filter change).
    function renderExperienceDetailBody(experience, experienceName) {
        const currency = document.getElementById('filterCurrency').value;
        const paymentType = document.getElementById('filterPayment').value;

        // Accept arrays OR newline-delimited strings for list-type fields.
        const toArr = (v) => {
            if (!v) return [];
            if (Array.isArray(v)) return v.filter(x => x !== null && x !== undefined && String(x).trim() !== '');
            return String(v).split(/\r?\n/).map(s => s.trim()).filter(Boolean);
        };

        const sections = [];

        // 1. Description (serif italic)
        if (experience.description) {
            sections.push(`<div class="exp-lux__section"><p class="exp-lux__desc">${experience.description}</p></div>`);
        }

        // 2. Info tiles: Duración, Capacidad y Tiempo de viaje.
        const durVal = experience.duration ? formatDuration(experience.duration) : '';
        const minP = experience.min_people;
        const maxP = experience.max_people || experience.capacity;
        let groupVal = '';
        if (minP && maxP) groupVal = `${minP}–${maxP} personas`;
        else if (maxP) groupVal = `Máximo ${maxP} personas`;
        else if (minP) groupVal = `Mínimo ${minP} personas`;
        const expTipo = experience.tipo || experience.experienceType;
        const tiles = [
            ['DURACIÓN', durVal || '—'],
            ['CAPACIDAD', groupVal || '—'],
        ];
        if (experience.travel_duration) {
            tiles.push(['TIEMPO DE VIAJE', formatTravelDuration(experience.travel_duration)]);
        }
        sections.push(`
            <div class="exp-lux__tiles">
                ${tiles.map(([label, val]) => `
                <div class="exp-lux__tile">
                    <span class="exp-lux__tile-label">${label}</span>
                    <span class="exp-lux__tile-value">${val}</span>
                </div>`).join('')}
            </div>
        `);

        // 2b. Itinerario (from serviceItems.subconcepts — mirrors old loadItineraryTab accessors, synchronous)
        const subconcepts = experience.serviceItems?.subconcepts || [];
        if (subconcepts.length) {
            const sortedItin = [...subconcepts].sort((a, b) =>
                parseItineraryTime(a.time || a.startTime) - parseItineraryTime(b.time || b.startTime)
            );
            const itinItems = sortedItin.map(item => {
                const startTime = item.time || item.startTime || '';
                const endTime = item.endTime || '';
                const timeDisplay = startTime ? (endTime ? `${startTime} – ${endTime}` : startTime) : '';
                const name = item.concept || 'Sin nombre';
                const notes = item.notes || '';
                return `
                    <li class="exp-lux__itinerary-item">
                        <span class="exp-lux__itinerary-dot"></span>
                        <div class="exp-lux__itinerary-body">
                            <span class="exp-lux__itinerary-name">${name}</span>
                            ${timeDisplay ? `<span class="exp-lux__itinerary-time">${timeDisplay}</span>` : ''}
                            ${notes ? `<p class="exp-lux__itinerary-notes">${notes}</p>` : ''}
                        </div>
                    </li>
                `;
            }).join('');
            sections.push(`
                <div class="exp-lux__section">
                    <h4 class="exp-lux__heading">ITINERARIO</h4>
                    <ul class="exp-lux__itinerary">${itinItems}</ul>
                </div>
            `);
        }

        // 3 + 4. Incluye / No incluye, lado a lado en 2 columnas (se apilan en panel angosto).
        const inc = toArr(experience.includes);
        const ninc = toArr(experience.notincludes);
        if (inc.length || ninc.length) {
            const incCol = inc.length ? `
                    <div class="exp-lux__inc-col">
                        <h4 class="exp-lux__heading">INCLUYE</h4>
                        <ul class="exp-lux__list">
                            ${inc.map(i => `<li><span class="exp-lux__check">✓</span><span>${i}</span></li>`).join('')}
                        </ul>
                    </div>` : '';
            const nincCol = ninc.length ? `
                    <div class="exp-lux__inc-col">
                        <h4 class="exp-lux__heading">NO INCLUYE</h4>
                        <ul class="exp-lux__list exp-lux__list--muted">
                            ${ninc.map(i => `<li><span class="exp-lux__cross">×</span><span>${i}</span></li>`).join('')}
                        </ul>
                    </div>` : '';
            sections.push(`
                <div class="exp-lux__section">
                    <div class="exp-lux__inc-grid">${incCol}${nincCol}</div>
                </div>
            `);
        }

        // 4b. Requisitos (string with newlines → pre-line, or array → list)
        const reqIsArr = Array.isArray(experience.requirements);
        const reqHas = reqIsArr ? experience.requirements.length > 0 : (experience.requirements && String(experience.requirements).trim() !== '');
        if (reqHas) {
            let reqBody;
            if (reqIsArr) {
                const items = experience.requirements.filter(x => x !== null && x !== undefined && String(x).trim() !== '');
                reqBody = `<ul class="exp-lux__list">${items.map(i => `<li><span class="exp-lux__check">✓</span><span>${i}</span></li>`).join('')}</ul>`;
            } else {
                reqBody = `<p class="exp-lux__prewrap">${experience.requirements}</p>`;
            }
            sections.push(`
                <div class="exp-lux__section">
                    <h4 class="exp-lux__heading">REQUISITOS</h4>
                    ${reqBody}
                </div>
            `);
        }

        // 5. Galería: tira horizontal con TODAS las fotos. Clic en miniatura cambia el hero.
        if (experience.photos && experience.photos.length > 0) {
            const thumbs = experience.photos.map((photo, index) => {
                const url = getOptimizedImageUrl(photo) || '/img/amexing_logo_horizontal.avif';
                return `<button type="button" class="exp-lux__thumb${index === 0 ? ' is-active' : ''}" data-photo-index="${index}" data-photo-url="${url}" style="background-image:url('${url}')" aria-label="Ver foto ${index + 1}"></button>`;
            }).join('');
            sections.push(`
                <div class="exp-lux__section">
                    <div class="exp-lux__gallery-head">
                        <h4 class="exp-lux__heading">GALERÍA</h4>
                        <div class="exp-lux__gallery-navs">
                            <button type="button" class="exp-lux__gallery-nav exp-lux__gallery-nav--prev is-hidden" aria-label="Anterior"><i class="ti ti-chevron-left"></i></button>
                            <button type="button" class="exp-lux__gallery-nav exp-lux__gallery-nav--next" aria-label="Siguiente"><i class="ti ti-chevron-right"></i></button>
                        </div>
                    </div>
                    <div class="exp-lux__gallery">${thumbs}</div>
                </div>
            `);
        }

        // 6. Reserva: tiempo de anticipación + notas de reserva, juntos en una sola sección.
        // Fall back to booking_notes/notas/notes so content isn't lost (old modal behavior).
        const bookingNotes = experience.client_booking_notes || experience.booking_notes || experience.notas || experience.notes;
        // Si la experiencia no tiene reserva anticipada configurada, se asume 24h (1 día) por default.
        const advMinResv = experience.advance_minutes || parseInt(experience.advance_booking_time) || parseInt(experience.advanceBookingTime) || 1440;
        if (advMinResv || bookingNotes) {
            let reservaInner = '';
            if (advMinResv) {
                reservaInner += `<p class="exp-lux__resv-adv">Reservar con al menos <span class="exp-lux__resv-adv-value">${formatAdvanceBooking(advMinResv)}</span> de anticipación.</p>`;
            }
            if (bookingNotes) {
                reservaInner += `<p class="exp-lux__prewrap exp-lux__resv-notes">${bookingNotes}</p>`;
            }
            sections.push(`
                <div class="exp-lux__section">
                    <h4 class="exp-lux__heading">RESERVA</h4>
                    ${reservaInner}
                </div>
            `);
        }

        // 7. Key-value rows (moneda/método de pago se muestran en la sección de precios;
        //    el tipo de experiencia se muestra como pill en el hero)
        const kv = [];
        // Ubicación
        const ubic = experience.location || experience.address;
        if (ubic) kv.push(['UBICACIÓN', ubic]);
        // Disponibilidad desglosada por día (día → sus horarios). Se agrupan los días que
        // comparten exactamente el mismo horario para no repetir (p.ej. "Lun, Mié, Vie · 9:00 am").
        const to12h = (hhmm) => {
            const m = String(hhmm || '').match(/^(\d{1,2}):(\d{2})/);
            if (!m) return '';
            let h = parseInt(m[1], 10);
            const min = m[2];
            const ampm = h >= 12 ? 'pm' : 'am';
            h = h % 12; if (h === 0) h = 12;
            return h + ':' + min + ' ' + ampm;
        };
        const schedDayAbbr = {
            '0': 'Do', '7': 'Do', 'sunday': 'Do', 'domingo': 'Do',
            '1': 'Lu', 'monday': 'Lu', 'lunes': 'Lu',
            '2': 'Ma', 'tuesday': 'Ma', 'martes': 'Ma',
            '3': 'Mi', 'wednesday': 'Mi', 'miércoles': 'Mi', 'miercoles': 'Mi',
            '4': 'Ju', 'thursday': 'Ju', 'jueves': 'Ju',
            '5': 'Vi', 'friday': 'Vi', 'viernes': 'Vi',
            '6': 'Sa', 'saturday': 'Sa', 'sábado': 'Sa', 'sabado': 'Sa'
        };
        const schedShort = { 'Lu': 'Lun', 'Ma': 'Mar', 'Mi': 'Mié', 'Ju': 'Jue', 'Vi': 'Vie', 'Sa': 'Sáb', 'Do': 'Dom' };
        const schedFull = { 'Lu': 'Lunes', 'Ma': 'Martes', 'Mi': 'Miércoles', 'Ju': 'Jueves', 'Vi': 'Viernes', 'Sa': 'Sábado', 'Do': 'Domingo' };
        const schedOrder = ['Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa', 'Do'];
        let scheduleRendered = false;
        if (Array.isArray(experience.availability) && experience.availability.length) {
            const perDay = {}; // abbr -> [horarios formateados]
            experience.availability.forEach(entry => {
                if (!entry || typeof entry !== 'object') return;
                let dv = entry.day !== undefined ? entry.day : (entry.Day !== undefined ? entry.Day : (entry.name !== undefined ? entry.name : entry.value));
                if (dv === null || dv === undefined) return;
                const abbr = schedDayAbbr[String(dv).toLowerCase().trim()];
                if (!abbr) return;
                const times = [];
                if (Array.isArray(entry.times)) {
                    entry.times.forEach(t => {
                        if (!t) return;
                        const s = to12h(t.start || t.startTime || t.start_time);
                        const e = to12h(t.end || t.endTime || t.end_time);
                        if (s) times.push(e ? `${s} – ${e}` : s);
                    });
                } else if (entry.startTime || entry.start_time) {
                    const s = to12h(entry.startTime || entry.start_time);
                    const e = to12h(entry.endTime || entry.end_time);
                    if (s) times.push(e ? `${s} – ${e}` : s);
                }
                if (!perDay[abbr]) perDay[abbr] = [];
                times.forEach(t => { if (!perDay[abbr].includes(t)) perDay[abbr].push(t); });
            });
            const activeDays = Object.keys(perDay).sort((a, b) => schedOrder.indexOf(a) - schedOrder.indexOf(b));
            const anyTimes = activeDays.some(d => perDay[d].length);
            if (activeDays.length && anyTimes) {
                // Agrupar días con el mismo conjunto de horarios.
                const groups = [];
                activeDays.forEach(d => {
                    const key = perDay[d].join('|');
                    const g = groups.find(gr => gr.key === key);
                    if (g) g.days.push(d); else groups.push({ key, days: [d], times: perDay[d] });
                });
                const rowsHtml = groups.map(g => {
                    let label;
                    if (g.days.length === 7) label = 'Todos los días';
                    else if (g.days.length === 1) label = schedFull[g.days[0]];
                    else label = g.days.map(d => schedShort[d]).join(', ');
                    const timesHtml = g.times.length
                        ? g.times.map(t => `<span class="exp-lux__sched-time">${t}</span>`).join('')
                        : '<span class="exp-lux__sched-time exp-lux__sched-time--muted">Horario por confirmar</span>';
                    return `<div class="exp-lux__sched-row"><span class="exp-lux__sched-days">${label}</span><span class="exp-lux__sched-times">${timesHtml}</span></div>`;
                }).join('');
                sections.push(`
                    <div class="exp-lux__section">
                        <h4 class="exp-lux__heading">${experience.fixed_schedule ? 'HORARIOS' : 'HORARIOS SUGERIDOS'}</h4>
                        <div class="exp-lux__sched">${rowsHtml}</div>
                    </div>
                `);
                scheduleRendered = true;
            }
        }
        // Fallback: si no hubo horarios por día, mostrar al menos los días disponibles como texto.
        if (!scheduleRendered) {
            kv.push(['DÍAS DISPONIBLES', experience.displayAvailability || 'Todos los días']);
        }
        // Tiempo de viaje
        if (kv.length) {
            sections.push(`
                <div class="exp-lux__section">
                    <div class="exp-lux__kv">
                        ${kv.map(([k, v]) => `<div class="exp-lux__kv-row"><span class="exp-lux__kv-key">${k}</span><span class="exp-lux__kv-val">${v}</span></div>`).join('')}
                    </div>
                </div>
            `);
        }

        // Idioma como chips (se lee mejor que texto plano).
        const langs = Array.isArray(experience.languages) ? experience.languages : (experience.languages ? [experience.languages] : []);
        if (langs.length) {
            sections.push(`
                <div class="exp-lux__section">
                    <h4 class="exp-lux__heading">IDIOMA</h4>
                    <div class="exp-lux__chips">
                        ${langs.map(l => `<span class="exp-lux__chip">${l}</span>`).join('')}
                    </div>
                </div>
            `);
        }

        // 8. Precios por persona (filled by loadPricesTab into #pricesContent)
        sections.push(`
            <div class="exp-lux__section">
                <h4 class="exp-lux__heading">PRECIOS POR PERSONA</h4>
                <div id="pricesContent" class="exp-lux__prices"></div>
            </div>
        `);

        // 9. Términos y condiciones (buy-out / mínimo privado) — junto a precios y cancelación al final.
        //    El contenido lo inyecta loadPricesTab en #termsContent para que los montos se
        //    conviertan por moneda/recargo y se actualicen en vivo (igual que los precios).
        const hasBuyout = experience.buyout !== null && experience.buyout !== undefined && experience.buyout !== '';
        const hasPriv = experience.private_min_value !== null && experience.private_min_value !== undefined && experience.private_min_value !== '';
        if (hasBuyout || hasPriv) {
            sections.push(`
                <div class="exp-lux__section">
                    <h4 class="exp-lux__heading">TÉRMINOS Y CONDICIONES</h4>
                    <div id="termsContent" class="exp-lux__kv"></div>
                </div>
            `);
        }

        // 10. Política de cancelación — hasta el final, como sección normal (sobria).
        if (experience.cancellation_policy) {
            sections.push(`
                <div class="exp-lux__section">
                    <h4 class="exp-lux__heading">CANCELACIÓN</h4>
                    <p class="exp-lux__prewrap">${experience.cancellation_policy}</p>
                </div>
            `);
        }

        return sections.join('');
    }
    
