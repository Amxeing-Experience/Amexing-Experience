        const modal = new bootstrap.Modal(document.getElementById('addToQuoteModal'));
        modal.show();

        try {
            const token = getAccessToken();
            const response = await fetch('/api/quotes?start=0&length=50&order[0][column]=7&order[0][dir]=desc', {
                headers: { 'Authorization': 'Bearer ' + token }
            });

            if (!response.ok) throw new Error('Error al cargar cotizaciones');
            const result = await response.json();
            const quotes = (result.data || [])
                .filter(q => ['requested', 'hold'].includes(q.status))
                .sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt));
            renderQuotePickerList(quotes);
        } catch (error) {
            console.error('Error loading quotes:', error);
            document.getElementById('quotePickerList').innerHTML =
                '<div class="quote-picker-empty"><i class="ti ti-alert-circle me-1"></i>Error al cargar cotizaciones</div>';
        } finally {
            document.getElementById('quotePickerLoading').style.display = 'none';
            document.getElementById('quotePickerList').style.display = 'block';
        }
    }

    function timeAgo(dateStr) {
        if (!dateStr) return '';
        const now = new Date();
        const date = new Date(dateStr);
        const diffMs = now - date;
        const diffMin = Math.floor(diffMs / 60000);
        const diffHrs = Math.floor(diffMs / 3600000);
        const diffDays = Math.floor(diffMs / 86400000);

        if (diffMin < 1) return 'hace un momento';
        if (diffMin < 60) return 'hace ' + diffMin + ' min';
        if (diffHrs < 24) return 'hace ' + diffHrs + (diffHrs === 1 ? ' hora' : ' horas');
        if (diffDays < 30) return 'hace ' + diffDays + (diffDays === 1 ? ' día' : ' días');
        const diffMonths = Math.floor(diffDays / 30);
        return 'hace ' + diffMonths + (diffMonths === 1 ? ' mes' : ' meses');
    }

    function renderQuotePickerList(quotes) {
        const container = document.getElementById('quotePickerList');

        if (quotes.length === 0) {
            container.innerHTML = '<div class="quote-picker-empty"><i class="ti ti-file-off me-2"></i>No hay cotizaciones editables</div>';
            return;
        }

        container.innerHTML = quotes.map(q => {
            const creatorName = q.createdBy ? q.createdBy.fullName : 'Sin asignar';
            const serviceCount = q.serviceCount || 0;
            const updated = timeAgo(q.updatedAt);

            return '<div class="quote-list-item" data-quote-id="' + q.id + '">' +
                '<div class="flex-grow-1">' +
                    '<div class="quote-folio">' + q.folio + '</div>' +
                    '<div class="quote-meta">' + serviceCount + ' servicios · ' + creatorName +
                        (updated ? ' · ' + updated : '') + '</div>' +
                '</div>' +
                '<span class="quote-status status-' + q.status + '">' + q.status + '</span>' +
            '</div>';
        }).join('');
    }

    async function showDaySelector(quoteId) {
        const token = getAccessToken();

        // Hide quote list, show loading
        document.getElementById('quotePickerList').style.display = 'none';
        document.querySelector('#createNewQuoteBtn').style.display = 'none';
        document.querySelector('.quote-search-input').style.display = 'none';
        document.getElementById('quotePickerLoading').style.display = 'block';

        // Ensure daySelector container exists
        let daySelector = document.getElementById('daySelector');
        if (!daySelector) {
            daySelector = document.createElement('div');
            daySelector.id = 'daySelector';
            document.getElementById('quotePickerList').parentNode.appendChild(daySelector);
        }
        daySelector.style.display = 'none';

        try {
            const quoteRes = await fetch('/api/quotes/' + quoteId, {
                headers: { 'Authorization': 'Bearer ' + token }
            });
            if (!quoteRes.ok) throw new Error('Error al obtener cotización');

            const quoteData = await quoteRes.json();
            const quote = quoteData.data || quoteData;
            window._selectedQuote = quote;
            const days = (quote.serviceItems && quote.serviceItems.days) || [];

            // 0 or 1 days → add directly, no extra interaction
            if (days.length <= 1) {
                document.getElementById('quotePickerLoading').style.display = 'none';
                if (days.length === 0) {
                    await addExperienceToNewDay(quoteId);
                } else {
                    await addExperienceToDay(quoteId, 0);
                }
                return;
            }

            // 2+ days → show day picker
            let html = '<div class="day-selector-back mb-3"><i class="ti ti-arrow-left me-1"></i>Volver a cotizaciones</div>';
            html += '<div class="quote-folio mb-3">' + quote.folio + ' — Seleccionar día</div>';

            html += days.map((day, idx) => {
                const scCount = (day.subconcepts || []).length;
                return '<div class="day-list-item" data-quote-id="' + quoteId + '" data-day-index="' + idx + '">' +
                    '<div class="flex-grow-1">' +
                        '<div class="day-title">Día ' + day.dayNumber + (day.dayTitle ? ' — ' + day.dayTitle : '') + '</div>' +
                        '<div class="quote-meta">' + scCount + ' servicios</div>' +
                    '</div>' +
                '</div>';
            }).join('');

            html += '<div class="new-day-date-row mt-2" data-quote-id="' + quoteId + '">' +
                '<label class="form-label small text-muted mb-1">Agregar nuevo día:</label>' +
                '<input type="date" class="form-control form-control-sm new-day-date-input" data-quote-id="' + quoteId + '">' +
            '</div>';

            daySelector.innerHTML = html;
            daySelector.style.display = 'block';

        } catch (error) {
            console.error('Error loading quote days:', error);
            showAddToQuoteError(error.message);
            // Reset to quote list
            document.getElementById('quotePickerList').style.display = 'block';
            document.querySelector('#createNewQuoteBtn').style.display = '';
            document.querySelector('.quote-search-input').style.display = '';
        } finally {
            document.getElementById('quotePickerLoading').style.display = 'none';
        }
    }

    async function addExperienceToDay(quoteId, dayIndex) {
        const experience = window._selectedExperience;
        const quote = window._selectedQuote;
        const token = getAccessToken();

        // Show loading
        document.getElementById('daySelector').style.display = 'none';
        document.getElementById('quoteActionLoading').style.display = 'block';

        try {
            const serviceItems = quote.serviceItems || { days: [], subtotal: 0, iva: 0, total: 0 };

            // Build subconcept
            const newSubconcept = {
                type: 'experience',
                experienceId: experience.id,
                title: experience.name,
                time: '',
                hours: 0,
                unitPrice: experience.price,
                total: experience.price,
                isPerPerson: true,
                numberOfPeople: 1
            };

            // Add to selected day
            serviceItems.days[dayIndex].subconcepts.push(newSubconcept);

            // Recalculate totals
            let subtotal = 0;
            serviceItems.days.forEach(day => {
                let dayTotal = 0;
                (day.subconcepts || []).forEach(sc => { dayTotal += (sc.total || 0); });
                day.dayTotal = Math.round(dayTotal * 100) / 100;
                subtotal += dayTotal;
            });
            serviceItems.subtotal = Math.round(subtotal * 100) / 100;
            serviceItems.iva = Math.round(subtotal * 0.16 * 100) / 100;
            serviceItems.total = Math.round((serviceItems.subtotal + serviceItems.iva) * 100) / 100;

            // PUT
            const updateRes = await fetch('/api/quotes/' + quoteId + '/service-items', {
                method: 'PUT',
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(serviceItems)
            });

            if (!updateRes.ok) {
                const errData = await updateRes.json();
                throw new Error(errData.error || 'Error al agregar experiencia');
            }

            bootstrap.Modal.getInstance(document.getElementById('addToQuoteModal'))?.hide();
            showAddToQuoteSuccess(quote.folio || quoteId, quoteId);

        } catch (error) {
            console.error('Error adding experience to day:', error);
            showAddToQuoteError(error.message);
            document.getElementById('daySelector').style.display = 'block';
            document.getElementById('quoteActionLoading').style.display = 'none';
        }
    }

