    // Function to load Gallery tab
    function loadGalleryTab(experience, experienceName) {
        const galleryContent = document.getElementById('galleryContent');
        const galleryPhotoBadge = document.getElementById('galleryPhotoBadge');
        
        if (experience.photos && experience.photos.length > 0) {
            // Update gallery tab badge with photo count
            galleryPhotoBadge.textContent = experience.photos.length;
            // Store photos for full-screen gallery
            storeGalleryPhotos = experience.photos.map((photo, index) => ({
                ...photo,
                alt: `${experienceName} - Foto ${index + 1}`
            }));
            
            const galleryHtml = experience.photos.map((photo, index) => {
                const optimizedPicture = createOptimizedPicture(
                    photo, 
                    `${experienceName} - Foto ${index + 1}`, 
                    '',
                    '(max-width: 768px) 50vw, (max-width: 1200px) 33vw, 25vw'
                );
                
                return `
                    <div class="gallery-item loading" data-photo-index="${index}">
                        ${optimizedPicture}
                    </div>
                `;
            }).join('');
            
            galleryContent.innerHTML = `
                <div class="photo-gallery">
                    ${galleryHtml}
                </div>
            `;
            
            // Add event listeners to gallery items
            galleryContent.querySelectorAll('.gallery-item').forEach((item, index) => {
                item.addEventListener('click', () => openFullscreenGallery(index));
                
                // Add progressive loading event listeners
                const img = item.querySelector('img');
                if (img) {
                    img.addEventListener('load', () => {
                        item.classList.remove('loading');
                        item.classList.add('loaded');
                    });
                    
                    img.addEventListener('error', () => {
                        item.classList.remove('loading');
                        item.classList.add('error');
                    });
                    
                    // If image is already loaded (from cache), trigger load event
                    if (img.complete && img.naturalHeight !== 0) {
                        img.dispatchEvent(new Event('load'));
                    }
                }
            });
        } else {
            // Update gallery tab badge to 0 when no photos
            galleryPhotoBadge.textContent = '0';
            
            galleryContent.innerHTML = `
                <div class="text-center py-5">
                    <i class="ti ti-photo" style="font-size: 3rem; color: #dee2e6;"></i>
                    <p class="mt-3 text-muted">No hay fotos disponibles para esta experiencia</p>
                </div>
            `;
        }
    }
    
    // Function to load Details tab
    function loadDetailsTab(experience) {
        const detailsContent = document.getElementById('detailsContent');
        
        // Helper function to format availability
        function formatAvailability(availability) {
            if (!availability) return '';
            
            // Debug: Log the full availability object structure
            console.log('🔍 Full availability object:', availability);
            console.log('🔍 Availability type:', typeof availability);
            if (typeof availability === 'object') {
                console.log('🔍 Availability keys:', Object.keys(availability));
                console.log('🔍 Availability JSON:', JSON.stringify(availability, null, 2));
            }
            
            // If it's already a string, return it
            if (typeof availability === 'string') {
                return availability;
            }
            
            // If it's an array, format each item
            if (Array.isArray(availability)) {
                return availability.map((item, index) => {
                    if (typeof item === 'object' && item !== null) {
                        // Format complex object with detailed information
                        const parts = [];
                        
                        // Handle day information - check for numeric 'day' field first
                        let dayName = '';
                        if (typeof item.day === 'number') {
                            const dayNum = item.day;
                            const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                            
                            if (dayNum >= 0 && dayNum <= 6) {
                                dayName = daysOfWeek[dayNum];
                            } else if (dayNum >= 1 && dayNum <= 7) {
                                const altDaysOfWeek = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
                                dayName = altDaysOfWeek[dayNum - 1];
                            } else {
                                dayName = `Día ${dayNum}`;
                            }
                        } else if (item.day || item.dia) {
                            dayName = item.day || item.dia;
                        } else if (typeof item.dayNumber === 'number' || typeof item.day_number === 'number') {
                            const dayNum = item.dayNumber || item.day_number;
                            const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                            const altDaysOfWeek = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
                            
                            if (dayNum >= 0 && dayNum <= 6) {
                                dayName = daysOfWeek[dayNum];
                            } else if (dayNum >= 1 && dayNum <= 7) {
                                dayName = altDaysOfWeek[dayNum - 1];
                            }
                        }
                        
                        if (dayName) parts.push(`<strong>${dayName}</strong>`);
                        
                        // Handle times array (the actual structure from your data)
                        if (item.times && Array.isArray(item.times)) {
                            const schedules = item.times.map(time => {
                                if (typeof time === 'object' && time.start && time.end) {
                                    return `${time.start} - ${time.end}`;
                                }
                                return JSON.stringify(time);
                            }).join('<br>&nbsp;&nbsp;• ');
                            
                            if (schedules) {
                                parts.push(`<span class="text-muted">Horarios:</span><br>&nbsp;&nbsp;• ${schedules}`);
                            }
                        }
                        
                        // Handle schedule/horarios information (fallback)
                        if (item.horarios && Array.isArray(item.horarios)) {
                            const schedules = item.horarios.map(horario => {
                                if (typeof horario === 'object') {
                                    const schedParts = [];
                                    if (horario.start || horario.inicio) schedParts.push(horario.start || horario.inicio);
                                    if (horario.end || horario.fin) schedParts.push(horario.end || horario.fin);
                                    if (schedParts.length > 0) {
                                        return schedParts.join(' - ');
                                    }
                                    return JSON.stringify(horario);
                                }
                                return String(horario);
                            }).join(', ');
                            parts.push(`<span class="text-muted">Horarios: ${schedules}</span>`);
                        } else if (item.horarios && typeof item.horarios === 'string') {
                            parts.push(`<span class="text-muted">Horarios: ${item.horarios}</span>`);
                        }
                        
                        // Handle other schedule fields
                        if (item.hours || item.horas || item.time || item.horario) {
                            const timeInfo = item.hours || item.horas || item.time || item.horario;
                            if (typeof timeInfo === 'object') {
                                parts.push(`<span class="text-muted">${JSON.stringify(timeInfo)}</span>`);
                            } else {
                                parts.push(`<span class="text-muted">${timeInfo}</span>`);
                            }
                        }
                        
                        // Handle schedule as separate field
                        if (item.schedule && item.schedule !== item.horario) {
                            parts.push(`<span class="text-muted">Horario: ${item.schedule}</span>`);
                        }
                        
                        // Handle notes
                        if (item.notes || item.notas) {
                            parts.push(`<em class="text-muted">${item.notes || item.notas}</em>`);
                        }
                        
                        // If no specific fields found, show all properties
                        if (parts.length === 1) { // Only day name was added
                            const allParts = [parts[0]]; // Keep the day name
                            Object.keys(item).forEach(key => {
                                if (key === 'day') return; // Already handled
                                const value = item[key];
                                if (value !== null && value !== undefined && value !== '') {
                                    if (typeof value === 'object') {
                                        allParts.push(`<strong>${key}:</strong> ${JSON.stringify(value)}`);
                                    } else {
                                        allParts.push(`<strong>${key}:</strong> ${value}`);
                                    }
                                }
                            });
                            return allParts.join('<br>');
                        }
                        
                        return parts.join('<br>');
                    } else if (typeof item === 'number') {
                        // Map numbers to days of the week (assuming 1-7 or 0-6)
                        const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                        const altDaysOfWeek = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
                        
                        if (item >= 0 && item <= 6) {
                            return `<strong>${daysOfWeek[item]}</strong>`;
                        } else if (item >= 1 && item <= 7) {
                            return `<strong>${altDaysOfWeek[item - 1]}</strong>`;
                        } else {
                            return `<strong>Día ${item}</strong>`;
                        }
                    }
                    return String(item);
                }).join('<br><br>'); // Add extra space between days
            }
            
            // If it's a single number, treat it as a day
            if (typeof availability === 'number') {
                const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                const altDaysOfWeek = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
                
                if (availability >= 0 && availability <= 6) {
                    return `<strong>${daysOfWeek[availability]}</strong>`;
                } else if (availability >= 1 && availability <= 7) {
                    return `<strong>${altDaysOfWeek[availability - 1]}</strong>`;
                } else {
                    return `<strong>Día ${availability}</strong>`;
                }
            }
            
            // If it's an object, format its properties with special handling for horarios
            if (typeof availability === 'object' && availability !== null) {
                const parts = [];
                
                // Special handling for horarios field
                if (availability.horarios) {
                    if (Array.isArray(availability.horarios)) {
                        const schedules = availability.horarios.map(horario => {
                            if (typeof horario === 'object') {
                                const schedParts = [];
                                if (horario.start || horario.inicio) schedParts.push(horario.start || horario.inicio);
                                if (horario.end || horario.fin) schedParts.push(horario.end || horario.fin);
                                if (schedParts.length > 0) {
                                    return schedParts.join(' - ');
                                }
                                return JSON.stringify(horario);
                            }
                            return String(horario);
                        }).join('<br>&nbsp;&nbsp;• ');
                        parts.push(`<strong>Horarios:</strong><br>&nbsp;&nbsp;• ${schedules}`);
                    } else if (typeof availability.horarios === 'string') {
                        parts.push(`<strong>Horarios:</strong> ${availability.horarios}`);
                    } else {
                        parts.push(`<strong>Horarios:</strong> ${JSON.stringify(availability.horarios)}`);
                    }
                }
                
                // Handle other properties
                Object.keys(availability).forEach(key => {
                    if (key === 'horarios') return; // Already handled above
                    
                    const value = availability[key];
                    if (value !== null && value !== undefined && value !== '') {
                        if (typeof value === 'object') {
                            if (Array.isArray(value)) {
                                parts.push(`<strong>${key}:</strong> ${value.join(', ')}`);
                            } else {
                                parts.push(`<strong>${key}:</strong> ${JSON.stringify(value, null, 2)}`);
                            }
                        } else {
                            parts.push(`<strong>${key}:</strong> ${value}`);
                        }
                    }
                });
                
                return parts.join('<br>');
            }
            
            // Fallback to string representation
            return String(availability);
        }
        
        detailsContent.innerHTML = `
            ${experience.availability ? `
                <div class="content-section">
                    <h5 class="text-info mb-3">
                        <i class="ti ti-calendar me-2"></i>${experience.fixed_schedule ? 'Horarios' : 'Horarios Sugeridos'}
                    </h5>
                    <div class="availability-grid">
                        ${Array.isArray(experience.availability) ? (() => {
                            const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                            // Availability is stored in several historical shapes:
                            //   {day, times:[{start,end}]}      (current)
                            //   {day, start_time, end_time}      (legacy, one entry per slot)
                            //   {day, startTime, endTime}        (tours, one entry per slot)
                            // Normalize all of them and GROUP by day so a day with
                            // multiple slots renders as ONE card instead of duplicated
                            // cards with no times shown.
                            const byDay = new Map();
                            const addSlot = (day, start, end) => {
                                if (typeof day !== 'number') return;
                                if (!byDay.has(day)) byDay.set(day, []);
                                if (start && end) {
                                    const label = start + ' - ' + end;
                                    if (!byDay.get(day).includes(label)) byDay.get(day).push(label);
                                }
                            };
                            experience.availability.forEach(item => {
                                if (typeof item === 'number') { addSlot(item); return; }
                                if (!item || typeof item !== 'object') return;
                                if (Array.isArray(item.times)) {
                                    if (item.times.length === 0) addSlot(item.day);
                                    item.times.forEach(t => addSlot(item.day, t.start, t.end));
                                } else {
                                    addSlot(item.day, item.start_time || item.startTime, item.end_time || item.endTime);
                                }
                            });
                            // Order Monday-first (1..6, then 0=Sunday last).
                            const weekOrder = d => (d + 6) % 7;
                            return Array.from(byDay.keys()).sort((a, b) => weekOrder(a) - weekOrder(b)).map(day => {
                                const dayName = day >= 0 && day <= 6 ? daysOfWeek[day] : 'Día ' + day;
                                const times = byDay.get(day);
                                return '<div class="availability-day-card"><strong>' + dayName + '</strong>' + (times.length > 0 ? '<div class="text-muted small mt-1">' + times.map(t => '<span class="d-block">• ' + t + '</span>').join('') + '</div>' : '') + '</div>';
                            }).join('');
                        })() : '<div class="availability-info">' + formatAvailability(experience.availability) + '</div>'}
                    </div>
                </div>
            ` : ''}
            
            ${(experience.includes && experience.includes.length > 0) || (experience.notincludes && experience.notincludes.length > 0) ? `
                <div class="row g-4">
                    ${experience.includes && experience.includes.length > 0 ? `
                        <div class="col-md-6">
                            <div class="includes-section">
                                <h5 class="text-success mb-3">
                                    <i class="ti ti-circle-check me-2"></i>Incluye
                                </h5>
                                <ul class="includes-list">
                                    ${experience.includes.map(item => `<li><i class="ti ti-check text-success me-2"></i>${item}</li>`).join('')}
                                </ul>
                            </div>
                        </div>
                    ` : ''}
                    ${experience.notincludes && experience.notincludes.length > 0 ? `
                        <div class="col-md-6">
                            <div class="excludes-section">
                                <h5 class="text-danger mb-3">
                                    <i class="ti ti-circle-x me-2"></i>No Incluye
                                </h5>
                                <ul class="excludes-list">
                                    ${experience.notincludes.map(item => `<li><i class="ti ti-x text-danger me-2"></i>${item}</li>`).join('')}
                                </ul>
                            </div>
                        </div>
                    ` : ''}
                </div>
            ` : ''}
            
            ${experience.requirements ? `
                <div class="content-section">
                    <h5><i class="ti ti-backpack me-2"></i>Requisitos</h5>
                    <div class="requirements-content" style="white-space: pre-line;">
                        ${experience.requirements}
                    </div>
                </div>
            ` : ''}
            
            ${experience.notes ? `
                <div class="content-section">
                    <h5><i class="ti ti-note me-2"></i>Notas</h5>
                    <div class="notes-content" style="white-space: pre-line;">
                        ${experience.notes}
                    </div>
                </div>
            ` : ''}

            ${experience.languages && experience.languages.length > 0 ? `
                <div class="content-section">
                    <h5><i class="ti ti-language me-2"></i>Idiomas</h5>
                    <div class="languages">
                        ${experience.languages.map(lang => `<span class="badge bg-info me-2">${lang}</span>`).join('')}
                    </div>
                </div>
            ` : ''}

            ${(experience.cancellation_policy || (experience.buyout !== null && experience.buyout !== undefined) || (experience.private_min_value !== null && experience.private_min_value !== undefined)) ? `
                <div class="content-section">
                    <h5 class="text-warning mb-3"><i class="ti ti-file-description me-2"></i>Términos y condiciones</h5>
                    <ul class="list-unstyled mb-0">
                        ${experience.cancellation_policy ? `<li class="mb-2"><strong><i class="ti ti-calendar-x me-1"></i>Políticas de cancelación:</strong> <span style="white-space: pre-line;">${experience.cancellation_policy}</span></li>` : ''}
                        ${(experience.buyout !== null && experience.buyout !== undefined) ? `<li class="mb-2"><strong><i class="ti ti-cash me-1"></i>Buy-out:</strong> $${Number(experience.buyout).toLocaleString('es-MX', { minimumFractionDigits: 2 })}</li>` : ''}
                        ${(experience.private_min_value !== null && experience.private_min_value !== undefined) ? `<li class="mb-2"><strong><i class="ti ti-lock me-1"></i>Mínimo para hacerlo privado:</strong> ${experience.private_min_type === 'monto' ? '$' + Number(experience.private_min_value).toLocaleString('es-MX', { minimumFractionDigits: 2 }) : Number(experience.private_min_value) + ' personas'}</li>` : ''}
                    </ul>
                </div>
            ` : ''}
        `;
    }

    // Render the "Precios por persona" section into #pricesContent.
    // Kept as a standalone function because it is re-invoked when the currency
    // or payment-method filter changes (see the filter change handlers).
    function loadPricesTab(experience) {
        const pricesContent = document.getElementById('pricesContent');
        if (!pricesContent) return;

        // Read current currency & payment type from the page filters.
        const currency = document.getElementById('filterCurrency').value;
        const paymentType = document.getElementById('filterPayment').value;
        const unit = `${currency} / PERSONA`;

        const cards = [];
        const addCard = (label, subtitle, price) => {
            if (parseFloat(price || 0) > 0) {
                cards.push(`
                    <div class="exp-lux__price-card">
                        <div class="exp-lux__price-left">
                            <span class="exp-lux__price-name">${label}</span>
                            <span class="exp-lux__price-sub">${subtitle}</span>
                        </div>
                        <div class="exp-lux__price-right">
                            <span class="exp-lux__price-amount">${convertExperiencePrice(price, currency, paymentType)}</span>
                            <span class="exp-lux__price-unit">${unit}</span>
                        </div>
                    </div>
                `);
            }
        };

        addCard('ADULTO', 'Precio general', experience.displayPrice || experience.cost || experience.price);
        addCard('NIÑO', 'Precio niño', experience.displayPriceChild || experience.price_child);
        addCard('SIN ALCOHOL', 'Sin alcohol', experience.displayPriceNoAlcohol || experience.price_no_alcohol);

        // Moneda y método de pago aplicados a estos precios (se actualizan con los filtros).
        const currencyMap = { MXN: 'MXN — Peso Mexicano', USD: 'USD — US Dollar' };
        const payMap = { efectivo: 'Efectivo', transferencia: 'Transferencia bancaria', tarjeta: 'Tarjeta de crédito' };
        const metaRows = [['Moneda', currencyMap[currency] || currency]];
        if (payMap[paymentType]) metaRows.push(['Método de pago', payMap[paymentType]]);
        const metaHtml = `<div class="exp-lux__price-meta">${metaRows.map(([k, v]) => `<div class="exp-lux__price-meta-row"><span>${k}</span><span>${v}</span></div>`).join('')}</div>`;

        pricesContent.innerHTML = (cards.length ? cards.join('') : `<p class="exp-lux__quote">Por cotizar</p>`) + metaHtml;

        // Términos y condiciones (buy-out / mínimo privado): los montos usan el MISMO cálculo
        // que los precios por persona (convertExperiencePrice → recargo por pago + conversión a
        // USD + comas) y se refrescan aquí en cada cambio de moneda/pago.
        const termsContent = document.getElementById('termsContent');
        if (termsContent) {
            const trows = [];
            const hasBuyout = experience.buyout !== null && experience.buyout !== undefined && experience.buyout !== '';
            const hasPriv = experience.private_min_value !== null && experience.private_min_value !== undefined && experience.private_min_value !== '';
            if (hasBuyout) trows.push(['Buy-out', convertExperiencePrice(experience.buyout, currency, paymentType)]);
            if (hasPriv) trows.push(['Mínimo para hacerlo privado', experience.private_min_type === 'monto'
                ? convertExperiencePrice(experience.private_min_value, currency, paymentType)
                : Number(experience.private_min_value) + ' personas']);
            termsContent.innerHTML = trows.map(([k, v]) => `<div class="exp-lux__kv-row"><span class="exp-lux__kv-key">${k}</span><span class="exp-lux__kv-val">${v}</span></div>`).join('');
        }
    }
    
    // Function to load Itinerary tab
    async function loadItineraryTab(experience) {
        const itineraryContent = document.getElementById('itineraryContent');
        const itineraryTabItem = document.getElementById('itineraryTabItem');
        const itineraryCountBadge = document.getElementById('itineraryCountBadge');

        // Hide tab for department_manager and client roles
        <% if (currentUserRole === 'department_manager' || currentUserRole === 'client') { %>
            if (itineraryTabItem) itineraryTabItem.style.display = 'none';
            return;
        <% } %>

        const subconcepts = experience.serviceItems?.subconcepts || [];

        // Hide tab if no services
        if (subconcepts.length === 0) {
            if (itineraryTabItem) itineraryTabItem.style.display = 'none';
            return;
        }

        // Show tab and set badge count
        if (itineraryTabItem) itineraryTabItem.style.display = '';
        if (itineraryCountBadge) itineraryCountBadge.textContent = subconcepts.length;

        // Fetch images for experiences and tours referenced in subconcepts
        const imageCache = {};
        const token = getAccessToken();

        const imagePromises = subconcepts.map(async (item) => {
            const itemId = item.experienceId || item.tourId;
            const itemType = item.type;
            if (!itemId || imageCache[itemId]) return;
            imageCache[itemId] = '/img/amexing_logo_horizontal.avif'; // default placeholder

            try {
                let endpoint = '';
                if (itemType === 'experience' && item.experienceId) {
                    endpoint = `/api/experiences/${item.experienceId}/images`;
                } else if (itemType === 'tour' && item.tourId) {
                    endpoint = `/api/tours/${item.tourId}/images`;
                }
                if (!endpoint) return;

                const resp = await fetch(endpoint, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (resp.ok) {
                    const data = await resp.json();
                    const images = data.data || [];
                    if (images.length > 0) {
                        const primary = images.find(img => img.isPrimary || img.isPrincipal) || images[0];
                        imageCache[itemId] = primary.formats?.webp || primary.formats?.jpeg || primary.formats?.avif || primary.url || imageCache[itemId];
                    }
                }
            } catch (e) {
                // keep placeholder
            }
        });

        await Promise.all(imagePromises);

        // Fetch nested subconcepts for embedded experiences (1 level deep)
        const nestedSubconceptsMap = {};
        const nestedPromises = subconcepts
            .filter(item => item.type === 'experience' && item.experienceId)
            .map(async (item) => {
                try {
                    const resp = await fetch(`/api/experiences/${item.experienceId}`, {
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Content-Type': 'application/json'
                        }
                    });
                    if (resp.ok) {
                        const data = await resp.json();
                        const detail = data.data || data;
                        const nested = detail.serviceItems?.subconcepts || [];
                        if (nested.length > 0) {
                            nestedSubconceptsMap[item.experienceId] = nested;
                        }
                    }
                } catch (e) { /* parent renders normally without children */ }
            });
        await Promise.all(nestedPromises);

        // Fetch images for nested subconcepts
        const nestedImagePromises = [];
        for (const nestedItems of Object.values(nestedSubconceptsMap)) {
            for (const nested of nestedItems) {
                const nestedId = nested.experienceId || nested.tourId;
                if (!nestedId || imageCache[nestedId]) continue;
                imageCache[nestedId] = '/img/amexing_logo_horizontal.avif';
                nestedImagePromises.push((async () => {
                    try {
                        let endpoint = '';
                        if (nested.type === 'experience' && nested.experienceId) {
                            endpoint = `/api/experiences/${nested.experienceId}/images`;
                        } else if (nested.type === 'tour' && nested.tourId) {
                            endpoint = `/api/tours/${nested.tourId}/images`;
                        }
                        if (!endpoint) return;
                        const resp = await fetch(endpoint, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        if (resp.ok) {
                            const data = await resp.json();
                            const images = data.data || [];
                            if (images.length > 0) {
                                const primary = images.find(img => img.isPrimary || img.isPrincipal) || images[0];
                                imageCache[nestedId] = primary.formats?.webp || primary.formats?.jpeg || primary.formats?.avif || primary.url || imageCache[nestedId];
                            }
                        }
                    } catch (e) { /* keep placeholder */ }
                })());
            }
        }
        await Promise.all(nestedImagePromises);

        // Update badge count including nested items
        let totalItemCount = subconcepts.length;
        for (const items of Object.values(nestedSubconceptsMap)) {
            totalItemCount += items.length;
        }
        if (itineraryCountBadge) itineraryCountBadge.textContent = totalItemCount;

        // Sort by start time
        const sorted = [...subconcepts].sort((a, b) => {
            const timeA = parseItineraryTime(a.time || a.startTime);
            const timeB = parseItineraryTime(b.time || b.startTime);
            return timeA - timeB;
        });

        // Build timeline HTML
        let timelineHtml = '<div class="itinerary-timeline p-4">';

        sorted.forEach((item, index) => {
            const startTime = item.time || item.startTime || '';
            const endTime = item.endTime || '';
            const timeDisplay = startTime
                ? (endTime ? `${startTime} - ${endTime}` : startTime)
                : 'Sin horario';
            const typeIcon = getServiceTypeIcon(item.type);
            const typeBadge = getServiceTypeBadge(item.type);
            const notes = item.notes || '';
            const itemId = item.experienceId || item.tourId;
            const imageUrl = (itemId && imageCache[itemId]) ? imageCache[itemId] : '/img/amexing_logo_horizontal.avif';
            const nestedItems = (item.type === 'experience' && item.experienceId)
                ? nestedSubconceptsMap[item.experienceId] || []
                : [];

            timelineHtml += `
                <div class="itinerary-item ${index < sorted.length - 1 || nestedItems.length > 0 ? 'has-connector' : ''}">
                    <div class="itinerary-dot">
                        <i class="${typeIcon}"></i>
                    </div>
                    <div class="itinerary-card">
                        <div class="d-flex align-items-start gap-3">
                            <img src="${imageUrl}" alt="${item.concept || ''}" class="itinerary-thumb rounded">
                            <div class="flex-grow-1">
                                <span class="itinerary-time-badge">
                                    <i class="ti ti-clock me-1"></i>${timeDisplay}
                                </span>
                                <h6 class="mb-1 mt-2">${item.concept || 'Sin nombre'}</h6>
                                <span class="badge ${typeBadge.class} mb-1">${typeBadge.label}</span>
                                ${nestedItems.length > 0 ? `<span class="text-muted small ms-1"><i class="ti ti-list-tree me-1"></i>${nestedItems.length} actividades</span>` : ''}
                                ${notes ? `<div class="text-muted small mt-1 fst-italic"><i class="ti ti-notes me-1"></i>${notes}</div>` : ''}
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Render nested sub-items for embedded experiences
            if (nestedItems.length > 0) {
                const sortedNested = [...nestedItems].sort((a, b) => {
                    return parseItineraryTime(a.time || a.startTime) - parseItineraryTime(b.time || b.startTime);
                });

                timelineHtml += '<div class="itinerary-nested-group">';
                sortedNested.forEach((nested, nIdx) => {
                    const nStartTime = nested.time || nested.startTime || '';
                    const nEndTime = nested.endTime || '';
                    const nTimeDisplay = nStartTime
                        ? (nEndTime ? `${nStartTime} - ${nEndTime}` : nStartTime)
                        : '';
                    const nTypeIcon = getServiceTypeIcon(nested.type);
                    const nTypeBadge = getServiceTypeBadge(nested.type);
                    const nItemId = nested.experienceId || nested.tourId;
                    const nImageUrl = (nItemId && imageCache[nItemId]) ? imageCache[nItemId] : '/img/amexing_logo_horizontal.avif';

                    timelineHtml += `
                        <div class="itinerary-nested-item">
                            <div class="itinerary-nested-dot">
                                <i class="${nTypeIcon}"></i>
                            </div>
                            <div class="itinerary-nested-card">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="${nImageUrl}" alt="${nested.concept || ''}" class="itinerary-nested-thumb rounded">
                                    <div class="flex-grow-1">
                                        ${nTimeDisplay ? `<span class="itinerary-nested-time"><i class="ti ti-clock me-1"></i>${nTimeDisplay}</span>` : ''}
                                        <span class="d-block fw-semibold small">${nested.concept || 'Sin nombre'}</span>
                                        <span class="badge ${nTypeBadge.class}" style="font-size: 0.65rem;">${nTypeBadge.label}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                });
                timelineHtml += '</div>';
            }
        });

        timelineHtml += '</div>';

        itineraryContent.innerHTML = timelineHtml;
    }

    function parseItineraryTime(timeStr) {
        if (!timeStr) return 999999;
        const parts = timeStr.split(':');
        if (parts.length >= 2) {
            return parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
        }
        return 999999;
    }

    function getServiceTypeIcon(type) {
        const icons = {
            experience: 'ti ti-beach',
            tour: 'ti ti-map-2',
            transport: 'ti ti-car',
            concepto: 'ti ti-tag',
        };
        return icons[type] || 'ti ti-point-filled';
    }

    function getServiceTypeBadge(type) {
        const badges = {
            experience: { class: 'bg-success-subtle text-success', label: 'Experiencia' },
            tour: { class: 'bg-info-subtle text-info', label: 'Tour' },
            transport: { class: 'bg-warning-subtle text-warning', label: 'Transporte' },
            concepto: { class: 'bg-secondary-subtle text-secondary', label: 'Concepto' },
        };
        return badges[type] || { class: 'bg-light text-dark', label: type || 'Otro' };
    }

    // Helper functions (copied from tours) - formatDuration removed (using the one that handles minutes)
    
    function getOptimizedImageUrl(photo, size = 'medium') {
        console.log('🔧 getOptimizedImageUrl called with photo:', photo);
        
        if (!photo) {
            console.log('❌ Photo is null/undefined');
            return null;
        }
        
        // If it's just a string URL, return it as-is
        if (typeof photo === 'string') {
            console.log('✅ Photo is string URL:', photo);
            return photo;
        }
        
        // Check for optimized variants first (best quality formats first)
        if (photo.optimizedVariants) {
            console.log('📁 Found optimizedVariants:', photo.optimizedVariants);
            // Prefer AVIF > WebP > JPEG for best compression
            if (photo.optimizedVariants.avif && photo.optimizedVariants.avif.url) {
                console.log('✅ Using optimizedVariants AVIF:', photo.optimizedVariants.avif.url);
                return photo.optimizedVariants.avif.url;
            }
            if (photo.optimizedVariants.webp && photo.optimizedVariants.webp.url) {
                console.log('✅ Using optimizedVariants WebP:', photo.optimizedVariants.webp.url);
                return photo.optimizedVariants.webp.url;
            }
            if (photo.optimizedVariants.jpeg && photo.optimizedVariants.jpeg.url) {
                console.log('✅ Using optimizedVariants JPEG:', photo.optimizedVariants.jpeg.url);
                return photo.optimizedVariants.jpeg.url;
            }
        }
        
        // Check optimization metadata formats
        if (photo.optimizationMetadata && photo.optimizationMetadata.formats) {
            console.log('📁 Found optimizationMetadata.formats:', photo.optimizationMetadata.formats);
            const formats = photo.optimizationMetadata.formats;
            // Prefer AVIF > WebP > JPEG
            if (formats.avif && formats.avif.url) {
                console.log('✅ Using metadata AVIF:', formats.avif.url);
                return formats.avif.url;
            }
            if (formats.webp && formats.webp.url) {
                console.log('✅ Using metadata WebP:', formats.webp.url);
                return formats.webp.url;
            }
            if (formats.jpeg && formats.jpeg.url) {
                console.log('✅ Using metadata JPEG:', formats.jpeg.url);
                return formats.jpeg.url;
            }
        }
        
        // Check for formats property (provider experiences often have this structure)
        if (photo.formats && typeof photo.formats === 'object') {
            console.log('📁 Found formats object:', photo.formats);
            // Prefer AVIF > WebP > JPEG
            if (photo.formats.avif) {
                console.log('✅ Using formats AVIF:', photo.formats.avif);
                return photo.formats.avif;
            }
            if (photo.formats.webp) {
                console.log('✅ Using formats WebP:', photo.formats.webp);
                return photo.formats.webp;
            }
            if (photo.formats.jpeg) {
                console.log('✅ Using formats JPEG:', photo.formats.jpeg);
                return photo.formats.jpeg;
            }
        }
        
        // Fallback to direct properties
        if (photo.webp) {
            console.log('✅ Using direct webp property:', photo.webp);
            return photo.webp;
        }
        if (photo.avif) {
            console.log('✅ Using direct avif property:', photo.avif);
            return photo.avif;
        }
        if (photo.jpeg) {
            console.log('✅ Using direct jpeg property:', photo.jpeg);
            return photo.jpeg;
        }
        if (photo.url) {
            console.log('✅ Using direct url property:', photo.url);
            return photo.url;
        }
        if (photo.dataUrl) {
            console.log('✅ Using direct dataUrl property:', photo.dataUrl);
            return photo.dataUrl;
        }
        if (photo.s3Key) {
            const s3Url = `https://amexing-bucket.s3.us-east-2.amazonaws.com/${photo.s3Key}`;
            console.log('✅ Using s3Key to construct URL:', s3Url);
            return s3Url;
        }
        
        // Return null instead of placeholder to let caller handle fallback
        console.log('❌ No valid image URL found, returning null');
        return null;
    }
    
    function createOptimizedPicture(photo, alt, className = '', sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw') {
        const imageUrl = getOptimizedImageUrl(photo);
        return `<img src="${imageUrl}" alt="${alt}" class="${className}" loading="lazy" sizes="${sizes}" onload="this.classList.add('loaded')" onerror="this.classList.add('error')">`;
    }
    
    function formatCurrency(amount) {
        return new Intl.NumberFormat('es-MX', { 
            style: 'currency', 
            currency: 'MXN' 
        }).format(amount);
    }
    
    function showModalError(message) {
        const modalLoading = document.getElementById('experienceModalLoading');
        const detailBody = document.getElementById('experienceDetailBody');

        if (detailBody) detailBody.innerHTML = '';
        if (modalLoading) {
            modalLoading.style.display = 'block';
            modalLoading.innerHTML = `
                <div class="text-center py-5">
                    <i class="ti ti-alert-triangle text-warning" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Error</h5>
                    <p class="text-muted">${message}</p>
                </div>
            `;
        }
    }
    
    function openFullscreenGallery(index) {
        galleryCurrentIndex = index;
        const modal = new bootstrap.Modal(document.getElementById('fullscreenGalleryModal'));
        updateGalleryDisplay();
        modal.show();
        initializeGalleryEventListeners();
    }
    
    function updateGalleryDisplay() {
        if (!storeGalleryPhotos || storeGalleryPhotos.length === 0) return;
        
        const mainImage = document.getElementById('galleryMainImage');
        const galleryCounter = document.getElementById('galleryCounter');
        
        const currentPhoto = storeGalleryPhotos[galleryCurrentIndex];
        mainImage.src = getOptimizedImageUrl(currentPhoto);
        mainImage.alt = currentPhoto.alt || `Foto ${galleryCurrentIndex + 1}`;
        
        if (galleryCounter) {
            galleryCounter.textContent = `${galleryCurrentIndex + 1} / ${storeGalleryPhotos.length}`;
        }
        
        // Update navigation buttons visibility
        const prevBtn = document.getElementById('galleryPrevBtn');
        const nextBtn = document.getElementById('galleryNextBtn');
        
        if (prevBtn) prevBtn.style.display = galleryCurrentIndex > 0 ? 'block' : 'none';
        if (nextBtn) nextBtn.style.display = galleryCurrentIndex < storeGalleryPhotos.length - 1 ? 'block' : 'none';
        
        // Generate thumbnails if they don't exist
        generateThumbnails();
        updateThumbnailSelection();
    }
    
    function initializeGalleryEventListeners() {
        const prevBtn = document.getElementById('galleryPrevBtn');
        const nextBtn = document.getElementById('galleryNextBtn');
        
        if (prevBtn) {
            prevBtn.onclick = () => {
                if (galleryCurrentIndex > 0) {
                    galleryCurrentIndex--;
                    updateGalleryDisplay();
                }
            };
        }
        
        if (nextBtn) {
            nextBtn.onclick = () => {
                if (galleryCurrentIndex < storeGalleryPhotos.length - 1) {
                    galleryCurrentIndex++;
                    updateGalleryDisplay();
                }
            };
        }
        
        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            const modal = document.getElementById('fullscreenGalleryModal');
            if (modal.classList.contains('show')) {
                if (e.key === 'ArrowLeft' && galleryCurrentIndex > 0) {
                    galleryCurrentIndex--;
                    updateGalleryDisplay();
                } else if (e.key === 'ArrowRight' && galleryCurrentIndex < storeGalleryPhotos.length - 1) {
                    galleryCurrentIndex++;
                    updateGalleryDisplay();
                } else if (e.key === 'Escape') {
                    bootstrap.Modal.getInstance(modal).hide();
                }
            }
        });
    }
    
    // Add thumbnail functions
    function generateThumbnails() {
        const container = document.getElementById('galleryThumbnails');
        if (!container || !storeGalleryPhotos || storeGalleryPhotos.length <= 1) {
            if (container) container.style.display = 'none';
            return;
        }
        
        container.style.display = 'block';
        const thumbnailsHtml = storeGalleryPhotos.map((photo, index) => {
            const isActive = index === galleryCurrentIndex ? 'active' : '';
            return `
                <div class="gallery-thumbnail ${isActive}" data-index="${index}">
                    <img src="${getOptimizedImageUrl(photo)}" alt="Miniatura ${index + 1}" loading="lazy">
                </div>
            `;
        }).join('');
        
        container.innerHTML = `
            <div class="thumbnails-scroll">
                ${thumbnailsHtml}
            </div>
        `;
        
        // Add click listeners to thumbnails
        container.querySelectorAll('.gallery-thumbnail').forEach((thumbnail, index) => {
            thumbnail.addEventListener('click', () => {
                galleryCurrentIndex = index;
                updateGalleryDisplay();
            });
        });
    }
    
    function updateThumbnailSelection() {
        const thumbnails = document.querySelectorAll('.gallery-thumbnail');
        thumbnails.forEach((thumb, index) => {
            thumb.classList.toggle('active', index === galleryCurrentIndex);
        });
    }
    
    // Make functions available globally
    window.showExperienceDetailsModal = showExperienceDetailsModal;
});
</script>

<style>
/* Progressive Image Loading */
.image-loading-container {
    position: relative;
    width: 100%;
    height: 200px;
}

.experience-img.loading {
    opacity: 0.7;
    transition: opacity 0.3s ease;
}

.experience-img:not(.loading) {
    opacity: 1;
}

.progressive-loader {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    pointer-events: none;
}

.loading-pulse {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(248, 250, 252, 0.9);
    position: relative;
    animation: pulse 2s ease-in-out infinite;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.loading-pulse::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 16px;
    background: #6c757d;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: pulseInner 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { 
        transform: scale(1);
        opacity: 1;
    }
    50% { 
        transform: scale(1.1);
        opacity: 0.8;
    }
}

@keyframes pulseInner {
    0%, 100% { 
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.6;
    }
    50% { 
        transform: translate(-50%, -50%) scale(0.8);
        opacity: 1;
    }
}

/* Hide loading indicator when image loads */
.experience-img:not(.loading) ~ .progressive-loader {
    display: none;
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
    .loading-pulse { animation: none; }
    .loading-pulse::before { animation: none; }
    .experience-img { transition: none; }
}

