            `;
        }).join('');
        
        // Set up proper event listeners for images (CSP-compliant)
        setTimeout(() => {
            const images = document.querySelectorAll('.experience-img');
            images.forEach(img => {
                // Handle successful image load
                img.addEventListener('load', function() {
                    this.classList.remove('loading');
                    // Hide the loading indicator
                    const loader = this.closest('.image-loading-container')?.querySelector('.progressive-loader');
                    if (loader) {
                        loader.style.display = 'none';
                    }
                });
                
                // Handle image load error (403 = expired URL, try fallback formats)
                img.addEventListener('error', function() {
                    console.warn('❌ Image failed to load (likely expired S3 URL):', this.src);
                    
                    // Try to fall back to other formats if AVIF fails
                    const picture = this.parentElement;
                    const sources = picture.querySelectorAll('source');
                    
                    // If this was AVIF that failed, try removing AVIF sources to fall back to WebP/JPEG
                    if (this.src.includes('.avif')) {
                        sources.forEach(source => {
                            if (source.type === 'image/avif') {
                                source.remove();
                            }
                        });
                        
                        // Try to reload without AVIF
                        if (sources.length > 0) {
                            console.log('🔄 Retrying without AVIF...');
                            this.src = this.src; // Trigger reload
                            return;
                        }
                    }
                    
                    // If all formats fail, show no-image fallback
                    const container = this.closest('.experience-card-image');
                    if (container) {
                        container.innerHTML = `
                            <div class="no-image" style="display: flex; align-items: center; justify-content: center; height: 200px; background: #ffffff;">
                                <img src="/img/amexing_logo_horizontal.avif" alt="Amexing" style="max-width: 60%; max-height: 50%; object-fit: contain;">
                            </div>
                        `;
                    }
                });
            });
        }, 50);
    }

    // Search and filter experiences
    function searchExperiences() {
        const searchFilter = document.getElementById('searchExperience').value.toLowerCase();
        const categoryFilter = document.getElementById('filterCategory')?.value || '';

        filteredExperiences = allExperiences.filter(experience => {
            // Filtros de contenido (búsqueda + tipo de experiencia); moneda/pago solo recalculan precio.
            const matchesSearch = !searchFilter ||
                experience.displayName.toLowerCase().includes(searchFilter) ||
                (experience.displayDescription && experience.displayDescription.toLowerCase().includes(searchFilter)) ||
                (experience.providerName && experience.providerName.toLowerCase().includes(searchFilter));

            const matchesCategory = !categoryFilter || experience.experience_category === categoryFilter;

            return matchesSearch && matchesCategory;
        });
        
        // Sort filtered results alphabetically by name
        filteredExperiences.sort((a, b) => {
            const nameA = (a.displayName || a.name || '').toLowerCase().trim();
            const nameB = (b.displayName || b.name || '').toLowerCase().trim();
            return nameA.localeCompare(nameB, 'es', { numeric: true, sensitivity: 'base' });
        });

        displayExperiences();
    }

