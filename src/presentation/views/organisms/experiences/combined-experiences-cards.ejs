    // Function to load Details tab
    function loadDetailsTab(experience) {
        const detailsContent = document.getElementById('detailsContent');
        
        // Helper function to format availability
        function formatAvailability(availability) {
            if (!availability) return '';
            
            // Debug: Log the full availability object structure
            console.log('🔍 Full availability object:', availability);
            console.log('🔍 Availability type:', typeof availability);
            if (typeof availability === 'object') {
                console.log('🔍 Availability keys:', Object.keys(availability));
                console.log('🔍 Availability JSON:', JSON.stringify(availability, null, 2));
            }
            
            // If it's already a string, return it
            if (typeof availability === 'string') {
                return availability;
            }
            
            // If it's an array, format each item
            if (Array.isArray(availability)) {
                return availability.map((item, index) => {
                    if (typeof item === 'object' && item !== null) {
                        // Format complex object with detailed information
                        const parts = [];
                        
                        // Handle day information - check for numeric 'day' field first
                        let dayName = '';
                        if (typeof item.day === 'number') {
                            const dayNum = item.day;
                            const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                            
                            if (dayNum >= 0 && dayNum <= 6) {
                                dayName = daysOfWeek[dayNum];
                            } else if (dayNum >= 1 && dayNum <= 7) {
                                const altDaysOfWeek = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
                                dayName = altDaysOfWeek[dayNum - 1];
                            } else {
                                dayName = `Día ${dayNum}`;
                            }
                        } else if (item.day || item.dia) {
                            dayName = item.day || item.dia;
                        } else if (typeof item.dayNumber === 'number' || typeof item.day_number === 'number') {
                            const dayNum = item.dayNumber || item.day_number;
                            const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                            const altDaysOfWeek = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
                            
                            if (dayNum >= 0 && dayNum <= 6) {
                                dayName = daysOfWeek[dayNum];
                            } else if (dayNum >= 1 && dayNum <= 7) {
                                dayName = altDaysOfWeek[dayNum - 1];
                            }
                        }
                        
                        if (dayName) parts.push(`<strong>${dayName}</strong>`);
                        
                        // Handle times array (the actual structure from your data)
                        if (item.times && Array.isArray(item.times)) {
                            const schedules = item.times.map(time => {
                                if (typeof time === 'object' && time.start && time.end) {
                                    return `${time.start} - ${time.end}`;
                                }
                                return JSON.stringify(time);
                            }).join('<br>&nbsp;&nbsp;• ');
                            
                            if (schedules) {
                                parts.push(`<span class="text-muted">Horarios:</span><br>&nbsp;&nbsp;• ${schedules}`);
                            }
                        }
                        
                        // Handle schedule/horarios information (fallback)
                        if (item.horarios && Array.isArray(item.horarios)) {
                            const schedules = item.horarios.map(horario => {
                                if (typeof horario === 'object') {
                                    const schedParts = [];
                                    if (horario.start || horario.inicio) schedParts.push(horario.start || horario.inicio);
                                    if (horario.end || horario.fin) schedParts.push(horario.end || horario.fin);
                                    if (schedParts.length > 0) {
                                        return schedParts.join(' - ');
                                    }
                                    return JSON.stringify(horario);
                                }
                                return String(horario);
                            }).join(', ');
                            parts.push(`<span class="text-muted">Horarios: ${schedules}</span>`);
                        } else if (item.horarios && typeof item.horarios === 'string') {
                            parts.push(`<span class="text-muted">Horarios: ${item.horarios}</span>`);
                        }
                        
                        // Handle other schedule fields
                        if (item.hours || item.horas || item.time || item.horario) {
                            const timeInfo = item.hours || item.horas || item.time || item.horario;
                            if (typeof timeInfo === 'object') {
                                parts.push(`<span class="text-muted">${JSON.stringify(timeInfo)}</span>`);
                            } else {
                                parts.push(`<span class="text-muted">${timeInfo}</span>`);
                            }
                        }
                        
                        // Handle schedule as separate field
                        if (item.schedule && item.schedule !== item.horario) {
                            parts.push(`<span class="text-muted">Horario: ${item.schedule}</span>`);
                        }
                        
                        // Handle notes
                        if (item.notes || item.notas) {
                            parts.push(`<em class="text-muted">${item.notes || item.notas}</em>`);
                        }
                        
                        // If no specific fields found, show all properties
                        if (parts.length === 1) { // Only day name was added
                            const allParts = [parts[0]]; // Keep the day name
                            Object.keys(item).forEach(key => {
                                if (key === 'day') return; // Already handled
                                const value = item[key];
                                if (value !== null && value !== undefined && value !== '') {
                                    if (typeof value === 'object') {
                                        allParts.push(`<strong>${key}:</strong> ${JSON.stringify(value)}`);
                                    } else {
                                        allParts.push(`<strong>${key}:</strong> ${value}`);
                                    }
                                }
                            });
                            return allParts.join('<br>');
                        }
                        
                        return parts.join('<br>');
                    } else if (typeof item === 'number') {
                        // Map numbers to days of the week (assuming 1-7 or 0-6)
                        const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                        const altDaysOfWeek = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
                        
                        if (item >= 0 && item <= 6) {
                            return `<strong>${daysOfWeek[item]}</strong>`;
                        } else if (item >= 1 && item <= 7) {
                            return `<strong>${altDaysOfWeek[item - 1]}</strong>`;
                        } else {
                            return `<strong>Día ${item}</strong>`;
                        }
                    }
                    return String(item);
                }).join('<br><br>'); // Add extra space between days
            }
            
            // If it's a single number, treat it as a day
            if (typeof availability === 'number') {
                const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                const altDaysOfWeek = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
                
                if (availability >= 0 && availability <= 6) {
                    return `<strong>${daysOfWeek[availability]}</strong>`;
                } else if (availability >= 1 && availability <= 7) {
                    return `<strong>${altDaysOfWeek[availability - 1]}</strong>`;
                } else {
                    return `<strong>Día ${availability}</strong>`;
                }
            }
            
            // If it's an object, format its properties with special handling for horarios
            if (typeof availability === 'object' && availability !== null) {
                const parts = [];
                
                // Special handling for horarios field
                if (availability.horarios) {
                    if (Array.isArray(availability.horarios)) {
                        const schedules = availability.horarios.map(horario => {
                            if (typeof horario === 'object') {
                                const schedParts = [];
                                if (horario.start || horario.inicio) schedParts.push(horario.start || horario.inicio);
                                if (horario.end || horario.fin) schedParts.push(horario.end || horario.fin);
                                if (schedParts.length > 0) {
                                    return schedParts.join(' - ');
                                }
                                return JSON.stringify(horario);
                            }
                            return String(horario);
                        }).join('<br>&nbsp;&nbsp;• ');
                        parts.push(`<strong>Horarios:</strong><br>&nbsp;&nbsp;• ${schedules}`);
                    } else if (typeof availability.horarios === 'string') {
                        parts.push(`<strong>Horarios:</strong> ${availability.horarios}`);
                    } else {
                        parts.push(`<strong>Horarios:</strong> ${JSON.stringify(availability.horarios)}`);
                    }
                }
                
                // Handle other properties
                Object.keys(availability).forEach(key => {
                    if (key === 'horarios') return; // Already handled above
                    
                    const value = availability[key];
                    if (value !== null && value !== undefined && value !== '') {
                        if (typeof value === 'object') {
                            if (Array.isArray(value)) {
                                parts.push(`<strong>${key}:</strong> ${value.join(', ')}`);
                            } else {
                                parts.push(`<strong>${key}:</strong> ${JSON.stringify(value, null, 2)}`);
                            }
                        } else {
                            parts.push(`<strong>${key}:</strong> ${value}`);
                        }
                    }
                });
                
                return parts.join('<br>');
            }
            
            // Fallback to string representation
            return String(availability);
        }
        
        detailsContent.innerHTML = `
            ${experience.availability ? `
                <div class="content-section">
                    <h5 class="text-info mb-3">
                        <i class="ti ti-calendar me-2"></i>${experience.fixed_schedule ? 'Horarios' : 'Horarios Sugeridos'}
                    </h5>
                    <div class="availability-grid">
                        ${Array.isArray(experience.availability) ? (() => {
                            const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
                            // Availability is stored in several historical shapes:
                            //   {day, times:[{start,end}]}      (current)
                            //   {day, start_time, end_time}      (legacy, one entry per slot)
                            //   {day, startTime, endTime}        (tours, one entry per slot)
                            // Normalize all of them and GROUP by day so a day with
                            // multiple slots renders as ONE card instead of duplicated
                            // cards with no times shown.
                            const byDay = new Map();
                            const addSlot = (day, start, end) => {
                                if (typeof day !== 'number') return;
                                if (!byDay.has(day)) byDay.set(day, []);
                                if (start && end) {
                                    const label = start + ' - ' + end;
                                    if (!byDay.get(day).includes(label)) byDay.get(day).push(label);
                                }
                            };
                            experience.availability.forEach(item => {
                                if (typeof item === 'number') { addSlot(item); return; }
                                if (!item || typeof item !== 'object') return;
                                if (Array.isArray(item.times)) {
                                    if (item.times.length === 0) addSlot(item.day);
                                    item.times.forEach(t => addSlot(item.day, t.start, t.end));
                                } else {
                                    addSlot(item.day, item.start_time || item.startTime, item.end_time || item.endTime);
                                }
                            });
                            // Order Monday-first (1..6, then 0=Sunday last).
                            const weekOrder = d => (d + 6) % 7;
                            return Array.from(byDay.keys()).sort((a, b) => weekOrder(a) - weekOrder(b)).map(day => {
                                const dayName = day >= 0 && day <= 6 ? daysOfWeek[day] : 'Día ' + day;
                                const times = byDay.get(day);
                                return '<div class="availability-day-card"><strong>' + dayName + '</strong>' + (times.length > 0 ? '<div class="text-muted small mt-1">' + times.map(t => '<span class="d-block">• ' + t + '</span>').join('') + '</div>' : '') + '</div>';
                            }).join('');
                        })() : '<div class="availability-info">' + formatAvailability(experience.availability) + '</div>'}
                    </div>
                </div>
            ` : ''}
            
            ${(experience.includes && experience.includes.length > 0) || (experience.notincludes && experience.notincludes.length > 0) ? `
                <div class="row g-4">
                    ${experience.includes && experience.includes.length > 0 ? `
                        <div class="col-md-6">
                            <div class="includes-section">
                                <h5 class="text-success mb-3">
                                    <i class="ti ti-circle-check me-2"></i>Incluye
                                </h5>
                                <ul class="includes-list">
                                    ${experience.includes.map(item => `<li><i class="ti ti-check text-success me-2"></i>${item}</li>`).join('')}
                                </ul>
                            </div>
                        </div>
                    ` : ''}
                    ${experience.notincludes && experience.notincludes.length > 0 ? `
                        <div class="col-md-6">
                            <div class="excludes-section">
                                <h5 class="text-danger mb-3">
                                    <i class="ti ti-circle-x me-2"></i>No Incluye
                                </h5>
                                <ul class="excludes-list">
                                    ${experience.notincludes.map(item => `<li><i class="ti ti-x text-danger me-2"></i>${item}</li>`).join('')}
                                </ul>
                            </div>
                        </div>
                    ` : ''}
                </div>
            ` : ''}
            
            ${experience.requirements ? `
                <div class="content-section">
                    <h5><i class="ti ti-backpack me-2"></i>Requisitos</h5>
                    <div class="requirements-content" style="white-space: pre-line;">
                        ${experience.requirements}
                    </div>
                </div>
            ` : ''}
            
            ${experience.notes ? `
                <div class="content-section">
                    <h5><i class="ti ti-note me-2"></i>Notas</h5>
                    <div class="notes-content" style="white-space: pre-line;">
                        ${experience.notes}
                    </div>
                </div>
            ` : ''}

            ${experience.languages && experience.languages.length > 0 ? `
                <div class="content-section">
                    <h5><i class="ti ti-language me-2"></i>Idiomas</h5>
                    <div class="languages">
                        ${experience.languages.map(lang => `<span class="badge bg-info me-2">${lang}</span>`).join('')}
                    </div>
                </div>
            ` : ''}

            ${(experience.cancellation_policy || (experience.buyout !== null && experience.buyout !== undefined) || (experience.private_min_value !== null && experience.private_min_value !== undefined)) ? `
                <div class="content-section">
                    <h5 class="text-warning mb-3"><i class="ti ti-file-description me-2"></i>Condiciones</h5>
                    <ul class="list-unstyled mb-0">
                        ${experience.cancellation_policy ? `<li class="mb-2"><strong><i class="ti ti-calendar-x me-1"></i>Políticas de cancelación:</strong> <span style="white-space: pre-line;">${experience.cancellation_policy}</span></li>` : ''}
                        ${(experience.buyout !== null && experience.buyout !== undefined) ? `<li class="mb-2"><strong><i class="ti ti-cash me-1"></i>Buy-out:</strong> $${Number(experience.buyout).toLocaleString('es-MX', { minimumFractionDigits: 2 })}</li>` : ''}
                        ${(experience.private_min_value !== null && experience.private_min_value !== undefined) ? `<li class="mb-2"><strong><i class="ti ti-lock me-1"></i>Mínimo para hacerlo privado:</strong> ${experience.private_min_type === 'monto' ? '$' + Number(experience.private_min_value).toLocaleString('es-MX', { minimumFractionDigits: 2 }) : Number(experience.private_min_value) + ' personas'}</li>` : ''}
                    </ul>
                </div>
            ` : ''}
        `;
    }

