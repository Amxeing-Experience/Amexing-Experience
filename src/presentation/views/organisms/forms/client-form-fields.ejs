<%
/**
 * Campos del formulario de cliente directo (datos esenciales + acordeones opcionales:
 * contactos, empresa/fiscal, direccion, requerimientos + password). Reutilizable: modal de la
 * lista y pagina de detalle. Lo requerido se agrupa arriba para alta rapida; lo opcional colapsado.
 * Prefill (editar): un <script> en la vista contenedora setea los #directClient* desde el cliente;
 * los acordeones con datos se abren solos (window.cffRefreshAccordions() para re-evaluar tras prefill).
 * Provee tambien el CSS+JS de acordeon que reutiliza agency-form-fields (siempre co-presente).
 * Created by Denisse Maldonado
 */
%>
<style>
  .client-form-editorial{--olive:#6E7A50;--olive-d:#566040;--line:#ded9cb;--ink:#2b2b2b;--muted:#8a8f78;}
  /* Encabezados de sección → editorial (mayúsculas, línea sutil) */
  .client-form-editorial h6{text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;font-weight:700;color:var(--olive-d)!important;
    border:0!important;padding:0 0 .5rem 0!important;margin:1.7rem 0 1.1rem;position:relative;}
  .client-form-editorial h6::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;background:var(--line);}
  .client-form-editorial .mb-4:first-child > h6{margin-top:0;}
  /* Etiquetas consistentes */
  .client-form-editorial .form-label,.client-form-editorial label.form-label{font-size:.78rem;font-weight:600;color:var(--ink);margin-bottom:.35rem;}
  /* Inputs/selects/áreas → mismo tamaño, borde salvia, foco olivo */
  .client-form-editorial .form-control,.client-form-editorial .form-select{
    border:1px solid var(--line);border-radius:10px;padding:.6rem .85rem;font-size:.9rem;color:var(--ink);min-height:44px;background:#fff;box-shadow:none;}
  .client-form-editorial .form-control:focus,.client-form-editorial .form-select:focus{
    border-color:var(--olive);box-shadow:0 0 0 .18rem rgba(110,122,80,.12);}
  .client-form-editorial textarea.form-control{min-height:92px;}
  /* input-group (password): bordes/altura alineados con los demás inputs */
  .client-form-editorial .input-group > .form-control{border-radius:10px 0 0 10px;}
  .client-form-editorial .input-group > .btn{border:1px solid var(--line);border-left:0;}
  .client-form-editorial .input-group > .btn:last-child{border-radius:0 10px 10px 0;}
  .client-form-editorial .form-text{font-size:.72rem;color:var(--muted);}
  /* Espaciado uniforme entre campos */
  .client-form-editorial .row > [class*="col-"]{margin-bottom:1rem;}
  /* Campo solo en su fila → ocupa el ancho completo (sin hueco a la derecha) */
  .client-form-editorial .row > .col-md-6:only-child{flex:0 0 100%;max-width:100%;}
  /* Bloque esencial (alta rápida) */
  .client-form-editorial .cff-essential-note{font-size:.78rem;color:var(--muted);font-style:italic;margin:.2rem 0 1rem;}
  .client-form-editorial .cff-req-tag{display:inline-block;font-size:.62rem;letter-spacing:.05em;text-transform:none;color:var(--muted);
    border:1px solid var(--line);border-radius:999px;padding:1px 9px;margin-left:8px;vertical-align:middle;font-weight:600;}
  /* Acordeón (secciones opcionales) — compartido con agency-form-fields */
  .client-form-editorial .cff-acc{border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden;background:#fff;}
  .client-form-editorial .cff-acc-h{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;
    padding:14px 18px;cursor:pointer;background:#fbfaf6;border:0;text-align:left;}
  .client-form-editorial .cff-acc-h .cff-t{text-transform:uppercase;letter-spacing:.14em;font-size:.72rem;font-weight:700;
    color:var(--olive-d);display:flex;align-items:center;gap:10px;}
  .client-form-editorial .cff-acc-h .cff-t i{opacity:.7;}
  .client-form-editorial .cff-acc-h .cff-badge{background:#eceadd;color:var(--olive-d);border-radius:999px;font-size:.64rem;
    padding:2px 9px;font-weight:700;letter-spacing:.05em;text-transform:none;}
  .client-form-editorial .cff-acc-h .cff-chev{transition:transform .2s;color:var(--muted);margin-left:auto;}
  .client-form-editorial .cff-acc.open .cff-acc-h .cff-chev{transform:rotate(90deg);}
  .client-form-editorial .cff-acc-body{padding:0 18px;max-height:0;overflow:hidden;transition:max-height .28s ease,padding .28s ease;}
  .client-form-editorial .cff-acc.open .cff-acc-body{padding:18px;max-height:2600px;}
  .client-form-editorial .cff-hint-optional{font-size:.75rem;color:var(--muted);font-style:italic;margin:.4rem 0 .9rem;}
</style>
<div class="client-form-editorial">
                        <!-- ===== Bloque esencial: lo mínimo para crear (requeridos agrupados) ===== -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="ti ti-user me-1"></i>
                                Datos para crear
                                <span class="cff-req-tag">lo mínimo</span>
                            </h6>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="directClientCategory">Tipo de Cliente</label>
                                    <select class="form-select" id="directClientCategory" name="clientCategory">
                                        <option value="direct_client" selected>Cliente Directo</option>
                                        <option value="wedding_planner">Wedding Planner</option>
                                        <option value="concierge">Concierge</option>
                                        <option value="home_owner">Home Owner</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/phone-input', {
                                        name: 'phone',
                                        id: 'directClientPhone',
                                        label: 'Teléfono',
                                        required: false,
                                        countryCode: 'MX',
                                        placeholder: '999 123 4567',
                                        helpText: 'Número de contacto principal'
                                    }) %>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/first-name-input', {
                                        name: 'firstName',
                                        id: 'directClientFirstName',
                                        label: 'Nombre',
                                        required: true,
                                        placeholder: 'Ej: Juan',
                                        helpText: 'Primer nombre del cliente'
                                    }) %>
                                </div>
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/last-name-input', {
                                        name: 'lastName',
                                        id: 'directClientLastName',
                                        label: 'Apellido',
                                        required: true,
                                        placeholder: 'Ej: Pérez',
                                        helpText: 'Apellido(s) del cliente'
                                    }) %>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <%- include('../../atoms/common/email-input', {
                                        name: 'email',
                                        id: 'directClientEmail',
                                        label: 'Correo Electrónico',
                                        required: false,
                                        placeholder: 'cliente@empresa.com',
                                        helpText: 'Requerido si defines contraseña'
                                    }) %>
                                </div>
                                <!-- Contraseña (opcional): mismo componente reutilizable que el form de agencia -->
                                <div class="col-md-6">
                                    <%- include('../../molecules/common/password-field', {
                                        id: 'directClientPassword',
                                        name: 'password',
                                        label: 'Contraseña',
                                        required: false,
                                        helpText: 'Si la defines, el cliente inicia sesión con su email. Déjala vacía para asignarla después.'
                                    }) %>
                                </div>
                            </div>
                        </div>

                        <p class="cff-hint-optional"><i class="ti ti-chevron-down me-1"></i>Información opcional — ábrela solo si la necesitas</p>

                        <!-- ===== Opcional: Datos personales y contactos ===== -->
                        <div class="cff-acc">
                            <button type="button" class="cff-acc-h js-cff-acc" aria-expanded="false">
                                <span class="cff-t"><i class="ti ti-users"></i>Datos personales y contactos</span>
                                <span class="cff-badge">Opcional</span>
                                <span class="cff-chev"><i class="ti ti-chevron-right"></i></span>
                            </button>
                            <div class="cff-acc-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <%- include('../../atoms/form/datepicker', {
                                            name: 'birthDate',
                                            id: 'directClientBirthDate',
                                            label: 'Fecha de nacimiento',
                                            required: false,
                                            min: '1900-01-01',
                                            max: new Date().toISOString().split('T')[0]
                                        }) %>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <%- include('../../atoms/common/first-name-input', {
                                            name: 'contactFirstName',
                                            id: 'directClientContactFirstName',
                                            label: 'Nombre de Contacto',
                                            required: false,
                                            placeholder: 'Ej: María',
                                            helpText: 'Nombre de la persona de contacto en la empresa'
                                        }) %>
                                    </div>
                                    <div class="col-md-6">
                                        <%- include('../../atoms/common/last-name-input', {
                                            name: 'contactLastName',
                                            id: 'directClientContactLastName',
                                            label: 'Apellido de Contacto',
                                            required: false,
                                            placeholder: 'Ej: García',
                                            helpText: 'Apellido de la persona de contacto'
                                        }) %>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <%- include('../../atoms/common/emergency-contact-input', {
                                            name: 'emergencyContactName',
                                            id: 'directClientEmergencyContactName',
                                            label: 'Contacto de Emergencia',
                                            required: false,
                                            placeholder: 'Ej: Carlos Pérez',
                                            helpText: 'Persona a contactar en caso de emergencia'
                                        }) %>
                                    </div>
                                    <div class="col-md-6">
                                        <%- include('../../atoms/common/emergency-phone-input', {
                                            name: 'emergencyContactPhone',
                                            id: 'directClientEmergencyContactPhone',
                                            label: 'Teléfono de Emergencia',
                                            required: false,
                                            countryCode: 'MX',
                                            placeholder: '999 123 4567',
                                            helpText: 'Número disponible 24/7'
                                        }) %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ===== Opcional: Empresa (lo fiscal va por perfiles de facturación) ===== -->
                        <div class="cff-acc">
                            <button type="button" class="cff-acc-h js-cff-acc" aria-expanded="false">
                                <span class="cff-t"><i class="ti ti-building"></i>Empresa</span>
                                <span class="cff-badge">Opcional</span>
                                <span class="cff-chev"><i class="ti ti-chevron-right"></i></span>
                            </button>
                            <div class="cff-acc-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <%- include('../../molecules/common/form-field', {
                                            type: 'select',
                                            name: 'companyType',
                                            id: 'directClientCompanyType',
                                            label: 'Tipo de Empresa',
                                            required: false,
                                            options: [
                                                { value: '', text: 'Seleccione un tipo' },
                                                { value: 'individual', text: 'Persona Física' },
                                                { value: 'corporate', text: 'Persona Moral' },
                                                { value: 'travel_agency', text: 'Agencia de Viajes' },
                                                { value: 'tour_operator', text: 'Tour Operador' },
                                                { value: 'other', text: 'Otro' }
                                            ],
                                            helpText: 'Tipo de organización'
                                        }) %>
                                    </div>
                                    <div class="col-md-6">
                                        <%- include('../../atoms/common/url-input', {
                                            name: 'website',
                                            id: 'directClientWebsite',
                                            label: 'Sitio Web',
                                            required: false,
                                            placeholder: 'https://www.ejemplo.com',
                                            helpText: 'URL completa del sitio web de la empresa'
                                        }) %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ===== Opcional: Dirección ===== -->
                        <div class="cff-acc">
                            <button type="button" class="cff-acc-h js-cff-acc" aria-expanded="false">
                                <span class="cff-t"><i class="ti ti-map-pin"></i>Dirección</span>
                                <span class="cff-badge">Opcional</span>
                                <span class="cff-chev"><i class="ti ti-chevron-right"></i></span>
                            </button>
                            <div class="cff-acc-body">
                                <div class="row">
                                    <div class="col-md-3">
                                        <%- include('../../atoms/common/street-type-select', {
                                            name: 'streetType',
                                            id: 'directClientStreetType',
                                            label: 'Tipo de Vialidad',
                                            required: false,
                                            helpText: 'Tipo de vía',
                                            value: 'Calle'
                                        }) %>
                                    </div>
                                    <div class="col-md-5">
                                        <%- include('../../atoms/common/street-name-input', {
                                            name: 'streetName',
                                            id: 'directClientStreetName',
                                            label: 'Nombre de la Calle',
                                            required: false,
                                            placeholder: 'Ej: Reforma, 60, Insurgentes',
                                            helpText: 'Nombre de la calle'
                                        }) %>
                                    </div>
                                    <div class="col-md-2">
                                        <%- include('../../atoms/common/exterior-number-input', {
                                            name: 'exteriorNumber',
                                            id: 'directClientExteriorNumber',
                                            label: 'No. Exterior',
                                            required: false,
                                            placeholder: '123',
                                            helpText: 'Número exterior'
                                        }) %>
                                    </div>
                                    <div class="col-md-2">
                                        <%- include('../../atoms/common/interior-number-input', {
                                            name: 'interiorNumber',
                                            id: 'directClientInteriorNumber',
                                            label: 'No. Interior',
                                            required: false,
                                            placeholder: '4B',
                                            helpText: 'Depto/oficina'
                                        }) %>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <%- include('../../atoms/common/colonia-input', {
                                            name: 'colonia',
                                            id: 'directClientColonia',
                                            label: 'Colonia',
                                            required: false,
                                            placeholder: 'Ej: Centro, Roma Norte',
                                            helpText: 'Nombre de la colonia'
                                        }) %>
                                    </div>
                                    <div class="col-md-4">
                                        <%- include('../../atoms/common/city-input', {
                                            name: 'city',
                                            id: 'directClientCity',
                                            label: 'Ciudad / Municipio',
                                            required: false,
                                            placeholder: 'Ej: Mérida, Guadalajara',
                                            helpText: 'Ciudad o municipio'
                                        }) %>
                                    </div>
                                    <div class="col-md-4">
                                        <%- include('../../atoms/common/state-select', {
                                            name: 'state',
                                            id: 'directClientState',
                                            label: 'Estado',
                                            required: false,
                                            helpText: 'Estado o región',
                                            value: ''
                                        }) %>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <%- include('../../atoms/common/postal-code-input', {
                                            name: 'postalCode',
                                            id: 'directClientPostalCode',
                                            label: 'Código Postal',
                                            required: false,
                                            placeholder: '12345',
                                            helpText: '5 dígitos',
                                            country: 'MX'
                                        }) %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ===== Opcional: Requerimientos Especiales ===== -->
                        <div class="cff-acc">
                            <button type="button" class="cff-acc-h js-cff-acc" aria-expanded="false">
                                <span class="cff-t"><i class="ti ti-heart"></i>Requerimientos Especiales</span>
                                <span class="cff-badge">Opcional</span>
                                <span class="cff-chev"><i class="ti ti-chevron-right"></i></span>
                            </button>
                            <div class="cff-acc-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <%- include('../../atoms/common/language-select', {
                                            name: 'preferredLanguage',
                                            id: 'directClientPreferredLanguage',
                                            label: 'Idioma Preferido',
                                            required: false,
                                            helpText: 'Idioma para comunicaciones y servicios',
                                            value: 'es'
                                        }) %>
                                    </div>
                                    <div class="col-md-6">
                                        <%- include('../../atoms/common/accessibility-input', {
                                            name: 'accessibilityRequirements',
                                            id: 'directClientAccessibilityRequirements',
                                            label: 'Requerimientos de Accesibilidad',
                                            required: false,
                                            placeholder: 'Ej: Silla de ruedas, bastón, asistencia visual...',
                                            helpText: 'Necesidades especiales de accesibilidad'
                                        }) %>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <%- include('../../atoms/common/allergies-input', {
                                            name: 'allergies',
                                            id: 'directClientAllergies',
                                            label: 'Alergias',
                                            required: false,
                                            placeholder: 'Ingrese cada alergia en una línea separada',
                                            helpText: 'Una alergia por línea para mejor organización'
                                        }) %>
                                    </div>
                                    <div class="col-md-6">
                                        <%- include('../../atoms/common/dietary-restrictions-input', {
                                            name: 'dietaryRestrictions',
                                            id: 'directClientDietaryRestrictions',
                                            label: 'Restricciones Alimenticias',
                                            required: false,
                                            placeholder: 'Ingrese cada restricción en una línea separada',
                                            helpText: 'Una restricción por línea para mejor organización'
                                        }) %>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <%- include('../../molecules/common/form-field', {
                                            type: 'textarea',
                                            name: 'notes',
                                            id: 'directClientNotes',
                                            label: 'Notas Adicionales',
                                            required: false,
                                            placeholder: 'Cualquier información adicional relevante sobre el cliente...',
                                            helpText: 'Información general adicional',
                                            inputAttributes: { rows: '3' }
                                        }) %>
                                    </div>
                                </div>
                            </div>
                        </div>
</div>
<script>
(function () {
    // Acordeón editorial reutilizable (client + agency). Idempotente: seguro si se incluye una vez por página.
    function isFilled(el) {
        if (!el || el.type === 'hidden' || el.disabled) return false;
        if (el.tagName === 'SELECT') return el.selectedIndex > 0 && String(el.value || '').trim() !== '';
        return String(el.value || '').trim() !== '';
    }
    function openAcc(acc, open) {
        acc.classList.toggle('open', open);
        var h = acc.querySelector('.js-cff-acc');
        if (h) h.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    function refresh() {
        // Abre automáticamente los acordeones que ya tengan datos (modo edición / prefill)
        document.querySelectorAll('.client-form-editorial .cff-acc').forEach(function (acc) {
            var filled = Array.prototype.some.call(acc.querySelectorAll('input, select, textarea'), isFilled);
            if (filled) openAcc(acc, true);
        });
    }
    function init() {
        document.querySelectorAll('.client-form-editorial .js-cff-acc').forEach(function (h) {
            if (h.dataset.cffBound) return;
            h.dataset.cffBound = '1';
            h.addEventListener('click', function () {
                var acc = h.closest('.cff-acc');
                openAcc(acc, !acc.classList.contains('open'));
            });
        });
        refresh();
    }
    // Exponer para que el prefill de edición re-evalúe tras setear valores
    window.cffRefreshAccordions = refresh;
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();
</script>
