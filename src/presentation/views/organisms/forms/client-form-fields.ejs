<script>
(function () {
    // Acordeón editorial reutilizable (client + agency). Idempotente: seguro si se incluye una vez por página.
    function isFilled(el) {
        if (!el || el.type === 'hidden' || el.disabled) return false;
        if (el.tagName === 'SELECT') return el.selectedIndex > 0 && String(el.value || '').trim() !== '';
        return String(el.value || '').trim() !== '';
    }
    function openAcc(acc, open) {
        acc.classList.toggle('open', open);
        var h = acc.querySelector('.js-cff-acc');
        if (h) h.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    function refresh() {
        // Abre automáticamente los acordeones que ya tengan datos (modo edición / prefill)
        document.querySelectorAll('.client-form-editorial .cff-acc').forEach(function (acc) {
            var filled = Array.prototype.some.call(acc.querySelectorAll('input, select, textarea'), isFilled);
            if (filled) openAcc(acc, true);
        });
    }
    function init() {
        document.querySelectorAll('.client-form-editorial .js-cff-acc').forEach(function (h) {
            if (h.dataset.cffBound) return;
            h.dataset.cffBound = '1';
            h.addEventListener('click', function () {
                var acc = h.closest('.cff-acc');
                openAcc(acc, !acc.classList.contains('open'));
            });
        });
        refresh();
    }
    // Exponer para que el prefill de edición re-evalúe tras setear valores
    window.cffRefreshAccordions = refresh;
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();

(function () {
    // Segmented "Tipo de Cliente" ↔ input hidden #directClientCategory (compatibilidad con el submit)
    // Hint de capacidades por tipo (texto informativo; la fuente real es endClientCapabilities.js)
    var HINTS = {
        direct_client: 'Podrá crear y ver sus cotizaciones. Sin acceso al tarifario.',
        wedding_planner: 'Verá el tarifario y podrá cotizar. Catálogo de destinos y experiencias populares.',
        concierge: 'Verá el tarifario completo y podrá crear y ver cotizaciones.',
        home_owner: 'Solo verá el tarifario y el catálogo popular. No crea cotizaciones.'
    };
    function setHint(val) {
        var el = document.getElementById('directClientCategoryHint');
        if (!el) return;
        var txt = Object.prototype.hasOwnProperty.call(HINTS, val) ? HINTS[val] : '';
        el.innerHTML = txt ? '<i class="ti ti-info-circle me-1"></i>' + txt : '';
    }
    function sync() {
        var hidden = document.getElementById('directClientCategory');
        var radios = document.querySelectorAll('input[name="directClientCategorySeg"]');
        if (!hidden || !radios.length) return;
        // init: reflejar el valor del hidden (prefill/edición) en el segmento
        var current = hidden.value || 'direct_client';
        var matched = false;
        radios.forEach(function (r) {
            if (r.value === current) { r.checked = true; matched = true; }
            if (!r.dataset.segBound) {
                r.dataset.segBound = '1';
                r.addEventListener('change', function () { if (r.checked) { hidden.value = r.value; setHint(r.value); } });
            }
        });
        if (!matched && radios[0]) { radios[0].checked = true; hidden.value = radios[0].value; }
        setHint(hidden.value);
    }
    // Exponer para re-sincronizar tras el prefill de edición
    window.cffSyncCategory = sync;
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sync);
    else sync();
})();
</script>
