<%
/**
 * Custom Bootstrap Dropdown Select Component
 * Clean, reliable dropdown with search functionality
 * Uses native Bootstrap components for better integration
 *
 * Atomic Design Level: Atom
 * Category: Common Form Components
 *
 * @param {string} id - Select element ID (required)
 * @param {string} name - Name attribute for form submission
 * @param {boolean} multiple - Enable multi-select (default: false)
 * @param {string} placeholder - Placeholder text
 * @param {string} label - Field label text
 * @param {boolean} required - Mark field as required
 * @param {string} helpText - Help text below field
 * @param {array} options - Initial options [{value, text}]
 * @param {array} selected - Pre-selected values
 * @param {string} additionalClasses - Additional CSS classes
 * @param {boolean} disabled - Disable the dropdown
 *
 * @example
 * include('atoms/common/tom-select', {
 *   id: 'mySelect',
 *   name: 'items',
 *   placeholder: 'Search items...',
 *   label: 'Choose Items',
 *   options: [{value: '1', text: 'Option 1'}]
 * })
 */

// Required parameters
if (typeof id === 'undefined') {
    throw new Error('Custom Select component requires an "id" parameter');
}

// Default parameters
const selectId = id;
const selectName = typeof name !== 'undefined' ? name : selectId;
const selectMultiple = typeof multiple !== 'undefined' ? multiple : false;
const selectPlaceholder = typeof placeholder !== 'undefined' ? placeholder : 'Seleccionar...';
const selectLabel = typeof label !== 'undefined' ? label : '';
const selectRequired = typeof required !== 'undefined' ? required : false;
const selectHelpText = typeof helpText !== 'undefined' ? helpText : '';
const selectOptions = typeof options !== 'undefined' ? options : [];
const selectSelected = typeof selected !== 'undefined' ? selected : [];
const selectAdditionalClasses = typeof additionalClasses !== 'undefined' ? additionalClasses : '';
const selectDisabled = typeof disabled !== 'undefined' ? disabled : false;
// Modo combobox (opt-in): permite crear una opción escribiendo un texto nuevo.
const selectAllowCreate = typeof allowCreate !== 'undefined' ? allowCreate : false;
const selectCreateLabel = typeof createLabel !== 'undefined' ? createLabel : 'Crear';
// displayField (opcional): campo de la opción a mostrar en el input al seleccionar (p.ej.
// 'firstName'), aunque la búsqueda/lista sigan usando el texto completo. '' = usar text.
const selectDisplayField = typeof displayField !== 'undefined' ? displayField : '';
%>

<div class="mb-3 <%= selectAdditionalClasses %>">
    <% if (selectLabel) { %>
        <label for="<%= selectId %>" class="form-label">
            <%= selectLabel %>
            <% if (selectRequired) { %><span class="text-danger">*</span><% } %>
        </label>
    <% } %>

    <!-- Hidden input to store actual value -->
    <input type="hidden" id="<%= selectId %>" name="<%= selectName %>" <% if (selectRequired) { %>required<% } %> <% if (selectDisabled) { %>disabled<% } %> />

    <!-- Custom dropdown interface -->
    <div class="dropdown position-relative">
    <% if (selectAllowCreate) { %>
        <!-- Modo typeahead (allowCreate): campo de texto editable; al teclear aparece la lista.
             Se siente como un input normal (sin la cajita de "Buscar" aparte). -->
        <input type="text"
               class="form-control dropdown-typeahead-input"
               id="<%= selectId %>_display"
               placeholder="<%= selectPlaceholder %>"
               autocomplete="off"
               <% if (selectDisabled) { %>disabled<% } %> />
        <div class="dropdown-menu w-100 p-0" id="<%= selectId %>_menu" style="max-height: 300px; overflow-y: auto; top: 100%; left: 0;">
            <div id="<%= selectId %>_options" class="dropdown-options">
                <% if (selectOptions && selectOptions.length > 0) { %>
                    <% selectOptions.forEach(function(option) { %>
                        <a class="dropdown-item dropdown-option" href="#" data-value="<%= option.value %>" data-text="<%= option.text %>"><%= option.text %></a>
                    <% }); %>
                <% } %>
            </div>
        </div>
    <% } else { %>
        <div class="form-control dropdown-input-display <% if (selectDisabled) { %>disabled<% } %>"
             id="<%= selectId %>_display"
             <% if (!selectDisabled) { %>data-bs-toggle="dropdown"<% } %>
             aria-expanded="false"
             style="cursor: <% if (selectDisabled) { %>not-allowed<% } else { %>pointer<% } %>; display: flex; justify-content: between; align-items: center; <% if (selectDisabled) { %>background-color: #e9ecef; opacity: 1;<% } %>">
            <span class="dropdown-selected-text text-muted"><%= selectPlaceholder %></span>
            <i class="ti ti-chevron-down ms-auto"></i>
        </div>

        <div class="dropdown-menu w-100 p-0" id="<%= selectId %>_menu" style="max-height: 300px; overflow-y: auto;">
            <!-- Search input -->
            <div class="p-2 border-bottom position-relative">
                <input type="text"
                       class="form-control form-control-sm"
                       id="<%= selectId %>_search"
                       placeholder="Buscar..."
                       autocomplete="off">
                <!-- Search loader -->
                <div class="position-absolute top-50 end-0 translate-middle-y me-3 d-none"
                     id="<%= selectId %>_search_loader">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Buscando...</span>
                    </div>
                </div>
            </div>

            <!-- Options container -->
            <div id="<%= selectId %>_options" class="dropdown-options">
                <% if (selectOptions && selectOptions.length > 0) { %>
                    <% selectOptions.forEach(function(option) { %>
                        <a class="dropdown-item dropdown-option"
                           href="#"
                           data-value="<%= option.value %>"
                           data-text="<%= option.text %>">
                            <%= option.text %>
                        </a>
                    <% }); %>
                <% } else { %>
                    <div class="dropdown-item-text text-muted">No hay opciones disponibles</div>
                <% } %>
            </div>
        </div>
    <% } %>
    </div>

    <% if (selectHelpText) { %>
        <div class="form-text"><%= selectHelpText %></div>
    <% } %>
</div>

<script>
(function() {
    'use strict';
    
    const selectId = '<%= selectId %>';
    const isDisabled = <%= selectDisabled ? 'true' : 'false' %>;
    const allowCreate = <%= selectAllowCreate ? 'true' : 'false' %>;
    const createLabel = '<%= selectCreateLabel %>';
    const displayField = '<%= selectDisplayField %>';
    const typeahead = allowCreate;
    const hiddenInput = document.getElementById(selectId);
    const displayElement = document.getElementById(selectId + '_display');
    // En typeahead el propio campo editable es el buscador; no hay span/chevron/loader internos.
    const searchInput = typeahead ? displayElement : document.getElementById(selectId + '_search');
    const searchLoader = document.getElementById(selectId + '_search_loader');
    const optionsContainer = document.getElementById(selectId + '_options');
    const menuElement = document.getElementById(selectId + '_menu');
    const selectedTextSpan = typeahead ? null : displayElement.querySelector('.dropdown-selected-text');
    const chevronIcon = typeahead ? null : displayElement.querySelector('.ti-chevron-down');
    
    let allOptions = [];
    let currentValue = '';
    // Combobox: texto tecleado que NO corresponde a una opción existente.
    let typedText = '';
    let isTypedValue = false;

    // Actualiza el texto visible: en typeahead escribe el value del input; en clásico, el span.
    function setDisplayText(text, muted) {
        if (typeahead) {
            displayElement.value = text || '';
        } else if (selectedTextSpan) {
            selectedTextSpan.textContent = text;
            selectedTextSpan.classList.toggle('text-muted', !!muted);
        }
    }
    function openMenu() { if (menuElement) menuElement.classList.add('show'); }
    function closeMenu() { if (menuElement) menuElement.classList.remove('show'); }
    
    // Initialize component
    function init() {
        console.log('Initializing custom dropdown for #' + selectId + (isDisabled ? ' (disabled)' : ''));
        
        // Collect all initial options
        collectOptions();
        
        // Set initial selected value
        setInitialValue();
        
        // Setup event listeners
        setupEventListeners();
        
        // Dispatch ready event for compatibility
        const readyEvent = new CustomEvent('tomselect:ready', {
            detail: { 
                instance: {
                    getValue: () => currentValue,
                    setValue: setValue,
                    addOption: addOption,
                    clearOptions: clearOptions,
                    refreshOptions: refreshOptions,
                    getOption: getOption,
                    getTypedText: () => typedText,
                    isTyped: () => isTypedValue,
                    setTypedValue: (t) => commitTypedValue(t),
                    on: () => {}, // Compatibility stub
                    open: () => openDropdown(),
                    close: () => closeDropdown()
                }
            }
        });
        hiddenInput.dispatchEvent(readyEvent);
        
        console.log('Custom dropdown initialized successfully for #' + selectId);
    }
    
    // Collect options from HTML
    function collectOptions() {
        const optionElements = optionsContainer.querySelectorAll('.dropdown-option');
        allOptions = Array.from(optionElements).map(el => ({
            value: el.dataset.value,
            text: el.dataset.text,
            element: el
        }));
    }
    
    // Set initial selected value
    function setInitialValue() {
        <% if (selectSelected && selectSelected.length > 0) { %>
            const initialValue = '<%= selectSelected[0] %>';
            const option = allOptions.find(opt => opt.value === initialValue);
            if (option) {
                setValue(initialValue);
            }
        <% } %>
    }
    
    // Setup event listeners
    function setupEventListeners() {
        // Skip event listeners if disabled
        if (isDisabled) {
            console.log('Dropdown is disabled, skipping event listeners');
            return;
        }
        
        if (typeahead) {
            // Campo editable = buscador. La lista abre al enfocar/teclear y cierra al salir.
            searchInput.addEventListener('input', handleSearch);
            searchInput.addEventListener('keydown', handleKeyDown);
            searchInput.addEventListener('focus', function () {
                performLocalSearch((searchInput.value || '').toLowerCase(), searchInput.value);
                if (allOptions.length || (searchInput.value || '').trim()) openMenu();
            });
            searchInput.addEventListener('blur', function () {
                setTimeout(function () {
                    closeMenu();
                    // Si quedó texto sin elegir opción ni crear, commitearlo como "nuevo".
                    const v = (searchInput.value || '').trim();
                    if (v && !currentValue && !isTypedValue) commitTypedValue(v);
                }, 150);
            });
            // Evita que el blur cierre el menú antes de registrar el click en una opción.
            optionsContainer.addEventListener('mousedown', function (e) { e.preventDefault(); });
            optionsContainer.addEventListener('click', handleOptionClick);
            return;
        }

        // Search functionality
        searchInput.addEventListener('input', handleSearch);

        // Option selection
        optionsContainer.addEventListener('click', handleOptionClick);

        // Dropdown toggle
        displayElement.addEventListener('shown.bs.dropdown', handleDropdownOpen);
        displayElement.addEventListener('hidden.bs.dropdown', handleDropdownClose);

        // Keyboard navigation
        searchInput.addEventListener('keydown', handleKeyDown);
    }
    
    // Debounce timeout for search
    let searchTimeout;
    
    // Show search loader
    function showSearchLoader() {
        if (searchLoader) {
            searchLoader.classList.remove('d-none');
        }
    }
    
    // Hide search loader
    function hideSearchLoader() {
        if (searchLoader) {
            searchLoader.classList.add('d-none');
        }
    }
    
    // Handle search input with debouncing for server-side search
    function handleSearch(e) {
        const searchTerm = e.target.value.toLowerCase();
        // Typeahead: cualquier tecleo mantiene la lista abierta.
        if (typeahead) openMenu();

        // Clear existing timeout
        if (searchTimeout) {
            clearTimeout(searchTimeout);
        }
        
        // Hide loader if search is cleared
        if (!searchTerm) {
            hideSearchLoader();
        }
        
        // For client search dropdown, implement server-side search
        if (selectId === 'clientId' && window.loadActiveClients) {
            // Show loader for non-empty searches
            if (searchTerm) {
                showSearchLoader();
            }
            
            searchTimeout = setTimeout(async () => {
                try {
                    // Call the server-side search function
                    await window.loadActiveClients(searchTerm);
                } catch (error) {
                    console.error('Server-side search error:', error);
                    // Fallback to local search
                    performLocalSearch(searchTerm);
                } finally {
                    // Always hide loader when done
                    hideSearchLoader();
                }
            }, 300); // 300ms debounce
        } else {
            // For other dropdowns, use local search immediately
            performLocalSearch(searchTerm, e.target.value);
        }
    }
    
    // Local search function. rawTerm conserva el texto tal cual se tecleó (mayúsculas)
    // para el item "Crear «...»" del modo combobox.
    function performLocalSearch(searchTerm, rawTerm) {
        allOptions.forEach(option => {
            const matches = option.text.toLowerCase().includes(searchTerm);
            option.element.style.display = matches ? 'block' : 'none';
        });

        const visibleOptions = allOptions.filter(opt => opt.element.style.display !== 'none');

        // Modo combobox: si se permite crear y el texto no coincide EXACTAMENTE con una
        // opción existente, ofrecer "＋ Crear «texto»" en lugar del mensaje "sin resultados".
        if (allowCreate && searchTerm) {
            const exact = allOptions.some(opt => opt.text.toLowerCase() === searchTerm);
            showCreateOption(rawTerm || searchTerm, !exact);
            showNoResultsMessage(false);
        } else {
            showCreateOption('', false);
            showNoResultsMessage(visibleOptions.length === 0 && searchTerm.length > 0);
        }
    }
    
    // Handle option click
    function handleOptionClick(e) {
        e.preventDefault();

        // Modo combobox: click en "＋ Crear «texto»".
        const createEl = e.target.closest('.dropdown-option-create');
        if (createEl) {
            commitTypedValue(createEl.dataset.createText || '');
            return;
        }

        // Use closest() so clicks landing on inner elements (e.g. the small type
        // suffix) still resolve to the option anchor.
        const optionEl = e.target.closest('.dropdown-option');
        if (optionEl) {
            const value = optionEl.dataset.value;
            const text = optionEl.dataset.text;

            setValue(value);
            closeDropdown();
        }
    }
    
    // Handle dropdown open
    function handleDropdownOpen() {
        chevronIcon.style.transform = 'rotate(180deg)';
        searchInput.focus();
        searchInput.value = '';
        
        // Hide search loader on open
        hideSearchLoader();
        
        // Reset option visibility
        allOptions.forEach(option => {
            option.element.style.display = 'block';
        });
        showNoResultsMessage(false);
        showCreateOption('', false);
    }
    
    // Handle dropdown close
    function handleDropdownClose() {
        chevronIcon.style.transform = 'rotate(0deg)';
        
        // Hide search loader on close and clear any pending search
        hideSearchLoader();
        if (searchTimeout) {
            clearTimeout(searchTimeout);
            searchTimeout = null;
        }
    }
    
    // Handle keyboard navigation
    function handleKeyDown(e) {
        if (e.key === 'Escape') {
            closeDropdown();
            return;
        }
        // Modo combobox: Enter con item "Crear" visible → commitea el texto tecleado
        // (preventDefault evita que el Enter envíe el formulario contenedor).
        if (e.key === 'Enter' && allowCreate) {
            const createEl = optionsContainer.querySelector('.dropdown-option-create');
            if (createEl) {
                e.preventDefault();
                commitTypedValue(createEl.dataset.createText || searchInput.value);
            }
        }
    }
    
    // Set value
    function setValue(value) {
        console.log('[CustomSelect] setValue called:', {
            value: value,
            valueType: typeof value,
            allOptionsCount: allOptions.length,
            allOptionValues: allOptions.map(opt => ({
                value: opt.value,
                type: typeof opt.value,
                text: opt.text
            }))
        });
        
        const option = allOptions.find(opt => opt.value === value);
        
        if (option) {
            console.log('[CustomSelect] Option found:', option);
            currentValue = value;
            hiddenInput.value = value;
            // displayField permite mostrar solo el Nombre (u otro campo) al seleccionar.
            setDisplayText((displayField && option[displayField]) ? option[displayField] : option.text, false);
            // Se eligió una opción real → ya no es "texto tecleado".
            isTypedValue = false;
            typedText = '';

            // Trigger change event for compatibility
            const changeEvent = new Event('change', { bubbles: true });
            hiddenInput.dispatchEvent(changeEvent);
        } else {
            console.log('[CustomSelect] Option NOT found for value:', value);
            // Try with string comparison
            const optionStr = allOptions.find(opt => String(opt.value) === String(value));
            if (optionStr) {
                console.log('[CustomSelect] Found with string comparison:', optionStr);
            }
        }
    }
    
    // Add option
    function addOption(option) {
        const optionEl = document.createElement('a');
        optionEl.className = 'dropdown-item dropdown-option';
        optionEl.href = '#';
        optionEl.dataset.value = option.value;
        optionEl.dataset.text = option.text;
        optionEl.textContent = option.text;
        // Optional small muted suffix (e.g. POI type) shown only in the dropdown list.
        // Kept out of dataset.text so the selected display and search use the plain name.
        if (option.type) {
            optionEl.dataset.type = option.type;
            const typeEl = document.createElement('small');
            typeEl.className = 'text-muted ms-1';
            typeEl.textContent = '(' + option.type + ')';
            optionEl.appendChild(typeEl);
        }

        optionsContainer.appendChild(optionEl);
        // Store all option data, not just value and text
        allOptions.push({
            ...option,  // Include all properties from the option
            element: optionEl
        });
    }
    
    // Clear options
    function clearOptions() {
        optionsContainer.innerHTML = '';
        allOptions = [];
    }
    
    // Get option by value
    function getOption(value) {
        return allOptions.find(opt => opt.value === value);
    }
    
    // Refresh options (compatibility method)
    function refreshOptions() {
        // Already reactive, no action needed
    }
    
    // Open dropdown
    function openDropdown() {
        if (typeahead) { openMenu(); return; }
        const dropdown = new bootstrap.Dropdown(displayElement);
        dropdown.show();
    }

    // Close dropdown
    function closeDropdown() {
        if (typeahead) { closeMenu(); return; }
        const dropdown = bootstrap.Dropdown.getInstance(displayElement);
        if (dropdown) {
            dropdown.hide();
        }
    }
    
    // Show/hide no results message
    function showNoResultsMessage(show) {
        let noResultsEl = optionsContainer.querySelector('.no-results-message');
        
        if (show && !noResultsEl) {
            noResultsEl = document.createElement('div');
            noResultsEl.className = 'dropdown-item-text text-muted no-results-message';
            noResultsEl.textContent = 'No se encontraron resultados';
            optionsContainer.appendChild(noResultsEl);
        } else if (!show && noResultsEl) {
            noResultsEl.remove();
        }
    }

    // Combobox: item "＋ Crear «texto»" al inicio de la lista (des-duplicado).
    function showCreateOption(text, show) {
        let el = optionsContainer.querySelector('.dropdown-option-create');
        if (show && text) {
            if (!el) {
                el = document.createElement('a');
                el.className = 'dropdown-item dropdown-option-create';
                el.href = '#';
                optionsContainer.insertBefore(el, optionsContainer.firstChild);
            }
            el.dataset.createText = text;
            // textContent para evitar inyección de HTML desde el texto tecleado.
            el.textContent = '';
            const icon = document.createElement('i');
            icon.className = 'ti ti-plus me-1';
            el.appendChild(icon);
            el.appendChild(document.createTextNode(createLabel + ' «' + text + '»'));
        } else if (el) {
            el.remove();
        }
    }

    // Combobox: commitea el texto tecleado como valor "nuevo" (no es un id de opción).
    // Deja hiddenInput.value vacío (clave: no enviar texto como id) y notifica vía
    // 'customselect:create' para que el consumidor decida qué hacer (crear cliente, etc.).
    // silent=true (restauración en edición): solo pinta el display, sin disparar
    // 'customselect:create' (evita side-effects de "cliente nuevo" al cargar).
    function commitTypedValue(rawText, silent) {
        const text = (rawText || '').trim();
        if (!text) return;
        typedText = text;
        isTypedValue = true;
        currentValue = '';
        hiddenInput.value = '';
        setDisplayText(text, false);
        closeDropdown();
        if (silent) return;
        hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
        hiddenInput.dispatchEvent(new CustomEvent('customselect:create', { bubbles: true, detail: { text: text } }));
    }
    
    // Store reference for external access
    hiddenInput.customSelect = {
        getValue: () => currentValue,
        setValue: setValue,
        addOption: addOption,
        clearOptions: clearOptions,
        getOption: getOption,
        refreshOptions: refreshOptions,
        getTypedText: () => typedText,
        isTyped: () => isTypedValue,
        setTypedValue: commitTypedValue,
        open: openDropdown,
        close: closeDropdown
    };
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
