<%
/**
 * Interior Number Input Atom
 * Input for apartment/interior numbers with validation
 * Created by Denisse Maldonado
 *
 * Atomic Design Level: Atom
 * Category: Common Form Elements
 *
 * @param {string} name - Input name attribute (default: 'interiorNumber')
 * @param {string} id - Input ID attribute (default: 'interiorNumber')
 * @param {string} label - Field label text (default: 'No. Interior')
 * @param {boolean} required - Whether field is required (default: false)
 * @param {string} placeholder - Placeholder text
 * @param {string} helpText - Help text below field
 * @param {object} inputAttributes - Additional input attributes (default: {})
 * @param {string} value - Initial value (default: '')
 */

// Component Configuration
const inputName = typeof name !== 'undefined' ? name : 'interiorNumber';
const inputId = typeof id !== 'undefined' ? id : 'interiorNumber';
const inputLabel = typeof label !== 'undefined' ? label : 'No. Interior';
const isRequired = typeof required !== 'undefined' ? required : false;
const inputPlaceholder = typeof placeholder !== 'undefined' ? placeholder : 'Ej: 4B, 101, Apt 5';
const inputHelpText = typeof helpText !== 'undefined' ? helpText : 'Número de apartamento o interior (opcional)';
const additionalAttributes = typeof inputAttributes !== 'undefined' ? inputAttributes : {};
const initialValue = typeof value !== 'undefined' ? value : '';
%>

<div class="mb-3">
    <label for="<%= inputId %>" class="form-label">
        <i class="ti ti-door me-1"></i>
        <%= inputLabel %>
        <% if (isRequired) { %>
            <span class="text-danger">*</span>
        <% } %>
        <span class="text-muted small">(opcional)</span>
    </label>
    
    <input 
        type="text"
        class="form-control"
        id="<%= inputId %>"
        name="<%= inputName %>"
        placeholder="<%= inputPlaceholder %>"
        value="<%= initialValue %>"
        <%= isRequired ? 'required' : '' %>
        maxlength="15"
        pattern="^[0-9A-Za-z\-\s]+$"
        title="Número interior (números, letras, espacios y guiones)"
        <% Object.keys(additionalAttributes).forEach(function(key) { %>
            <%= key %>="<%= additionalAttributes[key] %>"
        <% }); %>
    >
    
    <% if (inputHelpText) { %>
        <small class="form-text text-muted">
            <i class="ti ti-info-circle"></i>
            <%= inputHelpText %>
        </small>
    <% } %>
    
    <div class="invalid-feedback">
        Por favor ingrese un número interior válido
    </div>
</div>

<script>
(function() {
    // Real-time validation for interior number
    const interiorInput = document.getElementById('<%= inputId %>');
    
    if (interiorInput) {
        interiorInput.addEventListener('input', function() {
            let value = this.value.toUpperCase();
            this.value = value;
            
            // Validate pattern (numbers, letters, spaces, dashes)
            const pattern = /^[0-9A-Z\-\s]*$/;
            if (pattern.test(value)) {
                this.classList.remove('is-invalid');
                if (value.trim().length > 0) {
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                }
            } else if (value.trim().length > 0) {
                this.classList.remove('is-valid');
                this.classList.add('is-invalid');
            } else {
                this.classList.remove('is-valid', 'is-invalid');
            }
        });
        
        // Prevent invalid characters
        interiorInput.addEventListener('keypress', function(e) {
            const char = String.fromCharCode(e.which);
            if (!/[0-9A-Za-z\-\s]/.test(char)) {
                e.preventDefault();
            }
        });
        
        interiorInput.addEventListener('blur', function() {
            // Clean up multiple spaces
            this.value = this.value.replace(/\s+/g, ' ').trim();
        });
    }
})();
</script>