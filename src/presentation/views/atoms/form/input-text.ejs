<%
/**
 * Text Input Atom
 * Basic text input field with consistent styling and behavior
 *
 * @param {string} id - Field ID
 * @param {string} name - Field name attribute
 * @param {string} label - Field label text
 * @param {string} value - Current field value
 * @param {string} placeholder - Placeholder text
 * @param {boolean} required - Whether field is required
 * @param {boolean} disabled - Whether field is disabled
 * @param {boolean} readonly - Whether field is readonly
 * @param {string} helpText - Help text to display below field
 * @param {string} errorText - Error message to display
 * @param {object} validation - Validation rules (minLength, maxLength, pattern)
 * @param {string} className - Additional CSS classes
 * @param {string} size - Field size: 'sm' | 'md' | 'lg'
 * @param {function} onChange - Change event handler
 * @param {function} onBlur - Blur event handler
 * @param {function} onFocus - Focus event handler
 */

const fieldId = typeof id !== 'undefined' ? id : `text_${Math.random().toString(36).substr(2, 9)}`;
const fieldName = typeof name !== 'undefined' ? name : fieldId;
const fieldLabel = typeof label !== 'undefined' ? label : '';
const fieldValue = typeof value !== 'undefined' ? value : '';
const fieldPlaceholder = typeof placeholder !== 'undefined' ? placeholder : '';
const isRequired = typeof required !== 'undefined' ? required : false;
const isDisabled = typeof disabled !== 'undefined' ? disabled : false;
const isReadonly = typeof readonly !== 'undefined' ? readonly : false;
const fieldHelpText = typeof helpText !== 'undefined' ? helpText : '';
const fieldErrorText = typeof errorText !== 'undefined' ? errorText : '';
const fieldValidation = typeof validation !== 'undefined' ? validation : {};
const fieldClassName = typeof className !== 'undefined' ? className : '';
const fieldSize = typeof size !== 'undefined' ? size : 'md';

// Size classes mapping
const sizeClasses = {
    'sm': 'form-control-sm',
    'md': '',
    'lg': 'form-control-lg'
};

const inputClass = `form-control ${sizeClasses[fieldSize]} ${fieldErrorText ? 'is-invalid' : ''} ${fieldClassName}`;

// Build validation attributes
let validationAttrs = '';
if (fieldValidation.minLength) validationAttrs += ` minlength="${fieldValidation.minLength}"`;
if (fieldValidation.maxLength) validationAttrs += ` maxlength="${fieldValidation.maxLength}"`;
if (fieldValidation.pattern) validationAttrs += ` pattern="${fieldValidation.pattern}"`;

// Build data attributes for JS handling
let dataAttrs = '';
if (typeof onChange !== 'undefined') dataAttrs += ` data-onchange="true"`;
if (typeof onBlur !== 'undefined') dataAttrs += ` data-onblur="true"`;
if (typeof onFocus !== 'undefined') dataAttrs += ` data-onfocus="true"`;

// Prepare field content
const fieldContent = `
    <input 
        type="text" 
        id="${fieldId}" 
        name="${fieldName}" 
        class="${inputClass}"
        value="${fieldValue}"
        placeholder="${fieldPlaceholder}"
        ${isRequired ? 'required' : ''}
        ${isDisabled ? 'disabled' : ''}
        ${isReadonly ? 'readonly' : ''}
        ${validationAttrs}
        ${dataAttrs}
    />
`;
%>

<%- include('_field-wrapper', {
    id: fieldId,
    name: fieldName,
    label: fieldLabel,
    required: isRequired,
    helpText: fieldHelpText,
    errorText: fieldErrorText,
    className: '',
    size: fieldSize,
    fieldContent: fieldContent
}) %>