<%- include('../templates/auth-layout', {
    title: '429 - Too Many Requests',
    page: '429-error',
    showAuthHeader: false,
    content: `
        <div class="error-429-container">
            <!-- Error Icon -->
            <div class="text-center mb-4">
                <div class="error-icon-wrapper">
                    <div class="error-icon-circle bg-warning-subtle d-flex align-items-center justify-content-center rounded-circle">
                        <i class="ti ti-clock text-warning display-3"></i>
                        <div class="error-ring position-absolute rounded-circle border border-warning opacity-25"></div>
                        <div class="error-ring-2 position-absolute rounded-circle border border-warning opacity-15"></div>
                    </div>
                </div>
            </div>

            <!-- Error Content -->
            <div class="error-content text-center">
                <!-- Title -->
                <h2 class="error-title fw-bold text-dark mb-3">
                    Too Many Requests
                </h2>

                <!-- Message -->
                <div class="error-message mb-4">
                    <p class="text-muted mb-0 fs-6 lh-base">
                        ${typeof message !== 'undefined' ? message : 'You have made too many requests. Please wait a moment and try again.'}
                    </p>
                    ${typeof retryAfter !== 'undefined' ? `
                        <div class="mt-3">
                            <div class="alert alert-warning d-inline-flex align-items-center border-0 bg-warning-subtle">
                                <i class="ti ti-info-circle me-2"></i>
                                <small class="mb-0">
                                    Please try again after ${retryAfter} seconds
                                </small>
                            </div>
                        </div>
                    ` : ''}
                </div>

                <!-- Action Buttons -->
                <div class="error-actions d-flex flex-column flex-sm-row gap-2 justify-content-center mt-4">
                    <a href="/" class="btn btn-primary d-flex align-items-center justify-content-center">
                        <i class="ti ti-home me-2"></i>
                        Go to Homepage
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary d-flex align-items-center justify-content-center">
                        <i class="ti ti-arrow-left me-2"></i>
                        Go Back
                    </a>
                </div>
            </div>

            <!-- Help Section -->
            <div class="error-help mt-5 pt-4 border-top text-center">
                <small class="text-muted">
                    If this problem persists,
                    <a href="/contact" class="text-primary text-decoration-none">Contact Support</a>
                    or visit our
                    <a href="/help" class="text-primary text-decoration-none">Help Center</a>
                </small>
            </div>
        </div>

        <style>
            .error-429-container {
                max-width: 500px;
                margin: 0 auto;
                padding: 2rem 1.5rem;
                animation: errorFadeIn 0.6s ease-out;
            }

            .error-icon-wrapper {
                width: 80px;
                height: 80px;
                margin: 0 auto;
                position: relative;
                animation: errorPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
            }

            .error-icon-circle {
                width: 100%;
                height: 100%;
                box-shadow: 0 8px 25px rgba(255, 193, 7, 0.15);
                border: 3px solid rgba(255, 193, 7, 0.1);
                transition: all 0.3s ease;
            }

            .error-ring,
            .error-ring-2 {
                width: 100%;
                height: 100%;
                top: 0;
                left: 0;
                pointer-events: none;
            }

            .error-ring {
                animation: errorRing 1.5s ease-out forwards;
                animation-delay: 0.3s;
            }

            .error-ring-2 {
                animation: errorRing 1.5s ease-out forwards;
                animation-delay: 0.6s;
            }

            .error-title {
                color: #2c3e50;
                font-size: 2rem;
                font-weight: 700;
            }

            .error-message {
                font-size: 1.1rem;
                line-height: 1.6;
                color: #6c757d;
            }

            .error-actions .btn {
                min-width: 140px;
                font-weight: 600;
                border-radius: 8px;
                transition: all 0.3s ease;
            }

            .error-actions .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            }

            @keyframes errorFadeIn {
                0% {
                    opacity: 0;
                    transform: translateY(20px);
                }
                100% {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @keyframes errorPop {
                0% {
                    transform: scale(0);
                    opacity: 0;
                }
                50% {
                    transform: scale(1.2);
                }
                100% {
                    transform: scale(1);
                    opacity: 1;
                }
            }

            @keyframes errorRing {
                0% {
                    transform: scale(1);
                    opacity: 0.3;
                }
                100% {
                    transform: scale(1.4);
                    opacity: 0;
                }
            }

            @media (max-width: 576px) {
                .error-429-container {
                    padding: 1.5rem 1rem;
                }

                .error-title {
                    font-size: 1.75rem;
                }

                .error-actions {
                    flex-direction: column;
                }

                .error-actions .btn {
                    min-width: auto;
                    width: 100%;
                }
            }
        </style>
    `
}) %>