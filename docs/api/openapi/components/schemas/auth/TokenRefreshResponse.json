{
  "type": "object",
  "required": ["success", "user"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": true
    },
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "abc123"
        },
        "username": {
          "type": "string",
          "example": "john.doe"
        },
        "role": {
          "type": "string",
          "example": "employee"
        }
      }
    },
    "tokens": {
      "type": "object",
      "description": "JWT tokens (only returned when X-Client-Type: mobile header is sent)",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "JWT access token (8 hours validity)",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "refreshToken": {
          "type": "string",
          "description": "JWT refresh token (7 days validity)",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "tokenType": {
          "type": "string",
          "example": "Bearer"
        },
        "expiresIn": {
          "type": "string",
          "description": "Access token expiration time",
          "example": "8h"
        }
      }
    }
  }
}
