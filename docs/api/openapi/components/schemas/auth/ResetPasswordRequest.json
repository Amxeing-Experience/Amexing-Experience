{
  "type": "object",
  "required": ["token", "password", "confirmPassword"],
  "properties": {
    "token": {
      "type": "string",
      "description": "Password reset token (received via email)",
      "example": "reset_token_abc123"
    },
    "password": {
      "type": "string",
      "format": "password",
      "minLength": 8,
      "description": "New password",
      "example": "NewSecureP@ssw0rd!"
    },
    "confirmPassword": {
      "type": "string",
      "format": "password",
      "description": "Password confirmation",
      "example": "NewSecureP@ssw0rd!"
    }
  }
}
