{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["healthy", "degraded", "down"],
      "example": "healthy"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "example": "2024-10-01T12:00:00.000Z"
    },
    "services": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "enum": ["connected", "disconnected"],
          "example": "connected"
        },
        "parseServer": {
          "type": "string",
          "enum": ["running", "stopped"],
          "example": "running"
        }
      }
    }
  }
}
