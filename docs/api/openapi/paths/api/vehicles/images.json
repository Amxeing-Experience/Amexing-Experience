{
  "get": {
    "tags": ["Vehicles"],
    "summary": "Get vehicle images",
    "operationId": "getVehicleImages",
    "description": "Get all images for a specific vehicle. Returns presigned S3 URLs valid for 24 hours.\n\n**Mobile App Usage:** Call this endpoint to load image galleries for vehicles. Cache the URLs but refresh when expired.\n\n**Note:** The `isPrimary` field indicates the main/cover image. Use `displayOrder` for sorting.",
    "security": [
      { "bearerAuth": [] }
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Vehicle ID (Parse ObjectId)",
        "schema": {
          "type": "string",
          "example": "abc123def456"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Vehicle images list with presigned S3 URLs",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../../components/schemas/vehicle/VehicleImagesResponse.json"
            },
            "example": {
              "success": true,
              "data": [
                {
                  "id": "img001",
                  "url": "https://amexing-bucket.s3.amazonaws.com/vehicles/abc123/front.jpg?X-Amz-...",
                  "fileName": "front.jpg",
                  "fileSize": 1024000,
                  "isPrimary": true,
                  "displayOrder": 0,
                  "uploadedAt": "2024-01-15T10:00:00.000Z"
                },
                {
                  "id": "img002",
                  "url": "https://amexing-bucket.s3.amazonaws.com/vehicles/abc123/interior.jpg?X-Amz-...",
                  "fileName": "interior.jpg",
                  "fileSize": 850000,
                  "isPrimary": false,
                  "displayOrder": 1,
                  "uploadedAt": "2024-01-15T10:05:00.000Z"
                }
              ],
              "count": 2
            }
          }
        }
      },
      "404": {
        "$ref": "../../../components/responses/NotFoundError.json"
      },
      "401": {
        "$ref": "../../../components/responses/UnauthorizedError.json"
      }
    }
  }
}
