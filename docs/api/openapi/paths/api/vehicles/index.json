{
  "get": {
    "tags": ["Vehicles"],
    "summary": "Get vehicles list",
    "operationId": "getVehicles",
    "description": "Get vehicles with optional filtering and pagination. Supports DataTables server-side processing.\n\n**Mobile App Usage:**\n- Use `rateId` to filter by segment (Premium, Standard, etc.)\n- Use `search[value]` for text search across brand, model, and license plate\n- Pagination via `start` and `length` parameters\n\n**Available Filters in Response:**\n- `vehicleTypeId.name` - Vehicle type (Van, SUV, Sedan, etc.)\n- `rateId.name` - Segment/rate name\n- `rateId.color` - Color code for UI badges",
    "security": [
      { "bearerAuth": [] }
    ],
    "parameters": [
      {
        "name": "rateId",
        "in": "query",
        "description": "Filter by Rate ID (segment). Get available rates from GET /api/rates/active",
        "schema": {
          "type": "string",
          "example": "rate123"
        }
      },
      {
        "name": "vehicleTypeId",
        "in": "query",
        "description": "Filter by Vehicle Type ID. Get available types from GET /api/vehicle-types/active",
        "schema": {
          "type": "string",
          "example": "vehicleType123"
        }
      },
      {
        "name": "search[value]",
        "in": "query",
        "description": "Text search across brand, model, and license plate",
        "schema": {
          "type": "string",
          "example": "Mercedes"
        }
      },
      {
        "name": "draw",
        "in": "query",
        "description": "DataTables draw counter (echoed back in response)",
        "schema": {
          "type": "integer",
          "example": 1
        }
      },
      {
        "name": "start",
        "in": "query",
        "description": "Pagination offset (default: 0)",
        "schema": {
          "type": "integer",
          "default": 0,
          "example": 0
        }
      },
      {
        "name": "length",
        "in": "query",
        "description": "Results per page (default: 25, max: 100)",
        "schema": {
          "type": "integer",
          "default": 25,
          "maximum": 100,
          "example": 25
        }
      },
      {
        "name": "order[0][column]",
        "in": "query",
        "description": "Column index for sorting (DataTables format)",
        "schema": {
          "type": "integer",
          "example": 0
        }
      },
      {
        "name": "order[0][dir]",
        "in": "query",
        "description": "Sort direction",
        "schema": {
          "type": "string",
          "enum": ["asc", "desc"],
          "example": "asc"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Paginated vehicles list with embedded type and rate information",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../../components/schemas/vehicle/VehicleListResponse.json"
            },
            "example": {
              "success": true,
              "draw": 1,
              "recordsTotal": 50,
              "recordsFiltered": 12,
              "data": [
                {
                  "id": "vehicle001",
                  "brand": "Mercedes-Benz",
                  "model": "Sprinter",
                  "year": 2023,
                  "licensePlate": "ABC-123",
                  "capacity": 14,
                  "luggageCapacity": 10,
                  "color": "Blanco",
                  "maintenanceStatus": "operational",
                  "active": true,
                  "image": "https://amexing-bucket.s3.amazonaws.com/vehicles/vehicle001/cover.jpg?...",
                  "vehicleTypeId": {
                    "id": "type001",
                    "name": "Van",
                    "code": "VAN",
                    "icon": "van",
                    "trunkCapacity": 10
                  },
                  "rateId": {
                    "id": "rate001",
                    "name": "Premium",
                    "color": "#6366F1"
                  }
                }
              ]
            }
          }
        }
      },
      "401": {
        "$ref": "../../../components/responses/UnauthorizedError.json"
      }
    }
  },
  "post": {
    "tags": ["Vehicles"],
    "summary": "Create vehicle",
    "operationId": "createVehicle",
    "description": "Create a new vehicle. Requires admin or department_manager role.",
    "security": [
      { "bearerAuth": [] }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["brand", "model", "licensePlate", "vehicleTypeId"],
            "properties": {
              "brand": {
                "type": "string",
                "description": "Vehicle brand/manufacturer",
                "example": "Mercedes-Benz"
              },
              "model": {
                "type": "string",
                "description": "Vehicle model",
                "example": "Sprinter"
              },
              "year": {
                "type": "integer",
                "description": "Vehicle year",
                "example": 2023
              },
              "licensePlate": {
                "type": "string",
                "description": "License plate number (unique)",
                "example": "ABC-123"
              },
              "capacity": {
                "type": "integer",
                "description": "Passenger capacity",
                "example": 14
              },
              "luggageCapacity": {
                "type": "integer",
                "description": "Luggage capacity",
                "example": 10
              },
              "color": {
                "type": "string",
                "description": "Vehicle color",
                "example": "Blanco"
              },
              "vehicleTypeId": {
                "type": "string",
                "description": "Vehicle Type ID (required)",
                "example": "vehicleType123"
              },
              "rateId": {
                "type": "string",
                "description": "Rate/Segment ID",
                "example": "rate123"
              }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Vehicle created successfully",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "data": {
                  "$ref": "../../../components/schemas/vehicle/Vehicle.json"
                },
                "message": {
                  "type": "string",
                  "example": "Vehicle created successfully"
                }
              }
            }
          }
        }
      },
      "400": {
        "$ref": "../../../components/responses/ValidationError.json"
      },
      "401": {
        "$ref": "../../../components/responses/UnauthorizedError.json"
      },
      "403": {
        "$ref": "../../../components/responses/ForbiddenError.json"
      }
    }
  }
}
