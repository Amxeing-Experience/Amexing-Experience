{
  "get": {
    "tags": ["Profile"],
    "summary": "Get current user's profile image",
    "operationId": "getProfileImage",
    "description": "Get the optimized profile image URL for the authenticated user.\n\n**Mobile App Usage:** Call this endpoint after login to get the user's profile picture URL. The URL is a presigned S3 URL valid for 24 hours.\n\n**Image Optimization:** The API automatically returns the best format based on Accept header (WebP, AVIF, or original).",
    "security": [
      { "bearerAuth": [] }
    ],
    "responses": {
      "200": {
        "description": "Profile image URL or null if no image",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "nullable": true,
                      "description": "Presigned S3 URL (expires in 24h) or null if no image",
                      "example": "https://amexing-bucket.s3.amazonaws.com/profiles/user123/avatar.webp?X-Amz-..."
                    },
                    "hasProfileImage": {
                      "type": "boolean",
                      "description": "Whether user has uploaded a profile image",
                      "example": true
                    },
                    "optimization": {
                      "type": "object",
                      "description": "Image optimization metadata",
                      "properties": {
                        "format": {
                          "type": "string",
                          "description": "Served format",
                          "example": "webp"
                        },
                        "availableFormats": {
                          "type": "array",
                          "items": { "type": "string" },
                          "example": ["webp", "avif", "jpeg"]
                        }
                      }
                    }
                  }
                }
              }
            },
            "examples": {
              "with_image": {
                "summary": "User has profile image",
                "value": {
                  "success": true,
                  "data": {
                    "url": "https://amexing-bucket.s3.amazonaws.com/profiles/user123/avatar.webp?...",
                    "hasProfileImage": true,
                    "optimization": {
                      "format": "webp",
                      "availableFormats": ["webp", "avif", "jpeg"]
                    }
                  }
                }
              },
              "no_image": {
                "summary": "User has no profile image",
                "value": {
                  "success": true,
                  "data": {
                    "url": null,
                    "hasProfileImage": false
                  }
                }
              }
            }
          }
        }
      },
      "401": {
        "$ref": "../../../components/responses/UnauthorizedError.json"
      }
    }
  },
  "post": {
    "tags": ["Profile"],
    "summary": "Upload profile image",
    "operationId": "uploadProfileImage",
    "description": "Upload and optimize a new profile image for the authenticated user.\n\n**Mobile App Usage:** Use multipart/form-data to upload the image. The API automatically optimizes the image into multiple formats (WebP, AVIF) for best performance.\n\n**Supported formats:** JPEG, PNG, GIF, WebP, AVIF\n**Max file size:** 10MB",
    "security": [
      { "bearerAuth": [] }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "multipart/form-data": {
          "schema": {
            "type": "object",
            "required": ["profileImage"],
            "properties": {
              "profileImage": {
                "type": "string",
                "format": "binary",
                "description": "Image file to upload (JPEG, PNG, GIF, WebP, AVIF)"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Image uploaded and optimized successfully",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "New profile image URL",
                      "example": "https://amexing-bucket.s3.amazonaws.com/profiles/user123/avatar.webp?..."
                    },
                    "optimization": {
                      "type": "object",
                      "properties": {
                        "originalSize": {
                          "type": "integer",
                          "description": "Original file size in bytes",
                          "example": 2048000
                        },
                        "optimizedSize": {
                          "type": "integer",
                          "description": "Optimized file size in bytes",
                          "example": 512000
                        },
                        "savedPercentage": {
                          "type": "number",
                          "description": "Size reduction percentage",
                          "example": 75
                        },
                        "availableFormats": {
                          "type": "array",
                          "items": { "type": "string" },
                          "example": ["webp", "avif", "jpeg"]
                        }
                      }
                    }
                  }
                },
                "message": {
                  "type": "string",
                  "example": "Profile image uploaded successfully"
                }
              }
            }
          }
        }
      },
      "400": {
        "$ref": "../../../components/responses/ValidationError.json"
      },
      "401": {
        "$ref": "../../../components/responses/UnauthorizedError.json"
      }
    }
  },
  "delete": {
    "tags": ["Profile"],
    "summary": "Delete profile image",
    "operationId": "deleteProfileImage",
    "description": "Delete the profile image for the authenticated user.",
    "security": [
      { "bearerAuth": [] }
    ],
    "responses": {
      "200": {
        "description": "Profile image deleted successfully",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "Profile image deleted successfully"
                }
              }
            }
          }
        }
      },
      "401": {
        "$ref": "../../../components/responses/UnauthorizedError.json"
      }
    }
  }
}
