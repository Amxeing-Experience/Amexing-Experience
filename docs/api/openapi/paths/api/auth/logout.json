{
  "post": {
    "tags": ["Authentication"],
    "summary": "Logout user session (API/Mobile)",
    "operationId": "apiAuthLogout",
    "description": "Invalidate current session and clear authentication cookies. This endpoint is designed for API clients (mobile apps) that don't use CSRF tokens.\n\n**No CSRF Required** - Uses Bearer token authentication only.",
    "security": [
      { "bearerAuth": [] }
    ],
    "responses": {
      "200": {
        "description": "Logout successful",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "Logged out successfully"
                }
              }
            }
          }
        }
      },
      "401": {
        "$ref": "../../../components/responses/UnauthorizedError.json"
      },
      "500": {
        "$ref": "../../../components/responses/ServerError.json"
      }
    }
  }
}
