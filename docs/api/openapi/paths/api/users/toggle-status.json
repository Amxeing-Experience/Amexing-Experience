{
  "patch": {
    "tags": ["User Management"],
    "summary": "Toggle user active status",
    "operationId": "toggleUserStatus",
    "description": "Toggle user's active status.",
    "security": [
      { "bearerAuth": [] }
    ],
    "parameters": [
      {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "User ID"
      }
    ],
    "responses": {
      "200": {
        "description": "Status toggled successfully",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../../components/schemas/common/SuccessResponse.json"
            }
          }
        }
      },
      "401": {
        "$ref": "../../../components/responses/UnauthorizedError.json"
      },
      "404": {
        "$ref": "../../../components/responses/NotFoundError.json"
      }
    }
  }
}
