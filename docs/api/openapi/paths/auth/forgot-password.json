{
  "post": {
    "tags": ["Authentication"],
    "summary": "Request password reset",
    "operationId": "authForgotPassword",
    "description": "Send password reset email to user.\n\n**Rate Limited:** 10 requests per 5 minutes",
    "security": [],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../../components/schemas/auth/ForgotPasswordRequest.json"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Reset email sent (if email exists)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas/common/SuccessResponse.json"
            }
          }
        }
      },
      "429": {
        "$ref": "../../components/responses/RateLimitError.json"
      }
    }
  }
}
